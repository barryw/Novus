// greeting.library - A simple "Hello World" library for AmigaOS

@library(name = "greeting.library")
pub struct GreetingLibrary {
    call_count: u32,
}

impl GreetingLibrary {
    // GetLibraryVersion() is now auto-generated by the compiler
    // It returns LibraryVersion { major, minor, patch } from project.toml

    pub fn Add(a: i32, b: i32) -> i32 {
        return a + b
    }

    pub fn GetCallCount() -> u32 {
        return 42
    }
}
