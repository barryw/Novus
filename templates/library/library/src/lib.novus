// greeting.library - A simple "Hello World" library for AmigaOS

@library(name = "greeting.library")
pub struct GreetingLibrary {
    // No fields needed! The compiler auto-adds:
    // - __call_count: Automatically tracks all library function calls
}

impl GreetingLibrary {
    // GetLibraryVersion() is auto-generated by the compiler
    // It returns LibraryVersion { major, minor, patch } from project.toml

    // GetCallCount() is auto-generated by the compiler
    // It returns the total number of library function calls
    // Counter is automatically incremented on each user function call

    pub fn Add(a: i32, b: i32) -> i32 {
        return a + b
    }
}
