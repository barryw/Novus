    // ========================================================================
    // Add your public library functions here. Each pub fn becomes a library
    // vector at negative offsets starting at -30, -36, -42, etc.
    //
    // These functions are called through the library base pointer (A6) using
    // AmigaOS calling conventions. The compiler handles all the details.

    pub fn Add(a: i32, b: i32) -> i32 {
        return a + b
    }

    pub fn Multiply(a: i32, b: i32) -> i32 {
        return a * b
    }

