// {{PROJECT_NAME}} - AmigaOS shared library
//
// The compiler owns the resident tag, vectors, A6 wrappers, open count, delayed
// expunge, and allocation of this persistent state. Public functions in the impl
// are exported as library vectors in source order.

@library(name = "{{PROJECT_NAME}}.library")
pub struct MyLib {
    counter: u32,
}

impl MyLib {
    pub fn Add(a: i32, b: i32) -> i32 {
        return a + b
    }

    pub fn Multiply(a: i32, b: i32) -> i32 {
        return a * b
    }

    pub fn Next(&var self) -> u32 {
        self.counter++
        return self.counter
    }

    // Optional lifecycle hooks receive persistent state. Remove any hook the
    // library does not need; Exec bookkeeping remains compiler-owned.
    @libinit
    pub fn loaded(state: *MyLib) -> bool {
        unsafe {
            (*state).counter = 0
        }
        return true  // false makes the initial load fail cleanly
    }

    @libopen
    pub fn opening(state: *MyLib) -> bool {
        return true  // false rejects this OpenLibrary call
    }

    @libclose
    pub fn closing(state: *MyLib) {
        // Release per-opener resources here.
    }

    @libexpunge
    pub fn unloading(state: *MyLib) {
        // Release resources created by loaded(). The generated code then
        // unlinks and frees the library base and returns its segment list.
    }
}
