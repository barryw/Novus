// {{PROJECT_NAME}} - AmigaOS shared library
//
// This library uses the @library attribute to automatically generate:
//   - LibInit, LibOpen, LibClose, LibExpunge, LibReserved (lifecycle functions)
//   - GetLibraryVersion() - returns major.minor.patch version
//   - GetLibraryName() - returns library name string
//   - GetCallCount() - returns total function calls (for profiling)
//   - GetDebugInfo() - returns open/close statistics (for debugging)
//   - GetFeatureFlags() - returns CPU/FPU feature flags
//
// You can override any lifecycle function by implementing it yourself (see below).

@library(name = "{{PROJECT_NAME}}.library")
pub struct MyLib {
    // Add custom state fields here if needed.
    // These are allocated once when the library is loaded and persist
    // until the library is expunged from memory.
    //
    // Example:
    //   counter: i32,
    //   flags: u32,
    //   data_ptr: *void,
}

impl MyLib {
    // ========================================================================
