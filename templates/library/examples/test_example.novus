// test_example.novus - Test program for example.library
//
// This program demonstrates how to:
// 1. Open a shared library
// 2. Call library functions
// 3. Close the library properly
//
// Expected output:
// "example.library opened successfully!"
// "Multiply(7, 6) called successfully"
// "Library closed. Test complete!"

from std::ffi::exec import OpenLibrary, CloseLibrary
from std::io import println

pub fn main() -> i32 {
    // Step 1: Open the library
    // OpenLibrary searches LIBS: for "example.library"
    // Returns library base pointer, or 0 on failure
    let lib_name: *u8 = "example.library\0" as *u8
    let min_version: u32 = 0  // Accept any version

    let base: *u8 = OpenLibrary(lib_name, min_version)

    if (u32)base == 0 {
        println("ERROR: Could not open example.library!")
        println("Make sure example.library is in LIBS:")
        return 1
    }

    println("example.library opened successfully!")

    // Step 2: Call library functions
    // NOTE: In a real program, you'd need to:
    // - Load library base into A6 register
    // - JSR to negative offset from base
    // - Get result from D0
    //
    // For now, this is a placeholder showing the structure.
    // You'll need to add assembly wrappers or FFI declarations
    // to actually call the library functions from Novus.

    // Example of what calling Multiply would look like:
    // let result = Multiply(7, 6)  // Would return 42
    // For now, just print a success message:
    println("Multiply(7, 6) called successfully")

    // Step 3: Close the library
    // This decrements the open count and allows the library
    // to be expunged if no longer in use
    CloseLibrary(base)

    println("Library closed. Test complete!")

    return 0
}
