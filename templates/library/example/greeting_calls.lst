Source: "greeting_calls.s"
                            	     1: ; Assembly wrappers for calling greeting.library from Novus
                            	     2: ; These manually open the library and call functions
                            	     3: ;
                            	     4: ; FIXED: Use absolute addressing and separate data section to avoid
                            	     5: ; PC-relative offset calculation errors during linking
                            	     6: 
                            	     7:         SECTION CODE
                            	     8: 
                            	     9: ; Open library (called first time)
                            	    10: OpenLib:
00:00000000 4AB900000000    	    11:         tst.l   GreetingLibraryBase.l
00:00000006 661E            	    12:         bne.s   .already_open
                            	    13: 
00:00000008 48E7C0C2        	    14:         movem.l d0-d1/a0-a1/a6,-(sp)
00:0000000C 2C780004        	    15:         move.l  4.w,a6                  ; ExecBase
00:00000010 43F900000004    	    16:         lea     LibName,a1              ; Library name (PC-relative OK for lea)
00:00000016 7001            	    17:         moveq   #1,d0                   ; Min version
00:00000018 4EAEFDD8        	    18:         jsr     -552(a6)                ; OpenLibrary
00:0000001C 23C000000000    	    19:         move.l  d0,GreetingLibraryBase.l ; Store with absolute addressing
00:00000022 4CDF4303        	    20:         movem.l (sp)+,d0-d1/a0-a1/a6
                            	    21: .already_open:
00:00000026 4E75            	    22:         rts
