// Safe optional client for {{PROJECT_NAME}}.library.
// The generated dependency stub owns the library lease and every public wrapper
// checks availability before calling through the library base.

from std::core import Result

pub enum LibraryError { Unavailable }

pub fn main() -> i32 {
    let Result::Ok(sum) = add(5, 3) else { return 5 }
    return 10 unless sum == 8

    let Result::Ok(product) = multiply(4, 7) else { return 5 }
    return 10 unless product == 28

    let Result::Ok(first) = next() else { return 5 }
    let Result::Ok(second) = next() else { return 5 }
    return 10 unless first == 1 && second == 2
    return 0
}

pub fn add(a: i32, b: i32) -> Result<i32, LibraryError> {
    return Result::Err(LibraryError::Unavailable) unless is_MyLib_available()
    return Result::Ok(call_MyLib_Add(a, b))
}

pub fn multiply(a: i32, b: i32) -> Result<i32, LibraryError> {
    return Result::Err(LibraryError::Unavailable) unless is_MyLib_available()
    return Result::Ok(call_MyLib_Multiply(a, b))
}

pub fn next() -> Result<u32, LibraryError> {
    return Result::Err(LibraryError::Unavailable) unless is_MyLib_available()
    return Result::Ok(call_MyLib_Next())
}

// The workspace dependency generates and links these private implementation
// symbols. Application code stays in Result-returning Novus wrappers above.
extern fn is_MyLib_available() -> bool
extern fn call_MyLib_Add(a: i32, b: i32) -> i32
extern fn call_MyLib_Multiply(a: i32, b: i32) -> i32
extern fn call_MyLib_Next() -> u32
