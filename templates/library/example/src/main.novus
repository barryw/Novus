// Example program demonstrating greeting.library usage
//
// This calls the library functions to demonstrate the complete workflow.
// The library is automatically opened at startup when linked with greeting_lib.o.

from std::core import LibraryVersion
from std::io import write

// Declare external C wrapper functions
// These are provided by greeting_calls.s which uses assembly wrappers
extern fn call_GreetingLibrary_GetLibraryVersion() -> LibraryVersion
extern fn call_GreetingLibrary_Add(a: i32, b: i32) -> i32
extern fn call_GreetingLibrary_GetCallCount() -> u32

pub fn main() -> i32 {
    // Get library version
    let version: LibraryVersion = call_GreetingLibrary_GetLibraryVersion()

    // Print version using write() with format specifiers
    let msg: String = "greeting.library version: %ld.%ld.%ld\n"
    write(msg.ptr, version.major(), version.minor(), version.patch())

    return 0
}
