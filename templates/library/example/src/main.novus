// Example program demonstrating {{PROJECT_NAME}} usage
//
// This program tests the library functions.

pub fn main() -> i32 {
    // Test the add function: 5 + 3 should = 8
    let result1: i32 = call_MyLib_Add(5, 3)

    // Test the multiply function: 4 * 7 should = 28
    let result2: i32 = call_MyLib_Multiply(4, 7)

    // Return the sum as exit code (just for testing)
    return result1 + result2  // Should be 36 (8 + 28)
}

// Library function declarations
// These must match the call stub names generated by the compiler:
// MyLib::Add becomes call_MyLib_Add, MyLib::Multiply becomes call_MyLib_Multiply
extern fn call_MyLib_Add(a: i32, b: i32) -> i32
extern fn call_MyLib_Multiply(a: i32, b: i32) -> i32
