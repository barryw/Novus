// Safe client for {{PROJECT_NAME}}.device.
// DeviceRequest owns the reply port, I/O request, device lease, and pending I/O.

from std::core import Result
from std::io::file import println
from amiga::sys::device import DeviceRequest, load_device_driver

const RESET: u16 = 1
const STATUS: u16 = 9
const CONFIGURE: u16 = 10
const ASYNC_PING: u16 = 11
const WAIT_FOR_ABORT: u16 = 12

pub fn main() -> i32 {
    var device = match DeviceRequest::open_standard("{{PROJECT_NAME}}.device", 0) {
        Result::Ok(request) => request,
        Result::Err(_) => {
            // Custom devices are not loaded automatically by OpenDevice. Try
            // the installed driver, then a side-by-side development build.
            if load_device_driver("DEVS:{{PROJECT_NAME}}.device").is_err() &&
                load_device_driver("PROGDIR:{{PROJECT_NAME}}.device").is_err() {
                println("{{PROJECT_NAME}}.device is not installed")
                return 5
            }
            match DeviceRequest::open_standard("{{PROJECT_NAME}}.device", 0) {
                Result::Ok(request) => request,
                Result::Err(_) => return 5,
            }
        },
    }

    return 10 unless device.command(RESET).is_ok()
    return 10 unless device.command(CONFIGURE).is_ok()

    let status = match device.command_actual(STATUS) {
        Result::Ok(value) => value,
        Result::Err(_) => return 10,
    }
    return 10 unless status == 1

    // SendIO lets the application keep working before it collects completion.
    return 10 unless device.send(ASYNC_PING).is_ok()
    let completed_early = !device.is_pending()
    return 10 unless device.wait().is_ok()

    // A request can also be cancelled safely. abort() waits until the driver
    // has relinquished it, so neither the request nor its reply port can dangle.
    return 10 unless device.send(WAIT_FOR_ABORT).is_ok()
    return 10 unless device.is_pending()
    return 10 unless device.abort().is_ok()

    println("{{PROJECT_NAME}}.device is working")
    println("async completion and cancellation are working") if completed_early
    return 0
}
