// {{PROJECT_NAME}}-example - Example program using {{PROJECT_NAME}}.device
//
// This demonstrates how to:
//   - Open a device with OpenDevice()
//   - Send commands using DoIO()
//   - Close the device with CloseDevice()
//   - Properly manage IOStdReq and MsgPort resources

from std::io::file import println, print
from amiga::raw::exec import OpenDevice, CloseDevice, DoIO
from amiga::raw::exec import SendIO, CheckIO, WaitIO, AbortIO
from amiga::raw::exec import CreateMsgPort, DeleteMsgPort
from amiga::raw::exec import CreateIORequest, DeleteIORequest
from amiga::raw::structs import IORequest, IOStdReq, MsgPort
from amiga::raw::consts import CMD_RESET

// Device command constants (match those in dev.novus)
const NOVUS_CMD_STATUS: u16 = 9
const NOVUS_CMD_CONFIG: u16 = 10

pub fn main() -> i32 {
    println("{{PROJECT_NAME}}.device Example")
    println("================================")
    println("")

    // Step 1: Create a message port for device replies
    print("Creating message port... ")
    let port = CreateMsgPort()
    if (u32)port == 0 {
        println("FAILED!")
        return 1
    }
    println("OK")

    // Step 2: Create an IOStdReq for communicating with the device
    // IOStdReq is the standard I/O request with io_Data, io_Length, io_Actual
    print("Creating IOStdReq... ")
    let req = CreateIORequest(port, @sizeof(IOStdReq))
    if (u32)req == 0 {
        println("FAILED!")
        DeleteMsgPort(port)
        return 1
    }
    let ioReq = (*IOStdReq)req
    let baseReq = (*IORequest)req
    println("OK")

    // Step 3: Open the device (unit 0)
    print("Opening {{PROJECT_NAME}}.device unit 0... ")
    let error = unsafe { OpenDevice("{{PROJECT_NAME}}.device", 0, baseReq, 0) }
    if error != 0 {
        println("FAILED!")
        println("Make sure {{PROJECT_NAME}}.device is in DEVS:")
        DeleteIORequest(req)
        DeleteMsgPort(port)
        return 1
    }
    println("OK")

    // Step 4: Send commands to the device
    println("")
    println("Sending commands:")

    // Reset the device
    print("  CMD_RESET... ")
    unsafe {
        (*ioReq).io_Command = CMD_RESET
    }
    let result = unsafe { DoIO(baseReq) }
    if result == 0 {
        println("OK")
    } else {
        println("FAILED")
    }

    // Configure the device
    print("  CMD_CONFIG... ")
    unsafe {
        (*ioReq).io_Command = NOVUS_CMD_CONFIG
        (*ioReq).io_Data = null
        (*ioReq).io_Length = 0
    }
    let result2 = unsafe { DoIO(baseReq) }
    if result2 == 0 {
        println("OK")
    } else {
        println("FAILED")
    }

    // Get device status
    print("  CMD_STATUS... ")
    unsafe {
        (*ioReq).io_Command = NOVUS_CMD_STATUS
    }
    let result3 = unsafe { DoIO(baseReq) }
    if result3 == 0 {
        print("OK (status = ")
        unsafe {
            if (*ioReq).io_Actual == 1 {
                print("initialized")
            } else {
                print("not initialized")
            }
        }
        println(")")
    } else {
        println("FAILED")
    }

    // Step 5: Close the device
    println("")
    print("Closing device... ")
    unsafe { CloseDevice(baseReq) }
    println("OK")

    // Step 6: Clean up resources
    print("Cleaning up... ")
    DeleteIORequest(req)
    DeleteMsgPort(port)
    println("OK")

    println("")
    println("Example completed successfully!")
    return 0
}

// For a deferred command, use the same request asynchronously:
//
// unsafe {
//     (*ioReq).io_Command = 11
//     SendIO(baseReq)
// }
//
// // Do unrelated work here. CheckIO never waits.
// if (u32)CheckIO(baseReq) == 0 {
//     println("command is still pending")
// }
//
// // Every SendIO must eventually be collected, even after AbortIO.
// // let error = WaitIO(baseReq)
// // unsafe { AbortIO(baseReq) }
// // let aborted = WaitIO(baseReq)
