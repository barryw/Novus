// {{PROJECT_NAME}}.device - AmigaOS device driver
//
// This device uses the @device attribute to automatically generate:
//   - DevInit, DevOpen, DevClose, DevExpunge (lifecycle functions)
//   - DevBeginIO (command dispatcher)
//   - DevAbortIO (abort handler)
//   - Unit management (per-unit state)
//   - ROMTag for exec.library scanning
//
// You implement command handlers using @devicecmd attributes.
// The compiler generates the dispatcher that routes io_Command to your handlers.

from std::ffi::amiga_structs import IORequest, Unit
from std::ffi::amiga_consts import IOERR_NOCMD

// ============================================================================
// Device Base Structure
// ============================================================================
// The @device attribute marks this struct as the device base.
//
// Parameters:
//   name  - Device filename (must end with ".device")
//   units - Maximum number of units this device supports (default: 1)
//
// The compiler generates a device base structure that includes:
//   - struct Device dev          (standard Exec device header)
//   - BPTR dev_SegList           (segment list for unloading)
//   - Unit* dev_Units[N]         (per-unit state pointers)
//   - Statistics counters
//   - Your custom fields below

@device(name = "{{PROJECT_NAME}}.device", units = 4)
pub struct MyDevice {
    // Add custom device state fields here.
    // These are allocated once when the device is loaded and persist
    // until the device is expunged from memory.
    //
    // Example fields:
    initialized: bool,
    buffer_ptr: *u8,
    buffer_size: u32,
}

// ============================================================================
// Custom Command Constants
// ============================================================================
// Standard commands (CMD_*) are 0-8. Your custom commands start at 9 (CMD_NONSTD).

pub const CMD_MYDEVICE_STATUS: u16 = 9
pub const CMD_MYDEVICE_CONFIG: u16 = 10

// ============================================================================
// Command Handlers
// ============================================================================
// Mark functions with @devicecmd to register them as command handlers.
// The BeginIO dispatcher calls these based on ioReq->io_Command.
//
// Handler signature:
//   fn handler(ioReq: *IORequest, base: *MyDevice) -> i8
//
// Return values:
//   0 = success (IOERR_SUCCESS)
//   -1 = open failed (IOERR_OPENFAIL)
//   -2 = aborted (IOERR_ABORTED)
//   -3 = unknown command (IOERR_NOCMD)
//   -4 = bad length (IOERR_BADLENGTH)
//   -5 = bad address (IOERR_BADADDRESS)
//   -6 = unit busy (IOERR_UNITBUSY)

impl MyDevice {
    // ========================================================================
    // STANDARD COMMAND HANDLERS
    // ========================================================================
    // Implement handlers for standard Exec commands as needed.

    // CMD_RESET (1) - Reset device to initial state
    @devicecmd(cmd = "CMD_RESET")
    pub fn cmd_reset(ioReq: *IORequest, base: *MyDevice) -> i8 {
        unsafe {
            (*base).initialized = false
            (*base).buffer_ptr = null
            (*base).buffer_size = 0
        }
        return 0  // Success
    }

    // CMD_READ (2) - Read data from device
    @devicecmd(cmd = "CMD_READ")
    pub fn cmd_read(ioReq: *IORequest, base: *MyDevice) -> i8 {
