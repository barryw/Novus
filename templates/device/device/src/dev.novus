// {{PROJECT_NAME}}.device - minimal Novus device driver
//
// The compiler generates the resident tag, lifecycle vectors, unit handling,
// BeginIO dispatcher, AbortIO handler, and A6 wrappers. Application code only
// defines persistent state and command handlers.

from amiga::raw::structs import IORequest, IOStdReq
from amiga::raw::consts import CMD_RESET
from amiga::raw::exec import ReplyMsg

@device(name = "{{PROJECT_NAME}}.device", units = 1)
pub struct DeviceState {
    configured: bool,
    command_count: u32,
}

@devicecmd(cmd = "CMD_RESET", quick = true)
pub fn reset(io_req: *IORequest, state: *DeviceState) -> i8 {
    unsafe {
        (*state).configured = false
        (*state).command_count++
    }
    return 0
}

@devicecmd(cmd = 9, quick = true)
pub fn status(io_req: *IORequest, state: *DeviceState) -> i8 {
    unsafe {
        (*state).command_count++
        let std_req = (*IOStdReq)io_req
        (*std_req).io_Actual = if (*state).configured { 1 } else { 0 }
    }
    return 0
}

@devicecmd(cmd = 10, quick = true)
pub fn configure(io_req: *IORequest, state: *DeviceState) -> i8 {
    unsafe {
        (*state).configured = true
        (*state).command_count++
    }
    return 0
}

// Optional lifecycle hooks. Remove any hook the device does not need; Exec's
// open counts, delayed expunge, and base allocation remain compiler-owned.
@deviceinit
pub fn loaded(state: *DeviceState) -> bool { return true }

@deviceopen
pub fn opening(io_req: *IORequest, state: *DeviceState,
               unit: u32, flags: u32) -> bool { return true }

@deviceclose
pub fn closing(io_req: *IORequest, state: *DeviceState) {}

@deviceexpunge
pub fn unloading(state: *DeviceState) {}

// A deferred handler owns its request and must eventually reply. Real devices
// normally do that from a worker task or interrupt; this tiny command completes
// immediately while exercising the same SendIO/WaitIO ownership contract.
@devicecmd(cmd = 11, deferred = true)
pub fn async_ping(io_req: *IORequest, state: *DeviceState) -> i8 {
    unsafe { ReplyMsg(&var (*io_req).io_Message) }
    return 0
}

// This command deliberately remains pending until AbortIO. It gives generated
// projects a runnable cancellation example without inventing a worker task.
@devicecmd(cmd = 12, deferred = true)
pub fn wait_for_abort(io_req: *IORequest, state: *DeviceState) -> i8 {
    return 0
}

@abortio
pub fn abort_pending(io_req: *IORequest, state: *DeviceState) -> bool {
    return true
}
