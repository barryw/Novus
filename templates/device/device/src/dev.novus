        return (i8)IOERR_NOCMD  // Not implemented yet
    }

    // CMD_WRITE (3) - Write data to device
    @devicecmd(cmd = "CMD_WRITE")
    pub fn cmd_write(ioReq: *IORequest, base: *MyDevice) -> i8 {
        // Access IORequest fields:
        //   ioReq->io_Data   - source buffer pointer
        //   ioReq->io_Length - data length
        //   ioReq->io_Actual - set this to actual bytes written

        // TODO: Implement your write logic here

        return (i8)IOERR_NOCMD  // Not implemented yet
    }

    // ========================================================================
    // CUSTOM COMMAND HANDLERS
    // ========================================================================
    // Your device-specific commands start at CMD_NONSTD (9).

    // Custom status command - returns device status
    // quick = true means this can complete immediately without waiting
    @devicecmd(cmd = 9, quick = true)
    pub fn cmd_status(ioReq: *IORequest, base: *MyDevice) -> i8 {
        // Return device status in io_Actual
        unsafe {
            if (*base).initialized {
                (*ioReq).io_Actual = 1
            } else {
                (*ioReq).io_Actual = 0
            }
        }
        return 0  // Success
    }

    // Custom config command - configure device
    @devicecmd(cmd = 10)
    pub fn cmd_config(ioReq: *IORequest, base: *MyDevice) -> i8 {
        // Use io_Data as configuration pointer
        // Use io_Length as configuration size

        unsafe {
            (*base).initialized = true
        }

        return 0  // Success
    }

    // ========================================================================
    // OPTIONAL LIFECYCLE OVERRIDES
    // ========================================================================
    // The compiler auto-generates lifecycle functions. You only need to
    // implement them if you require custom initialization or cleanup logic.
    //
    // Unlike libraries, devices have these lifecycle functions:
    //   - dev_init()    - Called when device first loads
    //   - dev_open()    - Called for each OpenDevice()
    //   - dev_close()   - Called for each CloseDevice()
    //   - dev_expunge() - Called when device should unload
    //
    // BeginIO and AbortIO are generated automatically based on your
    // @devicecmd handlers - you don't need to implement them directly.

