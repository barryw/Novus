// Example CLI program demonstrating proper argument handling
// Works correctly when launched from both Shell (CLI) and Workbench
//
// Launch from Shell:   myapp arg1 arg2 arg3
// Launch from Workbench: Double-click icon (argc will be 0)

from std::dos import write, output
from std::system import CPU, FPU, Chipset

// Helper to convert C string to Novus string
extern fn strlen(s: *u8) -> u32

fn c_str_to_novus(c_str: *u8) -> Str {
    let len = strlen(c_str)
    return Str::from_raw(c_str, len)
}

// AmigaOS main function receives argc and argv as parameters
// When launched from Workbench, argc will be 0 and argv contains WBStartup pointer
// When launched from Shell, argc >= 1 and argv is a char** array
fn main(argc: i32, argv: **u8) -> i32 {
    // Detect launch environment
    // When launched from Workbench, argc will be 0
    // When launched from Shell, argc will be >= 1

    if argc == 0 {
        // Launched from Workbench
        // In this case, arguments come from the WBStartup message
        // which is automatically handled by the Novus runtime

        write(output(), "Launched from Workbench\n")
        write(output(), "No command-line arguments available\n")

        // Show hardware detection info instead
        write(output(), "\nDetected hardware:\n")
        write(output(), f"CPU: {CPU}\n")
        write(output(), f"FPU: {FPU}\n")
        write(output(), f"Chipset: {Chipset}\n")
    } else {
        // Launched from Shell/CLI
        write(output(), "Launched from Shell\n")
        write(output(), f"Arguments: {argc}\n")

        // Print all arguments
        var i: i32 = 0
        while i < argc {
            let arg_ptr = *(argv + i as u32)
            let arg = c_str_to_novus(arg_ptr)
            write(output(), f"  argv[{i}] = {arg}\n")
            i = i + 1
        }

        // Example: Parse arguments
        if argc > 1 {
            let command = c_str_to_novus(*(argv + 1))

            if command == "help" {
                show_help()
            } else if command == "version" {
                show_version()
            } else {
                write(output(), f"Unknown command: {command}\n")
                write(output(), "Try: myapp help\n")
                return 1
            }
        }
    }

    return 0
}

fn show_help() {
    write(output(), "Usage: myapp [command]\n")
    write(output(), "\n")
    write(output(), "Commands:\n")
    write(output(), "  help     Show this help message\n")
    write(output(), "  version  Show version information\n")
}

fn show_version() {
    write(output(), "myapp version 1.0.0\n")
    write(output(), "Built with Novus for AmigaOS\n")
}
