// CLI application that also starts safely from Workbench.

from std::args::args import Args, is_workbench
from std::io::file import write

pub fn main() -> i32 {
    if is_workbench() {
        write("{{PROJECT_NAME}} started from Workbench\n")
        return 0
    }

    let parsed = Args::parse("NAME,VERBOSE/S")
    match parsed {
        Result::Ok(args) => {
            write("{{PROJECT_NAME}} started from the CLI\n")
            if args.get_switch("VERBOSE") {
                write("verbose mode enabled\n")
            }
            match args.get_str("NAME") {
                Some(name) => write("hello, {name}\n"),
                None => {},
            }
            return 0
        },
        Result::Err(_) => return 20,
    }
}
