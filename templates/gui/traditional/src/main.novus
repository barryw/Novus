// Traditional Intuition application using Novus's owning window wrapper.

from amiga::sys::intuition import WindowHandle, WindowEvent

pub fn main() -> i32 {
    match WindowHandle::simple("{{PROJECT_NAME}}", 480, 160) {
        Result::Ok(window) => {
            var running = true
            while running {
                match window.wait_event() {
                    WindowEvent::Close => { running = false },
                    _ => {},
                }
            }
            return 0
        },
        Result::Err(_) => return 20,
    }
}
