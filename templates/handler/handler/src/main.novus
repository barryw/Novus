// {{PROJECT_NAME}} - minimal AmigaDOS packet handler
//
// The handler startup leaves the initial StandardPacket on the process port.
// Packet owns every received request and replies ERROR_ACTION_NOT_KNOWN on Drop
// if a branch accidentally forgets to answer it.

from amiga::sys::dos import Packet
from amiga::raw::consts import ACTION_STARTUP, ACTION_DIE
from amiga::raw::consts import DOSTRUE, DOSFALSE, ERROR_ACTION_NOT_KNOWN

@suppress("W0002", "AmigaDOS ACTION and result constants fit their signed packet fields")
pub fn main() -> i32 {
    var running = true
    while running {
        var packet = Packet::wait()
        match packet.action() {
            action if action == ACTION_STARTUP as i32 => {
                // Initialize volumes, locks, and handler state here.
                packet.reply(DOSTRUE as i32, 0)
            },
            action if action == ACTION_DIE as i32 => {
                // Reject this request while locks/files are still outstanding.
                packet.reply(DOSTRUE as i32, 0)
                running = false
            },
            _ => {
                packet.reply(DOSFALSE as i32, ERROR_ACTION_NOT_KNOWN as i32)
            },
        }
    }
    return 0
}
