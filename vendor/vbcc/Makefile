.PHONY: all clean install

INSTALL_DIR ?= /opt/vbcc

# NOTE: dt.h and dt.c must be pre-generated in vbcc/machines/m68k/ before building.
# These files define target-specific type sizes and are generated by vbcc/bin/dtgen
# from machines/m68k/machine.dt (requires interactive input, so we commit generated files).

all:
	@mkdir -p bin vbcc/bin vasm/obj vlink/objects 2>/dev/null || true
	# Touch pre-generated dt.h/dt.c so make doesn't try to regenerate (requires interactive input)
	@touch vbcc/machines/m68k/dt.h vbcc/machines/m68k/dt.c 2>/dev/null || true
	@(cd vbcc; make TARGET=m68k)
	@(cd vasm; make CPU=m68k SYNTAX=mot)
	@(cd vlink; make)
	@mkdir -p bin 2> /dev/null || true
	@cp vbcc/bin/vc vbcc/bin/vbccm68k vbcc/bin/vprof bin/ 2>/dev/null || true
	@cp vasm/vasmm68k_mot vasm/vobjdump bin/
	@cp vlink/vlink bin/

clean:
	@(cd vasm; make clean)
	@(cd vlink; make clean)
	@(cd vbcc; rm -rf machines/*/opt.o machines/*/av.o machines/*/rd.o machines/*/regs.o machines/*/flow.o machines/*/cse.o machines/*/cp.o machines/*/loop.o machines/*/alias.o machines/*/range.o machines/*/main.o machines/*/vars.o machines/*/declaration.o machines/*/parse_expr.o machines/*/type_expr.o machines/*/ic.o machines/*/machine.o machines/*/statements.o machines/*/supp.o machines/*/dt.o machines/*/assert.o machines/*/cpp.o machines/*/hash.o machines/*/lexer.o machines/*/macro.o machines/*/mem.o machines/*/eval.o bin/vc bin/vbccm68k bin/vprof)
	@rm -rf bin

install:
	@mkdir -p $(INSTALL_DIR) 2> /dev/null
	@cp -R targets $(INSTALL_DIR)/
	@cp -R config $(INSTALL_DIR)/
	@cp -R bin $(INSTALL_DIR)/
	@cp -R docs $(INSTALL_DIR)/
	@echo vbcc installed in $(INSTALL_DIR)
	@echo "NOTE: NDK must be obtained separately due to copyright restrictions"
