.PHONY: all clean install

INSTALL_DIR ?= /opt/vbcc

# NOTE: dt.h and dt.c must be pre-generated in vbcc/machines/m68k/ before building.
# These files define target-specific type sizes and are generated by vbcc/bin/dtgen
# from machines/m68k/machine.dt (requires interactive input, so we commit generated files).

all:
	@(cd vbcc; make TARGET=m68k)
	@(cd vasm; make CPU=m68k SYNTAX=mot)
	@(cd vlink; make)
	@mkdir -p bin 2> /dev/null || true
	@cp vbcc/bin/vc vbcc/bin/vbccm68k vbcc/bin/vprof bin/ 2>/dev/null || true
	@cp vasm/vasmm68k_mot vasm/vobjdump bin/
	@cp vlink/vlink bin/

clean:
	@(cd vasm; make clean)
	@(cd vlink; make clean)
	# TODO(asigner): Add make clean for vbcc
	@rm -rf bin

install:
	@mkdir -p $(INSTALL_DIR) 2> /dev/null
	@cp -R targets $(INSTALL_DIR)/
	@cp -R config $(INSTALL_DIR)/
	@cp -R bin $(INSTALL_DIR)/
	@cp -R docs $(INSTALL_DIR)/
	@cp -R ndks $(INSTALL_DIR)/
	@echo vbcc installed in $(INSTALL_DIR)
