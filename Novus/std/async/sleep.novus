// Novus Standard Library - Async Sleep
// Namespace: std::async::sleep
//
// Non-blocking sleep using timer.device.
// The CPU sleeps during the wait - zero busy-polling.

from std::core import Option, Result, Drop
from std::async::future import Future, Poll, Context, Waker
from amiga::timer import Duration, TimerError
from amiga::raw::structs import timeval, timerequest, IORequest, MsgPort
from amiga::raw::exec import CreateIORequest, DeleteIORequest, CreateMsgPort, DeleteMsgPort
from amiga::raw::exec import OpenDevice, CloseDevice, SendIO, CheckIO, WaitIO, AbortIO, Signal
from amiga::raw::consts import UNIT_MICROHZ, TR_ADDREQUEST

// ============================================================================
// Sleep Future
// ============================================================================

/// A future that completes after a duration has elapsed.
///
/// This is the async equivalent of `TimerHandle::delay()`, but it doesn't
/// block - instead, it returns `Poll::Pending` and signals the executor
/// when the time is up.
///
/// # Example
///
/// ```novus
/// async fn delayed_hello() {
///     write("Hello...\n")
///     sleep(Duration::secs(2)).await
///     write("...World!\n")
/// }
/// ```
pub struct Sleep {
    /// The duration value stored by `Sleep`.
    duration: Duration,
    /// The unit value stored by `Sleep`.
    unit: u32,
    /// The timereq value stored by `Sleep`.
    timereq: *timerequest,
    /// The port value stored by `Sleep`.
    port: *MsgPort,
    /// The state value stored by `Sleep`.
    state: SleepState,
}

enum SleepState {
    /// Not yet started
    Init,
    /// Timer request sent, waiting for completion
    Waiting,
    /// Completed successfully
    Done,
    /// Resource allocation failed
    FailedNoMemory,
    /// timer.device could not be opened
    FailedOpen,
}

impl Sleep {
    /// Create a new sleep future for the given duration.
    ///
    /// The timer doesn't start until the future is first polled.
    pub fn new(duration: Duration) -> Sleep {
        return Sleep::with_unit(duration, UNIT_MICROHZ)
    }

    /// Create a sleep using a specific timer.device unit.
    /// Most applications should use `new`; this supports alternate timer units.
    pub fn with_unit(duration: Duration, unit: u32) -> Sleep {
        return Sleep {
            duration: duration,
            unit: unit,
            timereq: null,
            port: null,
            state: SleepState::Init,
        }
    }

    /// Initialize timer resources (called on first poll)
    fn init_timer(&var self) -> Result<(), TimerError> {
        // Create message port
        let port = CreateMsgPort()
        if (u32)port == 0 {
            self.state = SleepState::FailedNoMemory
            return Result::Err(TimerError::NoMemory)
        }
        self.port = port

        // Create IORequest
        let req = CreateIORequest(port, @sizeof(timerequest))
        if (u32)req == 0 {
            DeleteMsgPort(port)
            self.port = null
            self.state = SleepState::FailedNoMemory
            return Result::Err(TimerError::NoMemory)
        }
        self.timereq = (*timerequest)req

        // Open timer.device
        unsafe {
            let ioreq_ptr = &self.timereq.tr_node
            let ioreq = (*IORequest)ioreq_ptr
            let error = OpenDevice("timer.device", self.unit, ioreq, 0)
            if error != 0 {
                DeleteIORequest((*u8)self.timereq)
                DeleteMsgPort(self.port)
                self.timereq = null
                self.port = null
                self.state = SleepState::FailedOpen
                return Result::Err(TimerError::OpenFailed)
            }
        }

        return Result::Ok(())
    }

    /// Start the async timer request
    fn start_timer(&var self) {
        // Set up the timer request
        self.timereq.tr_node.io_Command = (u16)TR_ADDREQUEST
        self.timereq.tr_time = timeval {
            tv_secs: self.duration.get_secs(),
            tv_micro: self.duration.get_micros(),
        }

        // The reply will come to our port, which will signal the waker's task
        // We need to set up the port to signal the correct task/signal
        // For now, we rely on the executor checking our port

        // Send the request (non-blocking)
        let ioreq_ptr = &self.timereq.tr_node
        let ioreq = (*IORequest)ioreq_ptr
        SendIO(ioreq)

        self.state = SleepState::Waiting
    }

    /// Check if the timer has completed
    fn check_done(&var self) -> bool {
        let ioreq_ptr = &self.timereq.tr_node
        let ioreq = (*IORequest)ioreq_ptr
        if (u32)CheckIO(ioreq) != 0 {
            // Timer completed - clean up the request
            WaitIO(ioreq)
            self.state = SleepState::Done
            return true
        }
        return false
    }

    /// Clean up timer resources
    fn cleanup(&var self) {
        if (u32)self.timereq != 0 {
            let ioreq_ptr = &self.timereq.tr_node
            let ioreq = (*IORequest)ioreq_ptr

            // Abort if still pending
            if matches!(self.state, SleepState::Waiting) {
                AbortIO(ioreq)
                WaitIO(ioreq)
            }

            // Close device
            unsafe {
                CloseDevice(ioreq)
            }

            // Free request
            DeleteIORequest((*u8)self.timereq)
            self.timereq = null
        }

        if (u32)self.port != 0 {
            DeleteMsgPort(self.port)
            self.port = null
        }
    }

    /// Poll helper for Init state
    fn poll_init(&var self, ctx: &var Context) -> Poll<Result<(), TimerError>> {
        // First poll - initialize and start
        match self.init_timer() {
            Result::Err(error) => return Poll::Ready(Result::Err(error)),
            Result::Ok(_) => {},
        }
        // Wire up our port to signal the waker
        // The MsgPort has mp_SigTask and mp_SigBit we can set
        let waker = ctx.waker()
        self.port.mp_SigTask = (*u8)waker.task()
        self.port.mp_SigBit = (u8)waker.signal_bit()

        self.start_timer()

        return Poll::Pending
    }

    /// Poll helper for Waiting state
    fn poll_waiting(&var self) -> Poll<Result<(), TimerError>> {
        // Check if timer completed
        if self.check_done() {
            return Poll::Ready(Result::Ok(()))
        }
        return Poll::Pending
    }

    /// Poll the sleep future to check if the timer has elapsed.
    ///
    /// Returns `Poll::Ready(Result::Ok(()))` when the sleep is complete.
    /// Returns `Poll::Ready(Result::Err(error))` when timer setup fails.
    /// Returns `Poll::Pending` if still waiting.
    pub fn poll(&var self, ctx: &var Context) -> Poll<Result<(), TimerError>> {
        match self.state {
            SleepState::Init => return self.poll_init(ctx),
            SleepState::Waiting => return self.poll_waiting(),
            SleepState::Done => return Poll::Ready(Result::Ok(())),
            SleepState::FailedNoMemory => return Poll::Ready(Result::Err(TimerError::NoMemory)),
            SleepState::FailedOpen => return Poll::Ready(Result::Err(TimerError::OpenFailed)),
        }
    }
}

impl Future<Result<(), TimerError>> for Sleep {
    fn poll(&var self, ctx: &var Context) -> Poll<Result<(), TimerError>> {
        match self.state {
            SleepState::Init => return self.poll_init(ctx),
            SleepState::Waiting => return self.poll_waiting(),
            SleepState::Done => return Poll::Ready(Result::Ok(())),
            SleepState::FailedNoMemory => return Poll::Ready(Result::Err(TimerError::NoMemory)),
            SleepState::FailedOpen => return Poll::Ready(Result::Err(TimerError::OpenFailed)),
        }
    }
}

impl Drop for Sleep {
    fn drop(&var self) {
        self.cleanup()
    }
}

// ============================================================================
// Convenience function
// ============================================================================

/// Create a sleep future for the given duration.
///
/// This is the primary way to pause async execution.
///
/// # Example
///
/// ```novus
/// from std::async import block_on, sleep
/// from amiga::timer import Duration
///
/// fn main() -> i32 {
///     block_on(async {
///         write("Starting countdown...\n")
///
///         while var i = 5; i > 0 {
///             write("%ld...\n", i)
///             sleep(Duration::secs(1)).await
///             i--
///         }
///
///         write("Blast off!\n")
///     })
///     return 0
/// }
/// ```
pub fn sleep(duration: Duration) -> Sleep {
    return Sleep::new(duration)
}

/// Sleep for the given number of seconds
pub fn sleep_secs(secs: u32) -> Sleep {
    return Sleep::new(Duration::secs(secs))
}

/// Sleep for the given number of milliseconds
pub fn sleep_millis(ms: u32) -> Sleep {
    return Sleep::new(Duration::millis(ms))
}

/// Sleep for the given number of microseconds
pub fn sleep_micros(us: u32) -> Sleep {
    return Sleep::new(Duration::micros(us))
}
