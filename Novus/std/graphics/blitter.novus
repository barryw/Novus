// Blitter API for Amiga Custom Chip
// Module: std::graphics::blitter
//
// Provides type-safe blitter operations for common use cases.
// Uses direct hardware access for optimal performance.
//
// Example:
//   BlitterOps::copy_rect(&src_bitmap, 0, 0, &var dst_bitmap, 100, 50, 64, 32)?
//   BlitterOps::fill_rect(&var bitmap, 10, 10, 100, 50, $AAAA)?
//   BlitterOps::draw_line(&var bitmap, 0, 0, 319, 199, $FFFF)?
//   BlitterOps::copy_masked(&src, &mask, 0, 0, &var dst, 100, 50, 32, 32)?

from std::core import Option, Result, Drop, Error
from std::ffi::exec import TypeOfMem
from std::ffi::amiga_consts import MEMF_CHIP
from std::ffi::amiga_structs import BitMap
from std::ffi::graphics import OwnBlitter, DisownBlitter, WaitBlit
from std::hardware::registers import CUSTOM_BASE, BLTCON0, BLTCON1, BLTAFWM, BLTALWM, BLTAPT, BLTBPT, BLTCPT, BLTDPT, BLTSIZE, BLTAMOD, BLTBMOD, BLTCMOD, BLTDMOD, BLTADAT, BLTBDAT, BLTCDAT
from std::graphics::bitmap import BitMapHandle

// ============================================================================
// Minterm Constants
// ============================================================================

// Minterms define how the blitter combines sources A, B, C to produce D.
// Each bit in the minterm corresponds to one of 8 combinations of ABC.
// Bit 7: ABC=111, Bit 6: ABC=110, ..., Bit 0: ABC=000

/// D = A (simple copy from A channel)
pub const MINTERM_COPY: u8 = $F0

/// D = (A & B) | (~A & C) - Cookie cut / masked blit
/// Where A=mask, B=source image, C=background
pub const MINTERM_COOKIE_CUT: u8 = $CA

/// D = ~A (invert source)
pub const MINTERM_INVERT: u8 = $0F

/// D = A | C (OR source with background)
pub const MINTERM_OR: u8 = $FC

/// D = A & C (AND source with background)
pub const MINTERM_AND: u8 = $C0

/// D = A ^ C (XOR source with background)
pub const MINTERM_XOR: u8 = $3C

/// D = 1 (solid fill with all 1s)
pub const MINTERM_SET: u8 = $FF

/// D = 0 (clear to zero)
pub const MINTERM_CLEAR: u8 = $00

/// D = B (copy B channel)
pub const MINTERM_COPY_B: u8 = $CC

/// D = C (copy C channel / preserve destination)
pub const MINTERM_COPY_C: u8 = $AA

/// D = A | B (OR A and B channels)
pub const MINTERM_OR_AB: u8 = $FC

/// Line drawing minterm: D = (A & B) | C
/// Standard for blitter line mode - draws where pattern (B) is set
pub const MINTERM_LINE: u8 = $CA

// ============================================================================
// Channel Enable Constants (for BLTCON0)
// ============================================================================

/// Enable source A DMA (SRCA) - bit 11
pub const BLTCON0_SRCA: u16 = $0800

/// Enable source B DMA (SRCB) - bit 10
pub const BLTCON0_SRCB: u16 = $0400

/// Enable source C DMA (SRCC) - bit 9
pub const BLTCON0_SRCC: u16 = $0200

/// Enable destination D DMA (DEST) - bit 8
pub const BLTCON0_DEST: u16 = $0100

// ============================================================================
// BLTCON1 Control Constants
// ============================================================================

/// Line mode enable (bit 0)
pub const BLTCON1_LINE: u16 = $0001

/// Descending mode - blit from bottom-right to top-left (bit 1)
pub const BLTCON1_DESC: u16 = $0002

/// Fill Carry Input (bit 2) - for area fill
pub const BLTCON1_FCI: u16 = $0004

/// Inclusive fill mode - IFE (bit 3)
pub const BLTCON1_IFE: u16 = $0008

/// Exclusive fill mode - EFE (bit 4)
pub const BLTCON1_EFE: u16 = $0010

/// Single-pixel mode for line drawing - SING (bit 1 in line mode context)
/// Note: In line mode, bit 1 becomes SING instead of DESC
pub const BLTCON1_SING: u16 = $0002

// ============================================================================
// Line Drawing Octant Flags (for BLTCON1)
// ============================================================================
// These control the direction of line drawing in each octant.
// Reference: Amiga Hardware Reference Manual, Chapter 6

/// SUD flag (bit 2) - Sign of dY (up/down direction)
pub const BLTCON1_SUD: u16 = $0004

/// SUL flag (bit 3) - Sign of dX when steep
pub const BLTCON1_SUL: u16 = $0008

/// AUL flag (bit 4) - Sign of dX when not steep
pub const BLTCON1_AUL: u16 = $0010

/// SIGN flag (bit 6) - Set if initial error is negative
/// In line mode, this tells the blitter which direction to move first
pub const BLTCON1_SIGN: u16 = $0040

// Pre-computed octant flags lookup table
// Octant is determined by: steep (dy>dx), dx sign, dy sign
// Index = (steep ? 1 : 0) | (dx_neg ? 2 : 0) | (dy_neg ? 4 : 0)
// However, the Amiga uses a different octant numbering, so we use a lookup.

// ============================================================================
// Blitter Error Types
// ============================================================================

/// Errors that can occur during blitter operations
pub enum BlitterError {
    /// Pointer is not in chip RAM (blitter requires chip RAM)
    NotChipRam,
    /// Pointer is not word-aligned (must be even address)
    InvalidAlignment,
    /// Width or height is out of valid range (max 1024 pixels, 64 words)
    InvalidDimensions,
    /// Source and destination rectangles don't fit in their bitmaps
    OutOfBounds,
    /// Bitmap depths don't match for the operation
    DepthMismatch,
    /// Operation failed for unknown reason
    OperationFailed,
}

impl BlitterError {
    pub fn message(&self) -> *u8 {
        match *self {
            BlitterError::NotChipRam => return "Pointer is not in chip RAM",
            BlitterError::InvalidAlignment => return "Pointer is not word-aligned",
            BlitterError::InvalidDimensions => return "Dimensions out of valid range",
            BlitterError::OutOfBounds => return "Rectangle out of bitmap bounds",
            BlitterError::DepthMismatch => return "Bitmap depths don't match",
            BlitterError::OperationFailed => return "Blitter operation failed",
        }
    }
}

impl Error for BlitterError {
    fn message(&self) -> *u8 {
        return BlitterError::message(self)
    }
}

// ============================================================================
// Blit Operation Enum
// ============================================================================

/// Specifies the logical operation for blitter copy operations
pub enum BlitOp {
    /// D = A (simple copy)
    Copy,
    /// D = A | C (OR with background)
    Or,
    /// D = A ^ C (XOR with background - useful for cursors)
    Xor,
    /// D = A & C (AND with background)
    And,
    /// D = ~A (invert source)
    Invert,
}

// ============================================================================
// BlitterGuard - RAII Blitter Ownership
// ============================================================================

/// RAII guard that ensures proper blitter ownership arbitration.
///
/// The Amiga blitter is a shared resource between user programs, the system,
/// and the copper. Before using the blitter, you MUST acquire exclusive access
/// by calling OwnBlitter(). This guard ensures the blitter is properly acquired
/// on creation and released on drop, even in error paths.
///
/// # Important
/// Always use BlitterGuard before any direct blitter hardware operations.
/// Failure to do so can cause crashes when the system or copper attempts to
/// use the blitter simultaneously.
///
/// # Example
/// ```novus
/// {
///     let guard = BlitterGuard::acquire()
///     // ... perform blitter operations ...
///     // Blitter is automatically released when guard goes out of scope
/// }
/// ```
///
/// # Safety
/// This guard calls WaitBlit() before releasing the blitter to ensure all
/// operations complete before ownership is transferred back to the system.
pub struct BlitterGuard {
    acquired: bool,
}

impl BlitterGuard {
    /// Acquire exclusive blitter ownership.
    ///
    /// This calls OwnBlitter() to gain exclusive access to the blitter hardware.
    /// The blitter will be automatically released when this guard is dropped.
    ///
    /// # Returns
    /// A BlitterGuard that will release the blitter on drop.
    pub fn acquire() -> BlitterGuard {
        OwnBlitter()
        return BlitterGuard { acquired: true }
    }

    /// Wait for the blitter to complete any pending operations.
    ///
    /// This is a non-destructive wait - the guard remains valid and the
    /// blitter remains owned by this guard.
    pub fn wait(&self) {
        if self.acquired {
            WaitBlit()
        }
    }

    /// Check if the blitter is currently busy (non-blocking).
    ///
    /// Returns true if the blitter is still processing, false if idle.
    @suppress("W0001", "Hardware register access")
    pub fn is_busy(&self) -> bool {
        unsafe {
            let dmaconr: *u16 = (*u16)(CUSTOM_BASE + $002)
            let status: u16 = *dmaconr
            return (status & $4000) != 0
        }
    }
}

impl Drop for BlitterGuard {
    /// Automatically releases blitter ownership when guard goes out of scope.
    ///
    /// This waits for the blitter to complete (WaitBlit) and then releases
    /// ownership (DisownBlitter), ensuring safe cleanup even in error paths.
    fn drop(&var self) {
        if self.acquired {
            WaitBlit()
            DisownBlitter()
            self.acquired = false
        }
    }
}

// ============================================================================
// BlitHandle - Async operation handle (DEPRECATED - use BlitterGuard)
// ============================================================================

/// Handle for an in-progress blitter operation
/// When dropped, waits for completion and releases the blitter
///
/// # Deprecated
/// This type is deprecated in favor of BlitterGuard which provides clearer
/// RAII semantics and better error handling. Use BlitterGuard::acquire() instead.
pub struct BlitHandle {
    owns_blitter: bool,
}

impl BlitHandle {
    /// Create a new blit handle (internal use)
    pub fn new() -> BlitHandle {
        return BlitHandle { owns_blitter: true }
    }

    /// Wait for the blitter to finish
    pub fn wait(&var self) {
        if self.owns_blitter {
            WaitBlit()
        }
    }

    /// Check if the blitter is still busy (non-blocking)
    @suppress("W0001", "Hardware register access")
    pub fn is_busy(&self) -> bool {
        unsafe {
            let dmaconr: *u16 = (*u16)(CUSTOM_BASE + $002)
            let status: u16 = *dmaconr
            return (status & $4000) != 0
        }
    }
}

impl Drop for BlitHandle {
    fn drop(&var self) {
        if self.owns_blitter {
            WaitBlit()
            DisownBlitter()
            self.owns_blitter = false
        }
    }
}

// ============================================================================
// BlitterOps - High-Level Operations
// ============================================================================

/// High-level blitter operations for common use cases
pub struct BlitterOps {}

impl BlitterOps {
    // ========================================================================
    // Rectangle Copy Operations
    // ========================================================================

    /// Copy a rectangular region from source to destination bitmap
    ///
    /// Copies all bitplanes. For overlapping regions in the same bitmap,
    /// automatically uses descending blit direction when needed.
    ///
    /// Parameters:
    ///   src: Source bitmap handle
    ///   sx, sy: Source top-left corner (pixels)
    ///   dst: Destination bitmap handle
    ///   dx, dy: Destination top-left corner (pixels)
    ///   width: Width in pixels (rounded up to word boundary)
    ///   height: Height in rows (max 1024)
    ///
    /// Returns: Ok(()) on success, Err(BlitterError) on failure
    @suppress("W0001", "Integer calculations are safe")
    pub fn copy_rect(
        src: &BitMapHandle, sx: u16, sy: u16,
        dst: &var BitMapHandle, dx: u16, dy: u16,
        width: u16, height: u16
    ) -> Result<(), BlitterError> {
        return BlitterOps::copy_rect_op(src, sx, sy, dst, dx, dy, width, height, BlitOp::Copy)
    }

    /// Copy with specified logical operation (OR, XOR, AND, etc.)
    @suppress("W0001", "Integer calculations are safe")
    pub fn copy_rect_op(
        src: &BitMapHandle, sx: u16, sy: u16,
        dst: &var BitMapHandle, dx: u16, dy: u16,
        width: u16, height: u16,
        op: BlitOp
    ) -> Result<(), BlitterError> {
        let src_bm: *BitMap = src.handle()
        let dst_bm: *BitMap = dst.handle()

        if !src_bm || !dst_bm {
            return Result::Err(BlitterError::NotChipRam)
        }

        unsafe {
            let src_bytes_per_row: u16 = (*src_bm).BytesPerRow
            let dst_bytes_per_row: u16 = (*dst_bm).BytesPerRow
            let src_depth: u8 = (*src_bm).Depth
            let dst_depth: u8 = (*dst_bm).Depth

            // Use minimum depth
            var depth: u8 = src_depth
            if dst_depth < depth {
                depth = dst_depth
            }

            // Calculate word-aligned width
            let width_words: u16 = (width + 15) / 16
            if width_words < 1 || width_words > 64 {
                return Result::Err(BlitterError::InvalidDimensions)
            }
            if height < 1 || height > 1024 {
                return Result::Err(BlitterError::InvalidDimensions)
            }

            // Bounds checking
            let src_width_pixels: u16 = src_bytes_per_row * 8
            let dst_width_pixels: u16 = dst_bytes_per_row * 8
            if sx + width > src_width_pixels || sy + height > (u16)(*src_bm).Rows {
                return Result::Err(BlitterError::OutOfBounds)
            }
            if dx + width > dst_width_pixels || dy + height > (u16)(*dst_bm).Rows {
                return Result::Err(BlitterError::OutOfBounds)
            }

            // Calculate offsets
            let src_x_word: u16 = sx / 16
            let src_offset: u32 = ((u32)sy * (u32)src_bytes_per_row) + ((u32)src_x_word * 2)
            let dst_x_word: u16 = dx / 16
            let dst_offset: u32 = ((u32)dy * (u32)dst_bytes_per_row) + ((u32)dst_x_word * 2)

            // Determine if we need descending blit (for overlapping regions)
            // Descending is needed when dst is after src and they overlap
            var descending: bool = false
            let same_bitmap: bool = (u32)src_bm == (u32)dst_bm
            if same_bitmap {
                if dy > sy || (dy == sy && dx > sx) {
                    // Check if regions actually overlap
                    let src_end_y: u16 = sy + height
                    let dst_end_y: u16 = dy + height
                    let src_end_x: u16 = sx + width
                    let dst_end_x: u16 = dx + width

                    // Overlap if rectangles intersect
                    let overlap_x: bool = sx < dst_end_x && dx < src_end_x
                    let overlap_y: bool = sy < dst_end_y && dy < src_end_y
                    descending = overlap_x && overlap_y
                }
            }

            // Calculate modulos
            let src_mod: i16 = (i16)src_bytes_per_row - (i16)(width_words * 2)
            let dst_mod: i16 = (i16)dst_bytes_per_row - (i16)(width_words * 2)

            // Determine minterm based on operation
            var minterm: u8 = MINTERM_COPY
            var use_c_channel: bool = false
            match op {
                BlitOp::Copy => {
                    minterm = MINTERM_COPY
                },
                BlitOp::Or => {
                    minterm = MINTERM_OR
                    use_c_channel = true
                },
                BlitOp::Xor => {
                    minterm = MINTERM_XOR
                    use_c_channel = true
                },
                BlitOp::And => {
                    minterm = MINTERM_AND
                    use_c_channel = true
                },
                BlitOp::Invert => {
                    minterm = MINTERM_INVERT
                }
            }

            // Acquire blitter with RAII guard
            let guard = BlitterGuard::acquire()
            guard.wait()

            // Set up control registers
            var con0: u16 = BLTCON0_SRCA | BLTCON0_DEST | (u16)minterm
            if use_c_channel {
                con0 = con0 | BLTCON0_SRCC
            }

            var con1: u16 = 0
            if descending {
                con1 = BLTCON1_DESC
            }

            let con0_ptr: *u16 = (*u16)(CUSTOM_BASE + BLTCON0)
            let con1_ptr: *u16 = (*u16)(CUSTOM_BASE + BLTCON1)

            // Masks - full words
            let afwm_ptr: *u16 = (*u16)(CUSTOM_BASE + BLTAFWM)
            let alwm_ptr: *u16 = (*u16)(CUSTOM_BASE + BLTALWM)
            *afwm_ptr = $FFFF
            *alwm_ptr = $FFFF

            // Modulo pointers
            let amod_ptr: *i16 = (*i16)(CUSTOM_BASE + BLTAMOD)
            let cmod_ptr: *i16 = (*i16)(CUSTOM_BASE + BLTCMOD)
            let dmod_ptr: *i16 = (*i16)(CUSTOM_BASE + BLTDMOD)

            // Pointer registers
            let apt_ptr: *u32 = (*u32)(CUSTOM_BASE + BLTAPT)
            let cpt_ptr: *u32 = (*u32)(CUSTOM_BASE + BLTCPT)
            let dpt_ptr: *u32 = (*u32)(CUSTOM_BASE + BLTDPT)

            // Size register
            let bltsize: u16 = (height << 6) | width_words
            let size_ptr: *u16 = (*u16)(CUSTOM_BASE + BLTSIZE)

            // Blit each plane
            var plane: u8 = 0
            while plane < depth {
                let src_plane: *u8 = (*src_bm).Planes[plane]
                let dst_plane: *u8 = (*dst_bm).Planes[plane]

                // Calculate actual pointers
                var src_ptr_addr: u32 = (u32)src_plane + src_offset
                var dst_ptr_addr: u32 = (u32)dst_plane + dst_offset

                if descending {
                    // Start from bottom-right corner
                    let last_row: u32 = (u32)(height - 1)
                    let last_word: u32 = (u32)(width_words - 1) * 2
                    src_ptr_addr = (u32)src_plane + src_offset + (last_row * (u32)src_bytes_per_row) + last_word
                    dst_ptr_addr = (u32)dst_plane + dst_offset + (last_row * (u32)dst_bytes_per_row) + last_word
                }

                let src_ptr: *u8 = (*u8)src_ptr_addr
                let dst_ptr: *u8 = (*u8)dst_ptr_addr

                // Validate chip RAM and alignment
                if !is_chip_ram(src_ptr) || !is_chip_ram(dst_ptr) {
                    return Result::Err(BlitterError::NotChipRam)
                }
                if ((u32)src_ptr & 1) != 0 || ((u32)dst_ptr & 1) != 0 {
                    return Result::Err(BlitterError::InvalidAlignment)
                }

                guard.wait()

                // Set registers
                *con1_ptr = con1
                *con0_ptr = con0

                *amod_ptr = src_mod
                if use_c_channel {
                    *cmod_ptr = dst_mod
                }
                *dmod_ptr = dst_mod

                *apt_ptr = (u32)src_ptr
                if use_c_channel {
                    *cpt_ptr = (u32)dst_ptr
                }
                *dpt_ptr = (u32)dst_ptr

                // Start blit
                *size_ptr = bltsize

                plane++
            }

            // Blitter will be automatically released when guard goes out of scope
            dst.mark_blitter_pending()
        }

        return Result::Ok(())
    }

    /// Cookie-cut (masked) copy operation
    ///
    /// Copies source through a mask, preserving background where mask is 0.
    /// This is the standard operation for drawing sprites/BOBs.
    ///
    /// The formula is: D = (A & B) | (~A & C)
    /// Where: A = mask, B = source image, C = background (destination)
    ///
    /// All three bitmaps must have the same dimensions for the copy region.
    /// The mask should be single-plane (depth 1).
    @suppress("W0001", "Integer calculations are safe")
    pub fn copy_masked(
        src: &BitMapHandle, mask: &BitMapHandle,
        sx: u16, sy: u16,
        dst: &var BitMapHandle, dx: u16, dy: u16,
        width: u16, height: u16
    ) -> Result<(), BlitterError> {
        let src_bm: *BitMap = src.handle()
        let mask_bm: *BitMap = mask.handle()
        let dst_bm: *BitMap = dst.handle()

        if !src_bm || !mask_bm || !dst_bm {
            return Result::Err(BlitterError::NotChipRam)
        }

        unsafe {
            let src_bytes_per_row: u16 = (*src_bm).BytesPerRow
            let mask_bytes_per_row: u16 = (*mask_bm).BytesPerRow
            let dst_bytes_per_row: u16 = (*dst_bm).BytesPerRow
            let src_depth: u8 = (*src_bm).Depth
            let dst_depth: u8 = (*dst_bm).Depth

            // Use minimum depth of src and dst
            var depth: u8 = src_depth
            if dst_depth < depth {
                depth = dst_depth
            }

            // Calculate word-aligned width
            let width_words: u16 = (width + 15) / 16
            if width_words < 1 || width_words > 64 {
                return Result::Err(BlitterError::InvalidDimensions)
            }
            if height < 1 || height > 1024 {
                return Result::Err(BlitterError::InvalidDimensions)
            }

            // Calculate offsets
            let src_x_word: u16 = sx / 16
            let src_offset: u32 = ((u32)sy * (u32)src_bytes_per_row) + ((u32)src_x_word * 2)
            let mask_offset: u32 = ((u32)sy * (u32)mask_bytes_per_row) + ((u32)src_x_word * 2)
            let dst_x_word: u16 = dx / 16
            let dst_offset: u32 = ((u32)dy * (u32)dst_bytes_per_row) + ((u32)dst_x_word * 2)

            // Calculate modulos
            let src_mod: i16 = (i16)src_bytes_per_row - (i16)(width_words * 2)
            let mask_mod: i16 = (i16)mask_bytes_per_row - (i16)(width_words * 2)
            let dst_mod: i16 = (i16)dst_bytes_per_row - (i16)(width_words * 2)

            // Acquire blitter with RAII guard
            let guard = BlitterGuard::acquire()
            guard.wait()

            // Cookie cut: D = (A & B) | (~A & C)
            // A = mask, B = source, C = background
            let con0: u16 = BLTCON0_SRCA | BLTCON0_SRCB | BLTCON0_SRCC | BLTCON0_DEST | (u16)MINTERM_COOKIE_CUT
            let con1: u16 = 0

            let con0_ptr: *u16 = (*u16)(CUSTOM_BASE + BLTCON0)
            let con1_ptr: *u16 = (*u16)(CUSTOM_BASE + BLTCON1)

            // Full masks
            let afwm_ptr: *u16 = (*u16)(CUSTOM_BASE + BLTAFWM)
            let alwm_ptr: *u16 = (*u16)(CUSTOM_BASE + BLTALWM)
            *afwm_ptr = $FFFF
            *alwm_ptr = $FFFF

            // Modulo pointers
            let amod_ptr: *i16 = (*i16)(CUSTOM_BASE + BLTAMOD)
            let bmod_ptr: *i16 = (*i16)(CUSTOM_BASE + BLTBMOD)
            let cmod_ptr: *i16 = (*i16)(CUSTOM_BASE + BLTCMOD)
            let dmod_ptr: *i16 = (*i16)(CUSTOM_BASE + BLTDMOD)

            // Pointer registers
            let apt_ptr: *u32 = (*u32)(CUSTOM_BASE + BLTAPT)
            let bpt_ptr: *u32 = (*u32)(CUSTOM_BASE + BLTBPT)
            let cpt_ptr: *u32 = (*u32)(CUSTOM_BASE + BLTCPT)
            let dpt_ptr: *u32 = (*u32)(CUSTOM_BASE + BLTDPT)

            // Size register
            let bltsize: u16 = (height << 6) | width_words
            let size_ptr: *u16 = (*u16)(CUSTOM_BASE + BLTSIZE)

            // Get mask plane (always plane 0)
            let mask_plane: *u8 = (*mask_bm).Planes[0]
            let mask_ptr: *u8 = (*u8)((u32)mask_plane + mask_offset)

            if !is_chip_ram(mask_ptr) {
                return Result::Err(BlitterError::NotChipRam)
            }

            // Blit each plane
            var plane: u8 = 0
            while plane < depth {
                let src_plane: *u8 = (*src_bm).Planes[plane]
                let dst_plane: *u8 = (*dst_bm).Planes[plane]

                let src_ptr: *u8 = (*u8)((u32)src_plane + src_offset)
                let dst_ptr: *u8 = (*u8)((u32)dst_plane + dst_offset)

                // Validate chip RAM and alignment
                if !is_chip_ram(src_ptr) || !is_chip_ram(dst_ptr) {
                    return Result::Err(BlitterError::NotChipRam)
                }
                if ((u32)src_ptr & 1) != 0 || ((u32)dst_ptr & 1) != 0 || ((u32)mask_ptr & 1) != 0 {
                    return Result::Err(BlitterError::InvalidAlignment)
                }

                guard.wait()

                // Set registers
                *con1_ptr = con1
                *con0_ptr = con0

                *amod_ptr = mask_mod  // A = mask
                *bmod_ptr = src_mod   // B = source
                *cmod_ptr = dst_mod   // C = background
                *dmod_ptr = dst_mod   // D = destination

                *apt_ptr = (u32)mask_ptr  // A = mask
                *bpt_ptr = (u32)src_ptr   // B = source
                *cpt_ptr = (u32)dst_ptr   // C = background (read)
                *dpt_ptr = (u32)dst_ptr   // D = destination (write)

                // Start blit
                *size_ptr = bltsize

                plane++
            }

            // Blitter will be automatically released when guard goes out of scope
            dst.mark_blitter_pending()
        }

        return Result::Ok(())
    }

    // ========================================================================
    // Fill Operations
    // ========================================================================

    /// Fill a rectangular region with a 16-bit pattern
    ///
    /// This is a simple pattern fill that writes the same 16-bit pattern
    /// to every word in the rectangle. For solid fill, use $FFFF or $0000.
    /// For patterns like checkerboard, use $AAAA or $5555.
    ///
    /// Note: This fills all bitplanes with the same pattern.
    /// For multi-color fills, call multiple times with different patterns per plane.
    @suppress("W0001", "Integer calculations are safe")
    pub fn fill_rect(
        dst: &var BitMapHandle,
        x: u16, y: u16,
        width: u16, height: u16,
        pattern: u16
    ) -> Result<(), BlitterError> {
        let dst_bm: *BitMap = dst.handle()
        if !dst_bm {
            return Result::Err(BlitterError::NotChipRam)
        }

        unsafe {
            let bytes_per_row: u16 = (*dst_bm).BytesPerRow
            let depth: u8 = (*dst_bm).Depth

            // Calculate word-aligned width
            let width_words: u16 = (width + 15) / 16
            if width_words < 1 || width_words > 64 {
                return Result::Err(BlitterError::InvalidDimensions)
            }
            if height < 1 || height > 1024 {
                return Result::Err(BlitterError::InvalidDimensions)
            }

            // Calculate destination offset
            let x_word: u16 = x / 16
            let offset: u32 = ((u32)y * (u32)bytes_per_row) + ((u32)x_word * 2)

            // Calculate modulo
            let mod_val: i16 = (i16)bytes_per_row - (i16)(width_words * 2)

            // Acquire blitter with RAII guard
            let guard = BlitterGuard::acquire()
            guard.wait()

            // For pattern fill, we use BLTADAT as a constant source
            // The key is to NOT enable SRCA DMA - just set BLTADAT and use minterm
            // Minterm $F0 copies A to D, and with no SRCA DMA, BLTADAT is used repeatedly
            let con0: u16 = BLTCON0_DEST | (u16)MINTERM_COPY
            let con1: u16 = 0  // No fill mode needed for simple pattern fill

            let con0_ptr: *u16 = (*u16)(CUSTOM_BASE + BLTCON0)
            let con1_ptr: *u16 = (*u16)(CUSTOM_BASE + BLTCON1)

            // Full masks
            let afwm_ptr: *u16 = (*u16)(CUSTOM_BASE + BLTAFWM)
            let alwm_ptr: *u16 = (*u16)(CUSTOM_BASE + BLTALWM)
            *afwm_ptr = $FFFF
            *alwm_ptr = $FFFF

            // Set pattern in BLTADAT
            let adat_ptr: *u16 = (*u16)(CUSTOM_BASE + BLTADAT)
            *adat_ptr = pattern

            let dmod_ptr: *i16 = (*i16)(CUSTOM_BASE + BLTDMOD)
            let dpt_ptr: *u32 = (*u32)(CUSTOM_BASE + BLTDPT)

            let bltsize: u16 = (height << 6) | width_words
            let size_ptr: *u16 = (*u16)(CUSTOM_BASE + BLTSIZE)

            // Fill each plane
            var plane: u8 = 0
            while plane < depth {
                let dst_plane: *u8 = (*dst_bm).Planes[plane]
                let dst_ptr: *u8 = (*u8)((u32)dst_plane + offset)

                // Validate chip RAM and alignment
                if !is_chip_ram(dst_ptr) {
                    return Result::Err(BlitterError::NotChipRam)
                }
                if ((u32)dst_ptr & 1) != 0 {
                    return Result::Err(BlitterError::InvalidAlignment)
                }

                guard.wait()

                *con1_ptr = con1
                *con0_ptr = con0
                *dmod_ptr = mod_val
                *dpt_ptr = (u32)dst_ptr

                // Start fill
                *size_ptr = bltsize

                plane++
            }

            // Blitter will be automatically released when guard goes out of scope
            dst.mark_blitter_pending()
        }

        return Result::Ok(())
    }

    /// Clear a rectangular region to zero (all planes)
    pub fn clear_rect(
        dst: &var BitMapHandle,
        x: u16, y: u16,
        width: u16, height: u16
    ) -> Result<(), BlitterError> {
        return BlitterOps::fill_rect(dst, x, y, width, height, 0)
    }

    /// Set a rectangular region to all 1s (all planes)
    pub fn set_rect(
        dst: &var BitMapHandle,
        x: u16, y: u16,
        width: u16, height: u16
    ) -> Result<(), BlitterError> {
        return BlitterOps::fill_rect(dst, x, y, width, height, $FFFF)
    }

    /// Fill a single bitplane with a pattern
    @suppress("W0001", "Integer calculations are safe")
    pub fn fill_plane(
        dst: &var BitMapHandle,
        plane_num: u8,
        x: u16, y: u16,
        width: u16, height: u16,
        pattern: u16
    ) -> Result<(), BlitterError> {
        let dst_bm: *BitMap = dst.handle()
        if !dst_bm {
            return Result::Err(BlitterError::NotChipRam)
        }

        unsafe {
            let bytes_per_row: u16 = (*dst_bm).BytesPerRow
            let depth: u8 = (*dst_bm).Depth

            if plane_num >= depth {
                return Result::Err(BlitterError::InvalidDimensions)
            }

            // Calculate word-aligned width
            let width_words: u16 = (width + 15) / 16
            if width_words < 1 || width_words > 64 {
                return Result::Err(BlitterError::InvalidDimensions)
            }
            if height < 1 || height > 1024 {
                return Result::Err(BlitterError::InvalidDimensions)
            }

            // Calculate destination offset
            let x_word: u16 = x / 16
            let offset: u32 = ((u32)y * (u32)bytes_per_row) + ((u32)x_word * 2)

            let dst_plane: *u8 = (*dst_bm).Planes[plane_num]
            let dst_ptr: *u8 = (*u8)((u32)dst_plane + offset)

            // Validate chip RAM and alignment
            if !is_chip_ram(dst_ptr) {
                return Result::Err(BlitterError::NotChipRam)
            }
            if ((u32)dst_ptr & 1) != 0 {
                return Result::Err(BlitterError::InvalidAlignment)
            }

            // Calculate modulo
            let mod_val: i16 = (i16)bytes_per_row - (i16)(width_words * 2)

            // Acquire blitter with RAII guard
            let guard = BlitterGuard::acquire()
            guard.wait()

            let con0: u16 = BLTCON0_DEST | (u16)MINTERM_COPY
            let con1: u16 = 0

            let con0_ptr: *u16 = (*u16)(CUSTOM_BASE + BLTCON0)
            let con1_ptr: *u16 = (*u16)(CUSTOM_BASE + BLTCON1)
            *con1_ptr = con1
            *con0_ptr = con0

            let afwm_ptr: *u16 = (*u16)(CUSTOM_BASE + BLTAFWM)
            let alwm_ptr: *u16 = (*u16)(CUSTOM_BASE + BLTALWM)
            *afwm_ptr = $FFFF
            *alwm_ptr = $FFFF

            let adat_ptr: *u16 = (*u16)(CUSTOM_BASE + BLTADAT)
            *adat_ptr = pattern

            let dmod_ptr: *i16 = (*i16)(CUSTOM_BASE + BLTDMOD)
            *dmod_ptr = mod_val

            let dpt_ptr: *u32 = (*u32)(CUSTOM_BASE + BLTDPT)
            *dpt_ptr = (u32)dst_ptr

            let bltsize: u16 = (height << 6) | width_words
            let size_ptr: *u16 = (*u16)(CUSTOM_BASE + BLTSIZE)
            *size_ptr = bltsize

            // Blitter will be automatically released when guard goes out of scope
            dst.mark_blitter_pending()
        }

        return Result::Ok(())
    }

    // ========================================================================
    // Line Drawing Operations
    // ========================================================================

    /// Draw a line using blitter line mode (Bresenham algorithm)
    ///
    /// Draws an OR'd line - pixels are set where the line passes.
    /// For XOR lines (useful for cursors), use draw_line_xor().
    ///
    /// Parameters:
    ///   dst: Destination bitmap (first plane only)
    ///   x1, y1: Start coordinates
    ///   x2, y2: End coordinates
    ///   pattern: Line pattern ($FFFF for solid, $AAAA for dashed)
    @suppress("W0001", "Line calculations are safe")
    pub fn draw_line(
        dst: &var BitMapHandle,
        x1: i16, y1: i16,
        x2: i16, y2: i16,
        pattern: u16
    ) -> Result<(), BlitterError> {
        return BlitterOps::draw_line_internal(dst, x1, y1, x2, y2, pattern, false)
    }

    /// Draw an XOR line (toggles pixels - useful for cursors and rubber-banding)
    @suppress("W0001", "Line calculations are safe")
    pub fn draw_line_xor(
        dst: &var BitMapHandle,
        x1: i16, y1: i16,
        x2: i16, y2: i16,
        pattern: u16
    ) -> Result<(), BlitterError> {
        return BlitterOps::draw_line_internal(dst, x1, y1, x2, y2, pattern, true)
    }

    /// Internal line drawing implementation
    @suppress("W0001", "Line calculations are safe")
    fn draw_line_internal(
        dst: &var BitMapHandle,
        x1: i16, y1: i16,
        x2: i16, y2: i16,
        pattern: u16,
        xor_mode: bool
    ) -> Result<(), BlitterError> {
        let dst_bm: *BitMap = dst.handle()
        if !dst_bm {
            return Result::Err(BlitterError::NotChipRam)
        }

        unsafe {
            let bytes_per_row: u16 = (*dst_bm).BytesPerRow

            // Calculate deltas (signed)
            var dx: i16 = x2 - x1
            var dy: i16 = y2 - y1

            // Track original signs for octant calculation
            let dx_negative: bool = dx < 0
            let dy_negative: bool = dy < 0

            // Make dx and dy positive (absolute values)
            if dx < 0 {
                dx = -dx
            }
            if dy < 0 {
                dy = -dy
            }

            // Determine if line is steep (|dy| > |dx|)
            let steep: bool = dy > dx

            // Get major and minor axis lengths
            var major: i16 = dx
            var minor: i16 = dy
            if steep {
                major = dy
                minor = dx
            }

            // Zero-length line - just return
            if major == 0 {
                return Result::Ok(())
            }

            // Calculate starting position (plane 0 only for line drawing)
            let plane0: *u8 = (*dst_bm).Planes[0]
            let offset: u32 = ((u32)y1 * (u32)bytes_per_row) + ((u32)(x1 / 16) * 2)
            let dst_ptr: *u8 = (*u8)((u32)plane0 + offset)

            // Validate chip RAM and alignment
            if !is_chip_ram(dst_ptr) {
                return Result::Err(BlitterError::NotChipRam)
            }
            if ((u32)dst_ptr & 1) != 0 {
                return Result::Err(BlitterError::InvalidAlignment)
            }

            // Calculate starting bit position (15 = leftmost, 0 = rightmost)
            let start_bit: u16 = (u16)(15 - (x1 & 15))

            // Acquire blitter with RAII guard
            let guard = BlitterGuard::acquire()
            guard.wait()

            // Build BLTCON0 for line mode:
            // - ASH (bits 15-12): Starting bit position
            // - USE A, B (pattern), C (background), D (dest)
            // - Minterm $CA for OR lines, $4A for XOR lines
            let ash: u16 = start_bit << 12

            // For line mode we need A, B (implicit), C, D
            // The B channel provides the line pattern via BLTBDAT
            // Minterm for OR line: $CA = (A & B) | (~A & C) | (A & C) simplified
            // Actually the correct minterm is $CA for standard line drawing
            // For XOR: we want A ^ C where pattern applies
            var minterm: u8 = MINTERM_LINE  // $CA
            if xor_mode {
                // XOR line: toggle pixels where pattern is set
                // D = (A & B & ~C) | (~A & C) | (A & ~B & C) = complex
                // Simpler: use $3C (A XOR C) but only where B is set
                // Actually: $6A gives XOR behavior with pattern
                minterm = $6A
            }

            let con0: u16 = ash | BLTCON0_SRCA | BLTCON0_SRCC | BLTCON0_DEST | (u16)minterm

            // Build BLTCON1 for line mode
            // Start with LINE mode enabled and SING (single pixel per horizontal line)
            var con1: u16 = BLTCON1_LINE | BLTCON1_SING

            // Calculate octant and set appropriate flags
            // The octant determines which direction the line moves
            // Octant flags from Amiga Hardware Reference Manual:
            //
            // Octant 0: dx>0, dy>0, dx>=dy (right-down, shallow)    - no flags
            // Octant 1: dx>0, dy>0, dx<dy  (right-down, steep)      - SUD
            // Octant 2: dx<0, dy>0, |dx|>=dy (left-down, shallow)   - AUL
            // Octant 3: dx<0, dy>0, |dx|<dy  (left-down, steep)     - SUD | AUL
            // Octant 4: dx>0, dy<0, dx>=|dy| (right-up, shallow)    - SUL
            // Octant 5: dx>0, dy<0, dx<|dy|  (right-up, steep)      - SUD | SUL
            // Octant 6: dx<0, dy<0, |dx|>=|dy| (left-up, shallow)   - SUL | AUL
            // Octant 7: dx<0, dy<0, |dx|<|dy|  (left-up, steep)     - SUD | SUL | AUL

            if steep {
                con1 = con1 | BLTCON1_SUD
            }
            if dx_negative {
                con1 = con1 | BLTCON1_AUL
            }
            if dy_negative {
                con1 = con1 | BLTCON1_SUL
            }

            // Check if initial error is negative (SIGN flag)
            var apt_val: i16 = (2 * minor) - major
            if apt_val < 0 {
                con1 = con1 | BLTCON1_SIGN
            }

            let con0_ptr: *u16 = (*u16)(CUSTOM_BASE + BLTCON0)
            let con1_ptr: *u16 = (*u16)(CUSTOM_BASE + BLTCON1)
            *con1_ptr = con1
            *con0_ptr = con0

            // Masks - first word mask is single pixel at the calculated start position
            // The mask bit corresponds to start_bit (15 = leftmost $8000, 0 = rightmost $0001)
            let afwm_ptr: *u16 = (*u16)(CUSTOM_BASE + BLTAFWM)
            let alwm_ptr: *u16 = (*u16)(CUSTOM_BASE + BLTALWM)
            let first_pixel_mask: u16 = (u16)1 << start_bit
            *afwm_ptr = first_pixel_mask
            *alwm_ptr = $FFFF

            // Set line pattern in BLTBDAT
            let bdat_ptr: *u16 = (*u16)(CUSTOM_BASE + BLTBDAT)
            *bdat_ptr = pattern

            // Set modulos for line mode
            // BLTAMOD = 4 * minor (error adjust when no step)
            // BLTBMOD = 4 * minor - 4 * major (error adjust when step)
            let amod_ptr: *i16 = (*i16)(CUSTOM_BASE + BLTAMOD)
            let bmod_ptr: *i16 = (*i16)(CUSTOM_BASE + BLTBMOD)
            let cmod_ptr: *i16 = (*i16)(CUSTOM_BASE + BLTCMOD)
            let dmod_ptr: *i16 = (*i16)(CUSTOM_BASE + BLTDMOD)

            // Line mode modulos are 16-bit error term adjustments, factor is 2 (not 4)
            *amod_ptr = 2 * minor
            *bmod_ptr = 2 * (minor - major)

            // C and D modulos = bytes per row (for moving to next/prev scanline)
            *cmod_ptr = (i16)bytes_per_row
            *dmod_ptr = (i16)bytes_per_row

            // Set BLTAPT to initial error accumulator value (sign-extended to 32-bit)
            let apt_ptr: *u32 = (*u32)(CUSTOM_BASE + BLTAPT)
            let apt_val_32: i32 = (i32)apt_val
            *apt_ptr = (u32)apt_val_32

            // Set C and D pointers to destination (read-modify-write)
            let cpt_ptr: *u32 = (*u32)(CUSTOM_BASE + BLTCPT)
            let dpt_ptr: *u32 = (*u32)(CUSTOM_BASE + BLTDPT)
            *cpt_ptr = (u32)dst_ptr
            *dpt_ptr = (u32)dst_ptr

            // Start line draw
            // BLTSIZE: height = number of pixels (major + 1), width = 2 words always
            let n: u16 = (u16)(major + 1)
            let bltsize: u16 = (n << 6) | 2
            let size_ptr: *u16 = (*u16)(CUSTOM_BASE + BLTSIZE)
            *size_ptr = bltsize

            // Blitter will be automatically released when guard goes out of scope
            dst.mark_blitter_pending()
        }

        return Result::Ok(())
    }

    // ========================================================================
    // Shifted/Scrolling Blits
    // ========================================================================

    /// Copy with pixel shift (for smooth scrolling and non-word-aligned sprites)
    ///
    /// The shift value (0-15) determines how many pixels to shift the source
    /// data to the right. This enables sub-word positioning of graphics.
    ///
    /// Parameters:
    ///   src, sx, sy: Source bitmap and position
    ///   dst, dx, dy: Destination bitmap and position
    ///   width, height: Dimensions
    ///   shift: Pixel shift amount (0-15)
    @suppress("W0001", "Integer calculations are safe")
    pub fn copy_shifted(
        src: &BitMapHandle, sx: u16, sy: u16,
        dst: &var BitMapHandle, dx: u16, dy: u16,
        width: u16, height: u16,
        shift: u8
    ) -> Result<(), BlitterError> {
        let src_bm: *BitMap = src.handle()
        let dst_bm: *BitMap = dst.handle()

        if !src_bm || !dst_bm {
            return Result::Err(BlitterError::NotChipRam)
        }

        if shift > 15 {
            return Result::Err(BlitterError::InvalidDimensions)
        }

        unsafe {
            let src_bytes_per_row: u16 = (*src_bm).BytesPerRow
            let dst_bytes_per_row: u16 = (*dst_bm).BytesPerRow
            let src_depth: u8 = (*src_bm).Depth
            let dst_depth: u8 = (*dst_bm).Depth

            var depth: u8 = src_depth
            if dst_depth < depth {
                depth = dst_depth
            }

            // For shifted blits, we need an extra word to handle overflow
            let width_words: u16 = ((width + 15) / 16) + 1
            if width_words < 1 || width_words > 64 {
                return Result::Err(BlitterError::InvalidDimensions)
            }
            if height < 1 || height > 1024 {
                return Result::Err(BlitterError::InvalidDimensions)
            }

            // Calculate offsets
            let src_x_word: u16 = sx / 16
            let src_offset: u32 = ((u32)sy * (u32)src_bytes_per_row) + ((u32)src_x_word * 2)
            let dst_x_word: u16 = dx / 16
            let dst_offset: u32 = ((u32)dy * (u32)dst_bytes_per_row) + ((u32)dst_x_word * 2)

            // Calculate modulos (account for extra word)
            let src_mod: i16 = (i16)src_bytes_per_row - (i16)(width_words * 2)
            let dst_mod: i16 = (i16)dst_bytes_per_row - (i16)(width_words * 2)

            // Build BLTCON0 with shift in ASH field
            let ash: u16 = (u16)shift << 12
            let con0: u16 = ash | BLTCON0_SRCA | BLTCON0_DEST | (u16)MINTERM_COPY
            let con1: u16 = 0

            // Calculate first/last word masks based on shift
            // For ASH (ascending shift right), first word passes through,
            // last word needs to mask out the overflow bits that shifted beyond width
            let fwm: u16 = $FFFF
            var lwm: u16 = $FFFF
            if shift > 0 {
                // Mask out the rightmost 'shift' bits that are overflow from previous word
                lwm = $FFFF << shift
            }

            // Acquire blitter with RAII guard
            let guard = BlitterGuard::acquire()
            guard.wait()

            let con0_ptr: *u16 = (*u16)(CUSTOM_BASE + BLTCON0)
            let con1_ptr: *u16 = (*u16)(CUSTOM_BASE + BLTCON1)

            let afwm_ptr: *u16 = (*u16)(CUSTOM_BASE + BLTAFWM)
            let alwm_ptr: *u16 = (*u16)(CUSTOM_BASE + BLTALWM)

            let amod_ptr: *i16 = (*i16)(CUSTOM_BASE + BLTAMOD)
            let dmod_ptr: *i16 = (*i16)(CUSTOM_BASE + BLTDMOD)

            let apt_ptr: *u32 = (*u32)(CUSTOM_BASE + BLTAPT)
            let dpt_ptr: *u32 = (*u32)(CUSTOM_BASE + BLTDPT)

            let bltsize: u16 = (height << 6) | width_words
            let size_ptr: *u16 = (*u16)(CUSTOM_BASE + BLTSIZE)

            var plane: u8 = 0
            while plane < depth {
                let src_plane: *u8 = (*src_bm).Planes[plane]
                let dst_plane: *u8 = (*dst_bm).Planes[plane]

                let src_ptr: *u8 = (*u8)((u32)src_plane + src_offset)
                let dst_ptr: *u8 = (*u8)((u32)dst_plane + dst_offset)

                if !is_chip_ram(src_ptr) || !is_chip_ram(dst_ptr) {
                    return Result::Err(BlitterError::NotChipRam)
                }
                if ((u32)src_ptr & 1) != 0 || ((u32)dst_ptr & 1) != 0 {
                    return Result::Err(BlitterError::InvalidAlignment)
                }

                guard.wait()

                *con1_ptr = con1
                *con0_ptr = con0
                *afwm_ptr = fwm
                *alwm_ptr = lwm
                *amod_ptr = src_mod
                *dmod_ptr = dst_mod
                *apt_ptr = (u32)src_ptr
                *dpt_ptr = (u32)dst_ptr

                *size_ptr = bltsize

                plane++
            }

            // Blitter will be automatically released when guard goes out of scope
            dst.mark_blitter_pending()
        }

        return Result::Ok(())
    }

    // ========================================================================
    // Invert Operations
    // ========================================================================

    /// Invert a rectangular region (toggle all bits in all planes)
    @suppress("W0001", "Integer calculations are safe")
    pub fn invert_rect(
        dst: &var BitMapHandle,
        x: u16, y: u16,
        width: u16, height: u16
    ) -> Result<(), BlitterError> {
        let dst_bm: *BitMap = dst.handle()
        if !dst_bm {
            return Result::Err(BlitterError::NotChipRam)
        }

        unsafe {
            let bytes_per_row: u16 = (*dst_bm).BytesPerRow
            let depth: u8 = (*dst_bm).Depth

            let width_words: u16 = (width + 15) / 16
            if width_words < 1 || width_words > 64 {
                return Result::Err(BlitterError::InvalidDimensions)
            }
            if height < 1 || height > 1024 {
                return Result::Err(BlitterError::InvalidDimensions)
            }

            let x_word: u16 = x / 16
            let offset: u32 = ((u32)y * (u32)bytes_per_row) + ((u32)x_word * 2)
            let mod_val: i16 = (i16)bytes_per_row - (i16)(width_words * 2)

            // Acquire blitter with RAII guard
            let guard = BlitterGuard::acquire()
            guard.wait()

            // For invert: read C, apply NOT, write to D
            // Minterm $0F = ~A but we want ~C, so use $55 (NOT C)
            // Actually, easiest is to XOR with all 1s: use A channel with $FFFF and XOR
            // Set BLTADAT to $FFFF, use minterm $3C (A XOR C)
            let con0: u16 = BLTCON0_SRCC | BLTCON0_DEST | (u16)MINTERM_XOR
            let con1: u16 = 0

            let con0_ptr: *u16 = (*u16)(CUSTOM_BASE + BLTCON0)
            let con1_ptr: *u16 = (*u16)(CUSTOM_BASE + BLTCON1)

            let afwm_ptr: *u16 = (*u16)(CUSTOM_BASE + BLTAFWM)
            let alwm_ptr: *u16 = (*u16)(CUSTOM_BASE + BLTALWM)
            *afwm_ptr = $FFFF
            *alwm_ptr = $FFFF

            // Set A to all 1s for XOR
            let adat_ptr: *u16 = (*u16)(CUSTOM_BASE + BLTADAT)
            *adat_ptr = $FFFF

            let cmod_ptr: *i16 = (*i16)(CUSTOM_BASE + BLTCMOD)
            let dmod_ptr: *i16 = (*i16)(CUSTOM_BASE + BLTDMOD)

            let cpt_ptr: *u32 = (*u32)(CUSTOM_BASE + BLTCPT)
            let dpt_ptr: *u32 = (*u32)(CUSTOM_BASE + BLTDPT)

            let bltsize: u16 = (height << 6) | width_words
            let size_ptr: *u16 = (*u16)(CUSTOM_BASE + BLTSIZE)

            var plane: u8 = 0
            while plane < depth {
                let dst_plane: *u8 = (*dst_bm).Planes[plane]
                let dst_ptr: *u8 = (*u8)((u32)dst_plane + offset)

                if !is_chip_ram(dst_ptr) {
                    return Result::Err(BlitterError::NotChipRam)
                }
                if ((u32)dst_ptr & 1) != 0 {
                    return Result::Err(BlitterError::InvalidAlignment)
                }

                guard.wait()

                *con1_ptr = con1
                *con0_ptr = con0
                *cmod_ptr = mod_val
                *dmod_ptr = mod_val
                *cpt_ptr = (u32)dst_ptr
                *dpt_ptr = (u32)dst_ptr

                *size_ptr = bltsize

                plane++
            }

            // Blitter will be automatically released when guard goes out of scope
            dst.mark_blitter_pending()
        }

        return Result::Ok(())
    }
}

// ============================================================================
// Helper Functions
// ============================================================================

/// Check if a pointer is in chip RAM
@suppress("W0001", "TypeOfMem returns unsigned flags")
fn is_chip_ram(ptr: *u8) -> bool {
    if !ptr {
        return false
    }
    let mem_type: u32 = TypeOfMem(ptr)
    return (mem_type & MEMF_CHIP) != 0
}
