// Hardware Sprite Support for Amiga
//
// This module provides safe, ergonomic access to Amiga hardware sprites.
//
// Quick Start:
//   const PLAYER_DATA = [
//       $0000, $0000,  // Control words
//       $0FF0, $0000,  // Scanline 1: bitplane 0, bitplane 1
//       $1FF8, $0000,  // Scanline 2
//       $0FF0, $0000,  // Scanline 3
//       $0000, $0000   // Terminator
//   ]
//
//   let mut sprite_data = SpriteData::from_raw(&PLAYER_DATA)?
//   let mut sprite = SpriteHandle::alloc(0)?
//   sprite.set_colors(&[Color::rgb(255, 0, 0), Color::rgb(0, 255, 0), Color::rgb(0, 0, 255)])?
//   sprite.show(&sprite_data, 100, 50)?
//   sprite.move_to(200, 100)?

from std::core import Result, Option
from std::error::errors import GraphicsError
from std::graphics::palette import Color
from std::memory::amiga import ChipMemHandle
from std::ffi::amiga_structs import Custom

// Display mode detection - MUST be initialized before using sprites
static mut IS_PAL: bool = true
static mut INITIALIZED: bool = false

// Initialize the sprite system - MUST be called before using sprites
// Detects PAL vs NTSC display mode for correct vertical positioning
// Enables sprite DMA
pub fn init_sprite_system() {
    unsafe {
        if INITIALIZED {
            return
        }

        // Read VPOSR register at $DFF004 to detect PAL/NTSC
        // Note: This is a simplified detection. For production code, should check
        // GfxBase->DisplayFlags or SysBase->ex_EClockFrequency for more reliability
        let vposr = (*u16)$DFF004
        let agnus_id = (*vposr >> 8) & $7F
        // PAL has different Agnus IDs than NTSC
        IS_PAL = (agnus_id & $10) != 0

        // Enable sprite DMA (DMACON register at $DFF096)
        // Set bit 15 (SETCLR) + bit 5 (SPREN - sprite DMA enable)
        let dmacon = (*u16)$DFF096
        *dmacon = $8020

        INITIALIZED = true
    }
}

// Deprecated: Use init_sprite_system() instead
pub fn detect_display_mode() {
    init_sprite_system()
}

fn get_vstart_offset() -> u16 {
    unsafe {
        if IS_PAL {
            return $2Cu16  // PAL offset
        } else {
            return $18u16  // NTSC offset
        }
    }
}

// Sprite data in CHIP RAM
// Always 2 bitplanes (4 colors) for regular sprites
pub struct SpriteData {
    chip_mem: ChipMemHandle,
    height: u16,
}

impl SpriteData {
    // Create sprite data from raw hardware format
    // Data must be: control_word, plane0_line0, plane1_line0, plane0_line1, plane1_line1, ..., terminator
    pub fn from_raw(data: *u16, len: u32) -> Result<SpriteData, GraphicsError> {
        if len < 4u32 {
            return Result::Err(GraphicsError::InvalidSpriteData)
        }

        let size_bytes: u32 = len * 2u32
        let chip_mem_opt = ChipMemHandle::new(size_bytes)

        match chip_mem_opt {
            Option::None => {
                return Result::Err(GraphicsError::BitMapAllocFailed)
            },
            Option::Some(chip_mem) => {
                // Copy data to CHIP RAM
                unsafe {
                    let dest = (*u16)chip_mem.ptr()
                    for i in 0..(u32)len {
                        dest[i] = data[i]
                    }
                }

                let num_words = len - 2u32
                let num_lines = num_words / 2u32
                return Result::Ok(SpriteData {
                    chip_mem: chip_mem,
                    height: (u16)num_lines,  // Subtract control words, divide by 2 planes
                })
            }
        }
    }

    // Get pointer to sprite data (for hardware registers)
    pub fn as_ptr(&self) -> *u16 {
        return (*u16)self.chip_mem.ptr()
    }

    // Get sprite height
    pub fn height(&self) -> u16 {
        return self.height
    }
}

// Drop is automatically handled by ChipMemHandle

// Global sprite channel allocation bitmap (bit N = sprite N allocated)
static mut SPRITE_CHANNELS_ALLOCATED: u8 = 0

// Manages a single hardware sprite channel (0-7)
pub struct SpriteHandle {
    channel: u8,         // 0-7
    is_allocated: bool,
    custom: *u8,  // Pointer to Custom chipset registers at $DFF000
    visible: bool,       // Track visibility state
    pos_x: i16,          // Current X position
    pos_y: i16,          // Current Y position
    sprite_height: u16,  // Current sprite height (for vstop calculation)
}

impl SpriteHandle {
    // Allocate a sprite channel
    pub fn alloc(channel: u8) -> Result<SpriteHandle, GraphicsError> {
        if channel > 7 {
            return Result::Err(GraphicsError::InvalidSpriteChannel)
        }

        // Check if channel is already allocated
        unsafe {
            let channel_mask = 1u8 << channel
            if (SPRITE_CHANNELS_ALLOCATED & channel_mask) != 0 {
                return Result::Err(GraphicsError::SpriteChannelInUse)
            }
            SPRITE_CHANNELS_ALLOCATED = SPRITE_CHANNELS_ALLOCATED | channel_mask
        }

        let custom = (*u8)$DFF000

        return Result::Ok(SpriteHandle {
            channel: channel,
            is_allocated: true,
            custom: custom,
            visible: false,
            pos_x: 0,
            pos_y: 0,
            sprite_height: 0,
        })
    }

    // Show sprite at position
    // WARNING: sprite must remain valid (not dropped) while in use by hardware
    pub fn show(&mut self, sprite: &SpriteData, x: i16, y: i16) -> Result<(), GraphicsError> {
        if !self.is_allocated {
            return Result::Err(GraphicsError::SpriteNotAllocated)
        }

        // Store sprite height for vstop calculation
        self.sprite_height = sprite.height()

        // Set 32-bit sprite pointer (split into PTH and PTL registers)
        // SPRxPTH/SPRxPTL are at $DFF120 + (channel * 4)
        let sprite_ptr_addr = (u32)sprite.as_ptr()
        let ptr_high = (u16)(sprite_ptr_addr >> 16)
        let ptr_low = (u16)(sprite_ptr_addr & $FFFF)

        let channel_offset = (u32)self.channel * 4u32
        let spr_pth_offset = $120 + channel_offset
        let spr_ptl_offset = $122 + channel_offset

        unsafe {
            let pth_reg = (*u16)((u32)self.custom + spr_pth_offset)
            let ptl_reg = (*u16)((u32)self.custom + spr_ptl_offset)
            *pth_reg = ptr_high
            *ptl_reg = ptr_low
        }

        // Set position
        self.visible = true
        self.pos_x = x
        self.pos_y = y
        self.move_to(x, y)?

        return Result::Ok(())
    }

    // Move sprite to new position
    pub fn move_to(&mut self, x: i16, y: i16) -> Result<(), GraphicsError> {
        if !self.is_allocated {
            return Result::Err(GraphicsError::SpriteNotAllocated)
        }

        // Update tracked position
        self.pos_x = x
        self.pos_y = y

        // Calculate hardware position with offset
        let hw_x = (u16)(x + $81)
        let hw_y = (u16)(y + (i16)get_vstart_offset())

        // Calculate VSTART/VSTOP
        // VSTOP = VSTART + height + 1 (hardware requirement)
        let vstart = hw_y
        let vstop = hw_y + self.sprite_height + 1u16

        // SPRxPOS format: VSTART (8 bits) | HSTART (8 bits)
        let pos = ((vstart & $FF) << 8) | (hw_x & $FF)

        // SPRxCTL format: VSTOP[7:0] | ATTACH | unused | unused | unused | unused | VSTOP[8] | VSTART[8] | HSTART[0]
        let vstop_hi = (vstop >> 8) & 1
        let vstart_hi = (vstart >> 8) & 1
        let hstart_hi = (hw_x >> 8) & 1
        let ctl = ((vstop & $FF) << 8) | (vstop_hi << 2) | (vstart_hi << 1) | hstart_hi

        // Write to hardware registers
        let channel_offset = self.channel * 8
        let spr_pos_offset = $140 + (u32)channel_offset
        let spr_ctl_offset = $142 + (u32)channel_offset

        unsafe {
            let pos_reg = (*u16)((u32)self.custom + spr_pos_offset)
            let ctl_reg = (*u16)((u32)self.custom + spr_ctl_offset)
            *pos_reg = pos
            *ctl_reg = ctl
        }

        return Result::Ok(())
    }

    // Hide sprite (move offscreen)
    pub fn hide(&mut self) -> Result<(), GraphicsError> {
        self.visible = false
        self.move_to(-100, -100)?
        return Result::Ok(())
    }

    // Query if sprite is visible
    pub fn is_visible(&self) -> bool {
        return self.visible
    }

    // Get current position
    pub fn position(&self) -> (i16, i16) {
        return (self.pos_x, self.pos_y)
    }

    // Move sprite by relative offset
    pub fn move_by(&mut self, dx: i16, dy: i16) -> Result<(), GraphicsError> {
        let new_x = self.pos_x + dx
        let new_y = self.pos_y + dy
        return self.move_to(new_x, new_y)
    }

    // Check if sprite position is within screen bounds
    // Assumes standard screen size (320x256 for PAL, 320x200 for NTSC)
    pub fn is_on_screen(&self) -> bool {
        if self.pos_x < -16 || self.pos_x > 320 {
            return false
        }
        unsafe {
            let max_y: i16 = IS_PAL ? 256 : 200
            if self.pos_y < 0 || self.pos_y > max_y {
                return false
            }
        }
        return true
    }

    // Change sprite image (for animation)
    // WARNING: sprite must remain valid (not dropped) while in use by hardware
    pub fn set_image(&mut self, sprite: &SpriteData) -> Result<(), GraphicsError> {
        if !self.is_allocated {
            return Result::Err(GraphicsError::SpriteNotAllocated)
        }

        // Store new sprite height
        self.sprite_height = sprite.height()

        // Update sprite pointer registers
        let sprite_ptr_addr = (u32)sprite.as_ptr()
        let ptr_high = (u16)(sprite_ptr_addr >> 16)
        let ptr_low = (u16)(sprite_ptr_addr & $FFFF)

        let channel_offset = (u32)self.channel * 4u32
        let spr_pth_offset = $120 + channel_offset
        let spr_ptl_offset = $122 + channel_offset

        unsafe {
            let pth_reg = (*u16)((u32)self.custom + spr_pth_offset)
            let ptl_reg = (*u16)((u32)self.custom + spr_ptl_offset)
            *pth_reg = ptr_high
            *ptl_reg = ptr_low
        }

        return Result::Ok(())
    }

    // Set colors for this sprite channel
    //
    // IMPORTANT: Sprite pairs share color registers!
    // - Sprites 0 & 1 share colors 17-19 ($DFF1A2-$DFF1A8)
    // - Sprites 2 & 3 share colors 21-23 ($DFF1AA-$DFF1B0)
    // - Sprites 4 & 5 share colors 25-27 ($DFF1B2-$DFF1B8)
    // - Sprites 6 & 7 share colors 29-31 ($DFF1BA-$DFF1C0)
    //
    // Setting colors for sprite 0 will affect sprite 1, and vice versa.
    // Same applies to all other pairs (2+3, 4+5, 6+7).
    pub fn set_colors(&mut self, colors: &[Color; 3]) -> Result<(), GraphicsError> {

        let base_color: i32 = match self.channel {
            0 | 1 => 17,
            2 | 3 => 21,
            4 | 5 => 25,
            6 | 7 => 29,
            _ => return Result::Err(GraphicsError::InvalidSpriteChannel),
        }

        // Write colors to hardware
        // Convert reference to pointer so we can index it
        let colors_ptr: *Color = (*Color)colors
        unsafe {
            for i in 0..3 {
                let color_index_offset = (base_color + i) * 2
                let color_reg_offset = $180 + (u32)color_index_offset
                let color_reg = (*u16)((u32)self.custom + color_reg_offset)
                let (r4, g4, b4) = colors_ptr[i].to_rgb4()

                // Pack into 12-bit Amiga RGB format: 0x0RGB
                let rgb12 = ((u16)r4 << 8) | ((u16)g4 << 4) | (u16)b4
                *color_reg = rgb12
            }
        }

        return Result::Ok(())
    }

    // Release the sprite channel
    pub fn release(&mut self) {
        if self.is_allocated {
            let _ = self.hide()
            unsafe {
                let channel_mask = 1u8 << self.channel
                // Clear the bit by XORing if it's set
                if (SPRITE_CHANNELS_ALLOCATED & channel_mask) != 0 {
                    SPRITE_CHANNELS_ALLOCATED = SPRITE_CHANNELS_ALLOCATED ^ channel_mask
                }
            }
            self.is_allocated = false
        }
    }
}

impl Drop for SpriteHandle {
    fn drop(&mut self) {
        self.release()
    }
}

// Attached sprite handle (for 15-color sprites using 2 channels)
pub struct AttachedSpriteHandle {
    channel: u8,  // Must be even (0, 2, 4, 6)
    sprite0: SpriteHandle,
    sprite1: SpriteHandle,
}

impl AttachedSpriteHandle {
    // Allocate an attached sprite pair
    // channel must be even (0, 2, 4, 6) and will use channel+1 as well
    pub fn alloc_pair(channel: u8) -> Result<AttachedSpriteHandle, GraphicsError> {
        if channel % 2 != 0 || channel > 6 {
            return Result::Err(GraphicsError::InvalidAttachedSpriteChannel)
        }

        let sprite0 = SpriteHandle::alloc(channel)?
        let sprite1 = SpriteHandle::alloc(channel + 1)?

        return Result::Ok(AttachedSpriteHandle {
            channel: channel,
            sprite0: sprite0,
            sprite1: sprite1,
        })
    }

    // Show attached sprite at position
    pub fn show(&mut self, sprite: &AttachedSpriteData, x: i16, y: i16) -> Result<(), GraphicsError> {
        // Show even sprite (planes 0 and 1)
        self.sprite0.show(&sprite.plane01, x, y)?

        // Show odd sprite (planes 2 and 3)
        self.sprite1.show(&sprite.plane23, x, y)?

        // Set ATTACH bit (bit 7) in odd sprite's CTL register
        // This tells the hardware to combine the two sprites into one 16-color sprite
        let channel_offset = self.sprite1.channel * 8
        let spr_ctl_offset = $142 + (u32)channel_offset

        unsafe {
            let ctl_reg = (*u16)((u32)self.sprite1.custom + spr_ctl_offset)
            *ctl_reg = *ctl_reg | $80  // Set bit 7 (ATTACH)
        }

        return Result::Ok(())
    }

    // Move attached sprite
    pub fn move_to(&mut self, x: i16, y: i16) -> Result<(), GraphicsError> {
        self.sprite0.move_to(x, y)?
        self.sprite1.move_to(x, y)?
        return Result::Ok(())
    }

    // Hide attached sprite
    pub fn hide(&mut self) -> Result<(), GraphicsError> {
        self.sprite0.hide()?
        self.sprite1.hide()?
        return Result::Ok(())
    }

    // Get the two channel numbers used
    pub fn channels(&self) -> (u8, u8) {
        return (self.channel, self.channel + 1)
    }

    // Change sprite image (for animation)
    pub fn set_image(&mut self, sprite: &AttachedSpriteData) -> Result<(), GraphicsError> {
        self.sprite0.set_image(&sprite.plane01)?
        self.sprite1.set_image(&sprite.plane23)?
        return Result::Ok(())
    }

    // Set colors (15 colors + transparent)
    pub fn set_colors(&mut self, colors: &[Color; 15]) -> Result<(), GraphicsError> {
        // Attached sprites use colors 16-31
        // Convert reference to pointer so we can index it
        let colors_ptr: *Color = (*Color)colors
        unsafe {
            for i in 0..15 {
                let color_index_offset = (16 + i) * 2
                let color_reg_offset = $180 + (u32)color_index_offset
                let color_reg = (*u16)((u32)self.sprite0.custom + color_reg_offset)
                let (r4, g4, b4) = colors_ptr[i].to_rgb4()

                // Pack into 12-bit Amiga RGB format: 0x0RGB
                let rgb12 = ((u16)r4 << 8) | ((u16)g4 << 4) | (u16)b4
                *color_reg = rgb12
            }
        }

        return Result::Ok(())
    }
}

// Attached sprite data (4 bitplanes, 16 colors)
pub struct AttachedSpriteData {
    plane01: SpriteData,  // Bitplanes 0 and 1
    plane23: SpriteData,  // Bitplanes 2 and 3
}

impl AttachedSpriteData {
    // Create attached sprite data from two sprite data structures
    // Both must have the same height
    pub fn from_sprites(plane01: SpriteData, plane23: SpriteData) -> Result<AttachedSpriteData, GraphicsError> {
        if plane01.height() != plane23.height() {
            return Result::Err(GraphicsError::InvalidSpriteData)
        }

        return Result::Ok(AttachedSpriteData {
            plane01: plane01,
            plane23: plane23,
        })
    }

    // Create attached sprite data from raw 4-bitplane data
    // Data format: control words, then 4 words per scanline (plane0, plane1, plane2, plane3), then terminator
    pub fn from_raw(data: *u16, len: u32) -> Result<AttachedSpriteData, GraphicsError> {
        if len < 6u32 {
            return Result::Err(GraphicsError::InvalidSpriteData)
        }

        // Calculate number of scanlines
        let num_words = len - 2u32  // Subtract control words
        let num_lines = num_words / 4u32  // 4 words per scanline
        let size_per_plane = (num_lines * 2u32) + 2u32  // 2 words per line + control words

        // Allocate CHIP RAM for both planes
        let plane01_size = size_per_plane * 2u32
        let plane23_size = size_per_plane * 2u32

        let plane01_opt = ChipMemHandle::new(plane01_size)
        let plane23_opt = ChipMemHandle::new(plane23_size)

        match plane01_opt {
            Option::None => return Result::Err(GraphicsError::BitMapAllocFailed),
            Option::Some(plane01_chip_mem) => {
                match plane23_opt {
                    Option::None => return Result::Err(GraphicsError::BitMapAllocFailed),
                    Option::Some(plane23_chip_mem) => {
                        // Deinterleave the 4-plane data into two 2-plane structures
                        unsafe {
                            let src = data
                            let dest01 = (*u16)plane01_chip_mem.ptr()
                            let dest23 = (*u16)plane23_chip_mem.ptr()

                            // Copy control words to both
                            dest01[0] = src[0]
                            dest01[1] = src[1]
                            dest23[0] = src[0]
                            dest23[1] = src[1]

                            // Deinterleave scanlines
                            let mut src_idx = 2u32
                            let mut dest_idx = 2u32
                            for i in 0..num_lines {
                                dest01[dest_idx] = src[src_idx]       // plane 0
                                dest01[dest_idx + 1u32] = src[src_idx + 1u32]  // plane 1
                                dest23[dest_idx] = src[src_idx + 2u32]  // plane 2
                                dest23[dest_idx + 1u32] = src[src_idx + 3u32]  // plane 3
                                src_idx = src_idx + 4u32
                                dest_idx = dest_idx + 2u32
                            }
                        }

                        let plane01_data = SpriteData {
                            chip_mem: plane01_chip_mem,
                            height: (u16)num_lines,
                        }

                        let plane23_data = SpriteData {
                            chip_mem: plane23_chip_mem,
                            height: (u16)num_lines,
                        }

                        return Result::Ok(AttachedSpriteData {
                            plane01: plane01_data,
                            plane23: plane23_data,
                        })
                    }
                }
            }
        }
    }

    // Get sprite height
    pub fn height(&self) -> u16 {
        return self.plane01.height()
    }
}

// Read hardware sprite collision register
// Returns bitmask of which sprites collided
pub fn read_sprite_collisions() -> u16 {
    let custom = (*u16)$DFF00E  // CLXDAT register
    unsafe {
        return *custom
    }
}

// Clear collision detection latches
// Collisions are cleared by reading the CLXDAT register
pub fn clear_sprite_collisions() {
    let _ = read_sprite_collisions()
}

// Check if a specific sprite channel is free
pub fn is_channel_free(channel: u8) -> bool {
    if channel > 7 {
        return false
    }
    unsafe {
        let channel_mask = 1u8 << channel
        return (SPRITE_CHANNELS_ALLOCATED & channel_mask) == 0
    }
}

// Release all allocated sprite channels
// Useful for cleanup or resetting sprite system
pub fn release_all_sprites() {
    unsafe {
        SPRITE_CHANNELS_ALLOCATED = 0
    }
}
