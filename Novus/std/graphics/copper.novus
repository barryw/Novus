// Copper List Builder API for Amiga Custom Chip
// Module: std::graphics::copper
//
// Provides type-safe copper list construction with automatic validation
// and RAII-based resource management.
//
// Example:
//   var builder = CopperListBuilder::new()
//   builder.wait(0, 0)
//   builder.move_color(0, rgb12(15, 0, 0))
//   builder.wait(100, 0)
//   builder.move_color(0, rgb12(0, 0, 15))
//   let copper_list_handle = builder.build()
//
//   unsafe {
//       copper_list_handle.activate()
//   }
//   // Copper list automatically deactivated and freed when dropped

from std::core import Option, Result, Drop
from std::error::errors import GraphicsError
from std::ffi::exec import AllocVec, FreeVec, CopyMem
from std::ffi::amiga_consts import MEMF_CHIP, MEMF_CLEAR
from std::ffi::amiga_structs import View
from std::ffi::graphics import LoadView, WaitTOF, WaitBlit
from std::ffi::intuition import ViewAddress, RethinkDisplay
from std::ffi::exec import CacheClearU
from std::hardware::registers import is_register_safe_for_copper, color_register, rgb12, CUSTOM_BASE, COP1LC, DMACON, SPR0PTH, SPR0PTL, SPR1PTH, SPR1PTL, SPR2PTH, SPR2PTL, SPR3PTH, SPR3PTL, SPR4PTH, SPR4PTL, SPR5PTH, SPR5PTL, SPR6PTH, SPR6PTL, SPR7PTH, SPR7PTL, BPL1PTH, BPL1PTL, BPL2PTH, BPL2PTL, BPL3PTH, BPL3PTL, BPL4PTH, BPL4PTL, BPL5PTH, BPL5PTL, BPL6PTH, BPL6PTL, BPL7PTH, BPL7PTL, BPL8PTH, BPL8PTL
from std::hardware::chipset import SystemChipset

// Copper control registers
pub const COPJMP1: u32 = $088  // Copper jump strobe register

/// Copper list construction errors
pub enum CopperError {
    InvalidWaitPosition,    // Wait position out of range or not even
    BackwardsWait,          // Wait position before previous wait
    DangerousRegister,      // Attempted write to dangerous register
    AllocationFailed,       // Out of chip RAM
    ListAlreadyFinalized,   // Tried to modify after build()
    InvalidSpriteIndex,     // Sprite index out of range (must be 0-7)
    InvalidPlaneIndex,      // Bitplane index out of range (must be 0-7 for AGA, 0-5 for OCS/ECS)
    MisalignedPointer,      // Pointer must be word-aligned (even address)
}

/// Copper list builder - constructs copper lists with validation
///
/// Uses a growable buffer to build copper lists in chip RAM.
/// Validates all operations to prevent crashes and undefined behavior.
///
/// The builder cannot be modified after calling build().
pub struct CopperListBuilder {
    instructions: *u32,      // Pointer to instruction array in chip RAM
    count: u32,              // Number of instructions
    capacity: u32,           // Current capacity in instructions
    last_vpos: u16,          // Last vertical position for ordering check
    last_hpos: u16,          // Last horizontal position for ordering check
    finalized: bool,         // Prevent modifications after build()
}

impl CopperListBuilder {
    /// Create a new copper list builder
    ///
    /// Allocates initial capacity for 64 instructions (256 bytes).
    @suppress("W0001", "Integer literals are signed but arithmetic with u32 is safe here")
    pub fn new() -> CopperListBuilder {
        unsafe {
            let initial_capacity: u32 = 64
            let size: u32 = initial_capacity * 4  // 4 bytes per instruction
            let mem: *u8 = AllocVec(size, MEMF_CHIP | MEMF_CLEAR)

            if !mem {
                panic!("Failed to allocate copper list builder memory")
            }

            return CopperListBuilder {
                instructions: (*u32)mem,
                count: 0,
                capacity: initial_capacity,
                last_vpos: 0,
                last_hpos: 0,
                finalized: false,
            }
        }
    }

    /// Resize internal buffer (called automatically when needed)
    @suppress("W0001", "Integer literals are signed but arithmetic with u32 is safe here")
    fn grow(&var self) -> bool {
        if self.finalized {
            return false
        }

        unsafe {
            let new_capacity: u32 = self.capacity * 2
            let new_size: u32 = new_capacity * 4
            let new_mem: *u8 = AllocVec(new_size, MEMF_CHIP | MEMF_CLEAR)

            if !new_mem {
                return false  // Allocation failed
            }

            // Copy existing instructions using CopyMem
            let old_size: u32 = self.count * 4
            let src: *u8 = (*u8)self.instructions
            let dst: *u8 = new_mem
            CopyMem(src, dst, old_size)

            // Free old memory
            FreeVec(src)

            // Update to new buffer
            self.instructions = (*u32)new_mem
            self.capacity = new_capacity
            return true
        }
    }

    /// Add a WAIT instruction
    ///
    /// Waits for the raster beam to reach the specified position.
    /// - vpos: Vertical position (line number, 0-312 PAL / 0-262 NTSC)
    /// - hpos: Horizontal position (must be even, 0-226)
    ///
    /// Note: This does NOT wait for blitter to finish. Use wait_with_blitter() if you
    /// need to synchronize with blitter operations.
    ///
    /// Returns error if position is invalid or goes backwards.
    @suppress("W0001", "Integer literals are signed but arithmetic with u32 is safe here")
    pub fn wait(&var self, vpos: u16, hpos: u16) -> Result<(), CopperError> {
        // wait() without blitter synchronization
        return self.wait_internal(vpos, hpos, false)
    }

    /// Add a WAIT instruction that also waits for the blitter to finish
    ///
    /// Waits for the raster beam to reach the specified position AND for the
    /// blitter to finish any pending operations. This is essential when the copper
    /// needs to modify memory that the blitter might be accessing (e.g., changing
    /// bitplane pointers after a blitter fill operation).
    ///
    /// - vpos: Vertical position (line number, 0-312 PAL / 0-262 NTSC)
    /// - hpos: Horizontal position (must be even, 0-226)
    ///
    /// Returns error if position is invalid or goes backwards.
    @suppress("W0001", "Integer literals are signed but arithmetic with u32 is safe here")
    pub fn wait_with_blitter(&var self, vpos: u16, hpos: u16) -> Result<(), CopperError> {
        // wait() WITH blitter synchronization
        return self.wait_internal(vpos, hpos, true)
    }

    /// Internal WAIT instruction implementation
    ///
    /// - wait_blitter: If true, BFD=0 (wait for blitter). If false, BFD=1 (don't wait).
    @suppress("W0001", "Integer literals are signed but arithmetic with u32 is safe here")
    fn wait_internal(&var self, vpos: u16, hpos: u16, wait_blitter: bool) -> Result<(), CopperError> {
        if self.finalized {
            return Result::Err(CopperError::ListAlreadyFinalized)
        }

        // Validate position
        if !self.is_wait_position_valid(vpos, hpos) {
            return Result::Err(CopperError::InvalidWaitPosition)
        }

        // Check for backwards wait
        if vpos < self.last_vpos {
            return Result::Err(CopperError::BackwardsWait)
        }
        if vpos == self.last_vpos && hpos < self.last_hpos {
            return Result::Err(CopperError::BackwardsWait)
        }

        // Ensure capacity
        if self.count >= self.capacity {
            if !self.grow() {
                return Result::Err(CopperError::AllocationFailed)
            }
        }

        // Encode WAIT instruction
        // Format: [VVVVVVVVHHHHHHHH1] [BFD | mask]
        // VP = vertical position (bits 15-8 of first word)
        // HP = horizontal position (bits 7-1 of first word)
        // Bit 0 of first word = 1 (WAIT vs MOVE discriminator)
        // BFD = Blitter Finish Disable (bit 15 of second word)
        //   BFD=1 (0x8000): Don't wait for blitter
        //   BFD=0 (0x0000): Wait for blitter to finish before proceeding
        let vp = ((u32)vpos) & $FF
        let hp = ((u32)hpos) & $FE  // Must be even
        var vp_shift = vp
        vp_shift <<= 8  // Shift left by 8 bits
        let word1 = vp_shift | hp | 1u32  // Bit 0 = 1 for WAIT

        // Set BFD bit based on wait_blitter parameter
        var word2: u32 = $FFFEu32  // BFD=1 (bit 15 set): Don't wait for blitter (default)
        if wait_blitter {
            word2 = $7FFEu32  // BFD=0 (bit 15 clear): Wait for blitter
        }

        var word1_shift = word1
        word1_shift <<= 16  // Shift left by 16 bits
        let instruction = word1_shift | word2

        unsafe {
            let ptr: *u32 = (*u32)((u32)self.instructions + (self.count * 4))
            *ptr = instruction
        }
        self.count++

        // Update validation state
        self.last_vpos = vpos
        self.last_hpos = hpos

        return Result::Ok(())
    }

    /// Add a SKIP instruction (conditional copper execution)
    ///
    /// Compares the current beam position against the specified position and skips
    /// the next copper instruction if the condition is met. This is useful for:
    /// - PAL/NTSC detection and conditional execution
    /// - Blitter synchronization (when combined with wait_with_blitter)
    /// - Complex display mode switching
    ///
    /// The skip occurs if: (current_vpos > vpos) OR (current_vpos == vpos AND current_hpos >= hpos)
    ///
    /// - vpos: Vertical position to compare against
    /// - hpos: Horizontal position to compare against (must be even)
    ///
    /// Example: PAL detection
    ///   builder.skip(262, 0)  // Skip next instruction if beam is past NTSC limit
    ///   builder.move_color(0, ntsc_only_color)  // Only executed on NTSC machines
    ///
    /// Returns error if position is invalid.
    @suppress("W0001", "Integer literals are signed but arithmetic with u32 is safe here")
    pub fn skip(&var self, vpos: u16, hpos: u16) -> Result<(), CopperError> {
        if self.finalized {
            return Result::Err(CopperError::ListAlreadyFinalized)
        }

        // Validate position (same rules as WAIT)
        if !self.is_wait_position_valid(vpos, hpos) {
            return Result::Err(CopperError::InvalidWaitPosition)
        }

        // Ensure capacity
        if self.count >= self.capacity {
            if !self.grow() {
                return Result::Err(CopperError::AllocationFailed)
            }
        }

        // Encode SKIP instruction
        // Format: [VVVVVVVVHHHHHHHH1] [BFD | $0001]
        // Same as WAIT but with bit 0 of second word = 1
        // VP = vertical position (bits 15-8 of first word)
        // HP = horizontal position (bits 7-1 of first word)
        // Bit 0 of first word = 1 (indicates compare instruction)
        // Bit 0 of second word = 1 (SKIP vs WAIT discriminator)
        let vp = ((u32)vpos) & $FF
        let hp = ((u32)hpos) & $FE  // Must be even
        var vp_shift = vp
        vp_shift <<= 8  // Shift left by 8 bits
        let word1 = vp_shift | hp | 1u32  // Bit 0 = 1 for compare instruction

        // SKIP: bit 0 of second word = 1 (vs WAIT which has bit 0 = 0)
        // BFD bit is typically set for SKIP (don't wait for blitter)
        let word2 = $FFFFu32  // BFD=1, bit 0=1 for SKIP

        var word1_shift = word1
        word1_shift <<= 16  // Shift left by 16 bits
        let instruction = word1_shift | word2

        unsafe {
            let ptr: *u32 = (*u32)((u32)self.instructions + (self.count * 4))
            *ptr = instruction
        }
        self.count++

        // Note: We don't update last_vpos/last_hpos for SKIP because it's not a real wait

        return Result::Ok(())
    }

    /// Add a MOVE instruction (write to custom chip register)
    ///
    /// Writes a value to a custom chip register.
    /// - reg_addr: Custom chip register offset (e.g., 0x180 for COLOR00)
    /// - value: 16-bit value to write
    ///
    /// Returns error if register is dangerous.
    @suppress("W0001", "Integer literals are signed but arithmetic with u32 is safe here")
    pub fn move_register(&var self, reg_addr: u32, value: u16) -> Result<(), CopperError> {
        if self.finalized {
            return Result::Err(CopperError::ListAlreadyFinalized)
        }

        // Validate register address
        if !is_register_safe_for_copper(reg_addr) {
            return Result::Err(CopperError::DangerousRegister)
        }

        // Ensure capacity
        if self.count >= self.capacity {
            if !self.grow() {
                return Result::Err(CopperError::AllocationFailed)
            }
        }

        // Encode MOVE instruction
        // Format: [register_offset][value]
        // Register offset is from custom chip base ($DFF000)
        // Bit 0 of first word = 0 (MOVE vs WAIT discriminator)
        let offset = reg_addr & $1FE  // Ensure even, bit 0 = 0
        let val = (u32)value
        var offset_shift = offset
        offset_shift <<= 16  // Shift left by 16 bits
        let instruction = offset_shift | val

        unsafe {
            let ptr: *u32 = (*u32)((u32)self.instructions + (self.count * 4))
            *ptr = instruction
        }
        self.count++

        return Result::Ok(())
    }

    /// Convenience: Set a color register
    ///
    /// - index: Color register index (0-31)
    /// - color: 12-bit RGB value (use rgb12() function to construct)
    pub fn move_color(&var self, index: u8, color: u16) -> Result<(), CopperError> {
        let reg_addr: u32 = color_register(index)
        return self.move_register(reg_addr, color)
    }

    /// Convenience: Set a sprite data pointer (enables sprite multiplexing)
    ///
    /// Changes the data pointer for a hardware sprite. This allows reusing the 8 hardware
    /// sprites multiple times per frame by changing their data pointers at different
    /// scanlines.
    ///
    /// The pointer is automatically split into high and low words and written to the
    /// appropriate SPRxPTH/SPRxPTL registers.
    ///
    /// # Arguments
    /// * `sprite` - Sprite index (0-7)
    /// * `addr` - Pointer to sprite data in chip RAM (must be word-aligned)
    ///
    /// # Example: Sprite Multiplexing
    ///   builder.wait(50, 0)
    ///   builder.move_sprite_ptr(0, enemy1_sprite)?  // Sprite 0 shows enemy at top
    ///   builder.wait(150, 0)
    ///   builder.move_sprite_ptr(0, player_sprite)?  // Reuse sprite 0 for player
    ///
    /// Returns error if sprite index is out of range or pointer is misaligned.
    @suppress("W0001", "Integer literals are signed but arithmetic with u32 is safe here")
    pub fn move_sprite_ptr(&var self, sprite: u8, addr: *u8) -> Result<(), CopperError> {
        // Validate sprite index
        if sprite > 7 {
            return Result::Err(CopperError::InvalidSpriteIndex)
        }

        // Validate pointer alignment (must be word-aligned)
        let ptr_val: u32 = (u32)addr
        if (ptr_val & 1) != 0 {
            return Result::Err(CopperError::MisalignedPointer)
        }

        // Split pointer into high and low words
        let addr_high: u16 = (u16)(ptr_val >> 16)
        let addr_low: u16 = (u16)(ptr_val & $FFFF)

        // Calculate register addresses for this sprite
        // SPR0PTH = $120, SPR1PTH = $124, etc. (4 bytes per sprite)
        let sprite_offset: u32 = (u32)sprite * 4
        let pth_reg: u32 = SPR0PTH + sprite_offset
        let ptl_reg: u32 = SPR0PTL + sprite_offset

        // Write high word first, then low word
        // Note: Explicit error handling to work around codegen issue with Result<(), E>
        let result1 = self.move_register(pth_reg, addr_high)
        match result1 {
            Result::Err(e) => return Result::Err(e),
            Result::Ok(_) => {}
        }

        let result2 = self.move_register(ptl_reg, addr_low)
        match result2 {
            Result::Err(e) => return Result::Err(e),
            Result::Ok(_) => {}
        }

        return Result::Ok(())
    }

    /// Convenience: Set a bitplane data pointer (enables split-screen effects)
    ///
    /// Changes the data pointer for a bitplane. This allows advanced display effects like:
    /// - Split-screen displays (different buffers for top/bottom of screen)
    /// - Parallax scrolling (different scroll speeds for different layers)
    /// - Display list chaining
    ///
    /// The pointer is automatically split into high and low words and written to the
    /// appropriate BPLxPTH/BPLxPTL registers.
    ///
    /// # Arguments
    /// * `plane` - Bitplane index (0-7 for AGA, 0-5 for OCS/ECS)
    /// * `addr` - Pointer to bitplane data in chip RAM (must be word-aligned)
    ///
    /// # Example: Split Screen
    ///   builder.wait(100, 0)
    ///   builder.move_bitplane_ptr(0, top_buffer)?    // Top half uses one buffer
    ///   builder.wait(200, 0)
    ///   builder.move_bitplane_ptr(0, bottom_buffer)? // Bottom half uses different buffer
    ///
    /// Returns error if plane index is out of range or pointer is misaligned.
    @suppress("W0001", "Integer literals are signed but arithmetic with u32 is safe here")
    pub fn move_bitplane_ptr(&var self, plane: u8, addr: *u8) -> Result<(), CopperError> {
        // Validate bitplane index
        // TODO: Could check actual chipset and enforce 0-5 for OCS/ECS, 0-7 for AGA
        // For now, allow 0-7 (AGA max) and let hardware ignore planes 6-7 on OCS/ECS
        if plane > 7 {
            return Result::Err(CopperError::InvalidPlaneIndex)
        }

        // Validate pointer alignment (must be word-aligned)
        let ptr_val: u32 = (u32)addr
        if (ptr_val & 1) != 0 {
            return Result::Err(CopperError::MisalignedPointer)
        }

        // Split pointer into high and low words
        let addr_high: u16 = (u16)(ptr_val >> 16)
        let addr_low: u16 = (u16)(ptr_val & $FFFF)

        // Calculate register addresses for this bitplane
        // BPL1PTH = $0E0, BPL2PTH = $0E4, etc. (4 bytes per plane)
        let plane_offset: u32 = (u32)plane * 4
        let pth_reg: u32 = BPL1PTH + plane_offset
        let ptl_reg: u32 = BPL1PTL + plane_offset

        // Write high word first, then low word
        // Note: Explicit error handling to work around codegen issue with Result<(), E>
        let result1 = self.move_register(pth_reg, addr_high)
        match result1 {
            Result::Err(e) => return Result::Err(e),
            Result::Ok(_) => {}
        }

        let result2 = self.move_register(ptl_reg, addr_low)
        match result2 {
            Result::Err(e) => return Result::Err(e),
            Result::Ok(_) => {}
        }

        return Result::Ok(())
    }

    /// Convenience: Wait for vertical blank
    ///
    /// Waits for the start of vertical blank (line 262 on NTSC, 312 on PAL).
    /// Uses conservative NTSC value for compatibility.
    pub fn wait_vblank(&var self) -> Result<(), CopperError> {
        return self.wait(262, 0)
    }

    /// Validate WAIT position
    fn is_wait_position_valid(&self, vpos: u16, hpos: u16) -> bool {
        // Horizontal: must be even and in range 0-226
        if (hpos & 1) != 0 {
            return false
        }
        if hpos > 226 {
            return false
        }

        // Vertical: Use NTSC limits (0-262) as most restrictive
        let max_lines: u16 = 262  // NTSC (most restrictive)

        if vpos > max_lines {
            return false
        }

        return true
    }

    /// Finalize and build the copper list
    ///
    /// Adds the terminator instruction (WAIT $FFFF, $FFFE) and allocates
    /// final chip RAM. Returns an RAII handle that automatically restores
    /// the system copper on drop.
    ///
    /// After calling build(), the builder cannot be modified.
    @suppress("W0001", "Integer literals are signed but arithmetic with u32 is safe here")
    pub fn build(&var self) -> Result<CopperListHandle, CopperError> {
        if self.finalized {
            return Result::Err(CopperError::ListAlreadyFinalized)
        }

        // Add END instruction: WAIT($FFFF, $FFFE)
        if self.count >= self.capacity {
            if !self.grow() {
                return Result::Err(CopperError::AllocationFailed)
            }
        }

        // END instruction: $FFFFFFFE
        unsafe {
            let ptr: *u32 = (*u32)((u32)self.instructions + (self.count * 4))
            *ptr = $FFFFFFFEu32
        }
        self.count++

        // Allocate final chip RAM and copy instructions
        let final_size: u32 = self.count * 4
        unsafe {
            let final_mem: *u8 = AllocVec(final_size, MEMF_CHIP | MEMF_CLEAR)
            if !final_mem {
                return Result::Err(CopperError::AllocationFailed)
            }

            // Copy instructions to final buffer using CopyMem
            let src: *u8 = (*u8)self.instructions
            let dst: *u8 = final_mem
            CopyMem(src, dst, final_size)

            // Mark as finalized
            self.finalized = true

            // Create RAII handle
            return Result::Ok(CopperListHandle {
                memory: (*u32)final_mem,
                size: final_size,
                active: false,
                saved_view: null,
            })
        }
    }
}

// Automatic cleanup for builder
impl Drop for CopperListBuilder {
    fn drop(&var self) {
        if self.capacity > 0 {
            unsafe {
                let mem: *u8 = (*u8)self.instructions
                FreeVec(mem)
                self.instructions = null
                self.capacity = 0
                self.count = 0
            }
        }
    }
}

/// Copper List Handle - RAII handle for a finalized copper list
///
/// Automatically restores system copper and frees memory on drop.
/// This ensures you can never leak copper lists or leave the hardware
/// in an inconsistent state.
pub struct CopperListHandle {
    memory: *u32,      // Chip RAM containing copper instructions
    size: u32,         // Size in bytes
    active: bool,      // Is this list currently active?
    saved_view: *View, // Saved system view to restore later
}

impl CopperListHandle {
    /// Get pointer to copper list memory (for direct COP1LC write if needed)
    pub fn ptr(&self) -> *u32 {
        return self.memory
    }

    /// Get size in bytes
    pub fn size(&self) -> u32 {
        return self.size
    }

    /// Update a color value in the copper list at a specific instruction index
    ///
    /// This allows you to modify an existing copper list without rebuilding it.
    /// The instruction at the given index must be a MOVE instruction to a color register.
    ///
    /// This version waits for vertical blank before updating to prevent visual glitches.
    /// For maximum performance, use update_color_at_unchecked() if you're managing
    /// synchronization yourself.
    ///
    /// # Arguments
    /// * `instruction_idx` - Index of the instruction to update (0-based)
    /// * `new_color` - New 12-bit RGB color value
    ///
    /// # Safety
    /// This is unsafe because it directly modifies copper list memory.
    /// The caller must ensure the instruction index is valid and points to a color MOVE.
    @suppress("W0001", "Integer literals are signed but arithmetic with u32 is safe here")
    pub fn update_color_at(&var self, instruction_idx: u32, new_color: u16) {
        unsafe {
            // Wait for vertical blank to avoid glitches from copper reading while we write
            WaitTOF()

            // Each instruction is 4 bytes (32 bits)
            // MOVE format: [register_offset << 16 | value]
            // We only need to update the lower 16 bits (the value)
            let offset: u32 = instruction_idx * 4
            let instr_ptr: *u32 = (*u32)((u32)self.memory + offset)
            let old_instr: u32 = *instr_ptr

            // Clear lower 16 bits and OR in new color
            let new_instr: u32 = (old_instr & $FFFF0000u32) | (u32)new_color
            *instr_ptr = new_instr

            // CRITICAL for 68040/68060: Flush CPU data cache to chip RAM
            // Without this, the copper reads stale data from chip RAM while
            // the new value sits in the CPU's copyback cache
            CacheClearU()
        }
    }

    /// Activate this copper list (loads it into the copper)
    ///
    /// SAFETY: This directly writes to hardware registers.
    /// The copper list must remain valid for as long as it's active.
    /// You should keep the CopperList handle in scope.
    pub fn activate(&var self) {
        unsafe {
            // Save the current view so we can restore it later
            self.saved_view = ViewAddress()

            // CRITICAL: Must stop current copper first
            // Ensure blitter is idle before changing view
            WaitBlit()
            LoadView(null)
            WaitTOF()

            // Write copper list pointer to COP1LC/COP1LCL registers
            // Must split 32-bit address into two 16-bit writes
            let addr: u32 = (u32)self.memory
            let addr_high: u16 = (u16)(addr >> 16)
            let addr_low: u16 = (u16)(addr & $FFFF)

            // Write high word to COP1LCH ($DFF080)
            let cop1lch_ptr: *u16 = (*u16)(CUSTOM_BASE + $80)
            *cop1lch_ptr = addr_high

            // Write low word to COP1LCL ($DFF082)
            let cop1lcl_ptr: *u16 = (*u16)(CUSTOM_BASE + $82)
            *cop1lcl_ptr = addr_low

            // Strobe COPJMP1 to trigger copper load
            let copjmp1_ptr: *u16 = (*u16)(CUSTOM_BASE + COPJMP1)
            *copjmp1_ptr = 0

            // Enable copper DMA (bit 7 = copper, bit 15 = set/clear)
            let dmacon_ptr: *u16 = (*u16)(CUSTOM_BASE + DMACON)
            *dmacon_ptr = $8080  // Set bit 7 (copper enable)

            // Wait for copper to start
            WaitTOF()

            self.active = true
        }
    }

    /// Switch to a new copper list without restoring the view.
    /// This enables smooth transitions between copper effects.
    /// Simply updates the copper hardware pointer - memory management is caller's responsibility.
    ///
    /// # Arguments
    /// * `new_list` - The new copper list to switch to
    ///
    /// # Safety
    /// This is unsafe because it directly writes to hardware registers.
    /// The caller must ensure the new copper list remains valid.
    pub fn switch_to(&var self, new_list: &CopperListHandle) {
        unsafe {
            // Wait for current copper to finish current frame
            WaitTOF()

            // Write new copper list pointer
            let addr: u32 = (u32)new_list.memory
            let addr_high: u16 = (u16)(addr >> 16)
            let addr_low: u16 = (u16)(addr & $FFFF)

            // Write high word to COP1LCH ($DFF080)
            let cop1lch_ptr: *u16 = (*u16)(CUSTOM_BASE + $80)
            *cop1lch_ptr = addr_high

            // Write low word to COP1LCL ($DFF082)
            let cop1lcl_ptr: *u16 = (*u16)(CUSTOM_BASE + $82)
            *cop1lcl_ptr = addr_low

            // Strobe COPJMP1 to trigger copper load
            let copjmp1_ptr: *u16 = (*u16)(CUSTOM_BASE + COPJMP1)
            *copjmp1_ptr = 0

            // Wait for copper to switch to new list
            WaitTOF()
        }
    }

    /// Mark this copper list as inactive without restoring the view.
    ///
    /// Use this when you've switched to a different copper list and want to
    /// drop the old one without restoring the workbench view.
    /// The copper hardware is already pointing at a different list, so we
    /// just need to prevent Drop from restoring the view.
    pub fn deactivate_without_restore(&var self) {
        self.active = false
    }

    /// Deactivate and restore system copper
    ///
    /// This is called automatically by Drop, but you can call it manually
    /// if you want to restore the system copper before the handle is dropped.
    pub fn deactivate(&var self) {
        if self.active {
            unsafe {
                // Disable copper DMA before restoring view
                let dmacon_ptr: *u16 = (*u16)(CUSTOM_BASE + DMACON)
                *dmacon_ptr = $0080  // Clear bit 7 (copper disable)

                LoadView(self.saved_view)  // Restore saved view
                WaitTOF()                  // Wait for switch

                // Note: RethinkDisplay() not needed for copper-only changes
                // It rebuilds the entire display database which is slow (1-5 seconds)
                // and unnecessary when we're just restoring the original view
            }
            self.active = false
        }
    }
}

// Automatic cleanup for copper list
impl Drop for CopperListHandle {
    fn drop(&var self) {
        // CRITICAL: Restore system copper before freeing memory!
        if self.active {
            unsafe {
                // Disable copper DMA before restoring view
                let dmacon_ptr: *u16 = (*u16)(CUSTOM_BASE + DMACON)
                *dmacon_ptr = $0080  // Clear bit 7 (copper disable)

                // Only restore view if we saved one
                if self.saved_view != null {
                    LoadView(self.saved_view)
                    WaitTOF()
                    // Note: RethinkDisplay() not needed for copper-only changes
                    // It rebuilds the entire display database which is slow (1-5 seconds)
                }
            }
        }

        // Free chip RAM
        if self.size > 0 {
            unsafe {
                let mem: *u8 = (*u8)self.memory
                FreeVec(mem)
                self.memory = null
                self.size = 0
            }
        }
    }
}
