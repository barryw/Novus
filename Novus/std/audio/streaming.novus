// Audio Streaming
// Module: std::audio::streaming
//
// Provides streaming playback for audio that exceeds Paula's 128KB limit.
// Uses audio.device with triple-buffered async I/O for gapless playback.
//
// # How It Works
// 1. Allocates 3 chip RAM buffers (default 16KB each)
// 2. Opens audio.device and allocates a channel
// 3. Queues ALL THREE buffers to audio.device via BeginIO (non-blocking)
// 4. When a buffer finishes, it's refilled and re-queued immediately
// 5. Call tick() in your main loop to handle buffer refills
//
// Triple-buffering eliminates pops/clicks because:
// - Buffer A is currently playing
// - Buffer B is queued next (already in audio.device)
// - Buffer C is being refilled
// This gives us a full buffer duration to refill without any timing pressure.
//
// # Example
// ```novus
// @audio("long_song.wav", chip = false, sample_rate = 11025)
// static song: AudioAsset = []
//
// // Use any available channel
// var streamer = AudioStreamer::new(&song.data, song.size, song.period)?
// println!("Using channel {}", streamer.channel())
// streamer.play(false)?  // false = don't loop
//
// while streamer.is_playing() {
//     streamer.tick()?
//     WaitTOF()
// }
// // Streamer cleans up automatically on drop
//
// // Or request a specific channel:
// var streamer2 = AudioStreamer::new_on_channel(2, &song.data, song.size, song.period)?
// ```

from std::core import Result, Option, Drop
from std::ffi::exec import CopyMem, CacheClearU
from std::ffi::exec import CreateMsgPort, DeleteMsgPort, CreateIORequest, DeleteIORequest
from std::ffi::exec import OpenDevice, CloseDevice, BeginIO, CheckIO, WaitIO, GetMsg
from std::ffi::amiga_consts import MEMF_PUBLIC
from std::ffi::amiga_consts import CMD_WRITE, ADCMD_FREE, ADIOF_PERVOL, ADIOF_NOWAIT
from std::ffi::amiga_structs import IOAudio, IORequest, MsgPort
from std::audio::errors import AudioError
from std::audio::paula import ChannelMask
from std::memory::chip import is_chip_ram
from std::memory::chip_pool import ChipPool
from std::hardware::chipset import DISPLAY, DisplayType
from std::io::file import write

// ============================================================================
// Constants
// ============================================================================

/// Default buffer size (16KB) - good balance of memory vs interrupt frequency
pub const DEFAULT_BUFFER_SIZE: u32 = 16 * 1024

/// Minimum buffer size (4KB) - smaller = more CPU overhead
pub const MIN_BUFFER_SIZE: u32 = 4 * 1024

/// Maximum buffer size (64KB) - larger = more chip RAM usage
pub const MAX_BUFFER_SIZE: u32 = 64 * 1024

/// Number of buffers (triple-buffering for gapless playback)
const NUM_BUFFERS: u32 = 3

// ============================================================================
// Audio Streamer
// ============================================================================

/// Streaming audio player for long samples using audio.device
///
/// Handles audio files of any length by streaming chunks through
/// chip RAM buffers. Uses triple-buffered async I/O with audio.device
/// for gapless playback that works correctly on all Amigas.
///
/// # Memory Usage
/// - 3 × buffer_size of chip RAM (default 48KB total)
/// - Source data can be in fast RAM
///
/// # Usage Pattern
/// ```novus
/// // Any available channel:
/// var streamer = AudioStreamer::new(&audio_data, size, period)?
/// // Or specific channel:
/// var streamer = AudioStreamer::new_on_channel(0, &audio_data, size, period)?
///
/// streamer.play(loop)?
/// while streamer.is_playing() {
///     streamer.tick()?  // MUST call this regularly!
///     // ... your game logic ...
///     WaitTOF()
/// }
/// ```
pub struct AudioStreamer {
    // Audio.device resources - LEFT channel (or mono)
    // (all pointers - 4 bytes each, naturally aligned)
    io_audio_0: *IOAudio,    // IORequest for buffer 0, left/mono channel
    io_audio_1: *IOAudio,    // IORequest for buffer 1, left/mono channel
    io_audio_2: *IOAudio,    // IORequest for buffer 2, left/mono channel

    // Audio.device resources - RIGHT channel (stereo only)
    io_audio_0_r: *IOAudio,  // IORequest for buffer 0, right channel
    io_audio_1_r: *IOAudio,  // IORequest for buffer 1, right channel
    io_audio_2_r: *IOAudio,  // IORequest for buffer 2, right channel

    port: *MsgPort,          // Message port for I/O completion

    // Triple buffers in chip RAM (all pointers - 4 bytes each)
    buffer_0: *u8,
    buffer_1: *u8,
    buffer_2: *u8,

    // Source data (pointer then u32s - all 4-byte aligned)
    source_ptr: *u8,
    source_size: u32,
    source_offset: u32,      // Current read position (how much we've loaded)
    played_bytes: u32,       // How much has actually been played (buffer granularity)
    buffer_size: u32,

    // Time-based position tracking (all u32 - 4-byte aligned)
    sample_rate: u32,        // Samples per second (for position calculation)
    frames_elapsed: u32,     // VBlank frames since playback started

    // 16-bit values grouped together (2-byte aligned)
    alloc_key: i16,          // Allocation key from device
    period: u16,
    volume: u16,

    // Channel selection using unified ChannelMask
    channels: ChannelMask,   // Which channels we have allocated (1 for mono, 2 for stereo)

    // Individual channel masks for CMD_WRITE (derived from channels)
    left_channel_mask: u8,   // Single channel bit for left (e.g., $01 for channel 0)
    right_channel_mask: u8,  // Single channel bit for right (e.g., $02 for channel 1)

    // 8-bit values grouped together at the end
    pending_count: u8,       // How many buffers are currently queued (0-3 for mono, 0-6 for stereo)
    is_pal: bool,            // PAL (50Hz) or NTSC (60Hz)
    is_playing: bool,
    loop_playback: bool,
    reached_end: bool,

    // Per-buffer completion tracking for stereo
    // For stereo, we need BOTH left and right to complete before refilling
    // These flags track if left channel has completed for each buffer
    buf0_left_done: bool,
    buf1_left_done: bool,
    buf2_left_done: bool,
    // These flags track if right channel has completed for each buffer
    buf0_right_done: bool,
    buf1_right_done: bool,
    buf2_right_done: bool,
}

impl AudioStreamer {
    // ========================================================================
    // Private helper functions to reduce register pressure in with_stereo_options
    // ========================================================================

    /// Helper: Clamp buffer size to valid range and ensure word alignment
    fn clamp_buffer_size(buffer_size: u32) -> u32 {
        var actual = buffer_size
        if actual < MIN_BUFFER_SIZE {
            actual = MIN_BUFFER_SIZE
        }
        if actual > MAX_BUFFER_SIZE {
            actual = MAX_BUFFER_SIZE
        }
        // Ensure even size (Paula requires word alignment)
        if (actual & 1) != 0 {
            actual = actual - 1
        }
        return actual
    }

    /// Helper: Create message port (step 1 of IORequest creation)
    fn create_msg_port() -> Result<*MsgPort, AudioError> {
        let port = CreateMsgPort()
        if (u32)port == 0 {
            return Result::Err(AudioError::NoMsgPort)
        }
        return Result::Ok(port)
    }

    /// Helper: Create three IORequests for triple-buffering (mono or one side of stereo)
    fn create_io_requests(port: *MsgPort, io0_out: **IOAudio, io1_out: **IOAudio, io2_out: **IOAudio) -> Result<(), AudioError> {
        let req0 = CreateIORequest(port, @sizeof(IOAudio))
        if (u32)req0 == 0 {
            return Result::Err(AudioError::NoIORequest)
        }

        let req1 = CreateIORequest(port, @sizeof(IOAudio))
        if (u32)req1 == 0 {
            DeleteIORequest(req0)
            return Result::Err(AudioError::NoIORequest)
        }

        let req2 = CreateIORequest(port, @sizeof(IOAudio))
        if (u32)req2 == 0 {
            DeleteIORequest(req1)
            DeleteIORequest(req0)
            return Result::Err(AudioError::NoIORequest)
        }

        unsafe {
            *io0_out = (*IOAudio)req0
            *io1_out = (*IOAudio)req1
            *io2_out = (*IOAudio)req2
        }
        return Result::Ok(())
    }

    /// Helper: Create six IORequests for stereo triple-buffering (3 left + 3 right)
    fn create_stereo_io_requests(
        port: *MsgPort,
        io0_l_out: **IOAudio, io1_l_out: **IOAudio, io2_l_out: **IOAudio,
        io0_r_out: **IOAudio, io1_r_out: **IOAudio, io2_r_out: **IOAudio
    ) -> Result<(), AudioError> {
        // Create left channel IORequests
        let req0_l = CreateIORequest(port, @sizeof(IOAudio))
        if (u32)req0_l == 0 {
            return Result::Err(AudioError::NoIORequest)
        }

        let req1_l = CreateIORequest(port, @sizeof(IOAudio))
        if (u32)req1_l == 0 {
            DeleteIORequest(req0_l)
            return Result::Err(AudioError::NoIORequest)
        }

        let req2_l = CreateIORequest(port, @sizeof(IOAudio))
        if (u32)req2_l == 0 {
            DeleteIORequest(req1_l)
            DeleteIORequest(req0_l)
            return Result::Err(AudioError::NoIORequest)
        }

        // Create right channel IORequests
        let req0_r = CreateIORequest(port, @sizeof(IOAudio))
        if (u32)req0_r == 0 {
            DeleteIORequest(req2_l)
            DeleteIORequest(req1_l)
            DeleteIORequest(req0_l)
            return Result::Err(AudioError::NoIORequest)
        }

        let req1_r = CreateIORequest(port, @sizeof(IOAudio))
        if (u32)req1_r == 0 {
            DeleteIORequest(req0_r)
            DeleteIORequest(req2_l)
            DeleteIORequest(req1_l)
            DeleteIORequest(req0_l)
            return Result::Err(AudioError::NoIORequest)
        }

        let req2_r = CreateIORequest(port, @sizeof(IOAudio))
        if (u32)req2_r == 0 {
            DeleteIORequest(req1_r)
            DeleteIORequest(req0_r)
            DeleteIORequest(req2_l)
            DeleteIORequest(req1_l)
            DeleteIORequest(req0_l)
            return Result::Err(AudioError::NoIORequest)
        }

        unsafe {
            *io0_l_out = (*IOAudio)req0_l
            *io1_l_out = (*IOAudio)req1_l
            *io2_l_out = (*IOAudio)req2_l
            *io0_r_out = (*IOAudio)req0_r
            *io1_r_out = (*IOAudio)req1_r
            *io2_r_out = (*IOAudio)req2_r
        }
        return Result::Ok(())
    }

    /// Helper: Allocate stereo channels via audio.device
    fn allocate_stereo_channels(io0: *IOAudio, port: *MsgPort) -> Result<(), AudioError> {
        // Set up STEREO channel allocation
        // Provide multiple stereo pair combinations for audio.device to try
        var alloc_map: [u8; 4] = [$03, $05, $0A, $0C]
        // $03 = channels 0+1, $05 = channels 0+2, $0A = channels 1+3, $0C = channels 2+3

        io0.ioa_Request.io_Message.mn_ReplyPort = port
        io0.ioa_Request.io_Message.mn_Node.ln_Pri = 0
        io0.ioa_Data = &alloc_map[0]
        io0.ioa_Length = 2  // We want 2 channels

        unsafe {
            let req_addr = &io0.ioa_Request
            let ioreq = (*IORequest)req_addr
            let error = OpenDevice("audio.device", 0, ioreq, 0)

            if error != 0 {
                if error == -10 {
                    return Result::Err(AudioError::NoAllocation)
                }
                if error == -11 {
                    return Result::Err(AudioError::AllocFailed)
                }
                return Result::Err(AudioError::DeviceOpenFailed)
            }
        }
        return Result::Ok(())
    }

    /// Helper: Setup IORequests with allocated stereo unit
    /// Returns the unit mask as u32 (VBCC has u8 return bugs)
    fn setup_stereo_io_units(io0: *IOAudio, io1: *IOAudio, io2: *IOAudio, port: *MsgPort, alloc_key: i16) -> u32 {
        // Extract the unit mask from io_Unit (pointer contains channel bitmask)
        let unit_ptr = (u32)io0.ioa_Request.io_Unit
        let stereo_unit = (*Unit)unit_ptr

        io0.ioa_Request.io_Unit = stereo_unit

        // Copy device info to second IORequest
        io1.ioa_Request.io_Device = io0.ioa_Request.io_Device
        io1.ioa_Request.io_Unit = stereo_unit
        io1.ioa_Request.io_Message.mn_ReplyPort = port
        io1.ioa_AllocKey = alloc_key

        // Copy device info to third IORequest
        io2.ioa_Request.io_Device = io0.ioa_Request.io_Device
        io2.ioa_Request.io_Unit = stereo_unit
        io2.ioa_Request.io_Message.mn_ReplyPort = port
        io2.ioa_AllocKey = alloc_key

        // Return as u32 to avoid VBCC u8 return value bugs
        return unit_ptr
    }

    /// Helper: Setup all 6 IORequests for stereo triple-buffering
    /// Each IORequest is set to a SINGLE channel (left or right)
    /// Returns: (stereo_mask, left_mask, right_mask) packed as u32
    ///          bits 0-7: stereo mask (both channels), bits 8-15: left, bits 16-23: right
    fn setup_all_stereo_io_units(
        io0_l: *IOAudio, io1_l: *IOAudio, io2_l: *IOAudio,
        io0_r: *IOAudio, io1_r: *IOAudio, io2_r: *IOAudio,
        port: *MsgPort, alloc_key: i16
    ) -> u32 {
        // Extract the stereo unit mask from io_Unit (contains BOTH channel bits)
        let stereo_mask = (u8)(u32)io0_l.ioa_Request.io_Unit
        let device = io0_l.ioa_Request.io_Device

        // Split stereo mask into left and right channel bits
        // Paula channels: 0 and 3 are LEFT, 1 and 2 are RIGHT
        // Stereo pairs: 0+1 ($03), 0+2 ($05), 1+3 ($0A), 2+3 ($0C)
        var left_mask: u8 = 0
        var right_mask: u8 = 0

        // Channel 0 (bit 0) = LEFT
        if (stereo_mask & $01) != 0 {
            left_mask = $01
        }
        // Channel 1 (bit 1) = RIGHT
        if (stereo_mask & $02) != 0 {
            right_mask = $02
        }
        // Channel 2 (bit 2) = RIGHT
        if (stereo_mask & $04) != 0 {
            if right_mask == 0 {
                right_mask = $04
            } else {
                left_mask = $04  // If right already assigned, this is left (e.g., pair 2+3)
            }
        }
        // Channel 3 (bit 3) = LEFT
        if (stereo_mask & $08) != 0 {
            if left_mask == 0 {
                left_mask = $08
            } else {
                right_mask = $08  // If left already assigned, this is right (e.g., pair 1+3)
            }
        }

        // Actually, let's be more precise about Paula's channel mapping:
        // Channels 0,3 output to LEFT speaker, channels 1,2 output to RIGHT speaker
        // So from stereo_mask, find one LEFT channel and one RIGHT channel
        left_mask = 0
        right_mask = 0

        // Find a left channel (0 or 3)
        if (stereo_mask & $01) != 0 {
            left_mask = $01  // Channel 0
        } else if (stereo_mask & $08) != 0 {
            left_mask = $08  // Channel 3
        }

        // Find a right channel (1 or 2)
        if (stereo_mask & $02) != 0 {
            right_mask = $02  // Channel 1
        } else if (stereo_mask & $04) != 0 {
            right_mask = $04  // Channel 2
        }

        let left_unit = (*Unit)(u32)left_mask
        let right_unit = (*Unit)(u32)right_mask

        // Setup LEFT channel IORequests (io0_l, io1_l, io2_l)
        io0_l.ioa_Request.io_Unit = left_unit
        // Device already set from OpenDevice

        io1_l.ioa_Request.io_Device = device
        io1_l.ioa_Request.io_Unit = left_unit
        io1_l.ioa_Request.io_Message.mn_ReplyPort = port
        io1_l.ioa_AllocKey = alloc_key

        io2_l.ioa_Request.io_Device = device
        io2_l.ioa_Request.io_Unit = left_unit
        io2_l.ioa_Request.io_Message.mn_ReplyPort = port
        io2_l.ioa_AllocKey = alloc_key

        // Setup RIGHT channel IORequests (io0_r, io1_r, io2_r)
        io0_r.ioa_Request.io_Device = device
        io0_r.ioa_Request.io_Unit = right_unit
        io0_r.ioa_Request.io_Message.mn_ReplyPort = port
        io0_r.ioa_AllocKey = alloc_key

        io1_r.ioa_Request.io_Device = device
        io1_r.ioa_Request.io_Unit = right_unit
        io1_r.ioa_Request.io_Message.mn_ReplyPort = port
        io1_r.ioa_AllocKey = alloc_key

        io2_r.ioa_Request.io_Device = device
        io2_r.ioa_Request.io_Unit = right_unit
        io2_r.ioa_Request.io_Message.mn_ReplyPort = port
        io2_r.ioa_AllocKey = alloc_key

        // Pack return value: stereo_mask | (left_mask << 8) | (right_mask << 16)
        return (u32)stereo_mask | ((u32)left_mask << 8) | ((u32)right_mask << 16)
    }

    /// Helper: Allocate three chip RAM buffers for triple-buffering
    fn allocate_triple_buffers(size: u32, buf0_out: **u8, buf1_out: **u8, buf2_out: **u8) -> Result<(), AudioError> {
        unsafe {
            let buf0_opt = ChipPool::alloc(size)
            let buf0 = match buf0_opt {
                Option::Some(ptr) => ptr,
                Option::None => return Result::Err(AudioError::AllocationFailed)
            }

            let buf1_opt = ChipPool::alloc(size)
            let buf1 = match buf1_opt {
                Option::Some(ptr) => ptr,
                Option::None => {
                    let _ = ChipPool::free(buf0)
                    return Result::Err(AudioError::AllocationFailed)
                }
            }

            let buf2_opt = ChipPool::alloc(size)
            let buf2 = match buf2_opt {
                Option::Some(ptr) => ptr,
                Option::None => {
                    let _ = ChipPool::free(buf1)
                    let _ = ChipPool::free(buf0)
                    return Result::Err(AudioError::AllocationFailed)
                }
            }

            *buf0_out = buf0
            *buf1_out = buf1
            *buf2_out = buf2
            return Result::Ok(())
        }
    }

    /// Helper: Build the final AudioStreamer struct for stereo playback
    /// packed_masks: stereo_mask | (left_mask << 8) | (right_mask << 16)
    fn build_stereo_streamer(
        io0_l: *IOAudio, io1_l: *IOAudio, io2_l: *IOAudio,
        io0_r: *IOAudio, io1_r: *IOAudio, io2_r: *IOAudio,
        port: *MsgPort, alloc_key: i16, packed_masks: u32,
        buf0: *u8, buf1: *u8, buf2: *u8, actual_size: u32,
        source: *u8, source_size: u32, period: u16, sample_rate: u32
    ) -> Result<AudioStreamer, AudioError> {
        // Detect PAL/NTSC for frame-based timing
        let is_pal = DISPLAY() == DisplayType::PAL

        // Unpack the masks
        let stereo_mask = (u8)(packed_masks & $FF)
        let left_mask = (u8)((packed_masks >> 8) & $FF)
        let right_mask = (u8)((packed_masks >> 16) & $FF)

        // Build ChannelMask directly - no function calls between assignment and use
        var channels: ChannelMask = ChannelMask { mask: stereo_mask }

        return Result::Ok(AudioStreamer {
            io_audio_0: io0_l,
            io_audio_1: io1_l,
            io_audio_2: io2_l,
            io_audio_0_r: io0_r,
            io_audio_1_r: io1_r,
            io_audio_2_r: io2_r,
            port: port,
            alloc_key: alloc_key,
            channels: channels,
            left_channel_mask: left_mask,
            right_channel_mask: right_mask,
            period: period,
            volume: 64,
            buffer_0: buf0,
            buffer_1: buf1,
            buffer_2: buf2,
            buffer_size: actual_size,
            pending_count: 0,
            source_ptr: source,
            source_size: source_size,
            source_offset: 0,
            played_bytes: 0,
            sample_rate: sample_rate,
            frames_elapsed: 0,
            is_pal: is_pal,
            is_playing: false,
            loop_playback: false,
            reached_end: false,
            buf0_left_done: false,
            buf1_left_done: false,
            buf2_left_done: false,
            buf0_right_done: false,
            buf1_right_done: false,
            buf2_right_done: false,
        })
    }

    // ========================================================================
    // Public API
    // ========================================================================

    /// Create a new audio streamer using any available channel
    ///
    /// # Arguments
    /// * `source` - Pointer to audio data (can be in fast RAM)
    /// * `source_size` - Total size of audio in bytes
    /// * `period` - Paula period for playback rate
    /// * `sample_rate` - Sample rate in Hz (for progress calculation)
    ///
    /// # Returns
    /// * `Ok(AudioStreamer)` - Ready to play
    /// * `Err(AudioError::NoAllocation)` - No channels available
    /// * `Err(AudioError::AllocationFailed)` - Could not allocate chip RAM
    pub fn new(source: *u8, source_size: u32, period: u16, sample_rate: u32) -> Result<AudioStreamer, AudioError> {
        return AudioStreamer::with_options(source, source_size, period, sample_rate, Option::None, DEFAULT_BUFFER_SIZE)
    }

    /// Create a mono streamer with custom buffer size
    ///
    /// # Arguments
    /// * `source` - Pointer to audio data (can be in fast RAM)
    /// * `source_size` - Total size of audio in bytes
    /// * `period` - Paula period for playback rate
    /// * `sample_rate` - Sample rate in Hz (for progress calculation)
    /// * `buffer_size` - Size of each buffer in bytes (4KB - 64KB, will be clamped)
    ///
    /// # Buffer Size Guidelines
    /// - Smaller buffers (4-8KB): Lower latency, more CPU overhead
    /// - Default (16KB): Good balance for most uses
    /// - Larger buffers (32-64KB): Less CPU overhead, higher latency, more chip RAM
    pub fn new_with_buffer(source: *u8, source_size: u32, period: u16, sample_rate: u32, buffer_size: u32) -> Result<AudioStreamer, AudioError> {
        return AudioStreamer::with_options(source, source_size, period, sample_rate, Option::None, buffer_size)
    }

    /// Create a stereo audio streamer (one left + one right channel)
    ///
    /// Plays the same audio data on both a left and right channel for
    /// stereo output. The OS will allocate any available stereo pair.
    /// Uses the default buffer size (16KB per buffer, 48KB total chip RAM).
    ///
    /// # Arguments
    /// * `source` - Pointer to audio data (can be in fast RAM)
    /// * `source_size` - Total size of audio in bytes
    /// * `period` - Paula period for playback rate
    /// * `sample_rate` - Sample rate in Hz (for progress calculation)
    ///
    /// # Returns
    /// * `Ok(AudioStreamer)` - Ready to play in stereo
    /// * `Err(AudioError::NoAllocation)` - No stereo pair available
    pub fn new_stereo(source: *u8, source_size: u32, period: u16, sample_rate: u32) -> Result<AudioStreamer, AudioError> {
        return AudioStreamer::with_stereo_options(source, source_size, period, sample_rate, DEFAULT_BUFFER_SIZE)
    }

    /// Create a stereo audio streamer with custom buffer size
    ///
    /// # Arguments
    /// * `source` - Pointer to audio data (can be in fast RAM)
    /// * `source_size` - Total size of audio in bytes
    /// * `period` - Paula period for playback rate
    /// * `sample_rate` - Sample rate in Hz (for progress calculation)
    /// * `buffer_size` - Size of each buffer in bytes (4KB - 64KB, will be clamped)
    ///
    /// # Buffer Size Guidelines
    /// - Smaller buffers (4-8KB): Lower latency, more CPU overhead
    /// - Default (16KB): Good balance for most uses
    /// - Larger buffers (32-64KB): Less CPU overhead, higher latency, more chip RAM
    ///
    /// # Memory Usage
    /// Total chip RAM = 3 × buffer_size (triple-buffering)
    /// Example: 32KB buffers = 96KB chip RAM
    pub fn new_stereo_with_buffer(source: *u8, source_size: u32, period: u16, sample_rate: u32, buffer_size: u32) -> Result<AudioStreamer, AudioError> {
        return AudioStreamer::with_stereo_options(source, source_size, period, sample_rate, buffer_size)
    }

    /// Create a streamer requesting a specific channel
    ///
    /// # Arguments
    /// * `channel` - Paula channel (0-3)
    /// * `source` - Pointer to audio data (can be in fast RAM)
    /// * `source_size` - Total size of audio in bytes
    /// * `period` - Paula period for playback rate
    /// * `sample_rate` - Sample rate in Hz (for progress calculation)
    ///
    /// # Returns
    /// * `Ok(AudioStreamer)` - Ready to play
    /// * `Err(AudioError::InvalidChannel)` - Channel > 3
    /// * `Err(AudioError::NoAllocation)` - Requested channel not available
    pub fn new_on_channel(channel: u8, source: *u8, source_size: u32, period: u16, sample_rate: u32) -> Result<AudioStreamer, AudioError> {
        if channel > 3 {
            return Result::Err(AudioError::InvalidChannel)
        }
        return AudioStreamer::with_options(source, source_size, period, sample_rate, Option::Some(channel), DEFAULT_BUFFER_SIZE)
    }

    /// Create a streamer with a specific channel mask
    ///
    /// This is the most flexible constructor - it accepts a ChannelMask allowing
    /// you to request any combination of channels. Use this when you need the
    /// same channel selection API as paula.novus MultiChannel.
    ///
    /// # Arguments
    /// * `mask` - ChannelMask specifying which channels to allocate
    /// * `source` - Pointer to audio data (can be in fast RAM)
    /// * `source_size` - Total size of audio in bytes
    /// * `period` - Paula period for playback rate
    /// * `sample_rate` - Sample rate in Hz (for progress calculation)
    ///
    /// # Returns
    /// * `Ok(AudioStreamer)` - Ready to play
    /// * `Err(AudioError::NoAllocation)` - Requested channels not available
    ///
    /// # Example
    /// ```novus
    /// // Request stereo playback (same as new_stereo)
    /// let streamer = AudioStreamer::new_with_channels(
    ///     ChannelMask::stereo(), data, size, period, rate
    /// )?
    ///
    /// // Request specific channels
    /// let custom = AudioStreamer::new_with_channels(
    ///     ChannelMask::channel(0).with(3), data, size, period, rate
    /// )?
    /// ```
    pub fn new_with_channels(mask: ChannelMask, source: *u8, source_size: u32, period: u16, sample_rate: u32) -> Result<AudioStreamer, AudioError> {
        return AudioStreamer::with_channels_options(mask, source, source_size, period, sample_rate, DEFAULT_BUFFER_SIZE)
    }

    /// Create a streamer with a specific channel mask and custom buffer size
    ///
    /// # Arguments
    /// * `mask` - ChannelMask specifying which channels to allocate
    /// * `source` - Pointer to audio data
    /// * `source_size` - Total size of audio
    /// * `period` - Paula period
    /// * `sample_rate` - Sample rate in Hz (for progress calculation)
    /// * `buffer_size` - Size per buffer (4KB - 64KB)
    pub fn with_channels_options(mask: ChannelMask, source: *u8, source_size: u32, period: u16, sample_rate: u32, buffer_size: u32) -> Result<AudioStreamer, AudioError> {
        if mask.is_empty() {
            return Result::Err(AudioError::InvalidChannel)
        }

        // For single-channel masks, delegate to the original with_options
        if mask.count() == 1 {
            match mask.first() {
                Option::Some(ch) => {
                    return AudioStreamer::with_options(source, source_size, period, sample_rate, Option::Some(ch), buffer_size)
                },
                Option::None => {
                    return Result::Err(AudioError::InvalidChannel)
                }
            }
        }

        // For stereo (or multi-channel), use the stereo allocation path
        if mask.is_stereo() {
            return AudioStreamer::with_stereo_options(source, source_size, period, sample_rate, buffer_size)
        }

        // For other multi-channel combinations, use generic allocation
        // For now, only stereo is fully supported
        return Result::Err(AudioError::InvalidChannel)
    }

    /// Create a streamer with custom buffer size
    ///
    /// Larger buffers = less CPU overhead, more chip RAM used.
    /// Smaller buffers = more responsive, less chip RAM used.
    ///
    /// # Arguments
    /// * `source` - Pointer to audio data
    /// * `source_size` - Total size of audio
    /// * `period` - Paula period
    /// * `sample_rate` - Sample rate in Hz (for progress calculation)
    /// * `channel` - Optional specific channel (None = any available)
    /// * `buffer_size` - Size per buffer (4KB - 64KB)
    pub fn with_options(source: *u8, source_size: u32, period: u16, sample_rate: u32, channel: Option<u8>, buffer_size: u32) -> Result<AudioStreamer, AudioError> {
        // Validate channel if specified
        match channel {
            Option::Some(ch) => {
                if ch > 3 {
                    return Result::Err(AudioError::InvalidChannel)
                }
            },
            Option::None => {}
        }

        // Clamp buffer size
        var actual_size = buffer_size
        if actual_size < MIN_BUFFER_SIZE {
            actual_size = MIN_BUFFER_SIZE
        }
        if actual_size > MAX_BUFFER_SIZE {
            actual_size = MAX_BUFFER_SIZE
        }

        // Ensure even size (Paula requires word alignment)
        if (actual_size & 1) != 0 {
            actual_size = actual_size - 1
        }

        // Create message port for I/O replies
        let port = CreateMsgPort()
        if (u32)port == 0 {
            return Result::Err(AudioError::NoMsgPort)
        }

        // Create first IORequest
        let req0 = CreateIORequest(port, @sizeof(IOAudio))
        if (u32)req0 == 0 {
            DeleteMsgPort(port)
            return Result::Err(AudioError::NoIORequest)
        }
        let io0 = (*IOAudio)req0

        // Create second IORequest
        let req1 = CreateIORequest(port, @sizeof(IOAudio))
        if (u32)req1 == 0 {
            DeleteIORequest(req0)
            DeleteMsgPort(port)
            return Result::Err(AudioError::NoIORequest)
        }
        let io1 = (*IOAudio)req1

        // Create third IORequest
        let req2 = CreateIORequest(port, @sizeof(IOAudio))
        if (u32)req2 == 0 {
            DeleteIORequest(req1)
            DeleteIORequest(req0)
            DeleteMsgPort(port)
            return Result::Err(AudioError::NoIORequest)
        }
        let io2 = (*IOAudio)req2

        // Set up channel allocation
        // If specific channel requested, use that bit; otherwise try all channels
        var channel_mask: u8 = $0F  // All channels (1, 2, 4, 8)
        match channel {
            Option::Some(ch) => {
                channel_mask = 1 << ch
            },
            Option::None => {}
        }
        var alloc_map: [u8; 4] = [1, 2, 4, 8]  // Try channels in order
        var alloc_len: u32 = 4
        match channel {
            Option::Some(ch) => {
                // Specific channel requested
                alloc_map[0] = 1 << ch
                alloc_len = 1
            },
            Option::None => {}
        }

        io0.ioa_Request.io_Message.mn_ReplyPort = port
        io0.ioa_Request.io_Message.mn_Node.ln_Pri = 0
        io0.ioa_Data = &alloc_map[0]
        io0.ioa_Length = alloc_len

        // Open device - this performs the allocation
        unsafe {
            let req_addr = &io0.ioa_Request
            let ioreq = (*IORequest)req_addr
            let error = OpenDevice("audio.device", 0, ioreq, 0)

            if error != 0 {
                DeleteIORequest(req2)
                DeleteIORequest(req1)
                DeleteIORequest(req0)
                DeleteMsgPort(port)

                if error == -10 {
                    return Result::Err(AudioError::NoAllocation)
                }
                if error == -11 {
                    return Result::Err(AudioError::AllocFailed)
                }
                return Result::Err(AudioError::DeviceOpenFailed)
            }
        }

        let alloc_key = io0.ioa_AllocKey

        // Extract the allocated channel from io_Unit
        // The unit is a bitmask, so we need to find which bit is set
        let unit_mask = (u8)(u32)io0.ioa_Request.io_Unit
        var allocated_channel: u8 = 0
        var channel_bit: u8 = 1
        if (unit_mask & 1) != 0 {
            allocated_channel = 0
            channel_bit = 1
        } else if (unit_mask & 2) != 0 {
            allocated_channel = 1
            channel_bit = 2
        } else if (unit_mask & 4) != 0 {
            allocated_channel = 2
            channel_bit = 4
        } else if (unit_mask & 8) != 0 {
            allocated_channel = 3
            channel_bit = 8
        }

        // Now set BOTH IORequests to use the SPECIFIC channel, not the full mask
        // This is critical - each IORequest must have io_Unit set to the specific channel bit
        let specific_unit = (*Unit)(u32)channel_bit

        io0.ioa_Request.io_Unit = specific_unit

        // Copy device info to second IORequest
        io1.ioa_Request.io_Device = io0.ioa_Request.io_Device
        io1.ioa_Request.io_Unit = specific_unit
        io1.ioa_Request.io_Message.mn_ReplyPort = port
        io1.ioa_AllocKey = alloc_key

        // Copy device info to third IORequest
        io2.ioa_Request.io_Device = io0.ioa_Request.io_Device
        io2.ioa_Request.io_Unit = specific_unit
        io2.ioa_Request.io_Message.mn_ReplyPort = port
        io2.ioa_AllocKey = alloc_key

        // Allocate chip RAM buffers using ChipPool for consistency
        unsafe {
            let buf0_opt = ChipPool::alloc(actual_size)
            let buf0: *u8 = match buf0_opt {
                Option::Some(ptr) => ptr,
                Option::None => {
                    // Close device and cleanup
                    io0.ioa_Request.io_Command = ADCMD_FREE
                    let cleanup_req_addr = &io0.ioa_Request
                    let cleanup_ioreq = (*IORequest)cleanup_req_addr
                    CloseDevice(cleanup_ioreq)
                    DeleteIORequest((*u8)io2)
                    DeleteIORequest((*u8)io1)
                    DeleteIORequest((*u8)io0)
                    DeleteMsgPort(port)
                    return Result::Err(AudioError::AllocationFailed)
                }
            }

            let buf1_opt = ChipPool::alloc(actual_size)
            let buf1: *u8 = match buf1_opt {
                Option::Some(ptr) => ptr,
                Option::None => {
                    let _ = ChipPool::free(buf0)
                    io0.ioa_Request.io_Command = ADCMD_FREE
                    let cleanup_req_addr2 = &io0.ioa_Request
                    let cleanup_ioreq2 = (*IORequest)cleanup_req_addr2
                    CloseDevice(cleanup_ioreq2)
                    DeleteIORequest((*u8)io2)
                    DeleteIORequest((*u8)io1)
                    DeleteIORequest((*u8)io0)
                    DeleteMsgPort(port)
                    return Result::Err(AudioError::AllocationFailed)
                }
            }

            let buf2_opt = ChipPool::alloc(actual_size)
            let buf2: *u8 = match buf2_opt {
                Option::Some(ptr) => ptr,
                Option::None => {
                    let _ = ChipPool::free(buf1)
                    let _ = ChipPool::free(buf0)
                    io0.ioa_Request.io_Command = ADCMD_FREE
                    let cleanup_req_addr3 = &io0.ioa_Request
                    let cleanup_ioreq3 = (*IORequest)cleanup_req_addr3
                    CloseDevice(cleanup_ioreq3)
                    DeleteIORequest((*u8)io2)
                    DeleteIORequest((*u8)io1)
                    DeleteIORequest((*u8)io0)
                    DeleteMsgPort(port)
                    return Result::Err(AudioError::AllocationFailed)
                }
            }

            // Detect PAL/NTSC for frame-based timing
            let is_pal = DISPLAY() == DisplayType::PAL

            return Result::Ok(AudioStreamer {
                io_audio_0: io0,
                io_audio_1: io1,
                io_audio_2: io2,
                io_audio_0_r: null,  // No right channel for mono
                io_audio_1_r: null,
                io_audio_2_r: null,
                port: port,
                alloc_key: alloc_key,
                channels: ChannelMask::channel(allocated_channel),
                left_channel_mask: channel_bit,  // The allocated channel
                right_channel_mask: 0,           // No right channel for mono
                period: period,
                volume: 64,
                buffer_0: buf0,
                buffer_1: buf1,
                buffer_2: buf2,
                buffer_size: actual_size,
                pending_count: 0,
                source_ptr: source,
                source_size: source_size,
                source_offset: 0,
                played_bytes: 0,
                sample_rate: sample_rate,
                frames_elapsed: 0,
                is_pal: is_pal,
                is_playing: false,
                loop_playback: false,
                reached_end: false,
                buf0_left_done: false,
                buf1_left_done: false,
                buf2_left_done: false,
                buf0_right_done: false,
                buf1_right_done: false,
                buf2_right_done: false,
            })
        }
    }

    /// Create a stereo streamer with custom buffer size
    ///
    /// # Arguments
    /// * `source` - Pointer to audio data
    /// * `source_size` - Total size of audio
    /// * `period` - Paula period
    /// * `sample_rate` - Sample rate in Hz (for progress calculation)
    /// * `buffer_size` - Size per buffer (4KB - 64KB)
    pub fn with_stereo_options(source: *u8, source_size: u32, period: u16, sample_rate: u32, buffer_size: u32) -> Result<AudioStreamer, AudioError> {
        // Step 1: Validate and clamp buffer size
        let actual_size = AudioStreamer::clamp_buffer_size(buffer_size)

        // Step 2: Create message port
        let port = match AudioStreamer::create_msg_port() {
            Result::Ok(p) => p,
            Result::Err(e) => return Result::Err(e)
        }

        // Step 3: Create 6 IORequests (3 for left, 3 for right)
        var io0_l: *IOAudio = null
        var io1_l: *IOAudio = null
        var io2_l: *IOAudio = null
        var io0_r: *IOAudio = null
        var io1_r: *IOAudio = null
        var io2_r: *IOAudio = null
        match AudioStreamer::create_stereo_io_requests(port, &io0_l, &io1_l, &io2_l, &io0_r, &io1_r, &io2_r) {
            Result::Ok(_) => {},
            Result::Err(e) => {
                DeleteMsgPort(port)
                return Result::Err(e)
            }
        }

        // Step 4: Allocate stereo channels via audio.device (using first left IORequest)
        match AudioStreamer::allocate_stereo_channels(io0_l, port) {
            Result::Ok(_) => {},
            Result::Err(e) => {
                unsafe {
                    DeleteIORequest((*u8)io2_r)
                    DeleteIORequest((*u8)io1_r)
                    DeleteIORequest((*u8)io0_r)
                    DeleteIORequest((*u8)io2_l)
                    DeleteIORequest((*u8)io1_l)
                    DeleteIORequest((*u8)io0_l)
                    DeleteMsgPort(port)
                }
                return Result::Err(e)
            }
        }

        // Step 5: Setup all 6 IORequests with individual channel assignments
        let alloc_key = io0_l.ioa_AllocKey
        // Returns packed: stereo_mask | (left_mask << 8) | (right_mask << 16)
        let packed_masks = AudioStreamer::setup_all_stereo_io_units(
            io0_l, io1_l, io2_l,
            io0_r, io1_r, io2_r,
            port, alloc_key
        )

        // Step 6: Allocate chip RAM buffers
        var buf0: *u8 = null
        var buf1: *u8 = null
        var buf2: *u8 = null
        match AudioStreamer::allocate_triple_buffers(actual_size, &buf0, &buf1, &buf2) {
            Result::Ok(_) => {},
            Result::Err(e) => {
                unsafe {
                    io0_l.ioa_Request.io_Command = ADCMD_FREE
                    let cleanup_req_addr = &io0_l.ioa_Request
                    let cleanup_ioreq = (*IORequest)cleanup_req_addr
                    CloseDevice(cleanup_ioreq)
                    DeleteIORequest((*u8)io2_r)
                    DeleteIORequest((*u8)io1_r)
                    DeleteIORequest((*u8)io0_r)
                    DeleteIORequest((*u8)io2_l)
                    DeleteIORequest((*u8)io1_l)
                    DeleteIORequest((*u8)io0_l)
                    DeleteMsgPort(port)
                }
                return Result::Err(e)
            }
        }

        // Step 7: Build the final AudioStreamer with all 6 IORequests
        return AudioStreamer::build_stereo_streamer(
            io0_l, io1_l, io2_l,
            io0_r, io1_r, io2_r,
            port, alloc_key, packed_masks,
            buf0, buf1, buf2, actual_size,
            source, source_size, period, sample_rate
        )
    }

    /// Start streaming playback
    ///
    /// # Arguments
    /// * `loop_playback` - If true, restart from beginning when done
    pub fn play(&mut self, loop_playback: bool) -> Result<(), AudioError> {
        self.loop_playback = loop_playback
        self.pending_count = 0
        self.reached_end = false
        self.source_offset = 0
        self.played_bytes = 0
        self.frames_elapsed = 0

        // Reset stereo completion tracking flags
        self.buf0_left_done = false
        self.buf1_left_done = false
        self.buf2_left_done = false
        self.buf0_right_done = false
        self.buf1_right_done = false
        self.buf2_right_done = false

        // Fill all three buffers
        self.fill_buffer(0)?
        self.fill_buffer(1)?
        self.fill_buffer(2)?

        // Flush cache for 68040/060
        CacheClearU()

        // Queue ALL THREE buffers for playback (triple-buffering)
        // audio.device will play them in order: buffer 0, 1, 2
        // When each completes, we refill it and re-queue it
        // This gives us a full buffer's worth of time to refill without gaps
        self.start_buffer_playback(0)?
        self.start_buffer_playback(1)?
        self.start_buffer_playback(2)?

        self.is_playing = true
        return Result::Ok(())
    }

    /// Tick the streamer - MUST be called regularly in your main loop
    ///
    /// This checks if a buffer finished and re-queues it with fresh data.
    /// Call this at least once per frame (every 20ms at 50Hz).
    pub fn tick(&mut self) -> Result<(), AudioError> {
        if !self.is_playing {
            return Result::Ok(())
        }

        let is_stereo = self.right_channel_mask != 0

        // Process ALL pending messages (there may be multiple)
        var msg = GetMsg(self.port)
        while (u32)msg != 0 {
            // A buffer just finished playing
            self.pending_count = self.pending_count - 1

            // Identify which buffer and which channel (left or right) finished
            var buf_idx: i8 = -1
            var is_left: bool = false

            // Check LEFT channel IORequests
            if (u32)msg == (u32)self.io_audio_0 {
                buf_idx = 0
                is_left = true
            } else if (u32)msg == (u32)self.io_audio_1 {
                buf_idx = 1
                is_left = true
            } else if (u32)msg == (u32)self.io_audio_2 {
                buf_idx = 2
                is_left = true
            } else if (u32)msg == (u32)self.io_audio_0_r {
                // Check RIGHT channel IORequests
                buf_idx = 0
                is_left = false
            } else if (u32)msg == (u32)self.io_audio_1_r {
                buf_idx = 1
                is_left = false
            } else if (u32)msg == (u32)self.io_audio_2_r {
                buf_idx = 2
                is_left = false
            }

            if buf_idx >= 0 {
                // Mark this channel as done for this buffer
                if is_left {
                    if buf_idx == 0 {
                        self.buf0_left_done = true
                    } else if buf_idx == 1 {
                        self.buf1_left_done = true
                    } else {
                        self.buf2_left_done = true
                    }
                } else {
                    if buf_idx == 0 {
                        self.buf0_right_done = true
                    } else if buf_idx == 1 {
                        self.buf1_right_done = true
                    } else {
                        self.buf2_right_done = true
                    }
                }

                // Check if this buffer is fully complete (both channels done, or mono)
                let idx = (u8)buf_idx
                var buffer_complete = false

                if is_stereo {
                    // For stereo, BOTH channels must be done
                    if idx == 0 {
                        buffer_complete = self.buf0_left_done && self.buf0_right_done
                    } else if idx == 1 {
                        buffer_complete = self.buf1_left_done && self.buf1_right_done
                    } else {
                        buffer_complete = self.buf2_left_done && self.buf2_right_done
                    }
                } else {
                    // For mono, left channel done = buffer complete
                    buffer_complete = is_left
                }

                if buffer_complete {
                    // Reset completion flags for this buffer
                    if idx == 0 {
                        self.buf0_left_done = false
                        self.buf0_right_done = false
                    } else if idx == 1 {
                        self.buf1_left_done = false
                        self.buf1_right_done = false
                    } else {
                        self.buf2_left_done = false
                        self.buf2_right_done = false
                    }

                    // Update played bytes (only once per buffer)
                    self.played_bytes = self.played_bytes + self.buffer_size
                    if self.played_bytes > self.source_size {
                        self.played_bytes = self.source_size
                    }

                    // Check if we've reached the end (no more pending buffers)
                    if self.reached_end && !self.loop_playback {
                        if self.pending_count == 0 {
                            self.stop()
                        }
                        // Don't refill, just let remaining buffers drain
                    } else {
                        // Refill the buffer that just finished
                        let fill_result = self.fill_buffer(idx)
                        match fill_result {
                            Result::Ok(_) => {
                                // Flush cache for 68040/060
                                CacheClearU()
                                // Re-queue this buffer for playback
                                self.start_buffer_playback(idx)?
                            },
                            Result::Err(_) => {
                                // Reached end of data
                                if !self.loop_playback {
                                    self.reached_end = true
                                    // Don't re-queue - let remaining buffers drain
                                } else {
                                    // Loop: reset offset and refill
                                    self.source_offset = 0
                                    self.fill_buffer(idx)?
                                    CacheClearU()
                                    self.start_buffer_playback(idx)?
                                }
                            }
                        }
                    }
                }
            }

            // Get next message (if any)
            msg = GetMsg(self.port)
        }

        // Increment frame counter (for time-based position calculation)
        self.frames_elapsed = self.frames_elapsed + 1

        return Result::Ok(())
    }

    /// Stop playback
    pub fn stop(&mut self) {
        if !self.is_playing {
            return
        }

        // Abort any pending I/O - but we need to be careful here
        // Just mark as not playing; the drop handler will clean up
        self.is_playing = false
        self.pending_count = 0
    }

    /// Check if still playing
    pub fn is_playing(&self) -> bool {
        return self.is_playing
    }

    /// Get the allocated channel mask
    ///
    /// Returns the ChannelMask of all allocated channels, allowing you to
    /// query which channels are being used for playback.
    pub fn channels(&self) -> ChannelMask {
        return self.channels
    }

    /// Get the first allocated channel number (0-3)
    ///
    /// This returns the first channel that was allocated, which may differ
    /// from the requested channel if `new()` was used (any available channel).
    /// For stereo playback, use `channel2()` to get the second channel.
    pub fn channel(&self) -> u8 {
        match self.channels.first() {
            Option::Some(ch) => return ch,
            Option::None => return 0
        }
    }

    /// Get the second allocated channel for stereo playback (0-3)
    ///
    /// Returns 0 for mono playback.
    /// For stereo, this returns the second channel of the stereo pair.
    pub fn channel2(&self) -> u8 {
        // Find the second channel in the mask
        let first = self.channel()
        var ch: u8 = 0
        while ch < 4 {
            if self.channels.has(ch) && ch != first {
                return ch
            }
            ch++
        }
        return 0  // No second channel (mono)
    }

    /// Check if this streamer is playing in stereo
    ///
    /// Returns true if we have allocated channels from both left and right sides.
    pub fn is_stereo(&self) -> bool {
        return self.channels.is_stereo()
    }

    /// Get the raw channel mask value (for debugging)
    pub fn channels_raw(&self) -> u8 {
        return self.channels.mask
    }

    /// Get the left channel mask (for debugging)
    pub fn left_mask(&self) -> u8 {
        return self.left_channel_mask
    }

    /// Get the right channel mask (for debugging)
    pub fn right_mask(&self) -> u8 {
        return self.right_channel_mask
    }

    /// Set volume (0-64)
    pub fn set_volume(&mut self, volume: u16) -> Result<(), AudioError> {
        if volume > 64 {
            return Result::Err(AudioError::InvalidVolume)
        }
        self.volume = volume
        return Result::Ok(())
    }

    /// Get playback progress (0-100) based on elapsed time
    ///
    /// This uses frame counting to estimate position smoothly,
    /// rather than jumping when buffers complete.
    /// Returns u32 to avoid VBCC narrowing cast bug.
    pub fn progress(&self) -> u32 {
        if self.source_size == 0 {
            return 100
        }
        let pos = self.position()
        let pos_scaled = pos * 100
        let pct = pos_scaled / self.source_size
        return pct
    }

    /// Get current position in bytes (estimated from elapsed time)
    ///
    /// Calculates position based on frame count and sample rate,
    /// providing smooth progress updates rather than buffer-granularity jumps.
    pub fn position(&self) -> u32 {
        // frames_elapsed * samples_per_frame = samples_played
        // PAL: 50 fps, samples_per_frame = sample_rate / 50
        // NTSC: 60 fps, samples_per_frame = sample_rate / 60
        //
        // position = frames_elapsed * sample_rate / fps
        // To avoid overflow and maintain precision:
        // position = (frames_elapsed * sample_rate) / fps
        let fps: u32 = if self.is_pal { 50 } else { 60 }
        let pos = (self.frames_elapsed * self.sample_rate) / fps

        // Clamp to source size
        if pos > self.source_size {
            return self.source_size
        }
        return pos
    }

    /// Get total size in bytes
    pub fn total_size(&self) -> u32 {
        return self.source_size
    }

    /// Get sample rate in Hz
    pub fn sample_rate(&self) -> u32 {
        return self.sample_rate
    }

    /// Get frames elapsed (for debugging)
    pub fn get_frames_elapsed(&self) -> u32 {
        return self.frames_elapsed
    }

    /// Get buffer address (for debugging)
    pub fn buffer_addr(&self, idx: u8) -> u32 {
        return (u32)self.get_buffer(idx)
    }

    /// Get a byte from a buffer (for debugging)
    pub fn buffer_byte(&self, idx: u8, offset: u32) -> u8 {
        unsafe {
            let buf = self.get_buffer(idx)
            return *(buf + offset)
        }
    }

    // ========================================================================
    // Private methods
    // ========================================================================

    /// Fill a buffer with data from the source
    fn fill_buffer(&mut self, idx: u8) -> Result<(), AudioError> {
        let buffer = self.get_buffer(idx)

        // Calculate how much data is left
        let remaining = self.source_size - self.source_offset

        if remaining == 0 {
            if self.loop_playback {
                // Loop back to start
                self.source_offset = 0
                return self.fill_buffer(idx)
            } else {
                // No more data
                return Result::Err(AudioError::SampleTooShort)
            }
        }

        // Copy up to buffer_size bytes
        var copy_size = self.buffer_size
        if copy_size > remaining {
            copy_size = remaining
        }

        // Ensure even size
        if (copy_size & 1) != 0 {
            copy_size = copy_size - 1
        }

        unsafe {
            let src = self.source_ptr + self.source_offset
            CopyMem(src, buffer, copy_size)
        }

        self.source_offset = self.source_offset + copy_size

        // If we copied less than buffer size, pad with silence
        if copy_size < self.buffer_size {
            unsafe {
                var i = copy_size
                while i < self.buffer_size {
                    let ptr = buffer + i
                    *ptr = 0
                    i++
                }
            }
        }

        return Result::Ok(())
    }

    /// Get buffer pointer by index
    fn get_buffer(&self, idx: u8) -> *u8 {
        if idx == 0 {
            return self.buffer_0
        } else if idx == 1 {
            return self.buffer_1
        }
        return self.buffer_2
    }

    /// Get IOAudio by index (left channel / mono)
    fn get_io(&self, idx: u8) -> *IOAudio {
        if idx == 0 {
            return self.io_audio_0
        } else if idx == 1 {
            return self.io_audio_1
        }
        return self.io_audio_2
    }

    /// Get right channel IOAudio by index (stereo only, null for mono)
    fn get_io_right(&self, idx: u8) -> *IOAudio {
        if idx == 0 {
            return self.io_audio_0_r
        } else if idx == 1 {
            return self.io_audio_1_r
        }
        return self.io_audio_2_r
    }

    /// Setup an IORequest for playback (helper to reduce duplication)
    fn setup_io_for_playback(&self, io: *IOAudio, buffer: *u8) {
        io.ioa_Request.io_Command = CMD_WRITE
        io.ioa_Request.io_Flags = ADIOF_PERVOL | ADIOF_NOWAIT
        io.ioa_Data = buffer
        io.ioa_Length = self.buffer_size  // Length in BYTES for audio.device
        io.ioa_Period = self.period
        io.ioa_Volume = self.volume
        io.ioa_Cycles = 1  // Play once, then signal completion
    }

    /// Start async playback of a buffer
    /// For stereo mode, sends CMD_WRITE to both left and right channels
    fn start_buffer_playback(&mut self, idx: u8) -> Result<(), AudioError> {
        let buffer = self.get_buffer(idx)
        let io_left = self.get_io(idx)

        // Setup left channel IORequest
        self.setup_io_for_playback(io_left, buffer)

        // Flush cache before DMA - critical for 68040/060!
        CacheClearU()

        // Check if this is stereo playback
        let io_right = self.get_io_right(idx)
        if (u32)io_right != 0 {
            // STEREO: Send to both channels
            // Setup right channel IORequest (same buffer - mono audio to both)
            self.setup_io_for_playback(io_right, buffer)

            // Send both using BeginIO (async)
            // They'll play the same data through left and right speakers
            let req_addr_l = &io_left.ioa_Request
            let req_addr_r = &io_right.ioa_Request
            let ioreq_l = (*IORequest)req_addr_l
            let ioreq_r = (*IORequest)req_addr_r

            BeginIO(ioreq_l)
            BeginIO(ioreq_r)

            // Track both pending requests
            self.pending_count = self.pending_count + 2
        } else {
            // MONO: Send to single channel only
            let req_addr = &io_left.ioa_Request
            let ioreq = (*IORequest)req_addr
            BeginIO(ioreq)
            self.pending_count = self.pending_count + 1
        }

        return Result::Ok(())
    }
}

impl Drop for AudioStreamer {
    fn drop(&mut self) {
        // Stop playback first
        self.is_playing = false

        unsafe {
            // Wait for any pending I/O to complete
            // With stereo triple-buffering, we may have up to 6 pending requests
            while self.pending_count > 0 {
                let _ = GetMsg(self.port)
                self.pending_count = self.pending_count - 1
            }

            // Free chip RAM buffers (via ChipPool)
            if self.buffer_0 {
                let _ = ChipPool::free(self.buffer_0)
            }
            if self.buffer_1 {
                let _ = ChipPool::free(self.buffer_1)
            }
            if self.buffer_2 {
                let _ = ChipPool::free(self.buffer_2)
            }

            // Free channel and close device
            if self.io_audio_0 {
                self.io_audio_0.ioa_Request.io_Command = ADCMD_FREE
                let req_addr = &self.io_audio_0.ioa_Request
                let ioreq = (*IORequest)req_addr
                CloseDevice(ioreq)

                DeleteIORequest((*u8)self.io_audio_0)
            }

            if self.io_audio_1 {
                DeleteIORequest((*u8)self.io_audio_1)
            }

            if self.io_audio_2 {
                DeleteIORequest((*u8)self.io_audio_2)
            }

            // Free right channel IORequests (stereo only)
            if self.io_audio_0_r {
                DeleteIORequest((*u8)self.io_audio_0_r)
            }

            if self.io_audio_1_r {
                DeleteIORequest((*u8)self.io_audio_1_r)
            }

            if self.io_audio_2_r {
                DeleteIORequest((*u8)self.io_audio_2_r)
            }

            if self.port {
                DeleteMsgPort(self.port)
            }
        }
    }
}
