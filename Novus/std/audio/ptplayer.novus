// ptplayer - ProTracker MOD Player Wrapper
// Module: std::audio::ptplayer
//
// High-level wrapper around ptplayer by Frank Wille.
// ptplayer is a popular, battle-tested MOD player for the Amiga.
//
// This module requires linking with the ptplayer.o object file.
// The MOD data must be in chip RAM for DMA playback.
//
// # Quick Start
// ```novus
// from std::audio::ptplayer import ModPlayer
//
// // Load a MOD file (must be in chip RAM)
// @mod("music.mod")
// static music_data = []
//
// // Initialize and play
// var player = ModPlayer::new(true)?  // true = PAL, false = NTSC
// player.init(&music_data, 0)?            // Start at position 0
// player.play()
//
// // ... game loop ...
//
// // Stop and cleanup (automatic on drop)
// ```
//
// # Sound Effects
// ptplayer supports playing sound effects alongside the music.
// You can specify which channels are dedicated to music vs SFX.
//
// ```novus
// // Reserve channels 2 and 3 for music only
// player.set_music_mask($0C)?  // bits 2,3 = channels 2,3
//
// // Play a sound effect
// let sfx = SfxStructure::new(&sample_data, sample_len, period, volume, 0, 1)
// player.play_sfx(&sfx)?
// ```

from std::core import Option, Result, Drop
from std::strings::core import Str
from std::ffi::amiga_consts import DMAF_SETCLR, DMAF_MASTER, DMAF_AUD0, DMAF_AUD1, DMAF_AUD2, DMAF_AUD3
from std::ffi::exec import FreeMem
from std::hardware::registers import CUSTOM_BASE
from std::audio::errors import AudioError
from std::memory::chip import ChipAsset, Priority, is_chip_ram, ChipCacheError
from std::memory::chip_cache import ChipCache

// ============================================================================
// Sound Effect Structure
// ============================================================================

/// Structure for playing sound effects through ptplayer
///
/// This matches the SfxStructure expected by _mt_playfx:
/// - sfx_ptr: Pointer to sample data (in chip RAM)
/// - sfx_len: Sample length in words
/// - sfx_per: Sample period (playback speed)
/// - sfx_vol: Sample volume (0-64)
/// - sfx_cha: Preferred channel (0-3, or -1 for any)
/// - sfx_pri: Priority (higher wins when channels conflict)
#[packed]
pub struct SfxStructure {
    sfx_ptr: *u8,    // Pointer to sample in chip RAM
    sfx_len: u16,    // Length in words
    sfx_per: u16,    // Period (124-65535)
    sfx_vol: u16,    // Volume (0-64)
    sfx_cha: i8,     // Channel (-1 = any, 0-3 = specific)
    sfx_pri: i8,     // Priority (higher = more important)
}

impl SfxStructure {
    /// Create a new sound effect structure
    ///
    /// # Arguments
    /// * `data` - Pointer to sample data (must be in chip RAM, < $200000)
    /// * `length_words` - Sample length in words
    /// * `period` - Playback period (124-65535)
    /// * `volume` - Volume (0-64)
    /// * `channel` - Preferred channel (-1 = any available, 0-3 = specific)
    /// * `priority` - Priority level for channel allocation (higher wins)
    ///
    /// # Returns
    /// * `Ok(SfxStructure)` - Valid sound effect structure
    /// * `Err(AudioError::NullSampleData)` - data is null
    /// * `Err(AudioError::SampleNotChipRam)` - data not in chip RAM
    /// * `Err(AudioError::InvalidPeriod)` - period < 124
    /// * `Err(AudioError::InvalidVolume)` - volume > 64
    pub fn new(data: *u8, length_words: u16, period: u16, volume: u16, channel: i8, priority: i8) -> Result<SfxStructure, AudioError> {
        // Validate sample pointer
        if !data {
            return Result::Err(AudioError::NullSampleData)
        }

        // Verify pointer is in chip RAM range (first 2MB)
        let addr = (u32)data
        if addr >= $00200000 {
            return Result::Err(AudioError::SampleNotChipRam)
        }

        // Validate period (Paula minimum is 124 to avoid DMA conflicts)
        if period < 124 {
            return Result::Err(AudioError::InvalidPeriod)
        }

        // Validate volume (Paula max is 64)
        if volume > 64 {
            return Result::Err(AudioError::InvalidVolume)
        }

        return Result::Ok(SfxStructure {
            sfx_ptr: data,
            sfx_len: length_words,
            sfx_per: period,
            sfx_vol: volume,
            sfx_cha: channel,
            sfx_pri: priority,
        })
    }

    /// Create from an AudioSample
    ///
    /// Convenience method to create an SfxStructure from a compiled audio sample.
    /// Uses PAL period by default.
    ///
    /// # Note
    /// This function does minimal validation since AudioSample is assumed to
    /// be generated correctly by the @audio compiler attribute.
    pub fn from_sample(sample: &AudioSample, channel: i8, priority: i8) -> Result<SfxStructure, AudioError> {
        // AudioSample should already be validated, but check the pointer
        if !sample.data {
            return Result::Err(AudioError::NullSampleData)
        }

        return Result::Ok(SfxStructure {
            sfx_ptr: sample.data,
            sfx_len: sample.length_words,
            sfx_per: sample.period_pal,
            sfx_vol: 64,
            sfx_cha: channel,
            sfx_pri: priority,
        })
    }

    /// Create from an AudioSample with explicit PAL/NTSC selection
    ///
    /// Like from_sample(), but allows choosing the period for PAL or NTSC.
    pub fn from_sample_native(sample: &AudioSample, channel: i8, priority: i8, pal: bool) -> Result<SfxStructure, AudioError> {
        if !sample.data {
            return Result::Err(AudioError::NullSampleData)
        }

        let period = if pal { sample.period_pal } else { sample.period_ntsc }

        return Result::Ok(SfxStructure {
            sfx_ptr: sample.data,
            sfx_len: sample.length_words,
            sfx_per: period,
            sfx_vol: 64,
            sfx_cha: channel,
            sfx_pri: priority,
        })
    }
}

// ============================================================================
// Audio Sample (matches @audio generated struct)
// ============================================================================

/// Audio sample metadata (generated by @audio attribute)
///
/// This struct matches the layout of samples generated by the @audio
/// compile-time attribute.
pub struct AudioSample {
    data: *u8,           // Pointer to sample data (in chip RAM)
    length_bytes: u32,   // Length in bytes
    length_words: u16,   // Length in words
    sample_rate: u32,    // Original sample rate
    period_pal: u16,     // Period for PAL systems
    period_ntsc: u16,    // Period for NTSC systems
}

impl ChipAsset for AudioSample {
    fn asset_id(&self) -> u32 {
        return (u32)self.data
    }

    fn data_ptr(&self) -> *u8 {
        return self.data
    }

    fn data_size(&self) -> u32 {
        return self.length_bytes
    }

    fn cache_priority(&self) -> Priority {
        // Audio samples are usually smaller and used frequently
        return Priority::High
    }
}

// ============================================================================
// MOD Asset (for chip RAM management)
// ============================================================================

/// Wrapper for MOD file data that supports automatic chip RAM management
///
/// Use this struct with the @mod attribute when you want to store
/// MOD files in fast RAM and have them automatically copied to chip
/// RAM when needed:
///
/// ```novus
/// // Store in fast RAM, copy to chip when playing
/// @mod("music.mod", chip = false)
/// static music: ModAsset = []
///
/// // Initialize chip cache at startup
/// ChipCache::init(512 * 1024)?
///
/// // ModPlayer::init() automatically handles chip RAM
/// player.init(&music, 0)?
/// ```
///
/// Or store directly in chip RAM (traditional approach):
/// ```novus
/// @mod("music.mod")  // chip = true is default
/// static music: [u8] = []
/// ```
pub struct ModAsset {
    /// Pointer to the MOD data
    data: *u8,
    /// Size of the MOD data in bytes
    size: u32,
}

impl ModAsset {
    /// Create a ModAsset from a raw pointer and size
    ///
    /// This is typically used to wrap @mod data stored in fast RAM
    /// when chip = false attribute is used.
    ///
    /// # Example
    /// ```novus
    /// @mod("music.mod", chip = false)
    /// static music_data: [u8] = []
    ///
    /// // Create ModAsset wrapper
    /// let asset = ModAsset::new(&music_data[0], @sizeof(music_data))
    /// ```
    pub fn new(data: *u8, size: u32) -> ModAsset {
        return ModAsset {
            data: data,
            size: size,
        }
    }

    /// Get a chip RAM pointer for this asset
    ///
    /// If already in chip RAM, returns the data pointer directly.
    /// Otherwise, uses the ChipCache to get a chip RAM copy.
    ///
    /// NOTE: This method does NOT pin the asset. For DMA-safe playback,
    /// use ModPlayer::init_asset() instead, which handles pinning.
    pub fn as_chip_ptr(&self) -> Result<*u8, ChipCacheError> {
        if is_chip_ram(self.data) {
            return Result::Ok(self.data)
        }
        // Use pointer as asset ID (unique per asset)
        let asset_id = (u32)self.data
        return ChipCache::get(asset_id, self.data, self.size, Priority::Normal, "MOD")
    }
}

impl ChipAsset for ModAsset {
    fn asset_id(&self) -> u32 {
        return (u32)self.data
    }

    fn data_ptr(&self) -> *u8 {
        return self.data
    }

    fn data_size(&self) -> u32 {
        return self.size
    }

    fn cache_priority(&self) -> Priority {
        // MOD files are typically large and stay loaded during playback
        return Priority::Normal
    }
}

// ============================================================================
// Audio Asset (for chip RAM management of WAV/sample data)
// ============================================================================

/// Wrapper for audio sample data that supports automatic chip RAM management
///
/// Use this struct with the @audio attribute when you want to store
/// audio samples in fast RAM and have them automatically copied to chip
/// RAM when needed for playback:
///
/// ```novus
/// // Store in fast RAM, copy to chip when playing
/// @audio("sound.wav", chip = false)
/// static explosion: AudioAsset = []
///
/// // Play using AudioChannel with automatic chip RAM management
/// var channel = AudioChannel::acquire(0)?
/// channel.play_asset(&explosion, PlaybackMode::OneShot)?
/// ```
///
/// Or store directly in chip RAM (traditional approach, default):
/// ```novus
/// @audio("sound.wav")  // chip = true is default
/// static explosion: AudioSample = []
/// ```
///
/// AudioAsset includes sample rate and period metadata for correct playback
/// at the original sample rate on both PAL and NTSC systems.
pub struct AudioAsset {
    /// Pointer to the audio data (in fast or chip RAM)
    data: *u8,
    /// Size of the audio data in bytes
    size: u32,
    /// Original sample rate in Hz
    sample_rate: u32,
    /// Pre-calculated period for PAL systems
    period_pal: u16,
    /// Pre-calculated period for NTSC systems
    period_ntsc: u16,
}

impl AudioAsset {
    /// Create an AudioAsset from raw data and metadata
    ///
    /// This is typically used to wrap @audio data stored in fast RAM
    /// when chip = false attribute is used.
    pub fn new(data: *u8, size: u32, sample_rate: u32, period_pal: u16, period_ntsc: u16) -> AudioAsset {
        return AudioAsset {
            data: data,
            size: size,
            sample_rate: sample_rate,
            period_pal: period_pal,
            period_ntsc: period_ntsc,
        }
    }

    /// Get a chip RAM pointer for this asset
    ///
    /// If already in chip RAM, returns the data pointer directly.
    /// Otherwise, uses the global ChipCache to allocate and copy.
    ///
    /// Note: Uses pointer value as asset ID for cache tracking.
    /// The cache manages memory lifetime.
    pub fn as_chip_ptr(&self) -> Result<*u8, ChipCacheError> {
        if is_chip_ram(self.data) {
            return Result::Ok(self.data)
        }
        // Use pointer value as asset ID for standalone cache lookups
        let asset_id = (u32)self.data
        return ChipCache::get(asset_id, self.data, self.size, Priority::High, "SFX")
    }

    /// Get the sample rate
    pub fn sample_rate(&self) -> u32 {
        return self.sample_rate
    }

    /// Get the PAL period for native playback rate
    pub fn period_pal(&self) -> u16 {
        return self.period_pal
    }

    /// Get the NTSC period for native playback rate
    pub fn period_ntsc(&self) -> u16 {
        return self.period_ntsc
    }

    /// Get the size in bytes
    pub fn size(&self) -> u32 {
        return self.size
    }

    /// Get the length in words (for Paula register)
    pub fn length_words(&self) -> u16 {
        return (u16)((self.size + 1) / 2)
    }

    /// Get the raw data pointer (may be in fast RAM)
    pub fn data_ptr(&self) -> *u8 {
        return self.data
    }
}

impl ChipAsset for AudioAsset {
    fn asset_id(&self) -> u32 {
        return (u32)self.data
    }

    fn data_ptr(&self) -> *u8 {
        return self.data
    }

    fn data_size(&self) -> u32 {
        return self.size
    }

    fn cache_priority(&self) -> Priority {
        // Audio samples are typically small and frequently used
        return Priority::High
    }
}

// ============================================================================
// External ptplayer Functions (C wrappers from ptplayer_helpers.c)
// ============================================================================

// These are C-callable wrapper functions that forward to ptplayer's
// register-based assembly functions. The wrappers handle moving
// parameters from the C stack to the correct registers (a6, a0, a1, d0).

/// Install CIA-B interrupt for music playback
extern fn __novus_mt_install_cia(custom: *u8, vector_base: *u8, pal_flag: u8)

/// Remove CIA-B interrupt
extern fn __novus_mt_remove_cia(custom: *u8)

/// Initialize a module for playback
extern fn __novus_mt_init(custom: *u8, module: *u8, samples: *u8, song_pos: u8)

/// Stop all playback
extern fn __novus_mt_end(custom: *u8)

/// Manual music tick (called by CIA interrupt normally)
extern fn __novus_mt_music(custom: *u8)

/// Play a sound effect
/// Returns: channel status pointer or NULL
extern fn __novus_mt_playfx(custom: *u8, sfx: *SfxStructure) -> *u8

/// Play a looped sound effect
extern fn __novus_mt_loopfx(custom: *u8, sfx: *SfxStructure)

/// Stop a sound effect
extern fn __novus_mt_stopfx(custom: *u8, channel: u8)

/// Set music channel mask
extern fn __novus_mt_musicmask(custom: *u8, mask: u8)

/// Set master volume
extern fn __novus_mt_mastervol(custom: *u8, volume: u16)

/// Set sample volume
extern fn __novus_mt_samplevol(sample_num: u16, volume: u8)

// Helper functions to access ptplayer variables
// These are linked from ptplayer_helpers.c
extern fn __novus_ptplayer_set_enable(value: u8)
extern fn __novus_ptplayer_get_enable() -> u8
extern fn __novus_ptplayer_get_e8_trigger() -> u8
extern fn __novus_ptplayer_get_music_channels() -> u8
extern fn __novus_ptplayer_get_song_end() -> u8
extern fn __novus_ptplayer_set_song_end(value: u8)
extern fn __novus_ptplayer_get_vumeter() -> u8
extern fn __novus_ptplayer_peek_vumeter() -> u8
extern fn __novus_ptplayer_get_song_pos() -> u8
extern fn __novus_ptplayer_get_song_length() -> u8

// Helper to call a function pointer stored as u32 address
extern fn __novus_call_u8_callback(func_addr: u32, arg: u8)

// Get the CPU's Vector Base Register (VBR)
// On 68000 this returns 0, on 68010+ it returns the actual VBR value.
// ptplayer needs this for proper interrupt vector handling.
extern fn __novus_get_vbr() -> *u8

fn set_mt_enable(value: u8) {
    __novus_ptplayer_set_enable(value)
}

fn get_mt_enable() -> u8 {
    return __novus_ptplayer_get_enable()
}

fn get_mt_e8_trigger() -> u8 {
    return __novus_ptplayer_get_e8_trigger()
}

fn get_mt_music_channels() -> u8 {
    return __novus_ptplayer_get_music_channels()
}

fn get_mt_song_end() -> u8 {
    return __novus_ptplayer_get_song_end()
}

fn set_mt_song_end(value: u8) {
    __novus_ptplayer_set_song_end(value)
}

fn get_mt_vumeter() -> u8 {
    return __novus_ptplayer_get_vumeter()
}

fn peek_mt_vumeter() -> u8 {
    return __novus_ptplayer_peek_vumeter()
}

// ============================================================================
// MOD Player Handle
// ============================================================================

/// Callback configuration for MOD playback
///
/// Use this struct to configure callbacks when starting playback.
/// Pass function pointers cast to u32, or 0 to disable a callback.
///
/// # Example
/// ```novus
/// fn on_e8(value: u8) { /* handle sync */ }
/// fn on_end(status: u8) { /* handle song end */ }
///
/// let config = PlayConfig {
///     on_e8_trigger: (u32)on_e8,
///     on_song_end: (u32)on_end,
/// }
/// player.play_with_config(&config)
/// ```
pub struct PlayConfig {
    /// Called when E8x sync command triggers (value 0-15)
    on_e8_trigger: u32,
    /// Called when song ends or loops (bit 7 = finished, bits 0-6 = loop count)
    on_song_end: u32,
}

impl PlayConfig {
    /// Create a config with no callbacks
    pub fn none() -> PlayConfig {
        return PlayConfig {
            on_e8_trigger: 0,
            on_song_end: 0,
        }
    }
}

/// RAII wrapper for ptplayer
///
/// Manages the complete lifecycle of MOD playback:
/// - Installs CIA interrupt on creation
/// - Provides methods for playback control
/// - Removes CIA interrupt on drop
///
/// # Safety
///
/// This module directly accesses Paula hardware. Only one ModPlayer
/// instance should exist at a time. Using ModPlayer alongside
/// std::audio::paula or std::audio::device will cause conflicts.
///
/// # Example
/// ```novus
/// // Create player for PAL system
/// var player = ModPlayer::new(true)?
///
/// // Load and play a module
/// player.init(&mod_data, 0)?
/// player.play()
///
/// // Adjust volume
/// player.set_master_volume(48)?
///
/// // Play a sound effect on channel 0
/// let sfx = SfxStructure::new(&sfx_data, 512, 322, 64, 0, 10)
/// player.play_sfx(&sfx)?
///
/// // Player automatically cleaned up on drop
/// ```

pub struct ModPlayer {
    is_playing: bool,
    cia_installed: bool,
    pal_mode: bool,
    // ChipCache asset ID for the currently loaded MOD (0 if none)
    cache_asset_id: u32,
    // Callback state tracking
    last_e8_value: u8,
    last_song_end: u8,
    // Optional callbacks (null = disabled)
    // Stored as u32 addresses - use __novus_call_u8_callback helper to invoke
    // - on_e8_trigger: called when E8x command is triggered (value 0-15)
    // - on_vumeter: called when channels have new notes (bitmask bits 0-3)
    // - on_song_end: called when song ends/loops (bit 7 = finished, bits 0-6 = loop count)
    on_e8_trigger: u32,
    on_vumeter: u32,
    on_song_end: u32,
}

// Global counter for generating unique asset IDs
static mut g_next_asset_id: u32 = 1

/// Generate a unique asset ID for ChipCache
fn next_asset_id() -> u32 {
    unsafe {
        let id = g_next_asset_id
        g_next_asset_id++
        return id
    }
}

impl ModPlayer {
    /// Create a new MOD player
    ///
    /// Installs the CIA-B interrupt handler for music timing.
    ///
    /// # Arguments
    /// * `pal` - True for PAL timing (50Hz), false for NTSC (60Hz)
    ///
    /// # Returns
    /// * `Ok(ModPlayer)` - Player ready for use
    /// * `Err(AudioError::CiaInstallFailed)` - Failed to install interrupt
    pub fn new(pal: bool) -> Result<ModPlayer, AudioError> {
        let custom = (*u8)CUSTOM_BASE
        let pal_flag: u8 = if pal { 1 } else { 0 }

        // Get the CPU's Vector Base Register
        // On 68000 this is 0, on 68010+ it may be relocated
        let vbr = __novus_get_vbr()

        unsafe {
            // Install CIA interrupt with proper vector base
            __novus_mt_install_cia(custom, vbr, pal_flag)
        }

        return Result::Ok(ModPlayer {
            is_playing: false,
            cia_installed: true,
            pal_mode: pal,
            cache_asset_id: 0,
            last_e8_value: 0,
            last_song_end: 0,
            on_e8_trigger: 0,
            on_vumeter: 0,
            on_song_end: 0,
        })
    }

    /// Initialize a module for playback from raw pointer
    ///
    /// Loads a ProTracker module and prepares it for playback.
    /// Does not start playback - call play() after init().
    ///
    /// # Arguments
    /// * `module_data` - Pointer to MOD file data (must be in chip RAM)
    /// * `start_position` - Song position to start from (usually 0)
    ///
    /// # Returns
    /// * `Ok(())` - Module initialized
    /// * `Err(AudioError::InvalidModuleData)` - Module data is invalid
    ///
    /// # Note
    /// For automatic chip RAM management, use `init_asset()` instead.
    pub fn init(&mut self, module_data: *u8, start_position: u8) -> Result<(), AudioError> {
        if (u32)module_data == 0 {
            return Result::Err(AudioError::InvalidModuleData)
        }

        let custom = (*u8)CUSTOM_BASE

        unsafe {
            // Initialize with NULL samples pointer (samples are in the MOD file)
            __novus_mt_init(custom, module_data, (*u8)0, start_position)
        }

        return Result::Ok(())
    }

    /// Initialize a module for playback from ModAsset
    ///
    /// Automatically handles chip RAM management. If the asset is in
    /// fast RAM, it will be cached to chip RAM using the global ChipCache.
    /// The asset is automatically pinned during playback to prevent eviction.
    ///
    /// # Arguments
    /// * `asset` - ModAsset containing the MOD file data
    /// * `start_position` - Song position to start from (usually 0)
    ///
    /// # Returns
    /// * `Ok(())` - Module initialized
    /// * `Err(AudioError::InvalidModuleData)` - Module data is invalid
    /// * `Err(AudioError::ChipCacheError)` - Failed to copy to chip RAM
    ///
    /// # Example
    /// ```novus
    /// @mod("music.mod", chip = false)
    /// static music: ModAsset = []
    ///
    /// player.init_asset(&music, 0)?
    /// player.play()  // Asset is pinned during playback
    /// ```
    pub fn init_asset(&mut self, asset: &ModAsset, start_position: u8) -> Result<(), AudioError> {
        // Unpin and release any previously cached asset
        if self.cache_asset_id != 0 {
            ChipCache::unpin(self.cache_asset_id)
            ChipCache::evict(self.cache_asset_id)
            self.cache_asset_id = 0
        }

        // Check if data is already in chip RAM
        let data_ptr = asset.data
        let data_size = asset.size

        if is_chip_ram(data_ptr) {
            // Already in chip RAM, use directly (no caching needed)
            return self.init(data_ptr, start_position)
        }

        // Generate a new asset ID and cache to chip RAM
        let asset_id = next_asset_id()
        let result = ChipCache::get(asset_id, data_ptr, data_size, Priority::Normal, "MOD")
        match result {
            Result::Ok(chip_ptr) => {
                // Track asset ID for cleanup and pin it during playback
                self.cache_asset_id = asset_id
                ChipCache::pin(asset_id)
                return self.init(chip_ptr, start_position)
            },
            Result::Err(_) => {
                return Result::Err(AudioError::ChipCacheError)
            }
        }
    }

    /// Start music playback
    ///
    /// Enables the CIA interrupt to call the replayer.
    pub fn play(&mut self) {
        set_mt_enable(1)
        self.is_playing = true
    }

    /// Start music playback with callbacks
    ///
    /// A cleaner alternative to setting callbacks separately.
    /// Callbacks are invoked when you call `tick()` in your main loop.
    ///
    /// # Example
    /// ```novus
    /// fn on_sync(value: u8) { flash_screen() }
    /// fn on_end(status: u8) { song_finished = true }
    ///
    /// player.play_with_config(&PlayConfig {
    ///     on_e8_trigger: (u32)on_sync,
    ///     on_song_end: (u32)on_end,
    /// })
    ///
    /// while !song_finished {
    ///     WaitTOF()
    ///     player.tick()  // Fires callbacks if events occurred
    /// }
    /// ```
    pub fn play_with_config(&mut self, config: &PlayConfig) {
        self.on_e8_trigger = config.on_e8_trigger
        self.on_song_end = config.on_song_end
        self.reset_callback_state()
        set_mt_enable(1)
        self.is_playing = true
    }

    /// Check for events and fire callbacks
    ///
    /// Call this once per frame in your main loop. It checks ptplayer's
    /// internal state and fires any registered callbacks when values change.
    ///
    /// This is the idiomatic way to handle music events on Amiga - polling
    /// from your main loop rather than interrupt-driven callbacks.
    ///
    /// # Example
    /// ```novus
    /// while game_running {
    ///     WaitTOF()
    ///     player.tick()  // Check for music events
    ///     update_game()
    ///     render_frame()
    /// }
    /// ```
    pub fn tick(&mut self) {
        // Check E8 trigger
        if self.on_e8_trigger != 0 {
            let current_e8 = get_mt_e8_trigger()
            if current_e8 != self.last_e8_value {
                self.last_e8_value = current_e8
                __novus_call_u8_callback(self.on_e8_trigger, current_e8)
            }
        }

        // Check song end
        if self.on_song_end != 0 {
            let current_song_end = get_mt_song_end()
            if current_song_end != self.last_song_end {
                self.last_song_end = current_song_end
                __novus_call_u8_callback(self.on_song_end, current_song_end)
            }
        }
    }

    /// Pause music playback
    ///
    /// Disables the CIA interrupt. Music resumes from current position
    /// when play() is called again.
    pub fn pause(&mut self) {
        set_mt_enable(0)
        self.is_playing = false
    }

    /// Stop music playback completely
    ///
    /// Stops all sound output and resets the player state.
    pub fn stop(&mut self) {
        let custom = (*u8)CUSTOM_BASE

        unsafe {
            __novus_mt_end(custom)
        }
        self.is_playing = false
    }

    /// Check if music is currently playing
    pub fn is_playing(&self) -> bool {
        return self.is_playing
    }

    /// Set master volume for all music channels
    ///
    /// # Arguments
    /// * `volume` - Master volume (0-64)
    pub fn set_master_volume(&self, volume: u16) -> Result<(), AudioError> {
        if volume > 64 {
            return Result::Err(AudioError::InvalidVolume)
        }

        let custom = (*u8)CUSTOM_BASE

        unsafe {
            __novus_mt_mastervol(custom, volume)
        }

        return Result::Ok(())
    }

    /// Set which channels are reserved for music only
    ///
    /// Channels not in the mask can be used for sound effects.
    /// Bit 0 = channel 0, bit 1 = channel 1, etc.
    ///
    /// # Arguments
    /// * `mask` - Channel bitmask (0-15)
    ///
    /// # Example
    /// ```novus
    /// // Reserve channels 2 and 3 for music, allow SFX on 0 and 1
    /// player.set_music_mask($0C)?
    /// ```
    pub fn set_music_mask(&self, mask: u8) -> Result<(), AudioError> {
        if mask > 15 {
            return Result::Err(AudioError::InvalidChannelMask)
        }

        let custom = (*u8)CUSTOM_BASE

        unsafe {
            __novus_mt_musicmask(custom, mask)
        }

        return Result::Ok(())
    }

    /// Play a sound effect
    ///
    /// Plays a one-shot sound effect. If all channels are busy,
    /// the effect with lowest priority is replaced.
    ///
    /// # Arguments
    /// * `sfx` - Sound effect structure
    ///
    /// # Returns
    /// Pointer to channel status, or null if no channel available
    pub fn play_sfx(&self, sfx: &SfxStructure) -> *u8 {
        let custom = (*u8)CUSTOM_BASE

        unsafe {
            return __novus_mt_playfx(custom, sfx)
        }
    }

    /// Play a looped sound effect
    ///
    /// The sound effect will loop until explicitly stopped.
    ///
    /// # Arguments
    /// * `sfx` - Sound effect structure (channel field determines which channel)
    pub fn play_looped_sfx(&self, sfx: &SfxStructure) {
        let custom = (*u8)CUSTOM_BASE

        unsafe {
            __novus_mt_loopfx(custom, sfx)
        }
    }

    /// Stop a sound effect on a specific channel
    ///
    /// # Arguments
    /// * `channel` - Channel number (0-3)
    pub fn stop_sfx(&self, channel: u8) -> Result<(), AudioError> {
        if channel > 3 {
            return Result::Err(AudioError::InvalidChannelMask)
        }

        let custom = (*u8)CUSTOM_BASE

        unsafe {
            __novus_mt_stopfx(custom, channel)
        }

        return Result::Ok(())
    }

    /// Set volume for a specific sample in the module
    ///
    /// Allows runtime adjustment of individual sample volumes.
    ///
    /// # Arguments
    /// * `sample_num` - Sample number in the module (1-31)
    /// * `volume` - New volume (0-64)
    pub fn set_sample_volume(&self, sample_num: u16, volume: u8) -> Result<(), AudioError> {
        if sample_num == 0 || sample_num > 31 {
            return Result::Err(AudioError::InvalidSampleNumber)
        }
        if volume > 64 {
            return Result::Err(AudioError::InvalidVolume)
        }

        unsafe {
            __novus_mt_samplevol(sample_num, volume)
        }

        return Result::Ok(())
    }

    /// Get the last E8 trigger value
    ///
    /// The E8 command (E8x where x is 0-F) in ProTracker sets a sync marker
    /// that can be read by the program. Trackers can place these at specific
    /// points in the song for visual synchronization.
    ///
    /// The value persists until the next E8 command. Reset to 0 on init.
    pub fn get_e8_trigger(&self) -> u8 {
        return get_mt_e8_trigger()
    }

    /// Check if the song has ended or looped
    ///
    /// Returns a non-zero value when the song reaches its end:
    /// - Bit 7 set: Song will stop (mt_Enable cleared)
    /// - Bits 0-6: Number of times the song has looped
    ///
    /// Reset to 0 on init.
    pub fn get_song_end(&self) -> u8 {
        return get_mt_song_end()
    }

    /// Check if song has finished playing
    ///
    /// Returns true when ptplayer has stopped (mt_Enable == 0).
    /// This happens when:
    /// - `stop()` was called
    /// - Single-play mode was enabled and the song reached its end
    ///
    /// Note: In looping mode, this only returns true after `stop()`.
    pub fn is_finished(&self) -> bool {
        // Check if ptplayer has stopped (mt_Enable == 0)
        // When in single-play mode, ptplayer clears mt_Enable when song ends
        return get_mt_enable() == 0
    }

    /// Enable single-play mode (song stops at end instead of looping)
    ///
    /// When enabled, the song will stop automatically when it reaches the end
    /// instead of looping. You can check `is_finished()` to detect this.
    ///
    /// This must be called before `play()` or `play_with_config()`.
    pub fn set_single_play(&mut self, enabled: bool) {
        if enabled {
            // Setting mt_SongEnd to $FF (-1) makes ptplayer stop when song ends
            set_mt_song_end($FF)
        } else {
            // Setting to 0 enables normal looping behavior
            set_mt_song_end(0)
        }
    }

    /// Get VU meter trigger and clear it
    ///
    /// Returns a bitmask indicating which channels started playing new notes
    /// since the last call. Bit 0 = channel 0, bit 1 = channel 1, etc.
    ///
    /// The value is cleared after reading. Use `peek_vumeter()` to read
    /// without clearing.
    ///
    /// Useful for visual effects synced to the beat.
    pub fn get_vumeter(&self) -> u8 {
        return get_mt_vumeter()
    }

    /// Peek at VU meter without clearing
    ///
    /// Same as `get_vumeter()` but doesn't clear the value.
    pub fn peek_vumeter(&self) -> u8 {
        return peek_mt_vumeter()
    }

    /// Get the number of channels dedicated to music
    pub fn get_music_channel_count(&self) -> u8 {
        return get_mt_music_channels()
    }

    /// Get current song position (0-127)
    ///
    /// This is the index into the pattern order table.
    pub fn song_position(&self) -> u8 {
        return __novus_ptplayer_get_song_pos()
    }

    /// Get total song length (number of positions)
    ///
    /// Returns the song length from the MOD file (1-128).
    pub fn song_length(&self) -> u8 {
        return __novus_ptplayer_get_song_length()
    }

    /// Get song progress as a percentage (0-100)
    pub fn progress(&self) -> u8 {
        let len = self.song_length()
        if len == 0 {
            return 0
        }
        let pos = self.song_position()
        return (u8)(((u32)pos * 100) / (u32)len)
    }

    /// Manually tick the music engine (for custom timing)
    ///
    /// Normally the CIA interrupt calls the music engine automatically.
    /// Use this only if you want to sync music to your own timing source
    /// instead of using the CIA interrupt.
    ///
    /// Note: This is different from `tick()` which checks for events and
    /// fires callbacks. This method directly drives the music playback.
    pub fn tick_music(&self) {
        let custom = (*u8)CUSTOM_BASE

        unsafe {
            __novus_mt_music(custom)
        }
    }

    // ========================================================================
    // Callback Configuration
    // ========================================================================

    /// Set callback for E8 sync trigger events
    ///
    /// The callback is invoked by `poll()` whenever the E8 trigger value
    /// changes. The E8x command in ProTracker allows trackers to embed
    /// sync markers (0-15) that your code can react to.
    ///
    /// Pass a null pointer to disable the callback.
    ///
    /// # Example
    /// ```novus
    /// fn on_sync(trigger: u8) {
    ///     match trigger {
    ///         1 => flash_screen(),
    ///         2 => spawn_enemy(),
    ///         _ => {}
    ///     }
    /// }
    ///
    /// player.set_on_e8_trigger(&on_sync)
    /// ```
    pub fn set_on_e8_trigger(&mut self, callback: u32) {
        self.on_e8_trigger = callback
    }

    /// Set callback for VU meter events
    ///
    /// The callback is invoked by `poll()` whenever any channel starts
    /// playing a new note. The parameter is a bitmask where bit N indicates
    /// channel N triggered (bits 0-3 for channels 0-3).
    ///
    /// Pass a null pointer to disable the callback.
    ///
    /// # Example
    /// ```novus
    /// fn on_vu(channels: u8) {
    ///     if (channels & 1) != 0 { flash_channel_0() }
    ///     if (channels & 2) != 0 { flash_channel_1() }
    /// }
    ///
    /// player.set_on_vumeter(&on_vu)
    /// ```
    pub fn set_on_vumeter(&mut self, callback: u32) {
        self.on_vumeter = callback
    }

    /// Set callback for song end/loop events
    ///
    /// The callback is invoked by `poll()` when the song_end value changes:
    /// - Bit 7 set: Song has finished (mt_Enable cleared)
    /// - Bits 0-6: Loop count
    ///
    /// Pass a null pointer to disable the callback.
    ///
    /// # Example
    /// ```novus
    /// fn on_song_end(status: u8) {
    ///     if (status & $80) != 0 {
    ///         // Song finished, play next track
    ///         load_next_song()
    ///     } else {
    ///         // Song looped
    ///         let loop_count = status & $7F
    ///         write("Loop %d\n", (i32)loop_count)
    ///     }
    /// }
    ///
    /// player.set_on_song_end(&on_song_end)
    /// ```
    pub fn set_on_song_end(&mut self, callback: u32) {
        self.on_song_end = callback
    }

    /// Poll for events and fire callbacks
    ///
    /// Call this regularly (e.g., once per frame in your game loop) to
    /// check for ptplayer events and invoke any registered callbacks.
    ///
    /// This is a polling-based approach which is more Amiga-idiomatic
    /// than interrupt-driven callbacks, giving you control over when
    /// events are processed.
    ///
    /// # Example
    /// ```novus
    /// // In your game loop:
    /// loop {
    ///     player.poll()  // Check for music events
    ///     update_game()
    ///     render_frame()
    ///     wait_vblank()
    /// }
    /// ```
    pub fn poll(&mut self) {
        // Check E8 trigger
        if self.on_e8_trigger != 0 {
            let current_e8 = get_mt_e8_trigger()
            if current_e8 != self.last_e8_value {
                self.last_e8_value = current_e8
                __novus_call_u8_callback(self.on_e8_trigger, current_e8)
            }
        }

        // Check VU meter (always fires if non-zero since it auto-clears)
        if self.on_vumeter != 0 {
            let vu = get_mt_vumeter()  // This clears the value
            if vu != 0 {
                __novus_call_u8_callback(self.on_vumeter, vu)
            }
        }

        // Check song end
        if self.on_song_end != 0 {
            let current_song_end = get_mt_song_end()
            if current_song_end != self.last_song_end {
                self.last_song_end = current_song_end
                __novus_call_u8_callback(self.on_song_end, current_song_end)
            }
        }
    }

    /// Clear callback state
    ///
    /// Resets the internal state tracking for callbacks. Call this after
    /// loading a new song to avoid spurious callbacks from stale state.
    pub fn reset_callback_state(&mut self) {
        self.last_e8_value = 0
        self.last_song_end = 0
    }
}

impl Drop for ModPlayer {
    fn drop(&mut self) {
        // Stop any playing music
        self.stop()

        // Remove CIA interrupt
        if self.cia_installed {
            let custom = (*u8)CUSTOM_BASE

            unsafe {
                __novus_mt_remove_cia(custom)
            }
            self.cia_installed = false
        }

        // Unpin and evict any cached MOD data
        // We evict on drop since the MOD is no longer needed
        if self.cache_asset_id != 0 {
            ChipCache::unpin(self.cache_asset_id)
            ChipCache::evict(self.cache_asset_id)
            self.cache_asset_id = 0
        }
    }
}
