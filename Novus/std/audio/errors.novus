// Audio Error Types
// Module: std::audio::errors
//
// Unified error types for all audio modules (paula, device, ptplayer).
// Import this module to handle errors from any audio source consistently.

from std::core import Result, Error

// ============================================================================
// Unified Audio Error
// ============================================================================

/// Unified error type for all audio operations
///
/// This enum encompasses errors from:
/// - Direct Paula hardware access (std::audio::paula)
/// - audio.device system interface (std::audio::device)
/// - ptplayer MOD playback (std::audio::ptplayer)
///
/// Using this unified type allows writing code that handles errors
/// from multiple audio sources consistently.
pub enum AudioError {
    // ========================================================================
    // Channel Errors
    // ========================================================================

    /// Channel index must be 0-3
    InvalidChannel,

    // ========================================================================
    // Volume/Period Errors
    // ========================================================================

    /// Volume must be 0-64
    InvalidVolume,

    /// Period must be 124-65535
    InvalidPeriod,

    /// Sample rate would result in invalid period
    InvalidSampleRate,

    // ========================================================================
    // Sample Data Errors
    // ========================================================================

    /// Sample data must be in Chip RAM (DMA-accessible, < $200000)
    SampleNotChipRam,

    /// Sample pointer must be word-aligned (even address)
    SampleMisaligned,

    /// Sample exceeds 128KB (65535 words)
    SampleTooLong,

    /// Sample length must be at least 2 bytes
    SampleTooShort,

    /// Sample pointer is null
    NullSampleData,

    // ========================================================================
    // Allocation Errors
    // ========================================================================

    /// Failed to allocate chip RAM for sample
    AllocationFailed,

    /// Failed to create message port
    NoMsgPort,

    /// Failed to create I/O request
    NoIORequest,

    // ========================================================================
    // Device Errors (audio.device specific)
    // ========================================================================

    /// Failed to open audio.device
    DeviceOpenFailed,

    /// No channel allocation received
    NoAllocation,

    /// Channel allocation request failed
    AllocFailed,

    /// Channel was stolen by higher priority request
    ChannelStolen,

    /// I/O error from audio.device (contains error code)
    DeviceIOError(i8),

    // ========================================================================
    // MOD Player Errors (ptplayer specific)
    // ========================================================================

    /// Failed to initialize MOD player
    ModInitFailed,

    /// Failed to install CIA interrupt handler
    CiaInstallFailed,

    /// Invalid channel mask (must be 0-15)
    InvalidChannelMask,

    /// Invalid sample number in MOD
    InvalidSampleNumber,

    /// Module data is null or invalid
    InvalidModuleData,

    /// Failed to copy asset to chip RAM (cache not initialized or out of memory)
    ChipCacheError,
}

// ============================================================================
// Error trait implementation
// ============================================================================

impl AudioError {
    pub fn message(&self) -> *u8 {
        match *self {
            AudioError::InvalidChannel => return "Invalid channel (must be 0-3)",
            AudioError::InvalidVolume => return "Invalid volume (must be 0-64)",
            AudioError::InvalidPeriod => return "Invalid period (must be 124-65535)",
            AudioError::InvalidSampleRate => return "Invalid sample rate",
            AudioError::SampleNotChipRam => return "Sample not in chip RAM",
            AudioError::SampleMisaligned => return "Sample not word-aligned",
            AudioError::SampleTooLong => return "Sample exceeds 128KB",
            AudioError::SampleTooShort => return "Sample too short",
            AudioError::NullSampleData => return "Null sample data",
            AudioError::AllocationFailed => return "Allocation failed",
            AudioError::NoMsgPort => return "Failed to create message port",
            AudioError::NoIORequest => return "Failed to create I/O request",
            AudioError::DeviceOpenFailed => return "Failed to open audio.device",
            AudioError::NoAllocation => return "No channel allocation",
            AudioError::AllocFailed => return "Channel allocation failed",
            AudioError::ChannelStolen => return "Channel stolen",
            AudioError::DeviceIOError(_) => return "Audio device I/O error",
            AudioError::ModInitFailed => return "MOD player init failed",
            AudioError::CiaInstallFailed => return "CIA interrupt install failed",
            AudioError::InvalidChannelMask => return "Invalid channel mask",
            AudioError::InvalidSampleNumber => return "Invalid sample number",
            AudioError::InvalidModuleData => return "Invalid module data",
            AudioError::ChipCacheError => return "Chip cache error",
        }
    }
}

impl Error for AudioError {
    fn message(&self) -> *u8 {
        return AudioError::message(self)
    }
}

// ============================================================================
// Conversion Traits (for module-specific errors)
// ============================================================================

// Note: These would be implemented in each module to convert their
// specific errors to the unified AudioError type. For now, modules
// can use AudioError directly.
