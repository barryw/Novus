}

// ============================================================================
// BStr - BCPL String for AmigaDOS
// ============================================================================

/// BCPL string (BSTR) for AmigaDOS compatibility
/// Format: [length_byte][char1][char2]...
/// Maximum length: 255 bytes
/// BPTR = address / 4
pub struct BStr {
    bptr: u32,  // BPTR (address divided by 4)
}

impl BStr {
    /// Create a BStr from a Str (allocates BCPL format)
    pub fn new_from_str(s: Str) -> Result<BStr, StringError> {
        if s.len() > 255 {
            return Result::Err(StringError::TooLong(s.len()))
        }

        // Allocate length byte + string data
        let total_bytes: u32 = 1 + s.len()
        let block_opt: Option<MemoryBlock> = MemoryBlock::alloc(total_bytes, MEMF_PUBLIC)

        match block_opt {
            Some(block) => {
                let ptr: *u8 = block.ptr()

                // Set length byte
                ptr[0] = (u8)s.len()

                // Copy string data
                var i: u32 = 0
                while i < s.len() {
                    ptr[1 + i] = s.as_ptr()[i]
                    i = i + 1
                }

                // Convert address to BPTR
                let addr: u32 = (u32)ptr
                let bptr: u32 = addr / 4

                return Result::Ok(BStr { bptr: bptr })
            },
            None => {
                return Result::Err(StringError::AllocationFailed)
            }
        }
    }

    /// Get the BPTR value for passing to DOS functions
    pub fn as_bptr(&self) -> u32 {
        return self.bptr
    }

    /// Get the actual memory address
    pub fn as_ptr(&self) -> *u8 {
        let addr: u32 = self.bptr * 4
        return (*u8)addr
    }

    /// Get the length
    pub fn len(&self) -> u32 {
        let ptr: *u8 = self.as_ptr()
        return (u32)ptr[0]
    }

    /// Convert to Str slice
    pub fn as_str(&self) -> Str {
        let ptr: *u8 = self.as_ptr()
        let len: u32 = (u32)ptr[0]
        let data_ptr: *u8 = ptr + 1
        return Str::from_raw(data_ptr, len)
    }

    /// Free the BCPL string memory
    pub fn drop(&self) {
        let ptr: *u8 = self.as_ptr()
        let len: u32 = self.len()
        let total_bytes: u32 = 1 + len

        unsafe {
            FreeMem(ptr, total_bytes)
        }
    }
}

// ============================================================================
// C String FFI Functions
// ============================================================================

extern fn strlen(str: *u8) -> u32
extern fn strcmp(s1: *u8, s2: *u8) -> i32
extern fn strncmp(s1: *u8, s2: *u8, n: u32) -> i32
extern fn strcpy(dest: *u8, src: *u8) -> *u8
extern fn strncpy(dest: *u8, src: *u8, n: u32) -> *u8
extern fn strcat(dest: *u8, src: *u8) -> *u8
extern fn strncat(dest: *u8, src: *u8, n: u32) -> *u8
extern fn strchr(str: *u8, ch: i32) -> *u8
extern fn strrchr(str: *u8, ch: i32) -> *u8
extern fn strstr(haystack: *u8, needle: *u8) -> *u8
extern fn memmove(dest: *u8, src: *u8, n: u32) -> *u8
extern fn memset(ptr: *u8, value: i32, n: u32) -> *u8
extern fn memcmp(s1: *u8, s2: *u8, n: u32) -> i32
