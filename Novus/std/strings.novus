    pub fn as_str(&self) -> Str {
        return Str::from_raw((*u8)(&self.buf), self.len)
    }

    pub fn as_mut_ptr(&mut self) -> *u8 {
        return (*u8)(&self.buf)
    }

    pub fn push_str(&mut self, s: Str) -> bool {
        if self.len + s.len() > 128 {
            return false
        }

        var i: u32 = 0
        while i < s.len() {
            self.buf[self.len + i] = s.as_ptr()[i]
            i = i + 1
        }

        self.len = self.len + s.len()
        return true
    }

    pub fn push_byte(&mut self, byte: u8) -> bool {
        if self.len >= 128 {
            return false
        }

        self.buf[self.len] = byte
        self.len = self.len + 1
        return true
    }

    pub fn clear(&mut self) {
        self.len = 0
    }
}

