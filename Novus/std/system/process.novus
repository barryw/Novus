// Novus Standard Library - Process Management
// Namespace: std::process
//
// High-level process creation and management with fluent builder API.
// This provides an ergonomic way to spawn DOS processes without
// manually dealing with tag lists.

from std::core import Option, Result, Drop
from std::strings::core import Str
from std::error::core import DosError
from std::ffi::amiga_structs import Process, MsgPort, Task, TagItem
from std::ffi::dos import CreateNewProc
from std::ffi::exec import AllocMem, FreeMem
from std::ffi::amiga_consts import NP_Entry, NP_StackSize, NP_Name, NP_Priority
from std::ffi::amiga_consts import NP_Input, NP_Output, NP_Error
from std::ffi::amiga_consts import NP_CloseInput, NP_CloseOutput, NP_CloseError
from std::ffi::amiga_consts import NP_CurrentDir, NP_HomeDir, NP_CopyVars
from std::ffi::amiga_consts import NP_Cli, NP_WindowPtr, NP_ConsoleTask
from std::ffi::amiga_consts import NP_NotifyOnDeath, NP_Synchronous
from std::ffi::amiga_consts import SIGBREAKF_CTRL_C, SIGBREAKF_CTRL_D
from std::ffi::amiga_consts import SIGBREAKF_CTRL_E, SIGBREAKF_CTRL_F
from std::ffi::amiga_consts import MEMF_PUBLIC, MEMF_CLEAR

// ============================================================================
// ProcessBuilder - Fluent API for Process Creation
// ============================================================================

/// ProcessBuilder - fluent builder for creating DOS processes
///
/// Provides a modern, ergonomic way to spawn processes without manually
/// building tag lists. Uses method chaining for a clean API.
///
/// Example:
/// ```novus
/// from std::process import ProcessBuilder
///
/// fn my_task() {
///     // Task code here
/// }
///
/// fn main() {
///     var builder = ProcessBuilder::new()
///     builder.set_name("Worker Task")
///     builder.set_stack_size(8192)
///     builder.set_priority(5)
///     builder.set_entry(my_task)
///
///     match builder.spawn() {
///         Ok(process) => {
///             // Process is now running
///         },
///         Err(e) => {
///             // Handle error
///         }
///     }
/// }
/// ```
pub struct ProcessBuilder {
    // Required
    entry: u32,           // Entry point function pointer

    // Optional settings with defaults
    name: *u8,            // Process name (null = unnamed)
    stack_size: u32,      // Stack size (0 = default 4096)
    priority: i8,         // Task priority (0 = default)

    // I/O handles (0 = inherit)
    input: i32,
    output: i32,
    error: i32,
    close_input: bool,
    close_output: bool,
    close_error: bool,

    // Directory locks (0 = inherit)
    current_dir: i32,
    home_dir: i32,

    // Misc options
    copy_vars: bool,      // Copy local shell variables
    is_cli: bool,         // Create as CLI process
    window_ptr: *u8,      // Window for requesters
    console_task: *u8,    // Console handler

    // Exit notification
    notify_on_death: bool,
    synchronous: bool,
}

impl ProcessBuilder {
    /// Create a new ProcessBuilder with default settings
    pub fn new() -> ProcessBuilder {
        return ProcessBuilder {
            entry: 0,
            name: (*u8)0,
            stack_size: 4096,
            priority: 0,
            input: 0,
            output: 0,
            error: 0,
            close_input: false,
            close_output: false,
            close_error: false,
            current_dir: 0,
            home_dir: 0,
            copy_vars: false,
            is_cli: false,
            window_ptr: (*u8)0,
            console_task: (*u8)0,
            notify_on_death: false,
            synchronous: false
        }
    }

    /// Set the entry point function (required)
    pub fn set_entry(&mut self, func: *u8) {
        self.entry = (u32)func
    }

    /// Set the process name
    pub fn set_name(&mut self, name: Str) {
        self.name = name.as_cstr()
    }

    /// Set the stack size in bytes (default: 4096)
    pub fn set_stack_size(&mut self, size: u32) {
        self.stack_size = size
    }

    /// Set the task priority (-128 to 127, default: 0)
    pub fn set_priority(&mut self, pri: i8) {
        self.priority = pri
    }

    /// Set input file handle
    pub fn set_input(&mut self, fh: i32) {
        self.input = fh
    }

    /// Set output file handle
    pub fn set_output(&mut self, fh: i32) {
        self.output = fh
    }

    /// Set error file handle
    pub fn set_error(&mut self, fh: i32) {
        self.error = fh
    }

    /// Set whether to close input handle on exit
    pub fn set_close_input(&mut self, close: bool) {
        self.close_input = close
    }

    /// Set whether to close output handle on exit
    pub fn set_close_output(&mut self, close: bool) {
        self.close_output = close
    }

    /// Set whether to close error handle on exit
    pub fn set_close_error(&mut self, close: bool) {
        self.close_error = close
    }

    /// Set current directory lock
    pub fn set_current_dir(&mut self, lock: i32) {
        self.current_dir = lock
    }

    /// Set home directory lock
    pub fn set_home_dir(&mut self, lock: i32) {
        self.home_dir = lock
    }

    /// Set whether to copy local shell variables
    pub fn set_copy_vars(&mut self, copy: bool) {
        self.copy_vars = copy
    }

    /// Set whether to create as CLI process
    pub fn set_cli(&mut self, is_cli: bool) {
        self.is_cli = is_cli
    }

    /// Set window pointer for system requesters
    pub fn set_window(&mut self, win: *u8) {
        self.window_ptr = win
    }

    /// Set console handler task
    pub fn set_console(&mut self, task: *u8) {
        self.console_task = task
    }

    /// Set whether to notify parent on exit
    pub fn set_notify_on_death(&mut self, notify: bool) {
        self.notify_on_death = notify
    }

    /// Set whether to wait synchronously for completion
    pub fn set_synchronous(&mut self, sync: bool) {
        self.synchronous = sync
    }

    /// Spawn the process
    ///
    /// Creates the process with all configured settings.
    /// Returns the Process pointer on success, or error if creation fails.
    pub fn spawn(&self) -> Result<*Process, DosError> {
        // Validate required fields
        if self.entry == 0 {
            return Result::Err(DosError::Unknown)
        }

        // Build tag list - allocate space for max 21 tags
        let tag_count: u32 = 21
        let tag_size = tag_count * @sizeof(TagItem)

        var tag_mem: *u8 = (*u8)0
        unsafe {
            tag_mem = AllocMem(tag_size, MEMF_PUBLIC | MEMF_CLEAR)
        }
        if (u32)tag_mem == 0 {
            return Result::Err(DosError::Unknown)
        }

        let tag_ptr = (*TagItem)tag_mem
        var idx: u32 = 0

        // Required: entry point
        self.set_tag(tag_ptr, idx, NP_Entry, self.entry)
        idx++

        // Name (if set)
        if (u32)self.name != 0 {
            self.set_tag(tag_ptr, idx, NP_Name, (u32)self.name)
            idx++
        }

        // Stack size
        self.set_tag(tag_ptr, idx, NP_StackSize, self.stack_size)
        idx++

        // Priority
        self.set_tag(tag_ptr, idx, NP_Priority, (u32)self.priority)
        idx++

        // I/O handles
        if self.input != 0 {
            self.set_tag(tag_ptr, idx, NP_Input, (u32)self.input)
            idx++
        }

        if self.output != 0 {
            self.set_tag(tag_ptr, idx, NP_Output, (u32)self.output)
            idx++
        }

        if self.error != 0 {
            self.set_tag(tag_ptr, idx, NP_Error, (u32)self.error)
            idx++
        }

        // Close flags
        if self.close_input {
            self.set_tag(tag_ptr, idx, NP_CloseInput, 1)
            idx++
        }

        if self.close_output {
            self.set_tag(tag_ptr, idx, NP_CloseOutput, 1)
            idx++
        }

        if self.close_error {
            self.set_tag(tag_ptr, idx, NP_CloseError, 1)
            idx++
        }

        // Directory locks
        if self.current_dir != 0 {
            self.set_tag(tag_ptr, idx, NP_CurrentDir, (u32)self.current_dir)
            idx++
        }

        if self.home_dir != 0 {
            self.set_tag(tag_ptr, idx, NP_HomeDir, (u32)self.home_dir)
            idx++
        }

        // Other options
        if self.copy_vars {
            self.set_tag(tag_ptr, idx, NP_CopyVars, 1)
            idx++
        }

        if self.is_cli {
            self.set_tag(tag_ptr, idx, NP_Cli, 1)
            idx++
        }

        if (u32)self.window_ptr != 0 {
            self.set_tag(tag_ptr, idx, NP_WindowPtr, (u32)self.window_ptr)
            idx++
        }

        if (u32)self.console_task != 0 {
            self.set_tag(tag_ptr, idx, NP_ConsoleTask, (u32)self.console_task)
            idx++
        }

        if self.notify_on_death {
            self.set_tag(tag_ptr, idx, NP_NotifyOnDeath, 1)
            idx++
        }

        if self.synchronous {
            self.set_tag(tag_ptr, idx, NP_Synchronous, 1)
            idx++
        }

        // Terminate tag list (TAG_DONE = 0)
        self.set_tag(tag_ptr, idx, 0, 0)

        // Create the process
        let process = CreateNewProc(tag_ptr)

        // Free tag memory (process has copied what it needs)
        unsafe {
            FreeMem(tag_mem, tag_size)
        }

        // Check result - CreateNewProc returns NULL on failure
        if (u32)process != 0 {
            return Result::Ok((*Process)process)
        }

        return Result::Err(DosError::Unknown)
    }

    /// Helper to set a tag in the tag array
    fn set_tag(&self, tags: *TagItem, index: u32, tag: u32, data: u32) {
        let ptr = (u32)tags + (index * @sizeof(TagItem))
        let tag_ptr = (*TagItem)ptr
        let tag_ref = tag_ptr
        tag_ref.ti_Tag = tag
        tag_ref.ti_Data = data
    }
}

// ============================================================================
// ProcessHandle - RAII wrapper for spawned processes
// ============================================================================

// Note: ProcessHandle for RAII management is complex on AmigaOS because
// processes are independent entities. Unlike modern OSes, you can't just
// "kill" a process - you need to signal it and let it clean up properly.
//
// For now, ProcessBuilder::spawn() returns a raw *Process pointer.
// Future enhancement: Add ProcessHandle with wait(), signal(), is_running().
