from std::collections import ArrayVec, ArrayVecError
from std::core import Error, From, Option, Result
from std::string import FixedCString, FixedString, Str
from amiga::storage::block_device import BlockDeviceError
from amiga::sys::device import DriverLoadError, device_is_resident, load_device_driver
from amiga::sys::dos import DeviceProcess, DosDeviceList

// Tier 1: safe block storage and owned device discovery for applications.
pub use amiga::storage::block_device::*

pub const MAX_DEVICES: u32 = 32

pub enum StorageError {
    DeviceUnavailable,
    DriverLoadFailed,
    DiscoveryFailed,
    TooManyDevices,
}

/// How AmigaDOS is currently using a block device.
pub enum DeviceUse {
    Clear,
    Mounted,
    Boot,
}

impl From<BlockDeviceError> for StorageError {
    fn convert(consuming error: BlockDeviceError) -> StorageError {
        return StorageError::DeviceUnavailable
    }
}

impl From<ArrayVecError> for StorageError {
    fn convert(consuming _error: ArrayVecError) -> StorageError {
        return StorageError::TooManyDevices
    }
}

impl StorageError {
    pub fn message(&self) -> *u8 {
        return match self {
            StorageError::DeviceUnavailable => "The storage device is unavailable",
            StorageError::DriverLoadFailed => "Could not load the device driver",
            StorageError::DiscoveryFailed => "Could not discover storage devices",
            StorageError::TooManyDevices => "Too many mounted devices",
        }
    }
}

impl From<DriverLoadError> for StorageError {
    fn convert(consuming error: DriverLoadError) -> StorageError {
        return StorageError::DriverLoadFailed
    }
}

pub fn driver_is_loaded(name: Str) -> bool {
    return device_is_resident(name)
}

pub fn load_driver(path: Str) -> Result<FixedCString<40>, StorageError> {
    return Result::Ok(load_device_driver(path)?)
}

impl Error for StorageError {
    fn message(&self) -> *u8 { return StorageError::message(self) }
}

/// Owner-independent identity copied while the DOS list is locked.
pub struct StorageDevice {
    driver: FixedCString<60>,
    name: FixedString<32>,
    unit: u32,
    flags: u32,
}

impl StorageDevice {
    pub fn driver(&self) -> Str { return self.driver.as_str() }
    pub fn name(&self) -> Str { return self.name.as_str() }
    pub fn unit(&self) -> u32 { return self.unit }
    pub fn flags(&self) -> u32 { return self.flags }
}

fn contains_device(devices: &ArrayVec<StorageDevice, 32>, driver: Str, unit: u32) -> bool {
    for device in devices {
        return true if device.unit() == unit && device.driver().eq_ignore_case(driver)
    }
    return false
}

fn valid_driver_name(name: Str) -> bool {
    return false unless name.len() >= 8 && name.len() <= 60
    return match name.slice_from(name.len() - 7) {
        Result::Ok(suffix) => suffix.eq_ignore_case(".device"),
        Result::Err(_) => false,
    }
}

/// Return owned snapshots; no DOS-list lock or borrowed view escapes this call.
pub fn devices() -> Result<ArrayVec<StorageDevice, 32>, StorageError> {
    let list = match DosDeviceList::lock() {
        Result::Ok(value) => value,
        Result::Err(_) => return Result::Err(StorageError::DiscoveryFailed),
    }
    var result = ArrayVec::<StorageDevice, 32>::new()
    for entry in list.iter() {
        let startup = entry.startup() else { continue }
        let driver = startup.device_name() else { continue }
        continue unless valid_driver_name(driver)
        continue if contains_device(&result, driver, startup.unit())

        let Result::Ok(owned_driver) = FixedCString::<60>::new_from_str(driver) else { continue }
        var owned_name = FixedString::<32>::new()
        match entry.name() {
            Option::Some(name) => { let _ = owned_name.push_str(name) },
            Option::None => {},
        }
        result.push(StorageDevice {
            driver: owned_driver,
            name: owned_name,
            unit: startup.unit(),
            flags: startup.flags(),
        })?
    }
    return Result::Ok(result)
}

/// Classify a live device without exposing DOS-list locks or handler processes.
/// Failure is returned explicitly so destructive callers can fail closed.
pub fn device_use(driver: Str, unit: u32) -> Result<DeviceUse, StorageError> {
    let sys_name = FixedCString::<4>::new_from_str("SYS:")
        .or_error(StorageError::DiscoveryFailed)?
    let boot = DeviceProcess::resolve(sys_name.as_cstr_view())
        .or_error(StorageError::DiscoveryFailed)?
    let list = DosDeviceList::lock().or_error(StorageError::DiscoveryFailed)?

    var boot_known = false
    var mounted = false
    for entry in list.iter() {
        let startup = entry.startup() else { continue }
        let current_driver = startup.device_name() else { continue }
        continue unless valid_driver_name(current_driver)
        let same = startup.unit() == unit && current_driver.eq_ignore_case(driver)
        if entry.is_handled_by(&boot) {
            boot_known = true
            return Result::Ok(DeviceUse::Boot) if same
        }
        mounted = true if same
    }

    return Result::Ok(DeviceUse::Mounted) if mounted
    return Result::Ok(DeviceUse::Clear) if boot_known
    return Result::Err(StorageError::DiscoveryFailed)
}

/// Find the mounted volume whose on-disk cylinder range overlaps a partition.
pub fn mounted_volume_for(
    driver: Str,
    unit: u32,
    low_cylinder: u32,
    high_cylinder: u32
) -> Result<Option<FixedString<32>>, StorageError> {
    let list = DosDeviceList::lock().or_error(StorageError::DiscoveryFailed)?
    for entry in list.iter() {
        let startup = entry.startup() else { continue }
        let current_driver = startup.device_name() else { continue }
        continue unless startup.unit() == unit && current_driver.eq_ignore_case(driver)
        let environment = startup.environment() else { continue }
        continue unless low_cylinder <= environment.de_HighCyl && environment.de_LowCyl <= high_cylinder
        let name = entry.name() else { continue }
        return match FixedString::<32>::new_from_str(name) {
            Result::Ok(value) => Result::Ok(Option::Some(value)),
            Result::Err(_) => Result::Err(StorageError::DiscoveryFailed),
        }
    }
    return Result::Ok(Option::None)
}

/// Test a DOS device name while keeping the DOS-list lock inside Tier 1.
pub fn volume_name_exists(name: Str) -> Result<bool, StorageError> {
    let list = DosDeviceList::lock().or_error(StorageError::DiscoveryFailed)?
    for entry in list.iter() {
        let existing = entry.name() else { continue }
        return Result::Ok(true) if existing.eq_ignore_case(name)
    }
    return Result::Ok(false)
}
