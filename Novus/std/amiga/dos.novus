from std::core import Error, From, Option, Result
from std::collections::vec import Vec
from amiga::sys::dos::errors import DosError
from std::memory import MutSlice, Slice
from amiga::sys::dos import DirLockHandle, OwnedFileHandle
from amiga::sys::dos import DosEnvironment, DosNodeDraft, DosNodeError
from amiga::sys::dos import FileSystemHandler, FileSystemOperationError, FileSystemRegistry, MountedFileSystem
from amiga::sys::dos import HandlerImage, LoadedSegment, SegmentError
from std::string import FixedString, Str, String
from amiga::sys::timer import Duration, delay

// Tier 1: files, directories, mounted volumes, and formatting.
pub use amiga::sys::dos::errors::DosError

const DOS_FAMILY: u32 = $444F5300
const DEFAULT_HANDLER_STACK: u32 = 4096
const DEFAULT_HANDLER_PRIORITY: i32 = 10

/// Reports failures from file system operations.
pub enum FileSystemError {
    /// Indicates handler unavailable.
    HandlerUnavailable,
    /// Indicates invalid environment.
    InvalidEnvironment,
    /// Indicates mount failed.
    MountFailed,
    /// Indicates format failed.
    FormatFailed,
}

impl FileSystemError {
    /// Returns a human-readable description of this error.
    ///
    /// # Returns
    /// The resulting `*u8` value.
    pub fn message(&self) -> *u8 {
        return match self {
            FileSystemError::HandlerUnavailable => "No compatible filesystem handler is available",
            FileSystemError::InvalidEnvironment => "The filesystem environment is invalid",
            FileSystemError::MountFailed => "The filesystem handler did not mount the volume",
            FileSystemError::FormatFailed => "The filesystem rejected the format request",
        }
    }
}

impl Error for FileSystemError {
    fn message(&self) -> *u8 { return FileSystemError::message(self) }
}

impl From<DosNodeError> for FileSystemError {
    fn convert(consuming _error: DosNodeError) -> FileSystemError {
        return FileSystemError::InvalidEnvironment
    }
}

impl From<SegmentError> for FileSystemError {
    fn convert(consuming _error: SegmentError) -> FileSystemError {
        return FileSystemError::HandlerUnavailable
    }
}

impl From<FileSystemOperationError> for FileSystemError {
    fn convert(consuming error: FileSystemOperationError) -> FileSystemError {
        return match error {
            FileSystemOperationError::FormatFailed(_) | FileSystemOperationError::InhibitFailed(_) => FileSystemError::FormatFailed,
            _ => FileSystemError::MountFailed,
        }
    }
}

/// Semantic partition geometry used to mount a filesystem. Tier 1 owns the
/// translation to the NDK DosEnvec/DosEnvironment representation.
pub struct PartitionGeometry {
    /// The block bytes value stored by `PartitionGeometry`.
    block_bytes: u32
    /// The surfaces value stored by `PartitionGeometry`.
    surfaces: u32
    /// The blocks per track value stored by `PartitionGeometry`.
    blocks_per_track: u32
    /// The low cylinder value stored by `PartitionGeometry`.
    low_cylinder: u32
    /// The high cylinder value stored by `PartitionGeometry`.
    high_cylinder: u32
    /// The dos type value stored by `PartitionGeometry`.
    dos_type: u32
    /// The buffers value stored by `PartitionGeometry`.
    buffers: u32
    /// The buffer memory value stored by `PartitionGeometry`.
    buffer_memory: u32
    /// The max transfer value stored by `PartitionGeometry`.
    max_transfer: u32
    /// The mask value stored by `PartitionGeometry`.
    mask: u32
    /// The boot priority value stored by `PartitionGeometry`.
    boot_priority: i32
}

impl PartitionGeometry {
    /// Creates a new `PartitionGeometry` value.
    ///
    /// # Parameters
    /// * `block_bytes` - The `u32` value used as block bytes.
    /// * `surfaces` - The `u32` value used as surfaces.
    /// * `blocks_per_track` - The `u32` value used as blocks per track.
    /// * `low_cylinder` - The `u32` value used as low cylinder.
    /// * `high_cylinder` - The `u32` value used as high cylinder.
    /// * `dos_type` - The `u32` value used as dos type.
    ///
    /// # Returns
    /// The requested value on success; the error value explains why the operation could not complete.
    pub fn new(
        block_bytes: u32,
        surfaces: u32,
        blocks_per_track: u32,
        low_cylinder: u32,
        high_cylinder: u32,
        dos_type: u32
    ) -> Result<PartitionGeometry, FileSystemError> {
        return Result::Err(FileSystemError::InvalidEnvironment) if block_bytes == 0 || block_bytes % 4 != 0
        return Result::Err(FileSystemError::InvalidEnvironment) if surfaces == 0 || blocks_per_track == 0 || low_cylinder > high_cylinder
        return Result::Ok(PartitionGeometry {
            block_bytes: block_bytes,
            surfaces: surfaces,
            blocks_per_track: blocks_per_track,
            low_cylinder: low_cylinder,
            high_cylinder: high_cylinder,
            dos_type: dos_type,
            buffers: 30,
            buffer_memory: 0,
            max_transfer: $7FFFFFFF,
            mask: $FFFFFFFE,
            boot_priority: 0,
        })
    }

    /// Returns a copy configured with buffers for `PartitionGeometry`.
    ///
    /// # Parameters
    /// * `count` - The requested count.
    ///
    /// # Returns
    /// The requested value on success; the error value explains why the operation could not complete.
    ///
    /// # Ownership
    /// Arguments marked `consuming` transfer ownership to this call.
    pub fn with_buffers(consuming self, count: u32) -> Result<PartitionGeometry, FileSystemError> {
        return Result::Err(FileSystemError::InvalidEnvironment) if count == 0
        self.buffers = count
        return Result::Ok(self)
    }

    /// Returns a copy configured with transfer for `PartitionGeometry`.
    ///
    /// # Parameters
    /// * `maximum` - The `u32` value used as maximum.
    /// * `mask` - The `u32` value used as mask.
    ///
    /// # Returns
    /// The requested value on success; the error value explains why the operation could not complete.
    ///
    /// # Ownership
    /// Arguments marked `consuming` transfer ownership to this call.
    pub fn with_transfer(consuming self, maximum: u32, mask: u32) -> Result<PartitionGeometry, FileSystemError> {
        return Result::Err(FileSystemError::InvalidEnvironment) if maximum == 0 || mask == 0
        self.max_transfer = maximum
        self.mask = mask
        return Result::Ok(self)
    }

    /// Returns a copy configured with boot priority for `PartitionGeometry`.
    ///
    /// # Parameters
    /// * `priority` - The priority value.
    ///
    /// # Returns
    /// The resulting `PartitionGeometry` value.
    ///
    /// # Ownership
    /// Arguments marked `consuming` transfer ownership to this call.
    pub fn with_boot_priority(consuming self, priority: i32) -> PartitionGeometry {
        self.boot_priority = priority
        return self
    }

    /// Returns the block bytes value associated with `PartitionGeometry`.
    ///
    /// # Returns
    /// The resulting `u32` value.
    pub fn block_bytes(&self) -> u32 { return self.block_bytes }
    /// Returns the surfaces value associated with `PartitionGeometry`.
    ///
    /// # Returns
    /// The resulting `u32` value.
    pub fn surfaces(&self) -> u32 { return self.surfaces }
    /// Returns the blocks per track value associated with `PartitionGeometry`.
    ///
    /// # Returns
    /// The resulting `u32` value.
    pub fn blocks_per_track(&self) -> u32 { return self.blocks_per_track }
    /// Returns the low cylinder value associated with `PartitionGeometry`.
    ///
    /// # Returns
    /// The resulting `u32` value.
    pub fn low_cylinder(&self) -> u32 { return self.low_cylinder }
    /// Returns the high cylinder value associated with `PartitionGeometry`.
    ///
    /// # Returns
    /// The resulting `u32` value.
    pub fn high_cylinder(&self) -> u32 { return self.high_cylinder }
    /// Returns the buffers value associated with `PartitionGeometry`.
    ///
    /// # Returns
    /// The resulting `u32` value.
    pub fn buffers(&self) -> u32 { return self.buffers }
    /// Returns the max transfer value associated with `PartitionGeometry`.
    ///
    /// # Returns
    /// The resulting `u32` value.
    pub fn max_transfer(&self) -> u32 { return self.max_transfer }
    /// Returns the mask value associated with `PartitionGeometry`.
    ///
    /// # Returns
    /// The resulting `u32` value.
    pub fn mask(&self) -> u32 { return self.mask }
    /// Returns the boot priority value associated with `PartitionGeometry`.
    ///
    /// # Returns
    /// The resulting `i32` value.
    pub fn boot_priority(&self) -> i32 { return self.boot_priority }
    /// Returns the dos type value associated with `PartitionGeometry`.
    ///
    /// # Returns
    /// The resulting `u32` value.
    pub fn dos_type(&self) -> u32 { return self.dos_type }

    fn environment(&self) -> Result<DosEnvironment, FileSystemError> {
        var environment = DosEnvironment::partition(
            self.block_bytes,
            self.surfaces,
            self.blocks_per_track,
            self.low_cylinder,
            self.high_cylinder,
            self.dos_type
        )?
        environment.set_buffers(self.buffers, self.buffer_memory)?
        environment.set_transfer(self.max_transfer, self.mask)?
        environment.set_boot_priority(self.boot_priority)
        return Result::Ok(environment)
    }
}

/// Everything an application means when it asks DOS to mount a partition.
pub struct MountSpec {
    /// The name value stored by `MountSpec`.
    name: Str
    /// The driver value stored by `MountSpec`.
    driver: Str
    /// The unit value stored by `MountSpec`.
    unit: u32
    /// The open flags value stored by `MountSpec`.
    open_flags: u32
    /// The partition value stored by `MountSpec`.
    partition: PartitionGeometry
}

impl MountSpec {
    /// Creates a new `MountSpec` value.
    ///
    /// # Parameters
    /// * `name` - The name to use.
    /// * `driver` - The `Str` value used as driver.
    /// * `unit` - The unit value.
    /// * `partition` - The partition; ownership transfers to this call.
    ///
    /// # Returns
    /// The resulting `MountSpec` value.
    ///
    /// # Ownership
    /// Arguments marked `consuming` transfer ownership to this call.
    pub fn new(name: Str, driver: Str, unit: u32, consuming partition: PartitionGeometry) -> MountSpec {
        return MountSpec { name: name, driver: driver, unit: unit, open_flags: 0, partition: partition }
    }

    /// Returns a copy configured with open flags for `MountSpec`.
    ///
    /// # Parameters
    /// * `flags` - The flags value.
    ///
    /// # Returns
    /// The resulting `MountSpec` value.
    ///
    /// # Ownership
    /// Arguments marked `consuming` transfer ownership to this call.
    pub fn with_open_flags(consuming self, flags: u32) -> MountSpec {
        self.open_flags = flags
        return self
    }
}

/// Application-level embedded handler. Launch mechanics are deliberately held
/// in a systems object and are visible only to callers that step down a tier.
pub struct EmbeddedFileSystem { system: HandlerImage }

impl EmbeddedFileSystem {
    /// Wraps an owned system-level value as `EmbeddedFileSystem`.
    ///
    /// # Parameters
    /// * `image` - The image; ownership transfers to this call.
    ///
    /// # Returns
    /// The resulting `EmbeddedFileSystem` value.
    ///
    /// # Ownership
    /// Arguments marked `consuming` transfer ownership to this call.
    pub fn from_system(consuming image: HandlerImage) -> EmbeddedFileSystem {
        return EmbeddedFileSystem { system: image }
    }

    /// Borrows the system-level value wrapped by `EmbeddedFileSystem`.
    ///
    /// # Returns
    /// A shared borrow of `HandlerImage` tied to the receiver.
    pub fn system(&self) -> &HandlerImage { return &self.system }
}

struct OwnedFileSystem {
    segment: LoadedSegment,
    global_vec: i32,
    stack_size: u32,
    priority: i32,
}

enum FileSystemSource {
    Shared(FileSystemHandler),
    Owned(OwnedFileSystem),
}

/// A resolved handler ready to mount a DOS environment.
pub struct FileSystem {
    /// The source value stored by `FileSystem`.
    source: FileSystemSource,
}

impl FileSystem {
    /// Resolve a live/registered handler, then an embedded image, then FastFileSystem.
    pub fn resolve(dos_type: u32) -> Result<FileSystem, FileSystemError> {
        return FileSystem::resolve_embedded(dos_type, Option::None)
    }

    /// Advanced application path for an RDB-derived handler that was decoded
    /// by systems-aware code. Ordinary applications use `resolve`.
    pub fn resolve_embedded(dos_type: u32, embedded: Option<EmbeddedFileSystem>) -> Result<FileSystem, FileSystemError> {
        match FileSystemHandler::find_live(dos_type) {
            Option::Some(handler) => return Result::Ok(FileSystem { source: FileSystemSource::Shared(handler) }),
            Option::None => {},
        }
        match FileSystemRegistry::open() {
            Result::Ok(registry) => {
                match registry.find(dos_type) {
                    Option::Some(handler) => return Result::Ok(FileSystem { source: FileSystemSource::Shared(handler) }),
                    Option::None => {},
                }
            },
            Result::Err(_) => {},
        }
        match embedded {
            Option::Some(image) => {
                let segment = LoadedSegment::from_hunk(image.system.image())?
                return Result::Ok(FileSystem {
                    source: FileSystemSource::Owned(OwnedFileSystem {
                        segment: segment,
                        global_vec: image.system.global_vec(),
                        stack_size: image.system.stack_size(),
                        priority: image.system.priority(),
                    }),
                })
            },
            Option::None => {},
        }
        return Result::Err(FileSystemError::HandlerUnavailable) unless dos_type & $FFFFFF00 == DOS_FAMILY
        let segment = LoadedSegment::from_file("L:FastFileSystem")?
        return Result::Ok(FileSystem {
            source: FileSystemSource::Owned(OwnedFileSystem {
                segment: segment,
                global_vec: -1,
                stack_size: DEFAULT_HANDLER_STACK,
                priority: DEFAULT_HANDLER_PRIORITY,
            }),
        })
    }

    /// Create, register, start, and wait for a DOS device in one owned operation.
    pub fn mount(consuming self, consuming spec: MountSpec) -> Result<ApplicationVolume, FileSystemError> {
        let environment = spec.partition.environment()?
        var draft = DosNodeDraft::new(spec.name, spec.driver, spec.unit, spec.open_flags, &environment)?
        match self.source {
            FileSystemSource::Shared(handler) => {
                draft.bind_registered(&handler)?
                let _registered = draft.register(0, true)?
            },
            FileSystemSource::Owned(owned) => {
                let _registered = draft.register_loaded(
                    owned.segment,
                    owned.global_vec,
                    owned.stack_size,
                    owned.priority,
                    0,
                    true
                )?
            },
        }
        return wait_for_volume(spec.name)
    }
}

/// Application directory with a deliberately small surface.
pub struct ApplicationDirectory { system: DirLockHandle }

impl ApplicationDirectory {
    /// Opens `ApplicationDirectory`.
    ///
    /// # Parameters
    /// * `path` - The path to use.
    ///
    /// # Returns
    /// The requested value on success; the error value explains why the operation could not complete.
    pub fn open(path: Str) -> Result<ApplicationDirectory, DosError> {
        return Result::Ok(ApplicationDirectory { system: DirLockHandle::lock(path, -2)? })
    }

    /// Borrows the system-level value wrapped by `ApplicationDirectory`.
    ///
    /// # Returns
    /// A shared borrow of `DirLockHandle` tied to the receiver.
    pub fn system(&self) -> &DirLockHandle { return &self.system }
    /// Wraps an owned system-level value as `ApplicationDirectory`.
    ///
    /// # Parameters
    /// * `directory` - The directory; ownership transfers to this call.
    ///
    /// # Returns
    /// The resulting `ApplicationDirectory` value.
    ///
    /// # Ownership
    /// Arguments marked `consuming` transfer ownership to this call.
    pub fn from_system(consuming directory: DirLockHandle) -> ApplicationDirectory {
        return ApplicationDirectory { system: directory }
    }
}

/// Application volume over one mounted-filesystem systems owner.
pub struct ApplicationVolume { system: MountedFileSystem }

impl ApplicationVolume {
    /// Returns the name value associated with `ApplicationVolume`.
    ///
    /// # Returns
    /// The resulting `Str` value.
    pub fn name(&self) -> Str { return self.system.name() }
    /// Borrows the system-level value wrapped by `ApplicationVolume`.
    ///
    /// # Returns
    /// A shared borrow of `MountedFileSystem` tied to the receiver.
    pub fn system(&self) -> &MountedFileSystem { return &self.system }
    /// Wraps an owned system-level value as `ApplicationVolume`.
    ///
    /// # Parameters
    /// * `volume` - The volume; ownership transfers to this call.
    ///
    /// # Returns
    /// The resulting `ApplicationVolume` value.
    ///
    /// # Ownership
    /// Arguments marked `consuming` transfer ownership to this call.
    pub fn from_system(consuming volume: MountedFileSystem) -> ApplicationVolume {
        return ApplicationVolume { system: volume }
    }

    /// Inhibit, format, and always resume the volume.
    pub fn format(&self, volume_name: Str, dos_type: u32) -> Result<(), FileSystemError> {
        var inhibited = self.system.inhibit()?
        inhibited.format(volume_name, dos_type)?
        inhibited.release()?
        return Result::Ok(())
    }
}

/// Opens volume for the module.
///
/// # Parameters
/// * `name` - The name to use.
///
/// # Returns
/// The requested value on success; the error value explains why the operation could not complete.
pub fn open_volume(name: Str) -> Result<ApplicationVolume, FileSystemError> {
    if name.ends_with(":") {
        return Result::Ok(ApplicationVolume { system: MountedFileSystem::open(name)? })
    }
    var path = FixedString::<256>::new()
    return Result::Err(FileSystemError::MountFailed) if path.push_str(name).is_err()
    return Result::Err(FileSystemError::MountFailed) if path.push_byte((u8)':').is_err()
    return Result::Ok(ApplicationVolume { system: MountedFileSystem::open(path.as_str())? })
}

fn wait_for_volume(name: Str) -> Result<ApplicationVolume, FileSystemError> {
    for _attempt in 0..40 {
        match open_volume(name) {
            Result::Ok(volume) => return Result::Ok(volume),
            Result::Err(_) => {},
        }
        let _ = delay(Duration::millis(100))
    }
    return Result::Err(FileSystemError::MountFailed)
}

/// Aliases `Directory` to `ApplicationDirectory`.
pub type Directory = ApplicationDirectory
/// Aliases `Volume` to `ApplicationVolume`.
pub type Volume = ApplicationVolume

/// Owned file with semantic open/create operations and bounded I/O.
pub struct File {
    /// The file value stored by `File`.
    file: OwnedFileHandle,
}

impl File {
    /// Opens `File`.
    ///
    /// # Parameters
    /// * `path` - The path to use.
    ///
    /// # Returns
    /// The requested value on success; the error value explains why the operation could not complete.
    pub fn open(path: Str) -> Result<File, DosError> {
        return match OwnedFileHandle::open_existing(path) {
            Result::Ok(file) => Result::Ok(File { file: file }),
            Result::Err(error) => Result::Err(error),
        }
    }

    /// Creates `File`.
    ///
    /// # Parameters
    /// * `path` - The path to use.
    ///
    /// # Returns
    /// The requested value on success; the error value explains why the operation could not complete.
    pub fn create(path: Str) -> Result<File, DosError> {
        return match OwnedFileHandle::create(path) {
            Result::Ok(file) => Result::Ok(File { file: file }),
            Result::Err(error) => Result::Err(error),
        }
    }

    /// Reads `File`.
    ///
    /// # Parameters
    /// * `buffer` - The buffer; ownership transfers to this call.
    ///
    /// # Returns
    /// The requested value on success; the error value explains why the operation could not complete.
    ///
    /// # Ownership
    /// Arguments marked `consuming` transfer ownership to this call.
    pub fn read(&self, consuming buffer: MutSlice<u8>) -> Result<usize, DosError> {
        if buffer.is_empty() { return Result::Ok(0) }
        let Option::Some(first) = buffer.get_mut(0) else { return Result::Ok(0) }
        return Result::Ok((usize)self.file.read(unsafe { (*u8)first }, buffer.len())?)
    }

    /// Reads all for `File`.
    ///
    /// # Parameters
    /// * `buffer` - The buffer; ownership transfers to this call.
    ///
    /// # Returns
    /// The requested value on success; the error value explains why the operation could not complete.
    ///
    /// # Ownership
    /// Arguments marked `consuming` transfer ownership to this call.
    pub fn read_all(&self, consuming buffer: MutSlice<u8>) -> Result<usize, DosError> {
        if buffer.is_empty() { return Result::Ok(0) }
        let Option::Some(first) = buffer.get_mut(0) else { return Result::Ok(0) }
        return Result::Ok((usize)self.file.read_all(unsafe { (*u8)first }, buffer.len())?)
    }

    /// Writes `File`.
    ///
    /// # Parameters
    /// * `buffer` - The buffer used by the operation.
    ///
    /// # Returns
    /// The requested value on success; the error value explains why the operation could not complete.
    pub fn write(&self, buffer: Slice<u8>) -> Result<usize, DosError> {
        if buffer.is_empty() { return Result::Ok(0) }
        let Option::Some(first) = buffer.get(0) else { return Result::Ok(0) }
        return Result::Ok((usize)self.file.write(unsafe { (*u8)first }, buffer.len())?)
    }

    /// Writes all for `File`.
    ///
    /// # Parameters
    /// * `buffer` - The buffer used by the operation.
    ///
    /// # Returns
    /// `Result::Ok(())` on success; the error value explains why the operation could not complete.
    pub fn write_all(&self, buffer: Slice<u8>) -> Result<(), DosError> {
        if buffer.is_empty() { return Result::Ok(()) }
        let Option::Some(first) = buffer.get(0) else { return Result::Ok(()) }
        return self.file.write_all(unsafe { (*u8)first }, buffer.len())
    }

    /// Writes an entire string at the current file position.
    ///
    /// The string is written as-is without a terminator or hidden allocation.
    ///
    /// # Parameters
    /// * `text` - The text to write.
    ///
    /// # Returns
    /// `Result::Ok(())` only after every byte has been written.
    pub fn write_text(&self, text: Str) -> Result<(), DosError> {
        return self.write_all(text.as_bytes())
    }

    /// Writes an entire string followed by a newline.
    ///
    /// # Parameters
    /// * `text` - The line contents, excluding the newline.
    ///
    /// # Returns
    /// `Result::Ok(())` only after the line and newline have been written.
    pub fn write_line(&self, text: Str) -> Result<(), DosError> {
        self.write_text(text)?
        return self.write_text("\n")
    }

    /// Writes every string as a newline-terminated line.
    ///
    /// # Parameters
    /// * `lines` - The line contents, excluding newline characters.
    ///
    /// # Returns
    /// `Result::Ok(())` only after every line has been written.
    pub fn write_lines(&self, lines: Slice<Str>) -> Result<(), DosError> {
        for index in 0..lines.len() {
            self.write_line(*lines.get(index).unwrap())?
        }
        return Result::Ok(())
    }

    /// Reads all text from the current position through end-of-file.
    ///
    /// The returned string owns its bytes and remains valid after the file closes.
    ///
    /// # Returns
    /// The remaining file contents, or the error that prevented reading them.
    pub fn read_text(&self) -> Result<String, DosError> {
        let start = self.file.seek_from_current(0)?
        let _ = self.file.seek_from_end(0)?
        let end = self.file.seek_from_current(0)?
        let _ = self.file.seek_from_start(start)?
        if end < start { return Result::Err(DosError::SeekError) }

        let length = (usize)(end - start)
        let mut_text = String::with_capacity(length)
        var text = match mut_text {
            Result::Ok(value) => value,
            Result::Err(_) => return Result::Err(DosError::NoFreeStore),
        }
        for _index in 0..length {
            if text.push_byte(0).is_err() { return Result::Err(DosError::NoFreeStore) }
        }
        if length == 0 { return Result::Ok(text) }

        let bytes_read = self.file.read_all(text.as_mut_ptr(), length)?
        text.truncate((usize)bytes_read)
        return Result::Ok(text)
    }

    /// Reads the remaining text as owned lines.
    ///
    /// Line terminators are omitted. Both LF and CRLF input are accepted.
    ///
    /// # Returns
    /// An owned string for each line, or the error that prevented reading it.
    pub fn read_lines(&self) -> Result<Vec<String>, DosError> {
        let text = self.read_text()?
        let source = text.as_str()
        var lines = Vec::<String>::new()
        var start: usize = 0
        for index in 0..source.len() {
            if source.get(index).unwrap() == (u8)'\n' {
                var end = index
                if end > start && source.get(end - 1).unwrap() == (u8)'\r' { end-- }
                let line = String::new_from_str(source.slice(start, end).unwrap())
                let owned = match line {
                    Result::Ok(value) => value,
                    Result::Err(_) => return Result::Err(DosError::NoFreeStore),
                }
                if lines.push(owned).is_err() { return Result::Err(DosError::NoFreeStore) }
                start = index + 1
            }
        }
        if start < source.len() {
            let line = String::new_from_str(source.slice(start, source.len()).unwrap())
            let owned = match line {
                Result::Ok(value) => value,
                Result::Err(_) => return Result::Err(DosError::NoFreeStore),
            }
            if lines.push(owned).is_err() { return Result::Err(DosError::NoFreeStore) }
        }
        return Result::Ok(lines)
    }

    /// Return the file size without changing its current position.
    @suppress("W0002", "successful AmigaDOS Seek positions are non-negative signed LONG values")
    pub fn len(&self) -> Result<usize, DosError> {
        let original = self.file.seek_from_current(0)?
        let _ = self.file.seek_from_end(0)?
        let end = self.file.seek_from_current(0)?
        let _ = self.file.seek_from_start(original)?
        return Result::Ok((usize)end)
    }

    @suppress("W0002", "AmigaDOS seek mode constants are signed LONG values")
    /// Returns the rewind value associated with `File`.
    ///
    /// # Returns
    /// `Result::Ok(())` on success; the error value explains why the operation could not complete.
    pub fn rewind(&self) -> Result<(), DosError> {
        let _ = self.file.seek_from_start(0)?
        return Result::Ok(())
    }

    /// Borrows the system-level value wrapped by `File`.
    ///
    /// # Returns
    /// A shared borrow of `OwnedFileHandle` tied to the receiver.
    pub fn system(&self) -> &OwnedFileHandle { return &self.file }

    /// Wraps an owned system-level value as `File`.
    ///
    /// # Parameters
    /// * `file` - The file; ownership transfers to this call.
    ///
    /// # Returns
    /// The resulting `File` value.
    ///
    /// # Ownership
    /// Arguments marked `consuming` transfer ownership to this call.
    pub fn from_system(consuming file: OwnedFileHandle) -> File {
        return File { file: file }
    }

    /// Consumes `File` and returns its system-level value.
    ///
    /// # Returns
    /// The resulting `OwnedFileHandle` value.
    ///
    /// # Ownership
    /// Arguments marked `consuming` transfer ownership to this call.
    pub fn into_system(consuming self) -> OwnedFileHandle { return self.file }
}
