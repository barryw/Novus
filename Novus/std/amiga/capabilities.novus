from std::core import Error, From, Result
from std::string import Str
from amiga::sys::exec import ExecError, LibraryHandle

/// A system component is absent or older than the requested version.
pub enum CapabilityError {
    Unavailable,
}

impl CapabilityError {
    pub fn message(&self) -> *u8 {
        return "The requested system library is unavailable"
    }
}

impl Error for CapabilityError {
    fn message(&self) -> *u8 { return CapabilityError::message(self) }
}

impl From<ExecError> for CapabilityError {
    fn convert(consuming _error: ExecError) -> CapabilityError {
        return CapabilityError::Unavailable
    }
}

/// An optional AmigaOS library kept open for the lifetime of this value.
/// Dropping it closes the library automatically.
pub struct SystemLibrary {
    handle: LibraryHandle,
}

impl SystemLibrary {
    /// Open a library only when the application chooses to use that feature.
    pub fn open(name: Str, minimum_version: u32) -> Result<SystemLibrary, CapabilityError> {
        return Result::Ok(SystemLibrary {
            handle: LibraryHandle::open(name, minimum_version)?,
        })
    }

    pub fn version(&self) -> u16 { return self.handle.installed_version() }
    pub fn revision(&self) -> u16 { return self.handle.installed_revision() }

    /// Drop to Tier 2 without surrendering ownership of the open library.
    pub fn system(&self) -> &LibraryHandle { return &self.handle }
}

/// Test a feature dependency without leaking an open library.
pub fn library_available(name: Str, minimum_version: u32) -> bool {
    return match SystemLibrary::open(name, minimum_version) {
        Result::Ok(_) => true,
        Result::Err(_) => false,
    }
}
