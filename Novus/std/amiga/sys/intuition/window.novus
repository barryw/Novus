// Novus Standard Library - Intuition (High-Level)
// Namespace: amiga::sys::intuition
//
// High-level wrappers for intuition.library functions
// For low-level FFI access, use amiga::raw::intuition

from std::core import Option, Result, Drop
from amiga::sys::intuition::errors import IntuitionError
from amiga::sys::utility import make_tags
from std::string import Str
from std::string::format import Display, Formatter
from std::memory import Slice
from amiga::raw::structs import TagItem, Window, Screen, NewWindow, NewScreen, IntuiMessage, Message, MsgPort, RastPort
from amiga::raw::intuition import OpenWindowTagList, OpenScreenTagList, CloseWindow, CloseScreen, BeginRefresh, EndRefresh, MoveWindow, SizeWindow, ChangeWindowBox, WindowLimits, ZipWindow, WindowToFront, WindowToBack, MoveWindowInFrontOf, ModifyIDCMP, SetWindowTitles, ActivateWindow, RefreshWindowFrame, SetMouseQueue, ClearMenuStrip
from amiga::raw::consts import TAG_DONE, IDCMP_*, WA_*, WFLG_*, FALSE, NULL
from amiga::raw::exec import GetMsg, ReplyMsg, WaitPort

// ============================================================================
// Window Event Types
// ============================================================================

/// RAII guard for window refresh operations
///
/// This type ensures BeginRefresh and EndRefresh are properly balanced.
/// BeginRefresh is called when the guard is created, and EndRefresh is
/// automatically called when the guard is dropped (goes out of scope).
///
/// This prevents Intuition's internal state from getting corrupted if
/// EndRefresh is forgotten.
///
/// # Example
/// ```
/// match event {
///     WindowEvent::Refresh(guard) => {
///         // BeginRefresh already called
///         draw_my_content(guard.window())
///         // EndRefresh automatically called when guard drops
///     }
/// }
/// ```
pub struct RefreshGuard {
    /// The window value stored by `RefreshGuard`.
    window: *Window,
}

impl RefreshGuard {
    /// Create a new refresh guard and call BeginRefresh
    ///
    /// INTERNAL: This should only be called by parse_intui_message
    fn new(win: *Window) -> RefreshGuard {
        unsafe { BeginRefresh(win) }
        return RefreshGuard { window: win }
    }

    /// Get the window pointer for custom rendering
    pub fn window(&self) -> &Window {
        return unsafe { &*self.window }
    }
}

impl Drop for RefreshGuard {
    /// Automatically call EndRefresh when guard goes out of scope
    fn drop(&var self) {
        unsafe { EndRefresh(self.window, 1) }
    }
}

/// Typed window event enum - wraps IntuiMessage with safe field extraction
///
/// This enum provides type-safe pattern matching over Intuition IDCMP events.
/// Each variant extracts the relevant fields from the underlying IntuiMessage.
pub enum WindowEvent {
    /// User clicked close gadget or requested window close
    Close,

    /// Window was resized - provides new dimensions (width, height)
    Resize(i16, i16),

    /// Window needs refresh/redraw
    ///
    /// The RefreshGuard automatically handles BeginRefresh/EndRefresh.
    /// Use guard.window() to access the window pointer for custom rendering.
    Refresh(RefreshGuard),

    /// Mouse moved within window (x, y)
    MouseMove(i16, i16),

    /// Mouse button pressed or released (x, y, pressed)
    MouseButton(i16, i16, bool),

    /// Raw keyboard event (code, qualifier)
    RawKey(u16, u16),

    /// Vanilla key (char, qualifier)
    VanillaKey(u16, u16),

    /// Window became active (has focus)
    Activated,

    /// Window became inactive (lost focus)
    Deactivated,

    /// Menu item selected (code)
    MenuPick(u16),

    /// Gadget released (gadget_id)
    GadgetUp(u32),

    /// Gadget pressed down (gadget_id)
    GadgetDown(u32),

    /// Unknown/unhandled IDCMP event (class code)
    Unknown(u32),
}

impl Display for WindowEvent {
    fn fmt(&self, f: &var Formatter) -> bool {
        match *self {
            WindowEvent::Close => {
                return f.write_str("Close")
            },
            WindowEvent::Resize(_, _) => {
                return f.write_str("Resize")
            },
            WindowEvent::Refresh(_) => {
                return f.write_str("Refresh")
            },
            WindowEvent::MouseMove(_, _) => {
                return f.write_str("MouseMove")
            },
            WindowEvent::MouseButton(_, _, _) => {
                return f.write_str("MouseButton")
            },
            WindowEvent::RawKey(_, _) => {
                return f.write_str("RawKey")
            },
            WindowEvent::VanillaKey(_, _) => {
                return f.write_str("VanillaKey")
            },
            WindowEvent::Activated => {
                return f.write_str("Activated")
            },
            WindowEvent::Deactivated => {
                return f.write_str("Deactivated")
            },
            WindowEvent::MenuPick(_) => {
                return f.write_str("MenuPick")
            },
            WindowEvent::GadgetUp(_) => {
                return f.write_str("GadgetUp")
            },
            WindowEvent::GadgetDown(_) => {
                return f.write_str("GadgetDown")
            },
            WindowEvent::Unknown(_) => {
                return f.write_str("Unknown")
            }
        }
    }
}

// ============================================================================
// Window Management
// ============================================================================

/// Open an Intuition window with tag-based parameters
///
/// This is a simple wrapper around OpenWindowTagList that provides:
/// - Type-safe Result return (instead of nullable pointer)
///
/// The tag array MUST include TAG_DONE as the last element.
///
/// Example:
/// ```novus
/// from amiga::sys::intuition import open_window
/// from amiga::raw::intuition import WA_Width, WA_Height, WA_Title, WA_Flags, WFLG_CLOSEGADGET, CloseWindow, TAG_DONE
/// from amiga::raw::structs import TagItem
///
/// let input_tags = [
///     TagItem { ti_Tag: WA_Width, ti_Data: 640 },
///     TagItem { ti_Tag: WA_Height, ti_Data: 480 },
///     TagItem { ti_Tag: WA_Title, ti_Data: (u32)"My Application".ptr },
///     TagItem { ti_Tag: WA_Flags, ti_Data: WFLG_CLOSEGADGET },
///     TagItem { ti_Tag: TAG_DONE, ti_Data: 0 }
/// ]
/// let window = open_window(&input_tags[0])?
/// defer {
///     CloseWindow(window)
/// }
/// ```
pub fn open_window(tags_ptr: *TagItem) -> Result<*Window, IntuitionError> {
    let window = OpenWindowTagList(null, tags_ptr)

    // Check if window opened successfully (null check)
    if let win = window {
        return Result::Ok(win)
    }

    return Result::Err(IntuitionError::WindowOpenFailed)
}

/// Open an Intuition screen with tag-based parameters
///
/// This is a simple wrapper around OpenScreenTagList.
///
/// The tag array MUST include TAG_DONE as the last element.
///
/// Example:
/// ```novus
/// from amiga::sys::intuition import open_screen
/// from amiga::raw::intuition import SA_Width, SA_Height, SA_Depth, SA_Title, CloseScreen, TAG_DONE
/// from amiga::raw::structs import TagItem
///
/// let input_tags = [
///     TagItem { ti_Tag: SA_Width, ti_Data: 640 },
///     TagItem { ti_Tag: SA_Height, ti_Data: 480 },
///     TagItem { ti_Tag: SA_Depth, ti_Data: 8 },
///     TagItem { ti_Tag: SA_Title, ti_Data: (u32)"My Screen".ptr },
///     TagItem { ti_Tag: TAG_DONE, ti_Data: 0 }
/// ]
/// let screen = open_screen(&input_tags[0])?
/// defer {
///     CloseScreen(screen)
/// }
/// ```
pub fn open_screen(tags_ptr: *TagItem) -> Result<*Screen, IntuitionError> {
    let screen = OpenScreenTagList(null, tags_ptr)

    // Check if screen opened successfully (null check)
    if let scr = screen {
        return Result::Ok(scr)
    }

    return Result::Err(IntuitionError::ScreenOpenFailed)
}

// ============================================================================
// WindowHandle RAII Wrapper
// ============================================================================

/// RAII wrapper for Intuition windows with automatic cleanup
///
/// WindowHandle provides:
/// - Automatic message draining and window closing on drop (RAII)
/// - Safe field accessors without unsafe blocks
/// - Type-safe event handling via WindowEvent enum
/// - Callback-based event loop
///
/// Example:
/// ```novus
/// let window = WindowHandle::simple("My App", 320, 200)?
/// window.run_event_loop(|event| {
///     match event {
///         WindowEvent::Close => false,  // Stop loop
///         _ => true  // Continue
///     }
/// })
/// ```
/// Owner-tied systems view used when an application window steps down one layer.
pub struct WindowRef {
    /// The window value stored by `WindowRef`.
    window: &Window
}

impl WindowRef {
    /// Computes borrow for `WindowRef` from the supplied inputs.
    ///
    /// # Parameters
    /// * `window` - The `&Window` value used as window.
    ///
    /// # Returns
    /// The resulting `WindowRef` value.
    pub fn borrow(window: &Window) -> WindowRef {
        return WindowRef { window: window }
    }

    @unsafe
    /// Returns the raw representation wrapped by `WindowRef` without transferring ownership.
    ///
    /// # Returns
    /// The resulting `*Window` value.
    pub fn as_raw(&self) -> *Window {
        return unsafe { (*Window)self.window }
    }
}

/// Owns a window handle and releases its resources when dropped.
pub struct WindowHandle {
    /// The window value stored by `WindowHandle`.
    window: *Window,  // Pointer to FFI Window struct (null = invalid)
}

impl WindowHandle {
    /// Open a window with the given tag array
    ///
    /// Returns Err if window fails to open.
    /// The tag array must include TAG_DONE as the last element.
    ///
    /// Automatically coerces array references (&[TagItem; N]) to Slice<TagItem>.
    ///
    /// Example:
    /// ```novus
    /// let tags = [..., TagItem { ti_Tag: TAG_DONE, ti_Data: 0 }]
    /// let window = WindowHandle::open(&tags)?
    /// ```
    pub fn open(tags: Slice<TagItem>) -> Result<WindowHandle, IntuitionError> {
        let window = OpenWindowTagList(null, tags.ptr)

        // Check if window opened successfully
        if let win = window {
            return Result::Ok(WindowHandle { window: win })
        }

        return Result::Err(IntuitionError::WindowOpenFailed)
    }

    /// Create WindowHandle from raw pointer (takes ownership)
    ///
    /// The window will be automatically cleaned up when the WindowHandle is dropped.
    /// All pending IDCMP messages will be drained and replied.
    ///
    /// Only use this if you own the window and it should be closed.
    /// DO NOT use for system-owned windows.
    pub fn from_raw(window: *Window) -> Result<WindowHandle, IntuitionError> {
        return Result::Err(IntuitionError::InvalidWindow) unless window
        return Result::Ok(WindowHandle { window: window })
    }

    /// Extract raw pointer and prevent automatic cleanup
    ///
    /// This transfers ownership to the caller. The caller is responsible
    /// for draining messages and closing the window manually.
    pub fn into_raw(consuming self) -> *Window {
        let window = self.window
        self.window = null
        return window
    }

    /// Get the raw Window pointer for FFI calls
    pub fn as_raw(&self) -> *Window {
        return self.window
    }

    /// Get the UserPort for this window (safe accessor)
    pub fn user_port(&self) -> *MsgPort {
        unsafe {
            return (*self.window).UserPort
        }
    }

    /// Get the screen this window is displayed on
    pub fn get_screen(&self) -> *Screen {
        unsafe {
            return (*self.window).WScreen
        }
    }

    /// Get window width
    pub fn width(&self) -> i16 {
        unsafe {
            return (*self.window).Width
        }
    }

    /// Get window height
    pub fn height(&self) -> i16 {
        unsafe {
            return (*self.window).Height
        }
    }

    /// Get the window's RastPort for drawing operations
    pub fn rastport(&self) -> &RastPort {
        unsafe {
            let rp_ptr = (*self.window).RPort
            return &(*rp_ptr)
        }
    }

    /// Wait for and return the next event (blocking)
    ///
    /// This method blocks until an event arrives, then returns it.
    /// Use this in a loop to process all window events.
    pub fn wait_event(&self) -> WindowEvent {
        let user_port = self.user_port()

        // Wait for a message to arrive (blocks)
        WaitPort(user_port)

        // Get the message
        let msg = GetMsg(user_port)

        // Extract event and reply to message (unsafe pointer operations)
        unsafe {
            // Cast Message to IntuiMessage and extract event
            let imsg: *IntuiMessage = (*IntuiMessage)msg
            let event = parse_intui_message(imsg, self.window)

            // CRITICAL: Reply BEFORE processing to avoid deadlocks
            ReplyMsg(msg)

            return event
        }
    }

    /// Poll for a single event (non-blocking)
    ///
    /// Returns None if no messages are waiting.
    /// Returns Some(event) if a message was received.
    pub fn poll_event(&self) -> Option<WindowEvent> {
        let user_port = self.user_port()
        let msg = GetMsg(user_port)

        if !msg {
            return Option::None
        }

        // Extract event and reply to message (unsafe pointer operations)
        unsafe {
            // Cast Message to IntuiMessage and extract event
            let imsg: *IntuiMessage = (*IntuiMessage)msg
            let event = parse_intui_message(imsg, self.window)

            // CRITICAL: Reply BEFORE processing to avoid deadlocks
            ReplyMsg(msg)

            return Option::Some(event)
        }
    }

    /// Create a simple window with standard gadgets
    ///
    /// Opens a window with:
    /// - Close, drag, and depth gadgets
    /// - IDCMP for close events
    /// - Centered position (50, 50)
    ///
    /// Example:
    /// ```novus
    /// let window = WindowHandle::simple("My App", 320, 200)?
    /// ```
    @suppress("W0002", "We're casting from i16 to u32 for tag data")
    pub fn simple(title: Str, width: i16, height: i16) -> Result<WindowHandle, IntuitionError> {
        let flags = WFLG_CLOSEGADGET | WFLG_DRAGBAR | WFLG_DEPTHGADGET | WFLG_SIZEGADGET | WFLG_SIZEBRIGHT | WFLG_SIZEBBOTTOM
        // IDCMP_REFRESHWINDOW is safe with RefreshGuard RAII pattern that ensures BeginRefresh/EndRefresh are balanced
        let idcmp = IDCMP_CLOSEWINDOW | IDCMP_DELTAMOVE | IDCMP_NEWSIZE | IDCMP_REFRESHWINDOW | IDCMP_MOUSEMOVE | IDCMP_MOUSEBUTTONS | IDCMP_RAWKEY | IDCMP_VANILLAKEY | IDCMP_MENUPICK

        let tags = [
            TagItem { ti_Tag: WA_Left, ti_Data: 50 },
            TagItem { ti_Tag: WA_Top, ti_Data: 50 },
            TagItem { ti_Tag: WA_Width, ti_Data: (u32)width },
            TagItem { ti_Tag: WA_Height, ti_Data: (u32)height },
            TagItem { ti_Tag: WA_MinWidth, ti_Data: 100 },
            TagItem { ti_Tag: WA_MinHeight, ti_Data: 100 },
            TagItem { ti_Tag: WA_MaxWidth, ti_Data: WA_SIZE_UNLIMITED },
            TagItem { ti_Tag: WA_MaxHeight, ti_Data: WA_SIZE_UNLIMITED },
            TagItem { ti_Tag: WA_Title, ti_Data: (u32)title.as_ptr() },
            TagItem { ti_Tag: WA_Flags, ti_Data: flags },
            TagItem { ti_Tag: WA_IDCMP, ti_Data: idcmp },
            TagItem { ti_Tag: TAG_DONE, ti_Data: 0 }
        ]

        return WindowHandle::open(&tags)
    }

    /// Create a full-featured application window
    ///
    /// Opens a window with:
    /// - Close, drag, depth, and size gadgets
    /// - IDCMP for close, resize, and refresh events
    /// - Centered position (50, 50)
    ///
    /// Example:
    /// ```novus
    /// let window = WindowHandle::app_window("My Application", 640, 480)?
    /// ```
    @suppress("W0002", "We're casting from i16 to u32 for tag data")
    pub fn app_window(title: &Str, width: i16, height: i16) -> Result<WindowHandle, IntuitionError> {
        let flags = WFLG_CLOSEGADGET | WFLG_DRAGBAR | WFLG_DEPTHGADGET | WFLG_SIZEGADGET | WFLG_SIZEBRIGHT | WFLG_SIZEBBOTTOM
        // Now includes IDCMP_REFRESHWINDOW - safe with RefreshGuard RAII pattern
        let idcmp = IDCMP_CLOSEWINDOW | IDCMP_NEWSIZE | IDCMP_REFRESHWINDOW

        let tags = [
            TagItem { ti_Tag: WA_Left, ti_Data: 50 },
            TagItem { ti_Tag: WA_Top, ti_Data: 50 },
            TagItem { ti_Tag: WA_Width, ti_Data: (u32)width },
            TagItem { ti_Tag: WA_Height, ti_Data: (u32)height },
            TagItem { ti_Tag: WA_MinWidth, ti_Data: 100 },
            TagItem { ti_Tag: WA_MinHeight, ti_Data: 100 },
            TagItem { ti_Tag: WA_MaxWidth, ti_Data: WA_SIZE_UNLIMITED },
            TagItem { ti_Tag: WA_MaxHeight, ti_Data: WA_SIZE_UNLIMITED },
            TagItem { ti_Tag: WA_Title, ti_Data: (u32)title.as_ptr() },
            TagItem { ti_Tag: WA_Flags, ti_Data: flags },
            TagItem { ti_Tag: WA_IDCMP, ti_Data: idcmp },
            TagItem { ti_Tag: TAG_DONE, ti_Data: 0 }
        ]

        return WindowHandle::open(&tags)
    }

    /// Create a borderless window
    ///
    /// Opens a window with:
    /// - No borders or gadgets
    /// - IDCMP for close events only
    /// - Top-left position (0, 0)
    ///
    /// Useful for custom UI or fullscreen effects.
    ///
    /// Example:
    /// ```novus
    /// let window = WindowHandle::borderless(640, 256)?
    /// ```
    @suppress("W0002", "We're casting from i16 to u32 for tag data")
    pub fn borderless(width: i16, height: i16) -> Result<WindowHandle, IntuitionError> {
        let flags = WFLG_BORDERLESS | WFLG_ACTIVATE
        let idcmp = IDCMP_CLOSEWINDOW

        let tags = [
            TagItem { ti_Tag: WA_Left, ti_Data: 0 },
            TagItem { ti_Tag: WA_Top, ti_Data: 0 },
            TagItem { ti_Tag: WA_Width, ti_Data: (u32)width },
            TagItem { ti_Tag: WA_Height, ti_Data: (u32)height },
            TagItem { ti_Tag: WA_Flags, ti_Data: flags },
            TagItem { ti_Tag: WA_IDCMP, ti_Data: idcmp },
            TagItem { ti_Tag: TAG_DONE, ti_Data: 0 }
        ]

        return WindowHandle::open(&tags)
    }

    /// Drain and reply to all pending IDCMP messages
    ///
    /// This is called automatically by Drop, but can be called manually
    /// if you need to drain messages before the window is closed.
    pub fn drain_messages(&self) {
        let user_port = self.user_port()

        forever {
            let msg = GetMsg(user_port)
            if !msg {
                break
            }
            ReplyMsg(msg)
        }
    }

    // ========================================================================
    // Window Modification Methods
    // ========================================================================

    // Phase 1: Essential Operations
    // ----------------------------------------------------------------------

    /// Set window title and/or screen title
    ///
    /// Pass Some(title) to set a title, None to leave it unchanged.
    ///
    /// SAFETY WARNING: Intuition stores the title string pointer without
    /// copying. The title strings MUST remain valid for the window's lifetime!
    /// Use static string literals or strings stored in long-lived structures.
    ///
    /// Example:
    /// ```novus
    /// let new_title: Option<*u8> = Option::Some("My App - Processing...")
    /// let no_change: Option<*u8> = Option::None
    /// window.set_titles(new_title, no_change)
    /// ```
    pub fn set_titles(&self, window_title: Option<*u8>, screen_title: Option<*u8>) {
        unsafe {
            // Extract the actual pointers, using a special marker for "unchanged"
            // We use address -1 (0xFFFFFFFF) to indicate unchanged per NDK docs
            var wtitle: *u8 = (*u8)(-1)
            match window_title {
                Option::Some(s) => { wtitle = s },
                Option::None => {}
            }

            var stitle: *u8 = (*u8)(-1)
            match screen_title {
                Option::Some(s) => { stitle = s },
                Option::None => {}
            }

            SetWindowTitles(self.window, wtitle, stitle)
        }
    }

    /// Bring window to front of display
    ///
    /// Makes the window the frontmost window on the screen.
    /// Intuition applies the change on a later input tick.
    ///
    /// Example:
    /// ```novus
    /// window.to_front()
    /// ```
    pub fn to_front(&self) {
        unsafe { WindowToFront(self.window) }
    }

    /// Send window to back of display
    ///
    /// Moves the window behind all other windows on the screen.
    /// Intuition applies the change on a later input tick.
    ///
    /// Example:
    /// ```novus
    /// window.to_back()
    /// ```
    pub fn to_back(&self) {
        unsafe { WindowToBack(self.window) }
    }

    /// Programmatically activate window (give input focus)
    ///
    /// Triggers IDCMP_ACTIVEWINDOW event.
    /// Intuition applies the change on a later input tick.
    ///
    /// Example:
    /// ```novus
    /// window.activate()
    /// ```
    pub fn activate(&self) {
        unsafe { ActivateWindow(self.window) }
    }

    /// Change which IDCMP events this window receives
    ///
    /// Allows dynamic subscription to different event types.
    /// Drains and replies to pending messages before changing flags.
    ///
    /// Returns Err if out of memory.
    ///
    /// Example:
    /// ```novus
    /// let new_flags = IDCMP_CLOSEWINDOW | IDCMP_NEWSIZE | IDCMP_REFRESHWINDOW
    /// window.modify_idcmp(new_flags)?
    /// ```
    pub fn modify_idcmp(&self, flags: u32) -> Result<(), IntuitionError> {
        unsafe {
            let result = ModifyIDCMP(self.window, flags)
            // ModifyIDCMP returns TRUE on success, FALSE on failure
            if (result != FALSE) {
                return Result::Ok(())
            }
            return Result::Err(IntuitionError::ModifyIDCMPFailed)
        }
    }

    // Phase 2: Sizing & Positioning
    // ----------------------------------------------------------------------

    /// Move window by relative offset
    ///
    /// Moves the window dx pixels horizontally and dy pixels vertically
    /// from its current position. Negative values move left/up.
    /// Intuition applies the change on a later input tick.
    ///
    /// Example:
    /// ```novus
    /// window.move_by(10, -5)  // Move 10 pixels right, 5 pixels up
    /// ```
    pub fn move_by(&self, dx: i16, dy: i16) {
        unsafe { MoveWindow(self.window, dx, dy) }
    }

    /// Resize window by relative offset
    ///
    /// Changes window size by dx pixels horizontally and dy pixels vertically.
    /// Negative values shrink the window. Size is constrained by WindowLimits.
    ///
    /// Triggers IDCMP_NEWSIZE event. Listen for this event to get actual dimensions
    /// as the requested size may be adjusted to fit constraints.
    /// Intuition applies the change on a later input tick.
    ///
    /// Example:
    /// ```novus
    /// window.resize_by(20, 10)  // Grow by 20x10 pixels
    /// ```
    pub fn resize_by(&self, dx: i16, dy: i16) {
        unsafe { SizeWindow(self.window, dx, dy) }
    }

    /// Set absolute position and size
    ///
    /// Sets window position and size in one operation, which is more efficient
    /// than separate move + resize calls. Size is constrained by WindowLimits.
    /// Intuition applies the change on a later input tick.
    ///
    /// Triggers IDCMP_NEWSIZE event if size changes.
    ///
    /// Example:
    /// ```novus
    /// window.set_bounds(100, 50, 640, 480)  // Position at (100,50), size 640x480
    /// ```
    pub fn set_bounds(&self, left: i16, top: i16, width: i16, height: i16) {
        unsafe { ChangeWindowBox(self.window, left, top, width, height) }
    }

    /// Set minimum and maximum size constraints
    ///
    /// Constrains window sizing operations. Use WA_SIZE_UNLIMITED (0xFFFFFFFF)
    /// for unbounded constraints.
    ///
    /// Returns true when every requested limit is valid and accepted.
    /// An invalid limit is ignored and makes this return false; valid limits
    /// from the same call still take effect.
    ///
    /// Example:
    /// ```novus
    /// // Set minimum 320x200, maximum 1024x768
    /// let accepted = window.set_limits(320, 200, 1024, 768)
    /// ```
    pub fn set_limits(&self, min_width: i32, min_height: i32, max_width: u32, max_height: u32) -> bool {
        unsafe {
            return WindowLimits(self.window, min_width, min_height, max_width, max_height) != 0
        }
    }

    // Phase 3: Advanced Operations
    // ----------------------------------------------------------------------

    /// Toggle between current size and alternate zoom size
    ///
    /// Zooms the window between its current size and an alternate size
    /// (determined by the window's Zoom field). Commonly used for maximize/restore.
    /// Intuition applies the change on a later input tick.
    ///
    /// Example:
    /// ```novus
    /// window.zoom()  // Toggle maximize/restore
    /// ```
    pub fn zoom(&self) {
        unsafe { ZipWindow(self.window) }
    }

    /// Position window immediately in front of another window
    ///
    /// More precise than to_front() - places this window directly in front
    /// of the specified window in the depth arrangement.
    /// Intuition may apply the visible layer change on a later input tick.
    ///
    /// Example:
    /// ```novus
    /// window1.move_in_front_of(&window2)  // window1 goes in front of window2
    /// ```
    pub fn move_in_front_of(&self, other: &WindowHandle) {
        unsafe { MoveWindowInFrontOf(self.window, other.window) }
    }

    /// Refresh window borders and gadgets
    ///
    /// Redraws the window frame. Call this after direct rendering operations
    /// to the window's layer to ensure borders and gadgets are properly displayed.
    ///
    /// Example:
    /// ```novus
    /// // After custom rendering to window layer
    /// window.refresh_frame()
    /// ```
    pub fn refresh_frame(&self) {
        unsafe { RefreshWindowFrame(self.window) }
    }

    /// Set mouse event queue size
    ///
    /// Changes the size of the mouse event queue. Larger queues help prevent
    /// mouse event loss during heavy processing. Useful for games and drawing programs.
    ///
    /// Returns the old queue length.
    ///
    /// Example:
    /// ```novus
    /// let old_size = window.set_mouse_queue(20)  // Increase queue to 20 events
    /// ```
    pub fn set_mouse_queue(&self, queue_length: u16) -> i32 {
        unsafe {
            return SetMouseQueue(self.window, queue_length)
        }
    }
}

// Automatic cleanup for WindowHandle (RAII)
impl Drop for WindowHandle {
    fn drop(&var self) {
        if let w = self.window {
            // CRITICAL: Drain and reply to all pending IDCMP messages
            // before closing the window. Unreplied messages cause
            // system hangs and crashes.
            unsafe {
                let user_port = (*w).UserPort
                // Only drain messages if window has a UserPort (IDCMP was set)
                if let port = user_port {
                    forever {
                        let msg = GetMsg(port)
                        if !msg {
                            break
                        }
                        ReplyMsg(msg)
                    }
                }

                // Clear menu strip if present (required by NDK before closing window)
                // See: http://amigadev.elowar.com/read/ADCD_2.1/Includes_and_Autodocs_3._guide/node03F2.html
                if let menu_strip = (*w).MenuStrip {
                    ClearMenuStrip(w)
                }
                CloseWindow(w)
            }

            self.window = null
        }
    }
}

/// Parse IntuiMessage into typed WindowEvent
///
/// This is an internal helper that extracts relevant fields from
/// the IntuiMessage based on the IDCMP class.
///
/// OPTIMIZATION: Only extract fields that are needed for each event type.
/// This avoids unnecessary memory reads on 68k where every access counts.
fn parse_intui_message(msg: *IntuiMessage, owner: *Window) -> WindowEvent {
    // Always need the class to determine event type
    let class = unsafe { (*msg).Class }

    // Match on class and only extract fields needed for each case
    return match class {
        IDCMP_CLOSEWINDOW => {
            WindowEvent::Close
        },
        IDCMP_NEWSIZE => {
            // Only need IDCMPWindow for resize dimensions
            unsafe {
                let win = (*msg).IDCMPWindow
                WindowEvent::Resize((*win).Width, (*win).Height)
            }
        },
        IDCMP_REFRESHWINDOW => {
            let guard = RefreshGuard::new(owner)
            WindowEvent::Refresh(guard)
        },
        IDCMP_MOUSEMOVE => {
            // Only need mouse coordinates
            unsafe {
                WindowEvent::MouseMove((*msg).MouseX, (*msg).MouseY)
            }
        },
        IDCMP_MOUSEBUTTONS => {
            // Need code and mouse coordinates
            unsafe {
                let code = (*msg).Code
                let pressed = (code & $80) == 0
                WindowEvent::MouseButton((*msg).MouseX, (*msg).MouseY, pressed)
            }
        },
        IDCMP_RAWKEY => {
            // Need code and qualifier
            unsafe {
                WindowEvent::RawKey((*msg).Code, (*msg).Qualifier)
            }
        },
        IDCMP_VANILLAKEY => {
            // Need code and qualifier
            unsafe {
                WindowEvent::VanillaKey((*msg).Code, (*msg).Qualifier)
            }
        },
        IDCMP_ACTIVEWINDOW => {
            WindowEvent::Activated
        },
        IDCMP_INACTIVEWINDOW => {
            WindowEvent::Deactivated
        },
        IDCMP_MENUPICK => {
            // Only need code
            unsafe {
                WindowEvent::MenuPick((*msg).Code)
            }
        },
        IDCMP_GADGETUP => {
            // Only need IAddress
            unsafe {
                WindowEvent::GadgetUp((u32)(*msg).IAddress)
            }
        },
        IDCMP_GADGETDOWN => {
            // Only need IAddress
            unsafe {
                WindowEvent::GadgetDown((u32)(*msg).IAddress)
            }
        },
        _ => {
            // Unknown/unhandled IDCMP event (including DELTAMOVE)
            WindowEvent::Unknown(class)
        }
    }
}

// ============================================================================
// WindowBuilder - Fluent API for window creation
// ============================================================================

/// Builder for creating windows with a fluent API
///
/// This provides a more ergonomic way to create windows than raw TagItem arrays.
///
/// # Example
/// ```novus
/// let window = WindowBuilder::new()
///     .title("My Window")
///     .position(50, 50)
///     .size(300, 200)
///     .close_gadget(true)
///     .drag_bar(true)
///     .depth_gadget(true)
///     .build()?
/// ```
pub struct WindowBuilder {
    /// The left value stored by `WindowBuilder`.
    left: i16,
    /// The top value stored by `WindowBuilder`.
    top: i16,
    /// The width value stored by `WindowBuilder`.
    width: i16,
    /// The height value stored by `WindowBuilder`.
    height: i16,
    /// The min width value stored by `WindowBuilder`.
    min_width: i16,
    /// The min height value stored by `WindowBuilder`.
    min_height: i16,
    /// The max width value stored by `WindowBuilder`.
    max_width: i16,
    /// The max height value stored by `WindowBuilder`.
    max_height: i16,
    /// The title ptr value stored by `WindowBuilder`.
    title_ptr: *u8,
    /// The screen ptr value stored by `WindowBuilder`.
    screen_ptr: *Screen,
    /// The flags value stored by `WindowBuilder`.
    flags: u32,
    /// The idcmp value stored by `WindowBuilder`.
    idcmp: u32,
    /// The borderless value stored by `WindowBuilder`.
    borderless: bool,
    /// The backdrop value stored by `WindowBuilder`.
    backdrop: bool,
    /// The activate value stored by `WindowBuilder`.
    activate: bool,
}

fn update_flag(bits: u32, flag: u32, enabled: bool) -> u32 {
    if enabled { return bits | flag }
    return bits & (flag ^ $FFFFFFFF)
}

impl WindowBuilder {
    /// Create a new window builder with default settings
    ///
    /// Defaults:
    /// - Position: 0, 0
    /// - Size: 200x100
    /// - Min size: 50x20
    /// - Max size: unlimited (0 = no limit)
    /// - Title: none
    /// - Screen: Workbench (null)
    /// - Flags: none
    /// - IDCMP: CLOSEWINDOW
    /// - Activate: true
    pub fn new() -> WindowBuilder {
        return WindowBuilder {
            left: 0,
            top: 0,
            width: 200,
            height: 100,
            min_width: 50,
            min_height: 20,
            max_width: 0,
            max_height: 0,
            title_ptr: null,
            screen_ptr: null,
            flags: 0,
            idcmp: IDCMP_CLOSEWINDOW,
            borderless: false,
            backdrop: false,
            activate: true,
        }
    }

    /// Set the window title
    ///
    /// NOTE: The title string must remain valid for the lifetime of the window.
    /// Use string literals or long-lived String allocations.
    pub fn title(consuming self, t: Str) -> WindowBuilder {
        self.title_ptr = t.ptr
        return self
    }

    /// Set window position
    pub fn position(consuming self, x: i16, y: i16) -> WindowBuilder {
        self.left = x
        self.top = y
        return self
    }

    /// Set window size
    pub fn size(consuming self, w: i16, h: i16) -> WindowBuilder {
        self.width = w
        self.height = h
        return self
    }

    /// Set minimum window size
    pub fn min_size(consuming self, w: i16, h: i16) -> WindowBuilder {
        self.min_width = w
        self.min_height = h
        return self
    }

    /// Set maximum window size
    pub fn max_size(consuming self, w: i16, h: i16) -> WindowBuilder {
        self.max_width = w
        self.max_height = h
        return self
    }

    /// Open window on a specific screen
    ///
    /// Pass a ScreenHandle's handle() method result to open on a custom screen.
    /// If not set, window opens on Workbench.
    pub fn screen(consuming self, s: *Screen) -> WindowBuilder {
        self.screen_ptr = s
        return self
    }

    /// Add close gadget (X button)
    pub fn close_gadget(consuming self, enabled: bool) -> WindowBuilder {
        self.flags = update_flag(self.flags, WFLG_CLOSEGADGET, enabled)
        return self
    }

    /// Add drag bar for moving window
    pub fn drag_bar(consuming self, enabled: bool) -> WindowBuilder {
        self.flags = update_flag(self.flags, WFLG_DRAGBAR, enabled)
        return self
    }

    /// Add depth gadget for screen-to-front/back
    pub fn depth_gadget(consuming self, enabled: bool) -> WindowBuilder {
        self.flags = update_flag(self.flags, WFLG_DEPTHGADGET, enabled)
        return self
    }

    /// Add size gadget for resizing
    pub fn size_gadget(consuming self, enabled: bool) -> WindowBuilder {
        self.flags = update_flag(self.flags, WFLG_SIZEGADGET | WFLG_SIZEBRIGHT | WFLG_SIZEBBOTTOM, enabled)
        return self
    }

    /// Make window borderless
    pub fn borderless(consuming self, enabled: bool) -> WindowBuilder {
        self.borderless = enabled
        return self
    }

    /// Make window a backdrop (behind all other windows)
    pub fn backdrop(consuming self, enabled: bool) -> WindowBuilder {
        self.backdrop = enabled
        return self
    }

    /// Activate window on open
    pub fn activate(consuming self, enabled: bool) -> WindowBuilder {
        self.activate = enabled
        return self
    }

    /// Enable mouse move events
    pub fn mouse_move(consuming self, enabled: bool) -> WindowBuilder {
        self.idcmp = update_flag(self.idcmp, IDCMP_MOUSEMOVE, enabled)
        return self
    }

    /// Enable mouse button events
    pub fn mouse_buttons(consuming self, enabled: bool) -> WindowBuilder {
        self.idcmp = update_flag(self.idcmp, IDCMP_MOUSEBUTTONS, enabled)
        return self
    }

    /// Enable raw key events
    pub fn raw_keys(consuming self, enabled: bool) -> WindowBuilder {
        self.idcmp = update_flag(self.idcmp, IDCMP_RAWKEY, enabled)
        return self
    }

    /// Enable vanilla key events (translated keypresses)
    pub fn vanilla_keys(consuming self, enabled: bool) -> WindowBuilder {
        self.idcmp = update_flag(self.idcmp, IDCMP_VANILLAKEY, enabled)
        return self
    }

    /// Enable resize events
    pub fn resize_events(consuming self, enabled: bool) -> WindowBuilder {
        self.idcmp = update_flag(self.idcmp, IDCMP_NEWSIZE, enabled)
        return self
    }

    /// Enable refresh events (for GIMMEZEROZERO windows)
    pub fn refresh_events(consuming self, enabled: bool) -> WindowBuilder {
        self.idcmp = update_flag(self.idcmp, IDCMP_REFRESHWINDOW, enabled)
        return self
    }

    /// Enable menu pick events
    pub fn menu_events(consuming self, enabled: bool) -> WindowBuilder {
        self.idcmp = update_flag(self.idcmp, IDCMP_MENUPICK, enabled)
        return self
    }

    /// Enable gadget events
    pub fn gadget_events(consuming self, enabled: bool) -> WindowBuilder {
        self.idcmp = update_flag(self.idcmp, IDCMP_GADGETUP | IDCMP_GADGETDOWN, enabled)
        return self
    }

    /// Set raw IDCMP flags directly
    pub fn idcmp(consuming self, flags: u32) -> WindowBuilder {
        self.idcmp = flags
        return self
    }

    /// Build and open the window
    ///
    /// Returns Err if window fails to open.
    @suppress("W0002", "Casting values to u32 for tags")
    pub fn build(consuming self) -> Result<WindowHandle, IntuitionError> {
        // Compute final flags
        var final_flags = self.flags

        if self.borderless {
            final_flags = final_flags | WFLG_BORDERLESS
        }
        if self.backdrop {
            final_flags = final_flags | WFLG_BACKDROP
        }
        if self.activate {
            final_flags = final_flags | WFLG_ACTIVATE
        }

        // Build tag array - custom screen is optional
        // Use TAG_IGNORE (1) for disabled tags to keep array layout consistent
        let screen_tag = if self.screen_ptr { WA_CustomScreen } else { 1 }  // TAG_IGNORE = 1

        let tags = [
            TagItem { ti_Tag: WA_Left, ti_Data: (u32)self.left },
            TagItem { ti_Tag: WA_Top, ti_Data: (u32)self.top },
            TagItem { ti_Tag: WA_Width, ti_Data: (u32)self.width },
            TagItem { ti_Tag: WA_Height, ti_Data: (u32)self.height },
            TagItem { ti_Tag: WA_MinWidth, ti_Data: (u32)self.min_width },
            TagItem { ti_Tag: WA_MinHeight, ti_Data: (u32)self.min_height },
            TagItem { ti_Tag: WA_MaxWidth, ti_Data: if self.max_width > 0 { (u32)self.max_width } else { 65535 } },
            TagItem { ti_Tag: WA_MaxHeight, ti_Data: if self.max_height > 0 { (u32)self.max_height } else { 65535 } },
            TagItem { ti_Tag: WA_Title, ti_Data: (u32)self.title_ptr },
            TagItem { ti_Tag: screen_tag, ti_Data: (u32)self.screen_ptr },
            TagItem { ti_Tag: WA_Flags, ti_Data: final_flags },
            TagItem { ti_Tag: WA_IDCMP, ti_Data: self.idcmp },
            TagItem { ti_Tag: TAG_DONE, ti_Data: 0 }
        ]

        let window = OpenWindowTagList(null, &tags[0])

        if let win = window {
            return Result::Ok(WindowHandle { window: win })
        }

        return Result::Err(IntuitionError::WindowOpenFailed)
    }
}

