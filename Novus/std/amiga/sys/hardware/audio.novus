// Paula Audio API
// Module: amiga::sys::hardware::audio
//
// High-level RAII-based API for Paula audio playback.
// Provides safe wrappers around hardware registers with automatic cleanup.
//
// This module directly accesses Paula hardware registers. Use it for:
// - Games that take over the system
// - Demos with custom audio
// - Applications that need precise audio control
//
// For OS-friendly applications that coexist with Workbench and other
// programs, use amiga::sys::device::audio instead.
//
// # Quick Start
// ```novus
// from amiga::sys::hardware::audio import AudioChannel, SampleHandle, PlaybackMode
//
// // Load sample into chip RAM
// let sample = SampleHandle::from_data(raw_pcm_data, length)?
//
// // Acquire a channel and play
// var channel = AudioChannel::acquire(0)?
// channel.set_volume(64)?
// channel.play(&sample, PlaybackMode::OneShot)
//
// // Wait for sound to finish...
// delay(Duration::secs(1))
//
// // Channel automatically stops and releases on drop
// ```

from std::core import Option, Result, Drop
from std::string import Str
from amiga::raw::exec import AllocVec, FreeVec, CopyMem
from amiga::raw::graphics import WaitBlit
from amiga::raw::exec import CreateMsgPort, DeleteMsgPort, CreateIORequest, DeleteIORequest
from amiga::raw::exec import OpenDevice, CloseDevice, DoIO, BeginIO, AbortIO, WaitIO
from amiga::raw::consts import MEMF_CHIP, MEMF_CLEAR, DMAF_SETCLR, DMAF_MASTER
from amiga::raw::consts import ADCMD_FREE, CMD_WRITE, ADIOF_PERVOL
from amiga::raw::structs import IOAudio, IORequest, MsgPort
from amiga::sys::hardware::registers import CUSTOM_BASE, DMACON, INTREQ, ADKCON, VPOSR
from amiga::sys::hardware::paula import period_from_hz, hz_from_period, channel_base_offset, channel_dma_bit, channel_int_bit, is_valid_period, is_valid_volume, is_valid_channel, PAULA_MAX_VOLUME, PAULA_MIN_PERIOD, PAULA_MAX_PERIOD, PAULA_MAX_LENGTH_WORDS, PAULA_MAX_LENGTH_BYTES, PAULA_PAL_CLOCK, PAULA_NTSC_CLOCK, PERIOD_11025_PAL, PERIOD_11025_NTSC, AUD0LCH
from amiga::sys::audio::errors import AudioError
from amiga::sys::exec::memory::chip import is_chip_ram, copy_to_chip, ChipCacheError, Priority
from amiga::sys::exec::memory::chip_cache import ChipCache

// ============================================================================
// Playback Mode
// ============================================================================

/// Playback mode hint (currently informational only)
///
/// NOTE: Paula hardware always loops samples automatically. True one-shot
/// playback requires audio interrupt handling which is not yet implemented.
/// For now, use stop() or the sample's duration_ms() to end playback manually.
///
/// This enum exists for future compatibility when interrupt-based one-shot
/// mode is implemented.
pub enum PlaybackMode {
    /// Hint: play once then stop (not yet implemented - loops until stop())
    OneShot,
    /// Loop continuously until stop() is called
    Loop,
}

// ============================================================================
// Sample Handle
// ============================================================================

/// RAII wrapper for audio sample data in chip RAM
///
/// Paula requires sample data to be in chip RAM (the lower 2MB that the
/// custom chips can access via DMA). This handle manages the lifecycle:
/// - Allocates chip RAM on creation
/// - Copies sample data (source can be in any memory type)
/// - Frees chip RAM automatically on drop
///
/// Sample format: Signed 8-bit PCM (-128 to +127)
/// This is the only format Paula supports.
///
/// # Example
/// ```novus
/// // Load from raw PCM data
/// let sample = SampleHandle::from_data(my_pcm_data, 2048)?
///
/// // Play the sample
/// var channel = AudioChannel::acquire(0)?
/// channel.play(&sample, PlaybackMode::OneShot)
///
/// // Sample memory automatically freed when handle goes out of scope
/// ```
pub struct SampleHandle {
    /// The data value stored by `SampleHandle`.
    data: *u8,            // Pointer to sample data in chip RAM
    /// The length bytes value stored by `SampleHandle`.
    length_bytes: u32,    // Length in bytes
    /// The length words value stored by `SampleHandle`.
    length_words: u16,    // Length in words (for hardware register)
    /// The sample rate value stored by `SampleHandle`.
    sample_rate: u32,     // Original sample rate in Hz (0 if unknown)
    /// The period pal value stored by `SampleHandle`.
    period_pal: u16,      // Pre-calculated period for PAL playback
    /// The period ntsc value stored by `SampleHandle`.
    period_ntsc: u16,     // Pre-calculated period for NTSC playback
    /// The owns data value stored by `SampleHandle`.
    owns_data: bool,      // True if we allocated data and should free on drop
}

impl SampleHandle {
    /// Create a sample handle from raw PCM data
    ///
    /// The data is copied to newly allocated chip RAM. The source data
    /// can be in any memory type (chip, fast, or stack).
    ///
    /// Sample format must be signed 8-bit PCM. This is the only format
    /// Paula hardware supports.
    ///
    /// # Arguments
    /// * `data` - Pointer to signed 8-bit PCM sample data
    /// * `length_bytes` - Length in bytes (will be rounded up to even)
    ///
    /// # Returns
    /// * `Ok(SampleHandle)` - Sample loaded into chip RAM
    /// * `Err(AudioError::SampleTooLong)` - Exceeds 128KB limit
    /// * `Err(AudioError::SampleTooShort)` - Less than 2 bytes
    /// * `Err(AudioError::AllocationFailed)` - Out of chip RAM
    ///
    /// # Example
    /// ```novus
    /// let sample = SampleHandle::from_data(pcm_bytes, 4096)?
    /// ```
    pub fn from_data(data: *u8, length_bytes: u32) -> Result<SampleHandle, AudioError> {
        // Validate length
        if length_bytes < 2 {
            return Result::Err(AudioError::SampleTooShort)
        }
        if length_bytes > PAULA_MAX_LENGTH_BYTES {
            return Result::Err(AudioError::SampleTooLong)
        }

        // Round up to word boundary (Paula reads words, not bytes)
        // Clear the low bit to make even: (x + 1) & ~1
        let padded_length = (length_bytes + 1) & ~(u32)1
        let length_words = (u16)(padded_length / 2)

        unsafe {
            // Allocate chip RAM (required for Paula DMA)
            let chip_mem = AllocVec(padded_length, MEMF_CHIP | MEMF_CLEAR)
            if !chip_mem {
                return Result::Err(AudioError::AllocationFailed)
            }

            // Copy sample data to chip RAM
            CopyMem(data, chip_mem, length_bytes)

            return Result::Ok(SampleHandle {
                data: chip_mem,
                length_bytes: length_bytes,
                length_words: length_words,
                sample_rate: 0,              // Unknown
                period_pal: PERIOD_11025_PAL,   // Default to 11025 Hz
                period_ntsc: PERIOD_11025_NTSC,
                owns_data: true,             // We allocated this memory
            })
        }
    }

    /// Create a sample handle with known sample rate
    ///
    /// Like from_data(), but also records the original sample rate.
    /// This allows automatic period calculation for correct playback pitch.
    ///
    /// # Arguments
    /// * `data` - Pointer to signed 8-bit PCM sample data
    /// * `length_bytes` - Length in bytes
    /// * `sample_rate` - Original sample rate in Hz (e.g., 11025, 22050)
    ///
    /// # Example
    /// ```novus
    /// // Sample recorded at 22050 Hz
    /// let sample = SampleHandle::from_data_with_rate(pcm, 8192, 22050)?
    ///
    /// // Play at original rate
    /// channel.play_native(&sample, PlaybackMode::OneShot, true)
    /// ```
    pub fn from_data_with_rate(data: *u8, length_bytes: u32, sample_rate: u32) -> Result<SampleHandle, AudioError> {
        var handle = SampleHandle::from_data(data, length_bytes)?
        handle.sample_rate = sample_rate

        // Pre-calculate periods for both PAL and NTSC
        // Use unwrap_or to keep default if calculation fails
        handle.period_pal = period_from_hz(sample_rate, true).unwrap_or(handle.period_pal)
        handle.period_ntsc = period_from_hz(sample_rate, false).unwrap_or(handle.period_ntsc)

        return Result::Ok(handle)
    }

    /// Create a sample handle that references existing chip RAM data
    ///
    /// Use this when sample data is already in chip RAM (e.g., loaded from
    /// disk directly to chip RAM, or compile-time embedded via @audio).
    ///
    /// WARNING: This does NOT copy data or allocate memory. The caller is
    /// responsible for ensuring the data remains valid and is properly freed.
    /// The Drop implementation will NOT free this memory.
    ///
    /// # Arguments
    /// * `chip_ptr` - Pointer to sample data already in chip RAM
    /// * `length_bytes` - Length in bytes
    /// * `sample_rate` - Sample rate in Hz (use 0 if unknown)
    ///
    /// # Safety
    /// The pointer must point to valid chip RAM that outlives the handle.
    pub fn from_chip_ram(chip_ptr: *u8, length_bytes: u32, sample_rate: u32) -> Result<SampleHandle, AudioError> {
        if length_bytes < 2 {
            return Result::Err(AudioError::SampleTooShort)
        }
        if length_bytes > PAULA_MAX_LENGTH_BYTES {
            return Result::Err(AudioError::SampleTooLong)
        }

        // Check alignment (Paula requires word-aligned addresses)
        if ((u32)chip_ptr & 1) != 0 {
            return Result::Err(AudioError::SampleMisaligned)
        }

        // Verify pointer is in chip RAM range (first 2MB: $000000-$1FFFFF)
        // Paula DMA can only access this memory region
        let addr = (u32)chip_ptr
        if addr >= $00200000 {
            return Result::Err(AudioError::SampleNotChipRam)
        }

        let length_words = (u16)((length_bytes + 1) / 2)

        var handle = SampleHandle {
            data: chip_ptr,
            length_bytes: length_bytes,
            length_words: length_words,
            sample_rate: sample_rate,
            period_pal: PERIOD_11025_PAL,
            period_ntsc: PERIOD_11025_NTSC,
            owns_data: false,            // We don't own this memory - caller must manage it
        }

        // Calculate periods if sample rate known
        if sample_rate > 0 {
            handle.period_pal = period_from_hz(sample_rate, true).unwrap_or(handle.period_pal)
            handle.period_ntsc = period_from_hz(sample_rate, false).unwrap_or(handle.period_ntsc)
        }

        return Result::Ok(handle)
    }

    /// Get pointer to sample data in chip RAM
    ///
    /// This is used internally to set up Paula registers.
    pub fn ptr(&self) -> *u8 {
        return self.data
    }

    /// Get length in words (for AUDxLEN register)
    ///
    /// Paula's length register counts words, not bytes.
    pub fn words(&self) -> u16 {
        return self.length_words
    }

    /// Get length in bytes
    pub fn bytes(&self) -> u32 {
        return self.length_bytes
    }

    /// Get the original sample rate (0 if unknown)
    pub fn sample_rate(&self) -> u32 {
        return self.sample_rate
    }

    /// Get the PAL period for this sample's native rate
    ///
    /// Use this period to play the sample at its original pitch on PAL systems.
    pub fn period_pal(&self) -> u16 {
        return self.period_pal
    }

    /// Get the NTSC period for this sample's native rate
    ///
    /// Use this period to play the sample at its original pitch on NTSC systems.
    pub fn period_ntsc(&self) -> u16 {
        return self.period_ntsc
    }

    /// Calculate playback duration in milliseconds
    ///
    /// # Arguments
    /// * `pal` - True for PAL timing, false for NTSC
    ///
    /// # Returns
    /// Duration in milliseconds at the sample's native rate
    @suppress("W0001", "Integer arithmetic is safe here")
    pub fn duration_ms(&self, pal: bool) -> u32 {
        var rate: u32 = self.sample_rate
        if rate == 0 {
            // Calculate from period
            var period: u16 = self.period_pal
            if !pal {
                period = self.period_ntsc
            }
            rate = hz_from_period(period, pal)
        }

        if rate == 0 {
            return 0
        }

        // duration_ms = (length_bytes * 1000) / sample_rate
        return (self.length_bytes * 1000) / rate
    }
}

impl Drop for SampleHandle {
    fn drop(&var self) {
        // Only free if we own the memory (allocated via from_data/from_data_with_rate)
        // from_chip_ram() sets owns_data=false since caller manages that memory
        if self.owns_data && (u32)self.data != 0 {
            unsafe {
                FreeVec(self.data)
                self.data = null
            }
        }
    }
}

// ============================================================================
// Audio Channel
// ============================================================================

/// RAII handle for a Paula audio channel
///
/// Directly controls one of Paula's 4 hardware audio channels.
/// Automatically stops playback when dropped.
///
/// Stereo assignment is fixed in hardware:
/// - Channels 0 and 3 -> LEFT speaker
/// - Channels 1 and 2 -> RIGHT speaker
///
/// # Example
/// ```novus
/// // Acquire channel 0 (left speaker)
/// var ch = AudioChannel::acquire(0)?
///
/// // Configure playback
/// ch.set_volume(64)?        // Max volume
/// ch.set_period(322)?       // ~11 kHz on PAL
///
/// // Start playing
/// ch.play(&sample, PlaybackMode::Loop)
///
/// // Change volume while playing
/// ch.set_volume(32)?        // Half volume
///
/// // Stop when done
/// ch.stop()
///
/// // Or just let it drop - channel stops automatically
/// ```
pub struct AudioChannel {
    /// The channel value stored by `AudioChannel`.
    channel: u8,       // Channel number (0-3)
    /// The period value stored by `AudioChannel`.
    period: u16,       // Current period setting
    /// The volume value stored by `AudioChannel`.
    volume: u16,       // Current volume setting
    /// The active value stored by `AudioChannel`.
    active: bool,      // Is DMA enabled for this channel?
    // Owned chip RAM copy for play_asset() (null if borrowing chip RAM)
    owned_chip_ptr: *u8,
}

impl AudioChannel {
    /// Acquire a hardware audio channel
    ///
    /// This directly takes control of the specified Paula channel.
    /// Does NOT go through audio.device, so it won't cooperate with
    /// other applications.
    ///
    /// For OS-friendly audio, use amiga::sys::device::audio instead.
    ///
    /// # Arguments
    /// * `channel` - Channel number (0-3)
    ///   - 0: Left speaker
    ///   - 1: Right speaker
    ///   - 2: Right speaker
    ///   - 3: Left speaker
    ///
    /// # Returns
    /// * `Ok(AudioChannel)` - Channel acquired
    /// * `Err(AudioError::InvalidChannel)` - Channel number > 3
    ///
    /// # Example
    /// ```novus
    /// // Acquire left channel
    /// let left = AudioChannel::acquire(0)?
    ///
    /// // Acquire right channel
    /// let right = AudioChannel::acquire(1)?
    /// ```
    pub fn acquire(channel: u8) -> Result<AudioChannel, AudioError> {
        if !is_valid_channel(channel) {
            return Result::Err(AudioError::InvalidChannel)
        }

        return Result::Ok(AudioChannel {
            channel: channel,
            period: PERIOD_11025_PAL,  // Default ~11 kHz
            volume: PAULA_MAX_VOLUME,  // Default max volume
            active: false,
            owned_chip_ptr: null,
        })
    }

    /// Get the channel number (0-3)
    pub fn channel_num(&self) -> u8 {
        return self.channel
    }

    /// Set the playback period (lower = higher pitch)
    ///
    /// The period determines how fast samples are played.
    /// Paula's DMA fetches one sample per (period) clock cycles.
    ///
    /// Valid range: 124-65535
    /// - 124: ~28.6 kHz (highest quality, near DMA bandwidth limit)
    /// - 322: ~11 kHz (good quality, lower CPU/DMA load)
    /// - 428: ~8.3 kHz (ProTracker standard)
    ///
    /// # Arguments
    /// * `period` - Period value (124-65535)
    ///
    /// # Returns
    /// * `Ok(())` - Period updated
    /// * `Err(AudioError::InvalidPeriod)` - Period < 124
    pub fn set_period(&var self, period: u16) -> Result<(), AudioError> {
        if !is_valid_period(period) {
            return Result::Err(AudioError::InvalidPeriod)
        }

        self.period = period

        if self.active {
            self.write_period()
        }

        return Result::Ok(())
    }

    /// Set sample rate in Hz (convenience method)
    ///
    /// Automatically calculates the correct period value.
    ///
    /// # Arguments
    /// * `hz` - Sample rate in Hz (e.g., 8000, 11025, 22050)
    /// * `pal` - True for PAL system (50Hz), false for NTSC (60Hz)
    ///
    /// # Returns
    /// * `Ok(())` - Sample rate set
    /// * `Err(AudioError::InvalidSampleRate)` - Rate out of valid range
    ///
    /// # Example
    /// ```novus
    /// // Set to 22050 Hz on PAL
    /// channel.set_sample_rate(22050, true)?
    /// ```
    pub fn set_sample_rate(&var self, hz: u32, pal: bool) -> Result<(), AudioError> {
        match period_from_hz(hz, pal) {
            Option::Some(period) => {
                self.period = period
                if self.active {
                    self.write_period()
                }
                return Result::Ok(())
            },
            Option::None => {
                return Result::Err(AudioError::InvalidSampleRate)
            },
        }
    }

    /// Set sample rate with auto-detected PAL/NTSC
    ///
    /// Automatically detects whether the system is PAL or NTSC
    /// and calculates the appropriate period.
    ///
    /// # Arguments
    /// * `hz` - Sample rate in Hz
    ///
    /// # Example
    /// ```novus
    /// // Auto-detect system and set rate
    /// channel.set_sample_rate_auto(22050)?
    /// ```
    pub fn set_sample_rate_auto(&var self, hz: u32) -> Result<(), AudioError> {
        return self.set_sample_rate(hz, is_pal_system())
    }

    /// Get the current period setting
    pub fn period(&self) -> u16 {
        return self.period
    }

    /// Set volume (0-64)
    ///
    /// Paula uses 6-bit volume with 65 levels (0-64, not 0-63).
    /// - 0: Silent
    /// - 64: Maximum volume
    ///
    /// Volume changes take effect immediately if playing.
    ///
    /// # Arguments
    /// * `volume` - Volume level (0-64)
    ///
    /// # Returns
    /// * `Ok(())` - Volume updated
    /// * `Err(AudioError::InvalidVolume)` - Volume > 64
    pub fn set_volume(&var self, volume: u16) -> Result<(), AudioError> {
        if !is_valid_volume(volume) {
            return Result::Err(AudioError::InvalidVolume)
        }

        self.volume = volume

        if self.active {
            self.write_volume()
        }

        return Result::Ok(())
    }

    /// Get the current volume setting (0-64)
    pub fn volume(&self) -> u16 {
        return self.volume
    }

    /// Check if the channel is currently playing
    pub fn is_playing(&self) -> bool {
        return self.active
    }

    /// Play a sample
    ///
    /// Starts playback immediately using the current period and volume.
    /// If already playing, stops the previous sample first to avoid DMA glitches.
    ///
    /// # Arguments
    /// * `sample` - Sample to play (must remain valid during playback!)
    /// * `mode` - Currently ignored; Paula always loops until stop() is called
    ///
    /// # Returns
    /// * `Ok(())` - Playback started
    /// * `Err(AudioError::SampleMisaligned)` - Sample pointer not word-aligned
    ///
    /// # Note
    /// Paula hardware always loops samples. To play once, calculate the
    /// sample duration and call stop() after that time, or use audio interrupts.
    ///
    /// # Example
    /// ```novus
    /// channel.play(&explosion_sound, PlaybackMode::Loop)?
    /// delay(Duration::millis(explosion_sound.duration_ms(true)))
    /// channel.stop()
    /// ```
    pub fn play(&var self, sample: &SampleHandle, mode: PlaybackMode) -> Result<(), AudioError> {
        // Validate sample pointer is word-aligned
        let addr = (u32)sample.ptr()
        if (addr & 1) != 0 {
            return Result::Err(AudioError::SampleMisaligned)
        }

        unsafe {
            // If already playing, stop DMA first to avoid glitches
            if self.active {
                // Wait for blitter to complete - audio DMA and blitter can share chip RAM
                WaitBlit()
                let dma_bit = channel_dma_bit(self.channel)
                let dmacon = (*u16)(CUSTOM_BASE + DMACON)
                *dmacon = dma_bit  // Clear DMA (no SETCLR)
            }

            let base = channel_base_offset(self.channel)

            // Write sample pointer (high word first - critical for Paula!)
            let lch = (*u16)(CUSTOM_BASE + base)
            let lcl = (*u16)(CUSTOM_BASE + base + 2)
            *lch = (u16)(addr >> 16)
            *lcl = (u16)(addr & $FFFF)

            // Write length in words
            let len_reg = (*u16)(CUSTOM_BASE + base + 4)
            *len_reg = sample.words()

            // Write period and volume
            self.write_period()
            self.write_volume()

            // Enable audio DMA for this channel
            // DMAF_SETCLR = set bits (not clear)
            // DMAF_MASTER = master DMA enable
            // channel_dma_bit = this channel's DMA bit
            let dma_bit = channel_dma_bit(self.channel)
            let dmacon = (*u16)(CUSTOM_BASE + DMACON)
            *dmacon = (u16)(DMAF_SETCLR | DMAF_MASTER | dma_bit)

            self.active = true
        }

        return Result::Ok(())
    }

    /// Play a sample at its native sample rate
    ///
    /// Uses the pre-calculated period from the sample's metadata.
    /// This ensures correct pitch for samples with known sample rates.
    ///
    /// # Arguments
    /// * `sample` - Sample to play
    /// * `mode` - Currently ignored; Paula always loops until stop() is called
    /// * `pal` - True for PAL, false for NTSC
    ///
    /// # Example
    /// ```novus
    /// // Sample recorded at 22050 Hz - play at correct pitch
    /// channel.play_native(&sample, PlaybackMode::Loop, true)?
    /// ```
    pub fn play_native(&var self, sample: &SampleHandle, mode: PlaybackMode, pal: bool) -> Result<(), AudioError> {
        if pal {
            self.period = sample.period_pal()
        } else {
            self.period = sample.period_ntsc()
        }
        return self.play(sample, mode)
    }

    /// Play a sample at its native rate with auto-detected PAL/NTSC
    ///
    /// Like play_native(), but automatically detects PAL/NTSC.
    ///
    /// # Example
    /// ```novus
    /// // Play at correct pitch for current system
    /// channel.play_native_auto(&sample, PlaybackMode::Loop)?
    /// ```
    pub fn play_native_auto(&var self, sample: &SampleHandle, mode: PlaybackMode) -> Result<(), AudioError> {
        return self.play_native(sample, mode, is_pal_system())
    }

    /// Play raw audio data directly
    ///
    /// Low-level method that plays audio from any chip RAM pointer.
    /// Use this when you have raw audio data that isn't wrapped in a SampleHandle.
    ///
    /// # Arguments
    /// * `chip_ptr` - Pointer to audio data (MUST be in chip RAM!)
    /// * `length_words` - Length in words (bytes / 2)
    /// * `period` - Paula period (lower = faster playback)
    /// * `mode` - Playback mode
    ///
    /// # Safety
    /// The pointer MUST be in chip RAM (address < $200000) and word-aligned.
    /// The caller must ensure the data remains valid during playback.
    pub fn play_raw(&var self, chip_ptr: *u8, length_words: u16, period: u16, mode: PlaybackMode) -> Result<(), AudioError> {
        let addr = (u32)chip_ptr

        // Validate chip RAM range
        if addr >= $00200000 {
            return Result::Err(AudioError::SampleNotChipRam)
        }

        // Validate word alignment
        if (addr & 1) != 0 {
            return Result::Err(AudioError::SampleMisaligned)
        }

        // Validate period
        if !is_valid_period(period) {
            return Result::Err(AudioError::InvalidPeriod)
        }

        self.period = period

        unsafe {
            // If already playing, stop DMA first to avoid glitches
            if self.active {
                // Wait for blitter to complete - audio DMA and blitter can share chip RAM
                WaitBlit()
                let dma_bit = channel_dma_bit(self.channel)
                let dmacon = (*u16)(CUSTOM_BASE + DMACON)
                *dmacon = dma_bit  // Clear DMA (no SETCLR)
            }

            let base = channel_base_offset(self.channel)

            // Write sample pointer (high word first - critical for Paula!)
            let lch = (*u16)(CUSTOM_BASE + base)
            let lcl = (*u16)(CUSTOM_BASE + base + 2)
            *lch = (u16)(addr >> 16)
            *lcl = (u16)(addr & $FFFF)

            // Write length in words
            let len_reg = (*u16)(CUSTOM_BASE + base + 4)
            *len_reg = length_words

            // Write period and volume
            self.write_period()
            self.write_volume()

            // Enable audio DMA for this channel
            let dma_bit = channel_dma_bit(self.channel)
            let dmacon = (*u16)(CUSTOM_BASE + DMACON)
            *dmacon = (u16)(DMAF_SETCLR | DMAF_MASTER | dma_bit)

            self.active = true
        }

        return Result::Ok(())
    }

    /// Play an AudioAsset with automatic chip RAM management
    ///
    /// This is the recommended way to play audio from an AudioAsset.
    /// If the asset data is in fast RAM, it will be cached to chip RAM
    /// using the global ChipCache. The asset is pinned during playback.
    ///
    /// # Arguments
    /// * `data` - Pointer to audio data (can be in fast or chip RAM)
    /// * `size` - Size in bytes
    /// * `period` - Paula period for playback rate
    /// * `mode` - Playback mode (currently informational only)
    ///
    /// # Returns
    /// * `Ok(())` - Playback started
    /// * `Err(AudioError::AllocationFailed)` - Could not allocate chip RAM
    ///
    /// # Example
    /// ```novus
    /// @audio("sound.wav", chip = false)
    /// static sound: AudioAsset = []
    ///
    /// var channel = AudioChannel::acquire(0)?
    /// let period = is_pal_system() ? sound.period_pal : sound.period_ntsc
    /// channel.play_asset(sound.data, sound.size, period, PlaybackMode::OneShot)?
    /// // Asset is unpinned and evicted automatically when channel is dropped
    /// ```
    pub fn play_asset(&var self, data: *u8, size: u32, period: u16, mode: PlaybackMode) -> Result<(), AudioError> {
        if self.owned_chip_ptr {
            FreeVec(self.owned_chip_ptr)
            self.owned_chip_ptr = null
        }

        // If already in chip RAM, play directly
        if is_chip_ram(data) {
            let length_words = (u16)((size + 1) / 2)
            return self.play_raw(data, length_words, period, mode)
        }

        let padded_size = (size + 1) & ~(u32)1
        let chip_ptr = (*u8)AllocVec(padded_size, MEMF_CHIP | MEMF_CLEAR)
        if !chip_ptr {
            return Result::Err(AudioError::AllocationFailed)
        }
        copy_to_chip(chip_ptr, data, size)
        self.owned_chip_ptr = chip_ptr
        return self.play_raw(chip_ptr, (u16)(padded_size / 2), period, mode)
    }

    /// Play an AudioAsset at its native sample rate
    ///
    /// Convenience method that uses the asset's pre-calculated period.
    ///
    /// # Arguments
    /// * `data` - Pointer to audio data
    /// * `size` - Size in bytes
    /// * `period_pal` - PAL period from asset
    /// * `period_ntsc` - NTSC period from asset
    /// * `mode` - Playback mode
    ///
    /// # Example
    /// ```novus
    /// @audio("sound.wav", chip = false)
    /// static sound: AudioAsset = []
    ///
    /// var channel = AudioChannel::acquire(0)?
    /// channel.play_asset_native(
    ///     sound.data, sound.size,
    ///     sound.period_pal, sound.period_ntsc,
    ///     PlaybackMode::OneShot
    /// )?
    /// ```
    pub fn play_asset_native(&var self, data: *u8, size: u32, period_pal: u16, period_ntsc: u16, mode: PlaybackMode) -> Result<(), AudioError> {
        let period = if is_pal_system() { period_pal } else { period_ntsc }
        return self.play_asset(data, size, period, mode)
    }

    /// Stop playback
    ///
    /// Disables audio DMA for this channel, clears any pending audio
    /// interrupt, and sets volume to 0 to prevent residual noise.
    pub fn stop(&var self) {
        if self.active {
            unsafe {
                // Wait for blitter to complete - audio DMA and blitter can share chip RAM
                WaitBlit()
                // Disable DMA for this channel (no SETCLR = clear bit)
                let dma_bit = channel_dma_bit(self.channel)
                let dmacon = (*u16)(CUSTOM_BASE + DMACON)
                *dmacon = dma_bit

                // Clear any pending audio interrupt for this channel
                // This prevents spurious interrupts after stopping
                let int_bit = channel_int_bit(self.channel)
                let intreq = (*u16)(CUSTOM_BASE + INTREQ)
                *intreq = int_bit

                // Set volume to 0 to prevent noise
                self.volume = 0
                self.write_volume()
            }
            self.active = false
        }
    }

    /// Fade volume to a target level over time
    ///
    /// This is a simple linear fade that blocks until complete.
    /// For non-blocking fades, implement your own using a timer.
    ///
    /// # Arguments
    /// * `target` - Target volume (0-64)
    /// * `steps` - Number of intermediate steps
    /// * `delay_fn` - Function to call for each step delay
    ///
    /// # Example
    /// ```novus
    /// // Fade out over 10 steps
    /// channel.fade_to(0, 10, || delay(Duration::millis(50)))
    /// ```
    pub fn fade_to(&var self, target: u16, steps: u32, delay_fn: fn()) {
        if steps == 0 {
            let _ = self.set_volume(target)
            return
        }

        let start = self.volume

        while var i < steps {
            // Linear interpolation
            let progress = ((i + 1) * 100) / steps
            var new_vol: u16 = 0
            if target > start {
                new_vol = start + (((target - start) * (u16)progress) / 100)
            } else {
                new_vol = start - (((start - target) * (u16)progress) / 100)
            }

            let _ = self.set_volume(new_vol)
            delay_fn()
            i++
        }

        let _ = self.set_volume(target)
    }

    // Internal: write period to hardware register
    fn write_period(&self) {
        unsafe {
            let base = channel_base_offset(self.channel)
            let reg = (*u16)(CUSTOM_BASE + base + 6)
            *reg = self.period
        }
    }

    // Internal: write volume to hardware register
    fn write_volume(&self) {
        unsafe {
            let base = channel_base_offset(self.channel)
            let reg = (*u16)(CUSTOM_BASE + base + 8)
            *reg = self.volume
        }
    }
}

impl Drop for AudioChannel {
    fn drop(&var self) {
        // Always stop playback when the handle is dropped
        // This prevents orphaned DMA that could play garbage
        self.stop()

        if self.owned_chip_ptr {
            FreeVec(self.owned_chip_ptr)
            self.owned_chip_ptr = null
        }
    }
}

// ============================================================================
// Convenience Functions
// ============================================================================

/// Play a one-shot sound effect on any available channel
///
/// This is a quick helper for simple sound effects. It:
/// 1. Acquires the specified channel
/// 2. Plays the sample once
/// 3. Returns the channel handle (drop it when done)
///
/// # Arguments
/// * `channel` - Channel number (0-3)
/// * `sample` - Sample to play
/// * `pal` - True for PAL, false for NTSC
///
/// # Returns
/// AudioChannel handle - keep it alive until sound finishes!
///
/// # Example
/// ```novus
/// // Play explosion sound
/// let handle = play_sound(0, &explosion, true)?
/// delay(explosion.duration_ms(true))
/// // handle dropped, channel stops
/// ```
pub fn play_sound(channel: u8, sample: &SampleHandle, pal: bool) -> Result<AudioChannel, AudioError> {
    var ch = AudioChannel::acquire(channel)?
    ch.play_native(sample, PlaybackMode::Loop, pal)?
    return Result::Ok(ch)
}

/// Stop all audio channels
///
/// Immediately silences all 4 Paula channels by disabling their DMA
/// and clearing any pending audio interrupts. Useful for cleanup or emergency mute.
pub fn stop_all_channels() {
    unsafe {
        // Disable DMA for all audio channels (no SETCLR = clear bits)
        let dmacon = (*u16)(CUSTOM_BASE + DMACON)
        *dmacon = $000F  // DMAF_AUD0 | AUD1 | AUD2 | AUD3

        // Clear all pending audio interrupts
        // INTF_AUD0=$0080, AUD1=$0100, AUD2=$0200, AUD3=$0400 -> $0780
        let intreq = (*u16)(CUSTOM_BASE + INTREQ)
        *intreq = $0780

        // Set all volumes to 0
        var ch: u8 = 0
        while ch < 4 {
            let base = channel_base_offset(ch)
            let vol_reg = (*u16)(CUSTOM_BASE + base + 8)
            *vol_reg = 0
            ch++
        }
    }
}

// ============================================================================
// System Detection
// ============================================================================

/// Detect if the system is PAL or NTSC
///
/// Reads the VPOSR register to determine the video standard.
/// This affects audio timing calculations since PAL and NTSC
/// have different clock frequencies.
///
/// # Returns
/// - `true` for PAL systems (50Hz, European)
/// - `false` for NTSC systems (60Hz, American/Japanese)
///
/// # Example
/// ```novus
/// let period = if is_pal_system() {
///     sample.period_pal()
/// } else {
///     sample.period_ntsc()
/// }
/// ```
pub fn is_pal_system() -> bool {
    unsafe {
        // VPOSR bit 12 (LOF - Long Frame) indicates video system:
        // PAL has 312/313 lines per field, NTSC has 262/263
        // However, the reliable method is to check the Agnus ID in bits 8-14
        // Bit 12 of VPOSR: 0 = PAL, 1 = NTSC (when checking during vertical blank)
        // More reliable: Check if we're on a PAL Agnus
        // For simplicity, we check the current frame type bit
        let vposr = (*u16)(CUSTOM_BASE + VPOSR)
        let value = *vposr

        // Bit 15 (LOF - Long Frame) alternates each field
        // For PAL: long frame = 313 lines, short = 312
        // For NTSC: long frame = 263 lines, short = 262
        // We can't reliably detect from this alone, so we check Agnus ID

        // Bits 8-14 contain Agnus/Alice ID
        // PAL Agnus IDs have bit 12 = 0
        // NTSC Agnus IDs have bit 12 = 1
        return (value & $1000) == 0
    }
}

// ============================================================================
// Audio System Initialization
// ============================================================================

/// Initialize the Paula audio system
///
/// This should be called before using direct Paula audio.
/// Sets up ADKCON to disable audio modulation (standard playback mode).
///
/// # Note
/// This is only needed for direct Paula access. The audio.device
/// and ptplayer handle their own initialization.
///
/// # Example
/// ```novus
/// init_audio()
/// var channel = AudioChannel::acquire(0)?
/// ```
pub fn init_audio() {
    unsafe {
        // Clear audio modulation bits in ADKCON
        // This ensures standard (non-modulated) audio playback
        // Bits 0-3: USE0-USE3 (period modulation, should be 0)
        // Bits 4-7: USE0V-USE3V (volume modulation, should be 0)
        let adkcon = (*u16)(CUSTOM_BASE + ADKCON)
        *adkcon = $00FF  // Clear all audio modulation bits (no SETCLR)
    }
}

/// Initialize audio and return a channel ready to play
///
/// Convenience function that initializes the audio system and acquires a channel.
///
/// # Arguments
/// * `channel` - Channel number (0-3)
///
/// # Returns
/// Configured AudioChannel ready for playback
///
/// # Example
/// ```novus
/// var ch = init_channel(0)?
/// ch.play(&sample, PlaybackMode::Loop)?
/// ```
pub fn init_channel(channel: u8) -> Result<AudioChannel, AudioError> {
    init_audio()
    return AudioChannel::acquire(channel)
}

// ============================================================================
// Channel Mask - Flexible Channel Selection
// ============================================================================

/// Bitmask for selecting any combination of Paula's 4 audio channels
///
/// Paula has 4 channels with fixed stereo assignment:
/// - Channel 0: LEFT
/// - Channel 1: RIGHT
/// - Channel 2: RIGHT
/// - Channel 3: LEFT
///
/// ChannelMask lets you specify any combination of channels for playback.
/// Use the builder methods to construct masks, or create directly from a u8.
///
/// # Examples
/// ```novus
/// // Single channel
/// let ch0 = ChannelMask::channel(0)
///
/// // Stereo (one left + one right)
/// let stereo = ChannelMask::stereo()
///
/// // Custom combination
/// let custom = ChannelMask::channel(0).with(2).with(3)
///
/// // All channels
/// let all = ChannelMask::all()
/// ```
pub struct ChannelMask {
    /// The mask value stored by `ChannelMask`.
    mask: u8,  // Bits 0-3 correspond to channels 0-3
}

impl ChannelMask {
    /// Create an empty mask (no channels)
    pub fn none() -> ChannelMask {
        return ChannelMask { mask: 0 }
    }

    /// Create a mask for all 4 channels
    pub fn all() -> ChannelMask {
        return ChannelMask { mask: $0F }
    }

    /// Create a mask for a single channel (0-3)
    ///
    /// Returns an empty mask if channel > 3
    pub fn channel(ch: u8) -> ChannelMask {
        if ch > 3 {
            return ChannelMask { mask: 0 }
        }
        return ChannelMask { mask: 1 << ch }
    }

    /// Create a mask for left channels only (0 and 3)
    pub fn left() -> ChannelMask {
        return ChannelMask { mask: $09 }  // 0b1001
    }

    /// Create a mask for right channels only (1 and 2)
    pub fn right() -> ChannelMask {
        return ChannelMask { mask: $06 }  // 0b0110
    }

    /// Create a mask for stereo playback (channel 0 left + channel 1 right)
    ///
    /// This requests one left channel and one right channel.
    /// The actual channels allocated depend on availability.
    pub fn stereo() -> ChannelMask {
        return ChannelMask { mask: $03 }  // 0b0011 - channels 0 and 1
    }

    /// Create a mask from a raw u8 value
    ///
    /// Only the lower 4 bits are used.
    pub fn from_raw(mask: u8) -> ChannelMask {
        return ChannelMask { mask: mask & $0F }
    }

    /// Add a channel to this mask
    ///
    /// Returns a new mask with the additional channel.
    pub fn with(&self, ch: u8) -> ChannelMask {
        if ch > 3 {
            return ChannelMask { mask: self.mask }
        }
        return ChannelMask { mask: self.mask | (1 << ch) }
    }

    /// Remove a channel from this mask
    pub fn without(&self, ch: u8) -> ChannelMask {
        if ch > 3 {
            return ChannelMask { mask: self.mask }
        }
        return ChannelMask { mask: self.mask & ~(1 << ch) }
    }

    /// Check if a channel is in this mask
    pub fn has(&self, ch: u8) -> bool {
        if ch > 3 {
            return false
        }
        return (self.mask & (1 << ch)) != 0
    }

    /// Get the raw mask value
    pub fn as_raw(&self) -> u8 {
        return self.mask
    }

    /// Count how many channels are in this mask
    pub fn count(&self) -> u8 {
        var c: u8 = 0
        var m = self.mask
        while m != 0 {
            c = c + (m & 1)
            m = m >> 1
        }
        return c
    }

    /// Check if the mask is empty (no channels)
    pub fn is_empty(&self) -> bool {
        return self.mask == 0
    }

    /// Check if this mask has any left channel (0 or 3)
    pub fn has_left(&self) -> bool {
        return (self.mask & $09) != 0
    }

    /// Check if this mask has any right channel (1 or 2)
    pub fn has_right(&self) -> bool {
        return (self.mask & $06) != 0
    }

    /// Check if this mask has both left and right (stereo capable)
    pub fn is_stereo(&self) -> bool {
        return self.has_left() && self.has_right()
    }

    /// Get the first (lowest numbered) channel in this mask
    ///
    /// Returns Option::None if mask is empty
    pub fn first(&self) -> Option<u8> {
        if (self.mask & 1) != 0 { return Option::Some(0) }
        if (self.mask & 2) != 0 { return Option::Some(1) }
        if (self.mask & 4) != 0 { return Option::Some(2) }
        if (self.mask & 8) != 0 { return Option::Some(3) }
        return Option::None
    }
}

// ============================================================================
// Multi-Channel Playback
// ============================================================================

/// Play audio on multiple channels simultaneously with OS-friendly allocation
///
/// MultiChannel combines the best of both worlds:
/// - Uses audio.device for proper channel allocation (good OS citizen)
/// - Uses direct Paula hardware for low-latency playback
///
/// This is ideal for:
/// - Stereo sound effects (same sample on left + right channels)
/// - Multi-channel audio mixing
/// - Any scenario where you need to play on multiple channels at once
///
/// # Example - Stereo playback
/// ```novus
/// // Allocate stereo channels (one left, one right)
/// var audio = MultiChannel::acquire_stereo(0)?
///
/// // Play sample on both channels
/// audio.play(&explosion, PlaybackMode::OneShot)?
///
/// // Adjust volume on all channels
/// audio.set_volume(48)?
///
/// // Or per-channel volume for panning
/// audio.set_channel_volume(0, 64)?  // Full left
/// audio.set_channel_volume(1, 32)?  // Half right
/// ```
///
/// # Example - Custom channel selection
/// ```novus
/// // Play on channels 0, 2, and 3
/// let mask = ChannelMask::channel(0).with(2).with(3)
/// var audio = MultiChannel::acquire(mask, 0)?
/// audio.play(&sample, PlaybackMode::Loop)?
/// ```
pub struct MultiChannel {
    // audio.device resources for allocation
    /// The io audio value stored by `MultiChannel`.
    io_audio: *IOAudio,
    /// The port value stored by `MultiChannel`.
    port: *MsgPort,
    /// The alloc key value stored by `MultiChannel`.
    alloc_key: i16,

    // Which channels we actually got allocated
    /// The allocated mask value stored by `MultiChannel`.
    allocated_mask: ChannelMask,

    // Per-channel state (indexed by channel number 0-3)
    /// The periods value stored by `MultiChannel`.
    periods: [u16; 4],
    /// The volumes value stored by `MultiChannel`.
    volumes: [u16; 4],

    // Playback state
    /// The active value stored by `MultiChannel`.
    active: bool,
}

impl MultiChannel {
    /// Acquire channels matching the given mask through audio.device
    ///
    /// The OS will allocate available channels. If the exact channels aren't
    /// available, you may get different ones that satisfy the request.
    ///
    /// # Arguments
    /// * `mask` - Which channels to request
    /// * `priority` - Allocation priority (-128 to 127, 0 = normal)
    ///
    /// # Returns
    /// * `Ok(MultiChannel)` - Channels allocated, ready to play
    /// * `Err(AudioError::NoAllocation)` - Requested channels not available
    pub fn acquire(mask: ChannelMask, priority: i8) -> Result<MultiChannel, AudioError> {
        if mask.is_empty() {
            return Result::Err(AudioError::InvalidChannel)
        }

        // Create message port for I/O replies
        let port = CreateMsgPort()
        if (u32)port == 0 {
            return Result::Err(AudioError::NoMsgPort)
        }

        // Create IORequest
        let req = CreateIORequest(port, @sizeof(IOAudio))
        if (u32)req == 0 {
            DeleteMsgPort(port)
            return Result::Err(AudioError::NoIORequest)
        }

        let io_audio = (*IOAudio)req

        // Build allocation map based on requested mask
        // The allocation array is a list of acceptable channel combinations (bitmasks).
        // audio.device tries each entry in order until it finds available channels.
        // ioa_Length is the number of acceptable channel-mask choices.
        var alloc_map: [u8] = [0, 0, 0, 0, 0, 0, 0, 0]
        var choice_count: u32 = 1

        let channel_count = mask.count()

        if channel_count == 4 {
            // All 4 channels - only one option
            alloc_map[0] = $0F
        } else if channel_count == 2 && mask.has_left() && mask.has_right() {
            // Stereo pair - provide multiple fallback combinations
            // Each entry is a bitmask of channels that satisfy "one left + one right"
            alloc_map[0] = $03  // channels 0+1 (preferred: left 0, right 1)
            alloc_map[1] = $05  // channels 0+2 (left 0, right 2)
            alloc_map[2] = $0A  // channels 1+3 (right 1, left 3)
            alloc_map[3] = $0C  // channels 2+3 (right 2, left 3)
            choice_count = 4
        } else if channel_count == 1 {
            // Specific channel requested
            alloc_map[0] = mask.as_raw()
        } else {
            // Custom multi-channel request - use mask directly
            alloc_map[0] = mask.as_raw()
        }

        // Set up the IOAudio for allocation
        io_audio.ioa_Request.io_Message.mn_ReplyPort = port
        io_audio.ioa_Request.io_Message.mn_Node.ln_Pri = priority
        io_audio.ioa_Data = &alloc_map[0]
        io_audio.ioa_Length = choice_count

        // Open device - this performs the allocation
        unsafe {
            let req_addr = &io_audio.ioa_Request
            let ioreq = (*IORequest)req_addr
            let error = OpenDevice("audio.device", 0, ioreq, 0)

            if error != 0 {
                DeleteIORequest(req)
                DeleteMsgPort(port)

                if error == -10 {
                    return Result::Err(AudioError::NoAllocation)
                }
                if error == -11 {
                    return Result::Err(AudioError::AllocFailed)
                }
                return Result::Err(AudioError::DeviceOpenFailed)
            }
        }

        // Extract allocation results
        // io_Unit contains a bitmask of the actually allocated channels
        let alloc_key = io_audio.ioa_AllocKey
        let allocated = (u8)((u32)io_audio.ioa_Request.io_Unit & $FF)

        return Result::Ok(MultiChannel {
            io_audio: io_audio,
            port: port,
            alloc_key: alloc_key,
            allocated_mask: ChannelMask::from_raw(allocated),
            periods: [PERIOD_11025_PAL, PERIOD_11025_PAL, PERIOD_11025_PAL, PERIOD_11025_PAL],
            volumes: [PAULA_MAX_VOLUME, PAULA_MAX_VOLUME, PAULA_MAX_VOLUME, PAULA_MAX_VOLUME],
            active: false,
        })
    }

    /// Acquire any single available channel
    ///
    /// The OS will pick the first available channel.
    ///
    /// # Arguments
    /// * `priority` - Allocation priority (-128 to 127)
    pub fn acquire_any(priority: i8) -> Result<MultiChannel, AudioError> {
        var channel: u8 = 0
        while channel < 4 {
            match MultiChannel::acquire(ChannelMask::channel(channel), priority) {
                Result::Ok(value) => return Result::Ok(value),
                Result::Err(_) => {},
            }
            channel++
        }
        return Result::Err(AudioError::NoAllocation)
    }

    /// Acquire a stereo pair (one left + one right channel)
    ///
    /// The OS will allocate one channel from the left side (0 or 3)
    /// and one from the right side (1 or 2).
    ///
    /// # Arguments
    /// * `priority` - Allocation priority (-128 to 127)
    pub fn acquire_stereo(priority: i8) -> Result<MultiChannel, AudioError> {
        return MultiChannel::acquire(ChannelMask::stereo(), priority)
    }

    /// Acquire a specific channel by number
    ///
    /// # Arguments
    /// * `channel` - Channel number (0-3)
    /// * `priority` - Allocation priority (-128 to 127)
    pub fn acquire_channel(channel: u8, priority: i8) -> Result<MultiChannel, AudioError> {
        if channel > 3 {
            return Result::Err(AudioError::InvalidChannel)
        }
        return MultiChannel::acquire(ChannelMask::channel(channel), priority)
    }

    /// Get the mask of actually allocated channels
    pub fn channels(&self) -> ChannelMask {
        return self.allocated_mask
    }

    /// Get the number of allocated channels
    pub fn channel_count(&self) -> u8 {
        return self.allocated_mask.count()
    }

    /// Check if we have stereo (at least one left and one right)
    pub fn is_stereo(&self) -> bool {
        return self.allocated_mask.is_stereo()
    }

    /// Set volume for all allocated channels (0-64)
    ///
    /// This is the common case - same volume on all channels.
    /// Note: Volume changes take effect on the next play() call.
    pub fn set_volume(&var self, volume: u16) -> Result<(), AudioError> {
        if !is_valid_volume(volume) {
            return Result::Err(AudioError::InvalidVolume)
        }

        var ch: u8 = 0
        while ch < 4 {
            if self.allocated_mask.has(ch) {
                self.volumes[ch] = volume
            }
            ch++
        }
        return Result::Ok(())
    }

    /// Set volume for a specific channel (0-64)
    ///
    /// Use this for stereo panning or per-channel control.
    /// Note: Volume changes take effect on the next play() call.
    ///
    /// # Arguments
    /// * `channel` - Channel number (0-3)
    /// * `volume` - Volume level (0-64)
    pub fn set_channel_volume(&var self, channel: u8, volume: u16) -> Result<(), AudioError> {
        if channel > 3 {
            return Result::Err(AudioError::InvalidChannel)
        }
        if !self.allocated_mask.has(channel) {
            return Result::Err(AudioError::InvalidChannel)
        }
        if !is_valid_volume(volume) {
            return Result::Err(AudioError::InvalidVolume)
        }

        self.volumes[channel] = volume
        return Result::Ok(())
    }

    /// Get volume for a specific channel
    pub fn channel_volume(&self, channel: u8) -> u16 {
        if channel > 3 {
            return 0
        }
        return self.volumes[channel]
    }

    /// Set period for all allocated channels
    ///
    /// Note: Period changes take effect on the next play() call.
    pub fn set_period(&var self, period: u16) -> Result<(), AudioError> {
        if !is_valid_period(period) {
            return Result::Err(AudioError::InvalidPeriod)
        }

        var ch: u8 = 0
        while ch < 4 {
            if self.allocated_mask.has(ch) {
                self.periods[ch] = period
            }
            ch++
        }
        return Result::Ok(())
    }

    /// Set sample rate for all channels (converts to period)
    pub fn set_sample_rate(&var self, hz: u32, pal: bool) -> Result<(), AudioError> {
        match period_from_hz(hz, pal) {
            Option::Some(period) => {
                return self.set_period(period)
            },
            Option::None => {
                return Result::Err(AudioError::InvalidSampleRate)
            },
        }
    }

    /// Play a sample on all allocated channels simultaneously
    ///
    /// The sample is played on every channel we have allocated using audio.device.
    /// All channels use the same sample data but can have different volumes.
    pub fn play(&var self, sample: &SampleHandle, mode: PlaybackMode) -> Result<(), AudioError> {
        let addr = (u32)sample.ptr()
        if (addr & 1) != 0 {
            return Result::Err(AudioError::SampleMisaligned)
        }

        // Stop any currently playing audio first
        if self.active {
            self.stop()
        }

        // Use audio.device CMD_WRITE for proper system integration
        // With ADIOF_PERVOL, we can set period and volume per-write
        let io = self.io_audio

        // Calculate average volume for all channels (audio.device uses one volume for multi-channel)
        var total_vol: u32 = 0
        var ch_count: u32 = 0
        var ch: u8 = 0
        while ch < 4 {
            if self.allocated_mask.has(ch) {
                total_vol = total_vol + (u32)self.volumes[ch]
                ch_count++
            }
            ch++
        }
        let avg_vol = if ch_count > 0 { (u16)(total_vol / ch_count) } else { 64 }

        // Use the first channel's period (they should all be the same)
        var period: u16 = PERIOD_11025_PAL
        match self.allocated_mask.first() {
            Option::Some(first_ch) => {
                period = self.periods[first_ch]
            },
            Option::None => {}
        }

        // Set up the IORequest for CMD_WRITE
        io.ioa_Request.io_Command = (u16)CMD_WRITE
        io.ioa_Request.io_Flags = (u8)ADIOF_PERVOL  // Per-write period/volume
        io.ioa_Data = sample.ptr()
        io.ioa_Length = sample.bytes()
        io.ioa_Period = period
        io.ioa_Volume = avg_vol
        io.ioa_Cycles = if mode == PlaybackMode::Loop { 0 } else { 1 }

        unsafe {
            let req_addr = &io.ioa_Request
            let ioreq = (*IORequest)req_addr
            BeginIO(ioreq)
        }

        self.active = true
        return Result::Ok(())
    }

    /// Play a sample at its native sample rate
    pub fn play_native(&var self, sample: &SampleHandle, mode: PlaybackMode, pal: bool) -> Result<(), AudioError> {
        let period = if pal { sample.period_pal() } else { sample.period_ntsc() }
        self.set_period(period)?
        return self.play(sample, mode)
    }

    /// Play raw audio data from chip RAM
    pub fn play_raw(&var self, chip_ptr: *u8, length_bytes: u32, period: u16, mode: PlaybackMode) -> Result<(), AudioError> {
        let addr = (u32)chip_ptr

        if addr >= $00200000 {
            return Result::Err(AudioError::SampleNotChipRam)
        }
        if (addr & 1) != 0 {
            return Result::Err(AudioError::SampleMisaligned)
        }
        if !is_valid_period(period) {
            return Result::Err(AudioError::InvalidPeriod)
        }

        // Stop any currently playing audio first
        if self.active {
            self.stop()
        }

        // Store period for all channels
        var ch: u8 = 0
        while ch < 4 {
            if self.allocated_mask.has(ch) {
                self.periods[ch] = period
            }
            ch++
        }

        // Calculate average volume
        var total_vol: u32 = 0
        var ch_count: u32 = 0
        var ch2: u8 = 0
        while ch2 < 4 {
            if self.allocated_mask.has(ch2) {
                total_vol = total_vol + (u32)self.volumes[ch2]
                ch_count++
            }
            ch2++
        }
        let avg_vol = if ch_count > 0 { (u16)(total_vol / ch_count) } else { 64 }

        // Use audio.device CMD_WRITE
        let io = self.io_audio
        io.ioa_Request.io_Command = (u16)CMD_WRITE
        io.ioa_Request.io_Flags = (u8)ADIOF_PERVOL
        io.ioa_Data = chip_ptr
        io.ioa_Length = length_bytes
        io.ioa_Period = period
        io.ioa_Volume = avg_vol
        io.ioa_Cycles = if mode == PlaybackMode::Loop { 0 } else { 1 }

        unsafe {
            let req_addr = &io.ioa_Request
            let ioreq = (*IORequest)req_addr
            BeginIO(ioreq)
        }

        self.active = true
        return Result::Ok(())
    }

    /// Stop playback on all channels
    pub fn stop(&var self) {
        if self.active {
            // Abort any pending I/O using audio.device
            let io = self.io_audio
            unsafe {
                let req_addr = &io.ioa_Request
                let ioreq = (*IORequest)req_addr
                AbortIO(ioreq)
                WaitIO(ioreq)
            }
            self.active = false
        }
    }

    /// Check if currently playing
    pub fn is_playing(&self) -> bool {
        return self.active
    }
}

impl Drop for MultiChannel {
    fn drop(&var self) {
        // Stop any active playback
        self.stop()

        // Free channels and close device
        if let io = self.io_audio {
            unsafe {
                io.ioa_Request.io_Command = (u16)ADCMD_FREE
                let req_addr = &io.ioa_Request
                let ioreq = (*IORequest)req_addr
                let _ = DoIO(ioreq)

                CloseDevice(ioreq)
                DeleteIORequest((*u8)io)
            }
            self.io_audio = null
        }

        if let port = self.port {
            DeleteMsgPort(port)
            self.port = null
        }
    }
}
