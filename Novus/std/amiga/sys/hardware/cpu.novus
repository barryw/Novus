// system.novus - System hardware detection
// Namespace: amiga::sys::hardware
// Provides enums and variables for runtime hardware detection on Amiga

from std::string::format import Display, Formatter
from std::string::core import Str

// CPU types detected via ExecBase->AttnFlags
pub enum SystemCPU {
    M68020,    // Minimum supported CPU
    M68030,    // 68030 (25-50 MHz on accelerators)
    M68040,    // 68040 (25-40 MHz on A4000/accelerators)
    M68060,    // 68060 (50-75 MHz on accelerators)
}

// FPU types detected via ExecBase->AttnFlags
pub enum SystemFPU {
    None,      // No FPU present
    M68881,    // 68881 coprocessor (separate chip)
    M68882,    // 68882 coprocessor (separate chip)
    M68040,    // 68040 internal FPU
    M68060,    // 68060 internal FPU
}

// Chipset types detected via GfxBase->ChipRevBits0
pub enum SystemChipset {
    OCS,       // Original Chip Set (A500/A1000/A2000)
    ECS,       // Enhanced Chip Set (A500+/A600/A2000)
    AGA,       // Advanced Graphics Architecture (A1200/A4000/CD32)
}

// Memory information structure
pub struct MemoryInfo {
    total: u32,    // Total bytes
    free: u32,     // Free bytes
    largest: u32,  // Largest free block
}

// Runtime hardware detection functions
// These call into the Novus runtime which detects hardware at startup
extern fn __detect_cpu() -> SystemCPU
extern fn __detect_fpu() -> SystemFPU
extern fn __detect_chipset() -> SystemChipset
extern fn __get_chip_ram_total() -> u32
extern fn __get_chip_ram_free() -> u32
extern fn __get_chip_ram_largest() -> u32

// Global accessors for hardware detection
// These call the runtime's extern detection functions
pub fn CPU() -> SystemCPU {
    return __detect_cpu()
}

pub fn FPU() -> SystemFPU {
    return __detect_fpu()
}

pub fn CHIPSET() -> SystemChipset {
    return __detect_chipset()
}

pub fn CHIP_RAM() -> MemoryInfo {
    let total = __get_chip_ram_total()
    let free = __get_chip_ram_free()
    let largest = __get_chip_ram_largest()
    return MemoryInfo { total: total, free: free, largest: largest }
}

// Display trait implementations for hardware enums
impl Display for SystemCPU {
    fn fmt(&self, f: &var Formatter) -> bool {
        return match *self {
            SystemCPU::M68020 => f.write_str("68020"),
            SystemCPU::M68030 => f.write_str("68030"),
            SystemCPU::M68040 => f.write_str("68040"),
            SystemCPU::M68060 => f.write_str("68060"),
        }
    }
}

impl Display for SystemFPU {
    fn fmt(&self, f: &var Formatter) -> bool {
        return match *self {
            SystemFPU::None => f.write_str("None"),
            SystemFPU::M68881 => f.write_str("68881"),
            SystemFPU::M68882 => f.write_str("68882"),
            SystemFPU::M68040 => f.write_str("68040 FPU"),
            SystemFPU::M68060 => f.write_str("68060 FPU"),
        }
    }
}

impl Display for SystemChipset {
    fn fmt(&self, f: &var Formatter) -> bool {
        return match *self {
            SystemChipset::OCS => f.write_str("OCS"),
            SystemChipset::ECS => f.write_str("ECS"),
            SystemChipset::AGA => f.write_str("AGA"),
        }
    }
}
