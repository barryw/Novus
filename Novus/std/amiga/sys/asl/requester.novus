// Owning AmigaOS 3.1 ASL file requester.

from std::core import Error, Option, Result
from amiga::raw::consts import ASLFR_DoSaveMode, ASLFR_InitialDrawer, ASLFR_InitialFile, ASLFR_TitleText, ASLFR_Window, ASL_FileRequest, TAG_DONE
from amiga::raw::structs import FileRequester, TagItem, Window
from amiga::raw::asl import AllocAslRequest, AslRequest, FreeAslRequest
from std::string import PathString, Str

pub enum AslError {
    AllocationFailed,
    PathTooLong,
}

impl AslError {
    pub fn message(&self) -> *u8 {
        return match self {
            AslError::AllocationFailed => "Could not create the file requester",
            AslError::PathTooLong => "The selected path is too long",
        }
    }
}

impl Error for AslError {
    fn message(&self) -> *u8 { return AslError::message(self) }
}

pub struct FileRequesterHandle {
    requester: *FileRequester,
}

impl FileRequesterHandle {
    pub fn new() -> Result<FileRequesterHandle, AslError> {
        let requester = AllocAslRequest(ASL_FileRequest, null)
        return Result::Err(AslError::AllocationFailed) if requester == null
        return Result::Ok(FileRequesterHandle { requester: (*FileRequester)requester })
    }

    /// Returns None when the user cancels.
    pub fn choose(&self,
        parent: *Window,
        title: Str,
        initial_drawer: Str,
        initial_file: Str,
        save: bool
    ) -> Result<Option<PathString>, AslError> {
        let tags = [
            TagItem { ti_Tag: ASLFR_Window, ti_Data: (u32)parent },
            TagItem { ti_Tag: ASLFR_TitleText, ti_Data: (u32)title.as_cstr() },
            TagItem { ti_Tag: ASLFR_InitialDrawer, ti_Data: (u32)initial_drawer.as_cstr() },
            TagItem { ti_Tag: ASLFR_InitialFile, ti_Data: (u32)initial_file.as_cstr() },
            TagItem { ti_Tag: ASLFR_DoSaveMode, ti_Data: if save { 1 } else { 0 } },
            TagItem { ti_Tag: TAG_DONE, ti_Data: 0 },
        ]
        return Result::Ok(Option::None) if AslRequest((*u8)self.requester, &tags[0]) == 0

        var path = PathString::new()
        let drawer = match unsafe { Str::from_cstr((*self.requester).fr_Drawer) } {
            Option::Some(value) => value,
            Option::None => "",
        }
        let file = match unsafe { Str::from_cstr((*self.requester).fr_File) } {
            Option::Some(value) => value,
            Option::None => "",
        }
        match path.push_str(drawer) {
            Result::Ok(_) => {},
            Result::Err(_) => return Result::Err(AslError::PathTooLong),
        }
        if !drawer.is_empty() && !drawer.ends_with(":") && !drawer.ends_with("/") {
            match path.push_byte((u8)'/') {
                Result::Ok(_) => {},
                Result::Err(_) => return Result::Err(AslError::PathTooLong),
            }
        }
        match path.push_str(file) {
            Result::Ok(_) => {},
            Result::Err(_) => return Result::Err(AslError::PathTooLong),
        }
        return Result::Ok(Option::Some(path))
    }

    pub fn as_raw(&self) -> *FileRequester { return self.requester }
}

impl Drop for FileRequesterHandle {
    fn drop(&var self) {
        if self.requester != null {
            FreeAslRequest((*u8)self.requester)
            self.requester = null
        }
    }
}
