// Amiga Exec-compatible intrusive lists.
// AmigaOS-compatible intrusive doubly-linked list using Exec functions

from std::core import Option
from amiga::raw::structs import MinNode, MinList, Node, List
from amiga::raw::exec import AddHead, AddTail, Remove, RemHead, RemTail, Insert, Enqueue

/// IntrusiveList - AmigaOS-compatible intrusive doubly-linked list
///
/// An intrusive list where nodes embed their link pointers directly in the
/// data structure. This matches AmigaOS Exec's MinList/MinNode pattern exactly
/// and uses native Exec list functions for operations.
///
/// ## AmigaOS Compatibility
/// The list head is a MinList and nodes must have a MinNode as their FIRST field.
/// Operations use Exec's AddHead, AddTail, Remove, RemHead, RemTail functions
/// for maximum compatibility and performance.
///
/// ## Memory Model
/// - Zero allocation overhead - nodes contain their own links
/// - Nodes can only be in ONE list at a time
/// - List does NOT own the nodes - caller manages node lifetime
///
/// ## Example
/// ```novus
/// struct MyData {
///     node: MinNode,  // MUST be first field
///     value: u32,
/// }
///
/// var list = IntrusiveList::<MyData>::new()
/// list.init()  // MUST call after assignment
/// var item = MyData { node: MinNode { mln_Succ: null, mln_Pred: null }, value: 42 }
/// list.add_tail(&item)
/// ```
///
/// ## Safety
/// The caller must ensure:
/// - Nodes outlive the list operations
/// - A node is not added to multiple lists simultaneously
/// - Nodes are removed before being freed
pub struct IntrusiveList<T> {
    /// The list value stored by `IntrusiveList`.
    list: MinList,
}

impl<T> IntrusiveList<T> {
    /// Create a new empty intrusive list
    ///
    /// IMPORTANT: The returned list must be stored in its final location before use.
    /// After assignment, call init() to set up the internal pointers correctly.
    ///
    /// Example:
    /// ```novus
    /// var list = IntrusiveList::<MyData>::new()
    /// list.init()  // MUST call after assignment
    /// ```
    pub fn new() -> IntrusiveList<T> {
        // Return with null pointers - caller MUST call init() after assignment
        // This avoids the self-referential pointer invalidation problem that occurs
        // when returning a struct by value with pointers to its own fields.
        return IntrusiveList {
            list: MinList {
                mlh_Head: null,
                mlh_Tail: null,
                mlh_TailPred: null,
            },
        }
    }

    /// Initialize the list's internal pointers
    ///
    /// MUST be called after the list is at its final memory location.
    /// This sets up the self-referential pointers that make the list work.
    /// This is equivalent to AmigaOS's NewList() macro.
    pub fn init(&var self) {
        // Set up the circular pointers for empty list
        // Head points to address of Tail (which is null, acting as end marker)
        // TailPred points to address of Head
        self.list.mlh_Head = (*MinNode)&self.list.mlh_Tail
        self.list.mlh_Tail = null  // End marker
        self.list.mlh_TailPred = (*MinNode)&self.list.mlh_Head
    }

    /// Check if the list is empty
    pub fn is_empty(&self) -> bool {
        // List is empty when Head points to the Tail marker (mlh_Tail field address)
        return self.list.mlh_Head == (*MinNode)&self.list.mlh_Tail
    }

    /// Add a node to the head of the list
    ///
    /// Uses Exec's AddHead function.
    /// The node's first field must be a MinNode.
    pub fn add_head(&var self, node: *T) {
        // Cast MinList/MinNode to List/Node for Exec function
        // This is safe because the pointer layout is identical
        AddHead((*List)&self.list, (*Node)node)
    }

    /// Add a node to the tail of the list
    ///
    /// Uses Exec's AddTail function.
    /// The node's first field must be a MinNode.
    pub fn add_tail(&var self, node: *T) {
        AddTail((*List)&self.list, (*Node)node)
    }

    /// Remove and return the head node
    ///
    /// Uses Exec's RemHead function.
    /// Returns None if the list is empty.
    pub fn remove_head(&var self) -> Option<*T> {
        let node = RemHead((*List)&self.list)
        if node == null {
            return Option::None
        }
        return Option::Some((*T)node)
    }

    /// Remove and return the tail node
    ///
    /// Uses Exec's RemTail function.
    /// Returns None if the list is empty.
    pub fn remove_tail(&var self) -> Option<*T> {
        let node = RemTail((*List)&self.list)
        if node == null {
            return Option::None
        }
        return Option::Some((*T)node)
    }

    /// Remove a specific node from the list
    ///
    /// Uses Exec's Remove function.
    /// The node must be in this list. Removing a node not in the list
    /// or removing the same node twice is undefined behavior.
    pub fn remove(&var self, node: *T) {
        Remove((*Node)node)
    }

    /// Get the first node without removing it
    ///
    /// Returns None if the list is empty.
    pub fn first(&self) -> Option<*T> {
        if self.is_empty() {
            return Option::None
        }
        return Option::Some((*T)self.list.mlh_Head)
    }

    /// Get the last node without removing it
    ///
    /// Returns None if the list is empty.
    pub fn last(&self) -> Option<*T> {
        if self.is_empty() {
            return Option::None
        }
        return Option::Some((*T)self.list.mlh_TailPred)
    }

    /// Insert a node after another node
    ///
    /// Uses Exec's Insert function.
    /// Both nodes must have MinNode as their first field.
    pub fn insert_after(&var self, after: *T, node: *T) {
        // Exec's Insert inserts AFTER the pred node
        Insert((*List)&self.list, (*Node)node, (*Node)after)
    }

    /// Insert a node before another node
    ///
    /// Both nodes must have MinNode as their first field.
    pub fn insert_before(&var self, before: *T, node: *T) {
        let before_min = (*MinNode)before
        let min_node = (*MinNode)node

        // New node's links
        min_node.mln_Succ = before_min
        min_node.mln_Pred = before_min.mln_Pred

        // Update surrounding nodes
        before_min.mln_Pred.mln_Succ = min_node
        before_min.mln_Pred = min_node
    }

    /// Get the raw MinList pointer for AmigaOS interop
    ///
    /// Use this when you need to pass the list to Exec functions.
    pub fn as_min_list(&var self) -> *MinList {
        return &var self.list
    }

    /// Get the next node in the list
    ///
    /// Returns None if node is the last node.
    pub fn next(&self, node: *T) -> Option<*T> {
        let min_node = (*MinNode)node
        let next = min_node.mln_Succ

        // Check if next is the tail marker (end of list)
        if next == (*MinNode)&self.list.mlh_Tail {
            return Option::None
        }
        return Option::Some((*T)next)
    }

    /// Get the previous node in the list
    ///
    /// Returns None if node is the first node.
    pub fn prev(&self, node: *T) -> Option<*T> {
        let min_node = (*MinNode)node
        let prev = min_node.mln_Pred

        // Check if prev is the head marker (start of list)
        if prev == (*MinNode)&self.list.mlh_Head {
            return Option::None
        }
        return Option::Some((*T)prev)
    }

    /// Count the number of nodes in the list
    ///
    /// This is O(n) - use sparingly.
    pub fn len(&self) -> u32 {
        var count: u32 = 0
        var current = self.list.mlh_Head

        // Walk until we hit the tail marker
        while current != (*MinNode)&self.list.mlh_Tail {
            count = count + 1
            current = current.mln_Succ
        }

        return count
    }
}

/// Helper function to initialize a MinNode
pub fn init_min_node(node: *MinNode) {
    node.mln_Succ = null
    node.mln_Pred = null
}

// ============================================================================
// PriorityList - Uses full Node with priority support
// ============================================================================

/// PriorityList - AmigaOS-compatible priority-sorted intrusive list
///
/// Like IntrusiveList, but uses full Node (with type, priority, name fields)
/// and supports priority-based insertion via Exec's Enqueue function.
///
/// ## Node Requirements
/// Nodes must have a Node (not MinNode) as their FIRST field:
/// ```novus
/// struct MyTask {
///     node: Node,  // Full node with priority
///     data: u32,
/// }
/// ```
///
/// ## Priority Ordering
/// Higher priority values are closer to the head of the list.
/// Nodes with equal priority maintain FIFO order.
pub struct PriorityList<T> {
    /// The list value stored by `PriorityList`.
    list: List,
}

impl<T> PriorityList<T> {
    /// Create a new empty priority list
    ///
    /// IMPORTANT: Call init() after assignment.
    pub fn new() -> PriorityList<T> {
        return PriorityList {
            list: List {
                lh_Head: null,
                lh_Tail: null,
                lh_TailPred: null,
                lh_Type: 0,
                l_pad: 0,
            },
        }
    }

    /// Initialize the list's internal pointers
    ///
    /// MUST be called after the list is at its final memory location.
    pub fn init(&var self) {
        self.list.lh_Head = (*Node)&self.list.lh_Tail
        self.list.lh_Tail = null
        self.list.lh_TailPred = (*Node)&self.list.lh_Head
    }

    /// Check if the list is empty
    pub fn is_empty(&self) -> bool {
        return self.list.lh_Head == (*Node)&self.list.lh_Tail
    }

    /// Insert a node in priority order
    ///
    /// Uses Exec's Enqueue function.
    /// The node is inserted based on its ln_Pri field.
    /// Higher priority nodes are closer to the head.
    pub fn enqueue(&var self, node: *T) {
        Enqueue(&self.list, (*Node)node)
    }

    /// Add a node to the head (ignores priority)
    pub fn add_head(&var self, node: *T) {
        AddHead(&self.list, (*Node)node)
    }

    /// Add a node to the tail (ignores priority)
    pub fn add_tail(&var self, node: *T) {
        AddTail(&self.list, (*Node)node)
    }

    /// Remove and return the head node (highest priority)
    pub fn remove_head(&var self) -> Option<*T> {
        let node = RemHead(&self.list)
        if node == null {
            return Option::None
        }
        return Option::Some((*T)node)
    }

    /// Remove and return the tail node (lowest priority)
    pub fn remove_tail(&var self) -> Option<*T> {
        let node = RemTail(&self.list)
        if node == null {
            return Option::None
        }
        return Option::Some((*T)node)
    }

    /// Remove a specific node
    pub fn remove(&var self, node: *T) {
        Remove((*Node)node)
    }

    /// Get the first (highest priority) node without removing
    pub fn first(&self) -> Option<*T> {
        if self.is_empty() {
            return Option::None
        }
        return Option::Some((*T)self.list.lh_Head)
    }

    /// Get the last (lowest priority) node without removing
    pub fn last(&self) -> Option<*T> {
        if self.is_empty() {
            return Option::None
        }
        return Option::Some((*T)self.list.lh_TailPred)
    }

    /// Get the next node in the list
    pub fn next(&self, node: *T) -> Option<*T> {
        let n = (*Node)node
        let next = n.ln_Succ
        if next == (*Node)&self.list.lh_Tail {
            return Option::None
        }
        return Option::Some((*T)next)
    }

    /// Get the previous node in the list
    pub fn prev(&self, node: *T) -> Option<*T> {
        let n = (*Node)node
        let prev = n.ln_Pred
        if prev == (*Node)&self.list.lh_Head {
            return Option::None
        }
        return Option::Some((*T)prev)
    }

    /// Get the raw List pointer for AmigaOS interop
    pub fn as_list(&var self) -> *List {
        return &var self.list
    }

    /// Count nodes (O(n))
    pub fn len(&self) -> u32 {
        var count: u32 = 0
        var current = self.list.lh_Head
        while current != (*Node)&self.list.lh_Tail {
            count = count + 1
            current = current.ln_Succ
        }
        return count
    }
}

/// Helper to initialize a Node with priority
pub fn init_node(node: *Node, priority: i8, name: *u8) {
    node.ln_Succ = null
    node.ln_Pred = null
    node.ln_Type = 0
    node.ln_Pri = priority
    node.ln_Name = name
}
