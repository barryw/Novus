// Novus Standard Library - Exec (High-Level)
// Namespace: amiga::sys::exec
//
// High-level wrappers for exec.library functions
// For low-level FFI access, use amiga::raw::exec
//
// NOTE: For memory management, prefer using std::mem::MemoryBlock instead of AllocMem/FreeMem directly

from std::core import Option, Result, Drop
from std::string import Str
from amiga::sys::exec::errors import ExecError
from amiga::raw::structs import *
from amiga::raw::exec import AllocMem, FreeMem, AllocVec, FreeVec, CopyMem
from amiga::raw::exec import FindTask, SetTaskPri, AllocSignal, FreeSignal, Wait, Signal
from amiga::raw::exec import Forbid, Permit, Disable, Enable
from amiga::raw::exec import OpenLibrary, CloseLibrary
from amiga::raw::exec import CreateMsgPort, DeleteMsgPort, GetMsg, PutMsg, ReplyMsg
from amiga::raw::exec import InitSemaphore, ObtainSemaphore, ReleaseSemaphore, AttemptSemaphore, ObtainSemaphoreShared, AttemptSemaphoreShared
from amiga::raw::exec import __novus_init_semaphore, __novus_obtain_semaphore, __novus_release_semaphore, __novus_attempt_semaphore, __novus_obtain_semaphore_shared, __novus_attempt_semaphore_shared
from amiga::raw::exec import __novus_add_semaphore, __novus_rem_semaphore, __novus_find_semaphore
from amiga::raw::consts import MEMF_ANY, MEMF_PUBLIC, MEMF_CHIP, MEMF_FAST, MEMF_LOCAL, MEMF_24BITDMA, MEMF_KICK, MEMF_CLEAR, MEMF_LARGEST, MEMF_REVERSE

// ============================================================================
// Task Management
// ============================================================================

/// Get pointer to the current task
///
/// Returns None if called from interrupt context (no current task).
///
/// Example:
/// ```novus
/// from amiga::sys::exec import get_current_task
///
/// match get_current_task() {
///     Some(task) => {
///         // Use task pointer
///     },
///     None => {
///         // No task (interrupt context?)
///     }
/// }
/// ```
pub fn get_current_task() -> Option<*Task> {
    if let task = FindTask(null) {
        return Option::Some(task)
    }
    return Option::None
}

/// Find a task by name
///
/// Returns Some(task) if found, None otherwise.
///
/// Example:
/// ```novus
/// from amiga::sys::exec import find_task
///
/// match find_task("My Task".ptr) {
///     Some(task) => {
///         // Found the task
///     },
///     None => {
///         // Task not found
///     }
/// }
/// ```
pub fn find_task(name: Str) -> Option<*Task> {
    if let task = FindTask(name.as_cstr()) {
        return Option::Some(task)
    }
    return Option::None
}

/// Set task priority
///
/// Returns the old priority.
/// Priority range is typically -128 to 127, with higher being more important.
///
/// Example:
/// ```novus
/// from amiga::sys::exec import get_current_task, set_task_priority
///
/// if let Some(task) = get_current_task() {
///     let old_pri = set_task_priority(task, 10)  // Raise to priority 10
/// }
/// ```
pub fn set_task_priority(task: *Task, priority: i32) -> i8 {
    return SetTaskPri(task, priority)
}

// ============================================================================
// Signals
// ============================================================================

/// Allocate a signal bit
///
/// Returns a signal bit number (0-31), or `BadSignal` if none are available.
/// Pass -1 to allocate any available signal.
///
/// Example:
/// ```novus
/// from amiga::sys::exec import allocate_signal, free_signal
///
/// match allocate_signal(-1) {
///     Result::Ok(sig) => {
///         defer {
///             free_signal(sig)
///         }
///         // Use signal bit
///         let signal_mask = 1 << sig
///     },
///     Result::Err(_) => {
///         // No signals available
///     }
/// }
/// ```
pub fn allocate_signal(signal_num: i32) -> Result<i32, ExecError> {
    var result = AllocSignal(signal_num)
    return if result == -1 { Result::Err(ExecError::BadSignal) } else { Result::Ok(result) }
}

/// Free a previously allocated signal
///
/// Should be called for every successfully allocated signal.
/// Best used with defer for automatic cleanup.
pub fn free_signal(signal_num: i32) {
    FreeSignal(signal_num)
}

/// Wait for one or more signals
///
/// Blocks until at least one of the specified signals arrives.
/// Returns the mask of signals that arrived.
///
/// Example:
/// ```novus
/// from amiga::sys::exec import wait_for_signals
///
/// let signal_mask = 1 << 4  // Wait for signal bit 4
/// let received = wait_for_signals(signal_mask)
/// if (received & signal_mask) != 0 {
///     // Signal 4 arrived
/// }
/// ```
@suppress("W0002", "exec.library Wait() requires i32 signal mask per FFI conventions. Safe: signal bits are 0-31")
pub fn wait_for_signals(signal_mask: u32) -> u32 {
    return Wait((i32)signal_mask)
}

/// Send a signal to a task
///
/// The target task will wake up if it's waiting on this signal.
///
/// Example:
/// ```novus
/// from amiga::sys::exec import find_task, send_signal
///
/// if let Some(task) = find_task("My Task".ptr) {
///     let signal_mask = 1 << 4
///     send_signal(task, signal_mask)
/// }
/// ```
pub fn send_signal(task: *Task, signal_mask: u32) {
    Signal(task, signal_mask)
}

// ============================================================================
// Critical Sections
// ============================================================================

/// Disable task rescheduling
///
/// Prevents other tasks from running until Permit() is called.
/// Can be nested - must call Permit() the same number of times as Forbid().
/// Does NOT disable interrupts.
///
/// IMPORTANT: Keep Forbid()den sections as short as possible!
///
/// Example:
/// ```novus
/// from amiga::sys::exec import forbid, permit
///
/// forbid()
/// defer {
///     permit()  // Automatically permit when leaving scope
/// }
/// // Critical section - no task switches
/// ```
pub fn forbid() {
    Forbid()

}

/// Re-enable task rescheduling
///
/// Must be paired with every Forbid() call.
pub fn permit() {
    Permit()
}

/// Disable all interrupts
///
/// EXTREMELY DANGEROUS - system will hang if held too long!
/// Must be paired with Enable().
/// Can be nested.
///
/// Only use when absolutely necessary (e.g., hardware access that can't be interrupted).
///
/// Example:
/// ```novus
/// from amiga::sys::exec import disable, enable
///
/// disable()
/// defer {
///     enable()  // Automatically enable when leaving scope
/// }
/// // VERY brief critical section
/// ```
pub fn disable() {
    unsafe {
        Disable()
    }
}

/// Re-enable interrupts
///
/// Must be paired with every Disable() call.
pub fn enable() {
    unsafe {
        Enable()
    }
}

// ============================================================================
// RAII Resource Wrappers (Automatic Cleanup)
// ============================================================================

/// SignalHandle - RAII wrapper for Exec signal bits
///
/// Automatically frees the signal when it goes out of scope.
/// This prevents signal exhaustion (only 16 user signals available per task).
///
/// Example:
/// ```novus
/// fn wait_for_event() -> Result<(), ExecError> {
///     let signal = SignalHandle::alloc()?;
///     let mask = signal.mask();
///
///     // Wait for event
///     wait_for_signals(mask);
///
///     // Signal automatically freed here!
/// }
/// ```
pub struct SignalHandle {
    sigbit: i8,  // Signal bit number (-1 = invalid)
}

impl SignalHandle {
    /// Allocate a signal bit
    ///
    /// Returns Err if no signals are available (limit of 16 user signals).
    @suppress("W0002", "Safe: AllocSignal returns -1 or 0-31, which fits in i8 range (-128 to 127)")
    pub fn alloc() -> Result<SignalHandle, ExecError> {
        let sigbit = AllocSignal(-1)
        return if sigbit == -1 { Result::Err(ExecError::BadSignal) } else { Result::Ok(SignalHandle { sigbit: sigbit }) }
    }

    /// Get the signal bit number (0-31)
    pub fn bit(&self) -> i8 {
        return self.sigbit
    }

    /// Create SignalHandle from raw signal bit (takes ownership)
    ///
    /// The signal will be automatically freed when the SignalHandle is dropped.
    /// Only use this if you own the signal and it should be freed.
    ///
    /// DO NOT use for system signals like SIGBREAKF_CTRL_C.
    pub fn from_raw(sigbit: i8) -> Result<SignalHandle, ExecError> {
        return Result::Err(ExecError::BadSignal) unless sigbit >= 0 && sigbit < 32
        return Result::Ok(SignalHandle { sigbit: sigbit })
    }

    /// Extract raw signal bit and prevent automatic free
    ///
    /// This transfers ownership to the caller. The caller is responsible
    /// for freeing the signal manually.
    ///
    /// Use this when passing ownership to another task or storing
    /// the signal beyond the current scope.
    pub fn into_raw(consuming self) -> i8 {
        let sigbit = self.sigbit
        self.sigbit = -1
        return sigbit
    }

    /// Get the signal mask (1 << bit)
    ///
    /// This is the value to pass to Wait() or Signal().
    @suppress("W0002", "Safe: sigbit is validated to be 0-31 (negative check at line 296), guaranteed to fit in u32 range for array indexing")
    pub fn mask(&self) -> u32 {
        if self.sigbit < 0 {
            return 0
        }
        // Use pow2 lookup table instead of shift to work around parser bug with << after if
        let shifts: [u32] = [1, 2, 4, 8, 16, 32, 64, 128,
            256, 512, 1024, 2048, 4096, 8192, 16384, 32768,
            65536, 131072, 262144, 524288, 1048576, 2097152, 4194304, 8388608,
            16777216, 33554432, 67108864, 134217728, 268435456, 536870912, 1073741824, 2147483648
        ]
        return shifts[(u32)self.sigbit]
    }

    /// Wait for this signal
    ///
    /// Blocks until the signal arrives.
    pub fn wait(&self) -> u32 {
        // Call mask() which handles the bit shift
        return Wait(self.mask())
    }

    /// Send this signal to a task
    pub fn send_to(&self, task: *Task) {
        Signal(task, self.mask())
    }
}

// Automatic cleanup for SignalHandle (RAII)
impl Drop for SignalHandle {
    fn drop(&var self) {
        if self.sigbit >= 0 {
            FreeSignal(self.sigbit)
            self.sigbit = -1
        }
    }
}

/// MsgPort - RAII wrapper for Exec message ports
///
/// Automatically drains and replies to pending messages, then deletes the port
/// when it goes out of scope. This prevents:
/// - Message port leaks
/// - Unreplied messages (which cause system hangs)
/// - "Port freed with messages still queued" crashes
///
/// Example:
/// ```novus
/// fn create_reply_port() -> Result<MsgPortHandle, ExecError> {
///     let port = MsgPortHandle::create()?;
///
///     // Use port for communication...
///
///     // Port automatically cleaned up here:
///     // 1. All pending messages are drained and replied
///     // 2. Port is deleted
/// }
/// ```
pub struct MsgPortHandle {
    port: *MsgPort,  // Pointer to FFI MsgPort struct (null = invalid)
}

impl MsgPortHandle {
    /// Create a new message port
    ///
    /// Returns Err if port creation fails (out of memory).
    pub fn create() -> Result<MsgPortHandle, ExecError> {
        if let port = CreateMsgPort() {
            return Result::Ok(MsgPortHandle { port: port })
        }
        return Result::Err(ExecError::NoMem)
    }

    /// Get the raw MsgPort pointer for FFI calls
    pub fn as_raw(&self) -> *MsgPort {
        return self.port
    }

    /// Create MsgPort from raw pointer (takes ownership)
    ///
    /// The port will be automatically deleted when the MsgPort is dropped.
    /// All pending messages will be drained and replied.
    ///
    /// Only use this if you own the port and it should be deleted.
    /// DO NOT use for system-owned ports like Window.UserPort.
    pub fn from_raw(port: *MsgPort) -> Result<MsgPortHandle, ExecError> {
        return Result::Err(ExecError::BadPort) unless port
        return Result::Ok(MsgPortHandle { port: port })
    }

    /// Extract raw pointer and prevent automatic deletion
    ///
    /// This transfers ownership to the caller. The caller is responsible
    /// for draining messages and deleting the port manually.
    ///
    /// Use this when passing ownership to another task or storing
    /// the port beyond the current scope.
    pub fn into_raw(consuming self) -> *MsgPort {
        let port = self.port
        self.port = null
        return port
    }

    /// Get a message from the port (non-blocking)
    ///
    /// Returns None if no messages are waiting.
    pub fn get_msg(&self) -> Option<*Message> {
        if let msg = GetMsg(self.port) {
            return Option::Some(msg)
        }
        return Option::None
    }

    /// Put a message to this port
    ///
    /// The message will be queued until GetMsg() retrieves it.
    pub fn put_msg(&self, msg: *Message) {
        PutMsg(self.port, msg)
    }

    /// Reply to a message
    ///
    /// Should be called for every message received via get_msg().
    pub fn reply_msg(&self, msg: *Message) {
        ReplyMsg(msg)
    }

    /// Drain and reply to all pending messages
    ///
    /// This is called automatically by Drop, but can be called manually
    /// if you need to drain messages before the port is destroyed.
    pub fn drain_messages(&self) {
        forever {
            if let msg = GetMsg(self.port) {
                ReplyMsg(msg)
            } else {
                break
            }
        }
    }

    /// Get the signal bit for this port
    ///
    /// Returns the signal bit number (0-31) that this port uses.
    pub fn signal_bit(&self) -> u8 {
        return (*self.port).mp_SigBit
    }

    /// Get the signal mask for this port
    ///
    /// Returns a bitmask suitable for passing to Wait() or Signal().
    /// This is (1 << signal_bit).
    ///
    /// Example:
    /// ```novus
    /// let port = MsgPortHandle::create()?
    /// let mask = port.signal_mask()
    /// Wait(mask)  // Wait for message to arrive
    /// let msg = port.get_msg()
    /// ```
    pub fn signal_mask(&self) -> u32 {
        // Use lookup table to avoid shift operator issues
        let shifts: [u32] = [1, 2, 4, 8, 16, 32, 64, 128,
            256, 512, 1024, 2048, 4096, 8192, 16384, 32768,
            65536, 131072, 262144, 524288, 1048576, 2097152, 4194304, 8388608,
            16777216, 33554432, 67108864, 134217728, 268435456, 536870912, 1073741824, 2147483648
        ]
        return shifts[(u32)(*self.port).mp_SigBit]
    }

    /// Wait for a message to arrive on this port
    ///
    /// Blocks until a message is available. Returns the signal mask that was received.
    pub fn wait(&self) -> u32 {
        return Wait(self.signal_mask())
    }
}

// Automatic cleanup for MsgPort (RAII)
impl Drop for MsgPortHandle {
    fn drop(&var self) {
        if let p = self.port {
            self.drain_messages()

            // Now safe to delete the port
            DeleteMsgPort(p)
            self.port = null
        }
    }
}

// ============================================================================
// Semaphores
// ============================================================================

/// SemaphoreHandle - RAII wrapper for Exec signal semaphores
///
/// Provides mutual exclusion for shared resources between tasks.
/// Use `lock()` or `try_lock()` to get an exclusive SemaphoreGuard.
/// Use `lock_shared()` or `try_lock_shared()` to get a SharedSemaphoreGuard.
///
/// ## Exclusive vs Shared Locks
/// - Exclusive locks (lock/try_lock): Only one task can hold at a time
/// - Shared locks (lock_shared/try_lock_shared): Multiple tasks can hold simultaneously,
///   but blocks if any task holds an exclusive lock
///
/// ## Example
/// ```novus
/// from amiga::sys::exec import SemaphoreHandle
///
/// fn use_shared_resource() {
///     match SemaphoreHandle::new() {
///         Result::Ok(sem) => {
///             let guard = sem.lock()  // Blocks until semaphore is available
///             // Critical section - exclusive access to shared resource
///             // ...
///         }  // Semaphore automatically released here
///         Result::Err(_) => {
///             // Failed to allocate semaphore
///         }
///     }
/// }
/// ```
pub struct SemaphoreHandle {
    sem: *u8,       // Pointer to allocated semaphore (void* to avoid FFI type in header)
    is_public: bool, // Whether this is a public (named) semaphore
    owns_memory: bool, // Whether we should free the memory on drop
}

impl SemaphoreHandle {
    /// Create a new private semaphore
    ///
    /// Returns an allocation error if the semaphore cannot be created.
    /// The semaphore starts in the "available" state.
    pub fn new() -> Result<SemaphoreHandle, ExecError> {
        // Allocate zeroed memory for the semaphore
        let sem_size: u32 = @sizeof(SignalSemaphore)
        let sem_mem = unsafe { AllocMem(sem_size, MEMF_PUBLIC | MEMF_CLEAR) }

        // Check allocation
        if (u32)sem_mem == 0 {
            return Result::Err(ExecError::NoMem)
        }

        // Initialize the semaphore
        unsafe {
            __novus_init_semaphore(sem_mem)
        }

        return Result::Ok(SemaphoreHandle { sem: sem_mem, is_public: false, owns_memory: true })
    }

    /// Create a new public (named) semaphore
    ///
    /// Public semaphores are added to the system's semaphore list and can be
    /// found by other tasks using `find()`. The name must remain valid for
    /// the lifetime of the semaphore.
    ///
    /// Returns an allocation error if the semaphore cannot be created.
    ///
    /// ## Example
    /// ```novus
    /// // In task 1: Create a public semaphore
    /// let sem = SemaphoreHandle::new_public("MySemaphore", 0)?
    ///
    /// // In task 2: Find and use the semaphore
    /// let sem = SemaphoreHandle::find("MySemaphore")?
    /// let guard = sem.lock()
    /// // Critical section...
    /// ```
    pub fn new_public(name: *u8, priority: i8) -> Result<SemaphoreHandle, ExecError> {
        // Allocate zeroed memory for the semaphore
        let sem_size: u32 = @sizeof(SignalSemaphore)
        let sem_mem = unsafe { AllocMem(sem_size, MEMF_PUBLIC | MEMF_CLEAR) }

        // Check allocation
        if (u32)sem_mem == 0 {
            return Result::Err(ExecError::NoMem)
        }

        // Initialize the semaphore
        unsafe {
            __novus_init_semaphore(sem_mem)
        }

        // Set up the node for the public semaphore list
        // Node layout: ln_Succ(4) + ln_Pred(4) + ln_Type(1) + ln_Pri(1) + ln_Name(4)
        // ln_Pri is at offset 9, ln_Name is at offset 10
        let pri_ptr: *i8 = (*i8)(sem_mem + 9)
        let name_ptr: **u8 = (**u8)(sem_mem + 10)
        *pri_ptr = priority
        *name_ptr = name

        // Add to public semaphore list
        unsafe {
            __novus_add_semaphore(sem_mem)
        }

        return Result::Ok(SemaphoreHandle { sem: sem_mem, is_public: true, owns_memory: true })
    }

    /// Find an existing public semaphore by name
    ///
    /// Returns Some(handle) if found, None if not found.
    /// The returned handle does NOT own the semaphore - it will not be freed
    /// when this handle is dropped.
    ///
    /// ## Warning
    /// The returned handle is a non-owning reference. The actual semaphore
    /// owner must outlive all find() handles.
    pub fn find(name: *u8) -> Option<SemaphoreHandle> {
        let sem_ptr: *u8 = unsafe { __novus_find_semaphore(name) }

        if (u32)sem_ptr == 0 {
            return Option::None
        }

        // Return non-owning handle - we don't own the semaphore memory
        return Option::Some(SemaphoreHandle { sem: sem_ptr, is_public: false, owns_memory: false })
    }

    /// Obtain exclusive access to the semaphore (blocking)
    ///
    /// Blocks until the semaphore is available. Returns a guard that
    /// automatically releases the semaphore when dropped.
    ///
    /// Semaphores can be nested - the same task can obtain the same
    /// semaphore multiple times (must release the same number of times).
    pub fn lock(&self) -> SemaphoreGuard {
        unsafe {
            __novus_obtain_semaphore(self.sem)
        }
        return SemaphoreGuard { sem: self.sem, owner: self }
    }

    /// Try to obtain exclusive access without blocking
    ///
    /// Returns Some(guard) if successful, None if semaphore is held by another task.
    pub fn try_lock(&self) -> Option<SemaphoreGuard> {
        let result = unsafe { __novus_attempt_semaphore(self.sem) }
        if result != 0 {
            return Option::Some(SemaphoreGuard { sem: self.sem, owner: self })
        }
        return Option::None
    }

    /// Obtain shared (read) access to the semaphore (blocking)
    ///
    /// Multiple tasks can hold shared access simultaneously.
    /// Blocks if another task holds exclusive access.
    ///
    /// WARNING: Unlike exclusive locks, shared locks are NOT nestable from the
    /// same task. Calling lock_shared() twice from the same task without
    /// releasing the first lock will deadlock. Use lock() for nestable locking.
    pub fn lock_shared(&self) -> SharedSemaphoreGuard {
        unsafe {
            __novus_obtain_semaphore_shared(self.sem)
        }
        return SharedSemaphoreGuard { sem: self.sem, owner: self }
    }

    /// Try to obtain shared (read) access without blocking
    ///
    /// Returns Some(guard) if successful, None if semaphore is exclusively held.
    ///
    /// WARNING: Unlike exclusive locks, shared locks are NOT nestable from the
    /// same task. Calling try_lock_shared() twice from the same task without
    /// releasing the first lock may succeed but will deadlock on release.
    pub fn try_lock_shared(&self) -> Option<SharedSemaphoreGuard> {
        let result = unsafe { __novus_attempt_semaphore_shared(self.sem) }
        if result != 0 {
            return Option::Some(SharedSemaphoreGuard { sem: self.sem, owner: self })
        }
        return Option::None
    }

}

// Automatic cleanup for SemaphoreHandle (RAII)
impl Drop for SemaphoreHandle {
    fn drop(&var self) {
        if (u32)self.sem != 0 && self.owns_memory {
            // Remove from public list if this is a public semaphore we own
            if self.is_public {
                unsafe {
                    __novus_rem_semaphore(self.sem)
                }
            }

            // Free the semaphore memory
            let sem_size: u32 = @sizeof(SignalSemaphore)
            unsafe {
                FreeMem(self.sem, sem_size)
            }
            self.sem = null
        }
    }
}

/// SemaphoreGuard - RAII guard for exclusive semaphore access
///
/// When dropped, automatically releases the semaphore.
/// This ensures you can't forget to release the semaphore.
pub struct SemaphoreGuard {
    sem: *u8,  // Pointer to semaphore (non-owning, void* to avoid FFI type in header)
    owner: &SemaphoreHandle,
}

// Automatic release for SemaphoreGuard (RAII)
impl Drop for SemaphoreGuard {
    fn drop(&var self) {
        if (u32)self.sem != 0 {
            unsafe {
                __novus_release_semaphore(self.sem)
            }
            self.sem = null
        }
    }
}

/// SharedSemaphoreGuard - RAII guard for shared (read) semaphore access
///
/// When dropped, automatically releases the shared lock.
/// Multiple tasks can hold SharedSemaphoreGuard simultaneously.
///
/// This is a separate type from SemaphoreGuard for type safety - you can't
/// accidentally treat shared access as exclusive access.
pub struct SharedSemaphoreGuard {
    sem: *u8,  // Pointer to semaphore (non-owning)
    owner: &SemaphoreHandle,
}

// Automatic release for SharedSemaphoreGuard (RAII)
impl Drop for SharedSemaphoreGuard {
    fn drop(&var self) {
        if (u32)self.sem != 0 {
            unsafe {
                __novus_release_semaphore(self.sem)
            }
            self.sem = null
        }
    }
}

// ============================================================================
// ScopedData<T> - Semaphore-protected data
// ============================================================================

/// ScopedData<T> - Data protected by a semaphore
///
/// Combines a semaphore with the data it protects. You can only access
/// the data by first obtaining a lock, which ensures thread-safe access.
///
/// ## Example
/// ```novus
/// // Create protected counter
/// var counter = ScopedData::<u32>::new(0)?
///
/// // In task 1:
/// {
///     var guard = counter.lock()
///     let value = *guard.get()
///     guard.set(value + 1)
/// }  // Lock automatically released
///
/// // In task 2 (read-only access):
/// {
///     let guard = counter.lock_shared()
///     let value = *guard.get()
///     // Can read but not modify
/// }
/// ```
pub struct ScopedData<T> {
    sem: *u8,    // Semaphore protecting the data
    data: T,     // The protected data
}

impl<T> ScopedData<T> {
    /// Create new semaphore-protected data
    ///
    /// Returns an allocation error if the semaphore cannot be created.
    pub fn new(consuming initial_value: T) -> Result<ScopedData<T>, ExecError> {
        // Allocate zeroed memory for the semaphore
        let sem_size: u32 = @sizeof(SignalSemaphore)
        let sem_mem = unsafe { AllocMem(sem_size, MEMF_PUBLIC | MEMF_CLEAR) }

        // Check allocation
        if (u32)sem_mem == 0 {
            return Result::Err(ExecError::NoMem)
        }

        // Initialize the semaphore
        unsafe {
            __novus_init_semaphore(sem_mem)
        }

        return Result::Ok(ScopedData { sem: sem_mem, data: initial_value })
    }

    /// Lock for exclusive access
    ///
    /// Returns a guard that provides mutable access to the data.
    /// The lock is released when the guard is dropped.
    pub fn lock(&var self) -> ScopedDataGuard<T> {
        unsafe {
            __novus_obtain_semaphore(self.sem)
        }
        let data_ptr: &var T = &var self.data
        return ScopedDataGuard { sem: self.sem, data: data_ptr }
    }

    /// Try to lock for exclusive access
    ///
    /// Returns Some(guard) if successful, None if already locked.
    pub fn try_lock(&var self) -> Option<ScopedDataGuard<T>> {
        let result = unsafe { __novus_attempt_semaphore(self.sem) }
        if result != 0 {
            let data_ptr: &var T = &var self.data
            return Option::Some(ScopedDataGuard { sem: self.sem, data: data_ptr })
        }
        return Option::None
    }

    /// Lock for shared (read-only) access
    ///
    /// Returns a guard that provides read-only access to the data.
    /// Multiple tasks can hold shared locks simultaneously.
    pub fn lock_shared(&self) -> SharedScopedDataGuard<T> {
        unsafe {
            __novus_obtain_semaphore_shared(self.sem)
        }
        let data_ptr: &T = &self.data
        return SharedScopedDataGuard { sem: self.sem, data: data_ptr }
    }

    /// Try to lock for shared (read-only) access
    ///
    /// Returns Some(guard) if successful, None if exclusively locked.
    pub fn try_lock_shared(&self) -> Option<SharedScopedDataGuard<T>> {
        let result = unsafe { __novus_attempt_semaphore_shared(self.sem) }
        if result != 0 {
            let data_ptr: &T = &self.data
            return Option::Some(SharedScopedDataGuard { sem: self.sem, data: data_ptr })
        }
        return Option::None
    }
}

impl<T> Drop for ScopedData<T> {
    fn drop(&var self) {
        @drop_in_place(&var self.data)
        if (u32)self.sem != 0 {
            let sem_size: u32 = @sizeof(SignalSemaphore)
            unsafe {
                FreeMem(self.sem, sem_size)
            }
            self.sem = null
        }
    }
}

/// Guard for exclusive access to ScopedData
pub struct ScopedDataGuard<T> {
    sem: *u8,
    data: &var T,
}

impl<T> ScopedDataGuard<T> {
    /// Borrow the current value.
    pub fn get(&self) -> &T {
        return self.data
    }

    /// Set a new value
    pub fn set(&var self, consuming value: T) {
        @drop_in_place(self.data)
        *self.data = value
    }
}

impl<T> Drop for ScopedDataGuard<T> {
    fn drop(&var self) {
        if (u32)self.sem != 0 {
            unsafe {
                __novus_release_semaphore(self.sem)
            }
            self.sem = null
        }
    }
}

/// Guard for shared (read-only) access to ScopedData
pub struct SharedScopedDataGuard<T> {
    sem: *u8,
    data: &T,
}

impl<T> SharedScopedDataGuard<T> {
    /// Get the current value
    pub fn get(&self) -> &T {
        return self.data
    }
}

impl<T> Drop for SharedScopedDataGuard<T> {
    fn drop(&var self) {
        if (u32)self.sem != 0 {
            unsafe {
                __novus_release_semaphore(self.sem)
            }
            self.sem = null
        }
    }
}

// ============================================================================
// Library Handle - RAII wrapper for AmigaOS shared libraries
// ============================================================================

/// LibraryHandle - RAII wrapper for AmigaOS shared libraries
///
/// Automatically closes the library when it goes out of scope.
/// This prevents library leaks which can consume system resources.
///
/// Example:
/// ```novus
/// fn use_graphics_library() -> Result<(), ExecError> {
///     let gfx = LibraryHandle::open("graphics.library", 39)?
///
///     // Borrow the library base pointer for FFI calls
///     let base = gfx.as_raw()
///
///     // Library automatically closed when gfx goes out of scope!
///     return Result::Ok(())
/// }
/// ```
pub struct LibraryHandle {
    base: *Library,
    version: u32
}

impl LibraryHandle {
    /// Open a shared library by name and minimum version
    ///
    /// Returns Err if the library cannot be opened (not found, version too old).
    ///
    /// Example:
    /// ```novus
    /// let intuition = LibraryHandle::open("intuition.library", 37)?
    /// let graphics = LibraryHandle::open("graphics.library", 39)?
    /// ```
    pub fn open(name: Str, version: u32) -> Result<LibraryHandle, ExecError> {
        let base = unsafe { OpenLibrary(name.as_cstr(), version) }
        if !base {
            return Result::Err(ExecError::LibraryNotFound)
        }
        return Result::Ok(LibraryHandle { base: base, version: version })
    }

    /// Open a library with no version requirement
    ///
    /// Use this only when you need any version of the library.
    /// Prefer open() with a specific version for safety.
    pub fn open_any(name: Str) -> Result<LibraryHandle, ExecError> {
        return LibraryHandle::open(name, 0)
    }

    /// Get the library base pointer for FFI calls
    ///
    /// This is the value typically passed to library functions that
    /// need the library base (e.g., IntuitionBase, GfxBase).
    pub fn as_raw(&self) -> *Library {
        return self.base
    }

    /// Get the minimum version that was requested when opening
    pub fn version(&self) -> u32 {
        return self.version
    }

    /// Get the version of the library that Exec actually opened.
    pub fn installed_version(&self) -> u16 {
        return unsafe { (*self.base).lib_Version }
    }

    /// Get the revision of the library that Exec actually opened.
    pub fn installed_revision(&self) -> u16 {
        return unsafe { (*self.base).lib_Revision }
    }

    /// Create LibraryHandle from raw pointer (takes ownership)
    ///
    /// The library will be automatically closed when dropped.
    /// Only use this if you own the library and it should be closed.
    ///
    /// DO NOT use for system-opened libraries or libraries from
    /// other tasks/processes.
    pub fn from_raw(base: *Library, version: u32) -> Result<LibraryHandle, ExecError> {
        return Result::Err(ExecError::LibraryNotFound) unless base
        return Result::Ok(LibraryHandle { base: base, version: version })
    }

    /// Extract raw pointer and prevent automatic close
    ///
    /// This transfers ownership to the caller. The caller is responsible
    /// for closing the library manually with CloseLibrary().
    pub fn into_raw(consuming self) -> *Library {
        let base = self.base
        self.base = null
        return base
    }
}

impl Drop for LibraryHandle {
    fn drop(&var self) {
        if let b = self.base {
            unsafe { CloseLibrary(b) }
            self.base = null
        }
    }
}
