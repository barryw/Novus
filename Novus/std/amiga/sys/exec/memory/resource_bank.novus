// Resource Bank System for Proactive Chip RAM Management
// Module: amiga::sys::exec::memory::resource_bank
//
// Unlike ChipCache (reactive caching), Resource Banks provide proactive
// resource management for games with many megabytes of assets but only
// ~2MB of chip RAM. Games explicitly control what's loaded when.
//
// Features:
// - Bank builder pattern for grouping related assets
// - Shared assets can belong to multiple banks (reference counted)
// - Atomic load/unload of entire banks
// - Budget tracking and will_fit() checks

from std::core import Result, Option, Drop, Error
from std::string import Str
from amiga::sys::exec::memory::chip import Priority, ChipAsset, ChipCacheError
from amiga::sys::exec::memory::chip_cache import ChipCache
from std::collections import Vec

// ============================================================================
// Bank State
// ============================================================================

/// Current state of a resource bank
pub enum BankState {
    /// Not loaded into chip RAM
    Unloaded,
    /// Load in progress (for future async support)
    Loading,
    /// Fully loaded and pinned in chip RAM
    Loaded,
    /// Load failed
    Failed,
}

// ============================================================================
// Bank Entry
// ============================================================================

/// Maximum length of debug name for bank entries
const MAX_ENTRY_NAME_LEN: u32 = 32

/// An entry in a resource bank
///
/// Tracks a single asset within the bank, including its chip RAM state.
struct BankEntry {
    asset_id: u32,          // Unique asset identifier
    source_ptr: *u8,        // Fast RAM pointer to source data
    size: u32,              // Size in bytes
    priority: Priority,     // Cache priority
    debug_name: [u8; 32],   // Debug name
    debug_name_len: u8,     // Length of debug name
}

impl BankEntry {
    fn new(asset_id: u32, source_ptr: *u8, size: u32, priority: Priority) -> BankEntry {
        return BankEntry {
            asset_id: asset_id,
            source_ptr: source_ptr,
            size: size,
            priority: priority,
            debug_name: [0; 32],
            debug_name_len: 0,
        }
    }

    fn set_name(&var self, name: Str) {
        var max_len: u32 = MAX_ENTRY_NAME_LEN
        if name.len() < MAX_ENTRY_NAME_LEN {
            max_len = name.len()
        }
        while var i < max_len {
            self.debug_name[i] = unsafe { name.as_ptr()[i] }
            i++
        }
        self.debug_name_len = (u8)max_len
    }

    fn get_name(&self) -> Str {
        return unsafe { Str::new(&self.debug_name[0], (u32)self.debug_name_len) }
    }
}

// ============================================================================
// Bank Error
// ============================================================================

/// Errors that can occur during bank operations
pub enum BankError {
    /// Not enough chip RAM for the bank
    OutOfMemory,
    /// Bank is not loaded
    NotLoaded,
    /// Bank is already loaded
    AlreadyLoaded,
    /// Asset not found in bank
    AssetNotFound,
    /// Bank has too many entries
    TooManyEntries,
}

impl BankError {
    /// Returns a human-readable description of this error.
    ///
    /// # Returns
    /// The resulting `*u8` value.
    pub fn message(&self) -> *u8 {
        match *self {
            BankError::OutOfMemory => return "Out of chip RAM",
            BankError::NotLoaded => return "Bank not loaded",
            BankError::AlreadyLoaded => return "Bank already loaded",
            BankError::AssetNotFound => return "Asset not found in bank",
            BankError::TooManyEntries => return "Too many bank entries",
        }
    }
}

impl Error for BankError {
    fn message(&self) -> *u8 {
        return BankError::message(self)
    }
}

// ============================================================================
// Resource Bank
// ============================================================================

/// Maximum entries per bank
const MAX_BANK_ENTRIES: u32 = 64

/// A group of related assets that load/unload together
///
/// Resource banks provide proactive chip RAM management. Unlike ChipCache
/// (which caches on use), banks load explicitly when you need them.
///
/// # Usage
/// ```novus
/// // Create a bank with the builder
/// let level1 = ResourceBank::builder("level1")
///     .add(&player_sprites)
///     .add(&enemy_sprites)
///     .add(&tileset)
///     .build()?
///
/// // Load when entering level
/// level1.load()?
///
/// // Get chip RAM pointer for DMA
/// let chip_ptr = level1.get(&player_sprites)?
///
/// // Unload when leaving level
/// level1.unload()
/// ```
pub struct ResourceBank {
    /// The name value stored by `ResourceBank`.
    name: [u8; 32],
    /// The name len value stored by `ResourceBank`.
    name_len: u8,
    /// The entries value stored by `ResourceBank`.
    entries: [BankEntry; 64],
    /// The entry count value stored by `ResourceBank`.
    entry_count: u32,
    /// The state value stored by `ResourceBank`.
    state: BankState,
    /// The total size value stored by `ResourceBank`.
    total_size: u32,
    /// The persistent value stored by `ResourceBank`.
    persistent: bool,       // If true, never auto-unload
}

impl ResourceBank {
    /// Create a new bank builder
    pub fn builder(name: Str) -> BankBuilder {
        return BankBuilder::new(name)
    }

    /// Create an empty bank with a name
    fn new(name: Str) -> ResourceBank {
        var bank: ResourceBank = unsafe { @zeroed(ResourceBank) }
        bank.state = BankState::Unloaded

        // Copy name
        var max_len: u32 = 32
        if name.len() < 32 {
            max_len = name.len()
        }
        while var i < max_len {
            bank.name[i] = unsafe { name.as_ptr()[i] }
            i++
        }
        bank.name_len = (u8)max_len

        return bank
    }

    /// Get the bank name
    pub fn name(&self) -> Str {
        return unsafe { Str::new(&self.name[0], (u32)self.name_len) }
    }

    /// Get current state
    pub fn state(&self) -> BankState {
        return self.state
    }

    /// Check if bank is loaded
    pub fn is_loaded(&self) -> bool {
        match self.state {
            BankState::Loaded => true,
            _ => false,
        }
    }

    /// Get total size of all assets in bytes
    pub fn total_size(&self) -> u32 {
        return self.total_size
    }

    /// Get number of entries in the bank
    pub fn entry_count(&self) -> u32 {
        return self.entry_count
    }

    /// Check if this bank is marked as persistent
    pub fn is_persistent(&self) -> bool {
        return self.persistent
    }

    /// Load all assets into chip RAM
    ///
    /// This pins all assets via ChipCache's reference counting.
    /// Assets shared with other banks will have their pin count incremented.
    pub fn load(&var self) -> Result<(), BankError> {
        match self.state {
            BankState::Loaded => return Result::Err(BankError::AlreadyLoaded),
            BankState::Loading => return Result::Err(BankError::AlreadyLoaded),
            _ => {}
        }

        self.state = BankState::Loading

        // Load each entry via ChipCache
        while var i < self.entry_count {
            let entry = &self.entries[i]
            let result = ChipCache::get(
                entry.asset_id,
                entry.source_ptr,
                entry.size,
                entry.priority,
                entry.get_name()
            )

            match result {
                Result::Err(_) => {
                    // Failed - unpin any already loaded
                    self.unload_internal(i)
                    self.state = BankState::Failed
                    return Result::Err(BankError::OutOfMemory)
                },
                Result::Ok(_) => {
                    // Pin the asset
                    ChipCache::pin(entry.asset_id)
                }
            }
            i++
        }

        self.state = BankState::Loaded
        return Result::Ok(())
    }

    /// Unload all assets from chip RAM
    ///
    /// Decrements pin count for each asset. Assets shared with other
    /// loaded banks will remain in chip RAM.
    pub fn unload(&var self) {
        match self.state {
            BankState::Loaded => {},
            BankState::Loading => {},
            _ => return  // Nothing to unload
        }

        self.unload_internal(self.entry_count)
        self.state = BankState::Unloaded
    }

    /// Internal helper to unpin entries up to a count
    fn unload_internal(&var self, count: u32) {
        while var i < count {
            ChipCache::unpin(self.entries[i].asset_id)
            i++
        }
    }

    /// Get chip RAM pointer for an asset by ID
    ///
    /// Returns None if the bank is not loaded or asset not found.
    pub fn get_by_id(&self, asset_id: u32) -> Option<*u8> {
        match self.state {
            BankState::Loaded => {},
            _ => return Option::None
        }

        // Find the entry
        while var i < self.entry_count {
            if self.entries[i].asset_id == asset_id {
                // Get from cache (should be instant, already loaded)
                let result = ChipCache::get(
                    self.entries[i].asset_id,
                    self.entries[i].source_ptr,
                    self.entries[i].size,
                    self.entries[i].priority,
                    self.entries[i].get_name()
                )
                match result {
                    Result::Ok(ptr) => return Option::Some(ptr),
                    Result::Err(_) => return Option::None,
                }
            }
            i++
        }

        return Option::None
    }

    /// Pin all assets in the bank (additional pin for DMA safety)
    ///
    /// Use when you need to guarantee assets stay loaded during
    /// a DMA operation that spans multiple frames.
    pub fn pin(&self) {
        match self.state {
            BankState::Loaded => {},
            _ => return
        }

        while var i < self.entry_count {
            ChipCache::pin(self.entries[i].asset_id)
            i++
        }
    }

    /// Unpin all assets (release the extra pin)
    pub fn unpin(&self) {
        match self.state {
            BankState::Loaded => {},
            _ => return
        }

        while var i < self.entry_count {
            ChipCache::unpin(self.entries[i].asset_id)
            i++
        }
    }

    /// Check if the bank will fit in available chip RAM
    ///
    /// This is a heuristic check - actual loading may still fail
    /// if memory becomes fragmented.
    pub fn will_fit(&self, available: u32) -> bool {
        return self.total_size <= available
    }

    /// Add an entry to the bank (internal, used by builder)
    fn add_entry(&var self, entry: BankEntry) -> Result<(), BankError> {
        if self.entry_count >= MAX_BANK_ENTRIES {
            return Result::Err(BankError::TooManyEntries)
        }

        self.entries[self.entry_count] = entry
        self.total_size = self.total_size + entry.size
        self.entry_count++
        return Result::Ok(())
    }
}

impl Drop for ResourceBank {
    fn drop(&var self) {
        // Unload when bank goes out of scope
        self.unload()
    }
}

// ============================================================================
// Bank Builder
// ============================================================================

/// Fluent builder for creating resource banks
///
/// # Example
/// ```novus
/// let bank = ResourceBank::builder("level1")
///     .add(&sprites)
///     .add_named(&music, "level_music")
///     .priority(Priority::High)
///     .persistent(true)
///     .build()?
/// ```
pub struct BankBuilder {
    /// The bank value stored by `BankBuilder`.
    bank: ResourceBank,
    /// The default priority value stored by `BankBuilder`.
    default_priority: Priority,
}

impl BankBuilder {
    /// Create a new builder with the given bank name
    pub fn new(name: Str) -> BankBuilder {
        return BankBuilder {
            bank: ResourceBank::new(name),
            default_priority: Priority::Normal,
        }
    }

    /// Add an asset to the bank by its ChipAsset properties
    ///
    /// Uses explicit parameters rather than generics since Novus doesn't
    /// support trait-bounded generics in this context.
    ///
    /// # Example
    /// ```novus
    /// builder.add_asset(
    ///     asset.asset_id(),
    ///     asset.data_ptr(),
    ///     asset.data_size(),
    ///     asset.cache_priority()
    /// )
    /// ```
    @chain
    pub fn add_asset(&var self, asset_id: u32, data_ptr: *u8, data_size: u32, priority: Priority) {
        let entry = BankEntry::new(asset_id, data_ptr, data_size, priority)
        // Ignore errors during building - will fail at build() time
        let _ = self.bank.add_entry(entry)
    }

    /// Add an asset with a custom debug name
    @chain
    pub fn add_asset_named(&var self, asset_id: u32, data_ptr: *u8, data_size: u32, priority: Priority, name: Str) {
        var entry = BankEntry::new(asset_id, data_ptr, data_size, priority)
        entry.set_name(name)
        let _ = self.bank.add_entry(entry)
    }

    /// Set default priority for subsequently added assets
    @chain
    pub fn priority(&var self, p: Priority) {
        self.default_priority = p
    }

    /// Mark bank as persistent (never auto-unload)
    @chain
    pub fn persistent(&var self, p: bool) {
        self.bank.persistent = p
    }

    /// Build the resource bank
    ///
    /// Returns the bank or an error if configuration is invalid.
    pub fn build(&var self) -> Result<ResourceBank, BankError> {
        if self.bank.entry_count == 0 {
            // Empty bank is allowed but unusual
        }

        // Move the bank out - create a new empty one in its place
        var result = self.bank
        self.bank = ResourceBank::new("")
        return Result::Ok(result)
    }
}

// ============================================================================
// Budget Helpers
// ============================================================================

/// Chip RAM budget configuration
///
/// Helps plan memory usage across different asset categories.
pub struct ChipBudget {
    /// The total value stored by `ChipBudget`.
    total: u32,             // Total chip RAM available
    /// The persistent value stored by `ChipBudget`.
    persistent: u32,        // Reserved for always-loaded (persistent) banks
    /// The level value stored by `ChipBudget`.
    level: u32,             // Reserved for level-specific assets
    /// The streaming value stored by `ChipBudget`.
    streaming: u32,         // Reserved for audio streaming buffers
}

impl ChipBudget {
    /// Create a budget with typical game allocations
    ///
    /// Divides available chip RAM into categories:
    /// - 25% persistent (HUD, fonts, common SFX)
    /// - 50% level assets (graphics, music)
    /// - 25% streaming (audio buffers)
    pub fn typical(total: u32) -> ChipBudget {
        return ChipBudget {
            total: total,
            persistent: total / 4,
            level: total / 2,
            streaming: total / 4,
        }
    }

    /// Create a custom budget
    pub fn custom(total: u32, persistent: u32, level: u32, streaming: u32) -> ChipBudget {
        return ChipBudget {
            total: total,
            persistent: persistent,
            level: level,
            streaming: streaming,
        }
    }

    /// Get unallocated budget
    pub fn unallocated(&self) -> u32 {
        let allocated = self.persistent + self.level + self.streaming
        if allocated >= self.total {
            return 0
        }
        return self.total - allocated
    }

    /// Check if a bank fits in the level budget
    pub fn level_will_fit(&self, bank: &ResourceBank) -> bool {
        return bank.total_size() <= self.level
    }

    /// Check if a bank fits in the persistent budget
    pub fn persistent_will_fit(&self, bank: &ResourceBank) -> bool {
        return bank.total_size() <= self.persistent
    }
}

/// Statistics about loaded banks
pub struct BankStats {
    /// The loaded banks value stored by `BankStats`.
    loaded_banks: u32,      // Number of loaded banks
    /// The total loaded value stored by `BankStats`.
    total_loaded: u32,      // Total bytes in loaded banks
    /// The persistent banks value stored by `BankStats`.
    persistent_banks: u32,  // Number of persistent banks
    /// The persistent bytes value stored by `BankStats`.
    persistent_bytes: u32,  // Bytes in persistent banks
}
