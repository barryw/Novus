from amiga::sys::intuition::screen import ScreenHandle
from amiga::sys::intuition::window import WindowHandle

// Tier 2: owning Intuition windows and screens.
pub use amiga::sys::intuition::screen::*
pub use amiga::sys::intuition::window::*
pub use amiga::sys::intuition::errors::*

/// Aliases `IntuitionWindow` to `WindowHandle`.
pub type IntuitionWindow = WindowHandle
/// Aliases `IntuitionScreen` to `ScreenHandle`.
pub type IntuitionScreen = ScreenHandle
