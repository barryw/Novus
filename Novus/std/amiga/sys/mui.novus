// MUI (Magic User Interface) Builder API
// Namespace: amiga::sys::mui
//
// High-level builder API for MUI GUI applications (AmigaOS 2.0+ with MUI installed).
// MUI is a BOOPSI-based toolkit providing automatic layout, font sensitivity,
// user configuration, and a rich widget set.
//
// ## Design Pattern: Hierarchical Builder → MUI Object Tree
//
// The user sees a clean hierarchical API:
//   var app = MUIApp::new("My App")
//   app.add_window("Main Window", |win| {
//       win.vgroup(|g| {
//           g.button(1, "Click Me")
//           g.string_gadget(2, "Enter text")
//       })
//   })
//   app.run()
//
// Behind the scenes, we create MUI objects via MUI_NewObject and link them
// with parent-child relationships through MUIA_Group_Child.

from std::core import Option, Result
from amiga::sys::intuition::errors import IntuitionError
from amiga::raw::structs import Screen, Window, TagItem
from amiga::raw::consts import *
from amiga::raw::intuition import LockPubScreen, UnlockPubScreen
from amiga::raw::exec import AllocVec, FreeVec, CopyMem, Wait
from std::string::core import Str
from amiga::raw::mui_tags import *

// ============================================================================
// External: muimaster.library functions
// ============================================================================
// These are the core MUI library functions we need

extern fn MUI_NewObjectA(classname: *u8, tags: *TagItem) -> *u8
extern fn MUI_DisposeObject(obj: *u8)
extern fn MUI_RequestA(app: *u8, window: *u8, flags: u32, title: *u8, gadgets: *u8, format: *u8, params: *u32) -> i32

// DoMethod is from amiga.lib, dispatches BOOPSI methods
extern fn DoMethodA(object: *u8, message: *u32) -> u32

// ============================================================================
// Common Menu IDs - Standard IDs for common menu items
// ============================================================================
// These follow a convention: File menu 100-199, Edit menu 200-299, Help menu 900-999

// File/Project menu
pub const MENU_NEW: u32 = 100
pub const MENU_OPEN: u32 = 101
pub const MENU_SAVE: u32 = 102
pub const MENU_SAVE_AS: u32 = 103
pub const MENU_CLOSE: u32 = 104
pub const MENU_QUIT: u32 = 110

// Edit menu
pub const MENU_CUT: u32 = 200
pub const MENU_COPY: u32 = 201
pub const MENU_PASTE: u32 = 202
pub const MENU_UNDO: u32 = 203
pub const MENU_REDO: u32 = 204
pub const MENU_SELECT_ALL: u32 = 205
pub const MENU_CLEAR: u32 = 206

// Settings menu
pub const MENU_PREFS: u32 = 300
pub const MENU_MUI_PREFS: u32 = 301

// Help menu
pub const MENU_ABOUT: u32 = 900
pub const MENU_HELP: u32 = 901

// ============================================================================
// Helper: Tag Builder
// ============================================================================
// Simple tag list builder that accumulates tags

struct TagBuilder {
    tags: *TagItem
    count: u32
    capacity: u32
}

impl TagBuilder {
    fn new() -> TagBuilder {
        unsafe {
            let capacity: u32 = 32
            let size = capacity * @sizeof(TagItem)
            let mem = AllocVec(size, MEMF_PUBLIC | MEMF_CLEAR)
            if !mem {
                panic!("Failed to allocate tag builder memory")
            }
            return TagBuilder {
                tags: (*TagItem)mem,
                count: 0,
                capacity: capacity,
            }
        }
    }

    fn add(&var self, tag: u32, data: u32) {
        unsafe {
            if self.count >= self.capacity - 1 {
                // Resize
                let new_capacity = self.capacity * 2
                let new_size = new_capacity * @sizeof(TagItem)
                let new_mem = AllocVec(new_size, MEMF_PUBLIC | MEMF_CLEAR)
                if !new_mem {
                    panic!("Failed to resize tag builder")
                }

                CopyMem((*u8)self.tags, new_mem, self.count * @sizeof(TagItem))
                FreeVec((*u8)self.tags)
                self.tags = (*TagItem)new_mem
                self.capacity = new_capacity
            }

            self.tags[self.count].ti_Tag = tag
            self.tags[self.count].ti_Data = data
            self.count++
        }
    }

    fn finish(&var self) -> *TagItem {
        self.add(TAG_DONE, 0)
        return self.tags
    }

    fn clear(&var self) {
        self.count = 0
    }
}

impl Drop for TagBuilder {
    fn drop(&var self) {
        unsafe {
            if self.tags {
                FreeVec((*u8)self.tags)
            }
        }
    }
}

// ============================================================================
// MUI Application Builder
// ============================================================================

pub struct MUIAppBuilder {
    title: *u8
    author: *u8
    description: *u8
    version: *u8
    base: *u8
    menustrip_obj: *u8    // Optional menustrip object
    windows: **u8         // Array of window objects
    window_count: u32
    window_capacity: u32
    labels: **u8          // Tracked string allocations
    label_count: u32
    label_capacity: u32
}

impl MUIAppBuilder {
    /// Create a new MUI application builder
    pub fn new(title: Str) -> MUIAppBuilder {
        unsafe {
            // Allocate window array
            let win_capacity: u32 = 8
            let win_mem = AllocVec(win_capacity * 4, MEMF_PUBLIC | MEMF_CLEAR)
            if !win_mem {
                panic!("Failed to allocate window array")
            }

            // Allocate label tracking
            let label_capacity: u32 = 32
            let label_mem = AllocVec(label_capacity * 4, MEMF_PUBLIC | MEMF_CLEAR)
            if !label_mem {
                FreeVec(win_mem)
                panic!("Failed to allocate label array")
            }

            var builder = MUIAppBuilder {
                title: null,
                author: null,
                description: null,
                version: null,
                base: null,
                menustrip_obj: null,
                windows: (**u8)win_mem,
                window_count: 0,
                window_capacity: win_capacity,
                labels: (**u8)label_mem,
                label_count: 0,
                label_capacity: label_capacity,
            }

            builder.title = builder.alloc_label(title)
            return builder
        }
    }

    /// Set application author
    @chain
    pub fn author(&var self, author: Str) {
        self.author = self.alloc_label(author)
    }

    /// Set application description
    @chain
    pub fn description(&var self, desc: Str) {
        self.description = self.alloc_label(desc)
    }

    /// Set application version string
    @chain
    pub fn version(&var self, version: Str) {
        self.version = self.alloc_label(version)
    }

    /// Set application base name (for prefs files)
    @chain
    pub fn base(&var self, base: Str) {
        self.base = self.alloc_label(base)
    }

    /// Set the application's menustrip (built from MenuBuilder)
    @chain
    pub fn menustrip(&var self, strip: *u8) {
        self.menustrip_obj = strip
    }

    /// Create a window and return a builder for it
    pub fn window(&var self, title: Str) -> MUIWindowBuilder {
        return MUIWindowBuilder::new(self, title)
    }

    /// Build the application
    pub fn build(&var self) -> Result<MUIApp, IntuitionError> {
        unsafe {
            // Build application object
            var tags = TagBuilder::new()

            tags.add(MUIA_Application_Title, (u32)self.title)

            if self.author {
                tags.add(MUIA_Application_Author, (u32)self.author)
            }
            if self.description {
                tags.add(MUIA_Application_Description, (u32)self.description)
            }
            if self.version {
                tags.add(MUIA_Application_Version, (u32)self.version)
            }
            if self.base {
                tags.add(MUIA_Application_Base, (u32)self.base)
            }

            // Add menustrip if set
            if self.menustrip_obj {
                tags.add(MUIA_Application_Menustrip, (u32)self.menustrip_obj)
            }

            // Add all windows
            var i: u32 = 0
            forever {
                if i >= self.window_count {
                    break
                }
                tags.add(MUIA_Application_Window, (u32)self.windows[i])
                i++
            }

            let app = MUI_NewObjectA("Application.mui".ptr, tags.finish())
            if !app {
                return Result::Err(IntuitionError::LibraryOpenFailed)
            }

            // Transfer ownership
            let labels = self.labels
            let label_count = self.label_count
            self.labels = null
            self.label_count = 0

            // Clear windows (they're now owned by app)
            var j: u32 = 0
            forever {
                if j >= self.window_count {
                    break
                }
                self.windows[j] = null
                j++
            }
            self.window_count = 0

            return Result::Ok(MUIApp {
                app: app,
                labels: labels,
                label_count: label_count,
            })
        }
    }

    /// Add a window object to the app
    fn add_window(&var self, window: *u8) {
        unsafe {
            if self.window_count >= self.window_capacity {
                let new_capacity = self.window_capacity * 2
                let new_mem = AllocVec(new_capacity * 4, MEMF_PUBLIC | MEMF_CLEAR)
                if !new_mem {
                    panic!("Failed to resize window array")
                }

                var i: u32 = 0
                forever {
                    if i >= self.window_count {
                        break
                    }
                    let new_arr = (**u8)new_mem
                    new_arr[i] = self.windows[i]
                    i++
                }

                FreeVec((*u8)self.windows)
                self.windows = (**u8)new_mem
                self.window_capacity = new_capacity
            }

            self.windows[self.window_count] = window
            self.window_count++
        }
    }

    /// Allocate a null-terminated label string
    fn alloc_label(&var self, label: Str) -> *u8 {
        unsafe {
            let size = label.len + 1
            let mem = AllocVec(size, MEMF_PUBLIC | MEMF_CLEAR)
            if !mem {
                panic!("Failed to allocate label")
            }

            CopyMem(label.ptr, mem, label.len)
            let bytes = (*u8)mem
            bytes[label.len] = 0

            self.track_label(bytes)
            return bytes
        }
    }

    fn track_label(&var self, label: *u8) {
        unsafe {
            if self.label_count >= self.label_capacity {
                let new_capacity = self.label_capacity * 2
                let new_mem = AllocVec(new_capacity * 4, MEMF_PUBLIC | MEMF_CLEAR)
                if !new_mem {
                    panic!("Failed to resize label array")
                }

                var i: u32 = 0
                forever {
                    if i >= self.label_count {
                        break
                    }
                    let new_arr = (**u8)new_mem
                    new_arr[i] = self.labels[i]
                    i++
                }

                FreeVec((*u8)self.labels)
                self.labels = (**u8)new_mem
                self.label_capacity = new_capacity
            }

            self.labels[self.label_count] = label
            self.label_count++
        }
    }
}

impl Drop for MUIAppBuilder {
    fn drop(&var self) {
        unsafe {
            // Free any windows not transferred
            var i: u32 = 0
            forever {
                if i >= self.window_count {
                    break
                }
                if self.windows[i] {
                    MUI_DisposeObject(self.windows[i])
                }
                i++
            }

            if self.windows {
                FreeVec((*u8)self.windows)
            }

            // Free labels if still owned
            if self.labels {
                var j: u32 = 0
                forever {
                    if j >= self.label_count {
                        break
                    }
                    if self.labels[j] {
                        FreeVec(self.labels[j])
                    }
                    j++
                }
                FreeVec((*u8)self.labels)
            }
        }
    }
}

// ============================================================================
// MUI Window Builder
// ============================================================================

pub struct MUIWindowBuilder {
    app_builder: *MUIAppBuilder
    title: *u8
    root_group: *u8
    id: u32
    close_gadget: bool
    size_gadget: bool
    drag_bar: bool
    depth_gadget: bool
}

impl MUIWindowBuilder {
    fn new(app: *MUIAppBuilder, title: Str) -> MUIWindowBuilder {
        unsafe {
            let title_ptr = (*app).alloc_label(title)
            return MUIWindowBuilder {
                app_builder: app,
                title: title_ptr,
                root_group: null,
                id: 0,
                close_gadget: true,
                size_gadget: true,
                drag_bar: true,
                depth_gadget: true,
            }
        }
    }

    /// Set window ID for state saving
    @chain
    pub fn id(&var self, id: u32) {
        self.id = id
    }

    /// Enable/disable close gadget
    @chain
    pub fn close_gadget(&var self, enable: bool) {
        self.close_gadget = enable
    }

    /// Enable/disable size gadget
    @chain
    pub fn size_gadget(&var self, enable: bool) {
        self.size_gadget = enable
    }

    /// Set the root group directly
    @chain
    pub fn root(&var self, group: *u8) {
        self.root_group = group
    }

    /// Create a vertical group as the root
    pub fn vgroup(&var self) -> MUIGroupBuilder {
        return MUIGroupBuilder::new(self.app_builder, false)
    }

    /// Create a horizontal group as the root
    pub fn hgroup(&var self) -> MUIGroupBuilder {
        return MUIGroupBuilder::new(self.app_builder, true)
    }

    /// Build the window and add it to the application
    pub fn build(&var self) -> *u8 {
        unsafe {
            if !self.root_group {
                panic!("Window must have a root group")
            }

            var tags = TagBuilder::new()

            tags.add(MUIA_Window_Title, (u32)self.title)
            tags.add(MUIA_Window_RootObject, (u32)self.root_group)

            if self.id != 0 {
                tags.add(MUIA_Window_ID, self.id)
            }

            tags.add(MUIA_Window_CloseGadget, if self.close_gadget { 1 } else { 0 })
            tags.add(MUIA_Window_SizeGadget, if self.size_gadget { 1 } else { 0 })
            tags.add(MUIA_Window_DragBar, if self.drag_bar { 1 } else { 0 })
            tags.add(MUIA_Window_DepthGadget, if self.depth_gadget { 1 } else { 0 })

            let window = MUI_NewObjectA("Window.mui".ptr, tags.finish())
            if !window {
                panic!("Failed to create MUI window")
            }

            (*self.app_builder).add_window(window)
            return window
        }
    }
}

// ============================================================================
// MUI Group Builder
// ============================================================================

pub struct MUIGroupBuilder {
    app_builder: *MUIAppBuilder
    horizontal: bool
    children: **u8
    child_count: u32
    child_capacity: u32
    frame: i32
    frame_title: *u8
    same_size: bool
    spacing: i32
}

impl MUIGroupBuilder {
    fn new(app: *MUIAppBuilder, horizontal: bool) -> MUIGroupBuilder {
        unsafe {
            let capacity: u32 = 16
            let mem = AllocVec(capacity * 4, MEMF_PUBLIC | MEMF_CLEAR)
            if !mem {
                panic!("Failed to allocate group children array")
            }

            return MUIGroupBuilder {
                app_builder: app,
                horizontal: horizontal,
                children: (**u8)mem,
                child_count: 0,
                child_capacity: capacity,
                frame: -1,  // -1 = not set
                frame_title: null,
                same_size: false,
                spacing: -1,
            }
        }
    }

    /// Set frame style
    @chain
    pub fn frame(&var self, frame_type: i32) {
        self.frame = frame_type
    }

    /// Set frame title
    @chain
    pub fn frame_title(&var self, title: Str) {
        unsafe {
            self.frame_title = (*self.app_builder).alloc_label(title)
        }
    }

    /// Make all children same size
    @chain
    pub fn same_size(&var self) {
        self.same_size = true
    }

    /// Set spacing between children
    @chain
    pub fn spacing(&var self, spacing: i32) {
        self.spacing = spacing
    }

    /// Add a child object
    @chain
    pub fn child(&var self, obj: *u8) {
        unsafe {
            if self.child_count >= self.child_capacity {
                let new_capacity = self.child_capacity * 2
                let new_mem = AllocVec(new_capacity * 4, MEMF_PUBLIC | MEMF_CLEAR)
                if !new_mem {
                    panic!("Failed to resize children array")
                }

                var i: u32 = 0
                forever {
                    if i >= self.child_count {
                        break
                    }
                    let new_arr = (**u8)new_mem
                    new_arr[i] = self.children[i]
                    i++
                }

                FreeVec((*u8)self.children)
                self.children = (**u8)new_mem
                self.child_capacity = new_capacity
            }

            self.children[self.child_count] = obj
            self.child_count++
        }
    }

    /// Add a button
    pub fn button(&var self, id: u32, label: Str) -> *u8 {
        unsafe {
            let label_ptr = (*self.app_builder).alloc_label(label)

            let button = make_button(label_ptr)
            if button {
                // Set user data to ID for identification
                set_attr(button, MUIA_UserData, id)
                self.child(button)
            }
            return button
        }
    }

    /// Add a text label
    pub fn label(&var self, text: Str) -> *u8 {
        unsafe {
            let text_ptr = (*self.app_builder).alloc_label(text)
            let text_obj = make_text(text_ptr)
            if text_obj {
                self.child(text_obj)
            }
            return text_obj
        }
    }

    /// Add a string gadget
    pub fn string(&var self, id: u32, initial: Str, max_len: u32) -> *u8 {
        unsafe {
            let initial_ptr = (*self.app_builder).alloc_label(initial)

            var tags = TagBuilder::new()
            tags.add(MUIA_Frame, (u32)MUIV_Frame_String)
            tags.add(MUIA_String_Contents, (u32)initial_ptr)
            tags.add(MUIA_String_MaxLen, max_len)
            tags.add(MUIA_UserData, id)

            let str_obj = MUI_NewObjectA("String.mui".ptr, tags.finish())
            if str_obj {
                self.child(str_obj)
            }
            return str_obj
        }
    }

    /// Add a checkbox
    pub fn checkbox(&var self, id: u32, label: Str, checked: bool) -> *u8 {
        unsafe {
            // For MUI checkmarks, we use an Image with MUII_CheckMark
            let label_ptr = (*self.app_builder).alloc_label(label)

            var tags = TagBuilder::new()
            tags.add(MUIA_Frame, (u32)MUIV_Frame_ImageButton)
            tags.add(MUIA_InputMode, (u32)MUIV_InputMode_Toggle)
            tags.add(MUIA_Image_Spec, (u32)MUII_CheckMark)
            tags.add(MUIA_Selected, if checked { 1 } else { 0 })
            tags.add(MUIA_UserData, id)
            tags.add(MUIA_ShortHelp, (u32)label_ptr)

            let check_obj = MUI_NewObjectA("Image.mui".ptr, tags.finish())
            if check_obj {
                self.child(check_obj)
            }
            return check_obj
        }
    }

    /// Add a slider
    pub fn slider(&var self, id: u32, min: i32, max: i32, value: i32) -> *u8 {
        unsafe {
            var tags = TagBuilder::new()
            tags.add(MUIA_Numeric_Min, (u32)min)
            tags.add(MUIA_Numeric_Max, (u32)max)
            tags.add(MUIA_Numeric_Value, (u32)value)
            tags.add(MUIA_UserData, id)

            let slider_obj = MUI_NewObjectA("Slider.mui".ptr, tags.finish())
            if slider_obj {
                self.child(slider_obj)
            }
            return slider_obj
        }
    }

    /// Add a cycle gadget (dropdown)
    pub fn cycle(&var self, id: u32, entries: **u8) -> *u8 {
        unsafe {
            var tags = TagBuilder::new()
            tags.add(MUIA_Cycle_Entries, (u32)entries)
            tags.add(MUIA_UserData, id)

            let cycle_obj = MUI_NewObjectA("Cycle.mui".ptr, tags.finish())
            if cycle_obj {
                self.child(cycle_obj)
            }
            return cycle_obj
        }
    }

    /// Add a listview
    pub fn listview(&var self, id: u32) -> *u8 {
        unsafe {
            // Create the list object first
            var list_tags = TagBuilder::new()
            let list_obj = MUI_NewObjectA("List.mui".ptr, list_tags.finish())
            if !list_obj {
                return null
            }

            // Create listview with the list
            var lv_tags = TagBuilder::new()
            lv_tags.add(MUIA_Listview_List, (u32)list_obj)
            lv_tags.add(MUIA_UserData, id)

            let lv_obj = MUI_NewObjectA("Listview.mui".ptr, lv_tags.finish())
            if lv_obj {
                self.child(lv_obj)
            } else {
                MUI_DisposeObject(list_obj)
            }
            return lv_obj
        }
    }

    /// Add a gauge (progress bar)
    pub fn gauge(&var self, id: u32, max: i32, horiz: bool) -> *u8 {
        unsafe {
            var tags = TagBuilder::new()
            tags.add(MUIA_Frame, (u32)MUIV_Frame_Gauge)
            tags.add(MUIA_Gauge_Max, (u32)max)
            tags.add(MUIA_Gauge_Horiz, if horiz { 1 } else { 0 })
            tags.add(MUIA_UserData, id)

            let gauge_obj = MUI_NewObjectA("Gauge.mui".ptr, tags.finish())
            if gauge_obj {
                self.child(gauge_obj)
            }
            return gauge_obj
        }
    }

    /// Add a nested vertical group
    pub fn vgroup(&var self) -> MUIGroupBuilder {
        return MUIGroupBuilder::new(self.app_builder, false)
    }

    /// Add a nested horizontal group
    pub fn hgroup(&var self) -> MUIGroupBuilder {
        return MUIGroupBuilder::new(self.app_builder, true)
    }

    /// Add horizontal space
    @chain
    pub fn hspace(&var self) {
        unsafe {
            var tags = TagBuilder::new()
            let rect = MUI_NewObjectA("Rectangle.mui".ptr, tags.finish())
            if rect {
                self.child(rect)
            }
        }
    }

    /// Add vertical space
    @chain
    pub fn vspace(&var self) {
        unsafe {
            var tags = TagBuilder::new()
            let rect = MUI_NewObjectA("Rectangle.mui".ptr, tags.finish())
            if rect {
                self.child(rect)
            }
        }
    }

    /// Add a horizontal bar separator
    @chain
    pub fn hbar(&var self) {
        unsafe {
            var tags = TagBuilder::new()
            tags.add(MUIA_Rectangle_HBar, 1)
            let bar = MUI_NewObjectA("Rectangle.mui".ptr, tags.finish())
            if bar {
                self.child(bar)
            }
        }
    }

    /// Add a vertical bar separator
    @chain
    pub fn vbar(&var self) {
        unsafe {
            var tags = TagBuilder::new()
            tags.add(MUIA_Rectangle_VBar, 1)
            let bar = MUI_NewObjectA("Rectangle.mui".ptr, tags.finish())
            if bar {
                self.child(bar)
            }
        }
    }

    /// Build the group and return the object
    pub fn build(&var self) -> *u8 {
        unsafe {
            var tags = TagBuilder::new()

            if self.horizontal {
                tags.add(MUIA_Group_Horiz, 1)
            }

            if self.frame >= 0 {
                tags.add(MUIA_Frame, (u32)self.frame)
            }

            if self.frame_title {
                tags.add(MUIA_FrameTitle, (u32)self.frame_title)
            }

            if self.same_size {
                tags.add(MUIA_Group_SameSize, 1)
            }

            if self.spacing >= 0 {
                tags.add(MUIA_Group_Spacing, (u32)self.spacing)
            }

            // Add all children
            var i: u32 = 0
            forever {
                if i >= self.child_count {
                    break
                }
                tags.add(MUIA_Group_Child, (u32)self.children[i])
                i++
            }

            let group = MUI_NewObjectA("Group.mui".ptr, tags.finish())

            // Free children array (objects are now owned by group)
            FreeVec((*u8)self.children)
            self.children = null
            self.child_count = 0

            return group
        }
    }
}

impl Drop for MUIGroupBuilder {
    fn drop(&var self) {
        unsafe {
            // Dispose any children that weren't transferred
            if self.children {
                var i: u32 = 0
                forever {
                    if i >= self.child_count {
                        break
                    }
                    if self.children[i] {
                        MUI_DisposeObject(self.children[i])
                    }
                    i++
                }
                FreeVec((*u8)self.children)
            }
        }
    }
}

// ============================================================================
// MUI Application - Running Application
// ============================================================================

pub struct MUIApp {
    app: *u8
    labels: **u8
    label_count: u32
}

impl MUIApp {
    /// Get the application object
    pub fn app_object(&self) -> *u8 {
        return self.app
    }

    /// Open a window with automatic close-to-quit behavior
    /// This is the recommended default for simple applications.
    /// When the user clicks the close gadget, the app will quit.
    pub fn open_window(&self, window: *u8) {
        self.on_close(window)
        set_attr(window, MUIA_Window_Open, 1)
    }

    /// Open a window without automatic close handling
    /// Use this when you need custom close behavior (e.g., "Save changes?" dialogs).
    /// You must set up your own close notification using on_close_return()
    /// and handle the event in your event loop.
    pub fn open_window_custom(&self, window: *u8) {
        set_attr(window, MUIA_Window_Open, 1)
    }

    /// Close a window by pointer
    pub fn close_window(&self, window: *u8) {
        set_attr(window, MUIA_Window_Open, 0)
    }

    /// Run the main event loop
    /// Returns when MUIV_Application_ReturnID_Quit is received
    pub fn run(&self) {
        unsafe {
            var signals: u32 = 0

            forever {
                let id = self.new_input(&var signals)

                if id == (u32)MUIV_Application_ReturnID_Quit {
                    break
                }

                if signals != 0 {
                    signals = Wait(signals)
                }
            }
        }
    }

    /// Run one iteration of the event loop
    /// Returns the ReturnID or 0 if no events
    pub fn run_once(&self, signals: *u32) -> u32 {
        unsafe {
            return self.new_input(signals)
        }
    }

    /// Get new input using MUIM_Application_NewInput
    fn new_input(&self, signals: *u32) -> u32 {
        unsafe {
            let msg: [u32] = [MUIM_Application_NewInput, (u32)signals]
            return DoMethodA(self.app, &msg[0])
        }
    }

    /// Set up a notification
    pub fn notify(&self, source: *u8, attr: u32, trigger: u32, dest: *u8, method: u32) {
        unsafe {
            let msg: [u32] = [
                MUIM_Notify,
                attr,
                trigger,
                (u32)dest,
                (u32)1,  // Number of following arguments
                method,
                (u32)0   // Sentinel
            ]
            DoMethodA(source, &msg[0])
        }
    }

    /// Set up a notification with one parameter
    pub fn notify_val(&self, source: *u8, attr: u32, trigger: u32, dest: *u8, method: u32, val: u32) {
        unsafe {
            let msg: [u32] = [
                MUIM_Notify,
                attr,
                trigger,
                (u32)dest,
                (u32)2,  // Number of following arguments
                method,
                val,
                (u32)0   // Sentinel
            ]
            DoMethodA(source, &msg[0])
        }
    }

    /// Set up close notification for a window
    pub fn on_close(&self, window: *u8) {
        self.notify_val(window, MUIA_Window_CloseRequest, 1,
                       self.app, MUIM_Application_ReturnID, (u32)MUIV_Application_ReturnID_Quit)
    }

    /// Set up close notification with custom return ID
    pub fn on_close_return(&self, window: *u8, return_id: u32) {
        self.notify_val(window, MUIA_Window_CloseRequest, 1,
                       self.app, MUIM_Application_ReturnID, return_id)
    }

    /// Set up button press notification
    pub fn on_button(&self, button: *u8, return_id: u32) {
        self.notify_val(button, MUIA_Pressed, 0,
                       self.app, MUIM_Application_ReturnID, return_id)
    }

    /// Set up slider/numeric value change notification
    /// Triggers when the slider value changes
    pub fn on_slider(&self, slider: *u8, return_id: u32) {
        self.notify_val(slider, MUIA_Numeric_Value, MUIV_EveryTime,
                       self.app, MUIM_Application_ReturnID, return_id)
    }

    /// Set up checkbox state change notification
    /// Triggers when the checkbox is toggled (selected state changes)
    pub fn on_checkbox(&self, checkbox: *u8, return_id: u32) {
        self.notify_val(checkbox, MUIA_Selected, MUIV_EveryTime,
                       self.app, MUIM_Application_ReturnID, return_id)
    }

    /// Set up string gadget acknowledgment notification
    /// Triggers when the user presses Enter or the string loses focus
    pub fn on_string(&self, string: *u8, return_id: u32) {
        self.notify_val(string, MUIA_String_Acknowledge, MUIV_EveryTime,
                       self.app, MUIM_Application_ReturnID, return_id)
    }

    /// Set up string gadget content change notification
    /// Triggers on every keystroke (can be chatty!)
    pub fn on_string_change(&self, string: *u8, return_id: u32) {
        self.notify_val(string, MUIA_String_Contents, MUIV_EveryTime,
                       self.app, MUIM_Application_ReturnID, return_id)
    }

    /// Set up cycle gadget selection change notification
    /// Triggers when a different cycle entry is selected
    pub fn on_cycle(&self, cycle: *u8, return_id: u32) {
        self.notify_val(cycle, MUIA_Cycle_Active, MUIV_EveryTime,
                       self.app, MUIM_Application_ReturnID, return_id)
    }

    /// Set up list selection change notification
    /// Triggers when a different list entry is selected
    pub fn on_list(&self, list: *u8, return_id: u32) {
        self.notify_val(list, MUIA_List_Active, MUIV_EveryTime,
                       self.app, MUIM_Application_ReturnID, return_id)
    }

    /// Set up listview double-click notification
    /// Triggers when user double-clicks a list entry
    pub fn on_listview_doubleclick(&self, listview: *u8, return_id: u32) {
        self.notify_val(listview, MUIA_Listview_DoubleClick, 1,
                       self.app, MUIM_Application_ReturnID, return_id)
    }

    /// Generic notification for any attribute change
    /// Triggers when the specified attribute changes to the trigger value
    /// Use MUIV_EveryTime to trigger on any change
    pub fn on_attr(&self, obj: *u8, attr: u32, trigger: u32, return_id: u32) {
        self.notify_val(obj, attr, trigger,
                       self.app, MUIM_Application_ReturnID, return_id)
    }

    /// Set up menu item notification
    /// Triggers when a menu item with the given UserData is selected
    /// The menu_id should match the id passed to item() in MenuItemBuilder
    pub fn on_menu(&self, menu_id: u32) {
        // MUI sends MUIA_Application_MenuAction with the menu item's UserData
        // We set up a notification that triggers when MenuAction equals our menu_id
        self.notify_val(self.app, MUIA_Application_MenuAction, menu_id,
                       self.app, MUIM_Application_ReturnID, menu_id)
    }

    /// Request (show message box)
    pub fn request(&self, window: *u8, title: *u8, message: *u8, gadgets: *u8) -> i32 {
        unsafe {
            return MUI_RequestA(self.app, window, 0, title, gadgets, message, null)
        }
    }
}

impl Drop for MUIApp {
    fn drop(&var self) {
        unsafe {
            // Dispose application (this disposes all windows and children)
            if self.app {
                MUI_DisposeObject(self.app)
                self.app = null
            }

            // Free labels
            if self.labels {
                var i: u32 = 0
                forever {
                    if i >= self.label_count {
                        break
                    }
                    if self.labels[i] {
                        FreeVec(self.labels[i])
                    }
                    i++
                }
                FreeVec((*u8)self.labels)
            }
        }
    }
}

// ============================================================================
// Helper Functions
// ============================================================================

/// Create a simple button
pub fn make_button(label: *u8) -> *u8 {
    unsafe {
        var tags = TagBuilder::new()
        let centered = (*u8)"\033c".ptr
        tags.add(MUIA_Frame, (u32)MUIV_Frame_Button)
        tags.add(MUIA_Text_Contents, (u32)label)
        tags.add(MUIA_Text_PreParse, (u32)centered)
        tags.add(MUIA_InputMode, (u32)MUIV_InputMode_RelVerify)
        tags.add(MUIA_Background, (u32)MUII_ButtonBack)

        return MUI_NewObjectA("Text.mui".ptr, tags.finish())
    }
}

/// Create a text label
pub fn make_text(text: *u8) -> *u8 {
    unsafe {
        var tags = TagBuilder::new()
        tags.add(MUIA_Text_Contents, (u32)text)

        return MUI_NewObjectA("Text.mui".ptr, tags.finish())
    }
}

/// Create a text label with preparse codes
pub fn make_text_preparse(text: *u8, preparse: *u8) -> *u8 {
    unsafe {
        var tags = TagBuilder::new()
        tags.add(MUIA_Text_Contents, (u32)text)
        tags.add(MUIA_Text_PreParse, (u32)preparse)

        return MUI_NewObjectA("Text.mui".ptr, tags.finish())
    }
}

/// Set an attribute on an object
pub fn set_attr(obj: *u8, attr: u32, value: u32) {
    unsafe {
        let msg: [u32] = [MUIM_Set, attr, value]
        DoMethodA(obj, &msg[0])
    }
}

/// Set a string attribute on an object (convenience for text content)
pub fn set_text(obj: *u8, text: Str) {
    unsafe {
        let msg: [u32] = [MUIM_Set, MUIA_Text_Contents, (u32)text.as_ptr()]
        DoMethodA(obj, &msg[0])
    }
}

/// Set a string attribute on an object (any string attribute)
pub fn set_str_attr(obj: *u8, attr: u32, text: Str) {
    unsafe {
        let msg: [u32] = [MUIM_Set, attr, (u32)text.as_ptr()]
        DoMethodA(obj, &msg[0])
    }
}

// GetAttr from intuition.library
extern fn GetAttr(attr_id: u32, object: *u8, storage: *u32) -> u32

/// Get an attribute from an object
/// Returns the attribute value, also stores it in storage if provided
pub fn get_attr(obj: *u8, attr: u32, storage: *u32) -> u32 {
    unsafe {
        var value: u32 = 0
        GetAttr(attr, obj, &value)
        if storage {
            *storage = value
        }
        return value
    }
}

/// Add entries to a list
pub fn list_insert(list: *u8, entries: **u8, count: i32, pos: i32) {
    unsafe {
        let msg: [u32] = [MUIM_List_Insert, (u32)entries, (u32)count, (u32)pos]
        DoMethodA(list, &msg[0])
    }
}

/// Clear a list
pub fn list_clear(list: *u8) {
    unsafe {
        let msg: [u32] = [MUIM_List_Clear]
        DoMethodA(list, &msg[0])
    }
}

/// Redraw a list
pub fn list_redraw(list: *u8, entry: i32) {
    unsafe {
        let msg: [u32] = [MUIM_List_Redraw, (u32)entry]
        DoMethodA(list, &msg[0])
    }
}

// ============================================================================
// MUI Menu System - Novus-Native Builder API
// ============================================================================
//
// Usage:
//   var menustrip = MenuBuilder::new()
//
//   menustrip.menu("Project")
//       .item("New", "N", MENU_NEW)
//       .item("Open...", "O", MENU_OPEN)
//       .separator()
//       .item("Quit", "Q", MENU_QUIT)
//
//   menustrip.menu("Edit")
//       .item("Cut", "X", MENU_CUT)
//       .item("Copy", "C", MENU_COPY)
//       .item("Paste", "V", MENU_PASTE)
//
//   app_builder.menustrip(menustrip.build())
//
// ============================================================================

/// Menu item builder - accumulates items for a single menu
pub struct MenuItemBuilder {
    menu_obj: *u8           // The Menu object we're adding items to
    parent: *MenuBuilder    // Parent menu builder that tracks labels
}

impl MenuItemBuilder {
    /// Create a new menu item builder for a menu object
    fn new(menu_obj: *u8, parent: *MenuBuilder) -> MenuItemBuilder {
        return MenuItemBuilder {
            menu_obj: menu_obj,
            parent: parent,
        }
    }

    /// Allocate and track a label string (delegates to parent MenuBuilder)
    fn alloc_label(&var self, text: Str) -> *u8 {
        unsafe {
            return (*self.parent).alloc_label(text)
        }
    }

    /// Add a regular menu item (chainable)
    @chain
    pub fn item(&var self, title: Str, shortcut: Str, id: u32) {
        unsafe {
            let title_ptr = self.alloc_label(title)

            var tags = TagBuilder::new()
            tags.add(MUIA_Menuitem_Title, (u32)title_ptr)
            tags.add(MUIA_UserData, id)

            if shortcut.len() > 0 {
                let shortcut_ptr = self.alloc_label(shortcut)
                tags.add(MUIA_Menuitem_Shortcut, (u32)shortcut_ptr)
            }

            let item = MUI_NewObjectA("Menuitem.mui".ptr, tags.finish())
            if item != null {
                // Add to menu using MUIA_Family_Child
                let add_msg: [u32] = [MUIM_Family_AddTail, (u32)item, (u32)0]
                DoMethodA(self.menu_obj, &add_msg[0])
            }
        }
    }

    /// Add a checkable menu item (chainable)
    @chain
    pub fn checkitem(&var self, title: Str, shortcut: Str, id: u32, checked: bool) {
        unsafe {
            let title_ptr = self.alloc_label(title)

            var tags = TagBuilder::new()
            tags.add(MUIA_Menuitem_Title, (u32)title_ptr)
            tags.add(MUIA_UserData, id)
            tags.add(MUIA_Menuitem_Checkit, 1)
            tags.add(MUIA_Menuitem_Toggle, 1)
            if checked {
                tags.add(MUIA_Menuitem_Checked, 1)
            }

            if shortcut.len() > 0 {
                let shortcut_ptr = self.alloc_label(shortcut)
                tags.add(MUIA_Menuitem_Shortcut, (u32)shortcut_ptr)
            }

            let item = MUI_NewObjectA("Menuitem.mui".ptr, tags.finish())
            if item != null {
                let add_msg: [u32] = [MUIM_Family_AddTail, (u32)item, (u32)0]
                DoMethodA(self.menu_obj, &add_msg[0])
            }
        }
    }

    /// Add a separator bar (chainable)
    @chain
    pub fn separator(&var self) {
        unsafe {
            // MUI uses NM_BARLABEL (~0) for separators, but in object form
            // we create a menuitem with no title (becomes a bar)
            var tags = TagBuilder::new()
            tags.add(MUIA_Menuitem_Title, (u32)NM_BARLABEL)

            let item = MUI_NewObjectA("Menuitem.mui".ptr, tags.finish())
            if item != null {
                let add_msg: [u32] = [MUIM_Family_AddTail, (u32)item, (u32)0]
                DoMethodA(self.menu_obj, &add_msg[0])
            }
        }
    }

    /// Get the built menu object
    pub fn build(&self) -> *u8 {
        // Note: labels are NOT freed here - they're owned by the menu items
        // They will be freed when the menustrip is disposed
        return self.menu_obj
    }
}

// Special constant for menu separator
const NM_BARLABEL: u32 = $FFFFFFFF

/// Menu strip builder - creates the full menu bar
pub struct MenuBuilder {
    menus: **u8             // Array of Menu objects
    menu_count: u32
    menu_capacity: u32
    labels: **u8            // Track all allocated labels
    label_count: u32
    label_capacity: u32
}

impl MenuBuilder {
    /// Create a new menu builder
    pub fn new() -> MenuBuilder {
        unsafe {
            let menu_capacity: u32 = 8
            let label_capacity: u32 = 64

            let menus = (**u8)AllocVec(menu_capacity * 4, MEMF_PUBLIC | MEMF_CLEAR)
            let labels = (**u8)AllocVec(label_capacity * 4, MEMF_PUBLIC | MEMF_CLEAR)

            return MenuBuilder {
                menus: menus,
                menu_count: 0,
                menu_capacity: menu_capacity,
                labels: labels,
                label_count: 0,
                label_capacity: label_capacity,
            }
        }
    }

    /// Allocate and track a label string
    fn alloc_label(&var self, text: Str) -> *u8 {
        unsafe {
            let len = (u32)text.len() + 1
            let ptr = (*u8)AllocVec(len, MEMF_PUBLIC)
            if ptr != null {
                CopyMem(text.ptr, ptr, (u32)text.len())
                ptr[text.len()] = 0

                if self.label_count < self.label_capacity {
                    self.labels[self.label_count] = ptr
                    self.label_count++
                }
            }
            return ptr
        }
    }

    /// Add a new menu to the menustrip and return a builder for its items
    pub fn menu(&var self, title: Str) -> MenuItemBuilder {
        unsafe {
            let title_ptr = self.alloc_label(title)

            var tags = TagBuilder::new()
            tags.add(MUIA_Menu_Title, (u32)title_ptr)

            let menu_obj = MUI_NewObjectA("Menu.mui".ptr, tags.finish())

            // Track this menu
            if menu_obj != null {
                if self.menu_count < self.menu_capacity {
                    self.menus[self.menu_count] = menu_obj
                    self.menu_count++
                }
            }

            return MenuItemBuilder::new(menu_obj, self)
        }
    }

    /// Build the complete menustrip object
    /// Returns a MenuStrip wrapper that owns the labels and frees them on Drop
    pub fn build(consuming self) -> MenuStrip {
        unsafe {
            // Create the menustrip with all menus as children
            var tags = TagBuilder::new()

            // Add all menus as children
            var i: u32 = 0
            forever {
                if i >= self.menu_count {
                    break
                }
                if self.menus[i] != null {
                    tags.add(MUIA_Family_Child, (u32)self.menus[i])
                }
                i++
            }

            let strip = MUI_NewObjectA("Menustrip.mui".ptr, tags.finish())

            // Free the menus tracking array (MUI now owns the menu objects)
            if self.menus != null {
                FreeVec((*u8)self.menus)
            }

            // Return wrapper that owns the labels
            return MenuStrip {
                obj: strip,
                labels: self.labels,
                label_count: self.label_count,
            }
        }
    }
}

/// Wrapper for MUI menustrip that owns allocated label strings
/// Drop frees the labels when the menustrip is no longer needed
pub struct MenuStrip {
    obj: *u8
    labels: **u8
    label_count: u32
}

impl MenuStrip {
    /// Get the raw MUI menustrip object pointer
    pub fn ptr(&self) -> *u8 {
        return self.obj
    }
}

impl Drop for MenuStrip {
    fn drop(&var self) {
        unsafe {
            // Free all tracked label strings
            if self.labels != null {
                var i: u32 = 0
                forever {
                    if i >= self.label_count {
                        break
                    }
                    if self.labels[i] != null {
                        FreeVec(self.labels[i])
                    }
                    i++
                }
                FreeVec((*u8)self.labels)
                self.labels = null
            }
            // Note: We don't dispose the MUI object here - it's owned by the MUIApp
            // and will be disposed when the app is disposed
        }
    }
}

// Add MUIM_Family methods we need
pub const MUIM_Family_AddTail: u32 = $8042d752
pub const MUIM_Family_AddHead: u32 = $8042e200
pub const MUIM_Family_Remove: u32 = $8042f8a9

// ============================================================================
// MUI Tabs (Register) - Tabbed Page Groups
// ============================================================================
//
// MUI's Register class creates tabbed interfaces where each tab shows
// a different page (group).
//
// Usage:
//   var tabs = MUITabsBuilder::new(app_builder)
//   tabs.add_tab("General", general_group)
//   tabs.add_tab("Advanced", advanced_group)
//   tabs.add_tab("About", about_group)
//   let register = tabs.build()
//   root.child(register)
//
// ============================================================================

/// Builder for MUI tabbed interfaces (Register class)
pub struct MUITabsBuilder {
    app_builder: *MUIAppBuilder
    titles: **u8           // NULL-terminated array of title strings
    title_count: u32
    title_capacity: u32
    pages: **u8            // Array of page group objects
    page_count: u32
    page_capacity: u32
    frame: bool            // Whether to draw a frame around the register
}

impl MUITabsBuilder {
    /// Create a new tabs builder
    pub fn new(app: *MUIAppBuilder) -> MUITabsBuilder {
        unsafe {
            let title_capacity: u32 = 16
            let page_capacity: u32 = 16

            // Allocate titles array (+1 for NULL terminator)
            let titles = (**u8)AllocVec((title_capacity + 1) * 4, MEMF_PUBLIC | MEMF_CLEAR)
            let pages = (**u8)AllocVec(page_capacity * 4, MEMF_PUBLIC | MEMF_CLEAR)

            return MUITabsBuilder {
                app_builder: app,
                titles: titles,
                title_count: 0,
                title_capacity: title_capacity,
                pages: pages,
                page_count: 0,
                page_capacity: page_capacity,
                frame: true,  // Frame by default
            }
        }
    }

    /// Set whether to draw a frame around the tabs
    @chain
    pub fn frame(&var self, enable: bool) {
        self.frame = enable
    }

    /// Add a tab page with a title and content group
    @chain
    pub fn add_tab(&var self, title: Str, content: *u8) {
        unsafe {
            // Skip if at capacity or null content
            if self.title_count >= self.title_capacity || content == null {
                return self
            }

            // Allocate title string
            let title_ptr = (*self.app_builder).alloc_label(title)

            // Add to titles array
            self.titles[self.title_count] = title_ptr
            self.title_count++
            // Keep NULL terminator
            self.titles[self.title_count] = null

            // Add page to pages array
            if self.page_count < self.page_capacity {
                self.pages[self.page_count] = content
                self.page_count++
            }
        }
    }

    /// Build the Register object
    pub fn build(&var self) -> *u8 {
        unsafe {
            if self.title_count == 0 {
                return null  // No tabs
            }

            var tags = TagBuilder::new()

            // Set titles array (NULL-terminated array of strings)
            tags.add(MUIA_Register_Titles, (u32)self.titles)

            // Set frame option
            if self.frame {
                tags.add(MUIA_Register_Frame, 1)
            }

            // Add all pages as children
            var i: u32 = 0
            forever {
                if i >= self.page_count {
                    break
                }
                if self.pages[i] != null {
                    tags.add(MUIA_Group_Child, (u32)self.pages[i])
                }
                i++
            }

            let reg_obj = MUI_NewObjectA("Register.mui".ptr, tags.finish())

            // Free our tracking arrays (objects are now owned by Register)
            // Note: titles array is NOT freed - Register needs it to stay valid
            // The strings themselves are tracked by app_builder
            FreeVec((*u8)self.pages)
            self.pages = null
            self.page_count = 0

            return reg_obj
        }
    }
}

impl Drop for MUITabsBuilder {
    fn drop(&var self) {
        unsafe {
            // Free pages array if still owned
            if self.pages != null {
                // Dispose any pages that weren't transferred
                var i: u32 = 0
                forever {
                    if i >= self.page_count {
                        break
                    }
                    if self.pages[i] != null {
                        MUI_DisposeObject(self.pages[i])
                    }
                    i++
                }
                FreeVec((*u8)self.pages)
            }

            // Free titles array
            if self.titles != null {
                FreeVec((*u8)self.titles)
            }
        }
    }
}

// ============================================================================
// MUI Radio Buttons
// ============================================================================
//
// MUI's Radio class creates a group of mutually exclusive radio buttons.
//
// Usage:
//   let entries: [*u8; 4] = ["Option A".ptr, "Option B".ptr, "Option C".ptr, (*u8)0]
//   let radio = make_radio(GAD_RADIO, &entries[0], 0)
//   root.child(radio)
//
// ============================================================================

/// Create a radio button group
/// entries must be a NULL-terminated array of string pointers
/// initial is the initially selected entry index (0-based)
pub fn make_radio(id: u32, entries: **u8, initial: i32) -> *u8 {
    unsafe {
        var tags = TagBuilder::new()
        tags.add(MUIA_Radio_Entries, (u32)entries)
        tags.add(MUIA_Radio_Active, (u32)initial)
        tags.add(MUIA_UserData, id)

        return MUI_NewObjectA("Radio.mui".ptr, tags.finish())
    }
}

/// Set up radio button change notification
pub fn on_radio(app: &MUIApp, radio: *u8, return_id: u32) {
    app.notify_val(radio, MUIA_Radio_Active, MUIV_EveryTime,
                   app.app, MUIM_Application_ReturnID, return_id)
}

// ============================================================================
// MUI PopAsl - Popup ASL Requesters
// ============================================================================
//
// MUI's PopAsl class provides popup buttons that open ASL file/font requesters.
//
// Usage:
//   let file_popup = make_file_popup(GAD_FILE)
//   root.child(file_popup)
//
// ============================================================================

/// Create a file requester popup
pub fn make_file_popup(id: u32) -> *u8 {
    unsafe {
        var tags = TagBuilder::new()
        tags.add(MUIA_Popasl_Type, ASL_FileRequest)
        tags.add(MUIA_UserData, id)

        return MUI_NewObjectA("Popasl.mui".ptr, tags.finish())
    }
}

/// Create a font requester popup
pub fn make_font_popup(id: u32) -> *u8 {
    unsafe {
        var tags = TagBuilder::new()
        tags.add(MUIA_Popasl_Type, ASL_FontRequest)
        tags.add(MUIA_UserData, id)

        return MUI_NewObjectA("Popasl.mui".ptr, tags.finish())
    }
}

/// Create a screenmode requester popup
pub fn make_screenmode_popup(id: u32) -> *u8 {
    unsafe {
        var tags = TagBuilder::new()
        tags.add(MUIA_Popasl_Type, ASL_ScreenModeRequest)
        tags.add(MUIA_UserData, id)

        return MUI_NewObjectA("Popasl.mui".ptr, tags.finish())
    }
}

// ============================================================================
// MUI Busy/Progress Indicator
// ============================================================================
//
// MUI's Gauge class can be used as a progress indicator.
// For a "busy" spinner effect, use the Application's Sleep attribute.
//
// Usage:
//   let progress = make_progress(GAD_PROGRESS, 100, true)  // horiz, max 100
//   root.child(progress)
//
//   // Update progress:
//   set_attr(progress, MUIA_Gauge_Current, 50)  // 50%
//
// ============================================================================

/// Create a progress bar (horizontal or vertical gauge)
/// max is the maximum value, horiz determines orientation
pub fn make_progress(id: u32, max: i32, horiz: bool) -> *u8 {
    unsafe {
        var tags = TagBuilder::new()
        tags.add(MUIA_Frame, (u32)MUIV_Frame_Gauge)
        tags.add(MUIA_Gauge_Max, (u32)max)
        tags.add(MUIA_Gauge_Horiz, if horiz { 1 } else { 0 })
        tags.add(MUIA_UserData, id)

        return MUI_NewObjectA("Gauge.mui".ptr, tags.finish())
    }
}

/// Create a progress bar with info text
/// The info_text can include %ld to show current value
pub fn make_progress_with_text(id: u32, max: i32, horiz: bool, info_text: *u8) -> *u8 {
    unsafe {
        var tags = TagBuilder::new()
        tags.add(MUIA_Frame, (u32)MUIV_Frame_Gauge)
        tags.add(MUIA_Gauge_Max, (u32)max)
        tags.add(MUIA_Gauge_Horiz, if horiz { 1 } else { 0 })
        tags.add(MUIA_Gauge_InfoText, (u32)info_text)
        tags.add(MUIA_UserData, id)

        return MUI_NewObjectA("Gauge.mui".ptr, tags.finish())
    }
}

/// Set progress value (0 to max)
pub fn set_progress(gauge: *u8, value: i32) {
    set_attr(gauge, MUIA_Gauge_Current, (u32)value)
}

/// Put the application to sleep (shows busy pointer)
pub fn app_busy(app: *u8, busy: bool) {
    set_attr(app, MUIA_Application_Sleep, if busy { 1 } else { 0 })
}
