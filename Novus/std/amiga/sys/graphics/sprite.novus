// Hardware Sprite Support for Amiga
//
// This module provides safe, ergonomic access to Amiga hardware sprites.
//
// Quick Start:
//   const PLAYER_DATA = [
//       $0000, $0000,  // Control words
//       $0FF0, $0000,  // Scanline 1: bitplane 0, bitplane 1
//       $1FF8, $0000,  // Scanline 2
//       $0FF0, $0000,  // Scanline 3
//       $0000, $0000   // Terminator
//   ]
//
//   var sprite_data = SpriteData::from_raw(&PLAYER_DATA)?
//   var sprite = SpriteHandle::alloc(0)?
//   sprite.set_colors(&[Color::rgb(255, 0, 0), Color::rgb(0, 255, 0), Color::rgb(0, 0, 255)])?
//   sprite.show(&sprite_data, 100, 50)?
//   sprite.move_to(200, 100)?

from std::core import Result, Option
from amiga::sys::graphics::errors import GraphicsError
from amiga::sys::graphics::palette import Color
from amiga::sys::exec::memory::allocation import MemHandle
from amiga::raw::structs import Custom
from amiga::raw::graphics import WaitTOF
from amiga::raw::exec import FreeVec
from amiga::sys::hardware::chipset import DisplayType, SystemChipset, CHIPSET, DISPLAY

// Track if sprite DMA has been enabled
static var DMA_ENABLED: bool = false
static var BLANK_SPRITE: *u16 = null
static var SPRITE_FETCH_WIDTH: u16 = 16
static var SPRITE_CHANNELS_VISIBLE: u8 = 0

fn fetch_words_for_width(width: u16) -> u32 {
    return match width {
        16 => 1,
        32 => 2,
        64 => 4,
        _ => 0,
    }
}

fn sprite_pair_collision_bit(first: u8, second: u8) -> u16 {
    let first_pair = first / 2
    let second_pair = second / 2
    if first_pair == second_pair { return 0 }
    let low = if first_pair < second_pair { first_pair } else { second_pair }
    let high = if first_pair < second_pair { second_pair } else { first_pair }
    return match low {
        0 => match high { 1 => 1 << 10, 2 => 1 << 11, 3 => 1 << 13, _ => 0 },
        1 => match high { 2 => 1 << 12, 3 => 1 << 14, _ => 0 },
        2 => match high { 3 => 1 << 15, _ => 0 },
        _ => 0,
    }
}

fn configure_sprite_fetch_width(width: u16, channel: u8) -> Result<(), GraphicsError> {
    if fetch_words_for_width(width) == 0 {
        return Result::Err(GraphicsError::InvalidSpriteData)
    }
    if width > 16 && CHIPSET() != SystemChipset::AGA {
        return Result::Err(GraphicsError::BadDisplayMode)
    }
    if width == SPRITE_FETCH_WIDTH {
        return Result::Ok(())
    }
    let channel_mask: u8 = 1 << channel
    let other_visible = SPRITE_CHANNELS_VISIBLE & (channel_mask ^ $FF)
    if other_visible != 0 {
        return Result::Err(GraphicsError::BadDisplayMode)
    }
    unsafe {
        let fmode = (*u16)$DFF1FC
        // FMODE is write-only. The direct-hardware API owns the display mode;
        // Intuition applications must use the OS-backed extended sprite API.
        *fmode = match width { 32 => $0004, 64 => $000C, _ => 0 }
        SPRITE_FETCH_WIDTH = width
    }
    return Result::Ok(())
}

// Initialize the sprite system - enables sprite DMA
// PAL/NTSC detection is handled automatically by amiga::sys::hardware::chipset::DISPLAY()
/// Applies init sprite system to the module.
pub fn init_sprite_system() {
    unsafe {
        if DMA_ENABLED {
            return
        }

        // Enable sprite DMA (DMACON register at $DFF096)
        // Set bit 15 (SETCLR) + bit 5 (SPREN - sprite DMA enable)
        // DMACON uses set/clear semantics; bit 15 selects "set".
        let dmacon = (*u16)$DFF096
        *dmacon = $8020

        DMA_ENABLED = true
    }
}

fn ensure_blank_sprite() -> Result<*u16, GraphicsError> {
    if BLANK_SPRITE != null {
        return Result::Ok(BLANK_SPRITE)
    }
    // A single all-zero block is a valid terminator in every AGA fetch width.
    match MemHandle::new_chip(32) {
        Result::Err(_) => return Result::Err(GraphicsError::BitMapAllocFailed),
        Result::Ok(memory) => {
            unsafe {
                let words = (*u16)memory.ptr()
                for i in 0..16 { words[i] = 0 }
                BLANK_SPRITE = (*u16)memory.into_raw()
            }
            return Result::Ok(BLANK_SPRITE)
        },
    }
}

fn write_sprite_pointer(custom: *u8, channel: u8, data: *u16) {
    let address = (u32)data
    let offset = (u32)channel * 4
    unsafe {
        let high = (*u16)((u32)custom + $120 + offset)
        let low = (*u16)((u32)custom + $122 + offset)
        *high = (u16)(address >> 16)
        *low = (u16)(address & $FFFF)
    }
}

// Deprecated: Use init_sprite_system() instead
/// Detects display mode for the module.
pub fn detect_display_mode() {
    init_sprite_system()
}

fn get_vstart_offset() -> u16 {
    return match DISPLAY() {
        DisplayType::PAL => $2C,   // PAL offset
        DisplayType::NTSC => $18,  // NTSC offset
    }
}

// Unified sprite data representation
// Works with both hardware and OS APIs
// Supports both compile-time constants (future) and runtime allocation
//
// Memory layout (interleaved bitplanes):
//   [0-3]   Control words (POS/CTL) - filled at runtime based on position
//   [4...]  Pixel data: plane0_row0, plane1_row0, plane0_row1, plane1_row1, ...
//   [end]   Terminator: 0x0000, 0x0000
/// Represents a sprite data value.
pub struct SpriteData {
    /// The data ptr value stored by `SpriteData`.
    data_ptr: *u16,      // Points to sprite data in CHIP RAM
    /// The owns memory value stored by `SpriteData`.
    owns_memory: bool,   // true = runtime allocated, false = compile-time const (future)
    /// The height value stored by `SpriteData`.
    height: u16,         // Sprite height in scanlines
    /// The width value stored by `SpriteData`.
    width: u16,          // Always 16 for regular sprites
}

impl SpriteData {
    // Create sprite data from raw hardware format (runtime allocation)
    // Data format: control_word, plane0_line0, plane1_line0, ..., terminator
    // Minimum 4 words required (control + 1 line + terminator)
    //
    // Note: Control words at offset 0-3 will be overwritten at runtime when sprite is shown
    /// Wraps a raw representation as `SpriteData`.
    ///
    /// # Parameters
    /// * `data` - The data used by the operation.
    /// * `len` - The requested len.
    ///
    /// # Returns
    /// The requested value on success; the error value explains why the operation could not complete.
    pub fn from_raw(data: *u16, len: u32) -> Result<SpriteData, GraphicsError> {
        return SpriteData::from_raw_width(data, len, 16)
    }

    /// Copies hardware-format sprite words into CHIP RAM for a 16, 32, or
    /// 64-pixel fetch. Widths above 16 require AGA. Each control, data, and
    /// terminator word expands to `width / 16` consecutive words.
    ///
    /// # Parameters
    /// * `data` - Complete hardware sprite data, including control and terminator blocks.
    /// * `len` - Number of 16-bit words in `data`.
    /// * `width` - Sprite fetch width: 16, 32, or 64 pixels.
    ///
    /// # Returns
    /// The copied sprite data, or an error for an unsupported width or malformed layout.
    pub fn from_raw_width(data: *u16, len: u32, width: u16) -> Result<SpriteData, GraphicsError> {
        let fetch_words = fetch_words_for_width(width)
        if fetch_words == 0 {
            return Result::Err(GraphicsError::InvalidSpriteData)
        }
        if width > 16 && CHIPSET() != SystemChipset::AGA {
            return Result::Err(GraphicsError::BadDisplayMode)
        }
        let words_per_row = fetch_words * 2
        let overhead = words_per_row * 2
        if data == null || len < overhead + words_per_row || (len - overhead) % words_per_row != 0 {
            return Result::Err(GraphicsError::InvalidSpriteData)
        }
        unsafe {
            for i in (len - words_per_row)..len {
                if data[i] != 0 {
                    return Result::Err(GraphicsError::InvalidSpriteData)
                }
            }
        }

        // Allocate CHIP RAM
        let size_bytes = len * 2
        let chip_mem_opt = MemHandle::new_chip(size_bytes)

        match chip_mem_opt {
            Result::Err(_) => {
                return Result::Err(GraphicsError::BitMapAllocFailed)
            },
            Result::Ok(chip_mem) => {
                // Copy data to CHIP RAM
                unsafe {
                    let dest = (*u16)chip_mem.ptr()
                    for i in 0..len {
                        dest[i] = data[i]
                    }
                }

                let data_ptr = (*u16)chip_mem.into_raw()

                // Calculate height from data
                let num_lines = (len - overhead) / words_per_row

                return Result::Ok(SpriteData {
                    data_ptr: data_ptr,
                    owns_memory: true,
                    height: (u16)num_lines,
                    width: width,
                })
            }
        }
    }

    // Future: Create sprite from compile-time constant
    // Requires compiler support for @chip attribute and const functions
    //
    // pub const fn from_const(data: &[u16], height: u16) -> SpriteData {
    //     return SpriteData {
    //         data_ptr: (*u16)data,
    //         owns_memory: false,
    //         height: height,
    //         width: 16,
    //     }
    // }

    // Get pointer to sprite data (for hardware/OS use)
    /// Borrows `SpriteData` as ptr.
    ///
    /// # Returns
    /// The resulting `*u16` value.
    pub fn as_ptr(&self) -> *u16 {
        return self.data_ptr
    }

    // Get sprite height in scanlines
    /// Returns the height value associated with `SpriteData`.
    ///
    /// # Returns
    /// The resulting `u16` value.
    pub fn height(&self) -> u16 {
        return self.height
    }

    // Get sprite width (always 16 pixels)
    /// Returns the width value associated with `SpriteData`.
    ///
    /// # Returns
    /// The resulting `u16` value.
    pub fn width(&self) -> u16 {
        return self.width
    }
}

// RAII cleanup - free allocated CHIP RAM when sprite data goes out of scope
impl Drop for SpriteData {
    fn drop(&var self) {
        if self.owns_memory {
            // Free allocated CHIP RAM
            unsafe {
                let ptr = (*u8)self.data_ptr
                FreeVec(ptr)
            }
        }
        // If !owns_memory, it's a compile-time constant in __chip section, don't free
    }
}

// Global sprite channel allocation bitmap (bit N = sprite N allocated)
static var SPRITE_CHANNELS_ALLOCATED: u8 = 0

// Manages a single hardware sprite channel (0-7)
/// Owns a sprite handle and releases its resources when dropped.
pub struct SpriteHandle {
    /// The channel value stored by `SpriteHandle`.
    channel: u8,         // 0-7
    /// The is allocated value stored by `SpriteHandle`.
    is_allocated: bool,
    /// The custom value stored by `SpriteHandle`.
    custom: *u8,  // Pointer to Custom chipset registers at $DFF000
    /// The visible value stored by `SpriteHandle`.
    visible: bool,       // Track visibility state
    /// The pos x value stored by `SpriteHandle`.
    pos_x: i16,          // Current X position
    /// The pos y value stored by `SpriteHandle`.
    pos_y: i16,          // Current Y position
    /// The sprite height value stored by `SpriteHandle`.
    sprite_height: u16,  // Current sprite height (for vstop calculation)
    /// Current sprite fetch width.
    sprite_width: u16,
    /// Current image whose control words are consumed by sprite DMA.
    sprite_data: *u16,
    /// Whether this is the odd member of an attached sprite pair.
    attached: bool,
}

impl SpriteHandle {
    // Allocate a sprite channel
    /// Allocates `SpriteHandle`.
    ///
    /// # Parameters
    /// * `channel` - The `u8` value used as channel.
    ///
    /// # Returns
    /// The requested value on success; the error value explains why the operation could not complete.
    pub fn alloc(channel: u8) -> Result<SpriteHandle, GraphicsError> {
        if channel > 7 {
            return Result::Err(GraphicsError::InvalidSpriteChannel)
        }

        let blank = ensure_blank_sprite()?

        // Check if channel is already allocated
        unsafe {
            let channel_mask: u8 = 1 << channel
            if (SPRITE_CHANNELS_ALLOCATED & channel_mask) != 0 {
                return Result::Err(GraphicsError::SpriteChannelInUse)
            }
            SPRITE_CHANNELS_ALLOCATED = SPRITE_CHANNELS_ALLOCATED | channel_mask
        }

        let custom = (*u8)$DFF000
        write_sprite_pointer(custom, channel, blank)
        init_sprite_system()

        return Result::Ok(SpriteHandle {
            channel: channel,
            is_allocated: true,
            custom: custom,
            visible: false,
            pos_x: 0,
            pos_y: 0,
            sprite_height: 0,
            sprite_width: 16,
            sprite_data: null,
            attached: false,
        })
    }

    // Show sprite at position
    // WARNING: sprite must remain valid (not dropped) while in use by hardware
    /// Makes `SpriteHandle` visible.
    ///
    /// # Parameters
    /// * `sprite` - The `&SpriteData` value used as sprite.
    /// * `x` - The `i16` value used as x.
    /// * `y` - The `i16` value used as y.
    ///
    /// # Returns
    /// `Result::Ok(())` on success; the error value explains why the operation could not complete.
    pub fn show(&var self, sprite: &SpriteData, x: i16, y: i16) -> Result<(), GraphicsError> {
        if !self.is_allocated {
            return Result::Err(GraphicsError::SpriteNotAllocated)
        }
        configure_sprite_fetch_width(sprite.width(), self.channel)?

        // Store sprite height for vstop calculation
        self.sprite_height = sprite.height()
        self.sprite_width = sprite.width()

        self.sprite_data = sprite.as_ptr()
        self.move_to(x, y)?

        // Install the fully initialized data at VBlank to avoid a DMA race.
        WaitTOF()
        write_sprite_pointer(self.custom, self.channel, self.sprite_data)
        self.visible = true
        unsafe { SPRITE_CHANNELS_VISIBLE = SPRITE_CHANNELS_VISIBLE | (1 << self.channel) }

        return Result::Ok(())
    }

    // Move sprite to new position
    /// Moves `SpriteHandle` to an absolute position.
    ///
    /// # Parameters
    /// * `x` - The `i16` value used as x.
    /// * `y` - The `i16` value used as y.
    ///
    /// # Returns
    /// `Result::Ok(())` on success; the error value explains why the operation could not complete.
    pub fn move_to(&var self, x: i16, y: i16) -> Result<(), GraphicsError> {
        if !self.is_allocated {
            return Result::Err(GraphicsError::SpriteNotAllocated)
        }

        // Calculate hardware position with offset
        let hw_x_value = x + $81
        let hw_y_value = y + (i16)get_vstart_offset()
        if hw_x_value < 0 || hw_y_value < 0 {
            return Result::Err(GraphicsError::InvalidSpriteData)
        }
        let hw_x = (u16)hw_x_value
        let hw_y = (u16)hw_y_value

        // Calculate VSTART/VSTOP
        // VSTOP = VSTART + height + 1 (hardware requirement)
        let vstart = hw_y
        let vstop = hw_y + self.sprite_height + 1

        let max_vertical: u16 = if CHIPSET() == SystemChipset::AGA { 1023 } else { 511 }
        if hw_x > 511 || vstop > max_vertical {
            return Result::Err(GraphicsError::InvalidSpriteData)
        }

        self.pos_x = x
        self.pos_y = y

        // SPRxPOS format: VSTART (8 bits) | HSTART (8 bits)
        let pos = ((vstart & $FF) << 8) | (hw_x & $FF)

        // SPRxCTL format: VSTOP[7:0] | ATTACH | unused | unused | unused | unused | VSTOP[8] | VSTART[8] | HSTART[0]
        let vstop_hi = (vstop >> 8) & 1
        let vstart_hi = (vstart >> 8) & 1
        let hstart_hi = (hw_x >> 8) & 1
        var ctl = ((vstop & $FF) << 8) | (vstop_hi << 2) | (vstart_hi << 1) | hstart_hi
        if CHIPSET() == SystemChipset::AGA {
            ctl = ctl | (((vstart >> 9) & 1) << 6) | (((vstop >> 9) & 1) << 5)
        }
        if self.attached {
            ctl = ctl | $80
        }

        // Write to hardware registers
        let channel_offset = self.channel * 8
        let spr_pos_offset = $140 + (u32)channel_offset
        let spr_ctl_offset = $142 + (u32)channel_offset

        unsafe {
            if self.sprite_data != null {
                self.sprite_data[0] = pos
                self.sprite_data[(u32)self.sprite_width / 16] = ctl
            }
            let pos_reg = (*u16)((u32)self.custom + spr_pos_offset)
            let ctl_reg = (*u16)((u32)self.custom + spr_ctl_offset)
            *pos_reg = pos
            *ctl_reg = ctl
        }

        return Result::Ok(())
    }

    // Hide sprite (move offscreen)
    /// Hides `SpriteHandle`.
    ///
    /// # Returns
    /// `Result::Ok(())` on success; the error value explains why the operation could not complete.
    pub fn hide(&var self) -> Result<(), GraphicsError> {
        if !self.is_allocated {
            return Result::Err(GraphicsError::SpriteNotAllocated)
        }
        let blank = ensure_blank_sprite()?
        WaitTOF()
        write_sprite_pointer(self.custom, self.channel, blank)
        self.visible = false
        unsafe { SPRITE_CHANNELS_VISIBLE = SPRITE_CHANNELS_VISIBLE & ((1 << self.channel) ^ $FF) }
        self.pos_x = -(i16)self.sprite_width
        self.pos_y = match DISPLAY() {
            DisplayType::PAL => 257,
            DisplayType::NTSC => 201,
        }
        return Result::Ok(())
    }

    // Query if sprite is visible
    /// Returns whether visible for `SpriteHandle`.
    ///
    /// # Returns
    /// `true` when the stated condition holds; otherwise `false`.
    pub fn is_visible(&self) -> bool {
        return self.visible
    }

    // Get current position
    /// Returns the position value associated with `SpriteHandle`.
    ///
    /// # Returns
    /// The resulting `(i16, i16)` value.
    pub fn position(&self) -> (i16, i16) {
        return (self.pos_x, self.pos_y)
    }

    // Move sprite by relative offset
    /// Moves `SpriteHandle` by a relative offset.
    ///
    /// # Parameters
    /// * `dx` - The `i16` value used as dx.
    /// * `dy` - The `i16` value used as dy.
    ///
    /// # Returns
    /// `Result::Ok(())` on success; the error value explains why the operation could not complete.
    pub fn move_by(&var self, dx: i16, dy: i16) -> Result<(), GraphicsError> {
        let new_x = self.pos_x + dx
        let new_y = self.pos_y + dy
        return self.move_to(new_x, new_y)
    }

    // Check if sprite position is within screen bounds
    // Assumes standard screen size (320x256 for PAL, 320x200 for NTSC)
    /// Returns whether on screen for `SpriteHandle`.
    ///
    /// # Returns
    /// `true` when the stated condition holds; otherwise `false`.
    pub fn is_on_screen(&self) -> bool {
        if self.pos_x < -(i16)self.sprite_width || self.pos_x > 320 {
            return false
        }
        let max_y: i16 = match DISPLAY() {
            DisplayType::PAL => 256,
            DisplayType::NTSC => 200,
        }
        if self.pos_y < 0 || self.pos_y > max_y {
            return false
        }
        return true
    }

    // Change sprite image (for animation)
    // WARNING: sprite must remain valid (not dropped) while in use by hardware
    /// Sets image for `SpriteHandle`.
    ///
    /// # Parameters
    /// * `sprite` - The `&SpriteData` value used as sprite.
    ///
    /// # Returns
    /// `Result::Ok(())` on success; the error value explains why the operation could not complete.
    pub fn set_image(&var self, sprite: &SpriteData) -> Result<(), GraphicsError> {
        if !self.is_allocated {
            return Result::Err(GraphicsError::SpriteNotAllocated)
        }

        if self.visible {
            configure_sprite_fetch_width(sprite.width(), self.channel)?
        }

        // Store the new image and height.
        self.sprite_height = sprite.height()
        self.sprite_width = sprite.width()
        self.sprite_data = sprite.as_ptr()

        if !self.visible {
            return Result::Ok(())
        }

        // Wait for VBlank to avoid DMA race condition
        // This ensures sprite data pointers are updated safely
        WaitTOF()

        write_sprite_pointer(self.custom, self.channel, self.sprite_data)
        self.move_to(self.pos_x, self.pos_y)?

        return Result::Ok(())
    }

    // Set colors for this sprite channel
    //
    // IMPORTANT: Sprite pairs share color registers!
    // - Sprites 0 & 1 share colors 17-19 ($DFF1A2-$DFF1A8)
    // - Sprites 2 & 3 share colors 21-23 ($DFF1AA-$DFF1B0)
    // - Sprites 4 & 5 share colors 25-27 ($DFF1B2-$DFF1B8)
    // - Sprites 6 & 7 share colors 29-31 ($DFF1BA-$DFF1C0)
    //
    // Setting colors for sprite 0 will affect sprite 1, and vice versa.
    // Same applies to all other pairs (2+3, 4+5, 6+7).
    /// Sets colors for `SpriteHandle`.
    ///
    /// # Parameters
    /// * `colors` - The `&[Color; 3]` value used as colors.
    ///
    /// # Returns
    /// `Result::Ok(())` on success; the error value explains why the operation could not complete.
    pub fn set_colors(&var self, colors: &[Color; 3]) -> Result<(), GraphicsError> {

        let base_color: i32 = match self.channel {
            0 | 1 => 17,
            2 | 3 => 21,
            4 | 5 => 25,
            6 | 7 => 29,
            _ => return Result::Err(GraphicsError::InvalidSpriteChannel),
        }

        // Write colors to hardware
        // Convert reference to pointer so we can index it
        unsafe {
            let colors_ptr: *Color = (*Color)colors
            for i in 0..3 {
                let color_index_offset = (base_color + i) * 2
                let color_reg_offset = $180 + (u32)color_index_offset
                let color_reg = (*u16)((u32)self.custom + color_reg_offset)
                let (r4, g4, b4) = colors_ptr[i].to_rgb4()

                // Pack into 12-bit Amiga RGB format: 0x0RGB
                let rgb12 = ((u16)r4 << 8) | ((u16)g4 << 4) | (u16)b4
                *color_reg = rgb12
            }
        }

        return Result::Ok(())
    }

    // Check whether this sprite's pair collided with the other sprite's pair.
    // CLXDAT cannot distinguish the two channels within a hardware sprite pair.
    /// Checks collision with for `SpriteHandle`.
    ///
    /// # Parameters
    /// * `other_channel` - The `u8` value used as other channel.
    ///
    /// # Returns
    /// `true` when the stated condition holds; otherwise `false`.
    pub fn check_collision_with(&self, other_channel: u8) -> bool {
        if other_channel > 7 {
            return false
        }

        let bit = sprite_pair_collision_bit(self.channel, other_channel)
        return bit != 0 && (read_sprite_collisions() & bit) != 0
    }

    // Get list of all sprite channels that this sprite has collided with
    // Returns array of channel numbers (0-7) that collided
    // Note: The caller must allocate the array and pass in the size
    /// Computes get collisions for `SpriteHandle` from the supplied inputs.
    ///
    /// # Parameters
    /// * `out_channels` - The `*u8` value used as out channels.
    /// * `max_channels` - The `u32` value used as max channels.
    ///
    /// # Returns
    /// The resulting `u32` value.
    pub fn get_collisions(&self, out_channels: *u8, max_channels: u32) -> u32 {
        let clxdat = read_sprite_collisions()
        var count: u32 = 0

        // Check all possible collision pairs
        for other_channel in 0..8 {
            if other_channel == self.channel {
                continue
            }

            let bit = sprite_pair_collision_bit(self.channel, other_channel)
            let collided = bit != 0 && (clxdat & bit) != 0

            if collided {
                if count < max_channels && out_channels != null {
                    unsafe {
                        out_channels[count] = other_channel
                    }
                }
                count++
            }
        }

        return count
    }

    // Release the sprite channel
    /// Releases the operating-system resource owned by `SpriteHandle`.
    pub fn release(&var self) {
        if self.is_allocated {
            let _ = self.hide()
            unsafe {
                let channel_mask: u8 = 1 << self.channel
                // Clear the bit by XORing if it's set
                if (SPRITE_CHANNELS_ALLOCATED & channel_mask) != 0 {
                    SPRITE_CHANNELS_ALLOCATED = SPRITE_CHANNELS_ALLOCATED ^ channel_mask
                }
            }
            self.is_allocated = false
            self.sprite_data = null

            unsafe {
                if SPRITE_CHANNELS_ALLOCATED == 0 {
                    let dmacon = (*u16)$DFF096
                    *dmacon = $0020
                    DMA_ENABLED = false
                    SPRITE_CHANNELS_VISIBLE = 0
                    WaitTOF()
                    if CHIPSET() == SystemChipset::AGA {
                        let fmode = (*u16)$DFF1FC
                        *fmode = 0
                    }
                    SPRITE_FETCH_WIDTH = 16
                    if BLANK_SPRITE != null {
                        FreeVec((*u8)BLANK_SPRITE)
                        BLANK_SPRITE = null
                    }
                }
            }
        }
    }
}

impl Drop for SpriteHandle {
    fn drop(&var self) {
        self.release()
    }
}

// Attached sprite handle (for 15-color sprites using 2 channels)
/// Owns a attached sprite handle and releases its resources when dropped.
pub struct AttachedSpriteHandle {
    /// The channel value stored by `AttachedSpriteHandle`.
    channel: u8,  // Must be even (0, 2, 4, 6)
    /// The sprite0 value stored by `AttachedSpriteHandle`.
    sprite0: SpriteHandle,
    /// The sprite1 value stored by `AttachedSpriteHandle`.
    sprite1: SpriteHandle,
}

impl AttachedSpriteHandle {
    // Allocate an attached sprite pair
    // channel must be even (0, 2, 4, 6) and will use channel+1 as well
    /// Allocates an attached pair of `AttachedSpriteHandle` values.
    ///
    /// # Parameters
    /// * `channel` - The `u8` value used as channel.
    ///
    /// # Returns
    /// The requested value on success; the error value explains why the operation could not complete.
    pub fn alloc_pair(channel: u8) -> Result<AttachedSpriteHandle, GraphicsError> {
        if channel % 2 != 0 || channel > 6 {
            return Result::Err(GraphicsError::InvalidAttachedSpriteChannel)
        }

        let sprite0 = SpriteHandle::alloc(channel)?
        var sprite1 = SpriteHandle::alloc(channel + 1)?
        sprite1.attached = true

        return Result::Ok(AttachedSpriteHandle {
            channel: channel,
            sprite0: sprite0,
            sprite1: sprite1,
        })
    }

    // Show attached sprite at position
    /// Makes `AttachedSpriteHandle` visible.
    ///
    /// # Parameters
    /// * `sprite` - The `&AttachedSpriteData` value used as sprite.
    /// * `x` - The `i16` value used as x.
    /// * `y` - The `i16` value used as y.
    ///
    /// # Returns
    /// `Result::Ok(())` on success; the error value explains why the operation could not complete.
    pub fn show(&var self, sprite: &AttachedSpriteData, x: i16, y: i16) -> Result<(), GraphicsError> {
        // Show even sprite (planes 0 and 1)
        self.sprite0.show(&sprite.plane01, x, y)?

        // Show odd sprite (planes 2 and 3)
        self.sprite1.show(&sprite.plane23, x, y)?

        return Result::Ok(())
    }

    // Move attached sprite
    /// Moves `AttachedSpriteHandle` to an absolute position.
    ///
    /// # Parameters
    /// * `x` - The `i16` value used as x.
    /// * `y` - The `i16` value used as y.
    ///
    /// # Returns
    /// `Result::Ok(())` on success; the error value explains why the operation could not complete.
    pub fn move_to(&var self, x: i16, y: i16) -> Result<(), GraphicsError> {
        self.sprite0.move_to(x, y)?
        self.sprite1.move_to(x, y)?
        return Result::Ok(())
    }

    // Hide attached sprite
    /// Hides `AttachedSpriteHandle`.
    ///
    /// # Returns
    /// `Result::Ok(())` on success; the error value explains why the operation could not complete.
    pub fn hide(&var self) -> Result<(), GraphicsError> {
        self.sprite0.hide()?
        self.sprite1.hide()?
        return Result::Ok(())
    }

    // Get the two channel numbers used
    /// Returns the channels value associated with `AttachedSpriteHandle`.
    ///
    /// # Returns
    /// The resulting `(u8, u8)` value.
    pub fn channels(&self) -> (u8, u8) {
        return (self.channel, self.channel + 1)
    }

    // Change sprite image (for animation)
    /// Sets image for `AttachedSpriteHandle`.
    ///
    /// # Parameters
    /// * `sprite` - The `&AttachedSpriteData` value used as sprite.
    ///
    /// # Returns
    /// `Result::Ok(())` on success; the error value explains why the operation could not complete.
    pub fn set_image(&var self, sprite: &AttachedSpriteData) -> Result<(), GraphicsError> {
        let width_changed = self.sprite0.sprite_width != sprite.width()
        if width_changed && (self.sprite0.visible || self.sprite1.visible) {
            let (x, y) = self.sprite0.position()
            self.hide()?
            self.sprite0.set_image(&sprite.plane01)?
            self.sprite1.set_image(&sprite.plane23)?
            return self.show(sprite, x, y)
        }
        self.sprite0.set_image(&sprite.plane01)?
        self.sprite1.set_image(&sprite.plane23)?
        return Result::Ok(())
    }

    // Set colors (15 colors + transparent)
    /// Sets colors for `AttachedSpriteHandle`.
    ///
    /// # Parameters
    /// * `colors` - The `&[Color; 15]` value used as colors.
    ///
    /// # Returns
    /// `Result::Ok(())` on success; the error value explains why the operation could not complete.
    pub fn set_colors(&var self, colors: &[Color; 15]) -> Result<(), GraphicsError> {
        // Attached sprites use colors 16-31
        // Convert reference to pointer so we can index it
        unsafe {
            let colors_ptr: *Color = (*Color)colors
            for i in 0..15 {
                let color_index_offset = (17 + i) * 2
                let color_reg_offset = $180 + (u32)color_index_offset
                let color_reg = (*u16)((u32)self.sprite0.custom + color_reg_offset)
                let (r4, g4, b4) = colors_ptr[i].to_rgb4()

                // Pack into 12-bit Amiga RGB format: 0x0RGB
                let rgb12 = ((u16)r4 << 8) | ((u16)g4 << 4) | (u16)b4
                *color_reg = rgb12
            }
        }

        return Result::Ok(())
    }
}

// Attached sprite data (4 bitplanes, 16 colors)
/// Represents a attached sprite data value.
pub struct AttachedSpriteData {
    /// The plane01 value stored by `AttachedSpriteData`.
    plane01: SpriteData,  // Bitplanes 0 and 1
    /// The plane23 value stored by `AttachedSpriteData`.
    plane23: SpriteData,  // Bitplanes 2 and 3
}

impl AttachedSpriteData {
    // Create attached sprite data from two sprite data structures
    // Both must have the same height
    /// Creates `AttachedSpriteData` from sprites.
    ///
    /// # Parameters
    /// * `plane01` - The plane01; ownership transfers to this call.
    /// * `plane23` - The plane23; ownership transfers to this call.
    ///
    /// # Returns
    /// The requested value on success; the error value explains why the operation could not complete.
    ///
    /// # Ownership
    /// Arguments marked `consuming` transfer ownership to this call.
    pub fn from_sprites(consuming plane01: SpriteData, consuming plane23: SpriteData) -> Result<AttachedSpriteData, GraphicsError> {
        if plane01.height() != plane23.height() || plane01.width() != plane23.width() {
            return Result::Err(GraphicsError::InvalidSpriteData)
        }

        return Result::Ok(AttachedSpriteData {
            plane01: plane01,
            plane23: plane23,
        })
    }

    // Create attached sprite data from raw 4-bitplane data
    // Data format: control words, then 4 words per scanline (plane0, plane1, plane2, plane3), then terminator
    /// Wraps a raw representation as `AttachedSpriteData`.
    ///
    /// # Parameters
    /// * `data` - The data used by the operation.
    /// * `len` - The requested len.
    ///
    /// # Returns
    /// The requested value on success; the error value explains why the operation could not complete.
    pub fn from_raw(data: *u16, len: u32) -> Result<AttachedSpriteData, GraphicsError> {
        return AttachedSpriteData::from_raw_width(data, len, 16)
    }

    /// Copies interleaved four-plane sprite words into an attached AGA sprite.
    /// Widths above 16 require AGA and expand each plane block to `width / 16` words.
    ///
    /// # Parameters
    /// * `data` - Control, interleaved pixel, and terminator blocks.
    /// * `len` - Number of 16-bit words in `data`.
    /// * `width` - Sprite fetch width: 16, 32, or 64 pixels.
    ///
    /// # Returns
    /// The deinterleaved attached sprite data, or a layout/chipset error.
    pub fn from_raw_width(data: *u16, len: u32, width: u16) -> Result<AttachedSpriteData, GraphicsError> {
        let fetch_words = fetch_words_for_width(width)
        if fetch_words == 0 {
            return Result::Err(GraphicsError::InvalidSpriteData)
        }
        if width > 16 && CHIPSET() != SystemChipset::AGA {
            return Result::Err(GraphicsError::BadDisplayMode)
        }
        let control_words = fetch_words * 2
        let line_words = fetch_words * 4
        let overhead = control_words * 2
        if data == null || len < overhead + line_words || (len - overhead) % line_words != 0 {
            return Result::Err(GraphicsError::InvalidSpriteData)
        }
        unsafe {
            for i in (len - control_words)..len {
                if data[i] != 0 {
                    return Result::Err(GraphicsError::InvalidSpriteData)
                }
            }
        }

        // Calculate number of scanlines
        let num_lines = (len - overhead) / line_words
        let size_per_plane = (num_lines + 2) * control_words

        // Allocate CHIP RAM for both planes
        let plane01_size = size_per_plane * 2
        let plane23_size = size_per_plane * 2

        let plane01_opt = MemHandle::new_chip(plane01_size)
        let plane23_opt = MemHandle::new_chip(plane23_size)

        match plane01_opt {
            Result::Err(_) => return Result::Err(GraphicsError::BitMapAllocFailed),
            Result::Ok(plane01_chip_mem) => {
                match plane23_opt {
                    Result::Err(_) => return Result::Err(GraphicsError::BitMapAllocFailed),
                    Result::Ok(plane23_chip_mem) => {
                        // Deinterleave the 4-plane data into two 2-plane structures
                        unsafe {
                            let src = data
                            let dest01 = (*u16)plane01_chip_mem.ptr()
                            let dest23 = (*u16)plane23_chip_mem.ptr()

                            // Copy the expanded POS and CTL blocks to both sprites.
                            for i in 0..control_words {
                                dest01[i] = src[i]
                                dest23[i] = src[i]
                            }

                            // Deinterleave scanlines
                            var src_idx = control_words
                            var dest_idx = control_words
                            for i in 0..num_lines {
                                for word in 0..fetch_words {
                                    dest01[dest_idx + word] = src[src_idx + word]
                                    dest01[dest_idx + fetch_words + word] = src[src_idx + fetch_words + word]
                                    dest23[dest_idx + word] = src[src_idx + (fetch_words * 2) + word]
                                    dest23[dest_idx + fetch_words + word] = src[src_idx + (fetch_words * 3) + word]
                                }
                                src_idx = src_idx + line_words
                                dest_idx = dest_idx + control_words
                            }
                            for word in 0..control_words {
                                dest01[dest_idx + word] = src[len - control_words + word]
                                dest23[dest_idx + word] = src[len - control_words + word]
                            }
                        }

                        let plane01_ptr = (*u16)plane01_chip_mem.into_raw()
                        let plane23_ptr = (*u16)plane23_chip_mem.into_raw()

                        let plane01_data = SpriteData {
                            data_ptr: plane01_ptr,
                            owns_memory: true,
                            height: (u16)num_lines,
                            width: width,
                        }

                        let plane23_data = SpriteData {
                            data_ptr: plane23_ptr,
                            owns_memory: true,
                            height: (u16)num_lines,
                            width: width,
                        }

                        return Result::Ok(AttachedSpriteData {
                            plane01: plane01_data,
                            plane23: plane23_data,
                        })
                    }
                }
            }
        }
    }

    // Get sprite height
    /// Returns the height value associated with `AttachedSpriteData`.
    ///
    /// # Returns
    /// The resulting `u16` value.
    pub fn height(&self) -> u16 {
        return self.plane01.height()
    }

    /// Returns the hardware fetch width in pixels.
    ///
    /// # Returns
    /// 16, 32, or 64.
    pub fn width(&self) -> u16 {
        return self.plane01.width()
    }
}

// Read hardware sprite collision register
// Returns bitmask of which sprites collided
/// Reads sprite collisions for the module.
///
/// # Returns
/// The resulting `u16` value.
pub fn read_sprite_collisions() -> u16 {
    let custom = (*u16)$DFF00E  // CLXDAT register
    unsafe {
        return *custom
    }
}

// Clear collision detection latches
// Collisions are cleared by writing to the CLXDAT register
/// Applies clear sprite collisions to the module.
pub fn clear_sprite_collisions() {
    let _ = read_sprite_collisions()
}

// Check if a specific sprite channel is free
/// Returns whether channel free for the module.
///
/// # Parameters
/// * `channel` - The `u8` value used as channel.
///
/// # Returns
/// `true` when the stated condition holds; otherwise `false`.
pub fn is_channel_free(channel: u8) -> bool {
    if channel > 7 {
        return false
    }
    unsafe {
        let channel_mask: u8 = 1 << channel
        return (SPRITE_CHANNELS_ALLOCATED & channel_mask) == 0
    }
}

// Release all allocated sprite channels
// Useful for cleanup or resetting sprite system
/// Releases all sprites for the module.
pub fn release_all_sprites() {
    unsafe {
        SPRITE_CHANNELS_ALLOCATED = 0
        SPRITE_CHANNELS_VISIBLE = 0
        let dmacon = (*u16)$DFF096
        *dmacon = $0020
        DMA_ENABLED = false
        WaitTOF()
        if CHIPSET() == SystemChipset::AGA {
            let fmode = (*u16)$DFF1FC
            *fmode = 0
        }
        SPRITE_FETCH_WIDTH = 16
        if BLANK_SPRITE != null {
            FreeVec((*u8)BLANK_SPRITE)
            BLANK_SPRITE = null
        }
    }
}
