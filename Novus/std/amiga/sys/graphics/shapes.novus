// Geometric primitive types for Amiga graphics
// Module: amiga::sys::graphics::shapes
//
// Provides Point, Rect, and Circle types for use with drawing APIs.
// All coordinates use i16 to match AmigaOS graphics functions.

from std::core import Option

// ============================================================================
// Point - 2D coordinate
// ============================================================================

/// A 2D point with x and y coordinates.
/// Uses i16 to match AmigaOS graphics functions.
pub struct Point {
    /// The x value stored by `Point`.
    x: i16,
    /// The y value stored by `Point`.
    y: i16,
}

impl Point {
    /// Create a new point at the given coordinates.
    pub fn new(x: i16, y: i16) -> Point {
        return Point { x: x, y: y }
    }

    /// Create a point at the origin (0, 0).
    pub fn zero() -> Point {
        return Point { x: 0, y: 0 }
    }

    /// Create a new point offset from this one.
    pub fn offset(&self, dx: i16, dy: i16) -> Point {
        return Point { x: self.x + dx, y: self.y + dy }
    }

    /// Add another point to this one (vector addition).
    pub fn add(&self, other: &Point) -> Point {
        return Point { x: self.x + other.x, y: self.y + other.y }
    }

    /// Subtract another point from this one (vector subtraction).
    pub fn sub(&self, other: &Point) -> Point {
        return Point { x: self.x - other.x, y: self.y - other.y }
    }

    /// Check if this point equals another.
    pub fn equals(&self, other: &Point) -> bool {
        return self.x == other.x && self.y == other.y
    }
}

// ============================================================================
// Rect - Axis-aligned rectangle
// ============================================================================

/// An axis-aligned rectangle defined by min and max corners.
/// Uses the same convention as AmigaOS Rectangle struct:
/// (x_min, y_min) is top-left, (x_max, y_max) is bottom-right (inclusive).
pub struct Rect {
    /// The x min value stored by `Rect`.
    x_min: i16,
    /// The y min value stored by `Rect`.
    y_min: i16,
    /// The x max value stored by `Rect`.
    x_max: i16,
    /// The y max value stored by `Rect`.
    y_max: i16,
}

impl Rect {
    /// Create a rectangle from min/max coordinates.
    /// x_max and y_max are inclusive (the pixel at x_max, y_max is part of the rect).
    pub fn new(x_min: i16, y_min: i16, x_max: i16, y_max: i16) -> Rect {
        return Rect {
            x_min: x_min,
            y_min: y_min,
            x_max: x_max,
            y_max: y_max
        }
    }

    /// Create a rectangle from position and size.
    /// Width and height are in pixels; the resulting x_max = x + width - 1.
    pub fn from_pos_size(x: i16, y: i16, width: i16, height: i16) -> Rect {
        return Rect {
            x_min: x,
            y_min: y,
            x_max: x + width - 1,
            y_max: y + height - 1
        }
    }

    /// Create a rectangle from two corner points.
    pub fn from_points(top_left: &Point, bottom_right: &Point) -> Rect {
        return Rect {
            x_min: top_left.x,
            y_min: top_left.y,
            x_max: bottom_right.x,
            y_max: bottom_right.y
        }
    }

    /// Create a zero-sized rectangle at the origin.
    pub fn zero() -> Rect {
        return Rect { x_min: 0, y_min: 0, x_max: 0, y_max: 0 }
    }

    /// Get the width in pixels (inclusive, so max - min + 1).
    pub fn width(&self) -> i16 {
        return self.x_max - self.x_min + 1
    }

    /// Get the height in pixels (inclusive, so max - min + 1).
    pub fn height(&self) -> i16 {
        return self.y_max - self.y_min + 1
    }

    /// Get the top-left corner as a Point.
    pub fn top_left(&self) -> Point {
        return Point { x: self.x_min, y: self.y_min }
    }

    /// Get the bottom-right corner as a Point.
    pub fn bottom_right(&self) -> Point {
        return Point { x: self.x_max, y: self.y_max }
    }

    /// Get the center point (integer division, may lose precision).
    pub fn center(&self) -> Point {
        return Point {
            x: (self.x_min + self.x_max) / 2,
            y: (self.y_min + self.y_max) / 2
        }
    }

    /// Check if a point is inside this rectangle (inclusive bounds).
    pub fn contains(&self, p: &Point) -> bool {
        if p.x < self.x_min || p.x > self.x_max {
            return false
        }
        if p.y < self.y_min || p.y > self.y_max {
            return false
        }
        return true
    }

    /// Check if a coordinate is inside this rectangle.
    pub fn contains_xy(&self, x: i16, y: i16) -> bool {
        if x < self.x_min || x > self.x_max {
            return false
        }
        if y < self.y_min || y > self.y_max {
            return false
        }
        return true
    }

    /// Check if this rectangle intersects another.
    pub fn intersects(&self, other: &Rect) -> bool {
        if self.x_min > other.x_max || self.x_max < other.x_min {
            return false
        }
        if self.y_min > other.y_max || self.y_max < other.y_min {
            return false
        }
        return true
    }

    /// Get the intersection of two rectangles, if any.
    pub fn intersection(&self, other: &Rect) -> Option<Rect> {
        if !self.intersects(other) {
            return Option::None
        }

        var x_min: i16 = self.x_min
        if other.x_min > x_min {
            x_min = other.x_min
        }

        var y_min: i16 = self.y_min
        if other.y_min > y_min {
            y_min = other.y_min
        }

        var x_max: i16 = self.x_max
        if other.x_max < x_max {
            x_max = other.x_max
        }

        var y_max: i16 = self.y_max
        if other.y_max < y_max {
            y_max = other.y_max
        }

        return Option::Some(Rect {
            x_min: x_min,
            y_min: y_min,
            x_max: x_max,
            y_max: y_max
        })
    }

    /// Get a rectangle offset by the given amount.
    pub fn offset(&self, dx: i16, dy: i16) -> Rect {
        return Rect {
            x_min: self.x_min + dx,
            y_min: self.y_min + dy,
            x_max: self.x_max + dx,
            y_max: self.y_max + dy
        }
    }

    /// Expand the rectangle by the given amount on all sides.
    pub fn expand(&self, amount: i16) -> Rect {
        return Rect {
            x_min: self.x_min - amount,
            y_min: self.y_min - amount,
            x_max: self.x_max + amount,
            y_max: self.y_max + amount
        }
    }

    /// Shrink the rectangle by the given amount on all sides.
    pub fn shrink(&self, amount: i16) -> Rect {
        return Rect {
            x_min: self.x_min + amount,
            y_min: self.y_min + amount,
            x_max: self.x_max - amount,
            y_max: self.y_max - amount
        }
    }

    /// Check if this rectangle is empty (zero or negative area).
    pub fn is_empty(&self) -> bool {
        return self.x_max < self.x_min || self.y_max < self.y_min
    }

    /// Check if this rectangle equals another.
    pub fn equals(&self, other: &Rect) -> bool {
        if self.x_min != other.x_min || self.y_min != other.y_min {
            return false
        }
        if self.x_max != other.x_max || self.y_max != other.y_max {
            return false
        }
        return true
    }
}

// ============================================================================
// Circle/Ellipse - Elliptical shape
// ============================================================================

/// An ellipse (or circle) defined by center and radii.
/// When radius_x == radius_y, this represents a circle.
/// Radii are in pixels and must be >= 0.
pub struct Ellipse {
    /// The center value stored by `Ellipse`.
    center: Point,
    /// The radius x value stored by `Ellipse`.
    radius_x: i16,
    /// The radius y value stored by `Ellipse`.
    radius_y: i16,
}

impl Ellipse {
    /// Create an ellipse with center and separate x/y radii.
    pub fn new(center_x: i16, center_y: i16, radius_x: i16, radius_y: i16) -> Ellipse {
        return Ellipse {
            center: Point { x: center_x, y: center_y },
            radius_x: radius_x,
            radius_y: radius_y
        }
    }

    /// Create an ellipse from a center point and radii.
    pub fn from_center(center: Point, radius_x: i16, radius_y: i16) -> Ellipse {
        return Ellipse {
            center: center,
            radius_x: radius_x,
            radius_y: radius_y
        }
    }

    /// Create a circle (equal x and y radii).
    pub fn circle(center_x: i16, center_y: i16, radius: i16) -> Ellipse {
        return Ellipse {
            center: Point { x: center_x, y: center_y },
            radius_x: radius,
            radius_y: radius
        }
    }

    /// Create a circle from a center point and radius.
    pub fn circle_from_center(center: Point, radius: i16) -> Ellipse {
        return Ellipse {
            center: center,
            radius_x: radius,
            radius_y: radius
        }
    }

    /// Check if this is a circle (radius_x == radius_y).
    pub fn is_circle(&self) -> bool {
        return self.radius_x == self.radius_y
    }

    /// Get the bounding rectangle of this ellipse.
    pub fn bounds(&self) -> Rect {
        return Rect {
            x_min: self.center.x - self.radius_x,
            y_min: self.center.y - self.radius_y,
            x_max: self.center.x + self.radius_x,
            y_max: self.center.y + self.radius_y
        }
    }

    /// Get the diameter in the X direction.
    pub fn diameter_x(&self) -> i16 {
        return self.radius_x * 2
    }

    /// Get the diameter in the Y direction.
    pub fn diameter_y(&self) -> i16 {
        return self.radius_y * 2
    }

    /// Create an ellipse offset by the given amount.
    pub fn offset(&self, dx: i16, dy: i16) -> Ellipse {
        return Ellipse {
            center: self.center.offset(dx, dy),
            radius_x: self.radius_x,
            radius_y: self.radius_y
        }
    }

    /// Scale the ellipse by a factor (integer scaling).
    pub fn scale(&self, factor: i16) -> Ellipse {
        return Ellipse {
            center: self.center,
            radius_x: self.radius_x * factor,
            radius_y: self.radius_y * factor
        }
    }
}

// Note: Use Ellipse for circles - the is_circle() method checks if radius_x == radius_y
// Circle constructors are provided: Ellipse::circle() and Ellipse::circle_from_center()

// ============================================================================
// Size - Width and height pair
// ============================================================================

/// A size (width, height) pair.
/// Useful for representing dimensions separately from position.
pub struct Size {
    /// The width value stored by `Size`.
    width: i16,
    /// The height value stored by `Size`.
    height: i16,
}

impl Size {
    /// Create a new size.
    pub fn new(width: i16, height: i16) -> Size {
        return Size { width: width, height: height }
    }

    /// Create a zero size (0, 0).
    pub fn zero() -> Size {
        return Size { width: 0, height: 0 }
    }

    /// Create a square size (same width and height).
    pub fn square(side: i16) -> Size {
        return Size { width: side, height: side }
    }

    /// Check if this size is empty (zero or negative area).
    pub fn is_empty(&self) -> bool {
        return self.width <= 0 || self.height <= 0
    }

    /// Calculate the area.
    pub fn area(&self) -> i32 {
        return (i32)self.width * (i32)self.height
    }

    /// Check if this size equals another.
    pub fn equals(&self, other: &Size) -> bool {
        return self.width == other.width && self.height == other.height
    }
}
