from std::core import Error
from amiga::raw::dos import IoErr

/// Reports failures from dos operations.
pub enum DosError {
    /// Indicates that the requested item was not found.
    NotFound,
    /// Indicates already exists.
    AlreadyExists,
    /// Indicates dir not found.
    DirNotFound,
    /// Indicates directory not empty.
    DirectoryNotEmpty,
    /// Indicates permission denied.
    PermissionDenied,
    /// Indicates write protected.
    WriteProtected,
    /// Indicates read protected.
    ReadProtected,
    /// Indicates delete protected.
    DeleteProtected,
    /// Indicates disk full.
    DiskFull,
    /// Indicates disk not validated.
    DiskNotValidated,
    /// Indicates disk write protected.
    DiskWriteProtected,
    /// Indicates no disk.
    NoDisk,
    /// Indicates not ados disk.
    NotADosDisk,
    /// Indicates device not mounted.
    DeviceNotMounted,
    /// Indicates seek error.
    SeekError,
    /// Indicates buffer overflow.
    BufferOverflow,
    /// Indicates bad stream name.
    BadStreamName,
    /// Indicates no free store.
    NoFreeStore,
    /// Indicates object in use.
    ObjectInUse,
    /// Indicates object too large.
    ObjectTooLarge,
    /// Indicates too many levels.
    TooManyLevels,
    /// Indicates invalid lock.
    InvalidLock,
    /// Indicates record not locked.
    RecordNotLocked,
    /// Indicates lock collision.
    LockCollision,
    /// Indicates lock timeout.
    LockTimeout,
    /// Indicates not implemented.
    NotImplemented,
    /// Indicates bad number.
    BadNumber,
    /// Indicates invalid input.
    InvalidInput,
    /// Indicates unknown.
    Unknown,
}

/// Returns the dos last error value associated with the module.
///
/// # Returns
/// The resulting `DosError` value.
pub fn dos_last_error() -> DosError { return dos_error_from_code(IoErr()) }

/// Computes dos error from code for the module from the supplied inputs.
///
/// # Parameters
/// * `code` - The `i32` value used as code.
///
/// # Returns
/// The resulting `DosError` value.
pub fn dos_error_from_code(code: i32) -> DosError {
    return match code {
        103 => DosError::NoFreeStore,
        115 => DosError::BadNumber,
        202 => DosError::ObjectInUse,
        203 => DosError::AlreadyExists,
        204 => DosError::DirNotFound,
        205 => DosError::NotFound,
        206 => DosError::BadStreamName,
        207 => DosError::ObjectTooLarge,
        211 => DosError::InvalidLock,
        213 => DosError::DiskNotValidated,
        214 => DosError::DiskWriteProtected,
        216 => DosError::DirectoryNotEmpty,
        217 => DosError::TooManyLevels,
        218 => DosError::DeviceNotMounted,
        219 => DosError::SeekError,
        221 => DosError::DiskFull,
        222 => DosError::DeleteProtected,
        223 => DosError::WriteProtected,
        224 => DosError::ReadProtected,
        225 => DosError::NotADosDisk,
        226 => DosError::NoDisk,
        236 => DosError::NotImplemented,
        240 => DosError::RecordNotLocked,
        241 => DosError::LockCollision,
        242 => DosError::LockTimeout,
        303 => DosError::BufferOverflow,
        _ => DosError::Unknown,
    }
}

/// Computes dos error to code for the module from the supplied inputs.
///
/// # Parameters
/// * `error` - The `DosError` value used as error.
///
/// # Returns
/// The resulting `i32` value.
pub fn dos_error_to_code(error: DosError) -> i32 {
    return match error {
        DosError::NotFound => 205,
        DosError::AlreadyExists => 203,
        DosError::DirNotFound => 204,
        DosError::DirectoryNotEmpty => 216,
        DosError::PermissionDenied => -1,
        DosError::WriteProtected => 223,
        DosError::ReadProtected => 224,
        DosError::DeleteProtected => 222,
        DosError::DiskFull => 221,
        DosError::DiskNotValidated => 213,
        DosError::DiskWriteProtected => 214,
        DosError::NoDisk => 226,
        DosError::NotADosDisk => 225,
        DosError::DeviceNotMounted => 218,
        DosError::SeekError => 219,
        DosError::BufferOverflow => 303,
        DosError::BadStreamName => 206,
        DosError::NoFreeStore => 103,
        DosError::ObjectInUse => 202,
        DosError::ObjectTooLarge => 207,
        DosError::TooManyLevels => 217,
        DosError::InvalidLock => 211,
        DosError::RecordNotLocked => 240,
        DosError::LockCollision => 241,
        DosError::LockTimeout => 242,
        DosError::NotImplemented => 236,
        DosError::BadNumber => 115,
        DosError::InvalidInput => -2,
        DosError::Unknown => -999,
    }
}

impl DosError {
    /// Returns a human-readable description of this error.
    ///
    /// # Returns
    /// The resulting `*u8` value.
    pub fn message(&self) -> *u8 {
        return match *self {
            DosError::NotFound => "Object not found",
            DosError::AlreadyExists => "Object already exists",
            DosError::DirNotFound => "Directory not found",
            DosError::DirectoryNotEmpty => "Directory not empty",
            DosError::PermissionDenied => "Permission denied",
            DosError::WriteProtected => "Write protected",
            DosError::ReadProtected => "Read protected",
            DosError::DeleteProtected => "Delete protected",
            DosError::DiskFull => "Disk full",
            DosError::DiskNotValidated => "Disk not validated",
            DosError::DiskWriteProtected => "Disk write protected",
            DosError::NoDisk => "No disk in drive",
            DosError::NotADosDisk => "Not a DOS disk",
            DosError::DeviceNotMounted => "Device not mounted",
            DosError::SeekError => "Seek error",
            DosError::BufferOverflow => "Buffer overflow",
            DosError::BadStreamName => "Bad stream name",
            DosError::NoFreeStore => "Out of memory",
            DosError::ObjectInUse => "Object in use",
            DosError::ObjectTooLarge => "Object too large",
            DosError::TooManyLevels => "Too many directory levels",
            DosError::InvalidLock => "Invalid lock",
            DosError::RecordNotLocked => "Record not locked",
            DosError::LockCollision => "Lock collision",
            DosError::LockTimeout => "Lock timeout",
            DosError::NotImplemented => "Not implemented",
            DosError::BadNumber => "Bad number",
            DosError::InvalidInput => "Invalid input",
            DosError::Unknown => "Unknown error",
        }
    }
}

impl Error for DosError {
    fn message(&self) -> *u8 { return DosError::message(self) }
}
