// Safe, read-only traversal of AmigaDOS device entries.

from std::core import Drop, Error, Iterator, Option, Result
from std::string import CStr, Str
from amiga::sys::dos::bptr import BPtr, BPtrError
from amiga::raw::consts import LDF_DEVICES, LDF_READ
from amiga::raw::structs import DeviceNode, DevProc, DosEnvec, DosList, FileSysStartupMsg
from amiga::raw::dos import FreeDeviceProc, GetDeviceProc, LockDosList, NextDosEntry, UnLockDosList
from amiga::raw::exec import TypeOfMem

/// Reports failures from dos list operations.
pub enum DosListError {
    /// Indicates lock failed.
    LockFailed,
    /// Indicates resolve failed.
    ResolveFailed,
}

impl DosListError {
    /// Returns a human-readable description of this error.
    ///
    /// # Returns
    /// The resulting `*u8` value.
    pub fn message(&self) -> *u8 {
        return match self {
            DosListError::LockFailed => "Could not lock the AmigaDOS device list",
            DosListError::ResolveFailed => "Could not resolve the AmigaDOS device process",
        }
    }
}

impl Error for DosListError {
    fn message(&self) -> *u8 {
        return DosListError::message(self)
    }
}

/// Owns a read lock on the DOS device list.
pub struct DosDeviceList {
    /// The head value stored by `DosDeviceList`.
    head: *DosList,
    /// The flags value stored by `DosDeviceList`.
    flags: u32,
}

impl DosDeviceList {
    /// Returns the lock value associated with `DosDeviceList`.
    ///
    /// # Returns
    /// The requested value on success; the error value explains why the operation could not complete.
    pub fn lock() -> Result<DosDeviceList, DosListError> {
        let flags = LDF_DEVICES | LDF_READ
        let head = LockDosList(flags)
        if head == null {
            return Result::Err(DosListError::LockFailed)
        }
        return Result::Ok(DosDeviceList { head: head, flags: flags })
    }

    /// Returns an iterator over the items in `DosDeviceList`.
    ///
    /// # Returns
    /// The resulting `DosDeviceIter` value.
    pub fn iter(&self) -> DosDeviceIter {
        return DosDeviceIter { owner: self, cursor: self.head, visited: 0 }
    }
}

impl Drop for DosDeviceList {
    fn drop(&var self) {
        if self.head != null {
            UnLockDosList(self.flags)
            self.head = null
        }
    }
}

/// Iterates over dos device values.
pub struct DosDeviceIter {
    /// The owner value stored by `DosDeviceIter`.
    owner: &DosDeviceList,
    /// The cursor value stored by `DosDeviceIter`.
    cursor: *DosList,
    /// The visited value stored by `DosDeviceIter`.
    visited: u32,
}

/// Represents a dos device entry value.
pub struct DosDeviceEntry {
    /// The owner value stored by `DosDeviceEntry`.
    owner: &DosDeviceList,
    /// The entry value stored by `DosDeviceEntry`.
    entry: &DosList,
}

impl DosDeviceIter {
    /// Advances `DosDeviceIter` and returns the next item, when one remains.
    ///
    /// # Returns
    /// The requested value, or `Option::None` when it is unavailable.
    pub fn next(&var self) -> Option<DosDeviceEntry> {
        // A corrupt list must not trap callers in an infinite traversal.
        if self.visited >= 256 { return Option::None }
        let next = NextDosEntry(self.cursor, LDF_DEVICES)
        if next == null {
            return Option::None
        }
        self.cursor = next
        self.visited++
        return Option::Some(DosDeviceEntry {
            owner: self.owner,
            entry: unsafe { &*next },
        })
    }
}

impl Iterator<DosDeviceEntry> for DosDeviceIter {
    fn next(&var self) -> Option<DosDeviceEntry> {
        return DosDeviceIter::next(self)
    }
}

impl DosDeviceEntry {
    /// Returns whether handled by for `DosDeviceEntry`.
    ///
    /// # Parameters
    /// * `process` - The `&DeviceProcess` value used as process.
    ///
    /// # Returns
    /// `true` when the stated condition holds; otherwise `false`.
    pub fn is_handled_by(&self, process: &DeviceProcess) -> bool {
        return self.entry.dol_Task != null && self.entry.dol_Task == process.process.dvp_Port
    }

    /// Returns the name value associated with `DosDeviceEntry`.
    ///
    /// # Returns
    /// The requested value, or `Option::None` when it is unavailable.
    pub fn name(&self) -> Option<Str> {
        let bptr = match BPtr::<u8>::from_raw(self.entry.dol_Name) {
            Result::Ok(value) => value,
            Result::Err(_) => return Option::None,
        }
        if !bptr.is_addressable() {
            return Option::None
        }
        let ptr = unsafe { bptr.as_ptr() }
        let len = (u32)unsafe { ptr[0] }
        if len > 0 && TypeOfMem(ptr + len) == 0 {
            return Option::None
        }
        return Option::Some(unsafe { Str::new(&ptr[1], len) })
    }

    /// Starts up for `DosDeviceEntry`.
    ///
    /// # Returns
    /// The requested value, or `Option::None` when it is unavailable.
    pub fn startup(&self) -> Option<FileSystemStartup> {
        // A DLT_DEVICE DosList entry has the public DeviceNode layout.
        let node = unsafe { &*((*DeviceNode)self.entry) }
        let bptr = match BPtr::<FileSysStartupMsg>::from_raw(node.dn_Startup) {
            Result::Ok(value) => value,
            Result::Err(_) => return Option::None,
        }
        match unsafe { bptr.borrow() } {
            Option::Some(message) => return Option::Some(FileSystemStartup {
                owner: self.owner,
                message: message,
            }),
            Option::None => return Option::None,
        }
    }

    /// Explicit lower-layer escape hatch; the DOS-list lock remains the owner.
    pub fn as_raw(&self) -> &DeviceNode {
        return unsafe { &*((*DeviceNode)self.entry) }
    }
}

/// Owns the temporary DOS resources returned by GetDeviceProc().
pub struct DeviceProcess {
    /// The process value stored by `DeviceProcess`.
    process: *DevProc,
}

impl DeviceProcess {
    /// Resolves `DeviceProcess` to its underlying operating-system object.
    ///
    /// # Parameters
    /// * `name` - The name to use.
    ///
    /// # Returns
    /// The requested value on success; the error value explains why the operation could not complete.
    pub fn resolve(name: CStr) -> Result<DeviceProcess, DosListError> {
        let process = GetDeviceProc(name.as_ptr(), null)
        if process == null {
            return Result::Err(DosListError::ResolveFailed)
        }
        return Result::Ok(DeviceProcess { process: process })
    }

    /// Borrow the resolved handler port for lower-level packet operations.
    pub fn port(&self) -> *MsgPort { return unsafe { (*self.process).dvp_Port } }
}

impl Drop for DeviceProcess {
    fn drop(&var self) {
        if self.process != null {
            let process = self.process
            self.process = null
            FreeDeviceProc(process)
        }
    }
}

/// Borrowed, typed view of a DOS FileSysStartupMsg.
pub struct FileSystemStartup {
    /// The owner value stored by `FileSystemStartup`.
    owner: &DosDeviceList,
    /// The message value stored by `FileSystemStartup`.
    message: &FileSysStartupMsg,
}

impl FileSystemStartup {
    /// Returns the unit value associated with `FileSystemStartup`.
    ///
    /// # Returns
    /// The resulting `u32` value.
    pub fn unit(&self) -> u32 {
        return self.message.fssm_Unit
    }

    /// Returns the flags value associated with `FileSystemStartup`.
    ///
    /// # Returns
    /// The resulting `u32` value.
    pub fn flags(&self) -> u32 {
        return self.message.fssm_Flags
    }

    /// Returns the device name value associated with `FileSystemStartup`.
    ///
    /// # Returns
    /// The requested value, or `Option::None` when it is unavailable.
    pub fn device_name(&self) -> Option<Str> {
        let bptr = match BPtr::<u8>::from_raw(self.message.fssm_Device) {
            Result::Ok(value) => value,
            Result::Err(_) => return Option::None,
        }
        if !bptr.is_addressable() {
            return Option::None
        }
        let ptr = unsafe { bptr.as_ptr() }
        let len = (u32)unsafe { ptr[0] }
        if len > 0 && TypeOfMem(ptr + len) == 0 {
            return Option::None
        }
        return Option::Some(unsafe { Str::new(&ptr[1], len) })
    }

    /// Returns the environment value associated with `FileSystemStartup`.
    ///
    /// # Returns
    /// The requested value, or `Option::None` when it is unavailable.
    pub fn environment(&self) -> Option<&DosEnvec> {
        let bptr = match BPtr::<DosEnvec>::from_raw(self.message.fssm_Environ) {
            Result::Ok(value) => value,
            Result::Err(_) => return Option::None,
        }
        return unsafe { bptr.borrow() }
    }
}
