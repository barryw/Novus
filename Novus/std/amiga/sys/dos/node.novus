// Owned construction and explicit OS transfer for AmigaDOS device nodes.

from std::core import Error, Result
from amiga::raw::consts import ADNF_STARTPROC, MEMF_CLEAR, MEMF_PUBLIC
from amiga::raw::structs import DeviceNode, DosEnvec, FileSysStartupMsg
from amiga::raw::expansion import AddDosNode
from std::memory import MemoryBlock
from amiga::sys::dos::bptr import BPtr
from amiga::sys::dos::filesystem import FileSystemHandler
from amiga::sys::dos::segment import LoadedSegment
from std::string import BStr, Str

/// Reports failures from dos node operations.
pub enum DosNodeError {
    /// Indicates invalid name.
    InvalidName,
    /// Indicates invalid environment.
    InvalidEnvironment,
    /// Indicates allocation failed.
    AllocationFailed,
    /// Indicates missing handler.
    MissingHandler,
    /// Indicates invalid handler.
    InvalidHandler,
    /// Indicates registration failed.
    RegistrationFailed,
}

impl DosNodeError {
    /// Returns a human-readable description of this error.
    ///
    /// # Returns
    /// The resulting `*u8` value.
    pub fn message(&self) -> *u8 {
        return match self {
            DosNodeError::InvalidName => "Invalid DOS node name",
            DosNodeError::InvalidEnvironment => "Invalid DOS environment",
            DosNodeError::AllocationFailed => "DOS node allocation failed",
            DosNodeError::MissingHandler => "DOS node has no filesystem handler",
            DosNodeError::InvalidHandler => "Invalid filesystem handler",
            DosNodeError::RegistrationFailed => "DOS node registration failed",
        }
    }
}

impl Error for DosNodeError {
    fn message(&self) -> *u8 { return DosNodeError::message(self) }
}

/// Typed form of the standard 17-longword partition environment.
pub struct DosEnvironment {
    /// The block bytes value stored by `DosEnvironment`.
    block_bytes: u32
    /// The surfaces value stored by `DosEnvironment`.
    surfaces: u32
    /// The blocks per track value stored by `DosEnvironment`.
    blocks_per_track: u32
    /// The reserved blocks value stored by `DosEnvironment`.
    reserved_blocks: u32
    /// The low cylinder value stored by `DosEnvironment`.
    low_cylinder: u32
    /// The high cylinder value stored by `DosEnvironment`.
    high_cylinder: u32
    /// The buffers value stored by `DosEnvironment`.
    buffers: u32
    /// The buffer memory value stored by `DosEnvironment`.
    buffer_memory: u32
    /// The max transfer value stored by `DosEnvironment`.
    max_transfer: u32
    /// The mask value stored by `DosEnvironment`.
    mask: u32
    /// The boot priority value stored by `DosEnvironment`.
    boot_priority: i32
    /// The dos type value stored by `DosEnvironment`.
    dos_type: u32
}

impl DosEnvironment {
    /// Computes partition for `DosEnvironment` from the supplied inputs.
    ///
    /// # Parameters
    /// * `block_bytes` - The `u32` value used as block bytes.
    /// * `surfaces` - The `u32` value used as surfaces.
    /// * `blocks_per_track` - The `u32` value used as blocks per track.
    /// * `low_cylinder` - The `u32` value used as low cylinder.
    /// * `high_cylinder` - The `u32` value used as high cylinder.
    /// * `dos_type` - The `u32` value used as dos type.
    ///
    /// # Returns
    /// The requested value on success; the error value explains why the operation could not complete.
    pub fn partition(
        block_bytes: u32,
        surfaces: u32,
        blocks_per_track: u32,
        low_cylinder: u32,
        high_cylinder: u32,
        dos_type: u32
    ) -> Result<DosEnvironment, DosNodeError> {
        if block_bytes == 0 || block_bytes % 4 != 0 {
            return Result::Err(DosNodeError::InvalidEnvironment)
        }
        if surfaces == 0 || blocks_per_track == 0 || low_cylinder > high_cylinder {
            return Result::Err(DosNodeError::InvalidEnvironment)
        }
        return Result::Ok(DosEnvironment {
            block_bytes: block_bytes,
            surfaces: surfaces,
            blocks_per_track: blocks_per_track,
            reserved_blocks: 2,
            low_cylinder: low_cylinder,
            high_cylinder: high_cylinder,
            buffers: 30,
            buffer_memory: 0,
            max_transfer: $7FFFFFFF,
            mask: $FFFFFFFE,
            boot_priority: 0,
            dos_type: dos_type,
        })
    }

    /// Sets buffers for `DosEnvironment`.
    ///
    /// # Parameters
    /// * `count` - The requested count.
    /// * `memory_type` - The `u32` value used as memory type.
    ///
    /// # Returns
    /// `Result::Ok(())` on success; the error value explains why the operation could not complete.
    pub fn set_buffers(&var self, count: u32, memory_type: u32) -> Result<(), DosNodeError> {
        if count == 0 { return Result::Err(DosNodeError::InvalidEnvironment) }
        self.buffers = count
        self.buffer_memory = memory_type
        return Result::Ok(())
    }

    /// Sets transfer for `DosEnvironment`.
    ///
    /// # Parameters
    /// * `maximum` - The `u32` value used as maximum.
    /// * `mask` - The `u32` value used as mask.
    ///
    /// # Returns
    /// `Result::Ok(())` on success; the error value explains why the operation could not complete.
    pub fn set_transfer(&var self, maximum: u32, mask: u32) -> Result<(), DosNodeError> {
        if maximum == 0 || mask == 0 {
            return Result::Err(DosNodeError::InvalidEnvironment)
        }
        self.max_transfer = maximum
        self.mask = mask
        return Result::Ok(())
    }

    /// Sets reserved blocks for `DosEnvironment`.
    ///
    /// # Parameters
    /// * `count` - The requested count.
    pub fn set_reserved_blocks(&var self, count: u32) { self.reserved_blocks = count }
    /// Sets boot priority for `DosEnvironment`.
    ///
    /// # Parameters
    /// * `priority` - The priority value.
    pub fn set_boot_priority(&var self, priority: i32) { self.boot_priority = priority }

    /// Returns the block bytes value associated with `DosEnvironment`.
    ///
    /// # Returns
    /// The resulting `u32` value.
    pub fn block_bytes(&self) -> u32 { return self.block_bytes }
    /// Returns the surfaces value associated with `DosEnvironment`.
    ///
    /// # Returns
    /// The resulting `u32` value.
    pub fn surfaces(&self) -> u32 { return self.surfaces }
    /// Returns the blocks per track value associated with `DosEnvironment`.
    ///
    /// # Returns
    /// The resulting `u32` value.
    pub fn blocks_per_track(&self) -> u32 { return self.blocks_per_track }
    /// Returns the low cylinder value associated with `DosEnvironment`.
    ///
    /// # Returns
    /// The resulting `u32` value.
    pub fn low_cylinder(&self) -> u32 { return self.low_cylinder }
    /// Returns the high cylinder value associated with `DosEnvironment`.
    ///
    /// # Returns
    /// The resulting `u32` value.
    pub fn high_cylinder(&self) -> u32 { return self.high_cylinder }
    /// Returns the dos type value associated with `DosEnvironment`.
    ///
    /// # Returns
    /// The resulting `u32` value.
    pub fn dos_type(&self) -> u32 { return self.dos_type }
    /// Returns the buffers value associated with `DosEnvironment`.
    ///
    /// # Returns
    /// The resulting `u32` value.
    pub fn buffers(&self) -> u32 { return self.buffers }
    /// Returns the max transfer value associated with `DosEnvironment`.
    ///
    /// # Returns
    /// The resulting `u32` value.
    pub fn max_transfer(&self) -> u32 { return self.max_transfer }
    /// Returns the mask value associated with `DosEnvironment`.
    ///
    /// # Returns
    /// The resulting `u32` value.
    pub fn mask(&self) -> u32 { return self.mask }
    /// Returns the boot priority value associated with `DosEnvironment`.
    ///
    /// # Returns
    /// The resulting `i32` value.
    pub fn boot_priority(&self) -> i32 { return self.boot_priority }

    @unsafe
    fn write_to(&self, target: *DosEnvec) {
        (*target).de_TableSize = 16
        (*target).de_SizeBlock = self.block_bytes / 4
        (*target).de_SecOrg = 0
        (*target).de_Surfaces = self.surfaces
        (*target).de_SectorPerBlock = 1
        (*target).de_BlocksPerTrack = self.blocks_per_track
        (*target).de_Reserved = self.reserved_blocks
        (*target).de_PreAlloc = 0
        (*target).de_Interleave = 0
        (*target).de_LowCyl = self.low_cylinder
        (*target).de_HighCyl = self.high_cylinder
        (*target).de_NumBuffers = self.buffers
        (*target).de_BufMemType = self.buffer_memory
        (*target).de_MaxTransfer = self.max_transfer
        (*target).de_Mask = self.mask
        (*target).de_BootPri = self.boot_priority
        (*target).de_DosType = self.dos_type
    }
}

/// Owns every allocation referenced by a DeviceNode until registration succeeds.
pub struct DosNodeDraft {
    /// The storage value stored by `DosNodeDraft`.
    storage: MemoryBlock
    /// The name value stored by `DosNodeDraft`.
    name: BStr
    /// The driver value stored by `DosNodeDraft`.
    driver: BStr
}

impl DosNodeDraft {
    @suppress("W0002", "Validated aligned allocations are encoded as Amiga BPTRs")
    /// Creates a new `DosNodeDraft` value.
    ///
    /// # Parameters
    /// * `name` - The name to use.
    /// * `driver` - The `Str` value used as driver.
    /// * `unit` - The unit value.
    /// * `open_flags` - The `u32` value used as open flags.
    /// * `environment` - The `&DosEnvironment` value used as environment.
    ///
    /// # Returns
    /// The requested value on success; the error value explains why the operation could not complete.
    pub fn new(
        name: Str,
        driver: Str,
        unit: u32,
        open_flags: u32,
        environment: &DosEnvironment
    ) -> Result<DosNodeDraft, DosNodeError> {
        if !valid_component(name) || !valid_component(driver) {
            return Result::Err(DosNodeError::InvalidName)
        }
        let owned_name = match BStr::new_from_str(name) {
            Result::Ok(value) => value,
            Result::Err(_) => return Result::Err(DosNodeError::AllocationFailed),
        }
        let owned_driver = match BStr::new_from_str(driver) {
            Result::Ok(value) => value,
            Result::Err(_) => return Result::Err(DosNodeError::AllocationFailed),
        }
        let storage_size = @sizeof(DeviceNode) + @sizeof(FileSysStartupMsg) + @sizeof(DosEnvec)
        let storage = match MemoryBlock::alloc(storage_size, MEMF_PUBLIC | MEMF_CLEAR) {
            Result::Ok(value) => value,
            Result::Err(_) => return Result::Err(DosNodeError::AllocationFailed),
        }
        let node = (*DeviceNode)storage.ptr()
        let startup = (*FileSysStartupMsg)(storage.ptr() + @sizeof(DeviceNode))
        let envec = (*DosEnvec)(storage.ptr() + @sizeof(DeviceNode) + @sizeof(FileSysStartupMsg))
        let startup_bptr = match BPtr::<FileSysStartupMsg>::from_ptr(startup) {
            Result::Ok(value) => value,
            Result::Err(_) => return Result::Err(DosNodeError::AllocationFailed),
        }
        let envec_bptr = match BPtr::<DosEnvec>::from_ptr(envec) {
            Result::Ok(value) => value,
            Result::Err(_) => return Result::Err(DosNodeError::AllocationFailed),
        }

        unsafe {
            environment.write_to(envec)
            (*startup).fssm_Unit = unit
            (*startup).fssm_Device = (i32)owned_driver.as_bptr()
            (*startup).fssm_Environ = (i32)envec_bptr.as_raw()
            (*startup).fssm_Flags = open_flags

            (*node).dn_Type = 0
            (*node).dn_StackSize = 4096
            (*node).dn_Priority = 10
            (*node).dn_Startup = (i32)startup_bptr.as_raw()
            (*node).dn_GlobalVec = -1
            (*node).dn_Name = (i32)owned_name.as_bptr()
        }
        return Result::Ok(DosNodeDraft {
            storage: storage,
            name: owned_name,
            driver: owned_driver,
        })
    }

    /// Returns the name value associated with `DosNodeDraft`.
    ///
    /// # Returns
    /// The resulting `Str` value.
    pub fn name(&self) -> Str { return self.name.as_str() }
    /// Returns the driver value associated with `DosNodeDraft`.
    ///
    /// # Returns
    /// The resulting `Str` value.
    pub fn driver(&self) -> Str { return self.driver.as_str() }
    /// Returns the unit value associated with `DosNodeDraft`.
    ///
    /// # Returns
    /// The resulting `u32` value.
    pub fn unit(&self) -> u32 { return unsafe { (*self.startup()).fssm_Unit } }
    /// Opens flags for `DosNodeDraft`.
    ///
    /// # Returns
    /// The resulting `u32` value.
    pub fn open_flags(&self) -> u32 { return unsafe { (*self.startup()).fssm_Flags } }
    /// Returns the dos type value associated with `DosNodeDraft`.
    ///
    /// # Returns
    /// The resulting `u32` value.
    pub fn dos_type(&self) -> u32 { return unsafe { (*self.envec()).de_DosType } }
    /// Returns the block bytes value associated with `DosNodeDraft`.
    ///
    /// # Returns
    /// The resulting `u32` value.
    pub fn block_bytes(&self) -> u32 { return unsafe { (*self.envec()).de_SizeBlock * 4 } }

    @suppress("W0002", "Validated filesystem metadata is copied into NDK ABI fields")
    /// Binds registered for `DosNodeDraft`.
    ///
    /// # Parameters
    /// * `handler` - The `&FileSystemHandler` value used as handler.
    ///
    /// # Returns
    /// `Result::Ok(())` on success; the error value explains why the operation could not complete.
    pub fn bind_registered(&var self, handler: &FileSystemHandler) -> Result<(), DosNodeError> {
        if !handler.segment().is_addressable() {
            return Result::Err(DosNodeError::InvalidHandler)
        }
        let stack = if handler.stack_size() > 0 { handler.stack_size() } else { 4096 }
        let priority = if handler.priority() != 0 { handler.priority() } else { 10 }
        unsafe {
            let node = self.as_raw()
            (*node).dn_SegList = (i32)handler.segment().as_raw()
            (*node).dn_GlobalVec = handler.global_vec()
            (*node).dn_StackSize = stack
            (*node).dn_Priority = priority
        }
        return Result::Ok(())
    }

    /// Returns whether handler for `DosNodeDraft`.
    ///
    /// # Returns
    /// `true` when the stated condition holds; otherwise `false`.
    pub fn has_handler(&self) -> bool {
        return unsafe { (*self.as_raw()).dn_SegList != 0 }
    }

    /// Register the node. Success permanently transfers all backing storage to DOS.
    pub fn register(consuming self, boot_priority: i32, start_process: bool) -> Result<RegisteredDosNode, DosNodeError> {
        if !self.has_handler() { return Result::Err(DosNodeError::MissingHandler) }
        let node = self.as_raw()
        let flags = if start_process { ADNF_STARTPROC } else { 0 }
        if AddDosNode(boot_priority, flags, node) == 0 {
            return Result::Err(DosNodeError::RegistrationFailed)
        }

        let _name = self.name.into_raw()
        let _driver = self.driver.into_raw()
        let _storage = self.storage.into_raw()
        return Result::Ok(RegisteredDosNode { node: node })
    }

    /// Bind an owned embedded handler and transfer it only if DOS accepts the node.
    @suppress("W0002", "A validated loaded-segment BPTR is copied into the NDK node field")
    pub fn register_loaded(consuming self,
        consuming segment: LoadedSegment,
        global_vec: i32,
        stack_size: u32,
        priority: i32,
        boot_priority: i32,
        start_process: bool
    ) -> Result<RegisteredDosNode, DosNodeError> {
        if !segment.segment().is_addressable() {
            return Result::Err(DosNodeError::InvalidHandler)
        }
        unsafe {
            let node = self.as_raw()
            (*node).dn_SegList = (i32)segment.segment().as_raw()
            (*node).dn_GlobalVec = global_vec
            (*node).dn_StackSize = if stack_size > 0 { stack_size } else { 4096 }
            (*node).dn_Priority = if priority != 0 { priority } else { 10 }
        }
        return match self.register(boot_priority, start_process) {
            Result::Ok(node) => {
                let _transferred = segment.into_raw()
                Result::Ok(node)
            },
            Result::Err(error) => Result::Err(error),
        }
    }

    /// Explicit lower-layer escape hatch. The draft retains ownership.
    pub fn as_raw(&self) -> *DeviceNode { return (*DeviceNode)self.storage.ptr() }

    fn startup(&self) -> *FileSysStartupMsg {
        return (*FileSysStartupMsg)(self.storage.ptr() + @sizeof(DeviceNode))
    }

    fn envec(&self) -> *DosEnvec {
        return (*DosEnvec)(self.storage.ptr() + @sizeof(DeviceNode) + @sizeof(FileSysStartupMsg))
    }
}

/// Non-owning proof that DOS accepted and now retains a device node.
pub struct RegisteredDosNode {
    /// The node value stored by `RegisteredDosNode`.
    node: *DeviceNode
}

impl RegisteredDosNode {
    /// Returns the raw representation wrapped by `RegisteredDosNode` without transferring ownership.
    ///
    /// # Returns
    /// The resulting `*DeviceNode` value.
    pub fn as_raw(&self) -> *DeviceNode { return self.node }
}

fn valid_component(value: Str) -> bool {
    if value.is_empty() || value.len() > 255 { return false }
    while var i < value.len() {
        let byte = unsafe { value.as_ptr()[i] }
        if byte == 0 || byte == $3A { return false }
        i++
    }
    return true
}
