// Typed BCPL pointers used by AmigaDOS.

from std::core import Error, Option, Result
from amiga::raw::exec import TypeOfMem

/// Reports failures from bptr operations.
pub enum BPtrError {
    /// Indicates out of range.
    OutOfRange,
}

impl BPtrError {
    /// Returns a human-readable description of this error.
    ///
    /// # Returns
    /// The resulting `*u8` value.
    pub fn message(&self) -> *u8 {
        return "Invalid BCPL pointer"
    }
}

impl Error for BPtrError {
    fn message(&self) -> *u8 {
        return BPtrError::message(self)
    }
}

/// A typed, non-owning AmigaDOS pointer. Dereferencing remains an explicit
/// unsafe boundary because the operating system owns the pointed-to memory.
pub struct BPtr<T> {
    /// The raw value stored by `BPtr`.
    raw: u32,
    /// The  marker value stored by `BPtr`.
    _marker: u8,
}

impl<T> BPtr<T> {
    /// Wraps a raw representation as `BPtr`.
    ///
    /// # Parameters
    /// * `raw` - The `i32` value used as raw.
    ///
    /// # Returns
    /// The requested value on success; the error value explains why the operation could not complete.
    pub fn from_raw(raw: i32) -> Result<BPtr<T>, BPtrError> {
        if raw < 0 {
            return Result::Err(BPtrError::OutOfRange)
        }
        return BPtr::<T>::from_raw_u32((u32)raw)
    }

    /// Creates `BPtr` from raw u32.
    ///
    /// # Parameters
    /// * `raw` - The `u32` value used as raw.
    ///
    /// # Returns
    /// The requested value on success; the error value explains why the operation could not complete.
    pub fn from_raw_u32(raw: u32) -> Result<BPtr<T>, BPtrError> {
        if raw > $3FFFFFFF {
            return Result::Err(BPtrError::OutOfRange)
        }
        return Result::Ok(BPtr { raw: raw, _marker: 0 })
    }

    /// Convert a known Amiga pointer to a typed BPTR.
    pub fn from_ptr(ptr: *T) -> Result<BPtr<T>, BPtrError> {
        let address = (u32)ptr
        if address == 0 || address & 3 != 0 {
            return Result::Err(BPtrError::OutOfRange)
        }
        let value = BPtr { raw: address >> 2, _marker: 0 }
        if !value.is_addressable() {
            return Result::Err(BPtrError::OutOfRange)
        }
        return Result::Ok(value)
    }

    /// Returns the raw representation wrapped by `BPtr` without transferring ownership.
    ///
    /// # Returns
    /// The resulting `u32` value.
    pub fn as_raw(&self) -> u32 {
        return self.raw
    }

    /// Returns whether null for `BPtr`.
    ///
    /// # Returns
    /// `true` when the stated condition holds; otherwise `false`.
    pub fn is_null(&self) -> bool {
        return self.raw == 0
    }

    /// Returns the address value associated with `BPtr`.
    ///
    /// # Returns
    /// The resulting `u32` value.
    pub fn address(&self) -> u32 {
        return self.raw << 2
    }

    /// True when the complete pointed-to value is in known Amiga memory.
    pub fn is_addressable(&self) -> bool {
        if self.is_null() {
            return false
        }
        let size = @sizeof(T)
        let address = self.address()
        if size > 1 && address > $FFFFFFFF - (size - 1) {
            return false
        }
        if TypeOfMem((*u8)address) == 0 {
            return false
        }
        return size <= 1 || TypeOfMem((*u8)(address + size - 1)) != 0
    }

    /// The caller must prove that the OS object is alive and has type T.
    @unsafe
    pub fn as_ptr(&self) -> *T {
        return (*T)self.address()
    }

    /// The caller must prove that the OS object remains alive for the borrow.
    @unsafe
    pub fn borrow(&self) -> Option<&T> {
        if !self.is_addressable() {
            return Option::None
        }
        return Option::Some(unsafe { &*self.as_ptr() })
    }
}
