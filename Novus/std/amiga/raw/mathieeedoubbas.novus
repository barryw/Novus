/// long	c;
///
/// # Arguments
///
/// * y -- IEEE double precision floating point value z -- IEEE double precision floating point value
///
/// # Returns
///
/// c = 1   cc = gt         for (y > z)
/// c = 0   cc = eq         for (y == z)
/// c = -1  cc = lt         for (y < z)
///
/// # Bugs
///
/// Did not work correctly prior to V45 and might have returned results
/// indicating the wrong order for negative numbers of small absolute
/// value. This has been fixed in V45.
@library("mathieeedoubbas.library")
extern pub fn IEEEDPCmp(leftParm: f64, rightParm: f64) -> i32
