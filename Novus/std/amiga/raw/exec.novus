///
/// The 68000 processor has a "MOVE SR,<ea>" instruction which gets a copy of
/// the processor condition codes. On the 68010,20 and 30 CPUs, "MOVE SR,<ea>"
/// is privileged.
///
/// # Returns
/// conditions - the 680XX condition codes
@library("exec.library")
extern pub fn GetCC() -> u32
/// Determine attributes of a given memory address
///
/// Given a RAM memory address, search the system memory lists and return its
/// memory attributes. The memory attributes are similar to those specified when
/// the memory was first allocated: (eg.
///
/// # Returns
/// attributes - a long word of memory attribute flags. If the address is
/// not in known RAM, zero is returned.
///
/// See also: AllocMem()
@library("exec.library")
extern pub fn TypeOfMem(address: *u8) -> u32
/// Bid for a semaphore                                   (V39)
///
/// This function is used to obtain a semaphore in an async manner. Like
/// ObtainSemaphore(), it will obtain a SignalSemaphore for you but unlike
/// ObtainSemaphore(), you will not block until you get the semaphore.
///
/// See also: ObtainSemaphoreShared(), InitSemaphore(), ReleaseSemaphore(), AttemptSemaphore(), ObtainSemaphoreList()
@library("exec.library")
extern pub fn Procure(sigSem: *SignalSemaphore, bidMsg: *u8) -> u32
/// Release a bitMessage from Procure()                    (V39)
///
/// This function can be used to release a semaphore obtained via Procure().
/// However, the main purpose for this call is to be able to remove a bid for a
/// semaphore that has not yet responded.
///
/// See also: ObtainSemaphoreShared(), InitSemaphore(), ReleaseSemaphore(), AttemptSemaphore(), ObtainSemaphoreList()
@library("exec.library")
extern pub fn Vacate(sigSem: *SignalSemaphore, bidMsg: *u8)
/// Gain access to a library
///
/// This function returns a pointer to a library that was previously installed
/// into the system. If the requested library is exists, and if the library
/// version is greater than or equal to the requested version, then the open
/// will succeed.
///
/// # Arguments
/// * `libName` - the name of the library to open
/// * `version` - the version of the library required.
///
/// # Returns
/// library - a library pointer for a successful open, else zero
///
/// See also: CloseLibrary
@library("exec.library")
extern pub fn OpenLibrary(libName: *u8, version: u32) -> *Library
/// Initialize a signal semaphore
///
/// This function initializes a signal semaphore and prepares it for use. It
/// does not allocate anything, but does initialize list pointers and the
/// semaphore counters.
///
/// See also: ObtainSemaphore, ObtainSemaphoreShared, AttemptSemaphore, ReleaseSemaphore, Procure
@library("exec.library")
extern pub fn InitSemaphore(sigSem: *SignalSemaphore)
/// Gain exclusive access to a semaphore
///
/// Signal semaphores are used to gain exclusive access to an object.
/// ObtainSemaphore is the call used to gain this access.
///
/// See also: ObtainSemaphoreShared(), InitSemaphore(), ReleaseSemaphore(), AttemptSemaphore(), ObtainSemaphoreList()
@library("exec.library")
extern pub fn ObtainSemaphore(sigSem: *SignalSemaphore)
/// Make signal semaphore available to others
///
/// ReleaseSemaphore() is the inverse of ObtainSemaphore(). It makes the
/// semaphore lockable to other users.
///
/// See also: InitSemaphore(), ObtainSemaphore(), ObtainSemaphoreShared()
@library("exec.library")
extern pub fn ReleaseSemaphore(sigSem: *SignalSemaphore)
/// Try to obtain without blocking
///
/// This call is similar to ObtainSemaphore(), except that it will not block if
/// the semaphore could not be locked. INPUT signalSemaphore -- an initialized
/// signal semaphore structure
///
/// # Returns
/// success -- TRUE if the semaphore was locked, false if some other task
/// already possessed the semaphore.
///
/// See also: ObtainSemaphore() ObtainSemaphoreShared(), ReleaseSemaphore(), exec/semaphores.h
@library("exec.library")
extern pub fn AttemptSemaphore(sigSem: *SignalSemaphore) -> u32
/// Get a list of semaphores.
///
/// Signal semaphores may be linked together into a list. This function takes a
/// list of these semaphores and attempts to lock all of them at once.
///
/// See also: ObtainSemaphoreShared(), InitSemaphore(), ReleaseSemaphore(), AttemptSemaphore(), ObtainSemaphoreShared()
@library("exec.library")
extern pub fn ObtainSemaphoreList(sigSem: *List)
/// Make a list of semaphores available
///
/// ReleaseSemaphoreList() is the inverse of ObtainSemaphoreList(). It releases
/// each element in the semaphore list.
///
/// See also: ObtainSemaphoreList()
@library("exec.library")
extern pub fn ReleaseSemaphoreList(sigSem: *List)
/// Find a given system signal semaphore
///
/// This function will search the system signal semaphore list for a semaphore
/// with the given name. The first semaphore matching this name will be
/// returned.
///
/// # Returns
/// semaphore - a pointer to the signal semaphore, or zero if not found.
@library("exec.library")
extern pub fn FindSemaphore(name: *u8) -> *SignalSemaphore
/// Initialize then add a signal semaphore to the system
///
/// This function attaches a signal semaphore structure to the system's public
/// signal semaphore list. The name and priority fields of the semaphore
/// structure must be initialized prior to calling this function.
///
/// # Arguments
///
/// See also: RemSemaphore, FindSemaphore, InitSemaphore
@library("exec.library")
extern pub fn AddSemaphore(sigSem: *SignalSemaphore)
/// Remove a signal semaphore from the system
///
/// This function removes a signal semaphore structure from the system's signal
/// semaphore list. Subsequent attempts to rendezvous by name with this
/// semaphore will fail.
///
/// # Arguments
///
/// See also: AddSemaphore, FindSemaphore
@library("exec.library")
extern pub fn RemSemaphore(sigSem: *SignalSemaphore)
