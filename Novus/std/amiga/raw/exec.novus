///
/// # Returns
///
/// result   - Whatever values the userFunc left in the registers.
///
/// # Examples
///
/// ;Obtain the Exception Vector base.  68010 or greater only!
/// MOVECtrap:	movec.l	VBR,d0	;$4e7a,$0801
/// 		rte
///
/// # See Also
///
/// SuperState, UserState
