/// forget RemPort()!
///
/// See also: DeleteMsgPort(), exec/AddPort(), exec/ports.h, amiga.lib/CreatePort()
@library("exec.library")
extern pub fn CreateMsgPort() -> *MsgPort
/// Free a message port created by CreateMsgPort  (V36)
///
/// Frees a message port created by CreateMsgPort(). All messages that may have
/// been attached to this port must have already been replied to.
///
/// # Arguments
/// * `msgPort` - A message port.  NULL for no action.
///
/// See also: CreateMsgPort(), amiga.lib/DeletePort()
@library("exec.library")
extern pub fn DeleteMsgPort(consuming port: *MsgPort)
/// Gain shared access to a semaphore (V36)
///
/// A lock on a signal semaphore may either be exclusive, or shared. Exclusive
/// locks are granted by the ObtainSemaphore() and AttemptSemaphore() functions.
///
/// See also: ObtainSemaphore(), InitSemaphore(), ReleaseSemaphore(), AttemptSemaphore(), ObtainSemaphoreList()
@library("exec.library")
extern pub fn ObtainSemaphoreShared(sigSem: *SignalSemaphore)
/// Allocate memory and keep track of the size  (V36)
///
/// This function works identically to AllocMem(), but tracks the size of the
/// allocation. See the AllocMem() documentation for details.
///
/// # Warning
/// The result of any memory allocation MUST be checked, and a viable
///
/// See also: FreeVec, AllocMem
@library("exec.library")
extern pub fn AllocVec(byteSize: u32, requirements: u32) -> *u8
/// Return AllocVec() memory to the system  (V36)
///
/// Free an allocation made by the AllocVec() call. The memory will be returned
/// to the system pool from which it came.
///
/// # Arguments
/// * `memoryBlock` - pointer to the memory block to free, or NULL.
///
/// See also: AllocVec
@library("exec.library")
extern pub fn FreeVec(consuming memoryBlock: *u8)
/// Generate a private memory pool header (V39)
///
/// Allocate and prepare a new memory pool header. Each pool is a separate
/// tracking system for memory of a specific type.
///
/// # Arguments
/// * `memFlags` - a memory flags specifier, as taken by AllocMem.
///   puddleSize - the size of Puddles... threshSize - the largest
///   allocation that goes into normal puddles This *MUST* be less than or
///   equal to puddleSize (CreatePool() will fail if it is not)
///
/// # Returns
/// The address of a new pool header, or NULL for error.
///
/// See also: DeletePool(), AllocPooled(), FreePooled(), exec/memory.i
@library("exec.library")
extern pub fn CreatePool(requirements: u32, puddleSize: u32, threshSize: u32) -> *u8
/// Drain an entire memory pool (V39)
///
/// Frees all memory in all pudles of the specified pool header, then deletes
/// the pool header. Individual free calls are not needed.
///
/// # Arguments
/// * `poolHeader` - as returned by CreatePool().
///
/// See also: CreatePool(), AllocPooled(), FreePooled()
@library("exec.library")
extern pub fn DeletePool(consuming poolHeader: *u8)
/// Allocate memory with the pool manager (V39)
///
/// Allocate memSize bytes of memory, and return a pointer. NULL is returned if
/// the allocation fails.
///
/// # Arguments
/// * `memSize` - the number of bytes to allocate poolHeader - a specific
///   private pool header.
///
/// # Returns
/// A pointer to the memory, or NULL. The memory block returned is long
/// word aligned.
///
/// See also: FreePooled(), CreatePool(), DeletePool()
@library("exec.library")
extern pub fn AllocPooled(poolHeader: *u8, memSize: u32) -> *u8
/// Free pooled memory  (V39)
///
/// Deallocates memory allocated by AllocPooled(). The size of the allocation
/// *MUST* match the size given to AllocPooled().
///
/// # Arguments
/// * `memory` - pointer to memory allocated by AllocPooled. poolHeader - a
///   specific private pool header.
///
/// See also: AllocPooled(), CreatePool(), DeletePool()
@library("exec.library")
extern pub fn FreePooled(poolHeader: *u8, consuming memory: *u8, memSize: u32)
/// Try to obtain without blocking       (V37)
///
/// This call is similar to ObtainSemaphoreShared(), except that it will not
/// block if the semaphore could not be locked. INPUT signalSemaphore -- an
/// initialized signal semaphore structure
///
/// # Returns
/// success -- TRUE if the semaphore was granted, false if some other task
/// already possessed the semaphore in exclusive mode.
///
/// See also: ObtainSemaphore() ObtainSemaphoreShared(), ReleaseSemaphore(), exec/semaphores.h
@library("exec.library")
extern pub fn AttemptSemaphoreShared(sigSem: *SignalSemaphore) -> u32

// Void pointer wrappers for semaphore functions (to avoid FFI type issues in generated C)
@library("exec.library")
extern pub fn __novus_init_semaphore(sigSem: *u8)
@library("exec.library")
extern pub fn __novus_obtain_semaphore(sigSem: *u8)
@library("exec.library")
extern pub fn __novus_release_semaphore(sigSem: *u8)
@library("exec.library")
extern pub fn __novus_attempt_semaphore(sigSem: *u8) -> i32
@library("exec.library")
extern pub fn __novus_obtain_semaphore_shared(sigSem: *u8)
@library("exec.library")
extern pub fn __novus_attempt_semaphore_shared(sigSem: *u8) -> i32
@library("exec.library")
extern pub fn __novus_add_semaphore(sigSem: *u8)
@library("exec.library")
extern pub fn __novus_rem_semaphore(sigSem: *u8)
@library("exec.library")
extern pub fn __novus_find_semaphore(name: *u8) -> *u8
/// Reboot the Amiga (V36)
///
/// Reboot the machine. All external memory and periperals will be RESET, and
/// the machine will start its power up diagnostics.
///
/// # Returns
/// An altogether totally integrated living system.
@library("exec.library")
extern pub fn ColdReboot()
/// EXEC supported method of replacing task's stack      (V37)
///
/// This function will, in an EXEC supported manner, swap the stack of your task
/// with the given values in StackSwap. The StackSwapStruct structure will then
/// contain the values of the old stack such that the old stack can be restored.
///
/// # Arguments
/// * `newStack` - A structure that contains the values for the new upper
///   and lower stack bounds and the new stack pointer. This structure will
///   have its values replaced by those in you task such that you can
///   restore the stack later.
///
/// # Returns
/// newStack - The structure will now contain the old stack. This means
/// that StackSwap(foo); StackSwap(foo); will effectively do nothing.
///
/// See also: AddTask, RemTask, exec/tasks.h
@library("exec.library")
extern pub fn StackSwap(newStack: *StackSwapStruct)
/// Take actions prior to hardware DMA  (V37)
///
/// Take all appropriate steps before Direct Memory Access (DMA). This function
/// is primarily intended for writers of DMA device drivers.
///
/// # Arguments
/// * `address	- Base address to start the action. length	- Pointer to a longword with a length. flags	- Values: DMA_Continue` -
///   Indicates this call is to complete a prior request that was broken
///   up.
/// * `DMA_ReadFromRAM` - Indicates that this DMA is a read from RAM to the
///   DMA device (ie - a write to the hard drive) This flag is not required
///   but if used must match in both the PreDMA and PostDMA calls. This
///   flag *should* be used to help the system provide the best
///   performance. This flag is safe in all versions of CachePreDMA()
///
/// # Returns
/// paddress- Physical address that corresponds to the input virtual
/// address. &length - This length value will be updated to reflect the
/// contiguous length of physical memory present at paddress. This may be
/// smaller than the requested length. To get the mapping for the next
/// chunk of memory, call the function again with a new address, length,
/// and the DMA_Continue flag.
///
/// See also: exec/execbase.i, CachePostDMA, CacheClearU, CacheClearE
@library("exec.library")
extern pub fn CachePreDMA(address: *u8, length: *u8, flags: u32) -> *u8
/// Take actions after to hardware DMA  (V37)
///
/// Take all appropriate steps after Direct Memory Access (DMA). This function
/// is primarily intended for writers of DMA device drivers.
///
/// # Arguments
/// * `address	- Same as initially passed to CachePreDMA length	- Same as initially passed to CachePreDMA flags	- Values: DMA_NoModify` -
///   If the area was not modified (and thus there is no reason to flush
///   the cache) set this bit.
/// * `DMA_ReadFromRAM` - Indicates that this DMA is a read from RAM to the
///   DMA device (ie - a write to the hard drive) This flag is not required
///   but if used must match in both the PreDMA and PostDMA calls. This
///   flag *should* be used to help the system provide the best
///   performance. This flag is safe in all versions of CachePostDMA()
///
/// See also: exec/execbase.i, CachePreDMA, CacheClearU, CacheClearE
@library("exec.library")
extern pub fn CachePostDMA(address: *u8, length: *u8, flags: u32)
/// Add a low memory handler to exec                 (V39)
///
/// This function adds a low memory handler to the system. The handler is
/// described in the Interrupt structure.
///
/// # Arguments
/// * `memHandler` - A pointer to a completely filled in Interrupt
///   structure The priority field determine the position of the handler
///   with respect to other handlers in the system. The higher the
///   priority, the earlier the handler is called. Positive priorities will
///   have the handler called before any of the library expunge vectors are
///   called. Negative priority handlers will be called after the library
///   expunge routines are called. (Note: RAMLIB is a handler at priority
///   0)
///
/// See also: RemMemHandler, exec/interrupts.i
@library("exec.library")
extern pub fn AddMemHandler(memhand: *Interrupt)
/// Remove low memory handler from exec              (V39)
///
/// This function removes the low memory handler from the system. This function
/// can be called from within a handler.
///
/// # Arguments
/// * `memHandler` - Pointer to a handler added with AddMemHandler()
///
/// See also: AddMemHandler, exec/interrupts.i
@library("exec.library")
extern pub fn RemMemHandler(memhand: *Interrupt)
@library("exec.library")
extern pub fn ObtainQuickVector(interruptCode: *u8) -> u32
@library("exec.library")
extern pub fn NewMinList(minlist: *MinList)
/// Add node to the tree (V45)
///
/// The function will add the given node to the AVL tree in the correct
/// position. The correct position is determined by the compare function which
/// is also passed in and which defines relative value of nodes by determining
/// their "key" values and comparing them.
///
/// # Arguments
/// * `root` - Address of(!) the root pointer(!) of the AVL tree.
///   Initially, the root pointer must be set to NULL, which represents an
///   empty AVL tree.
/// * `node` - The node to add
/// * `func` - The compare function to find the right position for the node
///   in the tree
///
/// # Returns
/// If the node could be added, NULL is returned. If there is already a
/// node in the tree that has the same key, the pointer to that node be
/// returned and the given node will not be added.
///
/// See also: AVL_FindLastNode(), AVL_FindFirstNode(), AVL_RemNodeByKey(), AVL_RemNodeByAddress(), AVL_FindNextNodeByKey()
@library("exec.library")
extern pub fn AVL_AddNode(root: *u8, node: *u8, func: *u8) -> *u8
/// Remove a given node (V45)
///
/// The function will remove the given node from the tree. Note that there is no
/// arbitration for access to the tree.
///
/// # Arguments
/// * `root` - Address of(!) the root pointer(!) of the AVL tree
/// * `node` - pointer to the struct AVLNode that should be removed
///
/// # Returns
/// A pointer to the removed node.
///
/// See also: AVL_FindLastNode(), AVL_FindNode(), AVL_FindFirstNode(), AVL_RemNodeByAddress(), AVL_AddNode()
@library("exec.library")
extern pub fn AVL_RemNodeByAddress(root: *u8, node: *u8) -> *u8
/// Remove a node identified by its key (V45)
///
/// The function will search for the node with the given key and remove it from
/// the tree. Note that there is no arbitration for access to the tree.
///
/// # Arguments
/// * `root` - Address of(!) the root pointer(!) of the AVL tree
/// * `key` - An abstract key to match a node by the given compare function
/// * `func` - The compare function to check if a struct AVLNode matches
///   the given key
///
/// # Returns
/// A pointer to the removed node or NULL if the node could not be found.
///
/// See also: AVL_FindLastNode(), AVL_FindNode(), AVL_FindFirstNode(), AVL_RemNodeByAddress(), AVL_AddNode()
@library("exec.library")
extern pub fn AVL_RemNodeByKey(root: *u8, key: *u8, func: *u8) -> *u8
/// Find a node identified by its key (V45)
///
/// The function will search for the node with the given key and return a
/// pointer to it. Note that the compare function works like strcmp() by
/// returning <0, 0, >0 results to define a less/equal/greater relationship.
///
/// # Arguments
/// * `root` - pointer to the root of the AVL tree
/// * `key` - An abstract key to match a node by the given compare function
/// * `func` - The compare function to check if a struct AVLNode matches
///   the given key
///
/// # Returns
/// A pointer to the node or NULL if the node could not be found.
///
/// See also: AVL_FindLastNode(), AVL_FindFirstNode(), AVL_AddNode(), AVL_RemNodeByAddress()
@library("exec.library")
extern pub fn AVL_FindNode(root: *u8, key: *u8, func: *u8) -> *u8
/// Return previous node of a tree (V45)
///
/// Given the pointer to a struct AVLNode, this function will return the
/// logically previous/lower/smaller entry in the tree Using this function, you
/// can start to walk the tree in a "linear" fashion.
///
/// # Arguments
/// * `node` - pointer to the current AVLNode
///
/// # Returns
/// A pointer to the logically previous AVLNode or NULL if there is none.
///
/// See also: AVL_FindLastNode(), AVL_RemNodeByAddress()
@library("exec.library")
extern pub fn AVL_FindPrevNodeByAddress(node: *u8) -> *u8
/// Find node identified by a key (V45)
///
/// The function will search for a node or the next lower node based on the key
/// given and return a pointer to it. Note that the compare function works like
/// strcmp() by returning <0, 0, >0 results to define a less/equal/greater
/// relationship.
///
/// # Arguments
/// * `root` - pointer to the root of the AVL tree
/// * `key` - An abstract key to match a node by the given compare function
/// * `func` - The compare function to check if a struct AVLNode matches
///   the given key
///
/// # Returns
/// A pointer to the node with the given key or the next lower node if no
/// exact match was found.
///
/// See also: AVL_FindLastNode(), AVL_FindFirstNode(), AVL_AddNode(), AVL_RemNodeByAddress(), AVL_FindPrevNodeByAddress()
@library("exec.library")
extern pub fn AVL_FindPrevNodeByKey(root: *u8, key: *u8, func: *u8) -> *u8
/// Return the next node of a tree (V45)
///
/// Given the pointer to a struct AVLNode, this function will return the
/// logically next/higher/bigger entry in the tree Using this function, you can
/// start to walk the tree in a "linear" fashion.
///
/// # Arguments
/// * `node` - pointer to the current AVLNode
///
/// # Returns
/// A pointer to the logically next AVLNode or NULL if there is none.
///
/// See also: AVL_FindFirstNode(), AVL_RemNodeByAddress()
@library("exec.library")
extern pub fn AVL_FindNextNodeByAddress(node: *u8) -> *u8
/// Find node identified by a key (V45)
///
/// The function will search for a node or the next higher node based on the key
/// given and return a pointer to it. Note that the compare function works like
/// strcmp() by returning <0, 0, >0 results to define a less/equal/greater
/// relationship.
///
/// # Arguments
/// * `root` - pointer to the root of the AVL tree
/// * `key` - An abstract key to match a node by the given compare function
/// * `func` - The compare function to check if a struct AVLNode matches
///   the given key
///
/// # Returns
/// A pointer to the node with the given key or the next higher node if no
/// exact match was found.
///
/// See also: AVL_FindLastNode(), AVL_FindFirstNode(), AVL_AddNode(), AVL_RemNodeByAddress(), AVL_FindNextNodeByAddress()
@library("exec.library")
extern pub fn AVL_FindNextNodeByKey(root: *u8, key: *u8, func: *u8) -> *u8
/// Return the lowest/smallest node (V45)
///
/// This functions will return the pointer to the first node in the given AVL
/// tree. Using this function, you can start to walk the tree in a "linear"
/// fashion.
///
/// # Arguments
/// * `root` - The pointer to the root of the AVL tree
///
/// # Returns
/// A pointer to the smallest/lowest node in the tree or NULL for an empty
/// tree.
///
/// See also: AVL_FindNextNodeByAddress(), AVL_RemNodeByAddress()
@library("exec.library")
extern pub fn AVL_FindFirstNode(root: *u8) -> *u8
/// Return the highest/biggest node (V45)
///
/// This functions will return the pointer to the last node in the given AVL
/// tree. Using this function, you can start to walk the tree in a "linear"
/// fashion.
///
/// # Arguments
/// * `root` - The pointer to the root of the AVL tree
///
/// # Returns
/// A pointer to the highest/biggest node in the tree or NULL for an empty
/// tree.
///
/// See also: AVL_FindPrevNodeByAddress(), AVL_RemNodeByAddress()
@library("exec.library")
extern pub fn AVL_FindLastNode(root: *u8) -> *u8
