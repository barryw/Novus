///
/// See also: CreateIORequest(), amiga.lib/DeleteExtIO()
@library("exec.library")
extern pub fn DeleteIORequest(consuming iorequest: *u8)
/// Allocate and initialize a new message port  (V36)
///
/// Allocates and initializes a new message port. The message list of the new
/// port will be prepared for use (via NewList).
///
/// # Returns
/// MsgPort - A new MsgPort structure ready for use, or NULL if out of
