///
/// See FindAddressEntryA() for details
///
/// # See Also
///
/// FindAddressEntryA(), DisposeAddressEntry()
@library("aml.library")
extern pub fn HuntAddressEntryA(server: *u8, tags: *TagItem) -> *u8
