///
/// struct Node * AllocClickTabNodeA(struct TagItem *)
/// node = AllocClickTabNodeA(taglist)
///
/// # Arguments
///
/// * `columns` - How many columns your ClickTab has. taglist - Attributes for the node, passed onto SetClickTabNodeAttrsA().
///
/// # Returns
///
/// node - A node that can be added into the Exec list of labels for
/// a ClickTab gadget.
///
/// # See Also
///
/// FreeClickTabNode(), SetClickTabNodeAttrsA()
@library("clicktab.library")
extern pub fn AllocClickTabNodeA(tags: *TagItem) -> *Node
