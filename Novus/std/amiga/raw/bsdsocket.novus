pub const EFAULT: i32 = 14         // Bad address
pub const EBUSY: i32 = 16          // Device busy
pub const EINVAL: i32 = 22         // Invalid argument
pub const EMFILE: i32 = 24         // Too many open files
pub const EPIPE: i32 = 32          // Broken pipe
pub const EWOULDBLOCK: i32 = 35    // Operation would block
pub const EINPROGRESS: i32 = 36    // Operation in progress
pub const EALREADY: i32 = 37       // Operation already in progress
pub const ENOTSOCK: i32 = 38       // Not a socket
pub const EDESTADDRREQ: i32 = 39   // Destination address required
pub const EMSGSIZE: i32 = 40       // Message too long
pub const EPROTOTYPE: i32 = 41     // Protocol wrong type
pub const ENOPROTOOPT: i32 = 42    // Protocol not available
pub const EPROTONOSUPPORT: i32 = 43 // Protocol not supported
pub const ESOCKTNOSUPPORT: i32 = 44 // Socket type not supported
pub const EOPNOTSUPP: i32 = 45     // Operation not supported
pub const EPFNOSUPPORT: i32 = 46   // Protocol family not supported
pub const EAFNOSUPPORT: i32 = 47   // Address family not supported
pub const EADDRINUSE: i32 = 48     // Address already in use
pub const EADDRNOTAVAIL: i32 = 49  // Address not available
pub const ENETDOWN: i32 = 50       // Network is down
pub const ENETUNREACH: i32 = 51    // Network unreachable
pub const ENETRESET: i32 = 52      // Network dropped connection
pub const ECONNABORTED: i32 = 53   // Connection aborted
pub const ECONNRESET: i32 = 54     // Connection reset by peer
pub const ENOBUFS: i32 = 55        // No buffer space available
pub const EISCONN: i32 = 56        // Socket is connected
pub const ENOTCONN: i32 = 57       // Socket not connected
pub const ESHUTDOWN: i32 = 58      // Socket shutdown
pub const ETIMEDOUT: i32 = 60      // Connection timed out
