// Novus Standard Library - Amiga OS Type Mapping Reference
// Namespace: std::amiga_types
//
// This file defines the Amiga OS type system in native Novus terms.
//
// Amiga Type    Novus Type    Description
// ===========   ===========   ================================================
// BYTE          i8            signed 8-bit quantity
// UBYTE         u8            unsigned 8-bit quantity
// WORD          i16           signed 16-bit quantity
// UWORD         u16           unsigned 16-bit quantity
// LONG          i32           signed 32-bit quantity
// ULONG         u32           unsigned 32-bit quantity
// BOOL          i16           Boolean (16-bit on Amiga, TRUE=1, FALSE=0)
// APTR          *u8           32-bit untyped pointer (void*)
// STRPTR        *u8           String pointer (NULL terminated)
// BPTR          i32           BCPL pointer (byte offset / 4, NOT a real pointer!)
//
// Special note on BPTR:
//   BPTR is NOT a regular pointer! It's a LONG containing a byte offset
//   divided by 4 (BCPL word addressing). To convert BPTR to native pointer:
//     let ptr: *u8 = (*u8)(u32)((bptr_value << 2))
//
// ============================================================================
// Type aliases
// ============================================================================

pub type BYTE = i8
pub type UBYTE = u8
pub type WORD = i16
pub type UWORD = u16
pub type LONG = i32
pub type ULONG = u32
pub type BOOL = i16
pub type APTR = *u8
pub type STRPTR = *u8
pub type BPTR = i32

// ============================================================================
// Constants
// ============================================================================

// Memory allocation flags - import from amiga::raw::structs (source of truth)

// ============================================================================
// Notes
// ============================================================================

// 1. BPTR is NOT a regular pointer! It's a LONG that contains a byte offset
//    divided by 4 (BCPL word offset). To convert BPTR to native pointer:
//      APTR ptr = (APTR)(BPTR_VALUE << 2);
//
// 2. Many Amiga functions return BOOL (16-bit) not bool (8-bit in C99)
//
// 3. APTR is used for "any pointer" - similar to void* in C
//
// 4. Some types have multiple definitions in the NDK (signed/unsigned char)
//    depending on compiler flags. We use the most common versions.
//
// 5. These types are primarily for FFI. Native Novus code should prefer
//    Novus types (u32, i32, *u8, etc.) for clarity.
