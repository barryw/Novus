// ReAction GUI Tag Constants
// Namespace: amiga::raw::reaction_tags
//
// Tag constants for ReAction GUI toolkit (OS 3.5+)
// These are the BOOPSI tag IDs for the various ReAction classes.
//
// Reference: AmigaOS NDK headers from d0.se/include/

// ============================================================================
// Base Tag Values
// ============================================================================

// TAG_USER = 0x80000000
pub const TAG_USER: u32 = $80000000

// ReAction base offset
pub const REACTION_Dummy: u32 = TAG_USER + $5000000

// ============================================================================
// Gadget Class Tags (intuition/gadgetclass.h)
// ============================================================================

