from std::core import Error, From, Option, Result
from std::memory import Slice
from amiga::sys::audio::errors import AudioError as SystemAudioError
from amiga::sys::device::audio import AudioDeviceHandle as SystemDevice, ChannelPreference
from amiga::sys::hardware::audio import SampleHandle as SystemSample, is_pal_system

// Tier 1: ordinary PCM playback without chip-RAM, pointer, or audio.device mechanics.
pub use amiga::sys::device::audio::ChannelPreference

/// Reports failures from playback operations.
pub enum PlaybackError {
    /// Indicates that the requested service is unavailable.
    Unavailable,
    /// Indicates that the audio sample is invalid.
    InvalidSample,
    /// Indicates that the playback settings are invalid.
    InvalidPlayback,
    /// Indicates that memory allocation failed.
    OutOfMemory,
    /// Indicates playback failed.
    PlaybackFailed,
}

/// Aliases `AudioError` to `PlaybackError`.
pub type AudioError = PlaybackError

impl Error for PlaybackError {
    fn message(&self) -> *u8 {
        return match *self {
            PlaybackError::Unavailable => "Audio is unavailable",
            PlaybackError::InvalidSample => "The audio sample is invalid",
            PlaybackError::InvalidPlayback => "The playback settings are invalid",
            PlaybackError::OutOfMemory => "There is not enough audio memory",
            PlaybackError::PlaybackFailed => "Audio playback failed",
        }
    }
}

impl From<SystemAudioError> for PlaybackError {
    fn convert(consuming error: SystemAudioError) -> PlaybackError {
        return match error {
            SystemAudioError::NoMsgPort | SystemAudioError::NoIORequest | SystemAudioError::DeviceOpenFailed | SystemAudioError::NoAllocation | SystemAudioError::AllocFailed => PlaybackError::Unavailable,
            SystemAudioError::SampleNotChipRam | SystemAudioError::SampleMisaligned | SystemAudioError::SampleTooLong | SystemAudioError::SampleTooShort | SystemAudioError::NullSampleData | SystemAudioError::InvalidSampleNumber | SystemAudioError::InvalidModuleData => PlaybackError::InvalidSample,
            SystemAudioError::InvalidChannel | SystemAudioError::InvalidVolume | SystemAudioError::InvalidPeriod | SystemAudioError::InvalidSampleRate | SystemAudioError::InvalidChannelMask => PlaybackError::InvalidPlayback,
            SystemAudioError::AllocationFailed | SystemAudioError::ChipCacheError => PlaybackError::OutOfMemory,

            _ => PlaybackError::PlaybackFailed,
        }
    }
}

/// Represents a sample value.
pub struct Sample {
    /// The sample value stored by `Sample`.
    sample: SystemSample,
}

impl Sample {
    /// Copy signed 8-bit PCM into DMA-safe memory. The source may live anywhere.
    pub fn from_pcm(bytes: Slice<u8>, sample_rate: u32) -> Result<Sample, AudioError> {
        let Option::Some(first) = bytes.get(0) else {
            return Result::Err(PlaybackError::InvalidSample)
        }
        let sample = SystemSample::from_data_with_rate(unsafe { (*u8)first }, bytes.len(), sample_rate)?
        return Result::Ok(Sample { sample: sample })
    }

    /// Borrows the system-level value wrapped by `Sample`.
    ///
    /// # Returns
    /// A shared borrow of `SystemSample` tied to the receiver.
    pub fn system(&self) -> &SystemSample { return &self.sample }
    /// Wraps an owned system-level value as `Sample`.
    ///
    /// # Parameters
    /// * `sample` - The sample; ownership transfers to this call.
    ///
    /// # Returns
    /// The resulting `Sample` value.
    ///
    /// # Ownership
    /// Arguments marked `consuming` transfer ownership to this call.
    pub fn from_system(consuming sample: SystemSample) -> Sample { return Sample { sample: sample } }
    /// Consumes `Sample` and returns its system-level value.
    ///
    /// # Returns
    /// The resulting `SystemSample` value.
    ///
    /// # Ownership
    /// Arguments marked `consuming` transfer ownership to this call.
    pub fn into_system(consuming self) -> SystemSample { return self.sample }
}

/// Represents a device value.
pub struct ApplicationAudioDevice {
    /// The device value stored by `Device`.
    device: SystemDevice,
}

impl ApplicationAudioDevice {
    /// Opens `Device`.
    ///
    /// # Parameters
    /// * `preference` - The `ChannelPreference` value used as preference.
    /// * `priority` - The priority value.
    ///
    /// # Returns
    /// The requested value on success; the error value explains why the operation could not complete.
    pub fn open(preference: ChannelPreference, priority: i8) -> Result<Device, AudioError> {
        let device = SystemDevice::open(preference, priority)?
        return Result::Ok(ApplicationAudioDevice { device: device })
    }

    /// Opens `Device` using any available system resource.
    ///
    /// # Parameters
    /// * `priority` - The priority value.
    ///
    /// # Returns
    /// The requested value on success; the error value explains why the operation could not complete.
    pub fn open_any(priority: i8) -> Result<Device, AudioError> {
        return ApplicationAudioDevice::open(ChannelPreference::Any, priority)
    }

    /// Play once at the sample's native rate; PAL/NTSC timing is automatic.
    pub fn play(&var self, sample: &Sample, volume: u16) -> Result<(), AudioError> {
        self.device.play_native(sample.system(), volume, 1, is_pal_system())?
        return Result::Ok(())
    }

    /// Starts looped playback on `Device`.
    ///
    /// # Parameters
    /// * `sample` - The `&Sample` value used as sample.
    /// * `volume` - The `u16` value used as volume.
    ///
    /// # Returns
    /// `Result::Ok(())` on success; the error value explains why the operation could not complete.
    pub fn play_looped(&var self, sample: &Sample, volume: u16) -> Result<(), AudioError> {
        self.device.play_native(sample.system(), volume, 0, is_pal_system())?
        return Result::Ok(())
    }

    /// Stops the active operation on `Device`.
    ///
    /// # Returns
    /// `Result::Ok(())` on success; the error value explains why the operation could not complete.
    pub fn stop(&var self) -> Result<(), AudioError> {
        self.device.stop()?
        return Result::Ok(())
    }

    /// Resumes the paused operation on `Device`.
    ///
    /// # Returns
    /// `Result::Ok(())` on success; the error value explains why the operation could not complete.
    pub fn resume(&var self) -> Result<(), AudioError> {
        self.device.start()?
        return Result::Ok(())
    }

    /// Borrows the system-level value wrapped by `Device`.
    ///
    /// # Returns
    /// A shared borrow of `SystemDevice` tied to the receiver.
    pub fn system(&self) -> &SystemDevice { return &self.device }
    /// Wraps an owned system-level value as `Device`.
    ///
    /// # Parameters
    /// * `device` - The device; ownership transfers to this call.
    ///
    /// # Returns
    /// The resulting `Device` value.
    ///
    /// # Ownership
    /// Arguments marked `consuming` transfer ownership to this call.
    pub fn from_system(consuming device: SystemDevice) -> Device { return ApplicationAudioDevice { device: device } }
    /// Consumes `Device` and returns its system-level value.
    ///
    /// # Returns
    /// The resulting `SystemDevice` value.
    ///
    /// # Ownership
    /// Arguments marked `consuming` transfer ownership to this call.
    pub fn into_system(consuming self) -> SystemDevice { return self.device }
}

/// High-level audio device.
pub type Device = ApplicationAudioDevice
