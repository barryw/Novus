    /// * `bounds` - The `Bounds` value used as bounds.
    /// * `value` - The `Str` value used as value.
    /// * `max_chars` - The `u16` value used as max chars.
    ///
    /// # Returns
    /// `Result::Ok(())` on success; the error value explains why the operation could not complete.
    pub fn add_string(&var self, id: u16, label: Str, bounds: Bounds, value: Str, max_chars: u16) -> Result<(), UiError> {
        self.system.add_string(id, label, bounds, value, max_chars)?
        return Result::Ok(())
    }

    /// Adds text for `ApplicationWindowBuilder`.
    ///
    /// # Parameters
    /// * `id` - The `u16` value used as id.
    /// * `bounds` - The `Bounds` value used as bounds.
    /// * `text` - The `Str` value used as text.
    ///
    /// # Returns
    /// `Result::Ok(())` on success; the error value explains why the operation could not complete.
    pub fn add_text(&var self, id: u16, bounds: Bounds, text: Str) -> Result<(), UiError> {
        self.system.add_text(id, bounds, text)?
        return Result::Ok(())
    }

    /// Builds the configured `ApplicationWindowBuilder` value.
    ///
    /// # Parameters
    /// * `title` - The title to use.
    /// * `bounds` - The `Bounds` value used as bounds.
    /// * `menu` - The menu; ownership transfers to this call.
    ///
    /// # Returns
    /// The requested value on success; the error value explains why the operation could not complete.
    ///
    /// # Ownership
    /// Arguments marked `consuming` transfer ownership to this call.
    pub fn build(&var self, title: Str, bounds: Bounds, consuming menu: ApplicationMenuStrip) -> Result<ApplicationWindow, UiError> {
        return Result::Ok(ApplicationWindow { system: self.system.build(title, bounds, menu.system)? })
    }

    /// Borrows the system-level value wrapped by `ApplicationWindowBuilder`.
    ///
    /// # Returns
    /// A shared borrow of `GadToolsBuilder` tied to the receiver.
    pub fn system(&self) -> &GadToolsBuilder { return &self.system }
}

/// Owning application requester with a Tier-1 error contract.
pub struct ApplicationFileRequester { system: FileRequesterHandle }

impl ApplicationFileRequester {
    /// Creates a new `ApplicationFileRequester` value.
    ///
    /// # Returns
    /// The requested value on success; the error value explains why the operation could not complete.
    pub fn new() -> Result<ApplicationFileRequester, UiError> {
        return Result::Ok(ApplicationFileRequester { system: FileRequesterHandle::new()? })
    }

    /// Chooses for for `ApplicationFileRequester`.
    ///
    /// # Parameters
    /// * `parent` - The `&ApplicationWindow` value used as parent.
    /// * `title` - The title to use.
    /// * `initial_drawer` - The `Str` value used as initial drawer.
    /// * `initial_file` - The `Str` value used as initial file.
    /// * `save` - The `bool` value used as save.
    ///
    /// # Returns
    /// The requested value on success; the error value explains why the operation could not complete.
    pub fn choose_for(&self,
        parent: &ApplicationWindow,
        title: Str,
        initial_drawer: Str,
        initial_file: Str,
        save: bool
    ) -> Result<Option<PathString>, UiError> {
        return Result::Ok(self.system.choose(parent.system.as_raw(), title, initial_drawer, initial_file, save)?)
    }

    /// Borrows the system-level value wrapped by `ApplicationFileRequester`.
    ///
    /// # Returns
    /// A shared borrow of `FileRequesterHandle` tied to the receiver.
    pub fn system(&self) -> &FileRequesterHandle { return &self.system }
}

/// Owning application screen with a deliberately small public surface.
pub struct ApplicationScreen { system: ScreenHandle }

impl ApplicationScreen {
    /// Computes lores for `ApplicationScreen` from the supplied inputs.
    ///
    /// # Parameters
    /// * `title` - The title to use.
    /// * `depth` - The `i16` value used as depth.
    ///
    /// # Returns
    /// The requested value on success; the error value explains why the operation could not complete.
    pub fn lores(title: Str, depth: i16) -> Result<ApplicationScreen, UiError> {
        return Result::Ok(ApplicationScreen { system: ScreenHandle::lores(title, depth)? })
    }

    /// Computes hires for `ApplicationScreen` from the supplied inputs.
    ///
    /// # Parameters
    /// * `title` - The title to use.
    /// * `depth` - The `i16` value used as depth.
    ///
    /// # Returns
    /// The requested value on success; the error value explains why the operation could not complete.
    pub fn hires(title: Str, depth: i16) -> Result<ApplicationScreen, UiError> {
        return Result::Ok(ApplicationScreen { system: ScreenHandle::hires(title, depth)? })
    }

    /// Computes custom for `ApplicationScreen` from the supplied inputs.
    ///
    /// # Parameters
    /// * `title` - The title to use.
    /// * `width` - The `i16` value used as width.
    /// * `height` - The `i16` value used as height.
    /// * `depth` - The `i16` value used as depth.
    ///
    /// # Returns
    /// The requested value on success; the error value explains why the operation could not complete.
    pub fn custom(title: Str, width: i16, height: i16, depth: i16) -> Result<ApplicationScreen, UiError> {
        return Result::Ok(ApplicationScreen { system: ScreenHandle::custom(title, width, height, depth)? })
    }

    /// Returns the width value associated with `ApplicationScreen`.
    ///
    /// # Returns
    /// The resulting `i16` value.
    pub fn width(&self) -> i16 { return self.system.width() }
    /// Returns the height value associated with `ApplicationScreen`.
    ///
    /// # Returns
    /// The resulting `i16` value.
    pub fn height(&self) -> i16 { return self.system.height() }
    /// Converts `ApplicationScreen` to front.
    pub fn to_front(&self) { self.system.to_front() }
    /// Converts `ApplicationScreen` to back.
    pub fn to_back(&self) { self.system.to_back() }
    /// Moves `ApplicationScreen` by a relative offset.
    ///
    /// # Parameters
    /// * `dx` - The `i16` value used as dx.
    /// * `dy` - The `i16` value used as dy.
    pub fn move_by(&self, dx: i16, dy: i16) { self.system.move_by(dx, dy) }
    /// Shows title for `ApplicationScreen`.
    ///
    /// # Parameters
    /// * `show` - The `bool` value used as show.
    pub fn show_title(&self, show: bool) { self.system.show_title(show) }
    /// Borrows the system-level value wrapped by `ApplicationScreen`.
    ///
    /// # Returns
    /// A shared borrow of `ScreenHandle` tied to the receiver.
    pub fn system(&self) -> &ScreenHandle { return &self.system }
}

// Canonical Tier-1 names alias only controlled application wrappers, never
// systems-layer owners. Unique implementation names avoid transitive NDK name
// collisions while Novus module identity is still being made fully qualified.
/// Aliases `Event` to `ApplicationEvent`.
pub type Event = ApplicationEvent
/// Aliases `MenuBuilder` to `ApplicationMenuBuilder`.
pub type MenuBuilder = ApplicationMenuBuilder
/// Aliases `Menu` to `ApplicationMenu`.
pub type Menu = ApplicationMenu
/// Aliases `MenuItem` to `ApplicationMenuItem`.
pub type MenuItem = ApplicationMenuItem
/// Aliases `MenuStrip` to `ApplicationMenuStrip`.
pub type MenuStrip = ApplicationMenuStrip
/// Aliases `Control` to `ApplicationControl`.
pub type Control = ApplicationControl
/// Aliases `Cycle` to `ApplicationCycle`.
pub type Cycle = ApplicationCycle
/// Aliases `ListView` to `ApplicationListView`.
pub type ListView = ApplicationListView
/// Aliases `Checkbox` to `ApplicationCheckbox`.
pub type Checkbox = ApplicationCheckbox
/// Aliases `TextInput` to `ApplicationTextInput`.
pub type TextInput = ApplicationTextInput
/// Aliases `IntegerInput` to `ApplicationIntegerInput`.
pub type IntegerInput = ApplicationIntegerInput
/// Aliases `Text` to `ApplicationText`.
pub type Text = ApplicationText
/// Aliases `Window` to `ApplicationWindow`.
pub type Window = ApplicationWindow
/// Aliases `WindowBuilder` to `ApplicationWindowBuilder`.
pub type WindowBuilder = ApplicationWindowBuilder
/// Aliases `FileRequester` to `ApplicationFileRequester`.
pub type FileRequester = ApplicationFileRequester
/// Aliases `Screen` to `ApplicationScreen`.
pub type Screen = ApplicationScreen
