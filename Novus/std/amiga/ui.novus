        return ApplicationMenuItem { system: self.system.add_item(label) }
    }

    /// Adds separator for `ApplicationMenu`.
    pub fn add_separator(&var self) { self.system.add_separator() }

    /// Borrows the system-level value wrapped by `ApplicationMenu`.
    ///
    /// # Returns
    /// A shared borrow of `MenuHandle` tied to the receiver.
    pub fn system(&self) -> &MenuHandle { return &self.system }
}

impl ApplicationMenuItem {
