/// Controlled application window over one owning systems-layer window.
pub struct ApplicationWindow { system: GadToolsWindow }

impl ApplicationWindow {
    /// Borrows the system-level value wrapped by `ApplicationWindow`.
    ///
    /// # Returns
    /// A shared borrow of `GadToolsWindow` tied to the receiver.
    pub fn system(&self) -> &GadToolsWindow { return &self.system }

    /// Returns the child builder value associated with `ApplicationWindow`.
    ///
    /// # Returns
    /// The requested value on success; the error value explains why the operation could not complete.
    pub fn child_builder(&self) -> Result<ApplicationWindowBuilder, UiError> {
        return Result::Ok(ApplicationWindowBuilder { system: self.system.child_builder()? })
    }

    /// Displays an alert using `ApplicationWindow`.
    ///
    /// # Parameters
    /// * `title` - The title to use.
    /// * `message` - The `Str` value used as message.
    pub fn alert(&self, title: Str, message: Str) {
        alert_on(self.system.as_raw(), title.as_cstr(), message.as_cstr())
    }

    /// Applies alert error to `ApplicationWindow`.
    ///
    /// # Ownership
    /// Arguments marked `consuming` transfer ownership to this call.
    pub fn alert_error<E>(&self, title: Str, consuming error: E) where E: Error {
        match unsafe { Str::from_cstr(error.message()) } {
            Option::Some(message) => self.alert(title, message),
            Option::None => self.alert(title, ""),
        }
    }

    /// Displays a confirmation request using `ApplicationWindow`.
    ///
    /// # Parameters
    /// * `title` - The title to use.
    /// * `message` - The `Str` value used as message.
    ///
    /// # Returns
    /// `true` when the stated condition holds; otherwise `false`.
    pub fn confirm(&self, title: Str, message: Str) -> bool {
        return confirm_on(self.system.as_raw(), title.as_cstr(), message.as_cstr())
    }

    /// Displays a choice request using `ApplicationWindow`.
    ///
    /// # Parameters
    /// * `title` - The title to use.
    /// * `message` - The `Str` value used as message.
    /// * `buttons` - The `Str` value used as buttons.
    ///
    /// # Returns
    /// The resulting `i32` value.
    pub fn choice(&self, title: Str, message: Str, buttons: Str) -> i32 {
        return choice_on(self.system.as_raw(), title.as_cstr(), message.as_cstr(), buttons.as_cstr())
    }

    /// Fills rect for `ApplicationWindow`.
    ///
    /// # Parameters
    /// * `pen` - The `u8` value used as pen.
    /// * `left` - The `i16` value used as left.
    /// * `top` - The `i16` value used as top.
    /// * `right` - The `i16` value used as right.
    /// * `bottom` - The `i16` value used as bottom.
    pub fn fill_rect(&self, pen: u8, left: i16, top: i16, right: i16, bottom: i16) {
        self.system.fill_rect(pen, left, top, right, bottom)
    }

    /// Outlines rect for `ApplicationWindow`.
    ///
    /// # Parameters
    /// * `pen` - The `u8` value used as pen.
    /// * `left` - The `i16` value used as left.
    /// * `top` - The `i16` value used as top.
    /// * `right` - The `i16` value used as right.
    /// * `bottom` - The `i16` value used as bottom.
    pub fn outline_rect(&self, pen: u8, left: i16, top: i16, right: i16, bottom: i16) {
        self.system.outline_rect(pen, left, top, right, bottom)
    }

    /// Sets menu enabled for `ApplicationWindow`.
    ///
    /// # Parameters
    /// * `menu` - The `u16` value used as menu.
    /// * `item` - The `u16` value used as item.
    /// * `enabled` - The `bool` value used as enabled.
    pub fn set_menu_enabled(&self, menu: u16, item: u16, enabled: bool) {
        self.system.set_menu_enabled(menu, item, enabled)
    }

    /// Returns a generic control view owned by `ApplicationWindow`.
    ///
    /// # Parameters
    /// * `id` - The `u16` value used as id.
    ///
    /// # Returns
    /// The requested value, or `Option::None` when it is unavailable.
    pub fn control(&self, id: u16) -> Option<ApplicationControl> {
        let Option::Some(system) = self.system.control(id) else { return Option::None }
        return Option::Some(ApplicationControl { system: system })
    }

    /// Returns a cycle control view owned by `ApplicationWindow`.
    ///
    /// # Parameters
    /// * `id` - The `u16` value used as id.
    ///
    /// # Returns
    /// The requested value, or `Option::None` when it is unavailable.
    pub fn cycle(&self, id: u16) -> Option<ApplicationCycle> {
        let Option::Some(system) = self.system.cycle(id) else { return Option::None }
        return Option::Some(ApplicationCycle { system: system })
    }

    /// Returns a list-view control owned by `ApplicationWindow`.
    ///
    /// # Parameters
    /// * `id` - The `u16` value used as id.
    ///
    /// # Returns
    /// The requested value, or `Option::None` when it is unavailable.
    pub fn list_view(&self, id: u16) -> Option<ApplicationListView> {
        let Option::Some(system) = self.system.list_view(id) else { return Option::None }
        return Option::Some(ApplicationListView { system: system })
    }

    /// Returns a checkbox control owned by `ApplicationWindow`.
    ///
    /// # Parameters
    /// * `id` - The `u16` value used as id.
    ///
    /// # Returns
    /// The requested value, or `Option::None` when it is unavailable.
    pub fn checkbox(&self, id: u16) -> Option<ApplicationCheckbox> {
        let Option::Some(system) = self.system.checkbox(id) else { return Option::None }
        return Option::Some(ApplicationCheckbox { system: system })
    }

    /// Returns a string control owned by `ApplicationWindow`.
    ///
    /// # Parameters
    /// * `id` - The `u16` value used as id.
    ///
    /// # Returns
    /// The requested value, or `Option::None` when it is unavailable.
    pub fn string(&self, id: u16) -> Option<ApplicationTextInput> {
        let Option::Some(system) = self.system.string(id) else { return Option::None }
        return Option::Some(ApplicationTextInput { system: system })
    }

    /// Returns an integer control owned by `ApplicationWindow`.
    ///
    /// # Parameters
    /// * `id` - The `u16` value used as id.
    ///
    /// # Returns
    /// The requested value, or `Option::None` when it is unavailable.
    pub fn integer(&self, id: u16) -> Option<ApplicationIntegerInput> {
        let Option::Some(system) = self.system.integer(id) else { return Option::None }
        return Option::Some(ApplicationIntegerInput { system: system })
    }

    /// Returns a text control owned by `ApplicationWindow`.
    ///
    /// # Parameters
    /// * `id` - The `u16` value used as id.
    ///
    /// # Returns
    /// The requested value, or `Option::None` when it is unavailable.
    pub fn text(&self, id: u16) -> Option<ApplicationText> {
        let Option::Some(system) = self.system.text(id) else { return Option::None }
        return Option::Some(ApplicationText { system: system })
    }

    /// Replaces cycle for `ApplicationWindow`.
    ///
    /// # Parameters
    /// * `id` - The `u16` value used as id.
    /// * `choices` - The `Slice<Str>` value used as choices.
    /// * `active` - The `u16` value used as active.
    ///
    /// # Returns
    /// `Result::Ok(())` on success; the error value explains why the operation could not complete.
    pub fn replace_cycle(&var self, id: u16, choices: Slice<Str>, active: u16) -> Result<(), UiError> {
        self.system.replace_cycle(id, choices, active)?
        return Result::Ok(())
    }

    /// Replaces list for `ApplicationWindow`.
    ///
    /// # Parameters
    /// * `id` - The `u16` value used as id.
    /// * `rows` - The `Slice<Str>` value used as rows.
    /// * `selected` - The `Option<usize>` value used as selected.
    ///
    /// # Returns
    /// `Result::Ok(())` on success; the error value explains why the operation could not complete.
    pub fn replace_list(&var self, id: u16, rows: Slice<Str>, selected: Option<usize>) -> Result<(), UiError> {
        self.system.replace_list(id, rows, selected)?
        return Result::Ok(())
    }

    /// Waits for event for `ApplicationWindow`.
    ///
    /// # Returns
    /// The resulting `ApplicationEvent` value.
    pub fn wait_event(&self) -> ApplicationEvent { return application_event(self.system.wait_event()) }
    /// Refreshes the visible contents of `ApplicationWindow`.
    pub fn refresh(&self) { self.system.refresh() }
}

