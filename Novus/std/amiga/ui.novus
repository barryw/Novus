from amiga::sys::intuition::errors import IntuitionError

// Tier 1: application windows, controls, dialogs, screens, and requesters.
pub use amiga::ui::dialog::*

// These are application configuration/value types; unlike owning handles they
// do not expose resource-management mechanics by being aliases.
/// Aliases `Bounds` to `GadgetBounds`.
pub type Bounds = GadgetBounds
/// Aliases `StaticControl` to `StaticGadget`.
pub type StaticControl = StaticGadget
/// Aliases `StaticUi` to `StaticGadToolsUi`.
pub type StaticUi = StaticGadToolsUi
/// Aliases `StaticMenu` to `StaticMenuEntry`.
pub type StaticMenu = StaticMenuEntry

/// Reports failures from ui operations.
pub enum UiError {
    /// Indicates window failed.
    WindowFailed,
    /// Indicates screen failed.
    ScreenFailed,
    /// Indicates control failed.
    ControlFailed,
    /// Indicates menu failed.
    MenuFailed,
    /// Indicates requester failed.
    RequesterFailed,
}

impl From<IntuitionError> for UiError {
    fn convert(consuming error: IntuitionError) -> UiError {
        return match error {
            IntuitionError::ScreenOpenFailed | IntuitionError::InvalidScreen | IntuitionError::BadDisplayMode => UiError::ScreenFailed,
            IntuitionError::GadgetCreateFailed => UiError::ControlFailed,
            IntuitionError::MenuCreateFailed => UiError::MenuFailed,
            _ => UiError::WindowFailed,
        }
    }
}

impl From<AslError> for UiError {
    fn convert(consuming _error: AslError) -> UiError { return UiError::RequesterFailed }
}

impl UiError {
    /// Returns a human-readable description of this error.
    ///
    /// # Returns
    /// The resulting `*u8` value.
    pub fn message(&self) -> *u8 {
        return match self {
            UiError::WindowFailed => "Could not open or manage the window",
            UiError::ScreenFailed => "Could not open or manage the screen",
            UiError::ControlFailed => "Could not create or update a control",
            UiError::MenuFailed => "Could not create the menu",
            UiError::RequesterFailed => "Could not open the requester",
        }
    }
}

impl Error for UiError {
    fn message(&self) -> *u8 { return UiError::message(self) }
}

/// Stable application events independent of the underlying UI toolkit.
pub enum ApplicationEvent {
    /// Indicates close.
    Close,
    /// Indicates refresh.
    Refresh,
    /// Indicates menu pick.
    MenuPick(u16, u16),
    /// Indicates menu sub pick.
    MenuSubPick(u16, u16, u16),
    /// Indicates gadget up.
    GadgetUp(u16, u16),
    /// Indicates gadget down.
    GadgetDown(u16, u16),
    /// Indicates mouse button.
    MouseButton(i16, i16, bool),
    /// Indicates unknown.
    Unknown(u32),
}

fn application_event(consuming event: GadToolsEvent) -> ApplicationEvent {
    return match event {
        GadToolsEvent::Close => ApplicationEvent::Close,
        GadToolsEvent::Refresh => ApplicationEvent::Refresh,
        GadToolsEvent::MenuPick(menu, item) => ApplicationEvent::MenuPick(menu, item),
        GadToolsEvent::MenuSubPick(menu, item, sub) => ApplicationEvent::MenuSubPick(menu, item, sub),
        GadToolsEvent::GadgetUp(id, code) => ApplicationEvent::GadgetUp(id, code),
        GadToolsEvent::GadgetDown(id, code) => ApplicationEvent::GadgetDown(id, code),
        GadToolsEvent::MouseButton(x, y, pressed) => ApplicationEvent::MouseButton(x, y, pressed),
        GadToolsEvent::Unknown(class) => ApplicationEvent::Unknown(class),
    }
}

/// Application-level menu construction. Native arrays remain in Tier 2.
pub struct ApplicationMenuBuilder { system: GadToolsMenuBuilder }
/// Represents a application menu value.
pub struct ApplicationMenu { system: MenuHandle }
/// Represents a application menu item value.
pub struct ApplicationMenuItem { system: MenuItemHandle }
/// Represents a application menu strip value.
pub struct ApplicationMenuStrip { system: GadToolsMenuStrip }

impl ApplicationMenuBuilder {
    /// Adds menu for `ApplicationMenuBuilder`.
    ///
    /// # Parameters
    /// * `title` - The title to use.
    ///
    /// # Returns
    /// The resulting `ApplicationMenu` value.
    pub fn add_menu(&var self, title: Str) -> ApplicationMenu {
        return ApplicationMenu { system: self.system.add_menu(title) }
    }

    /// Builds the configured `ApplicationMenuBuilder` value.
    ///
    /// # Returns
    /// The requested value on success; the error value explains why the operation could not complete.
    pub fn build(&var self) -> Result<ApplicationMenuStrip, UiError> {
        return Result::Ok(ApplicationMenuStrip { system: self.system.build()? })
    }

    /// Borrows the system-level value wrapped by `ApplicationMenuBuilder`.
    ///
    /// # Returns
    /// A shared borrow of `GadToolsMenuBuilder` tied to the receiver.
    pub fn system(&self) -> &GadToolsMenuBuilder { return &self.system }
}

impl ApplicationMenu {
    /// Adds item for `ApplicationMenu`.
