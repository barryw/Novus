// system.novus - System hardware detection
// Namespace: std::system
// Provides enums and variables for runtime hardware detection on Amiga

from std::fmt import Display, Formatter

// CPU types detected via ExecBase->AttnFlags
pub enum SystemCPU {
    M68000,    // 68000 (7.14 MHz on A500/A1000/A2000)
    M68010,    // 68010 (rare)
    M68020,    // 68020 (14 MHz on A1200/A3000)
    M68030,    // 68030 (25-50 MHz on accelerators)
    M68040,    // 68040 (25-40 MHz on A4000/accelerators)
    M68060,    // 68060 (50-75 MHz on accelerators)
}

// FPU types detected via ExecBase->AttnFlags
pub enum SystemFPU {
    None,      // No FPU present
    M68881,    // 68881 coprocessor (separate chip)
    M68882,    // 68882 coprocessor (separate chip)
    M68040,    // 68040 internal FPU
    M68060,    // 68060 internal FPU
}

// Chipset types detected via GfxBase->ChipRevBits0
pub enum SystemChipset {
    OCS,       // Original Chip Set (A500/A1000/A2000)
    ECS,       // Enhanced Chip Set (A500+/A600/A2000)
    AGA,       // Advanced Graphics Architecture (A1200/A4000/CD32)
}

// Runtime hardware detection functions
// These call into the Novus runtime which detects hardware at startup
extern fn __detect_cpu() -> SystemCPU
extern fn __detect_fpu() -> SystemFPU
extern fn __detect_chipset() -> SystemChipset

// Global variables set during startup by the runtime
// These are initialized before main() is called
// Values are set by the runtime's __detect_cpu routine
// TODO: Currently using functions instead of vars until extern var support is complete
pub fn get_cpu() -> SystemCPU {
    return __detect_cpu()
}

pub fn get_fpu() -> SystemFPU {
    return __detect_fpu()
}

pub fn get_chipset() -> SystemChipset {
    return __detect_chipset()
}

// Display trait implementations for hardware enums
// TODO: These are temporarily disabled until match expressions support enum dereferencing
// For now, use conditional logic instead of match
impl Display for SystemCPU {
    fn fmt(&self, f: &mut Formatter) -> bool {
        if *self == SystemCPU::M68000 {
            return f.write_str("68000")
        } else if *self == SystemCPU::M68010 {
            return f.write_str("68010")
        } else if *self == SystemCPU::M68020 {
            return f.write_str("68020")
        } else if *self == SystemCPU::M68030 {
            return f.write_str("68030")
        } else if *self == SystemCPU::M68040 {
            return f.write_str("68040")
        } else {
            return f.write_str("68060")
        }
    }
}

impl Display for SystemFPU {
    fn fmt(&self, f: &mut Formatter) -> bool {
        if *self == SystemFPU::None {
            return f.write_str("None")
        } else if *self == SystemFPU::M68881 {
            return f.write_str("68881")
        } else if *self == SystemFPU::M68882 {
            return f.write_str("68882")
        } else if *self == SystemFPU::M68040 {
            return f.write_str("68040 FPU")
        } else {
            return f.write_str("68060 FPU")
        }
    }
}

impl Display for SystemChipset {
    fn fmt(&self, f: &mut Formatter) -> bool {
        if *self == SystemChipset::OCS {
            return f.write_str("OCS")
        } else if *self == SystemChipset::ECS {
            return f.write_str("ECS")
        } else {
            return f.write_str("AGA")
        }
    }
}
