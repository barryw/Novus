// io.novus - High-level I/O wrapper for Amiga DOS
// Automatic length calculation - no more manual counting!

from dos import Output, Write
from strings import strlen

// Write to stdout - automatic length calculation
// Returns bytes written, or negative error code
pub fn WriteOut(message: i32) -> i32 {
    let stdout = Output()
    if stdout == 0 {
        return -1
    }
    let len = strlen(message)
    return Write(stdout, message, len)
}

// Write to stderr - automatic length calculation
// Falls back to stdout if stderr unavailable
// Returns bytes written, or negative error code
pub fn WriteErr(message: i32) -> i32 {
    // Note: Error() causes hangs on some systems, using Output() for now
    let stdout = Output()
    if stdout == 0 {
        return -1
    }
    let len = strlen(message)
    return Write(stdout, message, len)
}
