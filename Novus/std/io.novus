// io.novus - High-level I/O for Amiga DOS
// Namespace: std::io

// Printf-style formatted output using RawDoFmt
// Format string uses AmigaOS RawDoFmt syntax:
//   %d   - signed decimal (16-bit word)
//   %ld  - signed decimal (32-bit long)
//   %u   - unsigned decimal (16-bit word)
//   %lu  - unsigned decimal (32-bit long)
//   %x   - hexadecimal (lowercase)
//   %X   - hexadecimal (uppercase)
//   %s   - null-terminated string
//   %c   - character
//   %b   - BSTR (BPTR to byte-counted string)
//
// Note: All numeric args are passed as 32-bit values on the stack,
// so use 'l' prefix for proper formatting (e.g., "%ld" not "%d")
//
// Implemented in novus_io.c runtime library
extern fn write(format: *u8, ...args) -> i32
