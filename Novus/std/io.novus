// io.novus - High-level I/O wrapper for Amiga DOS
// Provides convenient functions for writing to stdout/stderr without manual length tracking
//
// NOTE: This module currently requires manual length tracking due to
// limitations in pointer dereferencing. Use the manual Write() functions
// from dos module until proper string support is added.

from dos import Output, Error, Write
from core import Result

