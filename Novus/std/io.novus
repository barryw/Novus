// io.novus - High-level I/O wrapper for Amiga DOS
// Accepts String type - length is already known, no strlen() needed!

from dos import Output, Write

// Write to stdout - String provides both pointer and length
// Returns bytes written, or negative error code
pub fn WriteOut(message: String) -> i32 {
    let stdout = Output()
    if stdout == 0 {
        return -1
    }
    // String is {ptr: *u8, len: i32}
    // When passed to Write (which expects i32), compiler auto-extracts .ptr
    // We access .len explicitly here
    return Write(stdout, message, message.len)
}

// Write to stderr - String provides both pointer and length
// Falls back to stdout if stderr unavailable
// Returns bytes written, or negative error code
pub fn WriteErr(message: String) -> i32 {
    // Note: Error() causes hangs on some systems, using Output() for now
    let stdout = Output()
    if stdout == 0 {
        return -1
    }
    return Write(stdout, message, message.len)
}
