// io.novus - High-level I/O wrapper for Amiga DOS
// Provides convenient functions for writing to stdout/stderr without manual length tracking

from dos import Output, Error, Write
from core import Result

// Calculate the length of a null-terminated string
fn strlen(s: i32) -> i32 {
    var len = 0
    var ptr = s

    while *ptr != 0 {
        len = len + 1
        ptr = ptr + 1
    }

    return len
}

// Write a string to stdout
// Returns Result with bytes written or error code
pub fn WriteOut(message: i32) -> Result<i32, i32> {
    let stdout = Output()
    if stdout == 0 {
        return Result::Err(-1)
    }

    let len = strlen(message)
    let bytes_written = Write(stdout, message, len)

    if bytes_written < 0 {
        return Result::Err(bytes_written)
    }

    return Result::Ok(bytes_written)
}

// Write a string to stderr
// Returns Result with bytes written or error code
// Falls back to stdout if stderr is not available (e.g. in some emulators)
pub fn WriteErr(message: i32) -> Result<i32, i32> {
    var stderr = Error()

    // Fallback to stdout if Error() returns 0 (not all systems support stderr)
    if stderr == 0 {
        stderr = Output()
        if stderr == 0 {
            return Result::Err(-1)
        }
    }

    let len = strlen(message)
    let bytes_written = Write(stderr, message, len)

    if bytes_written < 0 {
        return Result::Err(bytes_written)
    }

    return Result::Ok(bytes_written)
}

// Write a string to stdout (convenience version that ignores the result)
pub fn print(message: i32) {
    let result = WriteOut(message)
}

// Write a string to stderr (convenience version that ignores the result)
pub fn eprint(message: i32) {
    let result = WriteErr(message)
}
