// io.novus - High-level I/O for Amiga DOS
// Namespace: std::io

from std::core import Result, Option, Vec
from std::ffi::dos import Output, Write
from std::error import DosError, dos_last_error

// Re-export DosError so callers don't need to import it separately
pub use std::error::DosError

// Write to stdout - returns Result for proper error handling
pub fn WriteOut(message: String) -> Result<i32, DosError> {
    let stdout = Output()
    if stdout == 0 {
        return Result::Err(DosError::InvalidInput)
    }

    // Pass string fields directly to Write (cast inline)
    let bytes = Write(stdout, (i32)(message.ptr), message.len)
    if bytes >= 0 {
        return Result::Ok(bytes)
    }

    let err = dos_last_error()
    return Result::Err(err)
}
