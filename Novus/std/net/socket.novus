// Novus Standard Library - Socket Library Management
// Namespace: std::net::socket
//
// Handles bsdsocket.library initialization with graceful failure.
// All networking functions require calling init() first.
//
// CRITICAL: Each Exec task must call init() before using networking.
// The library stores per-task data in the library base, so sharing
// between tasks is not possible.
//
// Example:
// ```novus
// from std::net::socket import SocketLibrary
//
// fn main() -> i32 {
//     // Try to initialize networking - returns Err if no TCP stack
//     let lib = match SocketLibrary::init() {
//         Result::Ok(l) => l,
//         Result::Err(e) => {
//             print("No TCP/IP stack installed: ")
//             println(e.message())
//             return 1
//         }
//     }
//
//     // Now networking is available...
//     // Library automatically cleaned up when lib goes out of scope
//     return 0
// }
// ```

from std::ffi::exec import OpenLibrary, CloseLibrary, Library
from std::net::errors import NetError
from std::ffi::bsdsocket import SetErrnoPtr, SocketBaseTags, SBTM_SETVAL, SBTC_ERRNOPTR, SocketBase
from std::ffi::bsdsocket import socket, CloseSocket, AF_INET, SOCK_STREAM
from std::core import Result

// Minimum required bsdsocket.library version
// Version 4 is provided by all major stacks (AmiTCP, Miami, Roadshow)
const BSDSOCKET_VERSION: u32 = 4

// Task-local errno storage for this task
// This is set per-task via SetErrnoPtr
// NOTE: This variable is accessed from std::net::errors for NetError::last()
//       It is exported as _net_task_errno to avoid name collisions
pub static var _net_task_errno: i32 = 0

/// Socket library handle with automatic cleanup
///
/// This type manages the per-task bsdsocket.library initialization.
/// When dropped, it properly cleans up the socket library resources.
pub struct SocketLibrary {
    base: *Library,
    initialized: bool,
}

impl SocketLibrary {
    /// Initialize the socket library for the current task
    ///
    /// This MUST be called before any networking operations.
    /// Returns Err if no TCP/IP stack is installed.
    ///
    /// Example:
    /// ```novus
    /// let socket_lib = SocketLibrary::init()?
    /// // Now you can use TCP, UDP, DNS, etc.
    /// ```
    pub fn init() -> Result<SocketLibrary, NetError> {
        // Try to open bsdsocket.library
        let base = unsafe { OpenLibrary("bsdsocket.library", BSDSOCKET_VERSION) }

        if !base {
            return Result::Err(NetError::NotInitialized)
        }

        // IMPORTANT: Set SocketBase TEMPORARILY so FFI functions work
        // This is needed because SetErrnoPtr uses the library base internally
        unsafe {
            SocketBase = base as *u8
        }

        // Set up per-task errno pointer
        // This is CRITICAL for multi-tasking - each task needs its own errno
        let errno_ptr: *i32 = (*i32)&_net_task_errno
        let result = unsafe { SetErrnoPtr(errno_ptr, 4) }

        if result != 0 {
            // Failed to set errno pointer - MUST clear SocketBase and close library
            unsafe { SocketBase = 0 as *u8 }
            unsafe { CloseLibrary(base) }
            return Result::Err(NetError::NotInitialized)
        }

        // SocketBase is already set and all initialization succeeded
        return Result::Ok(SocketLibrary {
            base: base,
            initialized: true
        })
    }

    /// Check if socket library is initialized for this task
    pub fn is_initialized(&self) -> bool {
        return self.initialized
    }

    /// Get the library base pointer (for advanced use)
    pub fn base(&self) -> *Library {
        return self.base
    }

    /// Get a reference to the per-task errno
    pub fn errno_ptr() -> *i32 {
        return (*i32)&_net_task_errno
    }
}

impl Drop for SocketLibrary {
    fn drop(&self) {
        if self.initialized && self.base as u32 != 0 {
            // Clear the global SocketBase
            unsafe {
                SocketBase = 0 as *u8
            }

            // Close the library
            unsafe {
                CloseLibrary(self.base)
            }
        }
    }
}

/// Ensure the socket library is initialized for the current task
///
/// This is called automatically by functions that need bsdsocket.library
/// (like inet_aton). If the library is already initialized (either via
/// SocketLibrary::init() or a previous ensure_initialized() call), this
/// is a no-op.
///
/// Returns true if the library is available, false if no TCP/IP stack.
pub fn ensure_initialized() -> bool {
    // Check if already initialized via SocketLibrary::init() or previous auto-init
    let current_base = unsafe { SocketBase }
    if current_base as u32 != 0 {
        return true
    }

    // Try to open bsdsocket.library
    let base = unsafe { OpenLibrary("bsdsocket.library", BSDSOCKET_VERSION) }

    if base as u32 == 0 {
        return false
    }

    // Set SocketBase so FFI functions work
    unsafe {
        SocketBase = base as *u8
    }

    // Set up per-task errno pointer
    let errno_ptr: *i32 = (*i32)&_net_task_errno
    let result = unsafe { SetErrnoPtr(errno_ptr, 4) }

    if result != 0 {
        // Failed to set errno pointer - cleanup
        unsafe { SocketBase = 0 as *u8 }
        unsafe { CloseLibrary(base) }
        return false
    }

    return true
}

/// Check if a TCP/IP stack is available without initializing
///
/// This is useful for optional networking features where you want
/// to check availability before attempting to use networking.
///
/// Example:
/// ```novus
/// if is_tcp_available() {
///     println("Networking available!")
/// } else {
///     println("No TCP/IP stack installed")
/// }
/// ```
pub fn is_tcp_available() -> bool {
    let base = unsafe { OpenLibrary("bsdsocket.library", BSDSOCKET_VERSION) }
    if (u32)base != 0 {
        unsafe { CloseLibrary(base) }
        return true
    }
    return false
}

/// Check if the TCP/IP stack is fully functional
///
/// This does more than just checking if bsdsocket.library exists:
/// it actually opens the library, sets up errno, and tries to create
/// a socket. This verifies the stack is properly running.
///
/// NOTE: This is more expensive than is_tcp_available() - only use it
/// when you need to verify the stack is actually working, not just installed.
///
/// IMPORTANT: This function temporarily modifies the global SocketBase.
/// Do NOT call this if you already have an active SocketLibrary instance
/// or from a multi-tasking context where other tasks may be using sockets.
/// For multi-tasking safety, use SocketLibrary::init() and handle the error.
///
/// Example:
/// ```novus
/// if is_tcp_functional() {
///     println("TCP/IP stack is working!")
/// } else {
///     println("TCP/IP stack not functional")
/// }
/// ```
pub fn is_tcp_functional() -> bool {
    // Check if SocketBase is already in use - if so, the stack is
    // already initialized and functional for this task
    let current_base = unsafe { SocketBase }
    if current_base as u32 != 0 {
        // Already initialized - assume functional
        // (If it wasn't, init() would have failed)
        return true
    }

    // Try to open the library
    let base = unsafe { OpenLibrary("bsdsocket.library", BSDSOCKET_VERSION) }
    if (u32)base == 0 {
        return false
    }

    // Set SocketBase for FFI calls
    // Safe because we checked it was 0 above
    unsafe { SocketBase = base as *u8 }

    // Set up errno pointer (required before any socket operations)
    var temp_errno: i32 = 0
    let errno_ptr: *i32 = (*i32)&temp_errno
    let errno_result = unsafe { SetErrnoPtr(errno_ptr, 4) }

    if errno_result != 0 {
        unsafe { SocketBase = 0 as *u8 }
        unsafe { CloseLibrary(base) }
        return false
    }

    // Try to create a socket - this tests if the stack is actually running
    let sock = unsafe { socket(AF_INET, SOCK_STREAM, 0) }
    let socket_works = sock >= 0

    // Clean up
    if sock >= 0 {
        unsafe { CloseSocket(sock) }
    }

    // Clear SocketBase since we're closing the library
    unsafe { SocketBase = 0 as *u8 }
    unsafe { CloseLibrary(base) }

    return socket_works
}

// Note: For TLS/SSL availability checking, use is_tls_available() from std::net::tls
// That function lives in the tls module where it semantically belongs.
