@library("graphics.library")
extern pub fn LockLayerRom(layer: *Layer)
/// Unlock Layer structure by ROM(gfx lib) code.
///
/// Release the lock on this layer. If the same task has called LockLayerRom
/// more than once than the same number of calls to UnlockLayerRom must happen
/// before the layer is actually freed so that other tasks may use it.
///
/// # Arguments
/// * `layer` - pointer to Layer structure
///
/// See also: LockLayerRom() layers.library/UnlockLayer() graphics/clip.h
@library("graphics.library")
extern pub fn UnlockLayerRom(layer: *Layer)
@library("graphics.library")
extern pub fn SyncSBitMap(layer: *Layer)
@library("graphics.library")
extern pub fn CopySBitMap(layer: *Layer)
