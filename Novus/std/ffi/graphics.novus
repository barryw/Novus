@library("graphics.library")
extern pub fn SetRGB4(vp: *ViewPort, index: i16, red: u8, green: u8, blue: u8)
/// Synchronize the blitter request with the video beam.
///
/// Call a user routine for use of the blitter, enqueued separately from the
/// QBlit queue. Calls the user routine contained in the blit structure when the
/// video beam is located at a specified position onscreen.
///
/// # Arguments
/// * `bsp` - pointer to a blit structure. See description in the Graphics
///   Support section of the manual for more info.
///
/// # Returns
/// User routine is called when the QBSBlit queue reaches this request AND
/// the video beam is in the specified position. If there are lots of blits
/// going on and the video beam has wrapped around back to the top it will
/// call all the remaining bltnodes as fast as it can to try and catch up.
///
/// See also: QBlit() hardware/blit.h
@library("graphics.library")
extern pub fn QBSBlit(blit: *bltnode)
/// Clear a block of memory words to zero.
///
/// For memory that is local and blitter accessible, the most efficient way to
/// clear a range of memory locations is to use the system's most efficient data
/// mover, the blitter. This command accepts the starting location and count and
/// clears that block to zeros.
///
/// # Arguments
/// * `bytecount` - if (flags & 2) == 0 then even number of bytes to clear.
///   else low 16 bits is taken as number of bytes per row and upper 16
///   bits taken as number of rows.
///
/// # Returns
/// The block of memory is initialized.
@library("graphics.library")
extern pub fn BltClear(memBlock: *u8, byteCount: u32, flags: u32)
