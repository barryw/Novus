///
/// # Returns
/// None
///
/// See also: ScreenToFront(), ScreenToBack(), SA_Parent, SA_FrontChild, SA_BackChild
@library("intuition.library")
extern pub fn ScreenDepth(screen: *Screen, flags: u32, reserved: *u8)
/// Move screens with greater control. (V39)
///
/// Moves the screen to the specified position or by the specified increment, in
/// screen pixel resolution coordinates. If the x1 and y1 variables you specify
/// would move the screen in a way that violates any restrictions, the screen
/// will be moved as far as possible.
///
/// # Arguments
///
/// # Returns
/// None
///
/// See also: MoveScreen(), RethinkDisplay()
@library("intuition.library")
extern pub fn ScreenPosition(screen: *Screen, flags: u32, x1: i32, y1: i32, x2: i32, y2: i32)
/// Intuition-friendly ScrollRasterBF() (V39)
///
/// Calls graphics.library/ScrollRasterBF(), which moves the bits in the raster
/// by (dx,dy) towards (0,0) The space vacated is filled by calling EraseRect().
/// NOTE: that vacated space is _not_ considered damage!
///
/// # Arguments
/// * `win` - pointer to a Window structure dx,dy are integers that may be
///   postive, zero, or negative xmin,ymin - upper left of bounding
///   rectangle xmax,ymax - lower right of bounding rectangle
///
/// See also: graphics.library/ScrollRaster(), graphics.library/ScrollRasterBF() graphics.library/EraseRect(), WA_BackFill
@library("intuition.library")
extern pub fn ScrollWindowRaster(win: *Window, dx: i16, dy: i16, xMin: i16, yMin: i16, xMax: i16, yMax: i16)
