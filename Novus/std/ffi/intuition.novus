pub const INTUITION_CLASSUSR_H: u32 = 1
pub const OM_Dummy: u32 = ($100)
pub const OM_NEW: u32 = ($101) // 'object' parameter is "true class"
pub const OM_DISPOSE: u32 = ($102) // delete self (no parameters)
pub const OM_SET: u32 = ($103) // set attributes (in tag list)
pub const OM_GET: u32 = ($104) // return single attribute value
pub const OM_ADDTAIL: u32 = ($105) // add self to a List (let root do it)
pub const OM_REMOVE: u32 = ($106) // remove self from list
pub const OM_NOTIFY: u32 = ($107) // send to self: notify dependents
pub const OM_UPDATE: u32 = ($108) // notification message from somebody
pub const OM_ADDMEMBER: u32 = ($109) // used by various classes with lists
pub const OM_REMMEMBER: u32 = ($10A) // used by various classes with lists
pub const OPUF_INTERIM: u32 = 1
pub const ICM_Dummy: u32 = ($0401) // used for nothing
pub const ICM_SETLOOP: u32 = ($0402) // set/increment loop counter
pub const ICM_CLEARLOOP: u32 = ($0403) // clear/decrement loop counter
pub const ICM_CHECKLOOP: u32 = ($0404) // set/increment loop
pub const EO_NOOP: u32 = ($0001)
pub const EO_DELBACKWARD: u32 = ($0002)
pub const EO_DELFORWARD: u32 = ($0003)
pub const EO_MOVECURSOR: u32 = ($0004)
pub const EO_ENTER: u32 = ($0005)
pub const EO_RESET: u32 = ($0006)
pub const EO_REPLACECHAR: u32 = ($0007)
pub const EO_INSERTCHAR: u32 = ($0008)
pub const EO_BADFORMAT: u32 = ($0009)
pub const EO_BIGCHANGE: u32 = ($000A) // unused by Intuition
pub const EO_UNDO: u32 = ($000B) // unused by Intuition
pub const EO_CLEAR: u32 = ($000C)
pub const EO_SPECIAL: u32 = ($000D) // unused by Intuition
pub const SGA_USE: u32 = ($1) // use contents of SGWork
pub const SGA_END: u32 = ($2) // terminate gadget, code in Code field
pub const SGA_BEEP: u32 = ($4) // flash the screen for the user
pub const SGA_REUSE: u32 = ($8) // reuse input event
pub const SGA_REDISPLAY: u32 = ($10) // gadget visuals changed
pub const SGA_NEXTACTIVE: u32 = ($20) // Make next possible gadget active.
pub const SGA_PREVACTIVE: u32 = ($40) // Make previous possible gadget active.
pub const SGH_KEY: u32 = (1) // process editing keystroke
pub const SGH_CLICK: u32 = (2) // process mouse click cursor position
