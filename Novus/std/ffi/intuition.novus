/// surrender the lock gotten by this call.
///
/// See also: UnlockIBase(), layers.library/LockLayerInfo(), exec.library/ObtainSemaphore()
@library("intuition.library")
extern pub fn LockIBase(dontknow: u32) -> u32
/// Surrender an Intuition lock gotten by LockIBase().
