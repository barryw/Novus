///
/// # Returns
/// None.
///
/// See also: NewObject(), SetAttrs(), GetAttr(), MakeClass(), Document "Basic Object-Oriented Programming System for Intuition" and the "boopsi Class Reference" document.
@library("intuition.library")
extern pub fn DisposeObject(consuming object: *u8)
/// Specify attribute values for an object. (V36)
///
