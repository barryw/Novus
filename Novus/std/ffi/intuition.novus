/// following exceptions: - You may change the CHECKED flag to turn a checkmark
/// on or off.
///
/// # Arguments
///
/// # Returns
/// TRUE always.
///
/// See also: SetMenuStrip(), ClearMenuStrip()
@library("intuition.library")
extern pub fn ResetMenuStrip(window: *Window, menu: *Menu) -> i16
