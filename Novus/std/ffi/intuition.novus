/// Surrenders lock gotten by LockIBase(). Calling this function when you do not
/// own the specified lock will immediately crash the system.
///
/// # Arguments
///
/// # Returns
/// None
///
/// See also: LockIBase()
@library("intuition.library")
extern pub fn UnlockIBase(ibLock: u32)
/// Get copy of a screen data structure.
