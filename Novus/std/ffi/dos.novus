extern pub fn FGets(fh: i32, buf: *u8, buflen: u32) -> *u8
/// Writes a string the the specified output (buffered) (V36)
///
/// This routine writes an unformatted string to the filehandle. No newline is
/// appended to the string.
///
/// # Arguments
/// * `fh` - filehandle to use for buffered I/O str - Null-terminated
///   string to be written to default output
///
/// # Returns
/// error - 0 normally, otherwise -1. Note that this is opposite of most
/// other Dos functions, which return success.
///
/// See also: FGets(), FPutC(), FWrite(), PutStr()
@library("dos.library")
extern pub fn FPuts(fh: i32, str: *u8) -> i32
/// Write a BCPL formatted string to a file (buffered) (V36)
///
/// Writes the formatted string and values to the specified file. This routine
/// is assumed to handle all internal buffering so that the formatting string
/// and resultant formatted values can be arbitrarily long.
///
/// # Arguments
/// * `fh` - filehandle to write to fmt - BCPL style formatting string argv
///   - Pointer to array of formatting values
///
/// # Returns
/// count - Number of bytes written or -1 for error
///
/// See also: VFPrintf(), VFPrintf(), FPutC()
@library("dos.library")
extern pub fn VFWritef(fh: i32, format: *u8, argarray: *u8)
@library("dos.library")
extern pub fn FWritef(fh: i32, format: *u8, ...args)
/// Format and print a string to a file (buffered) (V36)
///
/// Writes the formatted string and values to the given file. This routine is
/// assumed to handle all internal buffering so that the formatting string and
/// resultant formatted values can be arbitrarily long.
///
/// # Arguments
/// * `fh` - Filehandle to write to fmt - RawDoFmt() style formatting
///   string argv - Pointer to array of formatting values
///
/// # Returns
/// count - Number of bytes written or -1 (EOF) for an error
///
/// See also: VPrintf(), VFWritef(), RawDoFmt(), FPutC()
@library("dos.library")
extern pub fn VFPrintf(fh: i32, format: *u8, argarray: *u8) -> i32
@library("dos.library")
extern pub fn FPrintf(fh: i32, format: *u8, ...args) -> i32
/// Flushes buffers for a buffered filehandle (V36)
///
/// Flushes any pending buffered writes to the filehandle. All buffered writes
/// will also be flushed on Close().
///
/// # Arguments
///
/// # Returns
/// success - Success or failure.
///
/// See also: FputC(), FGetC(), UnGetC(), Seek(), Close()
@library("dos.library")
extern pub fn Flush(fh: i32) -> i32
/// Set buffering modes and size (V39)
///
/// Changes the buffering modes and buffer size for a filehandle. With buff ==
/// NULL, the current buffer will be deallocated and a new one of
/// (approximately) size will be allocated.
///
/// # Arguments
/// * `fh` - Filehandle buff - buffer pointer for buffered I/O or NULL.
///   MUST be LONG-aligned! type - buffering mode (see <dos/stdio.h>) size
///   - size of buffer for buffered I/O (sizes less than 208 bytes will be
///   rounded up to 208), or -1.
///
/// # Returns
/// error - 0 if successful. NOTE: opposite of most dos functions! NOTE:
/// fails if someone has replaced the buffer without using SetVBuf() -
/// RunCommand() does this. Remember to check error before freeing
/// user-supplied buffers!
///
/// See also: FputC(), FGetC(), UnGetC(), Flush(), FRead()
@library("dos.library")
extern pub fn SetVBuf(fh: i32, buff: *u8, _type: i32, size: i32) -> i32
/// Gets a lock on an open file (V36)
///
/// Obtain a lock on the object associated with fh. Only works if the file was
/// opened using a non-exclusive mode.
///
/// # Arguments
/// * `fh` - Opened file for which to obtain the lock
///
/// # Returns
/// lock - Obtained lock or NULL for failure
///
/// See also: DupLock(), Lock(), UnLock()
@library("dos.library")
extern pub fn DupLockFromFH(fh: i32) -> i32
/// Opens a file you have a lock on (V36)
///
/// Given a lock, this routine performs an open on that lock. If the open
/// succeeds, the lock is (effectively) relinquished, and should not be
/// UnLock()ed or used.
///
/// # Arguments
/// * `lock` - Lock on object to be opened.
///
/// # Returns
/// fh - Newly opened file handle or NULL for failure
///
/// See also: Open(), Close(), Lock(), UnLock()
@library("dos.library")
extern pub fn OpenFromLock(lock: i32) -> i32
/// Returns a lock on the parent directory of a file (V36)
///
/// Returns a shared lock on the parent directory of the filehandle.
///
/// # Arguments
/// * `fh` - Filehandle you want the parent of.
///
/// # Returns
/// lock - Lock on parent directory of the filehandle or NULL for failure.
///
/// See also: Parent(), Lock(), UnLock() DupLockFromFH()
@library("dos.library")
extern pub fn ParentOfFH(fh: i32) -> i32
/// Gets information on an open file (V36)
///
/// Examines a filehandle and returns information about the file in the
/// FileInfoBlock. There are no guarantees as to whether the fib_Size field will
/// reflect any changes made to the file size it was opened, though filesystems
/// should attempt to provide up-to-date information for it.
///
/// # Arguments
/// * `fh` - Filehandle you wish to examine fib - FileInfoBlock, must be
///   longword aligned.
///
/// # Returns
/// success - Success/failure indication
///
/// See also: Examine(), ExNext(), ExAll(), Open(), AllocDosObject()
@library("dos.library")
extern pub fn ExamineFH(fh: i32, fib: *FileInfoBlock) -> i16
/// Sets the modification date for a file or dir (V36)
///
/// Sets the file date for a file or directory. Note that for the Old File
/// System and the Fast File System, the date of the root directory cannot be
/// set.
///
/// # Arguments
/// * `name` - Name of object date - New modification date
///
/// # Returns
/// success - Success/failure indication
///
/// See also: DateStamp(), Examine(), ExNext(), ExAll()
@library("dos.library")
extern pub fn SetFileDate(name: *u8, date: *DateStamp) -> i32
/// Returns the name of a locked object (V36)
///
/// Returns a fully qualified path for the lock. This routine is guaranteed not
/// to write more than len characters into the buffer.
///
/// # Arguments
/// * `lock` - Lock of object to be examined. buffer - Buffer to store
///   name. len - Length of buffer.
///
/// # Returns
/// success - Success/failure indicator.
///
/// See also: NameFromFH(), Lock()
@library("dos.library")
extern pub fn NameFromLock(lock: i32, buffer: *u8, len: i32) -> i32
/// Get the name of an open filehandle (V36)
///
/// Returns a fully qualified path for the filehandle. This routine is
/// guaranteed not to write more than len characters into the buffer.
///
/// # Arguments
/// * `fh` - Lock of object to be examined. buffer - Buffer to store name.
///   len - Length of buffer.
///
/// # Returns
/// success - Success/failure indicator.
///
/// See also: NameFromLock(), ExamineFH()
@library("dos.library")
extern pub fn NameFromFH(fh: i32, buffer: *u8, len: i32) -> i32
/// Splits out a component of a pathname into a buffer (V36)
///
/// This routine splits out the next piece of a name from a given file name.
/// Each piece is copied into the buffer, truncating at size-1 characters.
///
/// # Arguments
/// * `name` - Filename being parsed. separator - Separator charactor to
///   split by. buf - Buffer to hold separated name. oldpos - Current
///   position in the file. size - Size of buf in bytes (including null
///   termination).
///
/// # Returns
/// newpos - New position for next call to splitname. -1 for last one.
///
/// See also: FilePart(), PathPart(), AddPart()
@library("dos.library")
extern pub fn SplitName(name: *u8, separator: u8, buf: *u8, oldpos: i16, size: i32) -> i16
/// Returns whether two locks are on the same object (V36)
///
/// Compares two locks. Returns LOCK_SAME if they are on the same object,
/// LOCK_SAME_VOLUME if on different objects on the same volume, and
/// LOCK_DIFFERENT if they are on different volumes.
///
/// # Arguments
/// * `lock1` - 1st lock for comparison lock2 - 2nd lock for comparison
///
/// # Returns
/// value - LOCK_SAME, LOCK_SAME_VOLUME, or LOCK_DIFFERENT
///
/// See also: <dos/dos.h>
@library("dos.library")
extern pub fn SameLock(lock1: i32, lock2: i32) -> i32
/// Set the current behavior of a handler (V36)
///
/// SetMode() sends an ACTION_SCREEN_MODE packet to the handler in question,
/// normally for changing a CON: handler to raw mode or vice-versa. For CON:,
/// use 1 to go to RAW: mode, 0 for CON: mode.
///
/// # Arguments
/// * `fh` - filehandle mode - The new mode you want
///
/// # Returns
/// success - Boolean
@library("dos.library")
extern pub fn SetMode(fh: i32, mode: i32) -> i32
/// Examine an entire directory (V36)
///
/// Examines an entire directory. Lock must be on a directory.
///
/// # Arguments
/// * `lock` - Lock on directory to be examined. buffer - Buffer for data
///   returned (MUST be at least word-aligned, preferably long-word
///   aligned). size - Size in bytes of 'buffer'. type - Type of data to be
///   returned. control - Control data structure (see notes above). MUST
///   have been allocated by AllocDosObject!
///
/// # Returns
/// continue - Whether or not ExAll is done. If FALSE is returned, either
/// ExAll has completed (IoErr() == ERROR_NO_MORE_ENTRIES), or an error
/// occurred (check IoErr()). If non-zero is returned, you MUST call ExAll
/// again until it returns FALSE.
///
/// See also: Examine(), ExNext(), ExamineFH(), MatchPatternNoCase(), ParsePatternNoCase()
@library("dos.library")
extern pub fn ExAll(lock: i32, buffer: *ExAllData, size: i32, data: i32, control: *ExAllControl) -> i32
/// Reads the path for a soft filesystem link (V36)
///
/// ReadLink() takes a lock/name pair (usually from a failed attempt to use them
/// to access an object with packets), and asks the filesystem to find the
/// softlink and fill buffer with the modified path string. You then start the
/// resolution process again by calling GetDeviceProc() with the new string from
/// ReadLink().
///
/// # Arguments
/// * `port` - msgport of the filesystem lock - lock this path is relative
///   to on the filesystem path - path that caused the ERROR_IS_SOFT_LINK
///   buffer - pointer to buffer for new path from handler. size - size of
///   buffer.
///
/// # Returns
/// Success - boolean
///
/// See also: MakeLink(), Open(), Lock(), GetDeviceProc()
@library("dos.library")
extern pub fn ReadLink(port: *MsgPort, lock: i32, path: *u8, buffer: *u8, size: u32) -> i32
/// Creates a filesystem link (V36)
///
/// Create a filesystem link from 'name' to dest. For "soft-links", dest is a
/// pointer to a null-terminated path string.
///
/// # Arguments
/// * `name` - Name of the link to create dest - CPTR to path string, or
///   BPTR lock soft - FALSE for hard-links, non-zero for soft-links
///
/// # Returns
/// Success - boolean
///
/// See also: ReadLink(), Open(), Lock()
@library("dos.library")
extern pub fn MakeLink(name: *u8, dest: i32, soft: i32) -> i32
/// Change the current mode of a lock or filehandle (V36)
///
/// This allows you to attempt to change the mode in use by a lock or
/// filehandle. For example, you could attempt to turn a shared lock into an
/// exclusive lock.
///
/// # Arguments
/// * `type` - Either CHANGE_FH or CHANGE_LOCK object - A lock or
///   filehandle newmode - The new mode you want
///
/// # Returns
/// success - Boolean
///
/// See also: Lock(), Open()
@library("dos.library")
extern pub fn ChangeMode(_type: i32, fh: i32, newmode: i32) -> i32
/// Sets the size of a file (V36)
///
/// Changes the file size, truncating or extending as needed. Not all handlers
/// may support this; be careful and check the return code.
///
/// # Arguments
/// * `fh` - File to be truncated/extended. offset - Offset from position
///   determined by mode. mode - One of OFFSET_BEGINNING, OFFSET_CURRENT,
///   or OFFSET_END.
///
/// # Returns
/// newsize - position of new end-of-file or -1 for error.
///
/// See also: Seek()
@library("dos.library")
extern pub fn SetFileSize(fh: i32, pos: i32, mode: i32) -> i32
/// Sets the value returned by IoErr() (V36)
///
/// This routine sets up the secondary result (pr_Result2) return code (returned
/// by the IoErr() function).
///
/// # Arguments
/// * `code` - Code to be returned by a call to IoErr.
///
/// # Returns
/// oldcode - The previous error code.
///
/// See also: IoErr(), Fault(), PrintFault()
@library("dos.library")
extern pub fn SetIoErr(result: i32) -> i32
/// Returns the text associated with a DOS error code (V36)
///
/// This routine obtains the error message text for the given error code. The
/// header is prepended to the text of the error message, followed by a colon.
///
/// # Arguments
/// * `code` - Error code header - header to output before error text
///   buffer - Buffer to receive error message. len - Length of the buffer.
///
/// # Returns
/// len - number of characters put into buffer (may be 0)
///
/// See also: IoErr(), SetIoErr(), PrintFault()
@library("dos.library")
extern pub fn Fault(code: i32, header: *u8, buffer: *u8, len: i32) -> i16
/// Returns the text associated with a DOS error code (V36)
///
/// This routine obtains the error message text for the given error code. This
/// is similar to the Fault() function, except that the output is written to the
/// default output channel with buffered output.
///
/// # Arguments
/// * `code` - Error code header - header to output before error text
///
/// # Returns
/// success - Success/failure code.
///
/// See also: IoErr(), Fault(), SetIoErr(), Output(), FPuts()
@library("dos.library")
extern pub fn PrintFault(code: i32, header: *u8) -> i16
/// Displays a Retry/Cancel requester for an error (V36)
///
/// Based on the request type, this routine formats the appropriate requester to
/// be displayed. If the code is not understood, it returns DOS_TRUE
/// immediately.
///
/// # Arguments
/// * `code` - Error code to put a requester up for. Current valid error
///   codes are: ERROR_DISK_NOT_VALIDATED ERROR_DISK_WRITE_PROTECTED
///   ERROR_DISK_FULL ERROR_DEVICE_NOT_MOUNTED ERROR_NOT_A_DOS_DISK
///   ERROR_NO_DISK ABORT_DISK_ERROR /* read/write error */ ABORT_BUSY /*
///   you MUST replace... */ type - Request type: REPORT_LOCK - arg1 is a
///   lock (BPTR). REPORT_FH - arg1 is a filehandle (BPTR). REPORT_VOLUME -
///   arg1 is a volumenode (C pointer). REPORT_INSERT - arg1 is the string
///   for the volumename (will be split on a ':'). With
///   ERROR_DEVICE_NOT_MOUNTED puts up the "Please insert..." requester.
///   arg1 - variable parameter (see type) device - (Optional) Address of
///   handler task for which report is to be made. Only required for
///   REPORT_LOCK, and only if arg1==NULL.
///
/// # Returns
/// status - Cancel/Retry indicator (0 means Retry)
///
/// See also: Fault(), IoErr()
@library("dos.library")
extern pub fn ErrorReport(code: i32, _type: i32, arg1: u32, device: *MsgPort) -> i32
/// Returns a pointer to the CLI structure of the process (V36)
///
/// Returns a pointer to the CLI structure of the current process, or NULL if
/// the process has no CLI structure.
///
/// # Returns
/// cli_ptr - pointer to the CLI structure, or NULL.
@library("dos.library")
extern pub fn Cli() -> *CommandLineInterface
/// Create a new process (V36)
///
/// This creates a new process according to the tags passed in. See
/// dos/dostags.h for the tags.
///
/// # Arguments
/// * `tags` - a pointer to a TagItem array.
///
/// # Returns
/// process - The created process, or NULL. Note that if it returns NULL,
/// you must free any items that were passed in via tags, such as if you
/// passed in a new current directory with NP_CurrentDir.
///
/// See also: LoadSeg(), CreateProc(), ReadArgs(), RunCommand(), <dos/dostags.h>
@library("dos.library")
extern pub fn CreateNewProc(tags: *TagItem) -> *u8  // Returns *Process, use *u8 to avoid struct gen issues
@library("dos.library")
extern pub fn CreateNewProcTags(tags: u32, ...args) -> *Process
/// Runs a program using the current process (V36)
///
/// Runs a command on your process/cli. Seglist may be any language, including
/// BCPL programs.
///
/// # Arguments
/// * `seglist` - Seglist of command to run. stacksize - Number of bytes to
///   allocate for stack space argptr - Pointer to argument command string.
///   argsize - Number of bytes in argument command.
///
/// # Returns
/// rc - Return code from executed command. -1 indicates failure
///
/// See also: CreateNewProc(), SystemTagList(), Execute(), GetArgStr(), SetProgramName()
@library("dos.library")
extern pub fn RunCommand(seg: i32, stack: i32, paramptr: *u8, paramlen: i32) -> i32
/// Returns the default console for the process (V36)
///
/// Returns the default console task's port (pr_ConsoleTask) for the current
/// process.
///
/// # Returns
/// port - The pr_MsgPort of the console handler, or NULL.
///
/// See also: SetConsoleTask(), Open()
@library("dos.library")
extern pub fn GetConsoleTask() -> *MsgPort
/// Sets the default console for the process (V36)
///
/// Sets the default console task's port (pr_ConsoleTask) for the current
/// process.
///
/// # Arguments
/// * `port` - The pr_MsgPort of the default console handler for the process
///
/// # Returns
/// oldport - The previous ConsoleTask value.
///
/// See also: GetConsoleTask(), Open()
@library("dos.library")
extern pub fn SetConsoleTask(task: *MsgPort) -> *MsgPort
/// Returns the default filesystem for the process (V36)
///
/// Returns the default filesystem task's port (pr_FileSystemTask) for the
/// current process.
///
/// # Returns
/// port - The pr_MsgPort of the filesystem, or NULL.
///
/// See also: SetFileSysTask(), Open()
@library("dos.library")
extern pub fn GetFileSysTask() -> *MsgPort
/// Sets the default filesystem for the process (V36)
///
/// Sets the default filesystem task's port (pr_FileSystemTask) for the current
/// process.
///
/// # Arguments
/// * `port` - The pr_MsgPort of the default filesystem for the process
///
/// # Returns
/// oldport - The previous FileSysTask value
///
/// See also: GetFileSysTask(), Open()
@library("dos.library")
extern pub fn SetFileSysTask(task: *MsgPort) -> *MsgPort
/// Returns the arguments for the process (V36)
///
/// Returns a pointer to the (null-terminated) arguments for the program
/// (process). This is the same string passed in a0 on startup from CLI.
///
/// # Returns
/// ptr - pointer to arguments
///
/// See also: SetArgStr(), RunCommand()
@library("dos.library")
extern pub fn GetArgStr() -> *u8
/// Sets the arguments for the current process (V36)
///
/// Sets the arguments for the current program. The ptr MUST be reset to it's
/// original value before process exit.
///
/// # Arguments
/// * `ptr` - pointer to new argument string.
///
/// # Returns
/// oldptr - the previous argument string
///
/// See also: GetArgStr(), RunCommand()
@library("dos.library")
extern pub fn SetArgStr(string: *u8) -> i16
/// Returns a pointer to the requested CLI process (V36)
///
/// This routine returns a pointer to the CLI process associated with the given
/// CLI number. If the process isn't an active CLI process, NULL is returned.
///
/// # Arguments
/// * `num` - Task number of CLI process (range 1-N)
///
/// # Returns
/// proc - Pointer to given CLI process
///
/// See also: Cli(), Forbid(), MaxCli()
@library("dos.library")
extern pub fn FindCliProc(num: u32) -> *Process
/// Returns the highest CLI process number possibly in use (V36)
///
/// Returns the highest CLI number that may be in use. CLI numbers are reused,
/// and are usually as small as possible.
///
/// # Returns
/// number - The highest CLI number that _may_ be in use.
///
/// See also: FindCliProc(), Cli()
@library("dos.library")
extern pub fn MaxCli() -> u32
/// Sets the directory name for the process (V36)
///
/// Sets the name for the current dir in the cli structure. If the name is too
/// long to fit, a failure is returned, and the old value is left intact.
///
/// # Arguments
/// * `name` - Name of directory to be set.
///
/// # Returns
/// success - Success/failure indicator
///
/// See also: GetCurrentDirName()
@library("dos.library")
extern pub fn SetCurrentDirName(name: *u8) -> i16
/// Returns the current directory name (V36)
///
/// Extracts the current directory name from the CLI structure and puts it into
/// the buffer. If the buffer is too small, the name is truncated appropriately
/// and a failure code returned.
///
/// # Arguments
/// * `buf` - Buffer to hold extracted name len - Number of bytes of space
///   in buffer
///
/// # Returns
/// success - Success/failure indicator
///
/// See also: SetCurrentDirName()
@library("dos.library")
extern pub fn GetCurrentDirName(buf: *u8, len: i32) -> i16
/// Sets the name of the program being run (V36)
///
/// Sets the name for the program in the cli structure. If the name is too long
/// to fit, a failure is returned, and the old value is left intact.
///
/// # Arguments
/// * `name` - Name of program to use.
///
/// # Returns
/// success - Success/failure indicator.
///
/// See also: GetProgramName()
@library("dos.library")
extern pub fn SetProgramName(name: *u8) -> i16
/// Returns the current program name (V36)
///
/// Extracts the program name from the CLI structure and puts it into the
/// buffer. If the buffer is too small, the name is truncated.
///
/// # Arguments
/// * `buf` - Buffer to hold extracted name len - Number of bytes of space
///   in buffer
///
/// # Returns
/// success - Success/failure indicator
///
/// See also: SetProgramName()
@library("dos.library")
extern pub fn GetProgramName(buf: *u8, len: i32) -> i16
/// Sets the CLI/shell prompt for the current process (V36)
///
/// Sets the text for the prompt in the cli structure. If the prompt is too long
/// to fit, a failure is returned, and the old value is left intact.
///
/// # Arguments
/// * `name` - Name of prompt to be set.
///
/// # Returns
/// success - Success/failure indicator.
///
/// See also: GetPrompt()
@library("dos.library")
extern pub fn SetPrompt(name: *u8) -> i16
/// Returns the prompt for the current process (V36)
///
/// Extracts the prompt string from the CLI structure and puts it into the
/// buffer. If the buffer is too small, the string is truncated appropriately
/// and a failure code returned.
///
/// # Arguments
/// * `buf` - Buffer to hold extracted prompt len - Number of bytes of
///   space in buffer
///
/// # Returns
/// success - Success/failure indicator
///
/// See also: SetPrompt()
@library("dos.library")
extern pub fn GetPrompt(buf: *u8, len: i32) -> i16
/// Sets the directory returned by GetProgramDir (V36)
///
/// Sets a shared lock on the directory the program was loaded from. This can be
/// used for a program to find data files, etc, that are stored with the
/// program, or to find the program file itself.
///
/// # Arguments
/// * `lock` - A lock on the directory the current program was loaded from
///
/// # Returns
/// oldlock - The previous ProgramDir.
///
/// See also: GetProgramDir(), Open()
@library("dos.library")
extern pub fn SetProgramDir(lock: i32) -> i32
/// Returns a lock on the directory the program was loaded
///
/// Returns a shared lock on the directory the program was loaded from. This can
/// be used for a program to find data files, etc, that are stored with the
/// program, or to find the program file itself.
///
/// # Returns
/// lock - A lock on the directory the current program was loaded from, or
/// NULL if loaded from resident list, etc.
///
/// See also: SetProgramDir(), Open()
@library("dos.library")
extern pub fn GetProgramDir() -> i32
/// Have a shell execute a command line (V36)
///
/// Similar to Execute(), but does not read commands from the input filehandle.
/// Spawns a Shell process to execute the command, and returns the returncode
/// the command produced, or -1 if the command could not be run for any reason.
///
/// # Arguments
/// * `command` - Program and arguments tags - see <dos/dostags.h>. Note
///   that both SystemTagList()- specific tags and tags from
///   CreateNewProc() may be passed.
///
/// # Returns
/// error - 0 for success, result from command, or -1. Note that on error,
/// the caller is responsible for any filehandles or other things passed in
/// via tags. -1 will only be returned if dos could not create the new
/// shell. If the command is not found the shell will return an error
/// value, normally RETURN_ERROR.
///
/// See also: Execute(), CreateNewProc(), <dos/dostags.h>, Input(), Output()
@library("dos.library")
extern pub fn SystemTagList(command: *u8, tags: *TagItem) -> i32
@library("dos.library")
extern pub fn SystemTags(command: *u8, tags: u32, ...args) -> i32
/// Creates an assignment to a locked object (V36)
///
/// Sets up an assign of a name to a given lock. Passing NULL for a lock cancels
/// any outstanding assign to that name.
///
/// # Arguments
/// * `name` - Name of device to assign lock to (without trailing ':') lock
///   - Lock associated with the assigned name
///
/// # Returns
/// success - Success/failure indicator. On failure, the lock is not
/// unlocked.
///
/// See also: Lock(), AssignAdd(), AssignPath(), AssignLate(), DupLock()
@library("dos.library")
extern pub fn AssignLock(name: *u8, lock: i32) -> i32
/// Creates an assignment to a specified path later (V36)
///
/// Sets up a assignment that is expanded upon the FIRST reference to the name.
/// The path (a string) would be attached to the node.
///
/// # Arguments
/// * `name` - Name of device to be assigned (without trailing ':') path -
///   Name of late assignment to be resolved on the first reference.
///
/// # Returns
/// success - Success/failure indicator of the operation
///
/// See also: Lock(), AssignAdd(), AssignPath(), AssignLock()
@library("dos.library")
extern pub fn AssignLate(name: *u8, path: *u8) -> i16
/// Creates an assignment to a specified path (V36)
///
/// Sets up a assignment that is expanded upon EACH reference to the name. This
/// is implemented through a new device list type (DLT_ASSIGNPATH, or some
/// such).
///
/// # Arguments
/// * `name` - Name of device to be assigned (without trailing ':') path -
///   Name of late assignment to be resolved at each reference
///
/// # Returns
/// success - Success/failure indicator of the operation
///
/// See also: AssignAdd(), AssignLock(), AssignLate(), Open()
@library("dos.library")
extern pub fn AssignPath(name: *u8, path: *u8) -> i16
/// Adds a lock to an assign for multi-directory assigns (V36)
///
/// Adds a lock to an assign, making or adding to a multi-directory assign. Note
/// that this only will succeed on an assign created with AssignLock(), or an
/// assign created with AssignLate() which has been resolved (converted into a
/// AssignLock()-assign).
///
/// # Arguments
/// * `name` - Name of device to assign lock to (without trailing ':') lock
///   - Lock associated with the assigned name
///
/// # Returns
/// success - Success/failure indicator. On failure, the lock is not
/// unlocked.
///
/// See also: Lock(), AssignLock(), AssignPath(), AssignLate(), DupLock()
@library("dos.library")
extern pub fn AssignAdd(name: *u8, lock: i32) -> i16
/// Remove an entry from a multi-dir assign (V36)
///
/// Removes an entry from a multi-directory assign. The entry removed is the
/// first one for which SameLock with 'lock' returns that they are on the same
/// object.
///
/// # Arguments
/// * `name` - Name of device to remove lock from (without trailing ':')
///   lock - Lock associated with the object to remove from the list
///
/// # Returns
/// success - Success/failure indicator.
///
/// See also: Lock(), AssignLock(), AssignPath(), AssignLate(), DupLock()
@library("dos.library")
extern pub fn RemAssignList(name: *u8, lock: i32) -> i32
/// Finds a handler to send a message to (V36)
///
/// Finds the handler/filesystem to send packets regarding 'name' to. This may
/// involve getting temporary locks.
///
/// # Arguments
/// * `name` - name of the object you wish to access. This can be a
///   relative path ("foo/bar"), relative to the current volume
///   (":foo/bar"), or relative to a device/volume/assign ("foo:bar").
///   devproc - A value returned by GetDeviceProc() before, or NULL
///
/// # Returns
/// devproc - a pointer to a DevProc structure or NULL
///
/// See also: FreeDeviceProc(), DeviceProc(), AssignLock(), AssignLate(), AssignPath()
@library("dos.library")
extern pub fn GetDeviceProc(name: *u8, dp: *DevProc) -> *DevProc
/// Releases port returned by GetDeviceProc() (V36)
///
/// Frees up the structure created by GetDeviceProc(), and any associated
/// temporary locks. Decrements the counter incremented by GetDeviceProc().
///
/// # Arguments
/// * `devproc` - A value returned by GetDeviceProc()
///
/// See also: GetDeviceProc(), DeviceProc(), AssignLock(), AssignLate(), AssignPath()
@library("dos.library")
extern pub fn FreeDeviceProc(consuming dp: *DevProc)
/// Locks the specified Dos Lists for use (V36)
///
/// Locks the dos device list in preparation to walk the list. If the list is
/// 'busy' then this routine will not return until it is available.
///
/// # Arguments
/// * `flags` - Flags stating which types of nodes you want to lock.
///
/// # Returns
/// dlist - Pointer to the head of the list. NOT a valid node!
///
/// See also: AttemptLockDosList(), UnLockDosList(), Forbid(), NextDosEntry()
@library("dos.library")
extern pub fn LockDosList(flags: u32) -> *DosList
/// Unlocks the Dos List (V36)
///
/// Unlocks the access on the Dos Device List. You MUST pass the same flags you
/// used to lock the list.
///
/// # Arguments
/// * `flags` - MUST be the same flags passed to (Attempt)LockDosList()
///
/// See also: AttemptLockDosList(), LockDosList(), Permit()
@library("dos.library")
extern pub fn UnLockDosList(flags: u32)
/// Attempt to lock the Dos Lists for use (V36)
///
/// Locks the dos device list in preparation to walk the list. If the list is
/// 'busy' then this routine will return NULL.
///
/// # Arguments
/// * `flags` - Flags stating which types of nodes you want to lock.
///
/// # Returns
/// dlist - Pointer to the beginning of the list or NULL. Not a valid node!
///
/// See also: LockDosList(), UnLockDosList(), Forbid(), NextDosEntry()
@library("dos.library")
extern pub fn AttemptLockDosList(flags: u32) -> *DosList
/// Removes a Dos List entry from it's list (V36)
///
/// This removes an entry from the Dos Device list. The memory associated with
/// the entry is NOT freed.
///
/// # Arguments
/// * `dlist` - Device list entry to be removed.
///
/// # Returns
/// success - Success/failure indicator
///
/// See also: AddDosEntry(), FindDosEntry(), NextDosEntry(), LockDosList(), MakeDosEntry()
@library("dos.library")
extern pub fn RemDosEntry(dlist: *DosList) -> i16
/// Add a Dos List entry to the lists (V36)
///
/// Adds a device, volume or assign to the dos devicelist. Can fail if it
/// conflicts with an existing entry (such as another assign to the same name or
/// another device of the same name).
///
/// # Arguments
/// * `dlist` - Device list entry to be added.
///
/// # Returns
/// success - Success/Failure indicator
///
/// See also: RemDosEntry(), FindDosEntry(), NextDosEntry(), LockDosList(), MakeDosEntry()
@library("dos.library")
extern pub fn AddDosEntry(dlist: *DosList) -> i32
/// Finds a specific Dos List entry (V36)
///
/// Locates an entry on the device list. Starts with the entry dlist.
///
/// # Arguments
/// * `dlist` - The device entry to start with. name - Name of device entry
///   (without ':') to locate. flags - Search control flags. Use the flags
///   you passed to LockDosList, or a subset of them. LDF_READ/LDF_WRITE
///   are not required for this call.
///
/// # Returns
/// newdlist - The device entry or NULL
///
/// See also: AddDosEntry(), RemDosEntry(), NextDosEntry(), LockDosList(), MakeDosEntry()
@library("dos.library")
extern pub fn FindDosEntry(dlist: *DosList, name: *u8, flags: u32) -> *DosList
/// Get the next Dos List entry (V36)
///
/// Find the next Dos List entry of the right type. You MUST have locked the
/// types you're looking for.
///
/// # Arguments
/// * `dlist` - The current device entry. flags - What type of entries to
///   look for.
///
/// # Returns
/// newdlist - The next device entry of the right type or NULL.
///
/// See also: AddDosEntry(), RemDosEntry(), FindDosEntry(), LockDosList(), MakeDosEntry()
@library("dos.library")
extern pub fn NextDosEntry(dlist: *DosList, flags: u32) -> *DosList
/// Creates a DosList structure (V36)
///
/// Create a DosList structure, including allocating a name and correctly
/// null-terminating the BSTR. It also sets the dol_Type field, and sets all
/// other fields to 0.
///
/// # Arguments
/// * `name` - name for the device/volume/assign node. type - type of node.
///
/// # Returns
/// newdlist - The new device entry or NULL.
///
/// See also: AddDosEntry(), RemDosEntry(), FindDosEntry(), LockDosList(), NextDosEntry()
@library("dos.library")
extern pub fn MakeDosEntry(name: *u8, _type: i32) -> *DosList
/// Frees an entry created by MakeDosEntry (V36)
///
/// Frees an entry created by MakeDosEntry(). This routine should be eliminated
/// and replaced by a value passed to FreeDosObject()!
///
/// # Arguments
/// * `dlist` - DosList to free.
///
/// See also: AddDosEntry(), RemDosEntry(), FindDosEntry(), LockDosList(), NextDosEntry()
@library("dos.library")
extern pub fn FreeDosEntry(consuming dlist: *DosList)
/// Returns whether a Dos handler is a filesystem (V36)
///
/// Returns whether the device is a filesystem or not. A filesystem supports
/// seperate files storing information.
///
/// # Arguments
/// * `name` - Name of device in question, with trailing ':'.
///
/// # Returns
/// result - Flag to indicate if device is a file system
///
/// See also: Lock()
@library("dos.library")
extern pub fn IsFileSystem(name: *u8) -> i16
/// Causes a filesystem to initialize itself (V36)
///
/// Interface for initializing new media on a device. This causes the filesystem
/// to write out an empty disk structure to the media, which should then be
/// ready for use.
///
/// # Arguments
/// * `filesystem` - Name of device to be formatted. ':' must be supplied.
///   volumename - Name for volume (if supported). No ':'. dostype - Type
///   of format, if filesystem supports multiple types.
///
/// # Returns
/// success - Success/failure indicator.
@library("dos.library")
extern pub fn Format(filesystem: *u8, volumename: *u8, dostype: u32) -> i16
/// Change the volume name of a volume (V36)
///
/// Changes the volumename of a volume, if supported by the filesystem.
///
/// # Arguments
/// * `volumename` - Full name of device to rename (with ':') newname - New
///   name to apply to device (without ':')
///
/// # Returns
/// success - Success/failure indicator
@library("dos.library")
extern pub fn Relabel(drive: *u8, newname: *u8) -> i32
/// Inhibits access to a filesystem (V36)
///
/// Sends an ACTION_INHIBIT packet to the indicated handler. This stops all
/// activity by the handler until uninhibited.
///
/// # Arguments
/// * `filesystem` - Name of device to inhibit (with ':') flag - New
///   status. DOSTRUE = inhibited, FALSE = uninhibited
///
/// # Returns
/// success - Success/failure indicator
@library("dos.library")
extern pub fn Inhibit(name: *u8, onoff: i32) -> i32
/// Changes the number of buffers for a filesystem (V36)
///
/// Adds buffers to a filesystem. If it succeeds, the number of current buffers
/// is returned in IoErr().
///
/// # Arguments
/// * `filesystem` - Name of device to add buffers to (with ':'). number -
///   Number of buffers to add. May be negative.
///
/// # Returns
/// success - Success or failure of command.
///
/// See also: IoErr()
@library("dos.library")
extern pub fn AddBuffers(name: *u8, number: i32) -> i32
/// Compares two datestamps (V36)
///
/// Compares two times for relative magnitide. <0 is returned if date1 is later
/// than date2, 0 if they are equal, or >0 if date2 is later than date1.
///
/// # Arguments
/// * `date1, date2` - DateStamps to compare
///
/// # Returns
/// result - <0, 0, or >0 based on comparison of two date stamps
///
/// See also: DateStamp(), DateToStr(), StrToDate()
@library("dos.library")
extern pub fn CompareDates(date1: *DateStamp, date2: *DateStamp) -> i32
/// Converts a DateStamp to a string (V36)
///
/// DateToStr converts an AmigaDOS DateStamp to a human readable ASCII string as
/// requested by your settings in the DateTime structure.
///
/// # Arguments
/// * `DateTime` - a pointer to an initialized DateTime structure.
/// * `dat_Stamp` - a copy of the datestamp you wish to convert to ascii.
/// * `dat_Format` - a format byte which specifies the format of the
///   dat_StrDate. This can be any of the following (note: If value used is
///   something other than those below, the default of FORMAT_DOS is used):
///
/// # Returns
/// success - a zero return indicates that the DateStamp was invalid, and
/// could not be converted. Non-zero indicates that the call succeeded.
///
/// See also: DateStamp(), StrtoDate(), <dos/datetime.h>
@library("dos.library")
extern pub fn DateToStr(datetime: *DateTime) -> i32
/// Converts a string to a DateStamp (V36)
///
/// Converts a human readable ASCII string into an AmigaDOS DateStamp.
///
/// # Arguments
/// * `DateTime` - a pointer to an initialized DateTime structure.
/// * `dat_Stamp` - ignored on input.
/// * `dat_Format` - a format byte which specifies the format of the
///   dat_StrDat. This can be any of the following (note: If value used is
///   something other than those below, the default of FORMAT_DOS is used):
///
/// # Returns
/// success - a zero return indicates that a conversion could not be
/// performed. A non-zero return indicates that the DateTime.dat_Stamp
/// variable contains the converted values.
///
/// See also: DateStamp(), DateToStr(), <dos/datetime.h>
@library("dos.library")
extern pub fn StrToDate(datetime: *DateTime) -> i32
/// Low-level load routine (V36)
///
/// Loads from fh. Table is used when loading an overlay, otherwise should be
/// NULL.
///
/// # Arguments
/// * `fh` - Filehandle to load from. table - When loading an overlay,
///   otherwise ignored. functionarray - Array of function to be used for
///   read, alloc, and free. FuncTable[0] -> Actual =
///   ReadFunc(readhandle,buffer,length),DOSBase D0 D1 D2 D3 A6
///   FuncTable[1] -> Memory = AllocFunc(size,flags), Execbase D0 D0 D1 a6
///   FuncTable[2] -> FreeFunc(memory,size), Execbase A1 D0 A6 stack -
///   Pointer to storage (ULONG) for stacksize.
///
/// # Returns
/// seglist - Seglist loaded or NULL. NOT returned in D1!
///
/// See also: LoadSeg(), UnLoadSeg(), NewLoadSeg(), InternalUnLoadSeg()
@library("dos.library")
extern pub fn InternalLoadSeg(fh: i32, table: i32, funcarray: *u8, stack: *u8) -> i32
/// Unloads a seglist loaded with InternalLoadSeg() (V36)
///
/// Unloads a seglist using freefunc to free segments. Freefunc is called as for
/// InternalLoadSeg.
///
/// # Arguments
/// * `seglist` - Seglist to be unloaded FreeFunc - Function called to free
///   memory
///
/// # Returns
/// success - returns whether everything went OK (since this may close
/// files). Also returns FALSE if seglist was NULL.
///
/// See also: LoadSeg(), UnLoadSeg(), InternalLoadSeg(), NewUnLoadSeg(), Close()
@library("dos.library")
extern pub fn InternalUnLoadSeg(seglist: i32, freefunc: fn()) -> i16
/// Improved version of LoadSeg for stacksizes (V36)
///
/// Does a LoadSeg on a file, and takes additional actions based on the tags
/// supplied. Clears unused portions of Code and Data hunks (as well as BSS
/// hunks).
///
/// # Arguments
/// * `file` - Filename of file to load tags - pointer to tagitem array
///
/// # Returns
/// seglist - Seglist loaded, or NULL
///
/// See also: LoadSeg(), UnLoadSeg(), InternalLoadSeg(), InternalUnLoadSeg()
@library("dos.library")
extern pub fn NewLoadSeg(file: *u8, tags: *TagItem) -> i32
@library("dos.library")
extern pub fn NewLoadSegTags(file: *u8, tags: u32, ...args) -> i32
/// Adds a resident segment to the resident list (V36)
///
/// Adds a segment to the Dos resident list, with the specified Seglist and type
/// (stored in seg_UC - normally 0). NOTE: currently unused types may cause it
/// to interpret other registers (d4-?) as additional parameters in the future.
///
/// # Arguments
/// * `name` - name for the segment seglist - Dos seglist of code for
///   segment type - initial usecount, normally 0
///
/// # Returns
/// success - success or failure
///
/// See also: FindSegment(), RemSegment(), LoadSeg()
@library("dos.library")
extern pub fn AddSegment(name: *u8, seg: i32, system: i32) -> i32
/// Finds a segment on the resident list (V36)
///
/// Finds a segment on the Dos resident list by name and type, starting at the
/// segment AFTER 'start', or at the beginning if start is NULL. If system is
/// zero, it will only return nodes with a seg_UC of 0 or more.
///
/// # Arguments
/// * `name` - name of segment to find start - segment to start the search
///   after system - true for system segment, false for normal segments
///
/// # Returns
/// segment - the segment found or NULL
///
/// See also: AddSegment(), RemSegment(), Forbid()
@library("dos.library")
extern pub fn FindSegment(name: *u8, seg: *Segment, system: i32) -> *Segment
/// Removes a resident segment from the resident list (V36)
///
/// Removes a resident segment from the Dos resident segment list, unloads it,
/// and does any other cleanup required. Will only succeed if the seg_UC
/// (usecount) is 0.
///
/// # Arguments
/// * `segment` - the segment to be removed
///
/// # Returns
/// success - success or failure.
///
/// See also: FindSegment(), AddSegment()
@library("dos.library")
extern pub fn RemSegment(seg: *Segment) -> i32
/// Checks for break signals (V36)
///
/// This function checks to see if any signals specified in the mask have been
/// set and if so, returns them. Otherwise it returns FALSE.
///
/// # Arguments
/// * `mask` - Signals to check for.
///
/// # Returns
/// signals - Signals specified in mask that were set.
@library("dos.library")
extern pub fn CheckSignal(mask: i32) -> i32
/// Parse the command line input (V36)
///
/// Parses and argument string according to a template. Normally gets the
/// arguments by reading buffered IO from Input(), but also can be made to parse
/// a string.
///
/// # Arguments
/// * `template` - formatting string array - array of longwords for
///   results, 1 per template entry rdargs - optional rdargs structure for
///   options. AllocDosObject should be used for allocating them if you
///   pass one in.
///
/// # Returns
/// result - a struct RDArgs or NULL for failure.
///
/// See also: FindArg(), ReadItem(), FreeArgs(), AllocDosObject()
@library("dos.library")
extern pub fn ReadArgs(arg_template: *u8, array: *u8, args: *RDArgs) -> *RDArgs
/// Find a keyword in a template (V36)
///
/// Returns the argument number of the keyword, or -1 if it is not a keyword for
/// the template. Abbreviations are handled.
///
/// # Arguments
/// * `keyword` - keyword to search for in template template - template
///   string to search
///
/// # Returns
/// index - number of entry in template, or -1 if not found
///
/// See also: ReadArgs(), ReadItem(), FreeArgs()
@library("dos.library")
extern pub fn FindArg(keyword: *u8, arg_template: *u8) -> i32
/// Reads a single argument/name from command line (V36)
///
/// Reads a "word" from either Input() (buffered), or via CSource, if it is
/// non-NULL (see <dos/rdargs.h> for more information). Handles quoting and some
/// '*' substitutions (*e and *n) inside quotes (only).
///
/// # Arguments
/// * `buffer` - buffer to store word in. maxchars - size of the buffer
///   input - CSource input or NULL (uses FGetC(Input()))
///
/// # Returns
/// value - See <dos/dos.h> for return values.
///
/// See also: ReadArgs(), FindArg(), UnGetC(), FGetC(), Input()
@library("dos.library")
extern pub fn ReadItem(name: *u8, maxchars: i32, cSource: *CSource) -> i32
/// String to long value (decimal) (V36)
///
/// Converts decimal string into LONG value. Returns number of characters
/// converted.
///
/// # Arguments
/// * `string` - Input string. value - Pointer to long value. Set to 0 if
///   no digits are converted.
///
/// # Returns
/// result - Number of characters converted or -1.
@library("dos.library")
extern pub fn StrToLong(string: *u8, value: *u8) -> i32
/// Finds file that matches pattern (V36)
///
/// Locates the first file or directory that matches a given pattern.
/// MatchFirst() is passed your pattern (you do not pass it through
/// ParsePattern() - MatchFirst() does that for you), and the control structure.
///
/// # Arguments
/// * `pat` - Pattern to search for AnchorPath - Place holder for search.
///   MUST be longword aligned!
///
/// # Returns
/// error - 0 for success or error code. (Opposite of most Dos calls!)
///
/// See also: MatchNext(), ParsePattern(), Examine(), CurrentDir(), Examine()
@library("dos.library")
extern pub fn MatchFirst(pat: *u8, anchor: *AnchorPath) -> i32
/// Finds the next file or directory that matches pattern (V36)
///
/// Locates the next file or directory that matches a given pattern. See
/// <dos/dosasl.h> for more information.
///
/// # Arguments
/// * `AnchorPath` - Place holder for search.  MUST be longword aligned!
///
/// # Returns
/// error - 0 for success or error code. (Opposite of most Dos calls)
///
/// See also: MatchFirst(), ParsePattern(), Examine(), CurrentDir(), Examine()
@library("dos.library")
extern pub fn MatchNext(anchor: *AnchorPath) -> i32
/// Free storage allocated for MatchFirst()/MatchNext() (V36)
///
/// Return all storage associated with a given search.
///
/// # Arguments
/// * `AnchorPath` - Anchor used for MatchFirst()/MatchNext() MUST be
///   longword aligned!
///
/// See also: MatchFirst(), ParsePattern(), Examine(), CurrentDir(), Examine()
@library("dos.library")
extern pub fn MatchEnd(anchor: *AnchorPath)
/// Create a tokenized string for MatchPattern() (V36)
///
/// Tokenizes a pattern, for use by MatchPattern(). Also indicates if there are
/// any wildcards in the pattern (i.e.
///
/// # Arguments
/// * `source` - unparsed wildcard string to search for.
/// * `dest` - output string, gets tokenized version of input. DestLength -
///   length available in destination (should be at least as twice as large
///   as source + 2 bytes).
///
/// # Returns
/// IsWild - 1 means there were wildcards in the pattern, 0 means there
/// were no wildcards in the pattern, -1 means there was a buffer overflow
/// or other error
///
/// See also: ParsePatternNoCase(), MatchPattern(), MatchFirst(), MatchNext()
@library("dos.library")
extern pub fn ParsePattern(pat: *u8, buf: *u8, buflen: i32) -> i32
/// Checks for a pattern match with a string (V36)
///
/// Checks for a pattern match with a string. The pattern must be a tokenized
/// string output by ParsePattern().
///
/// # Arguments
/// * `pat` - Special pattern string to match as returned by ParsePattern()
///   str - String to match against given pattern
///
/// # Returns
/// match - success or failure of pattern match. On failure, IoErr() will
/// return 0 or ERROR_TOO_MANY_LEVELS (starting with V37 - before that
/// there was no stack checking).
///
/// See also: ParsePattern(), MatchPatternNoCase(), MatchFirst(), MatchNext()
@library("dos.library")
extern pub fn MatchPattern(pat: *u8, str: *u8) -> i16
/// Free allocated memory after ReadArgs() (V36)
///
/// Frees memory allocated to return arguments in from ReadArgs(). If ReadArgs
/// allocated the RDArgs structure it will be freed.
///
/// # Arguments
/// * `rdargs` - structure returned from ReadArgs() or NULL.
///
/// See also: ReadArgs(), ReadItem(), FindArg()
@library("dos.library")
extern pub fn FreeArgs(consuming args: *RDArgs)
/// Returns the last component of a path (V36)
///
/// This function returns a pointer to the last component of a string path
/// specification, which will normally be the file name. If there is only one
/// component, it returns a pointer to the beginning of the string.
///
/// # Arguments
/// * `path` - pointer to an path string. May be relative to the current
///   directory or the current disk.
///
/// # Returns
/// fileptr - pointer to the last component of the path.
///
/// See also: PathPart(), AddPart()
@library("dos.library")
extern pub fn FilePart(path: *u8) -> *u8
/// Returns a pointer to the end of the next-to-last (V36)
///
/// This function returns a pointer to the character after the next-to-last
/// component of a path specification, which will normally be the directory
/// name. If there is only one component, it returns a pointer to the beginning
/// of the string.
///
/// # Arguments
/// * `path` - pointer to an path string. May be relative to the current
///   directory or the current disk.
///
/// # Returns
/// fileptr - pointer to the end of the next-to-last component of the path.
///
/// See also: FilePart(), AddPart()
@library("dos.library")
extern pub fn PathPart(path: *u8) -> *u8
/// Appends a file/dir to the end of a path (V36)
///
/// This function adds a file, directory, or subpath name to a directory path
/// name taking into account any required separator characters. If filename is a
/// fully-qualified path it will totally replace the current value of dirname.
///
/// # Arguments
/// * `dirname` - the path to add a file/directory name to. filename - the
///   filename or directory name to add. May be a relative pathname from
///   the current directory (example: foo/bar). Can deal with leading
///   '/'(s), indicating one directory up per '/', or with a ':',
///   indicating it's relative to the root of the appropriate volume. size
///   - size in bytes of the space allocated for dirname. Must not be 0.
///
/// # Returns
/// success - non-zero for ok, FALSE if the buffer would have overflowed.
/// If an overflow would have occured, dirname will not be changed.
///
/// See also: FilePart(), PathPart()
@library("dos.library")
extern pub fn AddPart(dirname: *u8, filename: *u8, size: u32) -> i16
/// Starts notification on a file or directory (V36)
///
/// Posts a notification request. Do not modify the notify structure while it is
/// active.
///
/// # Arguments
/// * `notifystructure` - A filled-in NotifyRequest structure
///
/// # Returns
/// success - Success/failure of request
///
/// See also: EndNotify(), <dos/notify.h>
@library("dos.library")
extern pub fn StartNotify(notify: *NotifyRequest) -> i16
/// Ends a notification request (V36)
///
/// Removes a notification request. Safe to call even if StartNotify() failed.
///
/// # Arguments
/// * `notifystructure` - a structure passed to StartNotify()
///
/// See also: StartNotify(), <dos/notify.h>
@library("dos.library")
extern pub fn EndNotify(notify: *NotifyRequest)
/// Sets a local or environment variable (V36)
///
/// Sets a local or environment variable. It is advised to only use ASCII
/// strings inside variables, but not required.
///
/// # Arguments
/// * `name` - pointer to an variable name. Note variable names follow
///   filesystem syntax and semantics. buffer - a user allocated area which
///   contains a string that is the value to be associated with this
///   variable. size - length of the buffer region in bytes. -1 means
///   buffer contains a null-terminated string. flags - combination of type
///   of var to set (low 8 bits), and flags to control the behavior of this
///   routine. Currently defined flags include:
/// * `GVF_LOCAL_ONLY` - set a local (to your process) variable.
///   GVF_GLOBAL_ONLY - set a global environment variable.
///
/// # Returns
/// success - If non-zero, the variable was sucessfully set, FALSE
/// indicates failure.
///
/// See also: GetVar(), DeleteVar(), FindVar(), <dos/var.h>
@library("dos.library")
extern pub fn SetVar(name: *u8, buffer: *u8, size: i32, flags: i32) -> i16
/// Returns the value of a local or global variable (V36)
///
/// Gets the value of a local or environment variable. It is advised to only use
/// ASCII strings inside variables, but not required.
///
/// # Arguments
/// * `name` - pointer to a variable name. buffer - a user allocated area
///   which will be used to store the value associated with the variable.
///   size - length of the buffer region in bytes. flags - combination of
///   type of var to get value of (low 8 bits), and flags to control the
///   behavior of this routine. Currently defined flags include:
/// * `GVF_GLOBAL_ONLY` - tries to get a global env variable.
///   GVF_LOCAL_ONLY - tries to get a local variable. GVF_BINARY_VAR -
///   don't stop at \n GVF_DONT_NULL_TERM - no null termination (only valid
///   for binary variables). (V37)
///
/// # Returns
/// len - Size of environment variable. -1 indicates that the variable was
/// not defined (if IoErr() returns ERROR_OBJECT_NOT_FOUND - it returns
/// ERROR_BAD_NUMBER if you specify a size of 0). If the value would
/// overflow the user buffer, the buffer is truncated. The buffer returned
/// is null-terminated (even if GVF_BINARY_VAR is used, unless
/// GVF_DONT_NULL_TERM is in effect). If it succeeds, len is the number of
/// characters put in the buffer (not including null termination), and
/// IoErr() will return the the size of the variable (regardless of buffer
/// size).
///
/// See also: SetVar(), DeleteVar(), FindVar(), <dos/var.h>
@library("dos.library")
extern pub fn GetVar(name: *u8, buffer: *u8, size: i32, flags: i32) -> i32
/// Deletes a local or environment variable (V36)
///
/// Deletes a local or environment variable.
///
/// # Arguments
/// * `name` - pointer to an variable name. Note variable names follow
///   filesystem syntax and semantics. flags - combination of type of var
///   to delete (low 8 bits), and flags to control the behavior of this
///   routine. Currently defined flags include:
/// * `GVF_LOCAL_ONLY` - delete a local (to your process) variable.
///   GVF_GLOBAL_ONLY - delete a global environment variable.
///
/// # Returns
/// success - If non-zero, the variable was sucessfully deleted, FALSE
/// indicates failure.
///
/// See also: GetVar(), SetVar(), FindVar(), DeleteFile(), <dos/var.h>
@library("dos.library")
extern pub fn DeleteVar(name: *u8, flags: u32) -> i32
/// Finds a local variable (V36)
///
/// Finds a local variable structure.
///
/// # Arguments
/// * `name` - pointer to an variable name. Note variable names follow
///   filesystem syntax and semantics.
/// * `type` - type of variable to be found (see <dos/var.h>)
///
/// # Returns
/// var - pointer to a LocalVar structure or NULL
///
/// See also: GetVar(), SetVar(), DeleteVar(), <dos/var.h>
@library("dos.library")
extern pub fn FindVar(name: *u8, _type: u32) -> *LocalVar
/// Set up a process to be a shell from initial packet
///
/// This function initializes a process and CLI structure for a new shell, from
/// parameters in an initial packet passed by the system (NewShell or NewCLI,
/// etc). The format of the data in the packet is purposely not defined.
///
/// # Arguments
/// * `packet` - the initial packet sent to your process MsgPort
///
/// # Returns
/// fn - flags or a pointer
///
/// See also: CliInitRun(), ReplyPkt(), WaitPkt(), IoErr()
@library("dos.library")
extern pub fn CliInitNewcli(dp: *DosPacket) -> i32
/// Set up a process to be a shell from initial packet
///
/// This function initializes a process and CLI structure for a new shell, from
/// parameters in an initial packet passed by the system (Run, System(),
/// Execute()). The format of the data in the packet is purposely not defined.
///
/// # Arguments
/// * `packet` - the initial packet sent to your process MsgPort
///
/// # Returns
/// fn - flags or a pointer
///
/// See also: CliInitNewcli(), ReplyPkt(), WaitPkt(), System(), Execute()
@library("dos.library")
extern pub fn CliInitRun(dp: *DosPacket) -> i32
/// Writes bytes to the the default output (buffered) (V36)
///
/// This routine writes a number of bytes to the default output. The length is
/// returned.
///
/// # Arguments
/// * `buf` - buffer of characters to write buflen - number of characters
///   to write
///
/// # Returns
/// count - Number of bytes written. -1 (EOF) indicates an error
///
/// See also: FPuts(), FPutC(), FWrite(), PutStr()
@library("dos.library")
extern pub fn WriteChars(buf: *u8, buflen: u32) -> i32
/// Writes a string the the default output (buffered) (V36)
///
/// This routine writes an unformatted string to the default output. No newline
/// is appended to the string and any error is returned.
///
/// # Arguments
/// * `str` - Null-terminated string to be written to default output
///
/// # Returns
/// error - 0 for success, -1 for any error. NOTE: this is opposite most
/// Dos function returns!
///
/// See also: FPuts(), FPutC(), FWrite(), WriteChars()
@library("dos.library")
extern pub fn PutStr(str: *u8) -> i32
/// Format and print string (buffered) (V36)
///
/// Writes the formatted string and values to Output(). This routine is assumed
/// to handle all internal buffering so that the formatting string and resultant
/// formatted values can be arbitrarily long.
///
/// # Arguments
/// * `fmt` - exec.library RawDoFmt() style formatting string argv -
///   Pointer to array of formatting values
///
/// # Returns
/// count - Number of bytes written or -1 (EOF) for an error
///
/// See also: VFPrintf(), VFWritef(), RawDoFmt(), FPutC()
@library("dos.library")
extern pub fn VPrintf(format: *u8, argarray: *u8) -> i32
@library("dos.library")
extern pub fn Printf(format: *u8, ...args) -> i32
/// Create a tokenized string for
///
/// Tokenizes a pattern, for use by MatchPatternNoCase(). Also indicates if
/// there are any wildcards in the pattern (i.e.
///
/// # Arguments
/// * `source` - unparsed wildcard string to search for.
/// * `dest` - output string, gets tokenized version of input. DestLength -
///   length available in destination (should be at least as twice as large
///   as source + 2 bytes).
///
/// # Returns
/// IsWild - 1 means there were wildcards in the pattern, 0 means there
/// were no wildcards in the pattern, -1 means there was a buffer overflow
/// or other error
///
/// See also: ParsePattern(), MatchPatternNoCase(), MatchFirst(), MatchNext(), utility.library/ToUpper()
@library("dos.library")
extern pub fn ParsePatternNoCase(pat: *u8, buf: *u8, buflen: i32) -> i32
/// Checks for a pattern match with a string (V37)
///
/// Checks for a pattern match with a string. The pattern must be a tokenized
/// string output by ParsePatternNoCase().
///
/// # Arguments
/// * `pat` - Special pattern string to match as returned by
///   ParsePatternNoCase() str - String to match against given pattern
///
/// # Returns
/// match - success or failure of pattern match. On failure, IoErr() will
/// return 0 or ERROR_TOO_MANY_LEVELS (starting with V37 - before that
/// there was no stack checking).
///
/// See also: ParsePatternNoCase(), MatchPattern(), MatchFirst(), MatchNext()
@library("dos.library")
extern pub fn MatchPatternNoCase(pat: *u8, str: *u8) -> i16
/// Are two locks are on partitions of the device? (V37)
///
/// SameDevice() returns whether two locks refer to partitions that are on the
/// same physical device (if it can figure it out). This may be useful in
/// writing copy routines to take advantage of asynchronous multi-device copies.
///
/// # Arguments
/// * `lock1,lock2` - locks
///
/// # Returns
/// same - whether they're on the same device as far as Dos can determine.
@library("dos.library")
extern pub fn SameDevice(lock1: i32, lock2: i32) -> i16
/// Stop an ExAll() (V39)
///
/// Stops an ExAll() on a directory before it hits NO_MORE_ENTRIES. The full set
/// of arguments that had been passed to ExAll() must be passed to ExAllEnd(),
/// so it can handle filesystems that can't abort an ExAll() directly.
///
/// # Arguments
/// * `lock` - Lock on directory to be examined. buffer - Buffer for data
///   returned (MUST be at least word-aligned, preferably long-word
///   aligned). size - Size in bytes of 'buffer'. type - Type of data to be
///   returned. control - Control data structure (see notes above). MUST
///   have been allocated by AllocDosObject!
///
/// See also: ExAll(), AllocDosObject()
@library("dos.library")
extern pub fn ExAllEnd(lock: i32, buffer: *ExAllData, size: i32, data: i32, control: *ExAllControl)
/// Set owner information for a file or directory (V39)
///
/// SetOwner() sets the owner information for the file or directory. This value
/// is a 32-bit value that is normally split into 16 bits of owner user id (bits
/// 31-16), and 16 bits of owner group id (bits 15-0).
///
/// # Arguments
/// * `name` - pointer to a null-terminated string owner_info - owner uid
///   (31:16) and group id (15:0)
///
/// # Returns
/// success - boolean
///
/// See also: SetProtect(), Examine(), ExNext(), ExAll(), <dos/dos.h>
@library("dos.library")
extern pub fn SetOwner(name: *u8, owner_info: i32) -> i16

