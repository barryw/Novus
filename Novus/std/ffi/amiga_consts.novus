/// Number of hardware audio channels
pub const ADHARD_CHANNELS: u32 = 4

/// Allocation priority range
pub const ADALLOC_MINPREC: i8 = -128
pub const ADALLOC_MAXPREC: i8 = 127

/// Audio device commands (CMD_NONSTD = 9)
pub const ADCMD_FREE: u16 = 9         // Free allocated channels
pub const ADCMD_SETPREC: u16 = 10     // Set allocation precedence
pub const ADCMD_FINISH: u16 = 11      // Finish current sound immediately
pub const ADCMD_PERVOL: u16 = 12      // Set period and volume only
pub const ADCMD_LOCK: u16 = 13        // Lock channel for exclusive use
pub const ADCMD_WAITCYCLE: u16 = 14   // Wait for cycle completion
pub const ADCMD_ALLOCATE: u16 = 32    // Allocate channels

/// IOAudio flag bits
pub const ADIOB_PERVOL: u8 = 4        // Set period/volume with CMD_WRITE
pub const ADIOB_SYNCCYCLE: u8 = 5     // Sync to cycle boundary
pub const ADIOB_NOWAIT: u8 = 6        // Don't wait for channel
pub const ADIOB_WRITEMESSAGE: u8 = 7  // Reply when sound finishes

/// IOAudio flag masks
pub const ADIOF_PERVOL: u8 = 16       // 1 << 4
pub const ADIOF_SYNCCYCLE: u8 = 32    // 1 << 5
pub const ADIOF_NOWAIT: u8 = 64       // 1 << 6
pub const ADIOF_WRITEMESSAGE: u8 = 128 // 1 << 7

/// IOAudio error codes
pub const ADIOERR_NOALLOCATION: i8 = -10   // No channels allocated
pub const ADIOERR_ALLOCFAILED: i8 = -11    // Allocation failed
pub const ADIOERR_CHANNELSTOLEN: i8 = -12  // Channel stolen by higher priority

