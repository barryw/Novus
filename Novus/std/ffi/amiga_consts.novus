pub const INTB_DSKBLK: u8 = 1     // Disk block done
pub const INTB_TBE: u8 = 0        // Serial transmit buffer empty

/// Interrupt enable/request flag masks
pub const INTF_SETCLR: u16 = $8000
pub const INTF_INTEN: u16 = $4000
pub const INTF_EXTER: u16 = $2000
pub const INTF_DSKSYNC: u16 = $1000
pub const INTF_RBF: u16 = $0800
pub const INTF_AUD3: u16 = $0400
pub const INTF_AUD2: u16 = $0200
pub const INTF_AUD1: u16 = $0100
pub const INTF_AUD0: u16 = $0080
pub const INTF_BLIT: u16 = $0040
pub const INTF_VERTB: u16 = $0020
pub const INTF_COPER: u16 = $0010
pub const INTF_PORTS: u16 = $0008
pub const INTF_SOFTINT: u16 = $0004
pub const INTF_DSKBLK: u16 = $0002
pub const INTF_TBE: u16 = $0001

// =============================================================================
// ADKCON Bits - Audio/Disk Control (from hardware/adkbits.h)
// =============================================================================

/// ADKCON bit positions
pub const ADKB_SETCLR: u8 = 15    // Set/clear control bit
pub const ADKB_PRECOMP1: u8 = 14  // Disk precompensation bit 1
pub const ADKB_PRECOMP0: u8 = 13  // Disk precompensation bit 0
pub const ADKB_MFMPREC: u8 = 12   // MFM precompensation
pub const ADKB_UARTBRK: u8 = 11   // Force UART break
pub const ADKB_WORDSYNC: u8 = 10  // Enable disk sync matching
pub const ADKB_MSBSYNC: u8 = 9    // Sync on MSB (GCR only)
pub const ADKB_FAST: u8 = 8       // Fast disk mode

/// Audio modulation control bits
pub const ADKB_USE3PN: u8 = 7     // Channel 3 modulates period of next
pub const ADKB_USE2P3: u8 = 6     // Channel 2 modulates period of 3
pub const ADKB_USE1P2: u8 = 5     // Channel 1 modulates period of 2
pub const ADKB_USE0P1: u8 = 4     // Channel 0 modulates period of 1
pub const ADKB_USE3VN: u8 = 3     // Channel 3 modulates volume of next
pub const ADKB_USE2V3: u8 = 2     // Channel 2 modulates volume of 3
pub const ADKB_USE1V2: u8 = 1     // Channel 1 modulates volume of 2
pub const ADKB_USE0V1: u8 = 0     // Channel 0 modulates volume of 1

/// ADKCON flag masks
pub const ADKF_SETCLR: u16 = $8000
pub const ADKF_PRECOMP1: u16 = $4000
pub const ADKF_PRECOMP0: u16 = $2000
pub const ADKF_MFMPREC: u16 = $1000
pub const ADKF_UARTBRK: u16 = $0800
pub const ADKF_WORDSYNC: u16 = $0400
pub const ADKF_MSBSYNC: u16 = $0200
pub const ADKF_FAST: u16 = $0100

/// Audio modulation flag masks
pub const ADKF_USE3PN: u16 = $0080
pub const ADKF_USE2P3: u16 = $0040
pub const ADKF_USE1P2: u16 = $0020
pub const ADKF_USE0P1: u16 = $0010
pub const ADKF_USE3VN: u16 = $0008
pub const ADKF_USE2V3: u16 = $0004
pub const ADKF_USE1V2: u16 = $0002
pub const ADKF_USE0V1: u16 = $0001

/// Disk precompensation values
pub const ADKF_PRE000NS: u16 = $0000                         // 0 ns
pub const ADKF_PRE140NS: u16 = $2000                         // 140 ns (PRECOMP0)
pub const ADKF_PRE280NS: u16 = $4000                         // 280 ns (PRECOMP1)
pub const ADKF_PRE560NS: u16 = $6000                         // 560 ns (both)

