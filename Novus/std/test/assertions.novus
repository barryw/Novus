/// Expect an Option<i32> to be Some
pub fn expect_some_i32(option: Option<i32>, message: *u8) {
    match option {
        Option::Some(_) => {},
        Option::None => {
            __test_record_failure()
            write("  FAIL: %s - expected Some, got None\n", message)
        },
    }
}

/// Expect an Option<i32> to be None
pub fn expect_none_i32(option: Option<i32>, message: *u8) {
    match option {
        Option::Some(v) => {
            __test_record_failure()
            write("  FAIL: %s - expected None, got Some(%ld)\n", message, v)
        },
        Option::None => {},
    }
}

/// Expect an Option<u32> to be Some
pub fn expect_some_u32(option: Option<u32>, message: *u8) {
    match option {
        Option::Some(_) => {},
        Option::None => {
            __test_record_failure()
            write("  FAIL: %s - expected Some, got None\n", message)
        },
    }
}

/// Expect an Option<u32> to be None
pub fn expect_none_u32(option: Option<u32>, message: *u8) {
    match option {
        Option::Some(v) => {
            __test_record_failure()
            write("  FAIL: %s - expected None, got Some(%lu)\n", message, v)
        },
        Option::None => {},
    }
}

/// Expect an Option<bool> to be Some
pub fn expect_some_bool(option: Option<bool>, message: *u8) {
    match option {
        Option::Some(_) => {},
        Option::None => {
            __test_record_failure()
            write("  FAIL: %s - expected Some, got None\n", message)
        },
    }
}

/// Expect an Option<bool> to be None
pub fn expect_none_bool(option: Option<bool>, message: *u8) {
    match option {
        Option::Some(v) => {
            let v_str = if v { "true" } else { "false" }
            __test_record_failure()
            write("  FAIL: %s - expected None, got Some(%s)\n", message, v_str)
        },
        Option::None => {},
    }
}

/// Expect Option<i32> to be Some with specific value
pub fn expect_some_eq_i32(option: Option<i32>, expected: i32, message: *u8) {
    match option {
        Option::Some(v) => {
            if v != expected {
                __test_record_failure()
                write("  FAIL: %s - expected Some(%ld), got Some(%ld)\n", message, expected, v)
            }
        },
        Option::None => {
            __test_record_failure()
            write("  FAIL: %s - expected Some(%ld), got None\n", message, expected)
        },
    }
}

/// Expect Option<u32> to be Some with specific value
pub fn expect_some_eq_u32(option: Option<u32>, expected: u32, message: *u8) {
    match option {
        Option::Some(v) => {
            if v != expected {
                __test_record_failure()
                write("  FAIL: %s - expected Some(%lu), got Some(%lu)\n", message, expected, v)
            }
        },
        Option::None => {
            __test_record_failure()
            write("  FAIL: %s - expected Some(%lu), got None\n", message, expected)
        },
    }
}

// ============================================================================
// P1: Comparison Assertions
// ============================================================================

/// Expect actual > threshold
pub fn expect_gt_i32(actual: i32, threshold: i32, message: *u8) {
    if actual <= threshold {
        __test_record_failure()
        write("  FAIL: %s - expected > %ld, got %ld\n", message, threshold, actual)
    }
}

/// Expect actual < threshold
pub fn expect_lt_i32(actual: i32, threshold: i32, message: *u8) {
    if actual >= threshold {
        __test_record_failure()
        write("  FAIL: %s - expected < %ld, got %ld\n", message, threshold, actual)
    }
}

/// Expect actual >= threshold
pub fn expect_gte_i32(actual: i32, threshold: i32, message: *u8) {
    if actual < threshold {
        __test_record_failure()
        write("  FAIL: %s - expected >= %ld, got %ld\n", message, threshold, actual)
    }
}

/// Expect actual <= threshold
pub fn expect_lte_i32(actual: i32, threshold: i32, message: *u8) {
    if actual > threshold {
        __test_record_failure()
        write("  FAIL: %s - expected <= %ld, got %ld\n", message, threshold, actual)
    }
}

/// Expect actual > threshold (u32)
pub fn expect_gt_u32(actual: u32, threshold: u32, message: *u8) {
    if actual <= threshold {
        __test_record_failure()
        write("  FAIL: %s - expected > %lu, got %lu\n", message, threshold, actual)
    }
}

/// Expect actual < threshold (u32)
pub fn expect_lt_u32(actual: u32, threshold: u32, message: *u8) {
    if actual >= threshold {
        __test_record_failure()
        write("  FAIL: %s - expected < %lu, got %lu\n", message, threshold, actual)
    }
}

/// Expect actual >= threshold (u32)
pub fn expect_gte_u32(actual: u32, threshold: u32, message: *u8) {
    if actual < threshold {
        __test_record_failure()
        write("  FAIL: %s - expected >= %lu, got %lu\n", message, threshold, actual)
    }
}

/// Expect actual <= threshold (u32)
pub fn expect_lte_u32(actual: u32, threshold: u32, message: *u8) {
    if actual > threshold {
        __test_record_failure()
        write("  FAIL: %s - expected <= %lu, got %lu\n", message, threshold, actual)
    }
}

/// Expect two i32 values to NOT be equal
pub fn expect_ne_i32(actual: i32, unexpected: i32, message: *u8) {
    if actual == unexpected {
        __test_record_failure()
        write("  FAIL: %s - expected != %ld, got %ld\n", message, unexpected, actual)
    }
}

/// Expect two u32 values to NOT be equal
pub fn expect_ne_u32(actual: u32, unexpected: u32, message: *u8) {
    if actual == unexpected {
        __test_record_failure()
        write("  FAIL: %s - expected != %lu, got %lu\n", message, unexpected, actual)
    }
}

// ============================================================================
// P2: Array/Slice Assertions
// ============================================================================

/// Expect two i32 arrays to be equal (by pointer and length)
/// Compares element by element
pub fn expect_array_eq_i32(actual_ptr: *i32, actual_len: u32, expected_ptr: *i32, expected_len: u32, message: *u8) {
    if actual_len != expected_len {
        __test_record_failure()
        write("  FAIL: %s - length mismatch: expected %lu, got %lu\n", message, expected_len, actual_len)
        return
    }

    while var i < actual_len {
        let actual = unsafe { actual_ptr[i] }
        let expected = unsafe { expected_ptr[i] }
        if actual != expected {
            __test_record_failure()
            write("  FAIL: %s - element [%lu] mismatch: expected %ld, got %ld\n",
                  message, i, expected, actual)
            return
        }
        i = i + 1
    }
}

/// Expect two u32 arrays to be equal
pub fn expect_array_eq_u32(actual_ptr: *u32, actual_len: u32, expected_ptr: *u32, expected_len: u32, message: *u8) {
    if actual_len != expected_len {
        __test_record_failure()
        write("  FAIL: %s - length mismatch: expected %lu, got %lu\n", message, expected_len, actual_len)
        return
    }

    while var i < actual_len {
        let actual = unsafe { actual_ptr[i] }
        let expected = unsafe { expected_ptr[i] }
        if actual != expected {
            __test_record_failure()
            write("  FAIL: %s - element [%lu] mismatch: expected %lu, got %lu\n",
                  message, i, expected, actual)
            return
        }
        i = i + 1
    }
}

/// Expect two u8 arrays to be equal (useful for byte buffers)
pub fn expect_array_eq_u8(actual_ptr: *u8, actual_len: u32, expected_ptr: *u8, expected_len: u32, message: *u8) {
    if actual_len != expected_len {
        __test_record_failure()
        write("  FAIL: %s - length mismatch: expected %lu, got %lu\n", message, expected_len, actual_len)
        return
    }

    while var i < actual_len {
        let actual = unsafe { actual_ptr[i] }
        let expected = unsafe { expected_ptr[i] }
        if actual != expected {
            __test_record_failure()
            write("  FAIL: %s - element [%lu] mismatch: expected 0x%02x, got 0x%02x\n",
                  message, i, (u32)expected, (u32)actual)
            return
        }
        i = i + 1
    }
}

/// Expect array to contain element
pub fn expect_array_contains_i32(ptr: *i32, len: u32, element: i32, message: *u8) {
    while var i < len {
        if unsafe { ptr[i] } == element {
            return  // Found it
        }
        i = i + 1
    }
    __test_record_failure()
    write("  FAIL: %s - array does not contain %ld\n", message, element)
}

/// Expect array to NOT contain element
pub fn expect_array_not_contains_i32(ptr: *i32, len: u32, element: i32, message: *u8) {
    while var i < len {
        if unsafe { ptr[i] } == element {
            __test_record_failure()
            write("  FAIL: %s - array contains %ld at index %lu\n", message, element, i)
            return
        }
        i = i + 1
    }
}

/// Expect array length to match expected value
pub fn expect_array_len(actual_len: u32, expected_len: u32, message: *u8) {
    if actual_len != expected_len {
        __test_record_failure()
        write("  FAIL: %s - expected length %lu, got %lu\n", message, expected_len, actual_len)
    }
}

/// Expect array to be empty
pub fn expect_array_empty(len: u32, message: *u8) {
    if len != 0 {
        __test_record_failure()
        write("  FAIL: %s - expected empty array, got length %lu\n", message, len)
    }
}

/// Expect array to NOT be empty
pub fn expect_array_not_empty(len: u32, message: *u8) {
    if len == 0 {
        __test_record_failure()
        write("  FAIL: %s - expected non-empty array\n", message)
    }
}

// ============================================================================
// P2: Range Assertions
// ============================================================================

/// Expect value to be in range [min, max] (inclusive)
pub fn expect_in_range_i32(value: i32, min: i32, max: i32, message: *u8) {
    if value < min || value > max {
        __test_record_failure()
        write("  FAIL: %s - expected in range [%ld, %ld], got %ld\n", message, min, max, value)
    }
}

/// Expect value to be in range [min, max] (inclusive, u32)
pub fn expect_in_range_u32(value: u32, min: u32, max: u32, message: *u8) {
    if value < min || value > max {
        __test_record_failure()
        write("  FAIL: %s - expected in range [%lu, %lu], got %lu\n", message, min, max, value)
    }
}

/// Expect value to be outside range [min, max]
pub fn expect_not_in_range_i32(value: i32, min: i32, max: i32, message: *u8) {
    if value >= min && value <= max {
        __test_record_failure()
        write("  FAIL: %s - expected outside range [%ld, %ld], got %ld\n", message, min, max, value)
    }
}

// ============================================================================
// P2: Floating-Point Assertions (when f32/f64 available)
// ============================================================================

// Note: These use fixed-point approximation since full f32/f64 support varies.
// The compiler may need FPU configuration for these to work properly.

/// Expect two i32 values representing fixed-point to be approximately equal
/// Uses absolute difference comparison
pub fn expect_approx_eq_fixed(actual: i32, expected: i32, tolerance: i32, message: *u8) {
    let diff: i32 = if actual > expected { actual - expected } else { expected - actual }
    if diff > tolerance {
        __test_record_failure()
        write("  FAIL: %s - expected ~%ld (tolerance %ld), got %ld (diff=%ld)\n",
              message, expected, tolerance, actual, diff)
    }
}

/// Expect two u32 values to be approximately equal within tolerance
pub fn expect_approx_eq_u32(actual: u32, expected: u32, tolerance: u32, message: *u8) {
    let diff: u32 = if actual > expected { actual - expected } else { expected - actual }
    if diff > tolerance {
        __test_record_failure()
        write("  FAIL: %s - expected ~%lu (tolerance %lu), got %lu (diff=%lu)\n",
              message, expected, tolerance, actual, diff)
    }
}

// ============================================================================
// P3: AmigaOS Memory Validation
// ============================================================================

/// Expect pointer to be in CHIP RAM
pub fn expect_chip_mem(ptr: *u8, message: *u8) {
    let mem_type: u32 = TypeOfMem(ptr)
    if (mem_type & MEMF_CHIP) == 0 {
        __test_record_failure()
        write("  FAIL: %s - expected CHIP memory at 0x%08lx, got type 0x%08lx\n",
              message, (ptr as u32), mem_type)
    }
}

/// Expect pointer to be in FAST RAM
pub fn expect_fast_mem(ptr: *u8, message: *u8) {
    let mem_type: u32 = TypeOfMem(ptr)
    if (mem_type & MEMF_FAST) == 0 {
        __test_record_failure()
        write("  FAIL: %s - expected FAST memory at 0x%08lx, got type 0x%08lx\n",
              message, (ptr as u32), mem_type)
    }
}

/// Expect pointer to be valid (non-null and recognized by TypeOfMem)
pub fn expect_valid_mem(ptr: *u8, message: *u8) {
    if ptr == null {
        __test_record_failure()
        write("  FAIL: %s - expected valid memory, got null\n", message)
        return
    }
    let mem_type: u32 = TypeOfMem(ptr)
    if mem_type == 0 {
        __test_record_failure()
        write("  FAIL: %s - pointer 0x%08lx not recognized by TypeOfMem\n",
              message, (ptr as u32))
    }
}

/// Check that CHIP RAM is available (at least min_bytes)
pub fn expect_chip_available(min_bytes: u32, message: *u8) {
    let available: u32 = AvailMem(MEMF_CHIP)
    if available < min_bytes {
        __test_record_failure()
        write("  FAIL: %s - expected >= %lu bytes CHIP RAM, only %lu available\n",
              message, min_bytes, available)
    }
}

/// Check that FAST RAM is available (at least min_bytes)
pub fn expect_fast_available(min_bytes: u32, message: *u8) {
    let available: u32 = AvailMem(MEMF_FAST)
    if available < min_bytes {
        __test_record_failure()
        write("  FAIL: %s - expected >= %lu bytes FAST RAM, only %lu available\n",
              message, min_bytes, available)
    }
}

// ============================================================================
// P3: Library Version Checks
// ============================================================================
// TODO: Library version assertion functions are temporarily disabled due to
// code generation issues with the Library struct type in split compilation.
// The functions are preserved below but commented out until the code generator
// can properly handle struct types across compilation units.
//
// Functions to be restored:
// - expect_library_available(name, min_version, message) -> *u8
// - expect_library_version(lib_ptr, min_version, message)
// - with_library(name, min_version, test_fn)
