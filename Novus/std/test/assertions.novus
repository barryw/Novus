// std::test::assertions - Extended test assertions for Novus
//
// This module provides comprehensive assertion functions for testing Novus code.
// It extends the basic test.novus with:
// - String comparisons (Str, C strings)
// - Result/Option helpers
// - Comparison assertions (>, <, >=, <=)
// - Range assertions
// - Array/slice equality
// - Floating-point with epsilon
// - AmigaOS-specific validations (memory types, library versions)
//
// Usage:
// ```novus
// from std::test::assertions import *
//
// @test
// pub fn test_my_function() {
//     let result = some_operation()
//     expect_ok_i32(result, "operation should succeed")
//
//     let s: Str = "hello"
//     expect_str_eq(s, "hello", "strings should match")
// }
// ```

from std::io::file import write
from std::string::core import Str, strlen, strcmp
from std::core import Result, Option
from amiga::raw::exec import TypeOfMem, AvailMem
from amiga::raw::consts import MEMF_CHIP, MEMF_FAST
from std::test::test import __test_record_failure

// ============================================================================
// P1: String Assertions
// ============================================================================

/// Expect two Str values to be equal
pub fn expect_str_eq(actual: Str, expected: Str, message: *u8) {
    if !actual.equals(expected) {
        __test_record_failure()
        write("  FAIL: %s\n", message)
        write("    Expected: \"")
        write_str_bytes(expected)
        write("\"\n")
        write("    Got:      \"")
        write_str_bytes(actual)
        write("\"\n")
    }
}

/// Expect two Str values to NOT be equal
pub fn expect_str_ne(actual: Str, expected: Str, message: *u8) {
    if actual.equals(expected) {
        __test_record_failure()
        write("  FAIL: %s - strings should not be equal\n", message)
        write("    Both: \"")
        write_str_bytes(actual)
        write("\"\n")
    }
}

/// Expect two C strings to be equal (null-terminated)
pub fn expect_cstr_eq(actual: *u8, expected: *u8, message: *u8) {
    if strcmp(actual, expected) != 0 {
        __test_record_failure()
        write("  FAIL: %s\n", message)
        write("    Expected: \"%s\"\n", expected)
        write("    Got:      \"%s\"\n", actual)
    }
}

/// Expect string to contain substring
pub fn expect_str_contains(haystack: Str, needle: Str, message: *u8) {
    if !haystack.contains(needle) {
        __test_record_failure()
        write("  FAIL: %s\n", message)
        write("    String: \"")
        write_str_bytes(haystack)
        write("\"\n")
        write("    Should contain: \"")
        write_str_bytes(needle)
        write("\"\n")
    }
}

/// Expect string to NOT contain substring
pub fn expect_str_not_contains(haystack: Str, needle: Str, message: *u8) {
    if haystack.contains(needle) {
        __test_record_failure()
        write("  FAIL: %s - string should not contain substring\n", message)
        write("    String: \"")
        write_str_bytes(haystack)
        write("\"\n")
        write("    Contains: \"")
        write_str_bytes(needle)
        write("\"\n")
    }
}

/// Expect string to start with prefix
pub fn expect_str_starts_with(s: Str, prefix: Str, message: *u8) {
    if !s.starts_with(prefix) {
        __test_record_failure()
        write("  FAIL: %s\n", message)
        write("    String: \"")
        write_str_bytes(s)
        write("\"\n")
        write("    Should start with: \"")
        write_str_bytes(prefix)
        write("\"\n")
    }
}

/// Expect string to end with suffix
pub fn expect_str_ends_with(s: Str, suffix: Str, message: *u8) {
    if !s.ends_with(suffix) {
        __test_record_failure()
        write("  FAIL: %s\n", message)
        write("    String: \"")
        write_str_bytes(s)
        write("\"\n")
        write("    Should end with: \"")
        write_str_bytes(suffix)
        write("\"\n")
    }
}

/// Expect string to be empty
pub fn expect_str_empty(s: Str, message: *u8) {
    if !s.is_empty() {
        __test_record_failure()
        write("  FAIL: %s - expected empty string, got length %lu\n", message, s.len())
    }
}

/// Expect string to NOT be empty
pub fn expect_str_not_empty(s: Str, message: *u8) {
    if s.is_empty() {
        __test_record_failure()
        write("  FAIL: %s - expected non-empty string\n", message)
    }
}

/// Expect string length to equal expected value
pub fn expect_str_len(s: Str, expected_len: u32, message: *u8) {
    if s.len() != expected_len {
        __test_record_failure()
        write("  FAIL: %s - expected length %lu, got %lu\n", message, expected_len, s.len())
    }
}

// Helper to write Str bytes (handles non-null-terminated strings)
fn write_str_bytes(s: Str) {
    while var i < s.len() {
        let c: u8 = s.get(i).unwrap()
        write("%c", (c as i32))
        i = i + 1
    }
}

// ============================================================================
// P1: Result Assertions
// ============================================================================

/// Expect a Result<i32, i32> to be Ok
pub fn expect_ok_i32(result: Result<i32, i32>, message: *u8) {
    match result {
        Result::Ok(_) => {},
        Result::Err(e) => {
            __test_record_failure()
            write("  FAIL: %s - expected Ok, got Err(%ld)\n", message, e)
        },
    }
}

/// Expect a Result<i32, i32> to be Err
pub fn expect_err_i32(result: Result<i32, i32>, message: *u8) {
    match result {
        Result::Ok(v) => {
            __test_record_failure()
            write("  FAIL: %s - expected Err, got Ok(%ld)\n", message, v)
        },
        Result::Err(_) => {},
    }
}

/// Expect a Result<u32, u32> to be Ok
pub fn expect_ok_u32(result: Result<u32, u32>, message: *u8) {
    match result {
        Result::Ok(_) => {},
        Result::Err(e) => {
            __test_record_failure()
            write("  FAIL: %s - expected Ok, got Err(%lu)\n", message, e)
        },
    }
}

/// Expect a Result<u32, u32> to be Err
pub fn expect_err_u32(result: Result<u32, u32>, message: *u8) {
    match result {
        Result::Ok(v) => {
            __test_record_failure()
            write("  FAIL: %s - expected Err, got Ok(%lu)\n", message, v)
        },
        Result::Err(_) => {},
    }
}

/// Expect a Result<bool, i32> to be Ok
pub fn expect_ok_bool(result: Result<bool, i32>, message: *u8) {
    match result {
        Result::Ok(_) => {},
        Result::Err(e) => {
            __test_record_failure()
            write("  FAIL: %s - expected Ok, got Err(%ld)\n", message, e)
        },
    }
}

/// Expect a Result<(), i32> to be Ok (unit Result)
pub fn expect_ok_unit(result: Result<(), i32>, message: *u8) {
    match result {
        Result::Ok(_) => {},
        Result::Err(e) => {
            __test_record_failure()
            write("  FAIL: %s - expected Ok, got Err(%ld)\n", message, e)
        },
    }
}

/// Expect Result<i32, i32> to be Ok with specific value
pub fn expect_ok_eq_i32(result: Result<i32, i32>, expected: i32, message: *u8) {
    match result {
        Result::Ok(v) => {
            if v != expected {
                __test_record_failure()
                write("  FAIL: %s - expected Ok(%ld), got Ok(%ld)\n", message, expected, v)
            }
        },
        Result::Err(e) => {
            __test_record_failure()
            write("  FAIL: %s - expected Ok(%ld), got Err(%ld)\n", message, expected, e)
        },
    }
}

/// Expect Result<u32, u32> to be Ok with specific value
pub fn expect_ok_eq_u32(result: Result<u32, u32>, expected: u32, message: *u8) {
    match result {
        Result::Ok(v) => {
            if v != expected {
                __test_record_failure()
                write("  FAIL: %s - expected Ok(%lu), got Ok(%lu)\n", message, expected, v)
            }
        },
        Result::Err(e) => {
            __test_record_failure()
            write("  FAIL: %s - expected Ok(%lu), got Err(%lu)\n", message, expected, e)
        },
    }
}

