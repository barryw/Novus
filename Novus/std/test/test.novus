// std::test - Test framework for Novus
//
// This module provides test assertion functions and result tracking for the Novus test framework.
// Tests are marked with @test attribute and use expect! / expect_eq! style assertions.
//
// Unlike assert!(), expect!() records failures and continues execution so all tests run.
//
// The generic `expect_eq<T>` function works with any type that implements Eq + Display traits,
// allowing a single function to handle i32, u32, i16, u16, i8, u8, and bool comparisons.

from std::io::file import write
from std::core import Eq, Option, Result
from std::string::format import Display
from std::string::core import Str
from std::string::display import *  // Import Display implementations for primitives

// ============================================================================
// External Runtime Functions (for should_panic tests)
// ============================================================================

// These functions are implemented in runtime_errors.c
// They control test mode for catching panics in @test(should_panic) tests

extern fn __novus_test_set_mode(enabled: i32)
extern fn __novus_test_reset_panic()
extern fn __novus_test_did_panic() -> i32
extern fn __novus_test_get_panic_message() -> *u8

// ============================================================================
// Test Result Tracking
// ============================================================================

// Global mutable state for test results (accessed by generated test runner)
static var __test_failures: u32 = 0
static var __test_current_name: *u8 = null

// Called by generated test runner before each test
pub fn __test_begin(name: *u8) {
    __test_current_name = name
}

// Called by generated test runner to get failure count
pub fn __test_get_failures() -> u32 {
    return __test_failures
}

// Reset failure count (called at start of test run)
pub fn __test_reset() {
    __test_failures = 0
}

// ============================================================================
// Test Assertions
// ============================================================================

/// Expect a condition to be true. Records failure but continues execution.
/// Use this instead of assert!() in tests to see all failures.
pub fn expect(condition: bool, message: *u8) {
    if !condition {
        __test_failures++
        write("  FAIL: %s\n", message)
    }
}

/// Expect a condition to be true.
pub fn expect_true(condition: bool, message: *u8) {
    if !condition {
        __test_failures++
        write("  FAIL: %s - expected true, got false\n", message)
    }
}

/// Expect a condition to be false.
pub fn expect_false(condition: bool, message: *u8) {
    if condition {
        __test_failures++
        write("  FAIL: %s - expected false, got true\n", message)
    }
}

/// Expect two values to be equal. Works with any type implementing Eq + Display.
///
/// This is the preferred generic assertion function. It automatically handles
/// formatting for any type that implements the Display trait and records failures
/// in the test framework.
///
/// Example:
/// ```novus
/// expect_eq(42, 42, "values should match")
/// expect_eq(true, true, "booleans should match")
/// ```
pub fn expect_eq<T>(actual: T, expected: T, message: Str) where T: Eq + Display {
    if actual != expected {
        __test_record_failure()
        write("  FAIL: ")
        // Write message character by character since it's a Str
        while var i < message.len {
            let c = match message.get(i) {
                Option::Some(byte) => byte,
                Option::None => 0,
            }
            write("%c", (c as i32))
            i = i + 1
        }
        write(" - expected {expected}, got {actual}\n")
    }
}

/// Concise assertions for the common case. Detailed message overloads remain
/// available when a test needs more context.
pub fn expect_eq<T>(actual: T, expected: T) where T: Eq + Display {
    if actual != expected {
        __test_record_failure()
        write("  FAIL: expected {expected}, got {actual}\n")
    }
}

pub fn expect_ne<T>(actual: T, expected: T) where T: Eq + Display {
    if actual == expected {
        __test_record_failure()
        write("  FAIL: expected distinct values, got {actual}\n")
    }
}

pub fn expect_ok<T, E>(result: Result<T, E>) {
    match result {
        Result::Ok(_) => {},
        Result::Err(_) => {
            __test_record_failure()
            write("  FAIL: expected Ok, got Err\n")
        },
    }
}

pub fn expect_err<T, E>(result: Result<T, E>) {
    match result {
        Result::Ok(_) => {
            __test_record_failure()
            write("  FAIL: expected Err, got Ok\n")
        },
        Result::Err(_) => {},
    }
}

pub fn expect_some<T>(value: Option<T>) {
    match value {
        Option::Some(_) => {},
        Option::None => {
            __test_record_failure()
            write("  FAIL: expected Some, got None\n")
        },
    }
}

pub fn expect_none<T>(value: Option<T>) {
    match value {
        Option::Some(_) => {
            __test_record_failure()
            write("  FAIL: expected None, got Some\n")
        },
        Option::None => {},
    }
}

/// Expect a pointer to be null.
pub fn expect_null(ptr: *u8, message: *u8) {
    if ptr != null {
        __test_failures++
        write("  FAIL: %s - expected null, got 0x%08lx\n", message, (ptr as u32))
    }
}

/// Expect a pointer to be non-null.
pub fn expect_not_null(ptr: *u8, message: *u8) {
    if ptr == null {
        __test_failures++
        write("  FAIL: %s - expected non-null, got null\n", message)
    }
}

/// Unconditionally fail a test with a message.
pub fn fail(message: *u8) {
    __test_failures++
    write("  FAIL: %s\n", message)
}

/// Record a test failure (used by assertions module)
/// This allows the assertions module to increment the failure counter
/// without needing direct access to the static variable.
pub fn __test_record_failure() {
    __test_failures++
}
