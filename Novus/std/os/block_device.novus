// Safe, synchronous access to an AmigaOS block device.

from std::core import Error, From, Option, Result
from std::strings::core import Str
from std::memory::slice import MutSlice, Slice
from std::os::device import DeviceError, DeviceRequest
from std::ffi::amiga_consts import CMD_READ, CMD_WRITE, TD_GETGEOMETRY
from std::ffi::amiga_structs import DriveGeometry, IOStdReq

pub enum BlockDeviceError {
    Device(DeviceError),
    InvalidGeometry,
    InvalidBufferLength,
    OutOfRange,
    OffsetTooLarge,
    ShortRead(u32),
    ShortWrite(u32),
}

impl From<DeviceError> for BlockDeviceError {
    fn convert(consuming error: DeviceError) -> BlockDeviceError {
        return BlockDeviceError::Device(error)
    }
}

impl BlockDeviceError {
    pub fn message(&self) -> *u8 {
        match *self {
            BlockDeviceError::Device(_) => return "Block device command failed",
            BlockDeviceError::InvalidGeometry => return "Device reported invalid geometry",
            BlockDeviceError::InvalidBufferLength => return "Buffer length is not a whole number of blocks",
            BlockDeviceError::OutOfRange => return "Block range is outside the device",
            BlockDeviceError::OffsetTooLarge => return "Block offset exceeds 32-bit device I/O",
            BlockDeviceError::ShortRead(_) => return "Device returned a short read",
            BlockDeviceError::ShortWrite(_) => return "Device returned a short write",
        }
    }
}

impl Error for BlockDeviceError {
    fn message(&self) -> *u8 {
        return BlockDeviceError::message(self)
    }
}

pub struct BlockGeometry {
    block_bytes: u32,
    total_blocks: u32,
    cylinders: u32,
    heads: u32,
    blocks_per_track: u32,
}

impl BlockGeometry {
    pub fn block_bytes(&self) -> u32 { return self.block_bytes }
    pub fn total_blocks(&self) -> u32 { return self.total_blocks }
    pub fn cylinders(&self) -> u32 { return self.cylinders }
    pub fn heads(&self) -> u32 { return self.heads }
    pub fn blocks_per_track(&self) -> u32 { return self.blocks_per_track }
}

pub struct BlockDevice {
    request: DeviceRequest,
    geometry: BlockGeometry,
}

impl BlockDevice {
    pub fn open(name: Str, unit: u32) -> Result<BlockDevice, BlockDeviceError> {
        let request = DeviceRequest::open(name, unit, @sizeof(IOStdReq))?
        var device = BlockDevice {
            request: request,
            geometry: BlockGeometry {
                block_bytes: 0u32,
                total_blocks: 0u32,
                cylinders: 0u32,
                heads: 0u32,
                blocks_per_track: 0u32,
            },
        }
        device.load_geometry()?
        return Result::Ok(device)
    }

    /// Borrow the lower-level request without surrendering ownership.
    pub fn request(&self) -> &DeviceRequest {
        return &self.request
    }

    pub fn geometry(&self) -> &BlockGeometry {
        return &self.geometry
    }

    @suppress("W0002", "TD_GETGEOMETRY is an Exec u16 command generated as a u32 constant")
    fn load_geometry(&var self) -> Result<(), BlockDeviceError> {
        var raw = DriveGeometry {
            dg_SectorSize: 0u32,
            dg_TotalSectors: 0u32,
            dg_Cylinders: 0u32,
            dg_CylSectors: 0u32,
            dg_Heads: 0u32,
            dg_TrackSectors: 0u32,
            dg_BufMemType: 0u32,
            dg_DeviceType: 0u8,
            dg_Flags: 0u8,
            dg_Reserved: 0u16,
        }
        let io = (*IOStdReq)self.request.handle()
        io.io_Actual = 0u32
        io.io_Length = @sizeof(DriveGeometry)
        io.io_Data = (*u8)&var raw
        io.io_Offset = 0u32
        self.request.command((u16)TD_GETGEOMETRY)?

        if raw.dg_SectorSize == 0u32 || raw.dg_TotalSectors == 0u32 {
            return Result::Err(BlockDeviceError::InvalidGeometry)
        }
        self.geometry = BlockGeometry {
            block_bytes: raw.dg_SectorSize,
            total_blocks: raw.dg_TotalSectors,
            cylinders: raw.dg_Cylinders,
            heads: raw.dg_Heads,
            blocks_per_track: raw.dg_TrackSectors,
        }
        return Result::Ok(())
    }

    /// Read whole blocks into a bounded mutable buffer.
    @suppress("W0002", "CMD_READ is an Exec u16 command generated as a u32 constant")
    pub fn read_blocks(&var self, start_block: u32, consuming buffer: MutSlice<u8>) -> Result<u32, BlockDeviceError> {
        let length = buffer.len()
        if length == 0u32 {
            return Result::Ok(0u32)
        }

        let block_bytes = self.geometry.block_bytes
        if length % block_bytes != 0u32 {
            return Result::Err(BlockDeviceError::InvalidBufferLength)
        }
        let block_count = length / block_bytes
        if start_block > self.geometry.total_blocks || block_count > self.geometry.total_blocks - start_block {
            return Result::Err(BlockDeviceError::OutOfRange)
        }
        if start_block > $FFFFFFFFu32 / block_bytes {
            return Result::Err(BlockDeviceError::OffsetTooLarge)
        }

        var data = buffer
        let first = match data.get_mut(0u32) {
            Option::Some(first) => first,
            Option::None => return Result::Ok(0u32),
        }
        let io = (*IOStdReq)self.request.handle()
        io.io_Actual = 0u32
        io.io_Length = length
        unsafe {
            io.io_Data = (*u8)first
        }
        io.io_Offset = start_block * block_bytes
        self.request.command((u16)CMD_READ)?
        if io.io_Actual != length {
            return Result::Err(BlockDeviceError::ShortRead(io.io_Actual))
        }
        return Result::Ok(io.io_Actual)
    }

    /// Write whole blocks from a bounded immutable buffer.
    @suppress("W0002", "CMD_WRITE is an Exec u16 command generated as a u32 constant")
    pub fn write_blocks(&var self, start_block: u32, consuming buffer: Slice<u8>) -> Result<u32, BlockDeviceError> {
        let length = buffer.len()
        if length == 0u32 {
            return Result::Ok(0u32)
        }

        let block_bytes = self.geometry.block_bytes
        if length % block_bytes != 0u32 {
            return Result::Err(BlockDeviceError::InvalidBufferLength)
        }
        let block_count = length / block_bytes
        if start_block > self.geometry.total_blocks || block_count > self.geometry.total_blocks - start_block {
            return Result::Err(BlockDeviceError::OutOfRange)
        }
        if start_block > $FFFFFFFFu32 / block_bytes {
            return Result::Err(BlockDeviceError::OffsetTooLarge)
        }

        let first = match buffer.get(0u32) {
            Option::Some(first) => first,
            Option::None => return Result::Ok(0u32),
        }
        let io = (*IOStdReq)self.request.handle()
        io.io_Actual = 0u32
        io.io_Length = length
        unsafe {
            io.io_Data = (*u8)first
        }
        io.io_Offset = start_block * block_bytes
        self.request.command((u16)CMD_WRITE)?
        if io.io_Actual != length {
            return Result::Err(BlockDeviceError::ShortWrite(io.io_Actual))
        }
        return Result::Ok(io.io_Actual)
    }
}
