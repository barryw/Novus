// Novus Standard Library - DOS (High-Level)
// Namespace: std::dos
//
// High-level wrappers for dos.library functions
// For low-level FFI access, use std::ffi::dos

from std::core import Option, Result, Drop
from std::strings::core import Str
from std::ffi::amiga_structs import *
from std::error::errors import DosError
from std::os::tags import make_tags
from std::ffi::dos import SystemTagList, CreateNewProc, AllocDosObject, FreeDosObject
from std::ffi::dos import NewLoadSeg, UnLoadSeg
from std::ffi::dos import Open, Close, Read, Write, Seek, Lock, UnLock, Output
from std::ffi::dos import FGets, DeleteFile
from std::ffi::dos import Examine, IoErr, CreateDir
from std::ffi::amiga_consts import ACCESS_READ, MEMF_PUBLIC, MEMF_CLEAR

// Raw memory allocation (bypasses memory tracking system)
// Used for AmigaOS structures that need precise memory control
extern fn __novus_alloc_raw(size: u32, flags: u32) -> *u8
extern fn __novus_free_raw(ptr: *u8, size: u32)

// ============================================================================
// Command Execution
// ============================================================================

/// Execute a shell command with tag-based parameters
///
/// This is a high-level wrapper around SystemTagList.
///
/// Example:
/// ```novus
/// from std::dos import execute_command
/// from std::ffi::dos import SYS_Input, SYS_Output, SYS_Asynch, DOSTRUE
///
/// let result = execute_command("dir", &[
///     (SYS_Asynch, DOSTRUE),
/// ])?
/// ```
pub fn execute_command(command: Str, tags_ptr: *TagItem, count: u32) -> Result<i32, DosError> {
    var tag_list = make_tags(tags_ptr, count)
    defer {
        tag_list.drop()  // Automatic cleanup at scope exit
    }

    let result = SystemTagList(command.as_cstr(), (*TagItem)tag_list.as_ptr())

    // SystemTagList returns -1 on error
    return if result == -1 { Result::Err(DosError::Unknown) } else { Result::Ok(result) }
}

// ============================================================================
// Process Management
// ============================================================================

/// Create a new process with tag-based parameters
///
/// This is a high-level wrapper around CreateNewProc.
///
/// Example:
/// ```novus
/// from std::dos import CreateProcess
/// from std::ffi::dos import NP_Entry, NP_Name, NP_StackSize
///
/// let process = CreateProcess(&[
///     (NP_Entry, my_task_func as u32),
///     (NP_Name, "My Task".ptr as u32),
///     (NP_StackSize, 4096),
/// ])?
/// ```
pub fn CreateProcess(tags_ptr: *TagItem, count: u32) -> Result<*Process, DosError> {
    var tag_list = make_tags(tags_ptr, count)
    defer {
        tag_list.drop()  // Automatic cleanup at scope exit
    }

    let process = CreateNewProc((*TagItem)tag_list.as_ptr())

    // Check if process creation succeeded - CreateNewProc returns NULL on failure
    if (u32)process != 0 {
        return Result::Ok((*Process)process)
    }

    return Result::Err(DosError::Unknown)
}

// ============================================================================
// DOS Object Allocation
// ============================================================================

/// Allocate a DOS object (lock, filehandle, etc.) with tag-based parameters
///
/// This is a high-level wrapper around AllocDosObject.
///
/// Example:
/// ```novus
/// from std::dos import AllocDos
/// from std::ffi::dos import DOS_STDPKT, ADO_FH_Mode, MODE_NEWFILE
///
/// let obj = AllocDos(DOS_STDPKT, &[
///     (ADO_FH_Mode, MODE_NEWFILE),
/// ])?
///
/// defer {
///     FreeDosObject(DOS_STDPKT, obj)
/// }
/// ```
pub fn AllocDos(obj_type: u32, tags_ptr: *TagItem, count: u32) -> Result<*u8, DosError> {
    var tag_list = make_tags(tags_ptr, count)
    defer {
        tag_list.drop()  // Automatic cleanup at scope exit
    }

    let obj = AllocDosObject(obj_type, (*TagItem)tag_list.as_ptr())

    // Check if allocation succeeded (null check)
    if let o = obj {
        return Result::Ok(o)
    }

    return Result::Err(DosError::Unknown)
}

/// Load a program segment with tag-based parameters
///
/// This is a high-level wrapper around NewLoadSeg.
///
/// Example:
/// ```novus
/// from std::dos import load_segment
///
/// let seglist = load_segment("SYS:C/Dir", &[])?
/// defer {
///     UnLoadSeg(seglist)
/// }
/// ```
pub fn load_segment(file: Str, tags_ptr: *TagItem, count: u32) -> Result<i32, DosError> {
    var tag_list = make_tags(tags_ptr, count)
    defer {
        tag_list.drop()  // Automatic cleanup at scope exit
    }

    let seglist = NewLoadSeg(file.as_cstr(), (*TagItem)tag_list.as_ptr())

    // NewLoadSeg returns 0 on failure
    return if seglist == 0 { Result::Err(DosError::Unknown) } else { Result::Ok(seglist) }
}

// ============================================================================
// File I/O (Legacy Functions)
// ============================================================================
// Note: These wrappers use the low-level FFI functions. For proper error handling,
// check IoErr() after operations. Future enhancement: wrap with proper Result types.
//
// File handles are i32 values returned by Open()

/// Open a file for reading or writing
///
/// Mode should be one of:
/// - MODE_OLDFILE (1005): Open existing file read/write
/// - MODE_READWRITE (1004): Open with shared lock
///
/// Returns Some(handle) on success, None on failure.
/// Use IoErr() to get error details on failure.
///
/// Example:
/// ```novus
/// from std::dos import open_file, close_file
/// from std::ffi::dos import MODE_OLDFILE
///
/// match open_file("S:Startup-Sequence", MODE_OLDFILE) {
///     Some(fh) => {
///         defer {
///             close_file(fh)
///         }
///         // Read/write operations
///     },
///     None => {
///         // Handle error
///     }
/// }
/// ```
pub fn open_file(path: Str, mode: i32) -> Option<i32> {
    let fh = Open(path.as_cstr(), mode)
    return if fh == 0 { Option::None } else { Option::Some(fh) }
}

/// Close a file handle
///
/// Should be called for every successfully opened file.
/// Best used with defer for automatic cleanup.
pub fn close_file(fh: i32) {
    Close(fh)
    
}

/// Read bytes from file into buffer
///
/// Returns number of bytes actually read (may be less than requested).
/// Returns 0 on end-of-file or error (check IoErr() to distinguish).
///
/// Example:
/// ```novus
/// let buffer: [u8; 1024]
/// let bytes_read = read_file(fh, &buffer, 1024)
/// ```
@suppress("W0002", "AmigaOS dos.library Read() requires i32, but length is naturally u32. Safe: max file I/O is 2GB on classic Amiga")
pub fn read_file(fh: i32, buffer: *u8, length: u32) -> i32 {
    var result: i32 = 0
    result = Read(fh, buffer, (i32)length)

    return result
}

/// Write bytes from buffer to file
///
/// Returns number of bytes actually written.
/// Returns -1 on error (check IoErr() for details).
///
/// Example:
/// ```novus
/// let data = "Hello, Amiga!\n"
/// let bytes_written = write_file(fh, data.ptr, 14)
/// ```
@suppress("W0002", "AmigaOS dos.library Write() requires i32 parameter per FFI conventions. Safe for files <2GB")
pub fn write_file(fh: i32, buffer: *u8, length: u32) -> i32 {
    var result: i32 = 0
    result = Write(fh, buffer, (i32)length)

    return result
}

/// Seek to a position in the file
///
/// offset: position relative to mode
/// mode: one of OFFSET_BEGINNING (seek from start), OFFSET_CURRENT (from current pos), OFFSET_END (from end)
///
/// Returns old position, or -1 on error.
///
/// Example:
/// ```novus
/// // Seek to beginning
/// seek_file(fh, 0, OFFSET_BEGINNING)
///
/// // Seek 10 bytes forward from current position
/// seek_file(fh, 10, OFFSET_CURRENT)
///
/// // Seek to end
/// let file_size = seek_file(fh, 0, OFFSET_END)
/// ```
pub fn seek_file(fh: i32, position: i32, offset: i32) -> i32 {
    var result: i32 = 0
    result = Seek(fh, position, offset)

    return result
}

// ============================================================================
// Notes on Printf/FPrintf
// ============================================================================
//
// Printf and FPrintf are varargs functions that require special handling.
// For now, you can use the V* variants (VPrintf, VFPrintf) directly by
// building an argument array manually, or use simpler functions like PutStr.
//
// The V* functions take a format string and a pointer to an array of arguments.
// This requires careful manual construction of the argument array with correct
// sizing and alignment.
//
// Future enhancement: Add a Printf macro or special compiler support for
// format string handling.
//

// ============================================================================
// RAII Resource Wrappers (Automatic Cleanup)
// ============================================================================

/// OwnedFileHandle - RAII wrapper for DOS file handles
///
/// Automatically closes the file when the handle goes out of scope.
/// This prevents file handle leaks, which are a common source of bugs
/// (DOS limits each process to ~20 file handles).
///
/// Example:
/// ```novus
/// fn read_config() -> Result<String, DosError> {
///     let file = OwnedFileHandle::open("S:Startup-Sequence", MODE_OLDFILE)?;
///     // Use file...
///     // Automatically closed here!
/// }
/// ```
pub struct OwnedFileHandle {
    fh: i32,  // BPTR file handle (0 = invalid)
}

impl OwnedFileHandle {
    /// Open a file and return a RAII handle
    ///
    /// Mode should be one of:
    /// - MODE_OLDFILE (1005): Open existing file read/write
    /// - MODE_NEWFILE (1006): Create new file (truncate if exists)
    /// - MODE_READWRITE (1004): Open with shared lock
    ///
    /// Returns Err on failure (use IoErr() for details).
    pub fn open(path: Str, mode: i32) -> Result<OwnedFileHandle, DosError> {
        let fh = Open(path.as_cstr(), mode)
        return if fh == 0 { Result::Err(DosError::Unknown) } else { Result::Ok(OwnedFileHandle { fh: fh }) }
    }

    /// Get the raw BPTR handle for FFI calls
    pub fn handle(&self) -> i32 {
        return self.fh
    }

    /// Create OwnedFileHandle from raw BPTR (takes ownership)
    ///
    /// The handle will be automatically closed when the OwnedFileHandle is dropped.
    /// Only use this if you own the handle and it should be closed.
    ///
    /// DO NOT use for system-owned handles like Input(), Output(), Error().
    pub fn from_raw(fh: i32) -> OwnedFileHandle {
        return OwnedFileHandle { fh: fh }
    }

    /// Extract raw BPTR and prevent automatic close
    ///
    /// This transfers ownership to the caller. The caller is responsible
    /// for closing the file handle manually.
    ///
    /// Use this when passing ownership to another system or storing
    /// the handle beyond the current scope.
    pub fn into_raw(consuming self) -> i32 {
        return self.fh
    }

    /// Read bytes from file into buffer
    ///
    /// Returns number of bytes actually read.
    /// Returns 0 on EOF or error (check IoErr()).
    @suppress("W0002", "AmigaOS dos.library Read() requires i32 parameter per FFI conventions. Safe for files <2GB")
    pub fn read(&self, buffer: *u8, length: u32) -> i32 {
        return Read(self.fh, buffer, (i32)length)
    }

    /// Write bytes from buffer to file
    ///
    /// Returns number of bytes written.
    /// Returns -1 on error (check IoErr()).
    @suppress("W0002", "AmigaOS dos.library Write() requires i32 parameter per FFI conventions. Safe for files <2GB")
    pub fn write(&self, buffer: *u8, length: u32) -> i32 {
        return Write(self.fh, buffer, (i32)length)
    }

    /// Seek to a position in the file
    ///
    /// Returns old position, or -1 on error.
    pub fn seek(&self, position: i32, offset: i32) -> i32 {
        return Seek(self.fh, position, offset)
    }

    /// Write all bytes from buffer to file
    ///
    /// Unlike write(), this ensures all bytes are written or returns an error.
    /// Loops internally to handle partial writes.
    ///
    /// Returns Ok(()) on success, Err on failure.
    @suppress("W0002", "AmigaOS dos.library Write() requires i32 parameter per FFI conventions. Safe for files <2GB")
    pub fn write_all(&self, buffer: *u8, length: u32) -> Result<(), DosError> {
        var written: u32 = 0u32
        while written < length {
            let remaining = length - written
            let result = Write(self.fh, buffer + written, (i32)remaining)
            if result < 0 {
                return Result::Err(DosError::Unknown)
            }
            if result == 0 {
                // No progress - treat as error
                return Result::Err(DosError::Unknown)
            }
            written = written + (u32)result
        }
        return Result::Ok(())
    }

    /// Read all available bytes from file into buffer
    ///
    /// Reads up to `length` bytes. Returns the actual number of bytes read.
    /// Returns 0 on EOF. Returns Err on I/O error.
    @suppress("W0002", "AmigaOS dos.library Read() requires i32 parameter per FFI conventions. Safe for files <2GB")
    pub fn read_all(&self, buffer: *u8, length: u32) -> Result<u32, DosError> {
        var total_read: u32 = 0u32
        while total_read < length {
            let remaining = length - total_read
            let result = Read(self.fh, buffer + total_read, (i32)remaining)
            if result < 0 {
                return Result::Err(DosError::Unknown)
            }
            if result == 0 {
                // EOF reached
                break
            }
            total_read = total_read + (u32)result
        }
        return Result::Ok(total_read)
    }

    /// Read a line from the file
    ///
    /// Reads characters until newline, EOF, or buffer is full.
    /// The newline character is included in the buffer if present.
    /// Buffer is null-terminated.
    ///
    /// Returns the number of bytes read (excluding null terminator).
    /// Returns 0 on EOF. Returns Err on I/O error.
    pub fn read_line(&self, buffer: *u8, length: u32) -> Result<u32, DosError> {
        let result = FGets(self.fh, buffer, length)
        if (u32)result == 0u32 {
            // Could be EOF or error - check IoErr
            let err = IoErr()
            if err != 0 {
                return Result::Err(DosError::Unknown)
            }
            // EOF - return 0 bytes read
            return Result::Ok(0u32)
        }
        // Count bytes read (find null terminator)
        var count: u32 = 0u32
        while count < length {
            if buffer[count] == 0u8 {
                break
            }
            count = count + 1u32
        }
        return Result::Ok(count)
    }
}

// Automatic cleanup for OwnedFileHandle (RAII)
impl Drop for OwnedFileHandle {
    fn drop(&var self) {
        if self.fh != 0 {
            Close(self.fh)
            self.fh = 0
        }
    }
}

/// DirLockHandle - RAII wrapper for DOS directory locks
///
/// Automatically unlocks the directory when the lock goes out of scope.
/// This prevents lock leaks, which cause "Volume is in use" errors and
/// prevent floppy disk ejection.
///
/// Example:
/// ```novus
/// fn list_directory() -> Result<(), DosError> {
///     let lock = DirLockHandle::lock("SYS:", ACCESS_READ)?;
///     // Examine directory...
///     // Automatically unlocked here!
/// }
/// ```
pub struct DirLockHandle {
    lock: i32,  // BPTR lock (0 = invalid)
}

impl DirLockHandle {
    /// Lock a directory and return a RAII handle
    ///
    /// Type should be:
    /// - ACCESS_READ (-2): Shared read lock
    /// - ACCESS_WRITE (-1): Exclusive write lock
    ///
    /// Returns Err on failure (use IoErr() for details).
    pub fn lock(path: Str, lock_type: i32) -> Result<DirLockHandle, DosError> {
        let lock = Lock(path.as_cstr(), lock_type)
        return if lock == 0 { Result::Err(DosError::Unknown) } else { Result::Ok(DirLockHandle { lock: lock }) }
    }

    /// Get the raw BPTR lock for FFI calls
    pub fn handle(&self) -> i32 {
        return self.lock
    }

    /// Create DirLockHandle from raw BPTR (takes ownership)
    ///
    /// The lock will be automatically unlocked when the DirLockHandle is dropped.
    /// Only use this if you own the lock and it should be unlocked.
    pub fn from_raw(lock: i32) -> DirLockHandle {
        return DirLockHandle { lock: lock }
    }

    /// Extract raw BPTR and prevent automatic unlock
    ///
    /// This transfers ownership to the caller. The caller is responsible
    /// for unlocking the directory lock manually.
    ///
    /// Use this when passing ownership to another system or storing
    /// the lock beyond the current scope.
    pub fn into_raw(consuming self) -> i32 {
        return self.lock
    }
}

// Automatic cleanup for DirLockHandle (RAII)
impl Drop for DirLockHandle {
    fn drop(&var self) {
        if self.lock != 0 {
            UnLock(self.lock)
            self.lock = 0
        }
    }
}

// ============================================================================
// File System Helper Functions
// ============================================================================

/// Information about a file or directory
pub struct FileInfo {
    is_file: bool,
    is_directory: bool,
    size: i32,
    protection: i32,
}

/// Check if a file or directory exists
///
/// Uses Lock() to test existence - if lock succeeds, the path exists.
///
/// Example:
/// ```novus
/// if file_exists("RAM:test.txt") {
///     PutStr("File exists!\n")
/// }
/// ```
pub fn file_exists(path: Str) -> bool {
    let lock = Lock(path.as_cstr(), ACCESS_READ)
    if lock == 0 {
        return false
    }
    UnLock(lock)
    return true
}

/// Delete a file
///
/// Returns Ok(()) on success, Err on failure.
///
/// Example:
/// ```novus
/// match delete_file("RAM:temp.txt") {
///     Result::Ok(_) => PutStr("Deleted!\n"),
///     Result::Err(_) => PutStr("Failed to delete\n"),
/// }
/// ```
pub fn delete_file(path: Str) -> Result<(), DosError> {
    let result = DeleteFile(path.as_cstr())
    return if result == 0 { Result::Err(DosError::Unknown) } else { Result::Ok(()) }
}

/// Create a directory
///
/// Returns Ok(()) on success, Err on failure.
/// The created lock is automatically freed.
///
/// Example:
/// ```novus
/// match create_dir("RAM:NewDir") {
///     Result::Ok(_) => PutStr("Directory created!\n"),
///     Result::Err(_) => PutStr("Failed to create directory\n"),
/// }
/// ```
pub fn create_dir(path: Str) -> Result<(), DosError> {
    // Call DOS CreateDir
    let lock = CreateDir(path.as_cstr())
    if lock == 0 {
        return Result::Err(DosError::Unknown)
    }
    // CreateDir returns a lock to the new directory - we must unlock it
    UnLock(lock)
    return Result::Ok(())
}

/// Get information about a file or directory
///
/// Returns FileInfo on success, with is_file/is_directory flags,
/// file size, and protection bits.
///
/// Example:
/// ```novus
/// match file_info("RAM:test.txt") {
///     Result::Ok(info) => {
///         if info.is_file {
///             PutStr("It's a file!\n")
///         }
///     },
///     Result::Err(_) => PutStr("Failed to get info\n"),
/// }
/// ```
pub fn file_info(path: Str) -> Result<FileInfo, DosError> {
    let lock = Lock(path.as_cstr(), ACCESS_READ)
    if lock == 0 {
        return Result::Err(DosError::Unknown)
    }

    // FileInfoBlock: 260 bytes, MUST be longword (4-byte) aligned!
    // Use raw allocation to bypass memory tracking - tracking adds guard bytes
    // and deferred freeing which interferes with AmigaOS structures.
    let fib_ptr = __novus_alloc_raw(260u32, MEMF_PUBLIC | MEMF_CLEAR)
    if (u32)fib_ptr == 0u32 {
        UnLock(lock)
        return Result::Err(DosError::Unknown)
    }

    let result = Examine(lock, (*FileInfoBlock)fib_ptr)
    UnLock(lock)

    if result == 0 {
        __novus_free_raw(fib_ptr, 260u32)
        return Result::Err(DosError::Unknown)
    }

    // Read fields using pointer arithmetic
    // Layout: offset 0=DiskKey(4), 4=DirEntryType(4), 8=FileName(108),
    //         116=Protection(4), 120=EntryType(4), 124=Size(4)
    let dir_type_ptr = (*i32)(fib_ptr + 4u32)
    let protection_ptr = (*i32)(fib_ptr + 116u32)
    let size_ptr = (*i32)(fib_ptr + 124u32)

    let dir_type = unsafe { *dir_type_ptr }
    let protection = unsafe { *protection_ptr }
    let size = unsafe { *size_ptr }

    // Free the FileInfoBlock before returning
    __novus_free_raw(fib_ptr, 260u32)

    // fib_DirEntryType: < 0 = file, > 0 = directory
    let is_dir = dir_type > 0
    let is_file_flag = dir_type < 0

    return Result::Ok(FileInfo {
        is_file: is_file_flag,
        is_directory: is_dir,
        size: size,
        protection: protection,
    })
}

