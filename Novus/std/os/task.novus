// Novus Standard Library - Task System
// Namespace: std::os::task
//
// High-level task spawning with guaranteed signal handling.
// Tasks implement the Task trait and run in a managed event loop
// that automatically responds to break signals.

from std::core import Option, Result, Drop
from std::strings::core import Str
from std::error::errors import DosError
from std::os::timer import TimerHandle, Duration
from std::ffi::amiga_structs import Task, MsgPort, TagItem, Message, Process
from std::ffi::dos import CreateNewProc, CheckSignal, Input, Output
from std::ffi::exec import AllocMem, FreeMem, Wait, Signal, FindTask, SetSignal
from std::ffi::amiga_consts import NP_Entry, NP_StackSize, NP_Name, NP_Priority
from std::ffi::amiga_consts import NP_NotifyOnDeath, NP_Synchronous, NP_ExitData
from std::ffi::amiga_consts import NP_Input, NP_Output, NP_CloseInput, NP_CloseOutput
from std::ffi::amiga_consts import SIGBREAKF_CTRL_C, SIGBREAKF_CTRL_D
from std::ffi::amiga_consts import SIGBREAKF_CTRL_E, SIGBREAKF_CTRL_F
from std::ffi::amiga_consts import MEMF_PUBLIC, MEMF_CLEAR

// ============================================================================
// TaskRunner Trait
// ============================================================================

/// Trait for implementing cooperative tasks
///
/// The runtime controls the main loop and guarantees signal handling.
/// User code implements tick() which is called when signals arrive.
///
/// Example:
/// ```novus
/// struct Counter {
///     count: i32,
/// }
///
/// impl TaskRunner for Counter {
///     fn tick(&var self) -> bool {
///         self.count++
///         return self.count < 100
///     }
///
///     fn interval(&self) -> Option<Duration> {
///         return Option::Some(Duration::millis(100))
///     }
///
///     fn signals(&self) -> u32 {
///         return 0
///     }
///
///     fn cleanup(&var self) {
///         // cleanup code
///     }
/// }
/// ```
pub trait TaskRunner {
    /// Called when task signals arrive
    /// Return true to continue, false to exit
    fn tick(&var self) -> bool

    /// Optional: tick interval for timer-based tasks
    /// Return Some(duration) for periodic execution
    /// Return None for signal-based or one-shot tasks
    fn interval(&self) -> Option<Duration>

    /// Optional: signal mask for event-driven tasks
    /// Return the signals this task waits on (besides break signals)
    /// Return 0 for timer-based or one-shot tasks
    fn signals(&self) -> u32

    /// Optional: cleanup when task exits
    /// Called after tick() returns false or break signal received
    fn cleanup(&var self)
}

// ============================================================================
// ProcessHandle
// ============================================================================

/// Handle to a spawned task process
///
/// Provides methods to wait for completion, send signals, and check status.
/// The handle does NOT kill the process when dropped - the process continues
/// running independently.
///
/// Example:
/// ```novus
/// let handle = spawn_task_fn("Worker", my_func, 8192)?
///
/// // Do other work...
///
/// // Request termination
/// handle.break_ctrl_c()
///
/// // Wait for it to exit
/// let code = handle.wait()
/// ```
pub struct ProcessHandle {
    process: *u8,   // Raw pointer to Process (use *u8 to avoid struct generation issues)
    is_running: bool,
}

impl ProcessHandle {
    /// Check if the task is still running
    pub fn is_running(&self) -> bool {
        return self.is_running
    }

    /// Wait for the task to complete
    /// Returns 0 on success
    /// Note: This blocks the calling task
    pub fn wait(&var self) -> i32 {
        if !self.is_running {
            return 0
        }

        // Wait for process using synchronous wait
        // TODO: Implement proper death message handling
        // For now, we mark as not running

        self.is_running = false
        return 0
    }

    /// Send a signal to the task
    pub fn signal(&self, signal_mask: u32) -> bool {
        if !self.is_running {
            return false
        }

        // Process starts with Task struct
        let task = (*Task)self.process
        Signal(task, signal_mask)
        return true
    }

    /// Send CTRL-C break signal to request termination
    /// The task will exit cleanly at the next tick boundary
    pub fn break_ctrl_c(&self) -> bool {
        return self.signal(SIGBREAKF_CTRL_C)
    }

    /// Send CTRL-D break signal
    pub fn break_ctrl_d(&self) -> bool {
        return self.signal(SIGBREAKF_CTRL_D)
    }

    /// Get raw process pointer
    /// WARNING: Only valid while is_running() returns true
    pub fn handle(&self) -> *u8 {
        return self.process
    }
}

impl Drop for ProcessHandle {
    /// ProcessHandle does NOT kill the process on drop.
    /// The process continues running independently.
    /// Use break_ctrl_c() and wait() for graceful termination.
    fn drop(&var self) {
        // Just clear our reference - process continues running
        // DOS owns the process memory and handles cleanup
        self.process = (*u8)0
        self.is_running = false
    }
}

// ============================================================================
// Spawn Functions
// ============================================================================

/// Spawn a task using a function pointer
///
/// The function should implement a proper event loop with signal checking.
/// Use run_task_loop() or the helper functions to implement the loop correctly.
///
/// Example:
/// ```novus
/// fn my_worker() -> i32 {
///     let break_mask = SIGBREAKF_CTRL_C | SIGBREAKF_CTRL_D
///
///     forever {
///         // Wait for signals
///         let signals = Wait(break_mask)
///
///         if (signals & break_mask) != 0 {
///             break
///         }
///
///         // Do work...
///     }
///
///     return 0
/// }
///
/// let handle = spawn_task_fn("Worker", my_worker, 8192)?
/// ```
pub fn spawn_task_fn(name: Str, entry: fn() -> i32, stack_size: u32) -> Result<ProcessHandle, DosError> {
    return spawn_task_fn_impl(name, entry, Option::None, stack_size)
}

/// Spawn a task with a data pointer passed via startup message.
///
/// This uses the AmigaOS WBStartup protocol: the parent sends a message to the
/// child's pr_MsgPort containing the data pointer. The child retrieves it by
/// calling receive_startup_data() at the beginning of its entry function.
///
/// This is the standard AmigaOS pattern for passing arbitrary data to spawned
/// processes, used by Workbench and all proper AmigaOS applications.
///
/// Example:
/// ```novus
/// fn worker() -> i32 {
///     from std::os::task import receive_startup_data
///
///     // Get data pointer passed from parent
///     let port_opt = receive_startup_data()
///     let port = match port_opt {
///         Option::Some(ptr) => (*MsgPort)ptr,
///         Option::None => return 1,
///     }
///
///     // ... use port ...
///     return 0
/// }
///
/// let (tx, rx) = bounded_channel::<i32>()?
/// let port_ptr = (*u8)rx.port()
/// let handle = spawn_task_fn_with_ptr("Worker", worker, port_ptr, 8192)?
/// ```
pub fn spawn_task_fn_with_ptr(name: Str, entry: fn() -> i32, data: *u8, stack_size: u32) -> Result<ProcessHandle, DosError> {
    return spawn_task_fn_impl(name, entry, Option::Some(data), stack_size)
}

fn spawn_task_fn_impl(name: Str, entry: fn() -> i32, data: Option<*u8>, stack_size: u32) -> Result<ProcessHandle, DosError> {
    // Allocate tag list
    // Need: Entry, Name, StackSize, Priority, Output, CloseOutput, Input, CloseInput, NotifyOnDeath, TAG_DONE
    let tag_count: u32 = 11
    let tag_size = tag_count * @sizeof(TagItem)

    let tag_mem = unsafe { AllocMem(tag_size, MEMF_PUBLIC | MEMF_CLEAR) }
    if (u32)tag_mem == 0 {
        return Result::Err(DosError::Unknown)
    }

    let tag_ptr = (*TagItem)tag_mem
    var idx: u32 = 0

    // Entry point
    // Get raw address from function pointer by reading through *u32
    let entry_addr = *(*u32)&entry
    set_tag(tag_ptr, idx, NP_Entry, entry_addr)
    idx++

    // Name
    set_tag(tag_ptr, idx, NP_Name, (u32)name.as_cstr())
    idx++

    // Stack size
    set_tag(tag_ptr, idx, NP_StackSize, stack_size)
    idx++

    // Priority (inherit from parent)
    set_tag(tag_ptr, idx, NP_Priority, 0)
    idx++

    // Don't use NP_Cli - we don't need CLI features and it reserves pr_MsgPort
    // for DOS packet I/O which prevents us from using WBStartup-style messages.
    // The process still gets I/O handles via NP_Input/NP_Output.

    // Pass parent's output handle to child for DOS functions like VPrintf
    let parent_output = (u32)Output()
    set_tag(tag_ptr, idx, NP_Output, parent_output)
    idx++

    // Do NOT close parent's output handle when child exits
    set_tag(tag_ptr, idx, NP_CloseOutput, 0)
    idx++

    // Pass parent's input handle to child
    let parent_input = (u32)Input()
    set_tag(tag_ptr, idx, NP_Input, parent_input)
    idx++

    // Do NOT close parent's input handle when child exits
    set_tag(tag_ptr, idx, NP_CloseInput, 0)
    idx++

    // Enable death notification
    set_tag(tag_ptr, idx, NP_NotifyOnDeath, 1)
    idx++

    // If we have data to pass, use NP_ExitData tag to store it in pr_ExitData field.
    // This avoids using pr_MsgPort which is reserved for DOS packet I/O and uses
    // SIGF_DOS (signal bit 8). Sending messages to pr_MsgPort can corrupt DOS state.
    match data {
        Option::Some(data_ptr) => {
            set_tag(tag_ptr, idx, NP_ExitData, (u32)data_ptr)
            idx++
        },
        Option::None => {}
    }

    // Terminate tag list
    set_tag(tag_ptr, idx, 0, 0)

    // Create the child process
    let process = CreateNewProc(tag_ptr)

    // Free tag memory
    unsafe {
        FreeMem(tag_mem, tag_size)
    }

    // Check result - CreateNewProc returns null on failure
    if (u32)process == 0 {
        return Result::Err(DosError::Unknown)
    }

    return Result::Ok(ProcessHandle {
        process: process,
        is_running: true
    })
}

/// Helper to set a tag in the tag array
fn set_tag(tags: *TagItem, index: u32, tag: u32, data: u32) {
    let ptr = (u32)tags + (index * @sizeof(TagItem))
    let tag_ptr = (*TagItem)ptr
    let tag_ref = tag_ptr
    tag_ref.ti_Tag = tag
    tag_ref.ti_Data = data
}

/// Receive startup data sent by the parent process.
///
/// Call this at the beginning of your task's entry function if the task was
/// spawned with spawn_task_fn_with_ptr(). This retrieves the data pointer
/// that was passed via the startup message.
///
/// This function blocks until the startup message arrives (which should be
/// immediate if the parent sent it).
///
/// Returns Some(ptr) if data was sent, None if no startup message or timeout.
///
/// Example:
/// ```novus
/// fn worker() -> i32 {
///     // Get data pointer from parent
///     let data_opt = receive_startup_data()
///     let port = match data_opt {
///         Option::Some(ptr) => (*MsgPort)ptr,
///         Option::None => return 1,  // Error - no data received
///     }
///
///     // ... use port ...
///     return 0
/// }
/// ```
pub fn receive_startup_data() -> Option<*u8> {
    // Get our process structure
    let me = (*Process)FindTask((*u8)0)

    // Read data pointer from pr_ExitData field
    // This was set via NP_ExitData tag when the process was created
    let data = me.pr_ExitData

    if data == 0 {
        return Option::None
    }

    return Option::Some((*u8)data)
}

// ============================================================================
// Task Loop Helpers
// ============================================================================

/// Run a timer-based event loop
///
/// This implements the proper signal-based wait loop with timer wakeups.
/// Call this from your task's entry function for guaranteed signal handling.
///
/// Example:
/// ```novus
/// fn my_task_entry() -> i32 {
///     var state = MyState { count: 0 }
///     return run_timer_loop(Duration::millis(100), &state, tick_handler)
/// }
///
/// fn tick_handler(state: *MyState) -> bool {
///     state.count++
///     return state.count < 100
/// }
/// ```
pub fn run_timer_loop(interval: Duration, state: *u8, tick_fn: fn(*u8) -> bool) -> i32 {
    // Get break signal mask
    let break_mask = SIGBREAKF_CTRL_C | SIGBREAKF_CTRL_D

    // Open timer for periodic wake-up
    let timer_result = TimerHandle::microhz()
    match timer_result {
        Err(_) => {
            return 1  // Failed to open timer
        },
        Ok(timer) => {
            // Main event loop
            forever {
                // Wait for timer interval
                let delay_result = timer.delay(interval)
                match delay_result {
                    Err(_) => {
                        break
                    },
                    Ok(_) => {
                        // Check for break signals (non-blocking)
                        let signals = (u32)CheckSignal((i32)break_mask)
                        if (signals & break_mask) != 0 {
                            break
                        }

                        // Call user's tick
                        if !tick_fn(state) {
                            break
                        }
                    }
                }
            }

            return 0
        }
    }
}

/// Run a signal-based event loop
///
/// This implements the proper signal-based wait loop.
/// The task blocks until signals arrive, then calls the tick function.
///
/// Example:
/// ```novus
/// fn my_task_entry() -> i32 {
///     var state = MyState { port: my_port }
///     let port_signal = 1u32 << (u32)my_port.mp_SigBit
///     return run_signal_loop(port_signal, &state, message_handler)
/// }
///
/// fn message_handler(state: *MyState) -> bool {
///     // Process messages from port
///     return true
/// }
/// ```
pub fn run_signal_loop(task_signals: u32, state: *u8, tick_fn: fn(*u8) -> bool) -> i32 {
    // Get break signal mask
    let break_mask = SIGBREAKF_CTRL_C | SIGBREAKF_CTRL_D

    // Combined mask
    let wait_mask = break_mask | task_signals

    // Main event loop
    forever {
        // Block until signals arrive - CPU friendly!
        let signals = Wait(wait_mask)

        // Check for break signals first - guaranteed termination
        if (signals & break_mask) != 0 {
            break
        }

        // Call user's tick
        if !tick_fn(state) {
            break
        }
    }

    return 0
}

// ============================================================================
// Convenience Functions
// ============================================================================

/// Check if a break signal has been received
/// Returns true if CTRL-C or CTRL-D was signaled
pub fn should_exit() -> bool {
    let mask = SIGBREAKF_CTRL_C | SIGBREAKF_CTRL_D
    let signals = (u32)CheckSignal((i32)mask)
    return (signals & mask) != 0
}

/// Clear break signals
/// Call this after handling a break to reset the signal state
pub fn clear_break_signals() {
    let mask = SIGBREAKF_CTRL_C | SIGBREAKF_CTRL_D
    SetSignal(0, mask)
}

/// Get the combined break signal mask
pub fn break_signal_mask() -> u32 {
    return SIGBREAKF_CTRL_C | SIGBREAKF_CTRL_D
}
