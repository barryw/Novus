// Novus Standard Library - Typed Message Channels
// Namespace: std::sync::channel
//
// Actor-style message passing built on AmigaOS message ports.
//
// Channels provide type-safe, zero-copy message passing between tasks.
// They integrate naturally with the Amiga's signal system, allowing
// efficient Wait() on multiple message sources.
//
// # How It Works
//
// Under the hood, channels use Exec message ports:
// - Each Receiver owns a MsgPort with an allocated signal bit
// - Senders embed user data after the Message header
// - PutMsg/GetMsg handle the actual transfer
// - Wait() can combine channel signals with other event sources
//
// # Memory Model
//
// Messages are allocated by the sender, freed by the receiver after processing.
// This is zero-copy - the actual data is passed directly, not serialized.
//
// # Example - Simple Channel
//
// ```novus
// from std::sync::channel import channel, Sender, Receiver
//
// // Create a channel for i32 values
// let (tx, rx) = channel::<i32>()?
//
// // Send a value
// tx.send(42)?
//
// // Receive it (blocks if no message)
// let value = rx.recv()
// ```
//
// # Example - UI Updates from Background Task
//
// ```novus
// struct ProgressUpdate {
//     percent: i32,
//     done: bool,
// }
//
// fn main() -> i32 {
//     let app = MUIApp::new("Demo")
//     let progress = app.add_progress_bar()
//
//     // Create channel for updates
//     let (tx, rx) = channel::<ProgressUpdate>()?
//
//     // Spawn worker
//     spawn_task_fn("Worker", || {
//         for i in 0..100 {
//             do_work()
//             let _ = tx.send(ProgressUpdate { percent: i, done: false })
//         }
//         let _ = tx.send(ProgressUpdate { percent: 100, done: true })
//         return 0
//     })
//
//     // Event loop waits on both UI and channel
//     let mask = app.signals() | rx.signal()
//     forever {
//         let received = Wait(mask)
//
//         // Handle channel messages (safe - main task)
//         while let Option::Some(update) = rx.try_recv() {
//             progress.set_value(update.percent)
//             if update.done { break }
//         }
//
//         // Handle UI events
//         if app.check(received) {
//             match app.next_event() {
//                 Event::Quit => break,
//                 _ => {}
//             }
//         }
//     }
//     return 0
// }
// ```

from std::core import Option, Result, Drop, Error
from std::ffi::amiga_structs import MsgPort, Message, Node, Task
from std::ffi::exec import CreateMsgPort, DeleteMsgPort, PutMsg, GetMsg, ReplyMsg, Wait, Signal
from std::ffi::exec import AllocMem, FreeMem, FindTask, AllocSignal, FreeSignal
from std::ffi::amiga_consts import MEMF_PUBLIC, MEMF_CLEAR, MEMF_FAST

pub enum ChannelError {
    NoMemory,
    NoSignal,
    AlreadySent,
    AlreadyReceived,
    MissingReply,
}

impl ChannelError {
    pub fn message(&self) -> *u8 {
        return match *self {
            ChannelError::NoMemory => "Channel message allocation failed",
            ChannelError::NoSignal => "No Exec signal is available",
            ChannelError::AlreadySent => "One-shot value was already sent",
            ChannelError::AlreadyReceived => "One-shot value was already received",
            ChannelError::MissingReply => "Bounded channel reply was not received",
        }
    }
}

impl Error for ChannelError {
    fn message(&self) -> *u8 {
        return ChannelError::message(self)
    }
}

// ============================================================================
// Cross-Process Port Helpers
// ============================================================================

/// Take over a message port from another process.
///
/// When a message port is created, its `mp_SigTask` points to the creating task
/// and `mp_SigBit` is allocated from that task's signal set. To use a port in
/// a different process, the new process must "take over" the port by:
/// 1. Setting `mp_SigTask` to point to itself
/// 2. Allocating its own signal bit and updating `mp_SigBit`
///
/// This function does both steps and returns the new signal mask for Wait().
///
/// IMPORTANT: After calling this, the port will signal THIS process, not the
/// original creator. The original process should not use the port anymore.
///
/// Returns the signal mask to use with Wait(), or 0 on failure.
///
/// Example:
/// ```novus
/// fn worker() -> i32 {
///     let port_ptr = receive_startup_data().unwrap()
///     let port = (*MsgPort)port_ptr
///
///     // Take over the port so we receive signals
///     let signal_mask = take_over_port(port)
///     if signal_mask == 0 {
///         return 1  // Failed to allocate signal
///     }
///
///     // Now we can wait for messages
///     Wait(signal_mask)
///     let msg = GetMsg(port)
///     // ...
/// }
/// ```
pub fn take_over_port(port: *MsgPort) -> Result<u32, ChannelError> {
    // Get our own task pointer
    let my_task = FindTask(null)

    // Allocate our own signal bit (-1 means any available)
    let my_signal = AllocSignal(-1)
    if my_signal == -1 {
        return Result::Err(ChannelError::NoSignal)
    }

    // Take over the port - point it to us with our signal
    port.mp_SigTask = (*u8)my_task
    port.mp_SigBit = (u8)my_signal

    // Return the signal mask for Wait()
    return Result::Ok((u32)1 << (u32)my_signal)
}

// ============================================================================
// PortHandoff - Automatic Parent-Child Port Transfer
// ============================================================================

/// Data structure for automatic port handoff between parent and child processes.
///
/// This enables safe, race-free transfer of message port ownership from a parent
/// process to a spawned child. The handshake protocol ensures the child has fully
/// taken over the port before the parent attempts to send any messages.
///
/// # Protocol
///
/// 1. Parent allocates PortHandoff on stack, calls `PortHandoff::new(port)`
/// 2. Parent spawns child with pointer to PortHandoff
/// 3. Parent calls `handoff.wait_for_ready()` which blocks until child signals
/// 4. Child receives PortHandoff pointer, calls `complete_handoff()`
/// 5. `complete_handoff()` takes over port and signals parent
/// 6. Parent's `wait_for_ready()` returns, parent can now send safely
///
/// # Example - Parent Side
///
/// ```novus
/// let (tx, rx) = bounded_channel::<i32>()?
/// var handoff = PortHandoff::new(rx.port())
///
/// let handle = spawn_task_fn_with_ptr("Worker", worker_fn, (*u8)&handoff, 8192)?
///
/// // Wait for child to take over the port - REQUIRED before sending!
/// handoff.wait_for_ready()
///
/// // Now safe to send
/// tx.send(42)?
/// ```
///
/// # Example - Child Side
///
/// ```novus
/// fn worker_fn() -> i32 {
///     let handoff_ptr = (*PortHandoff)receive_startup_data().unwrap()
///
///     // Take over port and signal parent we're ready
///     let signal_mask = complete_handoff(handoff_ptr)
///     if signal_mask == 0 {
///         return 1  // Failed
///     }
///
///     // Now wait for messages using our signal
///     Wait(signal_mask)
///     // ...
/// }
/// ```
pub struct PortHandoff {
    /// The message port to transfer ownership of
    port: *MsgPort,
    /// Parent's task pointer (child signals this task when ready)
    parent_task: *Task,
    /// Signal bit the child should use to notify parent (parent allocates this)
    ready_signal_bit: i8,
}

impl PortHandoff {
    /// Create a new port handoff structure.
    ///
    /// Call this in the parent process before spawning the child.
    /// The parent must keep this structure alive until `wait_for_ready()` returns.
    pub fn new(port: *MsgPort) -> Result<PortHandoff, ChannelError> {
        let parent = (*Task)FindTask(null)

        // Allocate a signal bit for the child to use to notify us
        let sig_bit = AllocSignal(-1)

        if sig_bit == -1 {
            return Result::Err(ChannelError::NoSignal)
        }

        return Result::Ok(PortHandoff {
            port: port,
            parent_task: parent,
            ready_signal_bit: sig_bit,
        })
    }

    /// Wait for the child process to signal that it has taken over the port.
    ///
    /// This blocks until the child calls `complete_handoff()`. After this
    /// function returns, it is safe to send messages through the channel.
    ///
    /// Returns true if handoff succeeded, false if signal allocation failed.
    pub fn wait_for_ready(&var self) -> Result<(), ChannelError> {
        if self.ready_signal_bit == -1 {
            return Result::Err(ChannelError::NoSignal)
        }

        let signal_mask = (u32)1 << (u32)self.ready_signal_bit
        Wait(signal_mask)

        // Free our signal bit - we don't need it anymore
        FreeSignal(self.ready_signal_bit)
        self.ready_signal_bit = -1  // Mark as freed

        return Result::Ok(())
    }

    /// Get the port pointer (for passing to channel operations after handoff)
    pub fn port(&self) -> *MsgPort {
        return self.port
    }
}

impl Drop for PortHandoff {
    /// Free the signal bit if it wasn't already freed by wait_for_ready()
    fn drop(&var self) {
        if self.ready_signal_bit != -1 {
            FreeSignal(self.ready_signal_bit)
            self.ready_signal_bit = -1
        }
    }
}

/// Represents ownership of a taken-over port in a child process.
///
/// This struct tracks the signal bit allocated when taking over a port
/// and ensures proper cleanup when the child process is done.
///
/// When dropped, this struct:
/// 1. Deletes the transferred port
/// 2. Frees the child-owned signal bit through DeleteMsgPort
pub struct PortOwnership {
    /// The port we took over
    port: *MsgPort,
    /// The signal bit we allocated (for cleanup)
    signal_bit: i8,
    /// The signal mask for Wait()
    signal_mask: u32,
}

impl PortOwnership {
    /// Get the signal mask to use with Wait()
    pub fn signal(&self) -> u32 {
        return self.signal_mask
    }

    /// Get the port pointer
    pub fn port(&self) -> *MsgPort {
        return self.port
    }
}

impl Drop for PortOwnership {
    /// Clean up the port and signal bit
    fn drop(&var self) {
        // complete_handoff changed mp_SigTask/mp_SigBit to this task, so the
        // matching Exec cleanup now owns both the port allocation and signal.
        if (u32)self.port != 0 {
            DeleteMsgPort(self.port)
            self.port = null
            self.signal_bit = -1
        }
    }
}

/// Complete the port handoff from the child side.
///
/// This function:
/// 1. Takes over the port (allocates signal, updates mp_SigTask/mp_SigBit)
/// 2. Signals the parent that we're ready
///
/// Returns a PortOwnership that manages the signal bit lifetime, or None on failure.
/// The PortOwnership MUST be kept alive for the duration of port usage - when it
/// is dropped, the signal bit is freed.
///
/// Call this at the start of your child process after receiving the
/// PortHandoff pointer via `receive_startup_data()`.
///
/// # Example
/// ```novus
/// fn worker() -> i32 {
///     let handoff = (*PortHandoff)receive_startup_data().unwrap()
///
///     // Complete handoff - ownership tracks our signal bit
///     let ownership = match complete_handoff(handoff) {
///         Option::Some(o) => o,
///         Option::None => return 1,
///     }
///
///     // Use the port
///     Wait(ownership.signal())
///     let msg = GetMsg(ownership.port())
///     ReplyMsg(msg)
///
///     return 0
///     // Signal bit is freed here when ownership is dropped
/// }
/// ```
pub fn complete_handoff(handoff: *PortHandoff) -> Result<PortOwnership, ChannelError> {
    let port = handoff.port

    // Get our own task pointer
    let my_task = FindTask(null)

    // Allocate our own signal bit (-1 means any available)
    let my_signal = AllocSignal(-1)
    if my_signal == -1 {
        return Result::Err(ChannelError::NoSignal)
    }

    // Take over the port - point it to us with our signal
    port.mp_SigTask = (*u8)my_task
    port.mp_SigBit = (u8)my_signal

    let signal_mask = (u32)1 << (u32)my_signal

    // Signal the parent that we're ready
    if handoff.ready_signal_bit != -1 {
        let parent_signal_mask = (u32)1 << (u32)handoff.ready_signal_bit
        Signal(handoff.parent_task, parent_signal_mask)
    }

    return Result::Ok(PortOwnership {
        port: port,
        signal_bit: my_signal,
        signal_mask: signal_mask,
    })
}

// ============================================================================
// ChannelMessage - Internal message wrapper
// ============================================================================

// Message layout for channel data:
// - Message header (mn_Node, mn_ReplyPort, mn_Length)
// - User data T follows immediately after
//
// We can't use generics in struct layout directly, so we compute
// the total size dynamically and cast pointers appropriately.

// ============================================================================
// Sender<T> - Send end of a channel
// ============================================================================

/// The sending half of a channel.
///
/// Senders can be cloned to allow multiple producers sending to the same
/// receiver. Messages are delivered in FIFO order.
///
/// Senders do NOT own the message port - they just hold a pointer to it.
/// The Receiver owns the port and must outlive all Senders.
pub struct Sender<T> {
    port: *MsgPort,      // Destination port (owned by Receiver)
}

impl<T> Sender<T> {
    /// Get the size of a channel message including header and payload
    fn msg_size() -> u32 {
        return @sizeof(Message) + @sizeof(T)
    }

    /// Get pointer to payload data within a message
    fn msg_data(msg: *Message) -> *T {
        let data_offset = @sizeof(Message)
        let data_ptr = (u32)msg + data_offset
        return (*T)data_ptr
    }

    /// Create a sender from a raw message port pointer.
    ///
    /// This is typically used when passing channel access to spawned tasks
    /// via global variables or task user data.
    pub fn from_port(port: *MsgPort) -> Sender<T> {
        return Sender { port: port }
    }

    /// Send a value through the channel.
    ///
    /// This allocates a message, copies the value into it, and sends it
    /// to the receiver's port. The receiver is responsible for freeing
    /// the message after processing.
    ///
    /// This is non-blocking - it returns immediately after queuing the message.
    /// The receiver will be signaled automatically.
    ///
    /// Returns Ok when queued or the allocation error.
    pub fn send(&self, value: T) -> Result<(), ChannelError> {
        // Allocate message with space for payload
        let size = Sender::<T>::msg_size()
        let msg_mem = unsafe { AllocMem(size, MEMF_FAST | MEMF_CLEAR) }
        if (u32)msg_mem == 0 {
            return Result::Err(ChannelError::NoMemory)
        }

        let msg = (*Message)msg_mem

        // Initialize message header
        msg.mn_Node.ln_Type = 5  // NT_MESSAGE
        msg.mn_ReplyPort = null  // No reply expected
        msg.mn_Length = (u16)size

        // Copy payload data
        let data_ptr = Sender::<T>::msg_data(msg)
        *data_ptr = value

        // Send it - receiver will be signaled
        PutMsg(self.port, msg)
        return Result::Ok(())
    }

    /// Clone this sender to create another sender to the same channel.
    ///
    /// Multiple senders can send to the same receiver.
    pub fn clone(&self) -> Sender<T> {
        return Sender { port: self.port }
    }

    /// Check if the channel is still valid.
    ///
    /// Returns false if the receiver has been dropped.
    pub fn is_valid(&self) -> bool {
        return (u32)self.port != 0
    }
}

// Sender does NOT implement Drop - it doesn't own the port
// The Receiver owns the port and handles cleanup

// ============================================================================
// Receiver<T> - Receive end of a channel
// ============================================================================

/// The receiving half of a channel.
///
/// Only one receiver exists per channel. It owns the message port and
/// must outlive all senders.
///
/// The receiver can be combined with other signal sources in Wait()
/// for efficient event-driven programming.
pub struct Receiver<T> {
    port: *MsgPort,      // Our message port (owned)
    signal_mask: u32,    // Precomputed signal mask for Wait()
}

impl<T> Receiver<T> {
    /// Get the size of a channel message including header and payload
    fn msg_size() -> u32 {
        return @sizeof(Message) + @sizeof(T)
    }

    /// Get pointer to payload data within a message
    fn msg_data(msg: *Message) -> *T {
        let data_offset = @sizeof(Message)
        let data_ptr = (u32)msg + data_offset
        return (*T)data_ptr
    }

    /// Receive a message, blocking if none available.
    ///
    /// This blocks the current task until a message arrives.
    /// For non-blocking receive, use try_recv().
    ///
    /// Returns the received value. The message memory is freed automatically.
    pub fn recv(&self) -> T {
        // Wait for a message to arrive
        // Loop because WaitPort might return due to other signals
        forever {
            // Check if message already waiting
            let msg = GetMsg(self.port)
            if (u32)msg != 0 {
                // Extract data and free message
                let data_ptr = Receiver::<T>::msg_data(msg)
                let value = *data_ptr
                let size = Receiver::<T>::msg_size()
                unsafe { FreeMem((*u8)msg, size) }
                return value
            }

            // No message - wait for signal
            // We use Wait on our signal bit rather than WaitPort
            // so the caller could potentially combine with other signals
            Wait(self.signal_mask)
        }
    }

    /// Try to receive a message without blocking.
    ///
    /// Returns Some(value) if a message was waiting, None otherwise.
    /// The message memory is freed automatically.
    pub fn try_recv(&self) -> Option<T> {
        let msg = GetMsg(self.port)
        if (u32)msg == 0 {
            return Option::None
        }

        // Extract data and free message
        let data_ptr = Receiver::<T>::msg_data(msg)
        let value = *data_ptr
        let size = Receiver::<T>::msg_size()
        unsafe { FreeMem((*u8)msg, size) }
        return Option::Some(value)
    }

    /// Get the signal mask for this channel.
    ///
    /// Use this to combine the channel with other signal sources in Wait().
    ///
    /// Example:
    /// ```novus
    /// let mask = rx.signal() | app.signals() | timer_signal
    /// let received = Wait(mask)
    /// if (received & rx.signal()) != 0 {
    ///     // Channel has messages
    /// }
    /// ```
    pub fn signal(&self) -> u32 {
        return self.signal_mask
    }

    /// Check if signals indicate this channel has messages.
    ///
    /// Use after Wait() to check if this channel was signaled.
    pub fn check(&self, signals: u32) -> bool {
        return (signals & self.signal_mask) != 0
    }

    /// Drain all pending messages, calling a function on each.
    ///
    /// This is useful in event loops where you want to process all
    /// queued messages before going back to Wait().
    ///
    /// Example:
    /// ```novus
    /// rx.drain(|update| {
    ///     progress.set_value(update.percent)
    /// })
    /// ```
    pub fn drain(&self, handler: fn(T)) {
        var has_more = true
        while has_more {
            match self.try_recv() {
                Option::Some(value) => handler(value),
                Option::None => {
                    has_more = false
                },
            }
        }
    }
}

impl<T> Drop for Receiver<T> {
    fn drop(&var self) {
        // Drain any remaining messages to free their memory
        var draining = true
        while draining {
            let msg = GetMsg(self.port)
            if (u32)msg == 0 {
                draining = false
            } else {
                let size = Receiver::<T>::msg_size()
                unsafe { FreeMem((*u8)msg, size) }
            }
        }

        // Delete the message port
        if (u32)self.port != 0 {
            DeleteMsgPort(self.port)
            self.port = null
        }
    }
}

// ============================================================================
// Channel Creation
// ============================================================================

/// Create a new channel for type T.
///
/// Returns a (Sender, Receiver) pair. The sender can be cloned to allow
/// multiple producers. Only one receiver exists per channel.
///
/// The receiver owns the underlying message port and must be kept alive
/// as long as any senders exist.
///
/// Example:
/// ```novus
/// let (tx, rx) = channel::<i32>()?
/// tx.send(42)?
/// let value = rx.recv()  // value == 42
/// ```
pub fn channel<T>() -> Result<(Sender<T>, Receiver<T>), ChannelError> {
    // Create the message port
    let port = CreateMsgPort()
    if (u32)port == 0 {
        return Result::Err(ChannelError::NoMemory)
    }

    // Compute signal mask from port's signal bit
    let signal_bit = port.mp_SigBit
    let signal_mask = (u32)1 << (u32)signal_bit

    let sender = Sender { port: port }
    let receiver = Receiver {
        port: port,
        signal_mask: signal_mask,
    }

    return Result::Ok((sender, receiver))
}

// ============================================================================
// Bounded Channel - limits queue depth with backpressure
// ============================================================================

/// A bounded sender that blocks when the channel is full.
///
/// Unlike unbounded Sender, this provides backpressure - if the receiver
/// can't keep up, the sender will block until space is available.
///
/// This uses a reply port mechanism: sender waits for acknowledgment
/// from the receiver before returning from send().
pub struct BoundedSender<T> {
    port: *MsgPort,          // Destination port (owned by Receiver)
    reply_port: *MsgPort,    // Our reply port for acks
    reply_signal: u32,       // Signal mask for reply port
}

impl<T> BoundedSender<T> {
    /// Get the size of a channel message including header and payload
    fn msg_size() -> u32 {
        return @sizeof(Message) + @sizeof(T)
    }

    /// Get pointer to payload data within a message
    fn msg_data(msg: *Message) -> *T {
        let data_offset = @sizeof(Message)
        let data_ptr = (u32)msg + data_offset
        return (*T)data_ptr
    }

    /// Send a value through the channel, blocking until received.
    ///
    /// This blocks until the receiver has processed the message,
    /// providing backpressure when the receiver is slow.
    ///
    /// Returns Ok when the receiver acknowledges the message.
    pub fn send(&self, value: T) -> Result<(), ChannelError> {
        // Allocate message with space for payload
        let size = BoundedSender::<T>::msg_size()
        let msg_mem = unsafe { AllocMem(size, MEMF_FAST | MEMF_CLEAR) }
        if (u32)msg_mem == 0 {
            return Result::Err(ChannelError::NoMemory)
        }

        let msg = (*Message)msg_mem

        // Initialize message header - set reply port for synchronous send
        msg.mn_Node.ln_Type = 5  // NT_MESSAGE
        msg.mn_ReplyPort = self.reply_port  // Request reply
        msg.mn_Length = (u16)size

        // Copy payload data
        let data_ptr = BoundedSender::<T>::msg_data(msg)
        *data_ptr = value

        // Send it
        PutMsg(self.port, msg)

        // Wait for reply (receiver acknowledgment)
        Wait(self.reply_signal)

        // Get the replied message
        let replied = GetMsg(self.reply_port)
        if (u32)replied != 0 {
            // Free the message memory
            unsafe { FreeMem((*u8)replied, size) }
            return Result::Ok(())
        }

        return Result::Err(ChannelError::MissingReply)
    }

    /// Try to send a value without blocking.
    ///
    /// This sends the message but does not wait for acknowledgment.
    /// Useful for single-threaded scenarios or when you don't need backpressure.
    ///
    /// Note: The receiver still needs to call recv() or try_recv() to process it.
    ///
    /// Returns Ok when queued or the allocation error.
    pub fn try_send(&self, value: T) -> Result<(), ChannelError> {
        // Allocate message with space for payload
        let size = BoundedSender::<T>::msg_size()
        let msg_mem = unsafe { AllocMem(size, MEMF_FAST | MEMF_CLEAR) }
        if (u32)msg_mem == 0 {
            return Result::Err(ChannelError::NoMemory)
        }

        let msg = (*Message)msg_mem

        // Non-blocking sends do not request an acknowledgment. The receiver
        // owns and frees this message after copying the value.
        msg.mn_Node.ln_Type = 5  // NT_MESSAGE
        msg.mn_ReplyPort = null
        msg.mn_Length = (u16)size

        // Copy payload data
        let data_ptr = BoundedSender::<T>::msg_data(msg)
        *data_ptr = value

        // Send it without waiting
        PutMsg(self.port, msg)

        return Result::Ok(())
    }

    /// Check if the channel is still valid.
    pub fn is_valid(&self) -> bool {
        return (u32)self.port != 0
    }
}

impl<T> Drop for BoundedSender<T> {
    fn drop(&var self) {
        // Clean up our reply port
        if (u32)self.reply_port != 0 {
            // Drain any pending replies
            var draining = true
            while draining {
                let msg = GetMsg(self.reply_port)
                if (u32)msg == 0 {
                    draining = false
                } else {
                    let size = BoundedSender::<T>::msg_size()
                    unsafe { FreeMem((*u8)msg, size) }
                }
            }
            DeleteMsgPort(self.reply_port)
            self.reply_port = null
        }
    }
}

/// A bounded receiver that acknowledges messages.
///
/// Works with BoundedSender to provide backpressure.
/// Each recv() automatically acknowledges the message, unblocking the sender.
pub struct BoundedReceiver<T> {
    port: *MsgPort,      // Our message port (owned)
    signal_mask: u32,    // Precomputed signal mask for Wait()
}

impl<T> BoundedReceiver<T> {
    /// Get the size of a channel message including header and payload
    fn msg_size() -> u32 {
        return @sizeof(Message) + @sizeof(T)
    }

    /// Get pointer to payload data within a message
    fn msg_data(msg: *Message) -> *T {
        let data_offset = @sizeof(Message)
        let data_ptr = (u32)msg + data_offset
        return (*T)data_ptr
    }

    /// Receive a message, blocking if none available.
    ///
    /// This acknowledges the message after copying its value, unblocking the
    /// sender before returning.
    pub fn recv(&var self) -> T {
        // Wait for a message
        forever {
            let msg = GetMsg(self.port)
            if (u32)msg != 0 {
                // Extract data
                let data_ptr = BoundedReceiver::<T>::msg_data(msg)
                let value = *data_ptr

                // A blocking sender owns the message after acknowledgment.
                if (u32)msg.mn_ReplyPort != 0 {
                    ReplyMsg(msg)
                } else {
                    // No reply needed, free immediately
                    let size = BoundedReceiver::<T>::msg_size()
                    unsafe { FreeMem((*u8)msg, size) }
                }

                return value
            }

            Wait(self.signal_mask)
        }
    }

    /// Try to receive without blocking.
    ///
    /// Acknowledges this message after copying its value.
    pub fn try_recv(&var self) -> Option<T> {
        let msg = GetMsg(self.port)
        if (u32)msg == 0 {
            return Option::None
        }

        let data_ptr = BoundedReceiver::<T>::msg_data(msg)
        let value = *data_ptr

        if (u32)msg.mn_ReplyPort != 0 {
            ReplyMsg(msg)
        } else {
            let size = BoundedReceiver::<T>::msg_size()
            unsafe { FreeMem((*u8)msg, size) }
        }

        return Option::Some(value)
    }

    /// Get the signal mask for this channel.
    pub fn signal(&self) -> u32 {
        return self.signal_mask
    }

    /// Check if signals indicate this channel has messages.
    pub fn check(&self, signals: u32) -> bool {
        return (signals & self.signal_mask) != 0
    }

    /// Get the underlying message port pointer.
    ///
    /// This is useful for passing to spawned tasks via PortHandoff.
    pub fn port(&self) -> *MsgPort {
        return self.port
    }

    /// Detach the port from this receiver, transferring ownership.
    ///
    /// After calling this, the receiver will NOT delete the port when dropped.
    /// Use this when handing off the port to a child process via PortHandoff.
    ///
    /// The child process becomes responsible for the port's signal bit.
    /// The parent should NOT use the receiver after detaching.
    ///
    /// Returns the detached port pointer.
    ///
    /// Example:
    /// ```novus
    /// let (tx, rx) = bounded_channel::<i32>()?
    /// var handoff = PortHandoff::new(rx.port())
    /// rx.detach()  // Don't delete port when rx is dropped
    /// spawn_task_fn_with_ptr("Worker", worker, (*u8)&handoff, 8192)?
    /// handoff.wait_for_ready()
    /// tx.send(42)?
    /// ```
    pub fn detach(&var self) -> *MsgPort {
        let p = self.port

        // Free the signal bit that CreateMsgPort allocated for us.
        // The child will allocate its own signal when it takes over.
        // We must do this BEFORE the child takes over, otherwise we'd
        // be freeing the child's signal.
        if (u32)p != 0 {
            let sig_bit = p.mp_SigBit
            FreeSignal((i8)sig_bit)
        }

        self.port = null
        self.signal_mask = 0
        return p
    }
}

impl<T> Drop for BoundedReceiver<T> {
    fn drop(&var self) {
        // If port was detached (transferred to child), nothing to clean up
        if (u32)self.port == 0 {
            return
        }

        // Drain remaining messages
        var draining = true
        while draining {
            let msg = GetMsg(self.port)
            if (u32)msg == 0 {
                draining = false
            } else {
                // Reply if needed, then free
                if (u32)msg.mn_ReplyPort != 0 {
                    ReplyMsg(msg)
                } else {
                    let size = BoundedReceiver::<T>::msg_size()
                    unsafe { FreeMem((*u8)msg, size) }
                }
            }
        }

        if (u32)self.port != 0 {
            DeleteMsgPort(self.port)
            self.port = null
        }
    }
}

/// Create a bounded (synchronous) channel.
///
/// Unlike unbounded channels, bounded channels provide backpressure:
/// the sender blocks until the receiver has processed the message.
///
/// This is useful when:
/// - You need to ensure the receiver keeps up with the sender
/// - You want request/response semantics
/// - You need to limit memory usage from queued messages
///
/// Example:
/// ```novus
/// let (tx, rx) = bounded_channel::<WorkItem>()?
///
/// // Sender blocks until receiver processes each item
/// tx.send(work1)?  // Blocks until recv() called
/// tx.send(work2)?  // Blocks until recv() called
///
/// // Receiver processes at its own pace
/// let item = rx.recv()  // Unblocks sender
/// ```
pub fn bounded_channel<T>() -> Result<(BoundedSender<T>, BoundedReceiver<T>), ChannelError> {
    // Create receiver's port
    let recv_port = CreateMsgPort()
    if (u32)recv_port == 0 {
        return Result::Err(ChannelError::NoMemory)
    }

    // Create sender's reply port
    let reply_port = CreateMsgPort()
    if (u32)reply_port == 0 {
        DeleteMsgPort(recv_port)
        return Result::Err(ChannelError::NoMemory)
    }

    let recv_signal = (u32)1 << (u32)recv_port.mp_SigBit
    let reply_signal = (u32)1 << (u32)reply_port.mp_SigBit

    let sender = BoundedSender {
        port: recv_port,
        reply_port: reply_port,
        reply_signal: reply_signal,
    }

    let receiver = BoundedReceiver {
        port: recv_port,
        signal_mask: recv_signal,
    }

    return Result::Ok((sender, receiver))
}

// ============================================================================
// One-Shot Channel - single value for request/response
// ============================================================================

/// A one-shot sender that sends exactly one value.
///
/// After sending, the sender is consumed and cannot be used again.
/// This is useful for returning results from async operations.
pub struct OneshotSender<T> {
    port: *MsgPort,      // Destination port (owned by Receiver)
    sent: bool,          // Track if already sent
}

impl<T> OneshotSender<T> {
    /// Get the size of a channel message including header and payload
    fn msg_size() -> u32 {
        return @sizeof(Message) + @sizeof(T)
    }

    /// Get pointer to payload data within a message
    fn msg_data(msg: *Message) -> *T {
        let data_offset = @sizeof(Message)
        let data_ptr = (u32)msg + data_offset
        return (*T)data_ptr
    }

    /// Send the value, consuming the sender.
    ///
    /// This can only be called once.
    pub fn send(&var self, value: T) -> Result<(), ChannelError> {
        if self.sent {
            return Result::Err(ChannelError::AlreadySent)
        }

        let size = OneshotSender::<T>::msg_size()
        let msg_mem = unsafe { AllocMem(size, MEMF_FAST | MEMF_CLEAR) }
        if (u32)msg_mem == 0 {
            return Result::Err(ChannelError::NoMemory)
        }

        let msg = (*Message)msg_mem
        msg.mn_Node.ln_Type = 5
        msg.mn_ReplyPort = null
        msg.mn_Length = (u16)size

        let data_ptr = OneshotSender::<T>::msg_data(msg)
        *data_ptr = value

        PutMsg(self.port, msg)
        self.sent = true
        return Result::Ok(())
    }

    /// Check if already sent.
    pub fn is_sent(&self) -> bool {
        return self.sent
    }
}

// OneshotSender doesn't own the port, no Drop needed

/// A one-shot receiver that receives exactly one value.
///
/// Blocks until the value arrives, then the channel is complete.
pub struct OneshotReceiver<T> {
    port: *MsgPort,      // Our message port (owned)
    signal_mask: u32,
    received: bool,
}

impl<T> OneshotReceiver<T> {
    /// Get the size of a channel message including header and payload
    fn msg_size() -> u32 {
        return @sizeof(Message) + @sizeof(T)
    }

    /// Get pointer to payload data within a message
    fn msg_data(msg: *Message) -> *T {
        let data_offset = @sizeof(Message)
        let data_ptr = (u32)msg + data_offset
        return (*T)data_ptr
    }

    /// Receive the value, blocking until it arrives.
    ///
    /// Can only be called once.
    pub fn recv(&var self) -> Result<T, ChannelError> {
        if self.received {
            return Result::Err(ChannelError::AlreadyReceived)
        }

        forever {
            let msg = GetMsg(self.port)
            if (u32)msg != 0 {
                let data_ptr = OneshotReceiver::<T>::msg_data(msg)
                let value = *data_ptr
                let size = OneshotReceiver::<T>::msg_size()
                unsafe { FreeMem((*u8)msg, size) }
                self.received = true
                return Result::Ok(value)
            }

            Wait(self.signal_mask)
        }
    }

    /// Try to receive without blocking.
    pub fn try_recv(&var self) -> Result<Option<T>, ChannelError> {
        if self.received {
            return Result::Err(ChannelError::AlreadyReceived)
        }

        let msg = GetMsg(self.port)
        if (u32)msg == 0 {
            return Result::Ok(Option::None)
        }

        let data_ptr = OneshotReceiver::<T>::msg_data(msg)
        let value = *data_ptr
        let size = OneshotReceiver::<T>::msg_size()
        unsafe { FreeMem((*u8)msg, size) }
        self.received = true
        return Result::Ok(Option::Some(value))
    }

    /// Get the signal mask for this channel.
    pub fn signal(&self) -> u32 {
        return self.signal_mask
    }

    /// Check if the value has been received.
    pub fn is_complete(&self) -> bool {
        return self.received
    }
}

impl<T> Drop for OneshotReceiver<T> {
    fn drop(&var self) {
        // Drain any pending message
        if !self.received {
            let msg = GetMsg(self.port)
            if (u32)msg != 0 {
                let size = OneshotReceiver::<T>::msg_size()
                unsafe { FreeMem((*u8)msg, size) }
            }
        }

        if (u32)self.port != 0 {
            DeleteMsgPort(self.port)
            self.port = null
        }
    }
}

/// Create a one-shot channel for a single value.
///
/// One-shot channels are useful for:
/// - Returning results from spawned tasks
/// - Request/response patterns where you need exactly one reply
/// - Futures/promises style async patterns
///
/// Example:
/// ```novus
/// let (tx, rx) = oneshot::<i32>()?
///
/// // Spawn task that computes a result
/// spawn_task_fn("Compute", || {
///     let result = expensive_computation()
///     let _ = tx.send(result)
///     return 0
/// })
///
/// // Wait for result
/// let value = rx.recv()
/// ```
pub fn oneshot<T>() -> Result<(OneshotSender<T>, OneshotReceiver<T>), ChannelError> {
    let port = CreateMsgPort()
    if (u32)port == 0 {
        return Result::Err(ChannelError::NoMemory)
    }

    let signal_mask = (u32)1 << (u32)port.mp_SigBit

    let sender = OneshotSender {
        port: port,
        sent: false,
    }

    let receiver = OneshotReceiver {
        port: port,
        signal_mask: signal_mask,
        received: false,
    }

    return Result::Ok((sender, receiver))
}
