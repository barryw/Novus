// Novus Standard Library - Critical Sections
// Namespace: std::sync::critical
//
// RAII guards for safe AmigaOS multi-tasking synchronization.
//
// AmigaOS is pre-emptive multitasking. When modifying shared data structures,
// you must prevent task switching to avoid race conditions. Two levels of
// protection are provided:
//
// 1. TASK SWITCHING PROTECTION (Forbid/Permit):
//    - Prevents other tasks from running
//    - Interrupts still fire normally
//    - Use for: modifying system lists, shared data structures
//    - Cannot nest across Wait() calls
//
// 2. INTERRUPT PROTECTION (Disable/Enable):
//    - Prevents ALL interrupts (including timer, disk, serial, etc.)
//    - EXTREMELY DANGEROUS - can crash the system if held too long
//    - Use ONLY for: modifying interrupt handler data, audio/copper setup
//    - Keep critical sections as SHORT as possible (< 250 microseconds)
//    - NEVER call OS functions while interrupts disabled
//
// WARNING: Improper use can deadlock or crash the system!
//
// SAFE USAGE RULES:
//   ✓ Keep critical sections SHORT - only protect the minimal code needed
//   ✓ Use RAII guards (let _guard = ...) to ensure automatic cleanup
//   ✓ Prefer SignalSemaphore for longer-term locking (see std::os::semaphore)
//   ✓ Never Wait() or call blocking functions inside critical sections
//   ✗ Don't nest Forbid with Disable (use Disable alone if you need both)
//   ✗ Don't allocate memory inside critical sections
//   ✗ Don't call DOS functions (Open, Read, Write, etc.)
//   ✗ Don't hold interrupt locks longer than 250 microseconds
//
// Example - Protecting a shared counter:
// ```novus
// var shared_counter: i32 = 0  // Shared between tasks
//
// fn increment_counter() {
//     let _guard = CriticalSection::enter()
//     shared_counter++
//     // Permit() called automatically when _guard drops
// }
// ```
//
// Example - Safe audio register access:
// ```novus
// fn start_audio_playback() {
//     let _guard = InterruptSection::enter()
//     // Write to Paula audio registers
//     custom.aud[0].ac_ptr = sample_ptr
//     custom.aud[0].ac_len = sample_len
//     custom.aud[0].ac_per = period
//     custom.aud[0].ac_vol = volume
//     // Enable() called automatically - interrupts restored
// }
// ```

from std::core import Drop
from std::ffi::exec import Forbid, Permit, Disable, Enable, FindTask
from std::ffi::amiga_structs import Task

// ============================================================================
// CriticalSection - Task Switching Protection (Forbid/Permit)
// ============================================================================

/// RAII guard that prevents task switching for the duration of its lifetime.
///
/// Calls Forbid() on creation and Permit() on drop.
/// Use this to protect shared data structures from concurrent modification
/// by other tasks.
///
/// IMPORTANT:
/// - Interrupts still fire while Forbid is active
/// - Cannot call Wait() or other blocking functions
/// - Keep sections SHORT - scheduler is disabled
/// - This is nestable (Exec maintains a nest count)
///
/// Example:
/// ```novus
/// fn safe_list_add(list: *List, node: *Node) {
///     let _guard = CriticalSection::enter()
///     AddHead(list, node)
///     // Permit() called automatically when _guard goes out of scope
/// }
/// ```
pub struct CriticalSection {
    // No fields needed - Drop trait handles cleanup
    _private: u8
}

impl CriticalSection {
    /// Enter a critical section that prevents task switching.
    ///
    /// Calls Forbid() immediately. Task switching is disabled until
    /// the returned guard is dropped.
    ///
    /// Returns: A guard that will call Permit() when dropped
    ///
    /// WARNING: Do NOT call Wait() or blocking functions while this guard exists!
    pub fn enter() -> CriticalSection {
        Forbid()
        return CriticalSection { _private: 0 }
    }

    /// Check if we're currently in a Forbid state.
    ///
    /// This reads the current task's TDNestCnt (Task Disable Nest Count).
    /// Returns true if Forbid has been called more times than Permit.
    ///
    /// Note: This is informational only - you should use RAII guards instead
    /// of manually checking and calling Forbid/Permit.
    pub fn is_forbidden() -> bool {
        // Get current task (pass null to get our own task)
        let task = FindTask(null)
        if task == null {
            return false
        }
        // tc_TDNestCnt starts at -1 (not forbidden)
        // After Forbid(), it becomes 0 or higher
        // >= 0 means we're in a Forbid state
        return (*task).tc_TDNestCnt >= 0
    }
}

impl Drop for CriticalSection {
    fn drop(&var self) {
        Permit()
    }
}

// ============================================================================
// InterruptSection - Interrupt Protection (Disable/Enable)
// ============================================================================

/// RAII guard that disables ALL interrupts for the duration of its lifetime.
///
/// Calls Disable() on creation and Enable() on drop.
///
/// EXTREMELY DANGEROUS! This stops ALL interrupts including:
/// - Timer interrupts (system time stops)
/// - Disk interrupts (can corrupt data if held too long)
/// - Serial interrupts (data loss)
/// - Audio/video interrupts (glitches)
///
/// USE ONLY WHEN ABSOLUTELY NECESSARY:
/// - Modifying interrupt handler data structures
/// - Setting up audio DMA pointers (Paula)
/// - Modifying copper lists while active
/// - Critical hardware register sequences
///
/// RULES:
/// - Keep sections EXTREMELY SHORT (< 250 microseconds ideal)
/// - NEVER allocate memory
/// - NEVER call any OS functions
/// - NEVER Wait() or block
/// - Only access hardware registers or memory
/// - This is nestable (Exec maintains a nest count)
///
/// If you're not 100% certain you need this, you probably don't.
/// Use CriticalSection (Forbid/Permit) instead.
///
/// Example:
/// ```novus
/// fn setup_copper_list() {
///     let _guard = InterruptSection::enter()
///     // Disable interrupts for the absolute minimum time
///     custom.cop1lc = copper_list_addr
///     custom.copjmp1 = 1
///     // Enable() called automatically - very short critical section
/// }
/// ```
pub struct InterruptSection {
    // No fields needed - Drop trait handles cleanup
    _private: u8
}

impl InterruptSection {
    /// Enter an interrupt-disabled section.
    ///
    /// Calls Disable() immediately. ALL interrupts are disabled until
    /// the returned guard is dropped.
    ///
    /// Returns: A guard that will call Enable() when dropped
    ///
    /// DANGER: Keep this section as SHORT as possible! Only a few instructions!
    /// System time stops, disk I/O is blocked, everything freezes.
    pub fn enter() -> InterruptSection {
        unsafe {
            Disable()
        }
        return InterruptSection { _private: 0 }
    }

    /// Check if interrupts are currently disabled.
    ///
    /// This reads the current task's IDNestCnt (Interrupt Disable Nest Count).
    /// Returns true if Disable has been called more times than Enable.
    ///
    /// Note: This is informational only - you should use RAII guards instead
    /// of manually checking and calling Disable/Enable.
    pub fn is_disabled() -> bool {
        // Get current task (pass null to get our own task)
        let task = FindTask(null)
        if task == null {
            return false
        }
        // tc_IDNestCnt starts at -1 (interrupts enabled)
        // After Disable(), it becomes 0 or higher
        // >= 0 means interrupts are disabled
        return (*task).tc_IDNestCnt >= 0
    }
}

impl Drop for InterruptSection {
    fn drop(&var self) {
        unsafe {
            Enable()
        }
    }
}

// ============================================================================
// Usage Patterns
// ============================================================================
//
// Basic pattern - RAII guard:
// ```novus
// fn modify_shared_data() {
//     let _guard = CriticalSection::enter()
//     // Forbid() called automatically
//     shared_list.add(item)
//     // Permit() called when _guard drops
// }
// ```
//
// Nested critical sections (safe - Exec maintains nest count):
// ```novus
// fn outer() {
//     let _guard = CriticalSection::enter()  // nest count = 0
//     inner()  // This will increment/decrement nest count
//     // Still protected here
// }
//
// fn inner() {
//     let _guard = CriticalSection::enter()  // nest count = 1
//     // Do work
//     // nest count back to 0 when guard drops
// }
// ```
//
// Early return pattern (guard ensures cleanup):
// ```novus
// fn conditional_work() -> Result<i32, Error> {
//     let _guard = CriticalSection::enter()
//     if error_condition {
//         return Result::Err(Error)  // Permit() still called!
//     }
//     // Do work
//     return Result::Ok(0)  // Permit() called here too
// }
// ```
