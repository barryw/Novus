// Fixed-capacity vector with inline storage and no allocation.

from std::core import Drop, Error, Iterable, Option, Result

/// Returned by `ArrayVec::push` when the inline capacity is exhausted.
pub enum ArrayVecError {
    /// Indicates full.
    Full,
}

impl Error for ArrayVecError {
    fn message(&self) -> *u8 { return "ArrayVec is full" }
}

/// Represents a array vec value.
pub struct ArrayVec<T, const N: usize> {
    /// The items value stored by `ArrayVec`.
    items: [Option<T>; N],
    /// The len value stored by `ArrayVec`.
    len: usize,
}

impl<T, const N: usize> ArrayVec<T, N> {
    /// Creates a new `ArrayVec` value.
    ///
    /// # Returns
    /// The resulting `ArrayVec<T, N>` value.
    pub fn new() -> ArrayVec<T, N> {
        return ArrayVec { items: [Option::None; N], len: 0 }
    }

    @inline
    /// Returns the number of items currently stored by `ArrayVec`.
    ///
    /// # Returns
    /// The resulting `usize` value.
    pub fn len(&self) -> usize { return self.len }

    @inline
    /// Returns the maximum number of items `ArrayVec` can store without growing.
    ///
    /// # Returns
    /// The resulting `usize` value.
    pub fn capacity(&self) -> usize { return N }

    @inline
    /// Returns whether `ArrayVec` contains no items.
    ///
    /// # Returns
    /// `true` when the stated condition holds; otherwise `false`.
    pub fn is_empty(&self) -> bool { return self.len == 0 }

    @inline
    /// Returns whether `ArrayVec` has reached its capacity.
    ///
    /// # Returns
    /// `true` when the stated condition holds; otherwise `false`.
    pub fn is_full(&self) -> bool { return self.len == N }

    /// Append a value. A value rejected because the vector is full is consumed
    /// and dropped normally before this call returns.
    pub fn push(&var self, consuming value: T) -> Result<(), ArrayVecError> {
        if self.len == N {
            return Result::Err(ArrayVecError::Full)
        }
        self.items[self.len] = Option::Some(value)
        self.len++
        return Result::Ok(())
    }

    /// Returns the requested item from `ArrayVec`, when it exists.
    ///
    /// # Parameters
    /// * `index` - The zero-based index.
    ///
    /// # Returns
    /// The requested value, or `Option::None` when it is unavailable.
    pub fn get(&self, index: usize) -> Option<&T> {
        if index >= self.len { return Option::None }
        return match &self.items[index] {
            Option::Some(&value) => Option::Some(value),
            Option::None => Option::None,
        }
    }

    /// Returns a mutable borrow of the requested item from `ArrayVec`, when it exists.
    ///
    /// # Parameters
    /// * `index` - The zero-based index.
    ///
    /// # Returns
    /// The requested value, or `Option::None` when it is unavailable.
    pub fn get_mut(&var self, index: usize) -> Option<&var T> {
        if index >= self.len { return Option::None }
        return match &var self.items[index] {
            Option::Some(&var value) => Option::Some(value),
            Option::None => Option::None,
        }
    }

    /// Remove one value while preserving order. Ownership transfers to the
    /// caller; every shifted slot is cleared so Drop still runs exactly once.
    pub fn remove(&var self, index: usize) -> Option<T> {
        if index >= self.len { return Option::None }
        let removed: Option<T> = self.items[index]
        var current = index
        while current + 1 < self.len {
            self.items[current] = self.items[current + 1]
            current++
        }
        self.len--
        return removed
    }
}

impl<T, const N: usize> Iterable<T> for ArrayVec<T, N> {
    fn len(&self) -> usize { return self.len }

    @unsafe
    fn get_unchecked(&self, index: usize) -> &T {
        return match &self.items[index] {
            Option::Some(&value) => value,
            Option::None => { panic!("ArrayVec invariant violated") },
        }
    }
}

impl<T, const N: usize> Drop for ArrayVec<T, N> {
    fn drop(&var self) {
        while self.len > 0 {
            self.len--
            @drop_in_place(&var self.items[self.len])
        }
    }
}
