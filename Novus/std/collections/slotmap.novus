// Novus Standard Library - SlotMap
// A generational index arena for safe object handles
//
// ## Amiga Use Cases
// - ECS game entities (players, enemies, projectiles, pickups)
// - Resource handles (textures, sounds, fonts, levels)
// - Screen/Window handles (multiple screens with stable IDs)
// - Audio sample handles (music, SFX with generation tracking)
// - Network object synchronization
// - Undo/redo systems with stable references

from std::core import Option, Drop
from std::memory::block import MemoryBlock
from amiga::raw::exec import FreeMem, CopyMem, MEMF_PUBLIC, MEMF_CLEAR
from std::memory::errors import MemoryError

/// SlotKey - A handle to an object in a SlotMap
///
/// Contains both an index and a generation counter.
/// The generation detects use-after-free: if you try to access
/// an object with an old key after it was removed and the slot
/// was reused, the generations won't match.
///
/// ## Layout (32-bit packed)
/// - Bits 0-15: Index (supports up to 65,536 objects)
/// - Bits 16-31: Generation (wraps at 65,536 reuses)
///
/// The 16-bit generation provides much better ABA protection than
/// an 8-bit generation (65536 reuses vs 256 before potential collision).
pub struct SlotKey {
index: usize,
    generation: u32,
}

impl SlotKey {
    /// Create a sentinel/null key
    pub fn sentinel() -> SlotKey {
        return SlotKey { index: 0xFFFFFFFF, generation: 0 }
    }

    /// Check if this is a sentinel/null key
    pub fn is_sentinel(&self) -> bool {
        return self.index == 0xFFFFFFFF
    }

    /// Pack key into a single u32 (for storage/comparison)
    ///
    /// Uses 16 bits for index (65K objects max), 16 bits for generation
    /// (65K reuses before wrap). This provides much better ABA protection
    /// than an 8-bit generation.
    pub fn pack(&self) -> u32 {
        return (self.generation << 16) | (self.index & 0x0000FFFF)
    }

    /// Unpack a u32 into a SlotKey
    pub fn unpack(packed: u32) -> SlotKey {
        return SlotKey {
            index: packed & 0x0000FFFF,
            generation: packed >> 16,
        }
    }

    /// Get the index portion of this key
pub fn get_index(&self) -> usize {
        return self.index
    }

    /// Get the generation portion of this key
    pub fn get_generation(&self) -> u32 {
        return self.generation
    }
}

/// Internal slot state
struct Slot<T> {
    generation: u32,    // Current generation of this slot
    next_free: u32,     // When free: index of next free slot (or 0xFFFFFFFF)
    occupied: bool,
    _padding: [u8; 3],  // Align to 4 bytes
    // Value stored separately for CopyMem compatibility
}

/// SlotMap<T> - Generational index arena
///
/// A data structure that provides stable handles to objects.
/// Objects can be inserted, accessed, and removed in O(1) time.
/// Handles remain valid until the object is removed, and invalid
/// handles are safely detected (no dangling pointer bugs).
///
/// ## Features
/// - O(1) insert, get, remove
/// - Stable handles that survive other removals
/// - 16-bit generation counter for strong ABA protection
/// - O(1) free slot finding via free list
/// - Dynamic growth when needed
/// - Proper Drop support for contained elements
///
/// ## Example
/// ```novus
/// match SlotMap::<Entity>::new() {
///     Result::Ok(var entities) => {
///         // Insert an entity and get a handle
///         match entities.insert(player_entity) {
///             Result::Ok(player_key) => {
///                 // Access via handle - returns None if key is stale
///                 match entities.get(player_key) {
///                     Option::Some(entity) => { /* use entity */ },
///                     Option::None => { /* entity was removed */ }
///                 }
///
///                 // Remove the entity
///                 entities.remove(player_key)
///
///                 // Old key is now invalid
///                 // entities.get(player_key) returns None
///             },
///             Result::Err(_) => { /* allocation failed */ }
///         }
///     },
///     Result::Err(_) => { /* allocation failed */ }
/// }
/// ```
pub struct SlotMap<T> {
    values: *u8,        // Raw byte storage for values (for CopyMem)
    slots: *Slot<T>,    // Slot metadata (generation, free list, occupied)
capacity: usize,
len: usize,
free_head: usize,   // Index of first free slot, or 0xFFFFFFFF if none
    value_size: u32,    // Size of T (aligned)
    slot_size: u32,     // Size of Slot<T>
}

impl<T> SlotMap<T> {
    /// Create a new empty SlotMap with default capacity (16)
    pub fn new() -> Result<SlotMap<T>, MemoryError> {
        return SlotMap::<T>::with_capacity(16)
    }

    /// Create a new SlotMap with specified initial capacity
pub fn with_capacity(capacity: usize) -> Result<SlotMap<T>, MemoryError> {
        if capacity == 0 {
            return Result::Err(MemoryError::InvalidCapacity)
        }

        let value_size: u32 = @sizeof(T)
        // Align value size to 4 bytes
        let aligned_value_size: u32 = (value_size + 3) & 0xFFFFFFFC
        let slot_size: u32 = @sizeof(Slot<T>)

        let value_bytes: u32 = capacity * aligned_value_size
        let slot_bytes: u32 = capacity * slot_size

        // Allocate values array
        let value_opt = MemoryBlock::alloc(value_bytes, MEMF_PUBLIC | MEMF_CLEAR)
        match value_opt {
            Result::Ok(var value_block) => {
                let values: *u8 = value_block.ptr()
                value_block.into_raw()

                // Allocate slots array
                let slot_opt = MemoryBlock::alloc(slot_bytes, MEMF_PUBLIC | MEMF_CLEAR)
                match slot_opt {
                    Result::Ok(var slot_block) => {
                        let slots: *Slot<T> = (*Slot<T>)slot_block.ptr()
                        slot_block.into_raw()

                        // Initialize free list: each slot points to the next
var i: usize = 0
                        unsafe {
                            while i < capacity - 1 {
                                slots[i].occupied = false
                                slots[i].generation = 0
                                slots[i].next_free = i + 1
                                i = i + 1
                            }
                            // Last slot terminates the free list
                            slots[capacity - 1].occupied = false
                            slots[capacity - 1].generation = 0
                            slots[capacity - 1].next_free = 0xFFFFFFFF
                        }

                        return Result::Ok(SlotMap {
                            values: values,
                            slots: slots,
                            capacity: capacity,
                            len: 0,
                            free_head: 0,
                            value_size: aligned_value_size,
                            slot_size: slot_size,
                        })
                    },
                    Result::Err(error) => {
                        unsafe {
                            FreeMem(values, value_bytes)
                        }
                        return Result::Err(error)
                    }
                }
            },
            Result::Err(error) => return Result::Err(error),
        }
    }

    /// Create a new SlotMap, returning a Result for detailed error handling
pub fn try_with_capacity(capacity: usize) -> Result<SlotMap<T>, MemoryError> {
        return SlotMap::<T>::with_capacity(capacity)
    }

    /// Insert a value and return its key
    ///
    /// Returns the allocation error if growth fails.
    pub fn insert(&var self, consuming value: T) -> Result<SlotKey, MemoryError> {
        // Check if we need to grow
        if self.free_head == 0xFFFFFFFF {
            self.grow()?
        }

        // Pop from free list
let index: usize = self.free_head
        self.free_head = unsafe { self.slots[index].next_free }

        // Copy value using CopyMem
        let dst: *u8 = self.values + index * self.value_size
        unsafe {
            CopyMem((*u8)(&value), dst, self.value_size)
        }

        // Mark slot as occupied
        unsafe { self.slots[index].occupied = true }
        self.len = self.len + 1

        return Result::Ok(SlotKey {
            index: index,
            generation: unsafe { self.slots[index].generation },
        })
    }

    /// Grow the SlotMap by doubling capacity
    fn grow(&var self) -> Result<(), MemoryError> {
let new_capacity: usize = self.capacity << 1  // Double
        let new_value_bytes: u32 = new_capacity * self.value_size
        let new_slot_bytes: u32 = new_capacity * self.slot_size

        // Allocate new values array
        let value_opt = MemoryBlock::alloc(new_value_bytes, MEMF_PUBLIC | MEMF_CLEAR)
        match value_opt {
            Result::Ok(var value_block) => {
                let new_values: *u8 = value_block.ptr()
                value_block.into_raw()

                // Allocate new slots array
                let slot_opt = MemoryBlock::alloc(new_slot_bytes, MEMF_PUBLIC | MEMF_CLEAR)
                match slot_opt {
                    Result::Ok(var slot_block) => {
                        let new_slots: *Slot<T> = (*Slot<T>)slot_block.ptr()
                        slot_block.into_raw()

                        // Copy existing values using CopyMem (one big copy)
                        let old_value_bytes: u32 = self.capacity * self.value_size
                        unsafe {
                            CopyMem(self.values, new_values, old_value_bytes)
                        }

                        // Copy existing slots
var i: usize = 0
                        unsafe {
                            while i < self.capacity {
                                new_slots[i].generation = self.slots[i].generation
                                new_slots[i].next_free = self.slots[i].next_free
                                new_slots[i].occupied = self.slots[i].occupied
                                i = i + 1
                            }

                            // Initialize new slots as free list
                            while i < new_capacity - 1 {
                                new_slots[i].occupied = false
                                new_slots[i].generation = 0
                                new_slots[i].next_free = i + 1
                                i = i + 1
                            }
                            // Last new slot terminates the new free list
                            new_slots[new_capacity - 1].occupied = false
                            new_slots[new_capacity - 1].generation = 0
                            new_slots[new_capacity - 1].next_free = self.free_head
                        }

                        // Free old arrays
                        let old_slot_bytes: u32 = self.capacity * self.slot_size
                        unsafe {
                            FreeMem(self.values, old_value_bytes)
                            FreeMem((*u8)self.slots, old_slot_bytes)
                        }

                        // Update to new arrays
                        self.values = new_values
                        self.slots = new_slots
                        self.free_head = self.capacity  // First new slot
                        self.capacity = new_capacity
                        return Result::Ok(())
                    },
                    Result::Err(error) => {
                        unsafe {
                            FreeMem(new_values, new_value_bytes)
                        }
                        return Result::Err(error)
                    }
                }
            },
            Result::Err(error) => return Result::Err(error),
        }
    }

    /// Borrow the value for a key
    ///
    /// Returns None if the key is invalid or stale (object was removed).
    pub fn get(&self, key: SlotKey) -> Option<&T> {
        if key.index >= self.capacity {
            return Option::None
        }

        let slot: *Slot<T> = unsafe { &self.slots[key.index] }

        // Check if slot is occupied and generation matches
        if !slot.occupied || slot.generation != key.generation {
            return Option::None
        }

        let ptr: *T = (*T)(self.values + key.index * self.value_size)
        return Option::Some(unsafe { &*ptr })
    }

    /// Mutably borrow the value for a key
    ///
    /// Returns None if the key is invalid or stale.
    pub fn get_mut(&var self, key: SlotKey) -> Option<&var T> {
        if key.index >= self.capacity {
            return Option::None
        }

        if unsafe { !self.slots[key.index].occupied || self.slots[key.index].generation != key.generation } {
            return Option::None
        }

        let ptr: *T = (*T)(self.values + key.index * self.value_size)
        return Option::Some(unsafe { &var *ptr })
    }

    /// Check if a key is valid (refers to a live object)
    pub fn contains(&self, key: SlotKey) -> bool {
        if key.index >= self.capacity {
            return false
        }

        let slot: *Slot<T> = unsafe { &self.slots[key.index] }
        return slot.occupied && slot.generation == key.generation
    }

    /// Remove an object by key
    ///
    /// Calls Drop on the removed object.
    /// Returns true if the object was removed, false if key was invalid.
    pub fn remove(&var self, key: SlotKey) -> bool {
        if key.index >= self.capacity {
            return false
        }

        if unsafe { !self.slots[key.index].occupied || self.slots[key.index].generation != key.generation } {
            return false
        }

        // Call Drop on the value before releasing the slot
        let ptr: *T = (*T)(self.values + key.index * self.value_size)
        @drop_in_place(ptr)

        // Mark slot as unoccupied, increment generation, add to free list
        unsafe {
            self.slots[key.index].occupied = false
            self.slots[key.index].generation = self.slots[key.index].generation + 1
            self.slots[key.index].next_free = self.free_head
        }
        self.free_head = key.index
        self.len = self.len - 1

        return true
    }

    /// Remove and return an object by key
    ///
    /// Does NOT call Drop - ownership transfers to caller.
    /// Returns the value if successful, None if key was invalid.
    pub fn take(&var self, key: SlotKey) -> Option<T> {
        if key.index >= self.capacity {
            return Option::None
        }

        if unsafe { !self.slots[key.index].occupied || self.slots[key.index].generation != key.generation } {
            return Option::None
        }

        // Copy value out from the stored location (ownership transfer)
        let src: *T = (*T)(self.values + key.index * self.value_size)
        let value: T = *src

        // Mark slot as unoccupied, increment generation, add to free list
        unsafe {
            self.slots[key.index].occupied = false
            self.slots[key.index].generation = self.slots[key.index].generation + 1
            self.slots[key.index].next_free = self.free_head
        }
        self.free_head = key.index
        self.len = self.len - 1

        return Option::Some(value)
    }

    /// Get the number of objects in the map
pub fn len(&self) -> usize {
        return self.len
    }

    /// Check if the map is empty
    pub fn is_empty(&self) -> bool {
        return self.len == 0
    }

    /// Get the current capacity
pub fn capacity(&self) -> usize {
        return self.capacity
    }

    /// Clear all objects from the map
    ///
    /// Calls Drop on all contained values.
    /// Increments generations so old keys become invalid.
    pub fn clear(&var self) {
var i: usize = 0
        while i < self.capacity {
            if unsafe { self.slots[i].occupied } {
                // Call Drop on the value before releasing the slot
                let ptr: *T = (*T)(self.values + i * self.value_size)
                @drop_in_place(ptr)
                unsafe {
                    self.slots[i].occupied = false
                    self.slots[i].generation = self.slots[i].generation + 1
                }
            }
            i = i + 1
        }

        // Rebuild free list
        var j: u32 = 0
        while j < self.capacity - 1 {
            unsafe { self.slots[j].next_free = j + 1 }
            j = j + 1
        }
        unsafe { self.slots[self.capacity - 1].next_free = 0xFFFFFFFF }
        self.free_head = 0
        self.len = 0
    }

    /// Create an iterator over all valid (key, value) pairs
    pub fn iter(&self) -> SlotMapIter<T> {
        return SlotMapIter {
            map: self,
            current: 0,
        }
    }

    /// Get a key for an object at a raw index (for iteration)
    ///
    /// Returns None if the index is out of bounds or unoccupied.
pub fn key_at(&self, index: usize) -> Option<SlotKey> {
        if index >= self.capacity {
            return Option::None
        }

        if unsafe { !self.slots[index].occupied } {
            return Option::None
        }

        return Option::Some(SlotKey {
            index: index,
            generation: unsafe { self.slots[index].generation },
        })
    }
}

impl<T> Drop for SlotMap<T> {
    fn drop(&var self) {
        if self.values != null {
            // Call Drop on all occupied values before freeing memory
var i: usize = 0
            while i < self.capacity {
                if unsafe { self.slots[i].occupied } {
                    let ptr: *T = (*T)(self.values + i * self.value_size)
                    @drop_in_place(ptr)
                }
                i = i + 1
            }

            let value_bytes: u32 = self.capacity * self.value_size
            let slot_bytes: u32 = self.capacity * self.slot_size
            unsafe {
                FreeMem(self.values, value_bytes)
                FreeMem((*u8)self.slots, slot_bytes)
            }
            self.values = null
            self.slots = null
            self.capacity = 0
            self.len = 0
        }
    }
}

/// Iterator over SlotMap entries
pub struct SlotMapIter<T> {
    map: &SlotMap<T>,
current: usize,
}

/// Key-value pair returned by SlotMap iterator
pub struct SlotMapEntry<T> {
    key: SlotKey,
    value: &T,
}

impl<T> SlotMapIter<T> {
    /// Get the next occupied entry
    pub fn next(&var self) -> Option<SlotMapEntry<T>> {
        while self.current < self.map.capacity {
let idx: usize = self.current
            self.current = self.current + 1

            if unsafe { self.map.slots[idx].occupied } {
                let ptr: *T = (*T)(self.map.values + idx * self.map.value_size)
                return Option::Some(SlotMapEntry {
                    key: SlotKey {
                        index: idx,
                        generation: unsafe { self.map.slots[idx].generation },
                    },
                    value: unsafe { &*ptr },
                })
            }
        }
        return Option::None
    }

    /// Reset iterator to the beginning
    pub fn reset(&var self) {
        self.current = 0
    }
}

// ============================================================================
// Fixed-capacity variant (heap-allocated, but doesn't grow)
// ============================================================================

/// SlotMapFixed<T> - Heap-allocated SlotMap with fixed capacity
///
/// Like SlotMap but with fixed capacity that never grows.
/// Uses separate arrays for better cache behavior during iteration.
pub struct SlotMapFixed<T> {
    values: *u8,            // Raw byte storage for values
    generations: *u32,
    next_free: *u32,        // Free list linkage
    occupied: *bool,
capacity: usize,
len: usize,
free_head: usize,
    value_size: u32,
}

impl<T> SlotMapFixed<T> {
    /// Create a new fixed-capacity SlotMap
pub fn with_capacity(capacity: usize) -> Result<SlotMapFixed<T>, MemoryError> {
        if capacity == 0 {
            return Result::Err(MemoryError::InvalidCapacity)
        }

        let value_size: u32 = @sizeof(T)
        let aligned_value_size: u32 = (value_size + 3) & 0xFFFFFFFC
        let value_bytes: u32 = capacity * aligned_value_size
        let gen_bytes: u32 = capacity * 4      // u32 generations
        let free_bytes: u32 = capacity * 4     // u32 next_free
        let occ_bytes: u32 = capacity             // bool occupied

        // Allocate values array
        let value_opt = MemoryBlock::alloc(value_bytes, MEMF_PUBLIC | MEMF_CLEAR)
        match value_opt {
            Result::Ok(var value_block) => {
                let values: *u8 = value_block.ptr()
                value_block.into_raw()

                // Allocate generations array
                let gen_opt = MemoryBlock::alloc(gen_bytes, MEMF_PUBLIC | MEMF_CLEAR)
                match gen_opt {
                    Result::Ok(var gen_block) => {
                        let generations: *u32 = (*u32)gen_block.ptr()
                        gen_block.into_raw()

                        // Allocate next_free array
                        let free_opt = MemoryBlock::alloc(free_bytes, MEMF_PUBLIC)
                        match free_opt {
                            Result::Ok(var free_block) => {
                                let next_free: *u32 = (*u32)free_block.ptr()
                                free_block.into_raw()

                                // Allocate occupied array
                                let occ_opt = MemoryBlock::alloc(occ_bytes, MEMF_PUBLIC | MEMF_CLEAR)
                                match occ_opt {
                                    Result::Ok(var occ_block) => {
                                        let occupied: *bool = (*bool)occ_block.ptr()
                                        occ_block.into_raw()

                                        // Initialize free list
var i: usize = 0
                                        unsafe {
                                            while i < capacity - 1 {
                                                next_free[i] = i + 1
                                                i = i + 1
                                            }
                                            next_free[capacity - 1] = 0xFFFFFFFF
                                        }

                                        return Result::Ok(SlotMapFixed {
                                            values: values,
                                            generations: generations,
                                            next_free: next_free,
                                            occupied: occupied,
                                            capacity: capacity,
                                            len: 0,
                                            free_head: 0,
                                            value_size: aligned_value_size,
                                        })
                                    },
                                    Result::Err(error) => {
                                        unsafe {
                                            FreeMem(values, value_bytes)
                                            FreeMem((*u8)generations, gen_bytes)
                                            FreeMem((*u8)next_free, free_bytes)
                                        }
                                        return Result::Err(error)
                                    }
                                }
                            },
                            Result::Err(error) => {
                                unsafe {
                                    FreeMem(values, value_bytes)
                                    FreeMem((*u8)generations, gen_bytes)
                                }
                                return Result::Err(error)
                            }
                        }
                    },
                    Result::Err(error) => {
                        unsafe {
                            FreeMem(values, value_bytes)
                        }
                        return Result::Err(error)
                    }
                }
            },
            Result::Err(error) => return Result::Err(error),
        }
    }

    /// Create a new SlotMapFixed, returning a Result for detailed error handling
pub fn try_with_capacity(capacity: usize) -> Result<SlotMapFixed<T>, MemoryError> {
        return SlotMapFixed::<T>::with_capacity(capacity)
    }

    /// Insert a value and return its key
    ///
    /// Returns a capacity error if the map is full.
    pub fn insert(&var self, consuming value: T) -> Result<SlotKey, MemoryError> {
        if self.free_head == 0xFFFFFFFF {
            return Result::Err(MemoryError::CapacityExceeded)
        }

        // Pop from free list
let index: usize = self.free_head
        self.free_head = unsafe { self.next_free[index] }

        // Copy value using CopyMem
        let dst: *u8 = self.values + index * self.value_size
        unsafe {
            CopyMem((*u8)(&value), dst, self.value_size)
        }

        unsafe { self.occupied[index] = true }
        self.len = self.len + 1

        return Result::Ok(SlotKey {
            index: index,
            generation: unsafe { self.generations[index] },
        })
    }

    /// Borrow the value for a key
    pub fn get(&self, key: SlotKey) -> Option<&T> {
        if key.index >= self.capacity {
            return Option::None
        }
        if unsafe { !self.occupied[key.index] || self.generations[key.index] != key.generation } {
            return Option::None
        }
        let ptr: *T = (*T)(self.values + key.index * self.value_size)
        return Option::Some(unsafe { &*ptr })
    }

    /// Mutably borrow the value
    pub fn get_mut(&var self, key: SlotKey) -> Option<&var T> {
        if key.index >= self.capacity {
            return Option::None
        }
        if unsafe { !self.occupied[key.index] || self.generations[key.index] != key.generation } {
            return Option::None
        }
        let ptr: *T = (*T)(self.values + key.index * self.value_size)
        return Option::Some(unsafe { &var *ptr })
    }

    /// Check if a key is valid
    pub fn contains(&self, key: SlotKey) -> bool {
        if key.index >= self.capacity {
            return false
        }
        return unsafe { self.occupied[key.index] && self.generations[key.index] == key.generation }
    }

    /// Remove an object by key
    ///
    /// Calls Drop on the removed object.
    /// Returns true if the object was removed, false if key was invalid.
    pub fn remove(&var self, key: SlotKey) -> bool {
        if key.index >= self.capacity {
            return false
        }
        if unsafe { !self.occupied[key.index] || self.generations[key.index] != key.generation } {
            return false
        }

        // Call Drop on the value before releasing the slot
        let ptr: *T = (*T)(self.values + key.index * self.value_size)
        @drop_in_place(ptr)

        unsafe {
            self.occupied[key.index] = false
            self.generations[key.index] = self.generations[key.index] + 1
            self.next_free[key.index] = self.free_head
        }
        self.free_head = key.index
        self.len = self.len - 1
        return true
    }

    /// Get number of objects
pub fn len(&self) -> usize {
        return self.len
    }

    /// Check if empty
    pub fn is_empty(&self) -> bool {
        return self.len == 0
    }

    /// Get capacity
pub fn capacity(&self) -> usize {
        return self.capacity
    }

    /// Clear all objects
    ///
    /// Calls Drop on all contained values.
    /// Increments generations so old keys become invalid.
    pub fn clear(&var self) {
        var i: usize = 0
        while i < self.capacity {
            if unsafe { self.occupied[i] } {
                // Call Drop on the value before releasing the slot
                let ptr: *T = (*T)(self.values + i * self.value_size)
                @drop_in_place(ptr)
                unsafe {
                    self.occupied[i] = false
                    self.generations[i] = self.generations[i] + 1
                }
            }
            i = i + 1
        }

        // Rebuild free list
        var j: u32 = 0
        while j < self.capacity - 1 {
            unsafe { self.next_free[j] = j + 1 }
            j = j + 1
        }
        unsafe { self.next_free[self.capacity - 1] = 0xFFFFFFFF }
        self.free_head = 0
        self.len = 0
    }
}

impl<T> Drop for SlotMapFixed<T> {
    fn drop(&var self) {
        if self.values != null {
            // Call Drop on all occupied values before freeing memory
            var i: usize = 0
            while i < self.capacity {
                if unsafe { self.occupied[i] } {
                    let ptr: *T = (*T)(self.values + i * self.value_size)
                    @drop_in_place(ptr)
                }
                i = i + 1
            }

            let value_bytes: u32 = self.capacity * self.value_size
            let gen_bytes: u32 = self.capacity * 4
            let free_bytes: u32 = self.capacity * 4
            let occ_bytes: u32 = self.capacity
            unsafe {
                FreeMem(self.values, value_bytes)
                FreeMem((*u8)self.generations, gen_bytes)
                FreeMem((*u8)self.next_free, free_bytes)
                FreeMem((*u8)self.occupied, occ_bytes)
            }
            self.values = null
            self.generations = null
            self.next_free = null
            self.occupied = null
            self.capacity = 0
            self.len = 0
        }
    }
}
