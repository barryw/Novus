// Novus Standard Library - Collections Module
// Namespace: std::collections
// Dynamic data structures and collection types

// Import core types and memory management
from std::core import Option, Result, Iterable, From, Drop, Clone
from std::memory::block import MemoryBlock
from std::error::errors import ExecError
from std::ffi::exec import CopyMem, FreeMem
from std::ffi::amiga_consts import MEMF_PUBLIC, MEMF_CLEAR

/// Vec<T> - dynamic array (growable)
///
/// A contiguous, growable array type with heap-allocated contents.
/// Similar to Rust's Vec or C++'s std::vector.
///
/// ## Features
/// - Automatic memory management via Drop trait (RAII)
/// - Amortized O(1) push with capacity doubling strategy
/// - O(1) indexed access via get/set
/// - Iterable for use in for-in loops
///
/// ## Memory
/// Uses AmigaOS AllocMem with MEMF_PUBLIC for cross-task safe allocations.
/// Memory is automatically freed when the Vec goes out of scope.
///
/// ## Example
/// ```novus
/// var numbers = Vec::<u32>::new()
/// numbers.push(1)
/// numbers.push(2)
/// numbers.push(3)
///
/// for num in numbers {
///     print_u32(num)
/// }
/// // Memory automatically freed here
/// ```
pub struct Vec<T> {
    ptr: *T,
    len: u32,
    capacity: u32,
}

impl<T> Vec<T> {
    // Create an empty vector with zero capacity
    pub fn new() -> Vec<T> {
        return Vec {
            ptr: null,
            len: 0,
            capacity: 0,
        }
    }

    /// Create a vector with pre-allocated capacity
    ///
    /// Returns None if allocation fails. For error details, use `try_with_capacity`.
    pub fn with_capacity(capacity: u32) -> Option<Vec<T>> {
        if capacity == 0 {
            return Option::Some(Vec { ptr: null, len: 0, capacity: 0 })
        }

        let element_size: u32 = @sizeof(T)
        let bytes_needed: u32 = capacity * element_size

        // Allocate with MEMF_PUBLIC | MEMF_CLEAR (clear memory to zero)
        let block_opt: Option<MemoryBlock> = MemoryBlock::alloc(bytes_needed, MEMF_PUBLIC | MEMF_CLEAR)

        match block_opt {
            Some(var block) => {
                // Take ownership of the raw pointer so MemoryBlock's Drop won't free it
                let (raw_ptr, _size) = block.into_raw()
                // Explicit pointer cast from *u8 to *T
                let ptr: *T = (*T)raw_ptr
                return Option::Some(Vec {
                    ptr: ptr,
                    len: 0,
                    capacity: capacity,
                })
            },
            None => {
                // Allocation failed
                return Option::None
            }
        }
    }

    /// Create a vector with pre-allocated capacity, returning Result for error handling
    ///
    /// Returns `Result::Err(ExecError::NoMem)` if allocation fails.
    ///
    /// # Example
    /// ```novus
    /// let vec = Vec::<u32>::try_with_capacity(100)?
    /// ```
    pub fn try_with_capacity(capacity: u32) -> Result<Vec<T>, ExecError> {
        match Vec::<T>::with_capacity(capacity) {
            Some(vec) => return Result::Ok(vec),
            None => return Result::Err(ExecError::NoMem),
        }
    }

    // Check if the vector is empty
    pub fn is_empty(&self) -> bool {
        return self.len == 0
    }

    // Get the number of elements in the vector
    pub fn len(&self) -> u32 {
        return self.len
    }

    // Get the capacity of the vector
    pub fn capacity(&self) -> u32 {
        return self.capacity
    }

    /// Reserve additional capacity (grow if needed)
    ///
    /// Returns true on success, false if allocation failed.
    /// For error details, use `try_reserve`.
    pub fn reserve(&var self, additional: u32) -> bool {
        let needed_capacity: u32 = self.len + additional

        // Only grow if we need more capacity
        if needed_capacity > self.capacity {
            // Calculate new capacity (double current or use needed, whichever is larger)
            var new_capacity: u32 = self.capacity * 2u32
            if new_capacity < needed_capacity {
                new_capacity = needed_capacity
            }

            // Minimum capacity of 4 elements
            if new_capacity < 4u32 {
                new_capacity = 4u32
            }

            let element_size: u32 = @sizeof(T)
            let new_bytes: u32 = new_capacity * element_size

            // Allocate with MEMF_PUBLIC | MEMF_CLEAR (clear memory to zero)
            let new_block_opt: Option<MemoryBlock> = MemoryBlock::alloc(new_bytes, MEMF_PUBLIC | MEMF_CLEAR)

            match new_block_opt {
                Some(var new_block) => {
                    // Take ownership of the raw pointer so MemoryBlock's Drop won't free it
                    let (raw_ptr, _size) = new_block.into_raw()
                    // Explicit pointer cast from *u8 to *T
                    let new_ptr: *T = (*T)raw_ptr

                    // Copy existing elements to new allocation
                    while var i < self.len {
                        new_ptr[i] = self.ptr[i]
                        i++
                    }

                    // Free old memory if it exists
                    if self.capacity > 0 {
                        let old_bytes: u32 = self.capacity * element_size
                        let old_mem: *u8 = (*u8)(self.ptr)
                        unsafe {
                            FreeMem(old_mem, old_bytes)
                        }
                    }

                    // Update vec fields
                    self.ptr = new_ptr
                    self.capacity = new_capacity
                    return true
                },
                None => {
                    // Allocation failed
                    return false
                }
            }
        }

        return true
    }

    /// Reserve additional capacity, returning Result for error handling
    ///
    /// Returns `Result::Err(ExecError::NoMem)` if allocation fails.
    ///
    /// # Example
    /// ```novus
    /// var vec = Vec::<u32>::new()
    /// vec.try_reserve(100)?
    /// ```
    pub fn try_reserve(&var self, additional: u32) -> Result<(), ExecError> {
        if self.reserve(additional) {
            return Result::Ok(())
        } else {
            return Result::Err(ExecError::NoMem)
        }
    }

    /// Add an element to the end of the vector
    ///
    /// Returns true on success, false if allocation failed.
    /// For error details, use `try_push`.
    pub fn push(&var self, value: T) -> bool {
        // Ensure we have capacity
        if self.len >= self.capacity {
            let success: bool = self.reserve(1)
            if !success {
                return false  // Allocation failed
            }
        }

        // Add the element
        self.ptr[self.len] = value
        self.len++
        return true
    }

    /// Add an element to the end of the vector, returning Result for error handling
    ///
    /// Returns `Result::Err(ExecError::NoMem)` if allocation fails.
    ///
    /// # Example
    /// ```novus
    /// var vec = Vec::<u32>::new()
    /// vec.try_push(42)?
    /// ```
    pub fn try_push(&var self, value: T) -> Result<(), ExecError> {
        if self.push(value) {
            return Result::Ok(())
        } else {
            return Result::Err(ExecError::NoMem)
        }
    }

    // Remove and return the last element (returns Option<T>)
    pub fn pop(&var self) -> Option<T> {
        if self.len == 0u32 {
            return Option::None
        }

        self.len--
        let value: T = self.ptr[self.len]
        return Option::Some(value)
    }

    // Set element at index (returns true if successful)
    pub fn set(&var self, index: u32, value: T) -> bool {
        if index >= self.len {
            return false
        }

        self.ptr[index] = value
        return true
    }

    // Get element at index (returns Option)
    pub fn get(&self, index: u32) -> Option<T> {
        if index >= self.len {
            return Option::None
        }

        return Option::Some(self.ptr[index])
    }

    // Remove all elements (keeps capacity)
    pub fn clear(&var self) {
        self.len = 0
    }

    // Get immutable pointer to the underlying buffer
    pub fn as_ptr(&self) -> *T {
        return self.ptr
    }

    // Get mutable pointer to the underlying buffer
    pub fn as_mut_ptr(&var self) -> *T {
        return self.ptr
    }

    /// Insert an element at the given index, shifting all elements after it to the right
    ///
    /// Returns true on success, false if index is out of bounds or allocation failed.
    ///
    /// Example:
    /// ```novus
    /// var vec = Vec::new()
    /// vec.push(1)
    /// vec.push(3)
    /// vec.insert(1, 2)  // vec is now [1, 2, 3]
    /// ```
    pub fn insert(&var self, index: u32, value: T) -> bool {
        // Check bounds - can insert at len (append position)
        if index > self.len {
            return false
        }

        // Ensure we have capacity
        if self.len >= self.capacity {
            let success: bool = self.reserve(1)
            if !success {
                return false  // Allocation failed
            }
        }

        // Shift elements right to make room
        var i: u32 = self.len
        while i > index {
            self.ptr[i] = self.ptr[i - 1u32]
            i--
        }

        // Insert the element
        self.ptr[index] = value
        self.len++
        return true
    }

    /// Remove element at the given index, shifting all elements after it to the left
    ///
    /// Returns Some(value) if successful, None if index is out of bounds.
    ///
    /// Example:
    /// ```novus
    /// var vec = Vec::new()
    /// vec.push(1)
    /// vec.push(2)
    /// vec.push(3)
    /// let removed = vec.remove(1)  // Returns Some(2), vec is now [1, 3]
    /// ```
    pub fn remove(&var self, index: u32) -> Option<T> {
        if index >= self.len {
            return Option::None
        }

        // Save the value to return
        let value: T = self.ptr[index]

        // Shift elements left
        var i: u32 = index
        while i < self.len - 1u32 {
            self.ptr[i] = self.ptr[i + 1u32]
            i++
        }

        self.len--
        return Option::Some(value)
    }

    /// Shorten the vector to the given length
    ///
    /// If new_len is greater than or equal to the current length, this does nothing.
    /// Capacity is unchanged.
    ///
    /// Example:
    /// ```novus
    /// var vec = Vec::new()
    /// vec.push(1)
    /// vec.push(2)
    /// vec.push(3)
    /// vec.truncate(1)  // vec is now [1]
    /// ```
    pub fn truncate(&var self, new_len: u32) {
        if new_len < self.len {
            self.len = new_len
        }
    }

    /// Shrink the capacity to match the length
    ///
    /// Returns true on success, false if reallocation failed.
    /// On failure, the vector is unchanged.
    ///
    /// Example:
    /// ```novus
    /// var vec = Vec::with_capacity(100)?
    /// vec.push(1)
    /// vec.push(2)
    /// vec.shrink_to_fit()  // Reduces capacity from 100 to 2
    /// ```
    pub fn shrink_to_fit(&var self) -> bool {
        // Nothing to do if already optimal
        if self.len == self.capacity {
            return true
        }

        // Special case: empty vector
        if self.len == 0 {
            if self.capacity > 0 {
                let element_size: u32 = @sizeof(T)
                let bytes: u32 = self.capacity * element_size
                let mem: *u8 = (*u8)(self.ptr)
                unsafe {
                    FreeMem(mem, bytes)
                }
                self.ptr = null
                self.capacity = 0
            }
            return true
        }

        // Allocate new smaller buffer
        let element_size: u32 = @sizeof(T)
        let new_bytes: u32 = self.len * element_size

        let new_block_opt: Option<MemoryBlock> = MemoryBlock::alloc(new_bytes, MEMF_PUBLIC | MEMF_CLEAR)

        match new_block_opt {
            Some(var new_block) => {
                // Take ownership of the raw pointer so MemoryBlock's Drop won't free it
                let (raw_ptr, _size) = new_block.into_raw()
                let new_ptr: *T = (*T)raw_ptr

                // Copy existing elements to new allocation
                while var i < self.len {
                    new_ptr[i] = self.ptr[i]
                    i++
                }

                // Free old memory
                let old_bytes: u32 = self.capacity * element_size
                let old_mem: *u8 = (*u8)(self.ptr)
                unsafe {
                    FreeMem(old_mem, old_bytes)
                }

                // Update vec fields
                self.ptr = new_ptr
                self.capacity = self.len
                return true
            },
            None => {
                // Allocation failed - keep the old allocation
                return false
            }
        }
    }

    // Free the vector's memory
    pub fn drop(&var self) {
        if self.capacity > 0 {
            let element_size: u32 = @sizeof(T)
            let bytes: u32 = self.capacity * element_size
            // Explicit pointer cast from *T to *u8
            let mem: *u8 = (*u8)(self.ptr)
            unsafe {
                FreeMem(mem, bytes)
            }

            self.ptr = null
            self.len = 0
            self.capacity = 0
        }
    }
}

// Vec<T> implements Iterable<T> - allows use in for-in loops
impl<T> Iterable<T> for Vec<T> {
    // Get the number of elements in the vector
    fn len(&self) -> u32 {
        return self.len
    }

    // Get element at index (safe, returns Option)
    fn get(&self, index: u32) -> Option<T> {
        if index >= self.len {
            return Option::None
        }

        let value: T = self.ptr[index]
        return Option::Some(value)
    }
}

// Automatic cleanup for Vec<T> (RAII)
// Frees the underlying memory when the Vec goes out of scope
impl<T> Drop for Vec<T> {
    fn drop(&var self) {
        if self.capacity > 0 {
            let element_size: u32 = @sizeof(T)
            let bytes: u32 = self.capacity * element_size
            let mem: *u8 = (*u8)(self.ptr)
            unsafe { FreeMem(mem, bytes) }
            self.ptr = null
            self.len = 0
            self.capacity = 0
        }
    }
}

// Clone for Vec<T> - creates a deep copy
impl<T> Clone for Vec<T> {
    fn clone(&self) -> Option<Vec<T>> {
        if self.len == 0 {
            return Option::Some(Vec::<T>::new())
        }

        // Allocate new vector with same capacity
        match Vec::<T>::with_capacity(self.capacity) {
            Some(var new_vec) => {
                // Copy elements
                while var i < self.len {
                    let success = new_vec.push(self.ptr[i])
                    if !success {
                        return Option::None
                    }
                    i++
                }
                return Option::Some(new_vec)
            },
            None => return Option::None,
        }
    }
}
