// Novus Standard Library - Collections Module
// Namespace: std::collections
// Dynamic data structures and collection types

// Import core types and memory management
from std::core import Option, Result, Iterable, From, Drop, Clone
from std::memory::block import MemoryBlock
from std::memory import Slice, MutSlice
from std::memory::errors import MemoryError
from amiga::raw::exec import CopyMem, FreeMem
from amiga::raw::consts import MEMF_PUBLIC, MEMF_CLEAR

/// Vec<T> - dynamic array (growable)
///
/// A contiguous, growable array type with heap-allocated contents.
/// Similar to Rust's Vec or C++'s std::vector.
///
/// ## Features
/// - Automatic memory management via Drop trait (RAII)
/// - Amortized O(1) push with capacity doubling strategy
/// - O(1) indexed access via get/set
/// - Iterable for use in for-in loops
///
/// ## Memory
/// Uses AmigaOS AllocMem with MEMF_PUBLIC for cross-task safe allocations.
/// Memory is automatically freed when the Vec goes out of scope.
///
/// ## Example
/// ```novus
/// var numbers = Vec::<u32>::new()
/// numbers.push(1)
/// numbers.push(2)
/// numbers.push(3)
///
/// for num in numbers {
///     print_u32(num)
/// }
/// // Memory automatically freed here
/// ```
pub struct Vec<T> {
    ptr: *T,
    len: usize,
    capacity: usize,
}

impl<T> Vec<T> {
    // Create an empty vector with zero capacity
    pub fn new() -> Vec<T> {
        return @zeroed(Vec<T>)
    }

    /// Create a vector with pre-allocated capacity
    ///
    /// Returns `Result::Err(MemoryError::OutOfMemory)` if allocation fails.
    ///
    /// # Example
    /// ```novus
    /// let vec = Vec::<u32>::with_capacity(100)?
    /// ```
    pub fn with_capacity(capacity: usize) -> Result<Vec<T>, MemoryError> {
        if capacity == 0 {
            return Result::Ok(@zeroed(Vec<T>))
        }

        let element_size: u32 = @sizeof(T)
        let bytes_needed: u32 = capacity * element_size

        // Allocate with MEMF_PUBLIC | MEMF_CLEAR (clear memory to zero)
        let block_opt = MemoryBlock::alloc(bytes_needed, MEMF_PUBLIC | MEMF_CLEAR)

        match block_opt {
            Result::Ok(var block) => {
                // Take ownership of the raw pointer so MemoryBlock's Drop won't free it
                let raw = block.into_raw()
                // Explicit pointer cast from *u8 to *T
                let ptr: *T = (*T)raw.ptr()
                return Result::Ok(Vec {
                    ptr: ptr,
                    len: 0,
                    capacity: capacity,
                })
            },
            Result::Err(_) => {
                // Allocation failed
                return Result::Err(MemoryError::OutOfMemory)
            }
        }
    }

    // Check if the vector is empty
    pub fn is_empty(&self) -> bool {
        return self.len == 0
    }

    // Get the number of elements in the vector
    pub fn len(&self) -> usize {
        return self.len
    }

    // Get the capacity of the vector
    pub fn capacity(&self) -> usize {
        return self.capacity
    }

    /// Reserve additional capacity (grow if needed)
    ///
    /// Returns `Result::Err(MemoryError::OutOfMemory)` if allocation fails.
    ///
    /// # Example
    /// ```novus
    /// var vec = Vec::<u32>::new()
    /// vec.reserve(100)?
    /// ```
    pub fn reserve(&var self, additional: usize) -> Result<(), MemoryError> {
        let needed_capacity: usize = self.len + additional

        // Only grow if we need more capacity
        if needed_capacity > self.capacity {
            // Calculate new capacity (double current or use needed, whichever is larger)
            var new_capacity: usize = self.capacity * 2
            if new_capacity < needed_capacity {
                new_capacity = needed_capacity
            }

            // Minimum capacity of 4 elements
            if new_capacity < 4 {
                new_capacity = 4
            }

            let element_size: u32 = @sizeof(T)
            let new_bytes: u32 = new_capacity * element_size

            // Allocate with MEMF_PUBLIC | MEMF_CLEAR (clear memory to zero)
            let new_block_opt = MemoryBlock::alloc(new_bytes, MEMF_PUBLIC | MEMF_CLEAR)

            match new_block_opt {
                Result::Ok(var new_block) => {
                    // Take ownership of the raw pointer so MemoryBlock's Drop won't free it
                    let raw = new_block.into_raw()
                    // Explicit pointer cast from *u8 to *T
                    let new_ptr: *T = (*T)raw.ptr()

                    // Copy existing elements to new allocation
                    unsafe {
                        while var i < self.len {
                            new_ptr[i] = self.ptr[i]
                            i++
                        }
                    }

                    // Free old memory if it exists
                    if self.capacity > 0 {
                        let old_bytes: u32 = self.capacity * element_size
                        let old_mem: *u8 = (*u8)(self.ptr)
                        unsafe {
                            FreeMem(old_mem, old_bytes)
                        }
                    }

                    // Update vec fields
                    self.ptr = new_ptr
                    self.capacity = new_capacity
                    return Result::Ok(())
                },
                Result::Err(_) => {
                    // Allocation failed
                    return Result::Err(MemoryError::OutOfMemory)
                }
            }
        }

        return Result::Ok(())
    }

    /// Add an element to the end of the vector
    ///
    /// Returns `Result::Err(MemoryError::OutOfMemory)` if allocation fails.
    ///
    /// # Example
    /// ```novus
    /// var vec = Vec::<u32>::new()
    /// vec.push(42)?
    /// ```
    pub fn push(&var self, consuming value: T) -> Result<(), MemoryError> {
        // Ensure we have capacity
        if self.len >= self.capacity {
            self.reserve(1)?
        }

        // Add the element
        unsafe { self.ptr[self.len] = value }
        self.len++
        return Result::Ok(())
    }

    // Remove and return the last element (returns Option<T>)
    pub fn pop(&var self) -> Option<T> {
        if self.len == 0 {
            return Option::None
        }

        self.len--
        let value: T = unsafe { self.ptr[self.len] }
        return Option::Some(value)
    }

    /// Set element at index
    ///
    /// Returns `Result::Err(MemoryError::IndexOutOfBounds)` if index >= len.
    ///
    /// # Example
    /// ```novus
    /// var vec = Vec::<u32>::new()
    /// vec.push(1)?
    /// vec.set(0, 42)?
    /// ```
    pub fn set(&var self, index: usize, consuming value: T) -> Result<(), MemoryError> {
        if index >= self.len {
            return Result::Err(MemoryError::IndexOutOfBounds)
        }

        unsafe {
            @drop_in_place(&var self.ptr[index])
            self.ptr[index] = value
        }
        return Result::Ok(())
    }

    // Get element at index (returns Option)
    pub fn get(&self, index: usize) -> Option<&T> {
        if index >= self.len {
            return Option::None
        }

        unsafe { return Option::Some(&self.ptr[index]) }
    }

    /// Mutably borrow the element at index.
    pub fn get_mut(&var self, index: usize) -> Option<&var T> {
        if index >= self.len {
            return Option::None
        }

        unsafe { return Option::Some(&var self.ptr[index]) }
    }

    // Remove all elements (keeps capacity)
    pub fn clear(&var self) {
        while self.len > 0 {
            self.len--
            unsafe { @drop_in_place(&var self.ptr[self.len]) }
        }
    }

    // Get immutable pointer to the underlying buffer
    pub fn as_ptr(&self) -> *T {
        return self.ptr
    }

    // Get mutable pointer to the underlying buffer
    pub fn as_mut_ptr(&var self) -> *T {
        return self.ptr
    }

    pub fn as_slice(&self) -> Slice<T> {
        if self.len == 0 {
            // References are non-null; use the Vec object's aligned address as
            // the never-dereferenced sentinel for an empty view.
            unsafe { return Slice::<T>::new(&*((*T)self), 0) }
        }
        return unsafe { Slice::<T>::new(&self.ptr[0], self.len) }
    }

    pub fn as_mut_slice(&var self) -> MutSlice<T> {
        if self.len == 0 {
            unsafe { return MutSlice::<T>::new(&var *((*T)self), 0) }
        }
        return unsafe { MutSlice::<T>::new(&var self.ptr[0], self.len) }
    }

    /// Insert an element at the given index, shifting all elements after it to the right
    ///
    /// Returns `Result::Err(MemoryError::IndexOutOfBounds)` if index > len.
    /// Returns `Result::Err(MemoryError::OutOfMemory)` if allocation fails.
    ///
    /// # Example
    /// ```novus
    /// var vec = Vec::<u32>::new()
    /// vec.push(1)?
    /// vec.push(3)?
    /// vec.insert(1, 2)?  // vec is now [1, 2, 3]
    /// ```
    pub fn insert(&var self, index: usize, consuming value: T) -> Result<(), MemoryError> {
        // Check bounds - can insert at len (append position)
        if index > self.len {
            return Result::Err(MemoryError::IndexOutOfBounds)
        }

        // Ensure we have capacity
        if self.len >= self.capacity {
            self.reserve(1)?
        }

        // Shift elements right to make room
        var i: usize = self.len
        unsafe {
            while i > index {
                self.ptr[i] = self.ptr[i - 1]
                i--
            }

            // Insert the element
            self.ptr[index] = value
        }
        self.len++
        return Result::Ok(())
    }

    /// Remove element at the given index, shifting all elements after it to the left
    ///
    /// Returns `Result::Err(MemoryError::IndexOutOfBounds)` if index >= len.
    ///
    /// # Example
    /// ```novus
    /// var vec = Vec::<u32>::new()
    /// vec.push(1)?
    /// vec.push(2)?
    /// vec.push(3)?
    /// let removed = vec.remove(1)?  // Returns 2, vec is now [1, 3]
    /// ```
    pub fn remove(&var self, index: usize) -> Result<T, MemoryError> {
        if index >= self.len {
            return Result::Err(MemoryError::IndexOutOfBounds)
        }

        // Save the value to return
        let value: T = unsafe { self.ptr[index] }

        // Shift elements left
        var i: usize = index
        unsafe {
            while i < self.len - 1 {
                self.ptr[i] = self.ptr[i + 1]
                i++
            }
        }

        self.len--
        return Result::Ok(value)
    }

    /// Shorten the vector to the given length
    ///
    /// If new_len is greater than or equal to the current length, this does nothing.
    /// Capacity is unchanged.
    ///
    /// Example:
    /// ```novus
    /// var vec = Vec::new()
    /// vec.push(1)
    /// vec.push(2)
    /// vec.push(3)
    /// vec.truncate(1)  // vec is now [1]
    /// ```
    pub fn truncate(&var self, new_len: usize) {
        while self.len > new_len {
            self.len--
            unsafe { @drop_in_place(&var self.ptr[self.len]) }
        }
    }

    /// Shrink the capacity to match the length
    ///
    /// Returns `Result::Err(MemoryError::OutOfMemory)` if reallocation fails.
    /// On failure, the vector is unchanged.
    ///
    /// # Example
    /// ```novus
    /// var vec = Vec::<u32>::with_capacity(100)?
    /// vec.push(1)?
    /// vec.push(2)?
    /// vec.shrink_to_fit()?  // Reduces capacity from 100 to 2
    /// ```
    pub fn shrink_to_fit(&var self) -> Result<(), MemoryError> {
        // Nothing to do if already optimal
        if self.len == self.capacity {
            return Result::Ok(())
        }

        // Special case: empty vector
        if self.len == 0 {
            if self.capacity > 0 {
                let element_size: u32 = @sizeof(T)
                let bytes: u32 = self.capacity * element_size
                let mem: *u8 = (*u8)(self.ptr)
                unsafe {
                    FreeMem(mem, bytes)
                }
                self.ptr = null
                self.capacity = 0
            }
            return Result::Ok(())
        }

        // Allocate new smaller buffer
        let element_size: u32 = @sizeof(T)
        let new_bytes: u32 = self.len * element_size

        let new_block_opt = MemoryBlock::alloc(new_bytes, MEMF_PUBLIC | MEMF_CLEAR)

        match new_block_opt {
            Result::Ok(var new_block) => {
                // Take ownership of the raw pointer so MemoryBlock's Drop won't free it
                let raw = new_block.into_raw()
                let new_ptr: *T = (*T)raw.ptr()

                // Copy existing elements to new allocation
                unsafe {
                    while var i < self.len {
                        new_ptr[i] = self.ptr[i]
                        i++
                    }
                }

                // Free old memory
                let old_bytes: u32 = self.capacity * element_size
                let old_mem: *u8 = (*u8)(self.ptr)
                unsafe {
                    FreeMem(old_mem, old_bytes)
                }

                // Update vec fields
                self.ptr = new_ptr
                self.capacity = self.len
                return Result::Ok(())
            },
            Result::Err(_) => {
                // Allocation failed - keep the old allocation
                return Result::Err(MemoryError::OutOfMemory)
            }
        }
    }

    // Free the vector's memory
    pub fn drop(&var self) {
        if self.capacity > 0 {
            self.clear()
            let element_size: u32 = @sizeof(T)
            let bytes: u32 = self.capacity * element_size
            // Explicit pointer cast from *T to *u8
            let mem: *u8 = (*u8)(self.ptr)
            unsafe {
                FreeMem(mem, bytes)
            }

            self.ptr = null
            self.len = 0
            self.capacity = 0
        }
    }
}

// Vec<T> implements Iterable<T> - allows use in for-in loops
impl<T> Iterable<T> for Vec<T> {
    // Get the number of elements in the vector
    fn len(&self) -> usize {
        return self.len
    }

    @unsafe
    fn get_unchecked(&self, index: usize) -> &T {
        unsafe { return &self.ptr[index] }
    }
}

// Automatic cleanup for Vec<T> (RAII)
// Frees the underlying memory when the Vec goes out of scope
impl<T> Drop for Vec<T> {
    fn drop(&var self) {
        if self.capacity > 0 {
            self.clear()
            let element_size: u32 = @sizeof(T)
            let bytes: u32 = self.capacity * element_size
            let mem: *u8 = (*u8)(self.ptr)
            unsafe { FreeMem(mem, bytes) }
            self.ptr = null
            self.len = 0
            self.capacity = 0
        }
    }
}

// Clone for Vec<T> - creates a deep copy
impl<T> Clone for Vec<T> where T: Clone {
    fn clone(&self) -> Option<Vec<T>> {
        if self.len == 0 {
            return Option::Some(Vec::<T>::new())
        }

        // Allocate new vector with same capacity
        match Vec::<T>::with_capacity(self.capacity) {
            Result::Ok(var new_vec) => {
                // Copy elements
                unsafe {
                    while var i < self.len {
                        match self.ptr[i].clone() {
                            Option::Some(value) => match new_vec.push(value) {
                                Result::Ok(_) => {},
                                Result::Err(_) => return Option::None,
                            },
                            Option::None => return Option::None,
                        }
                        i++
                    }
                }
                return Option::Some(new_vec)
            },
            Result::Err(_) => return Option::None,
        }
    }
}
