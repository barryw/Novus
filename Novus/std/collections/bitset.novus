// Novus Standard Library - BitSet Module
// Namespace: std::collections
// A compact bit storage for boolean flags

from std::core import Option, Result, Drop
from std::memory::errors import MemoryError
from std::memory::block import MemoryBlock
from amiga::raw::exec import FreeMem
from amiga::raw::consts import MEMF_PUBLIC, MEMF_CLEAR

// ============================================================================
// BitSet - Compact bit storage for boolean flags
// ============================================================================

/// BitSet - Compact storage for boolean flags using 1 bit per element
///
/// Uses u32 words internally, so 32 booleans fit in 4 bytes.
/// Essential for resource-constrained Amiga development.
///
/// ## Features
/// - 1 bit per boolean (32x more compact than bool array)
/// - O(1) set, get, toggle operations
/// - Bitwise operations: and, or, xor, not
/// - Population count and first-set-bit search
/// - Automatic memory management via Drop trait (RAII)
///
/// ## Example
/// ```novus
/// var flags = BitSet::with_capacity(64)?  // 64 bits = 8 bytes
/// flags.set(5)?
/// flags.set(10)?
///
/// if flags.get(5)? {
///     // bit 5 is set
/// }
///
/// let count = flags.count_ones()  // Returns 2
/// ```
pub struct BitSet {
    data: *u32,      // Array of u32 words (32 bits each)
    num_bits: usize,   // Total number of bits
    num_words: usize,  // Number of u32 words
}

impl BitSet {
    /// Create an empty BitSet with zero capacity
    pub fn new() -> BitSet {
        return @zeroed(BitSet)
    }

    /// Create a BitSet with capacity for num_bits
    ///
    /// All bits are initially cleared (false).
    /// Returns a typed allocation error on failure.
    pub fn with_capacity(num_bits: usize) -> Result<BitSet, MemoryError> {
        if num_bits == 0 {
            return Result::Ok(@zeroed(BitSet))
        }

        // Calculate number of u32 words needed (round up)
        let num_words: usize = (num_bits + 31) / 32
        let bytes_needed: u32 = num_words * 4

        let block_opt = MemoryBlock::alloc(bytes_needed, MEMF_PUBLIC | MEMF_CLEAR)

        match block_opt {
            Result::Ok(var block) => {
                let raw = block.into_raw()
                let data: *u32 = (*u32)raw.ptr()
                return Result::Ok(BitSet {
                    data: data,
                    num_bits: num_bits,
                    num_words: num_words,
                })
            },
            Result::Err(error) => return Result::Err(error),
        }
    }

    /// Set bit at index to true
    ///
    pub fn set(&var self, index: usize) -> Result<(), MemoryError> {
        if index >= self.num_bits {
            return Result::Err(MemoryError::IndexOutOfBounds)
        }

        let word_index: usize = index / 32
        let bit_index: usize = index % 32
        let mask: u32 = 1 << bit_index

        unsafe { self.data[word_index] = self.data[word_index] | mask }
        return Result::Ok(())
    }

    /// Clear bit at index to false
    ///
    pub fn clear(&var self, index: usize) -> Result<(), MemoryError> {
        if index >= self.num_bits {
            return Result::Err(MemoryError::IndexOutOfBounds)
        }

        let word_index: usize = index / 32
        let bit_index: usize = index % 32
        let mask: u32 = 1 << bit_index

        unsafe { self.data[word_index] = self.data[word_index] & (~mask) }
        return Result::Ok(())
    }

    /// Set bit at index to the given value
    ///
    pub fn set_value(&var self, index: usize, value: bool) -> Result<(), MemoryError> {
        if value {
            return self.set(index)
        } else {
            return self.clear(index)
        }
    }

    /// Get bit at index
    ///
    pub fn get(&self, index: usize) -> Result<bool, MemoryError> {
        if index >= self.num_bits {
            return Result::Err(MemoryError::IndexOutOfBounds)
        }

        let word_index: usize = index / 32
        let bit_index: usize = index % 32
        let mask: u32 = 1 << bit_index

        return Result::Ok(unsafe { (self.data[word_index] & mask) != 0 })
    }

    /// Toggle bit at index (flip true<->false)
    ///
    pub fn toggle(&var self, index: usize) -> Result<(), MemoryError> {
        if index >= self.num_bits {
            return Result::Err(MemoryError::IndexOutOfBounds)
        }

        let word_index: usize = index / 32
        let bit_index: usize = index % 32
        let mask: u32 = 1 << bit_index

        unsafe { self.data[word_index] = self.data[word_index] ^ mask }
        return Result::Ok(())
    }

    /// Set all bits to true
    pub fn set_all(&var self) {
        var i: usize = 0
        while i < self.num_words {
            unsafe { self.data[i] = 0xFFFFFFFF }
            i = i + 1
        }

        // Clear any unused bits in the last word
        let used_bits_in_last: usize = self.num_bits % 32
        if used_bits_in_last != 0 && self.num_words > 0 {
            let mask: u32 = (1 << used_bits_in_last) - 1
            unsafe { self.data[self.num_words - 1] = self.data[self.num_words - 1] & mask }
        }
    }

    /// Clear all bits to false
    pub fn clear_all(&var self) {
        var i: usize = 0
        while i < self.num_words {
            unsafe { self.data[i] = 0 }
            i = i + 1
        }
    }

    /// Count number of set bits (population count)
    pub fn count_ones(&self) -> usize {
        var count: usize = 0
        var i: usize = 0

        while i < self.num_words {
            count = count + BitSet::popcount(unsafe { self.data[i] })
            i = i + 1
        }

        return count
    }

    /// Count number of cleared bits
    pub fn count_zeros(&self) -> usize {
        return self.num_bits - self.count_ones()
    }

    /// Find index of first set bit
    ///
    /// Returns None if no bits are set.
    pub fn find_first_set(&self) -> Option<usize> {
        var word_idx: usize = 0

        while word_idx < self.num_words {
            let word: u32 = unsafe { self.data[word_idx] }
            if word != 0 {
                // Find first set bit in this word
                let bit_pos: usize = BitSet::find_first_set_bit(word)
                let index: usize = word_idx * 32 + bit_pos

                // Make sure we don't return an index beyond num_bits
                if index < self.num_bits {
                    return Option::Some(index)
                } else {
                    return Option::None
                }
            }
            word_idx = word_idx + 1
        }

        return Option::None
    }

    /// Find index of first cleared bit
    ///
    /// Returns None if all bits are set.
    pub fn find_first_clear(&self) -> Option<usize> {
        var word_idx: usize = 0

        while word_idx < self.num_words {
            let word: u32 = unsafe { self.data[word_idx] }
            if word != 0xFFFFFFFF {
                // Find first clear bit in this word (first set bit in inverted word)
                let bit_pos: usize = BitSet::find_first_set_bit(~word)
                let index: usize = word_idx * 32 + bit_pos

                // Make sure we don't return an index beyond num_bits
                if index < self.num_bits {
                    return Option::Some(index)
                } else {
                    return Option::None
                }
            }
            word_idx = word_idx + 1
        }

        return Option::None
    }

    /// Bitwise AND with another bitset (self &= other)
    ///
    /// Sets require the same size.
    pub fn and(&var self, other: &BitSet) -> Result<(), MemoryError> {
        if self.num_bits != other.num_bits {
            return Result::Err(MemoryError::CapacityExceeded)
        }

        var i: usize = 0
        while i < self.num_words {
            unsafe { self.data[i] = self.data[i] & other.data[i] }
            i = i + 1
        }

        return Result::Ok(())
    }

    /// Bitwise OR with another bitset (self |= other)
    ///
    /// Sets require the same size.
    pub fn or(&var self, other: &BitSet) -> Result<(), MemoryError> {
        if self.num_bits != other.num_bits {
            return Result::Err(MemoryError::CapacityExceeded)
        }

        var i: usize = 0
        while i < self.num_words {
            unsafe { self.data[i] = self.data[i] | other.data[i] }
            i = i + 1
        }

        return Result::Ok(())
    }

    /// Bitwise XOR with another bitset (self ^= other)
    ///
    /// Sets require the same size.
    pub fn xor(&var self, other: &BitSet) -> Result<(), MemoryError> {
        if self.num_bits != other.num_bits {
            return Result::Err(MemoryError::CapacityExceeded)
        }

        var i: usize = 0
        while i < self.num_words {
            unsafe { self.data[i] = self.data[i] ^ other.data[i] }
            i = i + 1
        }

        return Result::Ok(())
    }

    /// Bitwise NOT (complement all bits)
    pub fn not(&var self) {
        var i: usize = 0
        while i < self.num_words {
            unsafe { self.data[i] = ~self.data[i] }
            i = i + 1
        }

        // Clear any unused bits in the last word
        let used_bits_in_last: usize = self.num_bits % 32
        if used_bits_in_last != 0 && self.num_words > 0 {
            let mask: u32 = (1 << used_bits_in_last) - 1
            unsafe { self.data[self.num_words - 1] = self.data[self.num_words - 1] & mask }
        }
    }

    /// Get the number of bits
    pub fn len(&self) -> usize {
        return self.num_bits
    }

    /// Check if the bitset is empty (has zero capacity)
    pub fn is_empty(&self) -> bool {
        return self.num_bits == 0
    }

    /// Check if all bits are set
    pub fn all(&self) -> bool {
        return self.count_ones() == self.num_bits
    }

    /// Check if any bit is set
    pub fn any(&self) -> bool {
        var i: usize = 0
        while i < self.num_words {
            if unsafe { self.data[i] != 0 } {
                return true
            }
            i = i + 1
        }
        return false
    }

    /// Check if no bits are set
    pub fn none(&self) -> bool {
        return !self.any()
    }

    // Internal: Population count (number of set bits in a u32)
    // Uses Brian Kernighan's algorithm
    fn popcount(n: u32) -> usize {
        var count: usize = 0
        var value: u32 = n

        while value != 0 {
            value = value & (value - 1)
            count = count + 1
        }

        return count
    }

    // Internal: Find position of first set bit in a u32 (0-31)
    // Returns 0 if n is 0 (caller should check for 0)
    fn find_first_set_bit(n: u32) -> usize {
        if n == 0 {
            return 0
        }

        var pos: usize = 0
        var value: u32 = n

        // Binary search for the first set bit
        if (value & 0x0000FFFF) == 0 {
            pos = pos + 16
            value = value >> 16
        }
        if (value & 0x000000FF) == 0 {
            pos = pos + 8
            value = value >> 8
        }
        if (value & 0x0000000F) == 0 {
            pos = pos + 4
            value = value >> 4
        }
        if (value & 0x00000003) == 0 {
            pos = pos + 2
            value = value >> 2
        }
        if (value & 0x00000001) == 0 {
            pos = pos + 1
        }

        return pos
    }
}

// Automatic cleanup for BitSet (RAII)
impl Drop for BitSet {
    fn drop(&var self) {
        if self.num_words > 0 {
            let bytes: u32 = self.num_words * 4
            let mem: *u8 = (*u8)(self.data)
            unsafe {
                FreeMem(mem, bytes)
            }
            self.data = null
            self.num_bits = 0
            self.num_words = 0
        }
    }
}
