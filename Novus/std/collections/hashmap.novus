// Novus Standard Library - HashMap Module
// Namespace: std::collections
// A hash map implementation using open addressing with linear probing
//
// This implementation supports any key type that implements Hash + Eq traits.
// Optimized for 68k performance with cached sizes and shift-based calculations.

from std::core import Option, Result, Drop, Hash, Eq
from std::memory::block import MemoryBlock
from amiga::raw::exec import FreeMem
from amiga::raw::consts import MEMF_PUBLIC, MEMF_CLEAR
from std::memory::errors import MemoryError

// ============================================================================
// Entry State - Tracks bucket occupancy
// ============================================================================

/// Entry state for tracking bucket occupancy
/// Used internally by HashMap
pub enum EntryState {
    Empty,      // Never used
    Occupied,   // Contains a key-value pair
    Tombstone,  // Was occupied, now deleted (needed for linear probing)
}

// ============================================================================
// HashMapEntry - Internal bucket structure for generic keys
// ============================================================================

/// Internal entry structure for HashMap buckets
pub struct HashMapEntry<K, V> {
    state: EntryState,
    key: K,
    value: V,
}

// ============================================================================
// HashMap<K, V> - Generic hash map with trait-bounded keys
// ============================================================================

/// HashMap<K, V> - A hash table with generic keys using open addressing
///
/// This implementation uses:
/// - Open addressing (all entries stored in a single array)
/// - Linear probing for collision resolution
/// - Tombstones for deletion support
/// - Automatic resizing at 70% load factor
/// - Key hashing via the Hash trait
/// - Key equality via the Eq trait
/// - Optimized for 68k: cached sizes, shift-based calculations
///
/// Example:
/// ```novus
/// var map: HashMap<u32, u32> = HashMap::new()?
/// let _ = map.insert(1, 100)?
/// let _ = map.insert(2, 200)?
///
/// match map.get(&1) {
///     Some(val_ptr) => print_num(*val_ptr),
///     None => print("not found")
/// }
/// ```
pub struct HashMap<K, V> where K: Hash + Eq {
    entries: *HashMapEntry<K, V>,
    capacity: u32,
    len: u32,
    tombstones: u32,
    // Cached for 68k performance (avoids expensive multiplication)
    entry_size: u32,
    // Pre-computed resize threshold: capacity * 7 / 10
    resize_threshold: u32,
}

impl<K, V> HashMap<K, V> where K: Hash + Eq {
    /// Create a new empty HashMap with default capacity (16)
    /// Returns MemoryError if memory allocation fails
    pub fn new() -> Result<HashMap<K, V>, MemoryError> {
        return HashMap::<K, V>::with_capacity(16)
    }

    /// Create a new HashMap with the specified initial capacity
    /// Returns MemoryError if memory allocation fails
    ///
    /// The capacity will be rounded up to a power of 2 for efficient modulo.
    pub fn with_capacity(requested: u32) -> Result<HashMap<K, V>, MemoryError> {
        // Check for overflow - max capacity is 1GB worth of entries
        if requested > 0x4000_0000 {
            return Result::Err(MemoryError::OutOfMemory)
        }

        // Round up to power of 2 for fast modulo (using bitwise AND)
        let capacity: u32 = HashMap::<K, V>::next_power_of_two(requested)

        // Check if next_power_of_two overflowed
        if capacity == 0 {
            return Result::Err(MemoryError::OutOfMemory)
        }

        let entry_size: u32 = @sizeof(HashMapEntry<K, V>)
        let bytes_needed: u32 = capacity * entry_size

        match MemoryBlock::alloc(bytes_needed, MEMF_PUBLIC | MEMF_CLEAR) {
            Result::Ok(var block) => {
                let entries: *HashMapEntry<K, V> = (*HashMapEntry<K, V>)block.ptr()

                // Initialize all entries as Empty
                var i: u32 = 0
                unsafe {
                    while i < capacity {
                        entries[i].state = EntryState::Empty
                        i = i + 1
                    }
                }

                // Take ownership of memory - HashMap will manage it directly
                // This prevents MemoryBlock's Drop from freeing the memory
                block.into_raw()

                // Pre-compute resize threshold: capacity * 7 / 10
                // Using shifts: (capacity * 7) / 10 ≈ (capacity >> 1) + (capacity >> 3) + (capacity >> 4)
                // Simpler: just use capacity - (capacity >> 2) - (capacity >> 4) ≈ 70%
                let threshold: u32 = capacity - (capacity >> 2) - (capacity >> 4)

                return Result::Ok(HashMap {
                    entries: entries,
                    capacity: capacity,
                    len: 0,
                    tombstones: 0,
                    entry_size: entry_size,
                    resize_threshold: threshold,
                })
            },
            Result::Err(error) => return Result::Err(error),
        }
    }

    /// Get the number of key-value pairs in the map
    pub fn len(&self) -> u32 {
        return self.len
    }

    /// Check if the map is empty
    pub fn is_empty(&self) -> bool {
        return self.len == 0
    }

    /// Get the current capacity
    pub fn capacity(&self) -> u32 {
        return self.capacity
    }

    /// Get the current load factor as a percentage (0-100)
    pub fn load_factor(&self) -> u32 {
        if self.capacity == 0 {
            return 0
        }
        return (self.len * 100) / self.capacity
    }

    /// Insert a key-value pair into the map
    ///
    /// If the key already exists, the value is updated and the old value is returned as Some(old_value).
    /// Returns Ok(None) if this is a new key.
    /// Returns Err(MemoryError) on allocation failure during resize (map unchanged).
    pub fn insert(&var self, consuming key: K, consuming value: V) -> Result<Option<V>, MemoryError> {
        // Check if we need to resize using pre-computed threshold
        if self.len + self.tombstones + 1 > self.resize_threshold {
            let resize_result: Result<(), MemoryError> = self.resize(self.capacity << 1)  // Shift instead of multiply
            match resize_result {
                Result::Err(err) => {
                    // Resize failed, but we might still have room
                    if self.len + self.tombstones >= self.capacity {
                        return Result::Err(err)
                    }
                },
                Result::Ok(_) => {}
            }
        }

        let hash: u32 = key.hash()
        let mask: u32 = self.capacity - 1
        var index: u32 = hash & mask
        var tombstone_index: Option<u32> = Option::None

        // Linear probing
        var probes: u32 = 0
        while probes < self.capacity {
            let state: EntryState = unsafe { self.entries[index].state }

            match state {
                EntryState::Empty => {
                    // Found empty slot - use tombstone slot if we passed one
                    match tombstone_index {
                        Option::Some(ti) => {
                            unsafe {
                                self.entries[ti].state = EntryState::Occupied
                                self.entries[ti].key = key
                                self.entries[ti].value = value
                            }
                            self.len = self.len + 1
                            self.tombstones = self.tombstones - 1
                        },
                        Option::None => {
                            unsafe {
                                self.entries[index].state = EntryState::Occupied
                                self.entries[index].key = key
                                self.entries[index].value = value
                            }
                            self.len = self.len + 1
                        }
                    }
                    return Result::Ok(Option::None)
                },
                EntryState::Tombstone => {
                    // Remember first tombstone for potential reuse
                    if tombstone_index.is_none() {
                        tombstone_index = Option::Some(index)
                    }
                },
                EntryState::Occupied => {
                    // Check if this is the same key using Eq trait
                    if unsafe { self.entries[index].key.eq(&key) } {
                        // Update existing entry
                        let old_value: V = unsafe { self.entries[index].value }
                        unsafe { self.entries[index].value = value }
                        return Result::Ok(Option::Some(old_value))
                    }
                }
            }

            index = (index + 1) & mask
            probes = probes + 1
        }

        // Table is full (shouldn't happen with proper resizing)
        return Result::Err(MemoryError::OutOfMemory)
    }

    /// Get a reference to the value associated with the key
    ///
    /// Returns Some(ref_to_value) if found, None otherwise.
    pub fn get(&self, key: &K) -> Option<&V> {
        if self.len == 0 {
            return Option::None
        }

        let hash: u32 = key.hash()
        let mask: u32 = self.capacity - 1
        var index: u32 = hash & mask

        var probes: u32 = 0
        while probes < self.capacity {
            let state: EntryState = unsafe { self.entries[index].state }

            match state {
                EntryState::Empty => {
                    // Key not found
                    return Option::None
                },
                EntryState::Tombstone => {
                    // Continue searching
                },
                EntryState::Occupied => {
                    if unsafe { self.entries[index].key.eq(key) } {
                        // Found it - return reference to value
                        let ref_val: &V = unsafe { &self.entries[index].value }
                        return Option::Some(ref_val)
                    }
                }
            }

            index = (index + 1) & mask
            probes = probes + 1
        }

        return Option::None
    }

    /// Get a mutable reference to the value associated with the key
    ///
    /// Returns Some(ref_to_value) if found, None otherwise.
    /// Allows in-place modification of values.
    pub fn get_mut(&var self, key: &K) -> Option<&var V> {
        if self.len == 0 {
            return Option::None
        }

        let hash: u32 = key.hash()
        let mask: u32 = self.capacity - 1
        var index: u32 = hash & mask

        var probes: u32 = 0
        while probes < self.capacity {
            let state: EntryState = unsafe { self.entries[index].state }

            match state {
                EntryState::Empty => {
                    return Option::None
                },
                EntryState::Tombstone => {
                    // Continue searching
                },
                EntryState::Occupied => {
                    if unsafe { self.entries[index].key.eq(key) } {
                        // Found it - return mutable reference to value
                        let ref_val: &var V = unsafe { &var self.entries[index].value }
                        return Option::Some(ref_val)
                    }
                }
            }

            index = (index + 1) & mask
            probes = probes + 1
        }

        return Option::None
    }

    /// Check if the map contains the given key
    pub fn contains_key(&self, key: &K) -> bool {
        return self.get(key).is_some()
    }

    /// Remove a key-value pair from the map
    ///
    /// Returns Some(value) if the key was found and removed, None otherwise.
    pub fn remove(&var self, key: &K) -> Option<V> {
        if self.len == 0 {
            return Option::None
        }

        let hash: u32 = key.hash()
        let mask: u32 = self.capacity - 1
        var index: u32 = hash & mask

        var probes: u32 = 0
        while probes < self.capacity {
            let state: EntryState = unsafe { self.entries[index].state }

            match state {
                EntryState::Empty => {
                    return Option::None
                },
                EntryState::Tombstone => {
                    // Continue searching
                },
                EntryState::Occupied => {
                    if unsafe { self.entries[index].key.eq(key) } {
                        // Found it - mark as tombstone
                        let value: V = unsafe { self.entries[index].value }
                        unsafe { self.entries[index].state = EntryState::Tombstone }
                        self.len = self.len - 1
                        self.tombstones = self.tombstones + 1

                        // Auto-compact if tombstones are excessive (> 25% of capacity)
                        if self.tombstones > (self.capacity >> 2) {
                            // Ignore compact errors - removal succeeded regardless
                            let _ = self.compact()
                        }

                        return Option::Some(value)
                    }
                }
            }

            index = (index + 1) & mask
            probes = probes + 1
        }

        return Option::None
    }

    /// Remove all entries from the map
    ///
    /// This keeps the current capacity but marks all entries as empty.
    pub fn clear(&var self) {
        var i: u32 = 0
        while i < self.capacity {
            unsafe { self.entries[i].state = EntryState::Empty }
            i = i + 1
        }
        self.len = 0
        self.tombstones = 0
    }

    /// Ensure capacity for at least `additional` more elements
    ///
    /// Returns Ok(()) if successful, Err(MemoryError) if allocation failed.
    pub fn reserve(&var self, additional: u32) -> Result<(), MemoryError> {
        let needed: u32 = self.len + additional
        // Account for 70% load factor
        let required_capacity: u32 = needed + (needed >> 1)  // needed * 1.5 ≈ needed / 0.7

        if required_capacity > self.capacity {
            let new_cap: u32 = HashMap::<K, V>::next_power_of_two(required_capacity)
            if new_cap == 0 {
                return Result::Err(MemoryError::OutOfMemory)  // Overflow
            }
            return self.resize(new_cap)
        }
        return Result::Ok(())
    }

    /// Compact tombstones by rehashing without growing capacity
    ///
    /// Call this to reclaim wasted slots after many removals.
    /// Automatically called when tombstones exceed 25% of capacity.
    pub fn compact(&var self) -> Result<(), MemoryError> {
        if self.tombstones == 0 {
            return Result::Ok(())  // Nothing to compact
        }
        // Resize to same capacity - this clears all tombstones
        return self.resize(self.capacity)
    }

    /// Shrink capacity to fit current length (reclaim memory)
    ///
    /// Returns Ok(()) if successful, Err(MemoryError) if allocation failed.
    pub fn shrink_to_fit(&var self) -> Result<(), MemoryError> {
        if self.len == 0 {
            // Free everything and reset to minimal state
            if self.entries != null {
                let bytes: u32 = self.capacity * self.entry_size
                let mem: *u8 = (*u8)self.entries
                unsafe {
                    FreeMem(mem, bytes)
                }
            }
            self.entries = null
            self.capacity = 0
            self.tombstones = 0
            self.resize_threshold = 0
            return Result::Ok(())
        }

        // Calculate minimum capacity (account for 70% load factor)
        let min_cap: u32 = self.len + (self.len >> 1)  // len * 1.5
        var ideal_cap: u32 = HashMap::<K, V>::next_power_of_two(min_cap)

        // Enforce minimum capacity of 16
        if ideal_cap < 16 {
            ideal_cap = 16
        }

        // Only resize if it would actually reduce capacity
        if ideal_cap < self.capacity {
            return self.resize(ideal_cap)
        }
        return Result::Ok(())
    }

    /// Internal: Resize the hash table to a new capacity
    fn resize(&var self, new_capacity: u32) -> Result<(), MemoryError> {
        // Don't use MEMF_CLEAR - we initialize entries manually
        let bytes_needed: u32 = new_capacity * self.entry_size

        match MemoryBlock::alloc(bytes_needed, MEMF_PUBLIC) {
            Result::Ok(var block) => {
                let new_entries: *HashMapEntry<K, V> = (*HashMapEntry<K, V>)block.ptr()

                // Take ownership of memory before block goes out of scope
                block.into_raw()

                // Initialize all new entries as Empty
                var i: u32 = 0
                unsafe {
                    while i < new_capacity {
                        new_entries[i].state = EntryState::Empty
                        i = i + 1
                    }
                }

                // Re-insert all occupied entries
                let old_entries: *HashMapEntry<K, V> = self.entries
                let old_capacity: u32 = self.capacity
                let mask: u32 = new_capacity - 1

                i = 0
                while i < old_capacity {
                    match unsafe { old_entries[i].state } {
                        EntryState::Occupied => {
                            // Compute new index using Hash trait
                            let hash: u32 = unsafe { old_entries[i].key.hash() }
                            var index: u32 = hash & mask

                            // Linear probe to find empty slot
                            while unsafe { new_entries[index].state != EntryState::Empty } {
                                index = (index + 1) & mask
                            }

                            // Copy entry
                            unsafe {
                                new_entries[index].state = EntryState::Occupied
                                new_entries[index].key = old_entries[i].key
                                new_entries[index].value = old_entries[i].value
                            }
                        },
                        _ => {
                            // Skip empty and tombstone entries
                        }
                    }
                    i = i + 1
                }

                // Free old entries (use cached entry_size)
                if old_entries != null {
                    let old_bytes: u32 = old_capacity * self.entry_size
                    let old_mem: *u8 = (*u8)old_entries
                    unsafe {
                        FreeMem(old_mem, old_bytes)
                    }
                }

                // Update map fields
                self.entries = new_entries
                self.capacity = new_capacity
                self.tombstones = 0
                // Recalculate threshold: ~70% of new capacity
                self.resize_threshold = new_capacity - (new_capacity >> 2) - (new_capacity >> 4)

                return Result::Ok(())
            },
            Result::Err(error) => return Result::Err(error),
        }
    }

    /// Internal: Round up to the next power of 2
    fn next_power_of_two(n: u32) -> u32 {
        if n == 0 {
            return 1
        }
        if n > 0x8000_0000 {
            return 0  // Would overflow
        }

        var v: u32 = n - 1
        v = v | (v >> 1)
        v = v | (v >> 2)
        v = v | (v >> 4)
        v = v | (v >> 8)
        v = v | (v >> 16)
        return v + 1
    }

    /// Create an iterator over the map's key-value pairs
    ///
    /// Returns references to keys and values, not copies.
    pub fn iter(&self) -> HashMapIter<K, V> {
        return HashMapIter {
            map: self,
            current: 0,
        }
    }

    /// Get the number of tombstones (for debugging/statistics)
    pub fn tombstone_count(&self) -> u32 {
        return self.tombstones
    }
}

// Automatic cleanup for HashMap (RAII)
impl<K, V> Drop for HashMap<K, V> where K: Hash + Eq {
    fn drop(&var self) {
        if self.entries != null && self.capacity > 0 {
            let bytes: u32 = self.capacity * self.entry_size
            let mem: *u8 = (*u8)self.entries
            unsafe {
                FreeMem(mem, bytes)
            }
            self.entries = null
            self.capacity = 0
            self.len = 0
            self.tombstones = 0
        }
    }
}

// ============================================================================
// HashMapIter - Iterator for HashMap (returns references)
// ============================================================================

/// Iterator over HashMap entries
/// Returns references to avoid copying keys/values
pub struct HashMapIter<K, V> {
    map: &HashMap<K, V>,
    current: u32,
}

/// Key-value reference pair returned by iterator
pub struct KeyValueRef<K, V> {
    key: &K,
    value: &V,
}

impl<K, V> HashMapIter<K, V> {
    /// Get the next key-value pair as references
    ///
    /// Returns Some(KeyValueRef) if there are more entries, None when done.
    /// References are valid as long as the HashMap is not modified.
    pub fn next(&var self) -> Option<KeyValueRef<K, V>> {
        while self.current < self.map.capacity {
            let idx: u32 = self.current
            self.current = self.current + 1

            match unsafe { self.map.entries[idx].state } {
                EntryState::Occupied => {
                    return Option::Some(KeyValueRef {
                        key: unsafe { &self.map.entries[idx].key },
                        value: unsafe { &self.map.entries[idx].value },
                    })
                },
                _ => {
                    // Skip empty and tombstone entries
                }
            }
        }

        return Option::None
    }

    /// Reset the iterator to the beginning
    pub fn reset(&var self) {
        self.current = 0
    }
}

// ============================================================================
// Mutable Iterator for HashMap
// ============================================================================

/// Mutable iterator over HashMap entries
pub struct HashMapIterMut<K, V> {
    map: &var HashMap<K, V>,
    current: u32,
}

/// Key-value reference pair with mutable value
pub struct KeyValueMut<K, V> {
    key: &K,
    value: &var V,
}

impl<K, V> HashMap<K, V> where K: Hash + Eq {
    /// Create a mutable iterator over the map's key-value pairs
    ///
    /// Allows modifying values in-place during iteration.
    pub fn iter_mut(&var self) -> HashMapIterMut<K, V> {
        return HashMapIterMut {
            map: self,
            current: 0,
        }
    }
}

impl<K, V> HashMapIterMut<K, V> {
    /// Get the next key-value pair with mutable value reference
    pub fn next(&var self) -> Option<KeyValueMut<K, V>> {
        while self.current < self.map.capacity {
            let idx: u32 = self.current
            self.current = self.current + 1

            match unsafe { self.map.entries[idx].state } {
                EntryState::Occupied => {
                    return Option::Some(KeyValueMut {
                        key: unsafe { &self.map.entries[idx].key },
                        value: unsafe { &var self.map.entries[idx].value },
                    })
                },
                _ => {
                    // Skip empty and tombstone entries
                }
            }
        }

        return Option::None
    }

    /// Reset the iterator to the beginning
    pub fn reset(&var self) {
        self.current = 0
    }
}
