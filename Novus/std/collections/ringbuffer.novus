// Novus Standard Library - RingBuffer
// A fixed-size circular buffer for streaming data
//
// ## Amiga Use Cases
// - Paula audio sample streaming (16-bit PCM at 28kHz = 56KB/s)
// - Serial port buffering (19200 baud = 2.4KB/s)
// - Vertical blank event queues (50Hz PAL = 50 events/s)
// - Trackdisk sector buffering (880KB floppy = 512-byte sectors)
// - Interrupt handler to main task communication
//
// ## Interrupt Handler Safety
//
// RingBuffer is safe for single-producer/single-consumer patterns:
// - Producer: Interrupt handler (writes via push_back)
// - Consumer: Main task (reads via pop_front)
//
// NOT safe for:
// - Multiple producers (requires Exec Forbid/Permit or semaphores)
// - Multiple consumers (same issue)
// - Shared read/write access from same context
//
// Pointer reads/writes are atomic on supported 68020+ targets. Ensure caches
// are properly managed for memory shared between interrupt handlers and tasks.

from std::core import Option, Drop
from std::memory::block import MemoryBlock
from std::ffi::exec import FreeMem, CopyMem, MEMF_PUBLIC, MEMF_CLEAR
from std::error::errors import ExecError

/// RingBuffer<T> - Fixed-size circular buffer
///
/// A lock-free circular buffer with constant memory footprint.
/// No dynamic allocation after initialization - ideal for
/// interrupt handlers and real-time audio/video.
///
/// ## Features
/// - O(1) push_back and pop_front
/// - Fixed capacity set at creation
/// - Safe for single-producer/single-consumer patterns
/// - Properly handles complex structs via CopyMem
///
/// ## Performance Note
/// This variant uses modulo (%) for index wrapping, which requires
/// software division on 68k (~100+ cycles). For best performance,
/// use RingBufferPow2 which uses bitmask operations (~5 cycles).
///
/// ## Example
/// ```novus
/// match RingBuffer::<u8>::with_capacity(256) {
///     Result::Ok(var buffer) => {
///         buffer.push_back(0x42)?
///         buffer.push_back(0x43)?
///         match buffer.pop_front() {
///             Option::Some(val) => { /* val == 0x42 */ },
///             Option::None => { /* empty */ }
///         }
///     },
///     Result::Err(_) => { /* allocation failed */ }
/// }
/// ```
pub struct RingBuffer<T> {
    data: *u8,          // Raw byte storage for CopyMem compatibility
    capacity: u32,
    head: u32,          // Index of first element (read position)
    tail: u32,          // Index of next write position
    len: u32,           // Current number of elements
    element_size: u32,  // Size of T in bytes
}

impl<T> RingBuffer<T> {
    /// Create a new ring buffer with specified capacity
    ///
    /// Returns a typed error if allocation fails.
    /// For best performance, use RingBufferPow2 with a power-of-2 capacity.
    pub fn with_capacity(capacity: u32) -> Result<RingBuffer<T>, ExecError> {
        if capacity == 0u32 {
            return Result::Err(ExecError::InvalidAddress)
        }

        let element_size: u32 = @sizeof(T)
        // Align element size to 4 bytes for 68k efficiency
        let aligned_size: u32 = (element_size + 3u32) & 0xFFFFFFFCu32
        let bytes: u32 = capacity * aligned_size

        let block_opt: Result<MemoryBlock, ExecError> = MemoryBlock::alloc(bytes, MEMF_PUBLIC | MEMF_CLEAR)

        match block_opt {
            Result::Ok(var block) => {
                let data: *u8 = block.ptr()
                block.into_raw()

                return Result::Ok(RingBuffer {
                    data: data,
                    capacity: capacity,
                    head: 0u32,
                    tail: 0u32,
                    len: 0u32,
                    element_size: aligned_size,
                })
            },
            Result::Err(error) => return Result::Err(error),
        }
    }

    /// Create a new ring buffer, returning a Result for detailed error handling
    pub fn try_with_capacity(capacity: u32) -> Result<RingBuffer<T>, ExecError> {
        if capacity == 0u32 {
            return Result::Err(ExecError::InvalidAddress)
        }

        let element_size: u32 = @sizeof(T)
        let aligned_size: u32 = (element_size + 3u32) & 0xFFFFFFFCu32
        let bytes: u32 = capacity * aligned_size

        let block_opt: Result<MemoryBlock, ExecError> = MemoryBlock::alloc(bytes, MEMF_PUBLIC | MEMF_CLEAR)

        match block_opt {
            Result::Ok(var block) => {
                let data: *u8 = block.ptr()
                block.into_raw()

                return Result::Ok(RingBuffer {
                    data: data,
                    capacity: capacity,
                    head: 0u32,
                    tail: 0u32,
                    len: 0u32,
                    element_size: aligned_size,
                })
            },
            Result::Err(_) => {
                return Result::Err(ExecError::NoMem)
            }
        }
    }

    /// Check if the buffer is empty
    pub fn is_empty(&self) -> bool {
        return self.len == 0u32
    }

    /// Check if the buffer is full
    pub fn is_full(&self) -> bool {
        return self.len == self.capacity
    }

    /// Get the current number of elements
    pub fn len(&self) -> u32 {
        return self.len
    }

    /// Get the total capacity
    pub fn capacity(&self) -> u32 {
        return self.capacity
    }

    /// Get available space for new elements
    pub fn available(&self) -> u32 {
        return self.capacity - self.len
    }

    /// Push an element to the back of the buffer
    ///
    /// Returns a capacity error if the buffer is full.
    /// Uses CopyMem for safe struct copying on 68k.
    pub fn push_back(&var self, value: T) -> Result<(), ExecError> {
        if self.len == self.capacity {
            return Result::Err(ExecError::CapacityExceeded)
        }

        // Use CopyMem for safe struct assignment
        let dst: *u8 = self.data + self.tail * self.element_size
        unsafe {
            CopyMem((*u8)(&value), dst, self.element_size)
        }

        self.tail = (self.tail + 1u32) % self.capacity
        self.len = self.len + 1u32
        return Result::Ok(())
    }

    /// Pop an element from the front of the buffer
    ///
    /// Returns Some(value) if buffer has elements, None if empty.
    /// Uses CopyMem for safe struct copying on 68k.
    pub fn pop_front(&var self) -> Option<T> {
        if self.len == 0u32 {
            return Option::None
        }

        // Copy value out from the buffer
        // We return the value directly from the stored location
        let src: *T = (*T)(self.data + self.head * self.element_size)
        let value: T = *src

        self.head = (self.head + 1u32) % self.capacity
        self.len = self.len - 1u32
        return Option::Some(value)
    }

    /// Peek at the front element without removing it
    ///
    /// Returns a reference to the front element, or None if empty.
    pub fn front(&self) -> Option<*T> {
        if self.len == 0u32 {
            return Option::None
        }
        let ptr: *T = (*T)(self.data + self.head * self.element_size)
        return Option::Some(ptr)
    }

    /// Peek at the back element without removing it
    ///
    /// Returns a reference to the most recently added element.
    pub fn back(&self) -> Option<*T> {
        if self.len == 0u32 {
            return Option::None
        }
        // Back is at tail - 1, with wrap-around
        let back_idx: u32 = if self.tail == 0u32 { self.capacity - 1u32 } else { self.tail - 1u32 }
        let ptr: *T = (*T)(self.data + back_idx * self.element_size)
        return Option::Some(ptr)
    }

    /// Clear all elements from the buffer
    ///
    /// Calls Drop on all contained elements if T implements Drop.
    pub fn clear(&var self) {
        // Call Drop on each element
        while self.len > 0u32 {
            let ptr: *T = (*T)(self.data + self.head * self.element_size)
            @drop_in_place(ptr)
            self.head = (self.head + 1u32) % self.capacity
            self.len = self.len - 1u32
        }
        self.head = 0u32
        self.tail = 0u32
    }

    /// Get element at logical index (0 = front)
    ///
    /// Returns None if index is out of bounds.
    pub fn get(&self, index: u32) -> Option<*T> {
        if index >= self.len {
            return Option::None
        }
        let actual_idx: u32 = (self.head + index) % self.capacity
        let ptr: *T = (*T)(self.data + actual_idx * self.element_size)
        return Option::Some(ptr)
    }

    /// Overwrite the front element (for in-place modification)
    ///
    /// Returns false if buffer is empty.
    pub fn set_front(&var self, value: T) -> Result<(), ExecError> {
        if self.len == 0u32 {
            return Result::Err(ExecError::IndexOutOfBounds)
        }
        let dst: *u8 = self.data + self.head * self.element_size
        unsafe {
            CopyMem((*u8)(&value), dst, self.element_size)
        }
        return Result::Ok(())
    }

    /// Skip (discard) n elements from the front
    ///
    /// Returns the number of elements actually skipped.
    /// Calls Drop on each discarded element if T implements Drop.
    pub fn skip(&var self, n: u32) -> u32 {
        let to_skip: u32 = if n > self.len { self.len } else { n }

        // Drop each element being skipped
        var i: u32 = 0u32
        while i < to_skip {
            let ptr: *T = (*T)(self.data + ((self.head + i) % self.capacity) * self.element_size)
            @drop_in_place(ptr)
            i = i + 1u32
        }

        self.head = (self.head + to_skip) % self.capacity
        self.len = self.len - to_skip
        return to_skip
    }
}

impl<T> Drop for RingBuffer<T> {
    fn drop(&var self) {
        if self.data != null {
            // Call Drop on all contained elements
            self.clear()

            let bytes: u32 = self.capacity * self.element_size
            unsafe {
                FreeMem(self.data, bytes)
            }
            self.data = null
            self.capacity = 0u32
        }
    }
}

// ============================================================================
// Power-of-2 optimized variant
// ============================================================================

/// RingBufferPow2<T> - Ring buffer optimized for power-of-2 sizes
///
/// Uses bitwise AND instead of modulo for index wrapping, providing
/// ~20x faster push/pop operations on 68k processors.
///
/// Capacity is automatically rounded up to the next power of 2.
///
/// ## Performance (68020 baseline)
/// - RingBuffer::push_back: ~150 cycles (modulo)
/// - RingBufferPow2::push_back: ~25 cycles (bitmask)
///
/// ## Example
/// ```novus
/// // Request 100 elements, gets 128 (next power of 2)
/// match RingBufferPow2::<Sample>::with_capacity(100) {
///     Option::Some(var buffer) => {
///         // buffer.capacity() == 128
///     },
///     Option::None => { }
/// }
/// ```
pub struct RingBufferPow2<T> {
    data: *u8,          // Raw byte storage for CopyMem compatibility
    capacity: u32,
    mask: u32,          // capacity - 1, for fast modulo
    head: u32,
    tail: u32,
    len: u32,
    element_size: u32,
}

impl<T> RingBufferPow2<T> {
    /// Create a new ring buffer with power-of-2 capacity
    ///
    /// Capacity will be rounded up to the next power of 2.
    /// Returns a typed error if allocation fails.
    pub fn with_capacity(requested: u32) -> Result<RingBufferPow2<T>, ExecError> {
        if requested == 0u32 {
            return Result::Err(ExecError::InvalidAddress)
        }

        // Round up to next power of 2
        let capacity: u32 = RingBufferPow2::<T>::next_power_of_two(requested)

        let element_size: u32 = @sizeof(T)
        // Align element size to 4 bytes for 68k efficiency
        let aligned_size: u32 = (element_size + 3u32) & 0xFFFFFFFCu32
        let bytes: u32 = capacity * aligned_size

        let block_opt: Result<MemoryBlock, ExecError> = MemoryBlock::alloc(bytes, MEMF_PUBLIC | MEMF_CLEAR)

        match block_opt {
            Result::Ok(var block) => {
                let data: *u8 = block.ptr()
                block.into_raw()

                return Result::Ok(RingBufferPow2 {
                    data: data,
                    capacity: capacity,
                    mask: capacity - 1u32,
                    head: 0u32,
                    tail: 0u32,
                    len: 0u32,
                    element_size: aligned_size,
                })
            },
            Result::Err(error) => return Result::Err(error),
        }
    }

    /// Create a new ring buffer, returning a Result for detailed error handling
    pub fn try_with_capacity(requested: u32) -> Result<RingBufferPow2<T>, ExecError> {
        if requested == 0u32 {
            return Result::Err(ExecError::InvalidAddress)
        }

        let capacity: u32 = RingBufferPow2::<T>::next_power_of_two(requested)

        let element_size: u32 = @sizeof(T)
        let aligned_size: u32 = (element_size + 3u32) & 0xFFFFFFFCu32
        let bytes: u32 = capacity * aligned_size

        let block_opt: Result<MemoryBlock, ExecError> = MemoryBlock::alloc(bytes, MEMF_PUBLIC | MEMF_CLEAR)

        match block_opt {
            Result::Ok(var block) => {
                let data: *u8 = block.ptr()
                block.into_raw()

                return Result::Ok(RingBufferPow2 {
                    data: data,
                    capacity: capacity,
                    mask: capacity - 1u32,
                    head: 0u32,
                    tail: 0u32,
                    len: 0u32,
                    element_size: aligned_size,
                })
            },
            Result::Err(_) => {
                return Result::Err(ExecError::NoMem)
            }
        }
    }

    /// Round up to next power of 2
    fn next_power_of_two(n: u32) -> u32 {
        if n == 0u32 {
            return 1u32
        }
        var v: u32 = n - 1u32
        v = v | (v >> 1)
        v = v | (v >> 2)
        v = v | (v >> 4)
        v = v | (v >> 8)
        v = v | (v >> 16)
        return v + 1u32
    }

    /// Check if the buffer is empty
    pub fn is_empty(&self) -> bool {
        return self.len == 0u32
    }

    /// Check if the buffer is full
    pub fn is_full(&self) -> bool {
        return self.len == self.capacity
    }

    /// Get the current number of elements
    pub fn len(&self) -> u32 {
        return self.len
    }

    /// Get the total capacity
    pub fn capacity(&self) -> u32 {
        return self.capacity
    }

    /// Get available space for new elements
    pub fn available(&self) -> u32 {
        return self.capacity - self.len
    }

    /// Push an element to the back (fast path with bitmask)
    pub fn push_back(&var self, value: T) -> Result<(), ExecError> {
        if self.len == self.capacity {
            return Result::Err(ExecError::CapacityExceeded)
        }

        // Use CopyMem for safe struct assignment
        let dst: *u8 = self.data + self.tail * self.element_size
        unsafe {
            CopyMem((*u8)(&value), dst, self.element_size)
        }

        self.tail = (self.tail + 1u32) & self.mask
        self.len = self.len + 1u32
        return Result::Ok(())
    }

    /// Pop an element from the front (fast path with bitmask)
    pub fn pop_front(&var self) -> Option<T> {
        if self.len == 0u32 {
            return Option::None
        }

        // Copy value out from the buffer
        let src: *T = (*T)(self.data + self.head * self.element_size)
        let value: T = *src

        self.head = (self.head + 1u32) & self.mask
        self.len = self.len - 1u32
        return Option::Some(value)
    }

    /// Peek at the front element
    pub fn front(&self) -> Option<*T> {
        if self.len == 0u32 {
            return Option::None
        }
        let ptr: *T = (*T)(self.data + self.head * self.element_size)
        return Option::Some(ptr)
    }

    /// Peek at the back element
    pub fn back(&self) -> Option<*T> {
        if self.len == 0u32 {
            return Option::None
        }
        // When tail==0, underflow wraps to 0xFFFFFFFF, mask produces capacity-1 (correct!)
        let back_idx: u32 = (self.tail - 1u32) & self.mask
        let ptr: *T = (*T)(self.data + back_idx * self.element_size)
        return Option::Some(ptr)
    }

    /// Clear all elements
    ///
    /// Calls Drop on all contained elements if T implements Drop.
    pub fn clear(&var self) {
        // Call Drop on each element
        while self.len > 0u32 {
            let ptr: *T = (*T)(self.data + self.head * self.element_size)
            @drop_in_place(ptr)
            self.head = (self.head + 1u32) & self.mask
            self.len = self.len - 1u32
        }
        self.head = 0u32
        self.tail = 0u32
    }

    /// Get element at logical index
    pub fn get(&self, index: u32) -> Option<*T> {
        if index >= self.len {
            return Option::None
        }
        let actual_idx: u32 = (self.head + index) & self.mask
        let ptr: *T = (*T)(self.data + actual_idx * self.element_size)
        return Option::Some(ptr)
    }

    /// Skip n elements from the front
    ///
    /// Returns the number of elements actually skipped.
    /// Calls Drop on each discarded element if T implements Drop.
    pub fn skip(&var self, n: u32) -> u32 {
        let to_skip: u32 = if n > self.len { self.len } else { n }

        // Drop each element being skipped
        var i: u32 = 0u32
        while i < to_skip {
            let ptr: *T = (*T)(self.data + ((self.head + i) & self.mask) * self.element_size)
            @drop_in_place(ptr)
            i = i + 1u32
        }

        self.head = (self.head + to_skip) & self.mask
        self.len = self.len - to_skip
        return to_skip
    }
}

impl<T> Drop for RingBufferPow2<T> {
    fn drop(&var self) {
        if self.data != null {
            // Call Drop on all contained elements
            self.clear()

            let bytes: u32 = self.capacity * self.element_size
            unsafe {
                FreeMem(self.data, bytes)
            }
            self.data = null
            self.capacity = 0u32
        }
    }
}
