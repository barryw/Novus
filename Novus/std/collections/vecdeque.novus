// Novus Standard Library - VecDeque Module
// Namespace: std::collections
// A double-ended queue implemented with a ring buffer

from std::core import Option, Result, Drop
from std::memory::block import MemoryBlock
from amiga::raw::exec import FreeMem, CopyMem
from amiga::raw::consts import MEMF_PUBLIC, MEMF_CLEAR
from std::memory::errors import MemoryError

// ============================================================================
// VecDeque<T> - Double-ended queue using ring buffer
// ============================================================================

/// VecDeque<T> - Double-ended queue with O(1) push/pop at both ends
///
/// Uses a ring buffer internally for efficient push/pop from both front and back.
/// Much better cache locality than LinkedList while providing similar operations.
///
/// ## Features
/// - O(1) push_front, push_back, pop_front, pop_back
/// - O(1) indexed access (wrapping around the buffer)
/// - Automatic resize when capacity is exceeded
/// - Automatic memory management via Drop trait (RAII)
///
/// ## Memory Layout
/// The ring buffer uses head and len to track the valid region:
/// - head: index of first element
/// - len: number of elements
/// - Elements wrap around: index i maps to (head + i) % capacity
///
/// ## Example
/// ```novus
/// var deque = VecDeque::<Message>::new()?
/// deque.push_back(msg1)
/// deque.push_front(urgent_msg)
///
/// match deque.pop_front() {
///     Some(msg) => process(msg),
///     None => // empty
/// }
/// ```
pub struct VecDeque<T> {
    ptr: *T,
    head: usize,      // Index of first element
    len: usize,       // Number of elements
    capacity: usize,  // Total capacity
}

impl<T> VecDeque<T> {
    /// Create an empty VecDeque with zero capacity
    pub fn new() -> VecDeque<T> {
        return @zeroed(VecDeque<T>)
    }

    /// Create a VecDeque with specified initial capacity
    /// Returns MemoryError::OutOfMemory if memory allocation fails
    pub fn with_capacity(capacity: usize) -> Result<VecDeque<T>, MemoryError> {
        if capacity == 0 {
            return Result::Ok(@zeroed(VecDeque<T>))
        }

        let element_size: u32 = @sizeof(T)
        let bytes_needed: u32 = capacity * element_size

        let block_opt = MemoryBlock::alloc(bytes_needed, MEMF_PUBLIC | MEMF_CLEAR)

        match block_opt {
            Result::Ok(var block) => {
                let raw = block.into_raw()
                let ptr: *T = (*T)raw.ptr()
                return Result::Ok(VecDeque {
                    ptr: ptr,
                    head: 0,
                    len: 0,
                    capacity: capacity,
                })
            },
            Result::Err(error) => return Result::Err(error),
        }
    }

    /// Get the number of elements
    pub fn len(&self) -> usize {
        return self.len
    }

    /// Check if empty
    pub fn is_empty(&self) -> bool {
        return self.len == 0
    }

    /// Get the current capacity
    pub fn capacity(&self) -> usize {
        return self.capacity
    }

    /// Add element to the back (enqueue)
    ///
    /// Returns MemoryError::OutOfMemory if allocation fails during resize.
    pub fn push_back(&var self, consuming value: T) -> Result<(), MemoryError> {
        // Ensure we have capacity
        if self.len >= self.capacity {
            let result: Result<(), MemoryError> = self.grow()
            match result {
                Result::Ok(_) => {},
                Result::Err(err) => return Result::Err(err),
            }
        }

        // Calculate the index for the new element (one past the last)
        let index: usize = self.wrap_index(self.head + self.len)
        unsafe { self.ptr[index] = value }
        self.len = self.len + 1
        return Result::Ok(())
    }

    /// Add element to the front
    ///
    /// Returns MemoryError::OutOfMemory if allocation fails during resize.
    pub fn push_front(&var self, consuming value: T) -> Result<(), MemoryError> {
        // Ensure we have capacity
        if self.len >= self.capacity {
            let result: Result<(), MemoryError> = self.grow()
            match result {
                Result::Ok(_) => {},
                Result::Err(err) => return Result::Err(err),
            }
        }

        // Move head back one position (with wrap-around)
        if self.head == 0 {
            self.head = self.capacity - 1
        } else {
            self.head = self.head - 1
        }

        unsafe { self.ptr[self.head] = value }
        self.len = self.len + 1
        return Result::Ok(())
    }

    /// Remove and return element from the back
    pub fn pop_back(&var self) -> Option<T> {
        if self.len == 0 {
            return Option::None
        }

        // Calculate the index of the last element
        let last_index: usize = self.wrap_index(self.head + self.len - 1)
        let value: T = unsafe { self.ptr[last_index] }
        self.len = self.len - 1

        return Option::Some(value)
    }

    /// Remove and return element from the front (dequeue)
    pub fn pop_front(&var self) -> Option<T> {
        if self.len == 0 {
            return Option::None
        }

        let value: T = unsafe { self.ptr[self.head] }
        self.head = self.wrap_index(self.head + 1)
        self.len = self.len - 1

        return Option::Some(value)
    }

    /// Get reference to front element without removing
    pub fn front(&self) -> Option<&T> {
        if self.len == 0 {
            return Option::None
        }
        return Option::Some(unsafe { &self.ptr[self.head] })
    }

    /// Get reference to back element without removing
    pub fn back(&self) -> Option<&T> {
        if self.len == 0 {
            return Option::None
        }
        let last_index: usize = self.wrap_index(self.head + self.len - 1)
        return Option::Some(unsafe { &self.ptr[last_index] })
    }

    /// Get element at index (0 = front)
    ///
    /// Returns None if index is out of bounds.
    pub fn get(&self, index: usize) -> Option<&T> {
        if index >= self.len {
            return Option::None
        }

        let actual_index: usize = self.wrap_index(self.head + index)
        return Option::Some(unsafe { &self.ptr[actual_index] })
    }

    /// Mutably borrow the element at index (0 = front).
    pub fn get_mut(&var self, index: usize) -> Option<&var T> {
        if index >= self.len {
            return Option::None
        }

        let actual_index: usize = self.wrap_index(self.head + index)
        return Option::Some(unsafe { &var self.ptr[actual_index] })
    }

    /// Set element at index
    ///
    /// Returns MemoryError::IndexOutOfBounds if index is out of bounds.
    pub fn set(&var self, index: usize, consuming value: T) -> Result<(), MemoryError> {
        if index >= self.len {
            return Result::Err(MemoryError::IndexOutOfBounds)
        }

        let actual_index: usize = self.wrap_index(self.head + index)
        unsafe {
            @drop_in_place(&var self.ptr[actual_index])
            self.ptr[actual_index] = value
        }
        return Result::Ok(())
    }

    /// Remove all elements (keeps capacity)
    pub fn clear(&var self) {
        while self.len > 0 {
            self.len = self.len - 1
            let index = self.wrap_index(self.head + self.len)
            unsafe { @drop_in_place(&var self.ptr[index]) }
        }
        self.head = 0
    }

    /// Reserve additional capacity
    ///
    /// Returns MemoryError::OutOfMemory if allocation fails.
    pub fn reserve(&var self, additional: usize) -> Result<(), MemoryError> {
        let needed_capacity: usize = self.len + additional
        if needed_capacity <= self.capacity {
            return Result::Ok(())
        }

        return self.resize_to(needed_capacity)
    }

    /// Rotate elements left by n positions
    ///
    /// The element at the front moves to the back.
    /// rotate_left(1) is equivalent to: let x = pop_front(); push_back(x)
    pub fn rotate_left(&var self, n: usize) {
        if self.len == 0 || n == 0 {
            return
        }

        // Normalize rotation amount
        let rotation: usize = n % self.len
        if rotation == 0 {
            return
        }

        var count: usize = 0
        while count < rotation {
            let value: T = unsafe { self.ptr[self.head] }
            self.head = self.wrap_index(self.head + 1)
            let tail: usize = self.wrap_index(self.head + self.len - 1)
            unsafe { self.ptr[tail] = value }
            count = count + 1
        }
    }

    /// Rotate elements right by n positions
    ///
    /// The element at the back moves to the front.
    /// rotate_right(1) is equivalent to: let x = pop_back(); push_front(x)
    pub fn rotate_right(&var self, n: usize) {
        if self.len == 0 || n == 0 {
            return
        }

        // Normalize rotation amount
        let rotation: usize = n % self.len
        if rotation == 0 {
            return
        }

        var count: usize = 0
        while count < rotation {
            let last: usize = self.wrap_index(self.head + self.len - 1)
            let value: T = unsafe { self.ptr[last] }
            if self.head == 0 {
                self.head = self.capacity - 1
            } else {
                self.head = self.head - 1
            }
            unsafe { self.ptr[self.head] = value }
            count = count + 1
        }
    }

    /// Shrink capacity to fit the current length
    ///
    /// Returns MemoryError::OutOfMemory if reallocation fails.
    pub fn shrink_to_fit(&var self) -> Result<(), MemoryError> {
        if self.len == self.capacity {
            return Result::Ok(())
        }

        if self.len == 0 {
            if self.capacity > 0 {
                let element_size: u32 = @sizeof(T)
                let bytes: u32 = self.capacity * element_size
                let mem: *u8 = (*u8)(self.ptr)
                unsafe {
                    FreeMem(mem, bytes)
                }
                self.ptr = null
                self.capacity = 0
            }
            return Result::Ok(())
        }

        return self.resize_to(self.len)
    }

    // Internal: wrap index around the buffer
    fn wrap_index(&self, index: usize) -> usize {
        if self.capacity == 0 {
            return 0
        }
        return index % self.capacity
    }

    // Internal: grow the buffer (double capacity, min 4)
    fn grow(&var self) -> Result<(), MemoryError> {
        var new_capacity: usize = self.capacity * 2
        if new_capacity < 4 {
            new_capacity = 4
        }
        return self.resize_to(new_capacity)
    }

    // Internal: resize to a specific capacity
    fn resize_to(&var self, new_capacity: usize) -> Result<(), MemoryError> {
        let element_size: u32 = @sizeof(T)
        let new_bytes: u32 = new_capacity * element_size

        let block_opt = MemoryBlock::alloc(new_bytes, MEMF_PUBLIC | MEMF_CLEAR)

        match block_opt {
            Result::Ok(var block) => {
                let raw = block.into_raw()
                let new_ptr: *T = (*T)raw.ptr()

                // Copy elements in order (unwrapping the ring buffer)
                var i: usize = 0
                while i < self.len {
                    let old_index: usize = self.wrap_index(self.head + i)
                    unsafe { new_ptr[i] = self.ptr[old_index] }
                    i = i + 1
                }

                // Free old memory if it exists
                if self.capacity > 0 {
                    let old_bytes: u32 = self.capacity * element_size
                    let old_mem: *u8 = (*u8)(self.ptr)
                    unsafe {
                        FreeMem(old_mem, old_bytes)
                    }
                }

                // Update fields
                self.ptr = new_ptr
                self.head = 0
                self.capacity = new_capacity
                return Result::Ok(())
            },
            Result::Err(error) => return Result::Err(error),
        }
    }
}

// Automatic cleanup for VecDeque (RAII)
impl<T> Drop for VecDeque<T> {
    fn drop(&var self) {
        if self.capacity > 0 {
            self.clear()
            let element_size: u32 = @sizeof(T)
            let bytes: u32 = self.capacity * element_size
            let mem: *u8 = (*u8)(self.ptr)
            unsafe {
                FreeMem(mem, bytes)
            }
            self.ptr = null
            self.head = 0
            self.len = 0
            self.capacity = 0
        }
    }
}
