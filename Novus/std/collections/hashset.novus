// Novus Standard Library - HashSet Module
// Namespace: std::collections
// A hash set implementation backed by HashMap<T, ()>

from std::core import Option, Result, Drop, Hash, Eq
from std::collections::hashmap import HashMap, HashMapIter, KeyValueRef
from std::memory::errors import MemoryError

// ============================================================================
// HashSet<T> - A set of unique values with O(1) operations
// ============================================================================

/// HashSet<T> - A hash set for storing unique values
///
/// Backed by HashMap<T, ()> internally. Provides O(1) insert, remove, contains.
/// Automatically resizes at 70% load factor.
///
/// ## Features
/// - O(1) average insert, remove, contains
/// - Automatic memory management via Drop trait (RAII)
/// - No duplicate values
/// - Set operations: union, intersection, difference
///
/// ## Example
/// ```novus
/// let result = HashSet::<u32>::new()
/// match result {
///     Result::Ok(var set) => {
///         set.insert(1)?
///         set.insert(2)?
///         set.insert(1)?  // Returns Ok(false) - already present
///
///         if set.contains(&1) {
///             // value is in set
///         }
///     },
///     Result::Err(err) => {
///         // Handle allocation error
///     }
/// }
/// ```
pub struct HashSet<T> where T: Hash + Eq {
    map: HashMap<T, ()>,
}

impl<T> HashSet<T> where T: Hash + Eq {
    /// Create a new empty HashSet with default capacity (16)
    /// Returns MemoryError::OutOfMemory if memory allocation fails
    pub fn new() -> Result<HashSet<T>, MemoryError> {
        match HashMap::<T, ()>::new() {
            Result::Ok(map) => return Result::Ok(HashSet { map: map }),
            Result::Err(err) => return Result::Err(err),
        }
    }

    /// Create a HashSet with specified initial capacity
    /// Returns MemoryError::OutOfMemory if memory allocation fails
    pub fn with_capacity(capacity: usize) -> Result<HashSet<T>, MemoryError> {
        match HashMap::<T, ()>::with_capacity(capacity) {
            Result::Ok(map) => return Result::Ok(HashSet { map: map }),
            Result::Err(err) => return Result::Err(err),
        }
    }

    /// Insert a value into the set
    ///
    /// Returns Ok(true) if the value was newly inserted, Ok(false) if already present.
    /// Returns Err(MemoryError) if allocation fails during resize.
    pub fn insert(&var self, consuming value: T) -> Result<bool, MemoryError> {
        // HashMap.insert returns Result<Option<V>, MemoryError>
        // The Option indicates whether a previous value existed
        match self.map.insert(value, ()) {
            Result::Ok(opt) => {
                match opt {
                    Option::Some(_) => {
                        // Key already existed, value was updated
                        return Result::Ok(false)
                    },
                    Option::None => {
                        // New key was inserted
                        return Result::Ok(true)
                    }
                }
            },
            Result::Err(err) => {
                // Allocation failure
                return Result::Err(err)
            }
        }
    }

    /// Remove a value from the set
    ///
    /// Returns true if the value was present, false otherwise.
    pub fn remove(&var self, value: &T) -> bool {
        match self.map.remove(value) {
            Option::Some(_) => return true,
            Option::None => return false,
        }
    }

    /// Check if the set contains a value
    pub fn contains(&self, value: &T) -> bool {
        return self.map.contains_key(value)
    }

    /// Get the number of elements in the set
    pub fn len(&self) -> usize {
        return self.map.len()
    }

    /// Check if the set is empty
    pub fn is_empty(&self) -> bool {
        return self.map.is_empty()
    }

    /// Get the current capacity
    pub fn capacity(&self) -> usize {
        return self.map.capacity()
    }

    /// Remove all elements from the set
    pub fn clear(&var self) {
        self.map.clear()
    }

    /// Check if this set is a subset of another
    ///
    /// Returns true if every element in self is also in other.
    pub fn is_subset(&self, other: &HashSet<T>) -> bool {
        if self.len() > other.len() {
            return false
        }

        var iter = self.map.iter()
        while true {
            match iter.next() {
                Option::Some(kv) => {
                    // kv.key is now *T (pointer), dereference to get value then take reference
                    if !other.contains(unsafe { &*kv.key }) {
                        return false
                    }
                },
                Option::None => {
                    return true
                }
            }
        }

        return true
    }

    /// Check if this set is a superset of another
    ///
    /// Returns true if every element in other is also in self.
    pub fn is_superset(&self, other: &HashSet<T>) -> bool {
        return other.is_subset(self)
    }

    /// Check if this set has any elements in common with another
    pub fn intersects(&self, other: &HashSet<T>) -> bool {
        // Iterate over the smaller set for efficiency
        if self.len() <= other.len() {
            var iter = self.map.iter()
            while true {
                match iter.next() {
                    Option::Some(kv) => {
                        // kv.key is now *T (pointer), dereference to get value then take reference
                        if other.contains(unsafe { &*kv.key }) {
                            return true
                        }
                    },
                    Option::None => {
                        return false
                    }
                }
            }
        } else {
            var iter = other.map.iter()
            while true {
                match iter.next() {
                    Option::Some(kv) => {
                        // kv.key is now *T (pointer), dereference to get value then take reference
                        if self.contains(unsafe { &*kv.key }) {
                            return true
                        }
                    },
                    Option::None => {
                        return false
                    }
                }
            }
        }

        return false
    }

    /// Create an iterator over the set's elements
    pub fn iter(&self) -> HashSetIter<T> {
        return HashSetIter {
            map_iter: self.map.iter(),
        }
    }
}

// Automatic cleanup for HashSet (RAII)
impl<T> Drop for HashSet<T> where T: Hash + Eq {
    fn drop(&var self) {
        self.map.drop()
    }
}

// ============================================================================
// HashSetIter - Iterator for HashSet
// ============================================================================

/// Iterator over HashSet elements
pub struct HashSetIter<T> {
    map_iter: HashMapIter<T, ()>,
}

impl<T> HashSetIter<T> {
    /// Get the next element as a reference
    ///
    /// Returns Some(&value) if there are more elements, None when done.
    /// The reference is valid as long as the HashSet is not modified.
    pub fn next(&var self) -> Option<&T> {
        match self.map_iter.next() {
            Option::Some(kv) => return Option::Some(kv.key),
            Option::None => return Option::None,
        }
    }
}
