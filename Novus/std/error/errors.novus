// Novus Error Taxonomy
// Comprehensive error handling across Amiga subsystems
// Namespace: std::error
//
// Design Philosophy:
// - Each subsystem has its own error type (DosError, ExecError, etc.)
// - Top-level NovusError enum wraps all subsystem errors
// - From<T> conversions allow ergonomic ? operator across subsystems
// - Raw error codes preserved for debugging

from std::core import From, Option, Result, Error
from std::ffi::dos import IoErr

// ============================================================================
// DOS Library Errors
// ============================================================================

/// DOS library error type
///
/// Maps common IoErr() codes from dos.library to semantic error variants.
/// Call `dos_last_error()` or `IoErr()` to get the raw error code after a failed operation.
///
/// # Example
///
/// ```novus
/// match Open("file.txt", MODE_OLDFILE) {
///     Result::Ok(fh) => { ... },
///     Result::Err(e) => {
///         match e {
///             DosError::NotFound => println("File not found"),
///             DosError::PermissionDenied => println("Access denied"),
///             _ => println("Unknown error"),
///         }
///     }
/// }
/// ```
pub enum DosError {
    /// File or directory not found (ERROR_OBJECT_NOT_FOUND, code 205)
    NotFound,
    /// Object already exists (ERROR_OBJECT_EXISTS, code 203)
    AlreadyExists,
    /// Directory not found (ERROR_DIR_NOT_FOUND, code 204)
    DirNotFound,
    /// Directory is not empty (ERROR_DIRECTORY_NOT_EMPTY, code 216)
    DirectoryNotEmpty,

    /// Generic permission denied error
    PermissionDenied,
    /// File is write protected (ERROR_WRITE_PROTECTED, code 223)
    WriteProtected,
    /// File is read protected (ERROR_READ_PROTECTED, code 224)
    ReadProtected,
    /// File is delete protected (ERROR_DELETE_PROTECTED, code 222)
    DeleteProtected,

    /// Disk is full (ERROR_DISK_FULL, code 221)
    DiskFull,
    /// Disk not validated (ERROR_DISK_NOT_VALIDATED, code 213)
    DiskNotValidated,
    /// Disk is write protected (ERROR_DISK_WRITE_PROTECTED, code 214)
    DiskWriteProtected,
    /// No disk in drive (ERROR_NO_DISK, code 226)
    NoDisk,
    /// Disk is not a DOS disk (ERROR_NOT_A_DOS_DISK, code 225)
    NotADosDisk,
    /// Device not mounted (ERROR_DEVICE_NOT_MOUNTED, code 218)
    DeviceNotMounted,

    /// Seek error during I/O (ERROR_SEEK_ERROR, code 219)
    SeekError,
    /// Buffer overflow (ERROR_BUFFER_OVERFLOW, code 303)
    BufferOverflow,
    /// Invalid stream name (ERROR_BAD_STREAM_NAME, code 206)
    BadStreamName,

    /// Out of memory (ERROR_NO_FREE_STORE, code 103)
    NoFreeStore,
    /// Object is in use (ERROR_OBJECT_IN_USE, code 202)
    ObjectInUse,
    /// Object is too large (ERROR_OBJECT_TOO_LARGE, code 207)
    ObjectTooLarge,
    /// Too many directory levels (ERROR_TOO_MANY_LEVELS, code 217)
    TooManyLevels,

    /// Invalid lock (ERROR_INVALID_LOCK, code 211)
    InvalidLock,
    /// Record was not locked (ERROR_RECORD_NOT_LOCKED, code 240)
    RecordNotLocked,
    /// Lock collision occurred (ERROR_LOCK_COLLISION, code 241)
    LockCollision,
    /// Lock timed out (ERROR_LOCK_TIMEOUT, code 242)
    LockTimeout,

    /// Feature not implemented (ERROR_NOT_IMPLEMENTED, code 236)
    NotImplemented,
    /// Bad number format (ERROR_BAD_NUMBER, code 115)
    BadNumber,
    /// Generic invalid input error
    InvalidInput,
    /// Unknown error code - check IoErr() for raw value
    Unknown,
}

// Get the current DOS error from IoErr()
pub fn dos_last_error() -> DosError {
    let code = IoErr()
    return dos_error_from_code(code)
}

// Convert raw IoErr code to DosError enum
pub fn dos_error_from_code(code: i32) -> DosError {
    // Map common DOS error codes to enum variants (sorted by code for readability)
    return match code {
        103 => DosError::NoFreeStore,
        115 => DosError::BadNumber,
        202 => DosError::ObjectInUse,
        203 => DosError::AlreadyExists,
        204 => DosError::DirNotFound,
        205 => DosError::NotFound,
        206 => DosError::BadStreamName,
        207 => DosError::ObjectTooLarge,
        211 => DosError::InvalidLock,
        213 => DosError::DiskNotValidated,
        214 => DosError::DiskWriteProtected,
        216 => DosError::DirectoryNotEmpty,
        217 => DosError::TooManyLevels,
        218 => DosError::DeviceNotMounted,
        219 => DosError::SeekError,
        221 => DosError::DiskFull,
        222 => DosError::DeleteProtected,
        223 => DosError::WriteProtected,
        224 => DosError::ReadProtected,
        225 => DosError::NotADosDisk,
        226 => DosError::NoDisk,
        236 => DosError::NotImplemented,
        240 => DosError::RecordNotLocked,
        241 => DosError::LockCollision,
        242 => DosError::LockTimeout,
        303 => DosError::BufferOverflow,
        _   => DosError::Unknown  // Unknown error code
    }
}

// Convert DosError back to error code (for debugging/logging)
pub fn dos_error_to_code(err: DosError) -> i32 {
    return match err {
        DosError::NotFound => 205,
        DosError::AlreadyExists => 203,
        DosError::DirNotFound => 204,
        DosError::DirectoryNotEmpty => 216,
        DosError::PermissionDenied => -1,  // Generic
        DosError::WriteProtected => 223,
        DosError::ReadProtected => 224,
        DosError::DeleteProtected => 222,
        DosError::DiskFull => 221,
        DosError::DiskNotValidated => 213,
        DosError::DiskWriteProtected => 214,
        DosError::NoDisk => 226,
        DosError::NotADosDisk => 225,
        DosError::DeviceNotMounted => 218,
        DosError::SeekError => 219,
        DosError::BufferOverflow => 303,
        DosError::BadStreamName => 206,
        DosError::NoFreeStore => 103,
        DosError::ObjectInUse => 202,
        DosError::ObjectTooLarge => 207,
        DosError::TooManyLevels => 217,
        DosError::InvalidLock => 211,
        DosError::RecordNotLocked => 240,
        DosError::LockCollision => 241,
        DosError::LockTimeout => 242,
        DosError::NotImplemented => 236,
        DosError::BadNumber => 115,
        DosError::InvalidInput => -2,  // Generic
        DosError::Unknown => -999,  // Unmapped error
    }
}

// ============================================================================
// Exec Library Errors
// ============================================================================

/// Exec library error type
///
/// Errors related to memory allocation, tasks, signals, and other Exec services.
pub enum ExecError {
    /// Memory allocation failed (AllocMem returned NULL)
    NoMem,
    /// Invalid signal number
    BadSignal,
    /// Function returned NULL unexpectedly
    NullReturn,
    /// Invalid task pointer
    BadTask,
    /// Invalid list node
    BadNode,
    /// Invalid message port
    BadPort,
    /// Signal bit already allocated
    SignalInUse,
    /// FindTask lookup failed
    TaskNotFound,
    /// OpenLibrary failed
    LibraryNotFound,
    /// Invalid memory address
    InvalidAddress,
    /// Memory alignment violation
    AlignmentError,
}

/// Convert ExecError to a numeric error code
///
/// Returns a negative error code in the range -100 to -199 for Exec errors.
/// Useful for returning error codes to AmigaOS or for logging.
pub fn exec_error_to_code(err: ExecError) -> i32 {
    match err {
        ExecError::NoMem => return -100,
        ExecError::BadSignal => return -101,
        ExecError::NullReturn => return -102,
        ExecError::BadTask => return -103,
        ExecError::BadNode => return -104,
        ExecError::BadPort => return -105,
        ExecError::SignalInUse => return -106,
        ExecError::TaskNotFound => return -107,
        ExecError::LibraryNotFound => return -108,
        ExecError::InvalidAddress => return -109,
        ExecError::AlignmentError => return -110,
    }
}

// ============================================================================
// Intuition Library Errors
// ============================================================================

/// Intuition library error type
///
/// Errors related to windows, screens, gadgets, menus, and other Intuition services.
pub enum IntuitionError {
    /// OpenWindow failed
    WindowOpenFailed,
    /// OpenScreen failed
    ScreenOpenFailed,
    /// Gadget creation failed
    GadgetCreateFailed,
    /// Menu creation failed
    MenuCreateFailed,
    /// Invalid window pointer
    InvalidWindow,
    /// Invalid screen pointer
    InvalidScreen,
    /// IDCMP setup failed
    NoIDCMP,
    /// Invalid display mode ID
    BadDisplayMode,
    /// ModifyIDCMP failed (usually out of memory)
    ModifyIDCMPFailed,
    /// Failed to open required library (e.g., GadTools)
    LibraryOpenFailed,
}

/// Convert IntuitionError to a numeric error code
///
/// Returns a negative error code in the range -200 to -299 for Intuition errors.
/// Useful for returning error codes to AmigaOS or for logging.
pub fn intuition_error_to_code(err: IntuitionError) -> i32 {
    match err {
        IntuitionError::WindowOpenFailed => return -200,
        IntuitionError::ScreenOpenFailed => return -201,
        IntuitionError::GadgetCreateFailed => return -202,
        IntuitionError::MenuCreateFailed => return -203,
        IntuitionError::InvalidWindow => return -204,
        IntuitionError::InvalidScreen => return -205,
        IntuitionError::NoIDCMP => return -206,
        IntuitionError::BadDisplayMode => return -207,
        IntuitionError::ModifyIDCMPFailed => return -208,
        IntuitionError::LibraryOpenFailed => return -209,
    }
}

// ============================================================================
// Graphics Library Errors
// ============================================================================

/// Graphics library error type
///
/// Errors related to bitmaps, rastports, fonts, sprites, and other graphics operations.
pub enum GraphicsError {
    /// BitMap allocation failed
    BitMapAllocFailed,
    /// RastPort initialization failed
    RastPortInitFailed,
    /// OpenFont failed
    FontOpenFailed,
    /// Invalid BitMap pointer
    InvalidBitMap,
    /// Invalid RastPort pointer
    InvalidRastPort,
    /// Invalid display mode
    BadDisplayMode,
    /// Copper list setup failed
    CopperListFailed,
    /// Invalid sprite data format
    InvalidSpriteData,
    /// Invalid sprite channel (must be 0-7)
    InvalidSpriteChannel,
    /// Invalid attached sprite channel (must be even 0-6)
    InvalidAttachedSpriteChannel,
    /// Sprite handle not allocated
    SpriteNotAllocated,
    /// Sprite channel already in use
    SpriteChannelInUse,
    /// Wrong number of colors for sprite type
    InvalidColorCount,
    /// All sprites in use by OS
    NoSpritesAvailable,
    /// NULL or invalid ViewPort pointer
    InvalidViewPort,
}

/// Convert GraphicsError to a numeric error code
///
/// Returns a negative error code in the range -300 to -399 for Graphics errors.
/// Useful for returning error codes to AmigaOS or for logging.
pub fn graphics_error_to_code(err: GraphicsError) -> i32 {
    match err {
        GraphicsError::BitMapAllocFailed => return -300,
        GraphicsError::RastPortInitFailed => return -301,
        GraphicsError::FontOpenFailed => return -302,
        GraphicsError::InvalidBitMap => return -303,
        GraphicsError::InvalidRastPort => return -304,
        GraphicsError::BadDisplayMode => return -305,
        GraphicsError::CopperListFailed => return -306,
        GraphicsError::InvalidSpriteData => return -307,
        GraphicsError::InvalidSpriteChannel => return -308,
        GraphicsError::InvalidAttachedSpriteChannel => return -309,
        GraphicsError::SpriteNotAllocated => return -310,
        GraphicsError::SpriteChannelInUse => return -311,
        GraphicsError::InvalidColorCount => return -312,
        GraphicsError::NoSpritesAvailable => return -313,
        GraphicsError::InvalidViewPort => return -314,
    }
}

// ============================================================================
// Top-Level Novus Error (Wraps All Subsystems)
// ============================================================================

/// Top-level Novus error type
///
/// Wraps errors from all Amiga subsystems into a single type.
/// Use this when functions may fail with errors from multiple
/// subsystems (e.g., a GUI app that does file I/O).
///
/// # Example
///
/// ```novus
/// fn load_and_display(path: *u8) -> Result<(), NovusError> {
///     let data = read_file(path)?  // DosError -> NovusError
///     let window = open_window()?  // IntuitionError -> NovusError
///     draw_data(window, data)?     // GraphicsError -> NovusError
///     Result::Ok(())
/// }
/// ```
pub enum NovusError {
    /// DOS library error (file I/O, filesystem)
    Dos(DosError),
    /// Exec library error (memory, tasks, signals)
    Exec(ExecError),
    /// Intuition library error (windows, screens, gadgets)
    Intuition(IntuitionError),
    /// Graphics library error (bitmaps, fonts, sprites)
    Graphics(GraphicsError),
}

// ============================================================================
// From<T> Trait Implementations - Automatic Error Conversion
// ============================================================================

// These implementations enable the ? operator to automatically convert
// subsystem errors to NovusError when propagating errors up the call stack

// From<DosError> for NovusError
impl From<DosError> for NovusError {
    fn convert(err: DosError) -> NovusError {
        return NovusError::Dos(err)
    }
}

// From<ExecError> for NovusError
impl From<ExecError> for NovusError {
    fn convert(err: ExecError) -> NovusError {
        return NovusError::Exec(err)
    }
}

// From<IntuitionError> for NovusError
impl From<IntuitionError> for NovusError {
    fn convert(err: IntuitionError) -> NovusError {
        return NovusError::Intuition(err)
    }
}

// From<GraphicsError> for NovusError
impl From<GraphicsError> for NovusError {
    fn convert(err: GraphicsError) -> NovusError {
        return NovusError::Graphics(err)
    }
}

// ============================================================================
// Manual Conversion Functions
// ============================================================================

// Note: These functions are currently necessary because the compiler doesn't
// yet support automatic From<T> trait conversion in Result::Err contexts.
// Once the compiler implements this feature, these can be replaced with direct
// error construction: Result::Err(DosError::NotFound) will automatically
// convert to Result::Err(NovusError::Dos(DosError::NotFound))

// From<DosError> for NovusError
pub fn novus_error_from_dos(err: DosError) -> NovusError {
    return NovusError::Dos(err)
}

// From<ExecError> for NovusError
pub fn novus_error_from_exec(err: ExecError) -> NovusError {
    return NovusError::Exec(err)
}

// From<IntuitionError> for NovusError
pub fn novus_error_from_intuition(err: IntuitionError) -> NovusError {
    return NovusError::Intuition(err)
}

// From<GraphicsError> for NovusError
pub fn novus_error_from_graphics(err: GraphicsError) -> NovusError {
    return NovusError::Graphics(err)
}

// Convert NovusError to generic error code (for debugging/FFI)
pub fn novus_error_to_code(err: NovusError) -> i32 {
    match err {
        NovusError::Dos(dos_err) => { return dos_error_to_code(dos_err) },
        NovusError::Exec(exec_err) => { return exec_error_to_code(exec_err) },
        NovusError::Intuition(intui_err) => { return intuition_error_to_code(intui_err) },
        NovusError::Graphics(gfx_err) => { return graphics_error_to_code(gfx_err) },
    }
}

// ============================================================================
// Error Message Methods
// ============================================================================

// Get human-readable message for DosError
impl DosError {
    pub fn message(&self) -> *u8 {
        match *self {
            DosError::NotFound => return "Object not found",
            DosError::AlreadyExists => return "Object already exists",
            DosError::DirNotFound => return "Directory not found",
            DosError::DirectoryNotEmpty => return "Directory not empty",
            DosError::PermissionDenied => return "Permission denied",
            DosError::WriteProtected => return "Write protected",
            DosError::ReadProtected => return "Read protected",
            DosError::DeleteProtected => return "Delete protected",
            DosError::DiskFull => return "Disk full",
            DosError::DiskNotValidated => return "Disk not validated",
            DosError::DiskWriteProtected => return "Disk write protected",
            DosError::NoDisk => return "No disk in drive",
            DosError::NotADosDisk => return "Not a DOS disk",
            DosError::DeviceNotMounted => return "Device not mounted",
            DosError::SeekError => return "Seek error",
            DosError::BufferOverflow => return "Buffer overflow",
            DosError::BadStreamName => return "Bad stream name",
            DosError::NoFreeStore => return "Out of memory",
            DosError::ObjectInUse => return "Object in use",
            DosError::ObjectTooLarge => return "Object too large",
            DosError::TooManyLevels => return "Too many directory levels",
            DosError::InvalidLock => return "Invalid lock",
            DosError::RecordNotLocked => return "Record not locked",
            DosError::LockCollision => return "Lock collision",
            DosError::LockTimeout => return "Lock timeout",
            DosError::NotImplemented => return "Not implemented",
            DosError::BadNumber => return "Bad number",
            DosError::InvalidInput => return "Invalid input",
            DosError::Unknown => return "Unknown error",
        }
    }
}

// Get human-readable message for ExecError
impl ExecError {
    pub fn message(&self) -> *u8 {
        match *self {
            ExecError::NoMem => return "Memory allocation failed",
            ExecError::BadSignal => return "Invalid signal number",
            ExecError::NullReturn => return "Unexpected null return",
            ExecError::BadTask => return "Invalid task pointer",
            ExecError::BadNode => return "Invalid list node",
            ExecError::BadPort => return "Invalid message port",
            ExecError::SignalInUse => return "Signal already allocated",
            ExecError::TaskNotFound => return "Task not found",
            ExecError::LibraryNotFound => return "Library not found",
            ExecError::InvalidAddress => return "Invalid memory address",
            ExecError::AlignmentError => return "Memory alignment error",
        }
    }
}

// Get human-readable message for IntuitionError
impl IntuitionError {
    pub fn message(&self) -> *u8 {
        match *self {
            IntuitionError::WindowOpenFailed => return "Failed to open window",
            IntuitionError::ScreenOpenFailed => return "Failed to open screen",
            IntuitionError::GadgetCreateFailed => return "Failed to create gadget",
            IntuitionError::MenuCreateFailed => return "Failed to create menu",
            IntuitionError::InvalidWindow => return "Invalid window pointer",
            IntuitionError::InvalidScreen => return "Invalid screen pointer",
            IntuitionError::NoIDCMP => return "IDCMP setup failed",
            IntuitionError::BadDisplayMode => return "Invalid display mode",
            IntuitionError::ModifyIDCMPFailed => return "Failed to modify IDCMP",
            IntuitionError::LibraryOpenFailed => return "Failed to open library",
        }
    }
}

// Get human-readable message for GraphicsError
impl GraphicsError {
    pub fn message(&self) -> *u8 {
        match *self {
            GraphicsError::BitMapAllocFailed => return "BitMap allocation failed",
            GraphicsError::RastPortInitFailed => return "RastPort init failed",
            GraphicsError::FontOpenFailed => return "Failed to open font",
            GraphicsError::InvalidBitMap => return "Invalid BitMap pointer",
            GraphicsError::InvalidRastPort => return "Invalid RastPort pointer",
            GraphicsError::BadDisplayMode => return "Invalid display mode",
            GraphicsError::CopperListFailed => return "Copper list setup failed",
            GraphicsError::InvalidSpriteData => return "Invalid sprite data format",
            GraphicsError::InvalidSpriteChannel => return "Invalid sprite channel (must be 0-7)",
            GraphicsError::InvalidAttachedSpriteChannel => return "Invalid attached sprite channel (must be even 0-6)",
            GraphicsError::SpriteNotAllocated => return "Sprite handle not allocated",
            GraphicsError::SpriteChannelInUse => return "Sprite channel already allocated",
            GraphicsError::InvalidColorCount => return "Wrong number of colors for sprite type",
            GraphicsError::NoSpritesAvailable => return "No sprites available (all in use)",
            GraphicsError::InvalidViewPort => return "Invalid ViewPort pointer",
        }
    }
}

// Get human-readable message for NovusError
impl NovusError {
    pub fn message(&self) -> *u8 {
        match *self {
            NovusError::Dos(err) => return err.message(),
            NovusError::Exec(err) => return err.message(),
            NovusError::Intuition(err) => return err.message(),
            NovusError::Graphics(err) => return err.message(),
        }
    }
}

// ============================================================================
// Error Trait Implementations
// ============================================================================

impl Error for DosError {
    fn message(&self) -> *u8 {
        return DosError::message(self)
    }
}

impl Error for ExecError {
    fn message(&self) -> *u8 {
        return ExecError::message(self)
    }
}

impl Error for IntuitionError {
    fn message(&self) -> *u8 {
        return IntuitionError::message(self)
    }
}

impl Error for GraphicsError {
    fn message(&self) -> *u8 {
        return GraphicsError::message(self)
    }
}

impl Error for NovusError {
    fn message(&self) -> *u8 {
        return NovusError::message(self)
    }
}

