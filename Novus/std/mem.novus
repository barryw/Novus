// Novus Standard Library - Safe Memory Management
// Namespace: std::mem
// Unified memory management API with automatic size tracking

from std::core import Option, Result, From, Drop
from std::error import ExecError
from std::ffi::exec import AllocMem, FreeMem, CopyMem
from std::ffi::amiga_consts import MEMF_PUBLIC, MEMF_CHIP, MEMF_FAST, MEMF_CLEAR, MEMF_ANY

/// MemoryBlock - Raw memory allocation with automatic size tracking
///
/// This is the fundamental building block for all memory operations.
/// Contains both pointer and size, eliminating manual size tracking bugs.
///
/// Use this for:
/// - Low-level memory operations
/// - Building higher-level abstractions
/// - FFI buffers where you need raw bytes
///
/// For type-safe allocations, prefer Allocation<T> or Box<T>.
///
/// Example:
/// ```novus
/// let block = MemoryBlock::alloc(1024, MEMF_FAST)
/// match block {
///     Some(mut b) => {
///         defer {
///             b.free()
///         }
///         // Use b.ptr() and b.size()
///         let ptr: *u8 = b.ptr()
///         ptr[0] = 42
///     },
///     None => {
///         // Allocation failed
///     }
/// }
/// ```
pub struct MemoryBlock {
    ptr: *u8,
    size: u32,
}

impl MemoryBlock {
    /// Allocate raw memory of specified size
    /// Returns None if allocation fails
    ///
    /// Example:
    /// ```novus
    /// let mem = MemoryBlock::alloc(1024, MEMF_FAST)
    /// match mem {
    ///     Some(mut block) => {
    ///         defer {
    ///             block.free()
    ///         }
    ///         // Use block
    ///     },
    ///     None => { /* failed */ }
    /// }
    /// ```
    pub fn alloc(size: u32, flags: u32) -> Option<MemoryBlock> {
        if size == 0 {
            // Zero-size allocation returns valid empty block
            return Option::Some(MemoryBlock { ptr: (*u8)0, size: 0 })
        }

        var ptr: *u8 = (*u8)0
        unsafe {
            ptr = AllocMem(size, flags)
        }

        // Check if allocation failed (returns null pointer)
        if (u32)ptr == 0 {
            return Option::None
        }

        return Option::Some(MemoryBlock { ptr: ptr, size: size })
    }

    /// Allocate and return Result with typed error
    ///
    /// Example:
    /// ```novus
    /// var block = MemoryBlock::try_alloc(1024, MEMF_FAST)?
    /// defer {
    ///     block.free()
    /// }
    /// ```
    pub fn try_alloc(size: u32, flags: u32) -> Result<MemoryBlock, ExecError> {
        match MemoryBlock::alloc(size, flags) {
            Some(block) => return Result::Ok(block),
            None => return Result::Err(ExecError::NoMem)
        }
    }

    /// Get pointer to allocated memory
    pub fn ptr(&self) -> *u8 {
        return self.ptr
    }

    /// Get size of allocated memory in bytes
    pub fn size(&self) -> u32 {
        return self.size
    }

    /// Check if this is an empty (zero-size) block
    pub fn is_empty(&self) -> bool {
        return self.size == 0
    }

    /// Free the memory block
    /// After calling free(), the block becomes invalid
    ///
    /// NOTE: No size parameter needed! Size is tracked automatically.
    pub fn free(&mut self) {
        if self.size > 0 {
            unsafe { FreeMem(self.ptr, self.size) }
            self.ptr = (*u8)0
            self.size = 0
        }
    }

    /// Resize the memory block (realloc equivalent)
    /// Returns true on success, false if reallocation fails
    /// On failure, original block is unchanged
    pub fn resize(&mut self, new_size: u32, flags: u32) -> bool {
        if new_size == self.size {
            return true
        }

        let new_block_opt = MemoryBlock::alloc(new_size, flags)
        match new_block_opt {
            Some(new_block) => {
                // Copy old data to new block
                var copy_size: u32 = self.size
                if new_size < self.size {
                    copy_size = new_size
                }

                if copy_size > 0 {
                    unsafe { CopyMem(self.ptr, new_block.ptr(), copy_size) }
                }

                // Free old block
                self.free()

                // Update to new block
                self.ptr = new_block.ptr()
                self.size = new_block.size()

                return true
            },
            None => {
                return false
            }
        }
    }
}

// Automatic cleanup for MemoryBlock (RAII)
impl Drop for MemoryBlock {
    fn drop(&mut self) {
        self.free()
    }
}

/// Allocation<T> - Type-safe bulk memory allocation
///
/// Safer alternative to MemoryBlock with compile-time type checking.
/// Automatically tracks element count and total size.
///
/// Use this for:
/// - Arrays/buffers of typed elements
/// - Manual memory pools
/// - Collections implementation (Vec, HashMap internals)
///
/// Example:
/// ```novus
/// let buffer = Allocation::new(1024, MEMF_CHIP)
/// match buffer {
///     Some(mut alloc) => {
///         defer {
///             alloc.free()
///         }
///
///         let ptr: *u8 = alloc.as_mut_ptr()
///         ptr[0] = 42
///     },
///     None => { /* failed */ }
/// }
/// ```
pub struct Allocation<T> {
    block: MemoryBlock,
    count: u32,
}

impl<T> Allocation<T> {
    /// Allocate memory for `count` elements of type T
    /// Returns None if allocation fails
    pub fn new(count: u32, flags: u32) -> Option<Allocation<T>> {
        if count == 0 {
            return Option::Some(Allocation {
                block: MemoryBlock { ptr: (*u8)0, size: 0 },
                count: 0,
            })
        }

        let element_size: u32 = @sizeof(T)

        // Check for overflow: count * element_size
        if element_size > ($FFFFFFFFu32 / count) {
            return Option::None  // Would overflow
        }

        let total_bytes: u32 = count * element_size

        match MemoryBlock::alloc(total_bytes, flags) {
            Some(block) => {
                return Option::Some(Allocation {
                    block: block,
                    count: count,
                })
            },
            None => return Option::None
        }
    }

    /// Allocate and return Result with typed error
    pub fn try_new(count: u32, flags: u32) -> Result<Allocation<T>, ExecError> {
        if count == 0 {
            let empty_alloc = Allocation {
                block: MemoryBlock { ptr: (*u8)0, size: 0 },
                count: 0,
            }
            return Result::Ok(empty_alloc)
        }

        let element_size: u32 = @sizeof(T)

        // Check for overflow: count * element_size
        if element_size > ($FFFFFFFFu32 / count) {
            return Result::Err(ExecError::NoMem)  // Treat overflow as allocation failure
        }

        let total_bytes: u32 = count * element_size

        match MemoryBlock::alloc(total_bytes, flags) {
            Some(block) => {
                let alloc = Allocation {
                    block: block,
                    count: count,
                }
                return Result::Ok(alloc)
            },
            None => return Result::Err(ExecError::NoMem)
        }
    }

    /// Get number of elements
    pub fn count(&self) -> u32 {
        return self.count
    }

    /// Get total size in bytes
    pub fn size_bytes(&self) -> u32 {
        return self.block.size()
    }

    /// Get immutable pointer
    pub fn as_ptr(&self) -> *T {
        return (*T)self.block.ptr()
    }

    /// Get mutable pointer
    pub fn as_mut_ptr(&mut self) -> *T {
        return (*T)self.block.ptr()
    }

    /// Check if empty
    pub fn is_empty(&self) -> bool {
        return self.count == 0
    }

    /// Free the allocation
    /// NOTE: No size parameter needed!
    pub fn free(&mut self) {
        self.block.free()
        self.count = 0
    }

    /// Resize allocation to new element count
    pub fn resize(&mut self, new_count: u32, flags: u32) -> bool {
        let element_size: u32 = @sizeof(T)

        // Check for overflow: new_count * element_size
        if new_count > 0 && element_size > ($FFFFFFFFu32 / new_count) {
            return false  // Would overflow
        }

        let new_bytes: u32 = new_count * element_size

        if self.block.resize(new_bytes, flags) {
            self.count = new_count
            return true
        }
        return false
    }
}

/// Box<T> - Single heap-allocated value
///
/// Simplest way to allocate a single value on the heap.
/// Size is completely automatic.
///
/// Use this for:
/// - Large structs that don't fit on stack
/// - Recursive data structures
/// - Heap-allocated values
///
/// Example:
/// ```novus
/// struct BigData {
///     buffer: [u8; 4096],
/// }
///
/// let boxed = Box::new(BigData { buffer: [0; 4096] })
/// match boxed {
///     Some(mut b) => {
///         defer {
///             b.free()
///         }
///
///         let val: *BigData = b.get_mut()
///         val.buffer[0] = 42
///     },
///     None => { /* failed */ }
/// }
/// ```
pub struct Box<T> {
    alloc: Allocation<T>,
}

impl<T> Box<T> {
    /// Allocate and initialize a Box with the given value
    /// Uses MEMF_PUBLIC by default
    pub fn new(value: T) -> Option<Box<T>> {
        return Box::new_in(value, MEMF_PUBLIC)
    }

    /// Allocate with specific memory flags
    pub fn new_in(value: T, flags: u32) -> Option<Box<T>> {
        let element_size: u32 = @sizeof(T)
        let total_bytes: u32 = element_size

        match MemoryBlock::alloc(total_bytes, flags) {
            Some(block) => {
                var alloc = Allocation {
                    block: block,
                    count: 1,
                }
                let ptr: *T = alloc.as_mut_ptr()
                *ptr = value
                return Option::Some(Box { alloc: alloc })
            },
            None => return Option::None
        }
    }

    /// Try allocate with Result
    pub fn try_new(value: T) -> Result<Box<T>, ExecError> {
        return Box::try_new_in(value, MEMF_PUBLIC)
    }

    /// Try allocate with specific flags
    pub fn try_new_in(value: T, flags: u32) -> Result<Box<T>, ExecError> {
        match Box::new_in(value, flags) {
            Some(box) => return Result::Ok(box),
            None => return Result::Err(ExecError::NoMem)
        }
    }

    /// Get immutable reference
    pub fn get(&self) -> *T {
        return self.alloc.as_ptr()
    }

    /// Get mutable reference
    pub fn get_mut(&mut self) -> *T {
        return self.alloc.as_mut_ptr()
    }

    /// Free the box
    /// NOTE: No size parameter needed!
    pub fn free(&mut self) {
        self.alloc.free()
    }
}

