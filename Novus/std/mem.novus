// Novus Standard Library - Safe Memory Management
// Namespace: std::mem
// RAII-style memory abstractions for safe heap allocation

from std::core import CoreAlloc, CoreFree, MemoryBlock, Option
from std::ffi::exec import MEMF_PUBLIC, MEMF_CHIP, MEMF_FAST, MEMF_CLEAR

/// Allocation<T> - Type-safe bulk memory allocation
///
/// This is a safer alternative to raw AllocMem/FreeMem:
/// - Remembers the size automatically (can't pass wrong size to free)
/// - Type-safe (can't mix T* with U*)
/// - Prevents double-free (drop() invalidates the handle)
/// - Explicit lifetime management
///
/// Use this for:
/// - Arrays/buffers of T
/// - Manual memory pools
/// - FFI buffers
///
/// Example:
/// ```
/// let alloc = Allocation::new(100u32, MEMF_FAST)  // 100 i32s
/// match alloc {
///     Some(mut a) => {
///         // Use a.as_mut_ptr() to access memory
///         let ptr = a.as_mut_ptr()
///         ptr[0] = 42
///
///         // Explicit cleanup
///         a.drop()
///     },
///     None => { /* allocation failed */ }
/// }
/// ```
pub struct Allocation<T> {
    ptr: *T,
    count: u32,      // Number of T elements
    flags: u32,      // MEMF_* flags used for allocation
}

impl<T> Allocation<T> {
    /// Allocate memory for `count` elements of type T
    /// Returns None if allocation fails
    pub fn new(count: u32, flags: u32) -> Option<Allocation<T>> {
        if count == 0u32 {
            // Zero-size allocation - return valid but empty allocation
            return Option::Some(Allocation {
                ptr: (*T)0,
                count: 0u32,
                flags: flags,
            })
        }

        let element_size: u32 = @sizeof(T)
        let bytes_needed: u32 = count * element_size

        // Allocate using safe std::core API
        let mem_result = CoreAlloc(bytes_needed, flags)

        match mem_result {
            Some(ptr) => {
                let typed_ptr: *T = (*T)(u32)ptr  // Fixed: added parentheses
                return Option::Some(Allocation {
                    ptr: typed_ptr,
                    count: count,
                    flags: flags,
                })
            },
            None => {
                return Option::None
            }
        }
    }

    /// Get the number of elements in this allocation
    pub fn count(&self) -> u32 {
        return self.count
    }

    /// Get the size in bytes
    pub fn size_bytes(&self) -> u32 {
        let element_size: u32 = @sizeof(T)
        return self.count * element_size
    }

    /// Get immutable pointer to the allocated memory
    /// The pointer is valid until drop() is called
    pub fn as_ptr(&self) -> *T {
        return self.ptr
    }

    /// Get mutable pointer to the allocated memory
    /// The pointer is valid until drop() is called
    pub fn as_mut_ptr(&mut self) -> *T {
        return self.ptr
    }

    /// Check if this is a zero-size allocation
    pub fn is_empty(&self) -> bool {
        return self.count == 0u32
    }

    /// Free the allocated memory
    /// After calling drop(), the allocation is invalid and cannot be used
    ///
    /// Safety: You must not use the pointer returned by as_ptr()/as_mut_ptr()
    /// after calling drop(). The Novus compiler cannot enforce this yet.
    pub fn drop(&mut self) {
        if self.count > 0u32 {
            let bytes: u32 = self.size_bytes()
            let mem: *u8 = (*u8)(u32)(self.ptr)  // Fixed: added parentheses

            // Free using safe std::core API
            CoreFree(mem, bytes)

            // Invalidate the allocation to detect use-after-free in debug builds
            self.ptr = (*T)0
            self.count = 0u32
        }
    }
}

/// Box<T> - Single heap-allocated value
///
/// Box provides safe single-value heap allocation:
/// - Size is automatic (no need to pass @sizeof(T))
/// - Type-safe
/// - Prevents double-free
/// - Simple API for single values
///
/// Use this for:
/// - Single large structs
/// - Recursive data structures
/// - Heap-allocated values
///
/// Example:
/// ```
/// let boxed = Box::new(42)
/// match boxed {
///     Some(mut b) => {
///         let value = *b.get()  // Get the value
///         *b.get_mut() = 100    // Modify the value
///         b.drop()              // Cleanup
///     },
///     None => { /* allocation failed */ }
/// }
/// ```
pub struct Box<T> {
    ptr: *T,
}

impl<T> Box<T> {
    /// Allocate and initialize a Box with the given value
    /// Uses MEMF_PUBLIC by default
    /// Returns None if allocation fails
    pub fn new(value: T) -> Option<Box<T>> {
        return Box::new_in(value, MEMF_PUBLIC)
    }

    /// Allocate and initialize a Box with specific memory flags
    /// Returns None if allocation fails
    pub fn new_in(value: T, flags: u32) -> Option<Box<T>> {
        let bytes: u32 = @sizeof(T)

        // Allocate using safe std::core API
        let mem_result = CoreAlloc(bytes, flags)

        match mem_result {
            Some(ptr) => {
                let typed_ptr: *T = (*T)(u32)ptr  // Fixed: added parentheses
                // Initialize the value
                *typed_ptr = value
                return Option::Some(Box { ptr: typed_ptr })
            },
            None => {
                return Option::None
            }
        }
    }

    /// Get immutable reference to the boxed value
    pub fn get(&self) -> *T {
        return self.ptr
    }

    /// Get mutable reference to the boxed value
    pub fn get_mut(&mut self) -> *T {
        return self.ptr
    }

    // TODO: Fix generic type inference for dereferencing
    // /// Extract the value and free the box
    // /// This is safer than drop() because it ensures you get the value out
    // pub fn into_inner(&mut self) -> T {
    //     let value: T = *self.ptr
    //     self.drop()
    //     return value
    // }

    /// Free the boxed value
    /// After calling drop(), the box is invalid and cannot be used
    pub fn drop(&mut self) {
        let bytes: u32 = @sizeof(T)
        let mem: *u8 = (*u8)(u32)(self.ptr)  // Fixed: added parentheses

        // Free using safe std::core API
        CoreFree(mem, bytes)

        // Invalidate to detect use-after-free
        self.ptr = (*T)0
    }
}

