// Novus Standard Library - Panic/Error Handling
// Namespace: std::panic
// Unrecoverable error handling

// Import DOS for error output
from std::ffi::dos import Output, Write

// Panic handler - terminates the program with an error message
// This is the Novus equivalent of Rust's panic!() or C's abort()
//
// When panic is called:
// 1. Prints error message to stdout
// 2. Terminates program with exit code 20 (RETURN_FAIL in AmigaOS)
//
// Note: This function never returns!
// Note: In future, may trigger debugger or show Alert
pub fn panic(message: String) {
    // Try to write error to stdout (best effort)
    let stdout = Output()
    if stdout != 0 {
        // Write "PANIC: " prefix
        let prefix: String = "PANIC: "
        Write(stdout, (i32)(prefix.ptr), prefix.len)

        // Write the message
        Write(stdout, (i32)(message.ptr), message.len)

        // Write newline
        let newline: String = "\n"
        Write(stdout, (i32)(newline.ptr), newline.len)
    }

    // Halt execution (never returns)
    // TODO: Call AmigaOS Alert() for GUI popup or proper cleanup
    // For now, just loop forever since we don't have exit() linked
    loop_forever()
}

// Internal: infinite loop to halt execution
// This is a fallback until we properly link the C runtime's exit()
fn loop_forever() {
    while true {
        // Spin forever - program is terminated
    }
}
