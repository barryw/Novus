// Novus Standard Library - Core Types
// Namespace: std::core
// Generic enums for safe error handling and optional values

// Import safe wrappers from std::exec
from std::exec import SafeAllocMem, SafeFreeMem

// Create local wrappers for use in generic methods
// Note: These must be public so generic instantiation can find them
// Named CoreAlloc/CoreFree to avoid collision with FFI extern functions
pub fn CoreAlloc(byteSize: u32, attributes: u32) -> Option<*u8> {
    let ptr: *u8 = SafeAllocMem(byteSize, attributes)

    // Check if null and wrap in Option
    let ptr_as_int: u32 = (u32)ptr
    if ptr_as_int == 0u32 {
        return Option::None
    }

    return Option::Some(ptr)
}

pub fn CoreFree(memoryBlock: *u8, byteSize: u32) {
    SafeFreeMem(memoryBlock, byteSize)
}

// Option<T> - represents an optional value
// Use this instead of null pointers!
pub enum Option<T> {
    Some(T),
    None,
}

// Result<T, E> - represents success or failure
// Use this for functions that can fail!
pub enum Result<T, E> {
    Ok(T),
    Err(E),
}

// Note: For AmigaOS error types, see std/error.novus
// - DosError for file/disk operations
// - ExecError for memory/tasks/signals
// - IntuitionError for GUI operations
// - GraphicsError for graphics operations
// - NovusError for multi-subsystem errors

// Note: For collections like Vec, see std/collections.novus

// Note: MemoryBlock - if needed, add it here or in std::mem
pub struct MemoryBlock {
    ptr: *u8,
    size: u32,
}
