// Novus Standard Library - Core Types
// Namespace: std::core
// Generic enums for safe error handling and optional values

// Option<T> - represents an optional value
// Use this instead of null pointers!
pub enum Option<T> {
    Some(T),
    None,
}

impl<T> Option<T> {
    /// Create an Option from a pointer
    /// Returns Some(ptr) if ptr is non-null, None otherwise
    ///
    /// Example:
    /// ```novus
    /// let block_opt = MemoryBlock::alloc(1024, MEMF_FAST)
    /// match block_opt {
    ///     Some(block) => return Option::FromPointer(block.ptr()),
    ///     None => return Option::None
    /// }
    /// ```
    pub fn FromPointer(ptr: *T) -> Option<*T> {
        if let p = ptr {
            return Option::Some(p)
        }
        return Option::None
    }

    @inline
    pub fn is_some(self) -> bool {
        match self {
            Some(_) => return true,
            None => return false
        }
    }

    @inline
    pub fn is_none(self) -> bool {
        match self {
            Some(_) => return false,
            None => return true
        }
    }

    /// Returns the contained value or a default
    @inline
    pub fn unwrap_or(self, default_val: T) -> T {
        match self {
            Some(val) => return val,
            None => return default_val
        }
    }

    /// Unwrap the value, panicking if None
    /// Only use when you're certain the Option is Some
    pub fn unwrap(self) -> T {
        match self {
            Some(val) => return val,
            None => {
                panic!("called Option::unwrap() on a None value")
                // Control never reaches here, but compiler may need a return
            }
        }
    }

    /// Returns the contained value or computes it from a closure/default expression
    ///
    /// This is useful when the default value is expensive to compute.
    /// Since Novus doesn't have closures yet, this takes a default value directly.
    /// TODO: When closures are available, this should take `fn() -> T`
    @inline
    pub fn unwrap_or_else(self, default_val: T) -> T {
        // For now, identical to unwrap_or until we have closures
        match self {
            Some(val) => return val,
            None => return default_val
        }
    }

    /// Returns the option if it contains a value, otherwise returns optb
    ///
    /// Example:
    /// ```novus
    /// let x = Option::Some(2)
    /// let y = Option::Some(100)
    /// let result = x.or(y)  // Some(2)
    ///
    /// let x = Option::None
    /// let result = x.or(y)  // Some(100)
    /// ```
    @inline
    pub fn or(self, optb: Option<T>) -> Option<T> {
        match self {
            Some(v) => return Option::Some(v),
            None => return optb
        }
    }
}

// Result<T, E> - represents success or failure
// Use this for functions that can fail!
pub enum Result<T, E> {
    Ok(T),
    Err(E),
}

impl<T, E> Result<T, E> {
    @inline
    pub fn is_ok(self) -> bool {
        match self {
            Ok(_) => return true,
            Err(_) => return false
        }
    }

    @inline
    pub fn is_err(self) -> bool {
        match self {
            Ok(_) => return false,
            Err(_) => return true
        }
    }

    /// Returns the contained value or a default
    @inline
    pub fn unwrap_or(self, default_val: T) -> T {
        match self {
            Ok(val) => return val,
            Err(_) => return default_val
        }
    }

    /// Unwrap the value, panicking if Err
    /// Only use when you're certain the Result is Ok
    pub fn unwrap(self) -> T {
        match self {
            Ok(val) => return val,
            Err(_) => {
                panic!("called Result::unwrap() on an Err value")
            }
        }
    }

    /// Returns the contained error, panicking if Ok
    /// Only use when you're certain the Result is Err
    pub fn unwrap_err(self) -> E {
        match self {
            Ok(_) => {
                panic!("called Result::unwrap_err() on an Ok value")
            },
            Err(e) => return e
        }
    }

    /// Returns res if the result is Err, otherwise returns the Ok value of self
    ///
    /// Example:
    /// ```novus
    /// let x: Result<i32, MyError> = Result::Err(MyError::Error1)
    /// let y: Result<i32, MyError> = Result::Ok(2)
    /// let result = x.or(y)  // Ok(2)
    /// ```
    pub fn or(self, res: Result<T, E>) -> Result<T, E> {
        match self {
            Ok(v) => return Result::Ok(v),
            Err(_) => return res
        }
    }

    /// Converts from Result<T, E> to Option<T>
    /// Converts Ok(v) to Some(v), Err(_) to None
    ///
    /// Example:
    /// ```novus
    /// let x: Result<i32, &str> = Result::Ok(2)
    /// let opt = x.ok()  // Some(2)
    ///
    /// let y: Result<i32, &str> = Result::Err("oops")
    /// let opt = y.ok()  // None
    /// ```
    @inline
    pub fn ok(self) -> Option<T> {
        match self {
            Ok(v) => return Option::Some(v),
            Err(_) => return Option::None
        }
    }

    /// Converts from Result<T, E> to Option<E>
    /// Converts Err(e) to Some(e), Ok(_) to None
    ///
    /// Example:
    /// ```novus
    /// let x: Result<i32, &str> = Result::Err("oops")
    /// let opt = x.err()  // Some("oops")
    ///
    /// let y: Result<i32, &str> = Result::Ok(2)
    /// let opt = y.err()  // None
    /// ```
    @inline
    pub fn err(self) -> Option<E> {
        match self {
            Ok(_) => return Option::None,
            Err(e) => return Option::Some(e)
        }
    }
}

// LibraryVersion - semantic version information for AmigaOS libraries
// Represents a version in major.minor.patch format (semver)
pub struct LibraryVersion {
    major: u16,
    minor: u16,
    patch: u16,
}

impl LibraryVersion {
    /// Create a new LibraryVersion
    pub fn new(major: u16, minor: u16, patch: u16) -> LibraryVersion {
        return LibraryVersion { major: major, minor: minor, patch: patch }
    }

    /// Get the major version number
    pub fn major(self) -> u16 {
        return self.major
    }

    /// Get the minor version number
    pub fn minor(self) -> u16 {
        return self.minor
    }

    /// Get the patch version number
    pub fn patch(self) -> u16 {
        return self.patch
    }
}

// Note: For AmigaOS error types, see std/error.novus
// - DosError for file/disk operations
// - ExecError for memory/tasks/signals
// - IntuitionError for GUI operations
// - GraphicsError for graphics operations
// - NovusError for multi-subsystem errors

// Note: For collections like Vec, see std/collections.novus
// Note: For memory management, see std/mem.novus (MemoryBlock, Allocation<T>, Box<T>)

// ============================================================================
// Iterable Trait - Foundation for For-In Loops
// ============================================================================

// Iterable<T> - allows types to be used in for-in loops
// Types implementing this trait can be iterated over with: for item in collection { ... }
//
// Requirements:
// - get(index: u32) -> Option<T>: Access element at index, returns None if out of bounds
// - len() -> u32: Total number of elements in the collection
//
// Example implementation:
// ```novus
// impl<T> Iterable<T> for Vec<T> {
//     fn get(&self, index: u32) -> Option<T> { ... }
//     fn len(&self) -> u32 { ... }
// }
// ```
pub trait Iterable<T> {
    fn get(&self, index: u32) -> Option<T>
    fn len(&self) -> u32
}

// ============================================================================
// Copy Trait - Marker Trait for Copyable Types
// ============================================================================

// Copy is a marker trait that indicates a type can be copied bitwise.
// Types implementing Copy will be implicitly copied when passed by value,
// rather than moved.
//
// When to implement Copy:
// - Simple value types with no resources (integers, bools, pointers)
// - Small structs containing only Copy types
// - Wrapper types around primitives
//
// When NOT to implement Copy:
// - Types that own heap memory (Vec, String, Box)
// - Types with Drop implementations that free resources
// - Types containing non-Copy fields
//
// Example:
// ```novus
// struct Point { x: i32, y: i32 }
// impl Copy for Point {}
//
// let p1 = Point { x: 10, y: 20 }
// let p2 = p1  // Copies p1 instead of moving it
// // p1 is still valid here!
// ```
//
// Note: The compiler automatically considers primitive types (i32, u32, bool, etc.)
// and pointer types as Copy without requiring explicit impl.
pub trait Copy {}

// ============================================================================
// From Trait - Automatic Type Conversions
// ============================================================================

// From<T> - enables automatic type conversions
// Primary use case: automatic error conversions with the ? operator
//
// When you implement From<SourceType> for TargetType, the compiler automatically
// converts SourceType to TargetType when needed (e.g., in ? operator error propagation)
//
// Requirements:
// - convert(value: T) -> Self: Convert from T to Self
//
// Note: We use 'convert' instead of 'from' because 'from' is a keyword in Novus
// (used in import statements: `from std::core import Option`)
//
// Example implementation:
// ```novus
// impl From<DosError> for NovusError {
//     fn convert(err: DosError) -> NovusError {
//         return NovusError::Dos(err)
//     }
// }
//
// // Now the ? operator can automatically convert DosError to NovusError:
// fn foo() -> Result<i32, NovusError> {
//     let file = open_file("test.txt")?  // Returns Result<File, DosError>
//     // If open_file returns Err(dos_err), ? automatically calls
//     // NovusError::convert(dos_err) and returns Err(converted_error)
//     return Ok(42)
// }
// ```
pub trait From<T> {
    fn convert(value: T) -> Self
}

// ============================================================================
// Drop Trait - Automatic Resource Cleanup (RAII)
// ============================================================================

// Drop - enables automatic cleanup when values go out of scope
//
// This trait provides automatic resource management (RAII - Resource Acquisition
// Is Initialization). When a value implementing Drop goes out of scope, the
// compiler automatically calls its drop() method to clean up resources.
//
// This is similar to Rust's Drop trait or C++'s destructors, ensuring that
// resources like memory, file handles, or hardware access are properly released
// without requiring manual cleanup in every code path.
//
// Requirements:
// - drop(&mut self): Clean up the resource
//
// The drop() method is called automatically by the compiler:
// - At the end of a block scope
// - Before reassignment
// - Before early returns
// - When a variable is shadowed
//
// Drop is NOT called if:
// - The value was moved to another location
// - A field was partially moved (only non-moved fields are dropped)
//
// Example implementation:
// ```novus
// impl Drop for MemoryBlock {
//     fn drop(&mut self) {
//         if self.size > 0 {
//             unsafe { FreeMem(self.ptr, self.size) }
//             self.ptr = (*u8)0
//             self.size = 0
//         }
//     }
// }
//
// // Usage - no manual cleanup needed!
// fn example() -> Result<(), ExecError> {
//     let mem = MemoryBlock::alloc(1024, MEMF_FAST)?
//     // ... use mem ...
//     return Ok(())  // mem.drop() called automatically before return
// }  // mem.drop() also called automatically here if we didn't return early
// ```
//
// Drop order:
// - Variables are dropped in reverse order of creation
// - Struct fields are dropped in declaration order
// - defer blocks run before automatic drop
//
// Safety notes:
// - drop() must not panic or fail
// - Use unsafe for operations that cannot fail
// - Avoid cyclic references (future: use weak references)
pub trait Drop {
    fn drop(&mut self)
}

// ============================================================================
// Hash Trait - For computing hash values
// ============================================================================

// Hash - enables types to be used as keys in hash-based collections
//
// Types implementing Hash can be used as keys in HashMap, HashSet, etc.
// The hash function should return a u32 value that represents the object.
//
// Contract:
// - If two values are equal (via Eq), they MUST produce the same hash value
// - It's acceptable for different values to produce the same hash (collision)
// - The hash function should distribute values uniformly across the u32 range
//
// Example implementation:
// ```novus
// impl Hash for Point {
//     fn hash(&self) -> u32 {
//         // Combine hashes of x and y coordinates
//         var h: u32 = self.x.hash()
//         h = h ^ (self.y.hash() * $9e3779b9)
//         return h
//     }
// }
// ```
pub trait Hash {
    fn hash(&self) -> u32
}

// ============================================================================
// Eq Trait - For equality comparison
// ============================================================================

// Eq - enables types to be compared for equality
//
// Types implementing Eq can be compared using == and != operators.
// This trait is required for hash map keys to resolve hash collisions.
//
// Contract:
// - Reflexive: a.eq(&a) must return true
// - Symmetric: a.eq(&b) must equal b.eq(&a)
// - Transitive: if a.eq(&b) and b.eq(&c), then a.eq(&c)
//
// Note: If implementing both Hash and Eq, the following MUST hold:
//       If a.eq(&b), then a.hash() == b.hash()
//
// Example implementation:
// ```novus
// impl Eq for Point {
//     fn eq(&self, other: &Point) -> bool {
//         return self.x == other.x && self.y == other.y
//     }
// }
// ```
pub trait Eq {
    fn eq(&self, other: &Self) -> bool
}

// ============================================================================
// Operator Traits - For operator overloading
// ============================================================================

// Add - enables the + operator for custom types
//
// Example implementation:
// ```novus
// impl Add for Point {
//     fn add(&self, other: &Point) -> Point {
//         return Point { x: self.x + other.x, y: self.y + other.y }
//     }
// }
// ```
pub trait Add {
    fn add(&self, other: &Self) -> Self
}

// Sub - enables the - operator for custom types
pub trait Sub {
    fn sub(&self, other: &Self) -> Self
}

// Mul - enables the * operator for custom types
pub trait Mul {
    fn mul(&self, other: &Self) -> Self
}

// Div - enables the / operator for custom types
pub trait Div {
    fn div(&self, other: &Self) -> Self
}

// Rem - enables the % operator for custom types (remainder/modulo)
pub trait Rem {
    fn rem(&self, other: &Self) -> Self
}

// Neg - enables unary - operator for custom types
pub trait Neg {
    fn neg(&self) -> Self
}

// PartialOrd - enables comparison operators (<, <=, >, >=) for custom types
// Note: == and != use the existing Eq trait
//
// Example implementation:
// ```novus
// impl PartialOrd for Version {
//     fn lt(&self, other: &Version) -> bool {
//         if self.major < other.major { return true }
//         if self.major > other.major { return false }
//         return self.minor < other.minor
//     }
//     fn le(&self, other: &Version) -> bool { return self.lt(other) || self.eq(other) }
//     fn gt(&self, other: &Version) -> bool { return other.lt(self) }
//     fn ge(&self, other: &Version) -> bool { return other.le(self) }
// }
// ```
pub trait PartialOrd {
    fn lt(&self, other: &Self) -> bool
    fn le(&self, other: &Self) -> bool
    fn gt(&self, other: &Self) -> bool
    fn ge(&self, other: &Self) -> bool
}

// Index - enables the [] operator for read access on custom types
//
// Example implementation:
// ```novus
// impl Index<u32, i32> for MyArray {
//     fn index(&self, idx: u32) -> i32 {
//         return self.data[idx]
//     }
// }
// ```
pub trait Index<I, T> {
    fn index(&self, idx: I) -> T
}

// IndexMut - enables the [] operator for write access on custom types
//
// Example implementation:
// ```novus
// impl IndexMut<u32, i32> for MyArray {
//     fn index_set(&mut self, idx: u32, value: i32) {
//         self.data[idx] = value
//     }
// }
// ```
pub trait IndexMut<I, T> {
    fn index_set(&mut self, idx: I, value: T)
}

// ============================================================================
// Hash implementations for primitive types
// ============================================================================

// Hash mixing constants as u32
// Note: We use decimal form to avoid signed/unsigned literal issues
// $85ebca6b = 2246822507
// $c2b2ae35 = 3266489909

// Hash for u8
impl Hash for u8 {
    fn hash(&self) -> u32 {
        // Mix the bits for better distribution
        var h: u32 = (u32)*self
        h = h ^ (h >> 4)
        h = h * 2246822507u32
        h = h ^ (h >> 13)
        return h
    }
}

// Hash for u16
impl Hash for u16 {
    fn hash(&self) -> u32 {
        var h: u32 = (u32)*self
        h = h ^ (h >> 8)
        h = h * 2246822507u32
        h = h ^ (h >> 13)
        return h
    }
}

// Hash for u32
impl Hash for u32 {
    fn hash(&self) -> u32 {
        // FNV-1a inspired mixing
        var h: u32 = *self
        h = h ^ (h >> 16)
        h = h * 2246822507u32
        h = h ^ (h >> 13)
        h = h * 3266489909u32
        h = h ^ (h >> 16)
        return h
    }
}

// Hash for i8
impl Hash for i8 {
    fn hash(&self) -> u32 {
        // Cast to u8 first to avoid sign extension, then to u32
        let byte_val: u8 = (u8)*self
        var h: u32 = (u32)byte_val
        h = h ^ (h >> 4)
        h = h * 2246822507u32
        h = h ^ (h >> 13)
        return h
    }
}

// Hash for i16
impl Hash for i16 {
    fn hash(&self) -> u32 {
        // Cast to u16 first to avoid sign extension, then to u32
        let short_val: u16 = (u16)*self
        var h: u32 = (u32)short_val
        h = h ^ (h >> 8)
        h = h * 2246822507u32
        h = h ^ (h >> 13)
        return h
    }
}

// Hash for i32
impl Hash for i32 {
    fn hash(&self) -> u32 {
        // Reinterpret as unsigned
        var h: u32 = (u32)*self
        h = h ^ (h >> 16)
        h = h * 2246822507u32
        h = h ^ (h >> 13)
        h = h * 3266489909u32
        h = h ^ (h >> 16)
        return h
    }
}

// Hash for bool
impl Hash for bool {
    fn hash(&self) -> u32 {
        if *self {
            return 1u32
        }
        return 0u32
    }
}

// ============================================================================
// Eq implementations for primitive types
// ============================================================================

// Eq for u8
impl Eq for u8 {
    fn eq(&self, other: &u8) -> bool {
        return *self == *other
    }
}

// Eq for u16
impl Eq for u16 {
    fn eq(&self, other: &u16) -> bool {
        return *self == *other
    }
}

// Eq for u32
impl Eq for u32 {
    fn eq(&self, other: &u32) -> bool {
        return *self == *other
    }
}

// Eq for i8
impl Eq for i8 {
    fn eq(&self, other: &i8) -> bool {
        return *self == *other
    }
}

// Eq for i16
impl Eq for i16 {
    fn eq(&self, other: &i16) -> bool {
        return *self == *other
    }
}

// Eq for i32
impl Eq for i32 {
    fn eq(&self, other: &i32) -> bool {
        return *self == *other
    }
}

// Eq for bool
impl Eq for bool {
    fn eq(&self, other: &bool) -> bool {
        return *self == *other
    }
}
