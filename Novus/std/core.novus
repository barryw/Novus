// Novus Standard Library - Core Types
// Namespace: std::core
// Generic enums for safe error handling and optional values

// Option<T> - represents an optional value
// Use this instead of null pointers!
pub enum Option<T> {
    Some(T),
    None,
}

impl<T> Option<T> {
    /// Create an Option from a pointer
    /// Returns Some(ptr) if ptr is non-null, None otherwise
    ///
    /// Example:
    /// ```novus
    /// let block_opt = MemoryBlock::alloc(1024, MEMF_FAST)
    /// match block_opt {
    ///     Some(block) => return Option::FromPointer(block.ptr()),
    ///     None => return Option::None
    /// }
    /// ```
    pub fn FromPointer(ptr: *T) -> Option<*T> {
        if let p = ptr {
            return Option::Some(p)
        }
        return Option::None
    }

    @inline
    pub fn is_some(self) -> bool {
        match self {
            Some(_) => return true,
            None => return false
        }
    }

    @inline
    pub fn is_none(self) -> bool {
        match self {
            Some(_) => return false,
            None => return true
        }
    }

    /// Returns the contained value or a default
    @inline
    pub fn unwrap_or(self, default_val: T) -> T {
        match self {
            Some(val) => return val,
            None => return default_val
        }
    }

    /// Unwrap the value, panicking if None
    /// Only use when you're certain the Option is Some
    pub fn unwrap(self) -> T {
        match self {
            Some(val) => return val,
            None => {
                panic!("called Option::unwrap() on a None value")
                // Control never reaches here, but compiler may need a return
            }
        }
    }

    /// Returns the contained value or computes it from a closure/default expression
    ///
    /// This is useful when the default value is expensive to compute.
    /// Since Novus doesn't have closures yet, this takes a default value directly.
    /// TODO: When closures are available, this should take `fn() -> T`
    @inline
    pub fn unwrap_or_else(self, default_val: T) -> T {
        // For now, identical to unwrap_or until we have closures
        match self {
            Some(val) => return val,
            None => return default_val
        }
    }

    /// Returns the option if it contains a value, otherwise returns optb
    ///
    /// Example:
    /// ```novus
    /// let x = Option::Some(2)
    /// let y = Option::Some(100)
    /// let result = x.or(y)  // Some(2)
    ///
    /// let x = Option::None
    /// let result = x.or(y)  // Some(100)
    /// ```
    @inline
    pub fn or(self, optb: Option<T>) -> Option<T> {
        match self {
            Some(v) => return Option::Some(v),
            None => return optb
        }
    }
}

// Result<T, E> - represents success or failure
// Use this for functions that can fail!
pub enum Result<T, E> {
    Ok(T),
    Err(E),
}

impl<T, E> Result<T, E> {
    @inline
    pub fn is_ok(self) -> bool {
        match self {
            Ok(_) => return true,
            Err(_) => return false
        }
    }

    @inline
    pub fn is_err(self) -> bool {
        match self {
            Ok(_) => return false,
            Err(_) => return true
        }
    }

    /// Returns the contained value or a default
    @inline
    pub fn unwrap_or(self, default_val: T) -> T {
        match self {
            Ok(val) => return val,
            Err(_) => return default_val
        }
    }

    /// Unwrap the value, panicking if Err
    /// Only use when you're certain the Result is Ok
    pub fn unwrap(self) -> T {
        match self {
            Ok(val) => return val,
            Err(_) => {
                panic!("called Result::unwrap() on an Err value")
            }
        }
    }

    /// Returns the contained error, panicking if Ok
    /// Only use when you're certain the Result is Err
    pub fn unwrap_err(self) -> E {
        match self {
            Ok(_) => {
                panic!("called Result::unwrap_err() on an Ok value")
            },
            Err(e) => return e
        }
    }

    /// Returns res if the result is Err, otherwise returns the Ok value of self
    ///
    /// Example:
    /// ```novus
    /// let x: Result<i32, MyError> = Result::Err(MyError::Error1)
    /// let y: Result<i32, MyError> = Result::Ok(2)
    /// let result = x.or(y)  // Ok(2)
    /// ```
    pub fn or(self, res: Result<T, E>) -> Result<T, E> {
        match self {
            Ok(v) => return Result::Ok(v),
            Err(_) => return res
        }
    }

    /// Converts from Result<T, E> to Option<T>
    /// Converts Ok(v) to Some(v), Err(_) to None
    ///
    /// Example:
    /// ```novus
    /// let x: Result<i32, &str> = Result::Ok(2)
    /// let opt = x.ok()  // Some(2)
    ///
    /// let y: Result<i32, &str> = Result::Err("oops")
    /// let opt = y.ok()  // None
    /// ```
    @inline
    pub fn ok(self) -> Option<T> {
        match self {
            Ok(v) => return Option::Some(v),
            Err(_) => return Option::None
        }
    }

    /// Converts from Result<T, E> to Option<E>
    /// Converts Err(e) to Some(e), Ok(_) to None
    ///
    /// Example:
    /// ```novus
    /// let x: Result<i32, &str> = Result::Err("oops")
    /// let opt = x.err()  // Some("oops")
    ///
    /// let y: Result<i32, &str> = Result::Ok(2)
    /// let opt = y.err()  // None
    /// ```
    @inline
    pub fn err(self) -> Option<E> {
        match self {
            Ok(_) => return Option::None,
            Err(e) => return Option::Some(e)
        }
    }
}

// LibraryVersion - semantic version information for AmigaOS libraries
// Represents a version in major.minor.patch format (semver)
pub struct LibraryVersion {
    major: u16,
    minor: u16,
    patch: u16,
}

impl LibraryVersion {
    /// Create a new LibraryVersion
    pub fn new(major: u16, minor: u16, patch: u16) -> LibraryVersion {
        return LibraryVersion { major: major, minor: minor, patch: patch }
    }

    /// Get the major version number
    pub fn major(&self) -> u16 {
        return self.major
    }

    /// Get the minor version number
    pub fn minor(&self) -> u16 {
        return self.minor
    }

    /// Get the patch version number
    pub fn patch(&self) -> u16 {
        return self.patch
    }

    /// Compare two versions using semantic versioning rules
    pub fn cmp(&self, other: &LibraryVersion) -> i32 {
        if self.major != other.major {
            return (i32)self.major - (i32)other.major
        }
        if self.minor != other.minor {
            return (i32)self.minor - (i32)other.minor
        }
        return (i32)self.patch - (i32)other.patch
    }
}

// Note: For AmigaOS error types, see std/error.novus
// - DosError for file/disk operations
// - ExecError for memory/tasks/signals
// - IntuitionError for GUI operations
// - GraphicsError for graphics operations
// - NovusError for multi-subsystem errors

// Note: For collections like Vec, see std/collections.novus
// Note: For memory management, see std/mem.novus (MemoryBlock, Allocation<T>, Box<T>)

// ============================================================================
// Iterable Trait - Foundation for For-In Loops
// ============================================================================

// Iterable<T> - allows types to be used in for-in loops
// Types implementing this trait can be iterated over with: for item in collection { ... }
//
// Requirements:
// - get(index: u32) -> Option<T>: Access element at index, returns None if out of bounds
// - len() -> u32: Total number of elements in the collection
//
// Example implementation:
// ```novus
// impl<T> Iterable<T> for Vec<T> {
//     fn get(&self, index: u32) -> Option<T> { ... }
//     fn len(&self) -> u32 { ... }
// }
// ```
pub trait Iterable<T> {
    fn get(&self, index: u32) -> Option<T>
    fn len(&self) -> u32
}

// ============================================================================
// Copy Trait - Marker Trait for Copyable Types
// ============================================================================

// Copy is a marker trait that indicates a type can be copied bitwise.
// Types implementing Copy will be implicitly copied when passed by value,
// rather than moved.
//
// When to implement Copy:
// - Simple value types with no resources (integers, bools, pointers)
// - Small structs containing only Copy types
// - Wrapper types around primitives
//
// When NOT to implement Copy:
// - Types that own heap memory (Vec, String, Box)
// - Types with Drop implementations that free resources
// - Types containing non-Copy fields
//
// Example:
// ```novus
// struct Point { x: i32, y: i32 }
// impl Copy for Point {}
//
// let p1 = Point { x: 10, y: 20 }
// let p2 = p1  // Copies p1 instead of moving it
// // p1 is still valid here!
// ```
//
// Note: The compiler automatically considers primitive types (i32, u32, bool, etc.)
// and pointer types as Copy without requiring explicit impl.
pub trait Copy {}

// ============================================================================
// From Trait - Automatic Type Conversions
// ============================================================================

// From<T> - enables automatic type conversions
// Primary use case: automatic error conversions with the ? operator
//
// When you implement From<SourceType> for TargetType, the compiler automatically
// converts SourceType to TargetType when needed (e.g., in ? operator error propagation)
//
// Requirements:
// - convert(value: T) -> Self: Convert from T to Self
//
// Note: We use 'convert' instead of 'from' because 'from' is a keyword in Novus
// (used in import statements: `from std::core import Option`)
//
// Example implementation:
// ```novus
// impl From<DosError> for NovusError {
//     fn convert(err: DosError) -> NovusError {
//         return NovusError::Dos(err)
//     }
// }
//
// // Now the ? operator can automatically convert DosError to NovusError:
// fn foo() -> Result<i32, NovusError> {
//     let file = open_file("test.txt")?  // Returns Result<File, DosError>
//     // If open_file returns Err(dos_err), ? automatically calls
//     // NovusError::convert(dos_err) and returns Err(converted_error)
//     return Ok(42)
// }
// ```
pub trait From<T> {
    fn convert(value: T) -> Self
}

// ============================================================================
// Drop Trait - Automatic Resource Cleanup (RAII)
// ============================================================================

// Drop - enables automatic cleanup when values go out of scope
//
// This trait provides automatic resource management (RAII - Resource Acquisition
// Is Initialization). When a value implementing Drop goes out of scope, the
// compiler automatically calls its drop() method to clean up resources.
//
// This is similar to Rust's Drop trait or C++'s destructors, ensuring that
// resources like memory, file handles, or hardware access are properly released
// without requiring manual cleanup in every code path.
//
// Requirements:
// - drop(&var self): Clean up the resource
//
// The drop() method is called automatically by the compiler:
// - At the end of a block scope
// - Before reassignment
// - Before early returns
// - When a variable is shadowed
//
// Drop is NOT called if:
// - The value was moved to another location
// - A field was partially moved (only non-moved fields are dropped)
//
// Example implementation:
// ```novus
// impl Drop for MemoryBlock {
//     fn drop(&var self) {
//         if self.size > 0 {
//             unsafe { FreeMem(self.ptr, self.size) }
//             self.ptr = (*u8)0
//             self.size = 0
//         }
//     }
// }
//
// // Usage - no manual cleanup needed!
// fn example() -> Result<(), ExecError> {
//     let mem = MemoryBlock::alloc(1024, MEMF_FAST)?
//     // ... use mem ...
//     return Ok(())  // mem.drop() called automatically before return
// }  // mem.drop() also called automatically here if we didn't return early
// ```
//
// Drop order:
// - Variables are dropped in reverse order of creation
// - Struct fields are dropped in declaration order
// - defer blocks run before automatic drop
//
// Safety notes:
// - drop() must not panic or fail
// - Use unsafe for operations that cannot fail
// - Avoid cyclic references (future: use weak references)
pub trait Drop {
    fn drop(&var self)
}

// ============================================================================
// Hash Trait - For computing hash values
// ============================================================================

// Hash - enables types to be used as keys in hash-based collections
//
// Types implementing Hash can be used as keys in HashMap, HashSet, etc.
// The hash function should return a u32 value that represents the object.
//
// Contract:
// - If two values are equal (via Eq), they MUST produce the same hash value
// - It's acceptable for different values to produce the same hash (collision)
// - The hash function should distribute values uniformly across the u32 range
//
// Example implementation:
// ```novus
// impl Hash for Point {
//     fn hash(&self) -> u32 {
//         // Combine hashes of x and y coordinates
//         var h: u32 = self.x.hash()
//         h = h ^ (self.y.hash() * $9e3779b9)
//         return h
//     }
// }
// ```
pub trait Hash {
    fn hash(&self) -> u32
}

// ============================================================================
// Eq Trait - For equality comparison
// ============================================================================

// Eq - enables types to be compared for equality
//
// Types implementing Eq can be compared using == and != operators.
// This trait is required for hash map keys to resolve hash collisions.
//
// Contract:
// - Reflexive: a.eq(&a) must return true
// - Symmetric: a.eq(&b) must equal b.eq(&a)
// - Transitive: if a.eq(&b) and b.eq(&c), then a.eq(&c)
//
// Note: If implementing both Hash and Eq, the following MUST hold:
//       If a.eq(&b), then a.hash() == b.hash()
//
// Example implementation:
// ```novus
// impl Eq for Point {
//     fn eq(&self, other: &Point) -> bool {
//         return self.x == other.x && self.y == other.y
//     }
// }
// ```
pub trait Eq {
    fn eq(&self, other: &Self) -> bool
}

// ============================================================================
// Operator Traits - For operator overloading
// ============================================================================

// Add - enables the + operator for custom types
//
// Example implementation:
// ```novus
// impl Add for Point {
//     fn add(&self, other: &Point) -> Point {
//         return Point { x: self.x + other.x, y: self.y + other.y }
//     }
// }
// ```
pub trait Add {
    fn add(&self, other: &Self) -> Self
}

// Sub - enables the - operator for custom types
pub trait Sub {
    fn sub(&self, other: &Self) -> Self
}

// Mul - enables the * operator for custom types
pub trait Mul {
    fn mul(&self, other: &Self) -> Self
}

// Div - enables the / operator for custom types
pub trait Div {
    fn div(&self, other: &Self) -> Self
}

// Rem - enables the % operator for custom types (remainder/modulo)
pub trait Rem {
    fn rem(&self, other: &Self) -> Self
}

// Neg - enables unary - operator for custom types
pub trait Neg {
    fn neg(&self) -> Self
}

// PartialOrd - enables comparison operators (<, <=, >, >=) for custom types
// Note: == and != use the existing Eq trait
//
// Example implementation:
// ```novus
// impl PartialOrd for Version {
//     fn lt(&self, other: &Version) -> bool {
//         if self.major < other.major { return true }
//         if self.major > other.major { return false }
//         return self.minor < other.minor
//     }
//     fn le(&self, other: &Version) -> bool { return self.lt(other) || self.eq(other) }
//     fn gt(&self, other: &Version) -> bool { return other.lt(self) }
//     fn ge(&self, other: &Version) -> bool { return other.le(self) }
// }
// ```
pub trait PartialOrd {
    fn lt(&self, other: &Self) -> bool
    fn le(&self, other: &Self) -> bool
    fn gt(&self, other: &Self) -> bool
    fn ge(&self, other: &Self) -> bool
}

// Index - enables the [] operator for read access on custom types
//
// Example implementation:
// ```novus
// impl Index<u32, i32> for MyArray {
//     fn index(&self, idx: u32) -> i32 {
//         return self.data[idx]
//     }
// }
// ```
pub trait Index<I, T> {
    fn index(&self, idx: I) -> T
}

// IndexMut - enables the [] operator for write access on custom types
//
// Example implementation:
// ```novus
// impl IndexMut<u32, i32> for MyArray {
//     fn index_set(&var self, idx: u32, value: i32) {
//         self.data[idx] = value
//     }
// }
// ```
pub trait IndexMut<I, T> {
    fn index_set(&var self, idx: I, value: T)
}

// ============================================================================
// Hash implementations for primitive types
// ============================================================================

// Hash mixing constants as u32
// Note: We use decimal form to avoid signed/unsigned literal issues
// $85ebca6b = 2246822507
// $c2b2ae35 = 3266489909

// Hash for u8
impl Hash for u8 {
    fn hash(&self) -> u32 {
        // Mix the bits for better distribution
        var h: u32 = (u32)*self
        h = h ^ (h >> 4)
        h = h * 2246822507u32
        h = h ^ (h >> 13)
        return h
    }
}

// Hash for u16
impl Hash for u16 {
    fn hash(&self) -> u32 {
        var h: u32 = (u32)*self
        h = h ^ (h >> 8)
        h = h * 2246822507u32
        h = h ^ (h >> 13)
        return h
    }
}

// Hash for u32
impl Hash for u32 {
    fn hash(&self) -> u32 {
        // FNV-1a inspired mixing
        var h: u32 = *self
        h = h ^ (h >> 16)
        h = h * 2246822507u32
        h = h ^ (h >> 13)
        h = h * 3266489909u32
        h = h ^ (h >> 16)
        return h
    }
}

// Hash for i8
impl Hash for i8 {
    fn hash(&self) -> u32 {
        // Cast to u8 first to avoid sign extension, then to u32
        let byte_val: u8 = (u8)*self
        var h: u32 = (u32)byte_val
        h = h ^ (h >> 4)
        h = h * 2246822507u32
        h = h ^ (h >> 13)
        return h
    }
}

// Hash for i16
impl Hash for i16 {
    fn hash(&self) -> u32 {
        // Cast to u16 first to avoid sign extension, then to u32
        let short_val: u16 = (u16)*self
        var h: u32 = (u32)short_val
        h = h ^ (h >> 8)
        h = h * 2246822507u32
        h = h ^ (h >> 13)
        return h
    }
}

// Hash for i32
impl Hash for i32 {
    fn hash(&self) -> u32 {
        // Reinterpret as unsigned
        var h: u32 = (u32)*self
        h = h ^ (h >> 16)
        h = h * 2246822507u32
        h = h ^ (h >> 13)
        h = h * 3266489909u32
        h = h ^ (h >> 16)
        return h
    }
}

// Hash for bool
impl Hash for bool {
    fn hash(&self) -> u32 {
        if *self {
            return 1u32
        }
        return 0u32
    }
}

// ============================================================================
// Eq implementations for primitive types
// ============================================================================

// Eq for u8
impl Eq for u8 {
    fn eq(&self, other: &u8) -> bool {
        return *self == *other
    }
}

// Eq for u16
impl Eq for u16 {
    fn eq(&self, other: &u16) -> bool {
        return *self == *other
    }
}

// Eq for u32
impl Eq for u32 {
    fn eq(&self, other: &u32) -> bool {
        return *self == *other
    }
}

// Eq for i8
impl Eq for i8 {
    fn eq(&self, other: &i8) -> bool {
        return *self == *other
    }
}

// Eq for i16
impl Eq for i16 {
    fn eq(&self, other: &i16) -> bool {
        return *self == *other
    }
}

// Eq for i32
impl Eq for i32 {
    fn eq(&self, other: &i32) -> bool {
        return *self == *other
    }
}

// Eq for bool
impl Eq for bool {
    fn eq(&self, other: &bool) -> bool {
        return *self == *other
    }
}

// ============================================================================
// Clone Trait - Explicit Deep Copying
// ============================================================================

/// Clone provides explicit deep copying for types that need it.
///
/// Unlike Copy (implicit bitwise copy), Clone is an explicit operation that
/// may allocate memory. Types implementing Clone can create independent
/// duplicates of themselves.
///
/// When to implement Clone:
/// - Types that own heap memory (Vec, String, HashMap)
/// - Types where copying involves allocation
/// - Types that need custom copy logic
///
/// When NOT to implement Clone:
/// - Simple value types (use Copy instead)
/// - Types that shouldn't be duplicated (unique handles, file locks)
///
/// Example implementation:
/// ```novus
/// impl Clone for String {
///     fn clone(&self) -> Option<Self> {
///         var new_string = String::with_capacity(self.len())?
///         new_string.push_str(self.as_str())
///         return Option::Some(new_string)
///     }
/// }
/// ```
///
/// Example usage:
/// ```novus
/// let original = String::from("Hello")
/// match original.clone() {
///     Some(var copy) => {
///         copy.push_str(" World")  // original unchanged
///     },
///     None => // handle allocation failure
/// }
/// ```
pub trait Clone {
    /// Create a deep copy of this value.
    /// Returns None if cloning fails (e.g., allocation failure).
    fn clone(&self) -> Option<Self>
}

// ============================================================================
// AsRef / AsMut Traits - Zero-Cost View Conversions
// ============================================================================

/// AsRef provides cheap reference-to-reference conversions.
///
/// This trait is used for generic code that can work with both owned types
/// and borrowed views. It enables functions to accept any type that can
/// provide a reference to T without allocation.
///
/// Common implementations:
/// - String: AsRef<Str> - view owned string as borrowed slice
/// - Vec<T>: AsRef<Slice<T>> - view owned vec as borrowed slice
/// - PathString: AsRef<Str> - view path string as borrowed slice
///
/// Example implementation:
/// ```novus
/// impl AsRef<Str> for String {
///     fn as_ref(&self) -> Str {
///         return self.as_str()
///     }
/// }
/// ```
///
/// Example usage:
/// ```novus
/// fn process<S: AsRef<Str>>(s: &S) {
///     let str_view: Str = s.as_ref()
///     // Works with String, PathString, &Str, etc.
/// }
/// ```
pub trait AsRef<T> {
    /// Convert this reference to a reference of type T.
    fn as_ref(&self) -> T
}

/// AsMut provides cheap mutable reference-to-mutable reference conversions.
///
/// This is the mutable counterpart to AsRef, allowing generic code to
/// work with mutable views of data.
///
/// Example implementation:
/// ```novus
/// impl AsMut<Slice<u8>> for Vec<u8> {
///     fn as_mut(&var self) -> Slice<u8> {
///         return Slice::new(self.ptr, self.len)
///     }
/// }
/// ```
pub trait AsMut<T> {
    /// Convert this mutable reference to a mutable reference of type T.
    fn as_mut(&var self) -> T
}

// ============================================================================
// Iterator Trait - Standard Iteration Protocol
// ============================================================================

/// Iterator provides a standard protocol for sequential iteration.
///
/// Unlike Iterable (which uses index-based access for for-in loops),
/// Iterator represents a stateful cursor through a sequence. This enables
/// lazy evaluation, custom traversal patterns, and iterator combinators.
///
/// Iterators are consumed as they advance - each call to next() moves
/// the cursor forward and returns the next item.
///
/// Types that implement Iterator:
/// - SplitIter (string splitting)
/// - LinesIter (line iteration)
/// - HashMapIter (key-value pairs)
/// - VecIter (vector elements)
///
/// Example implementation:
/// ```novus
/// struct RangeIter {
///     current: u32,
///     end: u32,
/// }
///
/// impl Iterator<u32> for RangeIter {
///     fn next(&var self) -> Option<u32> {
///         if self.current >= self.end {
///             return Option::None
///         }
///         let val = self.current
///         self.current++
///         return Option::Some(val)
///     }
/// }
/// ```
///
/// Example usage:
/// ```novus
/// var iter = string.split(",")
/// while let Some(part) = iter.next() {
///     // process each part
/// }
/// ```
pub trait Iterator<T> {
    /// Advance the iterator and return the next item.
    /// Returns None when iteration is complete.
    fn next(&var self) -> Option<T>
}

// ============================================================================
// Write Trait - Unified Output Interface
// ============================================================================

/// Write provides a unified interface for types that accept output.
///
/// This trait abstracts over different output destinations (strings, buffers,
/// files, formatters) allowing generic code that can write to any sink.
///
/// Types that implement Write:
/// - StringBuilder - growable string buffer
/// - String - append to owned string
/// - Formatter - format string builder
/// - StackFormatter - fixed-size stack buffer
/// - File (future) - file output
///
/// Note: We use raw pointer + length instead of Str to avoid circular
/// dependencies (Str is defined in std::strings which depends on core).
///
/// Example implementation:
/// ```novus
/// impl Write for StringBuilder {
///     fn write_bytes(&var self, ptr: *u8, len: u32) -> bool {
///         // Copy bytes from ptr
///     }
///
///     fn write_byte(&var self, b: u8) -> bool {
///         return self.push_byte(b)
///     }
/// }
/// ```
///
/// Example usage:
/// ```novus
/// fn write_header<W: Write>(w: &var W) -> bool {
///     let msg = "=== Header ===\n"
///     return w.write_bytes(msg.ptr, msg.len)
/// }
/// // Works with StringBuilder, String, File, etc.
/// ```
pub trait Write {
    /// Write bytes from a pointer to this output.
    /// Returns true on success, false on failure (e.g., buffer full).
    fn write_bytes(&var self, ptr: *u8, len: u32) -> bool

    /// Write a single byte to this output.
    /// Returns true on success, false on failure.
    fn write_byte(&var self, b: u8) -> bool
}

// ============================================================================
// Ord Trait - Total Ordering
// ============================================================================

/// Ord provides total ordering for types where all values are comparable.
///
/// Unlike PartialOrd (which allows incomparable values like NaN), Ord
/// guarantees that any two values can be compared. This is required for
/// sorted collections, binary search, and min/max operations.
///
/// Contract:
/// - Antisymmetric: if a.cmp(&b) < 0 then b.cmp(&a) > 0
/// - Transitive: if a.cmp(&b) < 0 and b.cmp(&c) < 0 then a.cmp(&c) < 0
/// - Total: cmp always returns a valid ordering (never "incomparable")
///
/// Types that implement Ord:
/// - All integer types (u8, u16, u32, i8, i16, i32)
/// - bool (false < true)
/// - Str (lexicographic comparison)
/// - LibraryVersion (semantic versioning order)
///
/// Example implementation:
/// ```novus
/// impl Ord for LibraryVersion {
///     fn cmp(&self, other: &LibraryVersion) -> i32 {
///         if self.major != other.major {
///             return (i32)self.major - (i32)other.major
///         }
///         if self.minor != other.minor {
///             return (i32)self.minor - (i32)other.minor
///         }
///         return (i32)self.patch - (i32)other.patch
///     }
/// }
/// ```
///
/// Return value semantics:
/// - Negative: self < other
/// - Zero: self == other
/// - Positive: self > other
pub trait Ord {
    /// Compare self with other, returning ordering.
    /// Returns: negative if self < other, zero if equal, positive if self > other
    fn cmp(&self, other: &Self) -> i32
}

// ============================================================================
// Ord implementations for primitive types
// ============================================================================

// Ord for u8
impl Ord for u8 {
    fn cmp(&self, other: &u8) -> i32 {
        if *self < *other { return -1 }
        if *self > *other { return 1 }
        return 0
    }
}

// Ord for u16
impl Ord for u16 {
    fn cmp(&self, other: &u16) -> i32 {
        if *self < *other { return -1 }
        if *self > *other { return 1 }
        return 0
    }
}

// Ord for u32
impl Ord for u32 {
    fn cmp(&self, other: &u32) -> i32 {
        if *self < *other { return -1 }
        if *self > *other { return 1 }
        return 0
    }
}

// Ord for i8
impl Ord for i8 {
    fn cmp(&self, other: &i8) -> i32 {
        if *self < *other { return -1 }
        if *self > *other { return 1 }
        return 0
    }
}

// Ord for i16
impl Ord for i16 {
    fn cmp(&self, other: &i16) -> i32 {
        if *self < *other { return -1 }
        if *self > *other { return 1 }
        return 0
    }
}

// Ord for i32
impl Ord for i32 {
    fn cmp(&self, other: &i32) -> i32 {
        if *self < *other { return -1 }
        if *self > *other { return 1 }
        return 0
    }
}

// Ord for bool (false < true)
impl Ord for bool {
    fn cmp(&self, other: &bool) -> i32 {
        let a: i32 = if *self { 1 } else { 0 }
        let b: i32 = if *other { 1 } else { 0 }
        return a - b
    }
}

// Ord for LibraryVersion (semantic versioning order)
impl Ord for LibraryVersion {
    fn cmp(&self, other: &LibraryVersion) -> i32 {
        if self.major != other.major {
            return (i32)self.major - (i32)other.major
        }
        if self.minor != other.minor {
            return (i32)self.minor - (i32)other.minor
        }
        return (i32)self.patch - (i32)other.patch
    }
}

// ============================================================================
// Default - Provides a default value for a type
// ============================================================================

/// Default trait for types that have a sensible default value
///
/// This is used for:
/// - Initializing collections with default values
/// - Providing fallback values in generic code
/// - Struct field defaults with `..Default::default()` pattern
///
/// Example:
/// ```novus
/// impl Default for MyConfig {
///     fn default() -> MyConfig {
///         return MyConfig { timeout: 1000, retries: 3 }
///     }
/// }
///
/// let config = MyConfig::default()
/// ```
pub trait Default {
    fn default() -> Self
}

// Default implementations for primitive types
impl Default for u8 {
    fn default() -> u8 { return 0u8 }
}

impl Default for u16 {
    fn default() -> u16 { return 0u16 }
}

impl Default for u32 {
    fn default() -> u32 { return 0u32 }
}

impl Default for i8 {
    fn default() -> i8 { return 0i8 }
}

impl Default for i16 {
    fn default() -> i16 { return 0i16 }
}

impl Default for i32 {
    fn default() -> i32 { return 0i32 }
}

impl Default for bool {
    fn default() -> bool { return false }
}

// Default for Option<T> is None
impl<T> Default for Option<T> {
    fn default() -> Option<T> { return Option::None }
}

// ============================================================================
// Into<T> - Consuming type conversion (complement to From<T>)
// ============================================================================

/// Into trait for consuming type conversions
///
/// This is the complement to `From<T>`. If you implement `From<T>`,
/// you get `Into<U>` for free via the blanket implementation.
///
/// Prefer implementing `From<T>` over `Into<T>` because:
/// - `From<T>` is more flexible (can be used with type inference)
/// - The blanket impl provides `Into` automatically
///
/// Example:
/// ```novus
/// // If you have: impl From<Str> for String
/// // You automatically get: impl Into<String> for Str
///
/// fn takes_string(s: String) { ... }
/// let my_str: Str = "hello"
/// takes_string(my_str.into())  // Converts via Into
/// ```
pub trait Into<T> {
    fn into(consuming self) -> T
}

// ============================================================================
// Zero and One - Numeric identity elements
// ============================================================================

/// Zero trait for types with an additive identity (0)
///
/// Used in generic numeric algorithms like sum, accumulation, etc.
///
/// Example:
/// ```novus
/// fn sum<T: Zero + Add>(values: &[T]) -> T {
///     var total = T::zero()
///     for v in values { total = total + v }
///     return total
/// }
/// ```
pub trait Zero {
    fn zero() -> Self
    fn is_zero(&self) -> bool
}

/// One trait for types with a multiplicative identity (1)
///
/// Used in generic numeric algorithms like product, counting, etc.
///
/// Example:
/// ```novus
/// fn product<T: One + Mul>(values: &[T]) -> T {
///     var total = T::one()
///     for v in values { total = total * v }
///     return total
/// }
/// ```
pub trait One {
    fn one() -> Self
}

// Zero implementations for numeric types
impl Zero for u8 {
    fn zero() -> u8 { return 0u8 }
    fn is_zero(&self) -> bool { return *self == 0u8 }
}

impl Zero for u16 {
    fn zero() -> u16 { return 0u16 }
    fn is_zero(&self) -> bool { return *self == 0u16 }
}

impl Zero for u32 {
    fn zero() -> u32 { return 0u32 }
    fn is_zero(&self) -> bool { return *self == 0u32 }
}

impl Zero for i8 {
    fn zero() -> i8 { return 0i8 }
    fn is_zero(&self) -> bool { return *self == 0i8 }
}

impl Zero for i16 {
    fn zero() -> i16 { return 0i16 }
    fn is_zero(&self) -> bool { return *self == 0i16 }
}

impl Zero for i32 {
    fn zero() -> i32 { return 0i32 }
    fn is_zero(&self) -> bool { return *self == 0i32 }
}

// One implementations for numeric types
impl One for u8 {
    fn one() -> u8 { return 1u8 }
}

impl One for u16 {
    fn one() -> u16 { return 1u16 }
}

impl One for u32 {
    fn one() -> u32 { return 1u32 }
}

impl One for i8 {
    fn one() -> i8 { return 1i8 }
}

impl One for i16 {
    fn one() -> i16 { return 1i16 }
}

impl One for i32 {
    fn one() -> i32 { return 1i32 }
}

// ============================================================================
// Bounded - Min/max values for numeric types
// ============================================================================

/// Bounded trait for types with defined minimum and maximum values
///
/// Used for:
/// - Overflow checking
/// - Range validation
/// - Generic clamping functions
///
/// Example:
/// ```novus
/// fn clamp<T: Ord + Bounded>(value: T, min: T, max: T) -> T {
///     if value < min { return min }
///     if value > max { return max }
///     return value
/// }
/// ```
pub trait Bounded {
    fn min_value() -> Self
    fn max_value() -> Self
}

// Bounded implementations for numeric types
impl Bounded for u8 {
    fn min_value() -> u8 { return 0u8 }
    fn max_value() -> u8 { return 255u8 }
}

impl Bounded for u16 {
    fn min_value() -> u16 { return 0u16 }
    fn max_value() -> u16 { return 65535u16 }
}

impl Bounded for u32 {
    fn min_value() -> u32 { return 0u32 }
    fn max_value() -> u32 { return 4294967295u32 }
}

impl Bounded for i8 {
    fn min_value() -> i8 { return -128i8 }
    fn max_value() -> i8 { return 127i8 }
}

impl Bounded for i16 {
    fn min_value() -> i16 { return -32768i16 }
    fn max_value() -> i16 { return 32767i16 }
}

impl Bounded for i32 {
    fn min_value() -> i32 { return -2147483648i32 }
    fn max_value() -> i32 { return 2147483647i32 }
}

// ============================================================================
// Extend<T> - Extend a collection with elements from an iterator
// ============================================================================

/// Extend trait for adding multiple elements to a collection
///
/// This provides a standardized way to add elements from any iterator
/// to a collection.
///
/// Example:
/// ```novus
/// var vec1 = Vec::new()
/// vec1.push(1)
/// vec1.push(2)
///
/// var vec2 = Vec::new()
/// vec2.push(3)
/// vec2.push(4)
///
/// vec1.extend_from_ptr(&vec2.as_ptr(), vec2.len())  // vec1 is now [1, 2, 3, 4]
/// ```
pub trait Extend<T> {
    /// Extend the collection with elements from the given pointer and count
    /// Returns true if all elements were added successfully
    fn extend_from_ptr(&var self, source: *T, count: u32) -> bool
}

// ============================================================================
// FromIterator<T> - Build a collection from an iterator
// ============================================================================

/// FromIterator trait for building collections from an array/slice
///
/// This enables creating collections from existing arrays.
///
/// Example:
/// ```novus
/// // When implemented for Vec<T>:
/// let numbers = Vec::<i32>::from_slice(&arr[0], arr.len())
/// ```
pub trait FromIterator<T> {
    /// Create a collection from a pointer and count
    /// Returns None if allocation fails
    fn from_slice(ptr: *T, count: u32) -> Option<Self>
}

// ============================================================================
// TryFrom<T> and TryInto<T> - Fallible type conversions
// ============================================================================

/// TryFrom trait for fallible type conversions
///
/// Use this when a conversion might fail (e.g., parsing strings,
/// narrowing numeric conversions). The error type E is a trait parameter.
///
/// Example:
/// ```novus
/// impl TryFrom<Str, ParseError> for i32 {
///     fn try_from(s: Str) -> Result<i32, ParseError> {
///         return s.parse_i32()
///     }
/// }
///
/// let num: Result<i32, ParseError> = i32::try_from("42")
/// ```
pub trait TryFrom<T, E> {
    /// Attempt to convert from T to Self
    fn try_from(value: T) -> Result<Self, E>
}

/// TryInto trait for fallible consuming conversions
///
/// This is the consuming counterpart to TryFrom.
/// The error type E is a trait parameter.
///
/// Example:
/// ```novus
/// let s: Str = "42"
/// let num: Result<i32, ParseError> = s.try_into()
/// ```
pub trait TryInto<T, E> {
    /// Attempt to convert self into T
    fn try_into(consuming self) -> Result<T, E>
}

// ============================================================================
// Error - Standard error trait
// ============================================================================

/// Error trait for standardized error handling
///
/// All error types in the stdlib should implement this trait to provide
/// consistent error messages via C-style null-terminated strings.
///
/// Example:
/// ```novus
/// impl Error for DosError {
///     fn message(&self) -> *u8 {
///         match *self {
///             DosError::NotFound => return "File not found",
///             _ => return "Unknown error"
///         }
///     }
/// }
/// ```
pub trait Error {
    /// Get a C-style error message pointer (null-terminated)
    fn message(&self) -> *u8
}

// ============================================================================
// Fn, FnMut, FnOnce - Closure/function traits
// ============================================================================

/// FnOnce trait for callables that can be called at least once
///
/// This is the most general function trait. All closures and function
/// pointers implement FnOnce. Closures that capture by move implement
/// only FnOnce.
///
/// Example:
/// ```novus
/// fn call_once<F: FnOnce() -> i32>(f: F) -> i32 {
///     return f()
/// }
/// ```
pub trait FnOnce<Args, Output> {
    /// Call the function, consuming it
    fn call_once(consuming self, args: Args) -> Output
}

/// FnMut trait for callables that can be called multiple times with mutation
///
/// Closures that capture variables by mutable reference implement FnMut.
/// Conceptually FnMut is a subtrait of FnOnce (any FnMut can be called once).
///
/// Example:
/// ```novus
/// fn call_mut<F: FnMut() -> i32>(f: &var F) -> i32 {
///     return f()
/// }
/// ```
pub trait FnMut<Args, Output> {
    /// Call the function, potentially mutating captured state
    fn call_mut(&var self, args: Args) -> Output
}

/// Fn trait for callables that can be called multiple times without mutation
///
/// Closures that capture only by shared reference implement Fn.
/// Conceptually Fn is the most restrictive (any Fn can be used as FnMut or FnOnce).
///
/// Example:
/// ```novus
/// fn call_fn<F: Fn() -> i32>(f: &F) -> i32 {
///     return f()
/// }
/// ```
pub trait Fn<Args, Output> {
    /// Call the function
    fn call(&self, args: Args) -> Output
}
