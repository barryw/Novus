// Novus Standard Library - Core Types
// Namespace: std::core
// Generic enums for safe error handling and optional values

// Option<T> - represents an optional value
// Use this instead of null pointers!
pub enum Option<T> {
    Some(T),
    None,
}

impl<T> Option<T> {
    /// Create an Option from a pointer
    /// Returns Some(ptr) if ptr is non-null, None otherwise
    ///
    /// Example:
    /// ```novus
    /// let block_opt = MemoryBlock::alloc(1024, MEMF_FAST)
    /// match block_opt {
    ///     Some(block) => return Option::FromPointer(block.ptr()),
    ///     None => return Option::None
    /// }
    /// ```
    pub fn FromPointer(ptr: *T) -> Option<*T> {
        if let p = ptr {
            return Option::Some(p)
        }
        return Option::None
    }
}

// Result<T, E> - represents success or failure
// Use this for functions that can fail!
pub enum Result<T, E> {
    Ok(T),
    Err(E),
}

// LibraryVersion - semantic version information for AmigaOS libraries
// Represents a version in major.minor.patch format (semver)
pub struct LibraryVersion {
    major: u16,
    minor: u16,
    patch: u16,
}

impl LibraryVersion {
    /// Create a new LibraryVersion
    pub fn new(major: u16, minor: u16, patch: u16) -> LibraryVersion {
        return LibraryVersion { major: major, minor: minor, patch: patch }
    }

    /// Get the major version number
    pub fn major(self) -> u16 {
        return self.major
    }

    /// Get the minor version number
    pub fn minor(self) -> u16 {
        return self.minor
    }

    /// Get the patch version number
    pub fn patch(self) -> u16 {
        return self.patch
    }
}

// Note: For AmigaOS error types, see std/error.novus
// - DosError for file/disk operations
// - ExecError for memory/tasks/signals
// - IntuitionError for GUI operations
// - GraphicsError for graphics operations
// - NovusError for multi-subsystem errors

// Note: For collections like Vec, see std/collections.novus
// Note: For memory management, see std/mem.novus (MemoryBlock, Allocation<T>, Box<T>)

// ============================================================================
// Iterable Trait - Foundation for For-In Loops
// ============================================================================

// Iterable<T> - allows types to be used in for-in loops
// Types implementing this trait can be iterated over with: for item in collection { ... }
//
// Requirements:
// - get(index: u32) -> Option<T>: Access element at index, returns None if out of bounds
// - len() -> u32: Total number of elements in the collection
//
// Example implementation:
// ```novus
// impl<T> Iterable<T> for Vec<T> {
//     fn get(&self, index: u32) -> Option<T> { ... }
//     fn len(&self) -> u32 { ... }
// }
// ```
pub trait Iterable<T> {
    fn get(&self, index: u32) -> Option<T>
    fn len(&self) -> u32
}

// ============================================================================
// From Trait - Automatic Type Conversions
// ============================================================================

// From<T> - enables automatic type conversions
// Primary use case: automatic error conversions with the ? operator
//
// When you implement From<SourceType> for TargetType, the compiler automatically
// converts SourceType to TargetType when needed (e.g., in ? operator error propagation)
//
// Requirements:
// - convert(value: T) -> Self: Convert from T to Self
//
// Note: We use 'convert' instead of 'from' because 'from' is a keyword in Novus
// (used in import statements: `from std::core import Option`)
//
// Example implementation:
// ```novus
// impl From<DosError> for NovusError {
//     fn convert(err: DosError) -> NovusError {
//         return NovusError::Dos(err)
//     }
// }
//
// // Now the ? operator can automatically convert DosError to NovusError:
// fn foo() -> Result<i32, NovusError> {
//     let file = open_file("test.txt")?  // Returns Result<File, DosError>
//     // If open_file returns Err(dos_err), ? automatically calls
//     // NovusError::convert(dos_err) and returns Err(converted_error)
//     return Ok(42)
// }
// ```
pub trait From<T> {
    fn convert(value: T) -> Self
}
