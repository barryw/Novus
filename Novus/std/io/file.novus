// io.novus - High-level I/O for Amiga DOS
// Namespace: std::io

from std::ffi::dos import VPrintf, Input, WaitForChar, Read

// Printf-style formatted output using AmigaOS VPrintf
// Format string uses AmigaOS RawDoFmt syntax:
//   %d   - signed decimal (16-bit word)
//   %ld  - signed decimal (32-bit long)
//   %u   - unsigned decimal (16-bit word)
//   %lu  - unsigned decimal (32-bit long)
//   %x   - hexadecimal (lowercase)
//   %X   - hexadecimal (uppercase)
//   %s   - null-terminated string
//   %c   - character
//   %b   - BSTR (BPTR to byte-counted string)
//
// Note: All numeric args are passed as 32-bit values on the stack,
// so use 'l' prefix for proper formatting (e.g., "%ld" not "%d")
//
// Variadic version - provided by runtime assembly (novus_io.s)
// This is the primary printf-style write function
extern fn write(format: *u8, ...args) -> i32

// Array-based version - pure Novus implementation
// Use this when building args programmatically or calling from pure Novus code
//
// Example:
//   let args: [i32; 3] = [version.major() as i32, version.minor() as i32, version.patch() as i32]
//   write_array("Version: %ld.%ld.%ld\n", &args)
//
pub fn write_array(format: *u8, args: *i32) -> i32 {
    let mut result: i32 = 0
    unsafe {
        result = VPrintf(format, args)
    }
    return result
}

/// Wait for a keypress from the console
///
/// Blocks until the user presses a key, then discards it.
/// Useful for "press any key to continue" prompts.
pub fn wait_for_key() {
    let input_handle = Input()
    WaitForChar(input_handle, -1)
    // Read and discard the character
    let mut buf: [u8; 1] = [0]
    Read(input_handle, &buf[0], 1)
}

/// Check if a key has been pressed (non-blocking)
///
/// Returns true if a key is available, false otherwise.
/// Does NOT consume the key - call read_key() to get it.
pub fn key_pressed() -> bool {
    let input_handle = Input()
    // WaitForChar with timeout 0 returns immediately
    // Returns non-zero if character is available
    return WaitForChar(input_handle, 0) != 0
}

/// Read a single key (blocking)
///
/// Waits for and returns the next key pressed.
pub fn read_key() -> u8 {
    let input_handle = Input()
    WaitForChar(input_handle, -1)
    let mut buf: [u8; 1] = [0]
    Read(input_handle, &buf[0], 1)
    return buf[0]
}

/// Print a null-terminated C string to stdout
///
/// Simple wrapper around write() for printing strings without formatting.
pub fn print(s: *u8) {
    write(s)
}

/// Print a null-terminated C string to stdout with newline
///
/// Simple wrapper around write() for printing strings with newline.
pub fn println(s: *u8) {
    write(s)
    write("\n")
}
