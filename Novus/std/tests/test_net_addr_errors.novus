from std::core import Option, Result
from std::net::addr import *
from std::net::errors import NetError
from std::net::socket import SocketLibrary
from std::test::test import expect

// @covers std::net::addr::AddrParseError::message()
// @covers std::net::addr::Cidr::address_count()
// @covers std::net::addr::Cidr::broadcast()
// @covers std::net::addr::Cidr::contains(Ipv4Addr)
// @covers std::net::addr::Cidr::format(*u8)
// @covers std::net::addr::Cidr::host_count()
// @covers std::net::addr::Cidr::ip()
// @covers std::net::addr::Cidr::is_private()
// @covers std::net::addr::Cidr::link_local()
// @covers std::net::addr::Cidr::loopback()
// @covers std::net::addr::Cidr::netmask()
// @covers std::net::addr::Cidr::network()
// @covers std::net::addr::Cidr::new(Ipv4Addr, u8)
// @covers std::net::addr::Cidr::prefix_len()
// @covers std::net::addr::Cidr::private_class_a()
// @covers std::net::addr::Cidr::private_class_b()
// @covers std::net::addr::Cidr::private_class_c()
// @covers std::net::addr::Ipv4Addr::any()
// @covers std::net::addr::Ipv4Addr::broadcast()
// @covers std::net::addr::Ipv4Addr::format(*u8)
// @covers std::net::addr::Ipv4Addr::from_in_addr(in_addr)
// @covers std::net::addr::Ipv4Addr::from_network_order(u32)
// @covers std::net::addr::Ipv4Addr::from_u32(u32)
// @covers std::net::addr::Ipv4Addr::in_cidr(Cidr)
// @covers std::net::addr::Ipv4Addr::is_any()
// @covers std::net::addr::Ipv4Addr::is_broadcast()
// @covers std::net::addr::Ipv4Addr::is_documentation()
// @covers std::net::addr::Ipv4Addr::is_global()
// @covers std::net::addr::Ipv4Addr::is_link_local()
// @covers std::net::addr::Ipv4Addr::is_loopback()
// @covers std::net::addr::Ipv4Addr::is_multicast()
// @covers std::net::addr::Ipv4Addr::is_private()
// @covers std::net::addr::Ipv4Addr::is_reserved()
// @covers std::net::addr::Ipv4Addr::localhost()
// @covers std::net::addr::Ipv4Addr::new(u8, u8, u8, u8)
// @covers std::net::addr::Ipv4Addr::octets()
// @covers std::net::addr::Ipv4Addr::parse(*u8)
// @covers std::net::addr::Ipv4Addr::to_in_addr()
// @covers std::net::addr::Ipv4Addr::to_network_order()
// @covers std::net::addr::Ipv4Addr::to_u32()
// @covers std::net::addr::Ipv4Addr::try_parse(*u8)
// @covers std::net::addr::SocketAddr::is_ipv4()
// @covers std::net::addr::SocketAddr::new_v4(Ipv4Addr, u16)
// @covers std::net::addr::SocketAddr::port()
// @covers std::net::addr::SocketAddrV4::from_sockaddr_in(sockaddr_in)
// @covers std::net::addr::SocketAddrV4::ip()
// @covers std::net::addr::SocketAddrV4::new(Ipv4Addr, u16)
// @covers std::net::addr::SocketAddrV4::port()
// @covers std::net::addr::SocketAddrV4::set_ip(Ipv4Addr)
// @covers std::net::addr::SocketAddrV4::set_port(u16)
// @covers std::net::addr::SocketAddrV4::to_sockaddr_in()
@test("network address public API")
pub fn test_network_address_public_api() {
    let ip = Ipv4Addr::new(192, 168, 1, 42)
    expect(ip.to_u32() == 0xC0A8012A, "integer conversion")
    let _ = Ipv4Addr::from_u32(ip.to_u32())
    let _ = Ipv4Addr::from_network_order(ip.to_network_order())
    let _ = Ipv4Addr::from_in_addr(ip.to_in_addr())
    let _ = ip.octets()
    let _ = Ipv4Addr::localhost()
    let _ = Ipv4Addr::any()
    let _ = Ipv4Addr::broadcast()
    let _ = ip.is_loopback()
    let _ = ip.is_any()
    let _ = ip.is_broadcast()
    let _ = ip.is_private()
    let _ = Ipv4Addr::new(224, 0, 0, 1).is_multicast()
    let _ = Ipv4Addr::new(169, 254, 1, 1).is_link_local()
    let _ = Ipv4Addr::new(192, 0, 2, 1).is_documentation()
    let _ = Ipv4Addr::new(240, 0, 0, 1).is_reserved()
    let _ = Ipv4Addr::new(8, 8, 8, 8).is_global()
    var ip_buf: [u8] = [0; 16]
    let _ = ip.format((*u8)&ip_buf[0])

    let cidr = Cidr::new(ip, 24)
    let _ = cidr.ip()
    let _ = cidr.prefix_len()
    let _ = cidr.network()
    let _ = cidr.broadcast()
    let _ = cidr.netmask()
    let _ = cidr.contains(ip)
    let _ = ip.in_cidr(cidr)
    let _ = cidr.host_count()
    let _ = cidr.address_count()
    let _ = cidr.is_private()
    let _ = Cidr::private_class_a()
    let _ = Cidr::private_class_b()
    let _ = Cidr::private_class_c()
    let _ = Cidr::loopback()
    let _ = Cidr::link_local()
    var cidr_buf: [u8] = [0; 20]
    let _ = cidr.format((*u8)&cidr_buf[0])

    var v4 = SocketAddrV4::new(ip, 1234)
    let _ = v4.ip()
    let _ = v4.port()
    v4.set_ip(Ipv4Addr::localhost())
    v4.set_port(4321)
    let raw = v4.to_sockaddr_in()
    let _ = SocketAddrV4::from_sockaddr_in(raw)
    let socket_addr = SocketAddr::new_v4(ip, 1234)
    let _ = socket_addr.port()
    let _ = socket_addr.is_ipv4()

    match SocketLibrary::init() {
        Result::Ok(_library) => {
            expect(Ipv4Addr::parse("127.0.0.1").is_ok(), "parse")
            expect(Ipv4Addr::try_parse("not-an-address").is_none(), "try parse")
        },
        Result::Err(_) => {
            expect(Ipv4Addr::parse("127.0.0.1").is_err(), "missing stack")
            expect(Ipv4Addr::try_parse("127.0.0.1").is_none(), "missing stack optional parse")
        }
    }

    let invalid = AddrParseError::InvalidAddress
    let _ = invalid.message()
}

// @covers std::net::errors::NetError::errno()
// @covers std::net::errors::NetError::from_errno(i32)
// @covers std::net::errors::NetError::from_h_errno(i32)
// @covers std::net::errors::NetError::is_transient()
// @covers std::net::errors::NetError::last()
// @covers std::net::errors::NetError::message()
// @covers std::net::errors::NetError::would_block()
@test("network error public API")
pub fn test_network_error_public_api() {
    let would_block = NetError::WouldBlock
    expect(would_block.would_block() && would_block.is_transient(), "transient")
    let other = NetError::from_errno(12345)
    expect(other.errno() == 12345, "errno round trip")
    let _ = NetError::from_h_errno(1)
    let _ = NetError::last()
    let _ = NetError::ConnectionRefused.message()
}
