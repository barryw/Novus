from std::math::fixed import *
from std::test::test import expect

// @covers std::math::fixed::Fixed16::abs()
// @covers std::math::fixed::Fixed16::add(Fixed16)
// @covers std::math::fixed::Fixed16::clamp(Fixed16, Fixed16)
// @covers std::math::fixed::Fixed16::cmp(Fixed16)
// @covers std::math::fixed::Fixed16::div(Fixed16)
// @covers std::math::fixed::Fixed16::eq(Fixed16)
// @covers std::math::fixed::Fixed16::fractional_part()
// @covers std::math::fixed::Fixed16::from_i8(i8)
// @covers std::math::fixed::Fixed16::from_raw(i16)
// @covers std::math::fixed::Fixed16::gt(Fixed16)
// @covers std::math::fixed::Fixed16::integer_part()
// @covers std::math::fixed::Fixed16::is_negative()
// @covers std::math::fixed::Fixed16::is_zero()
// @covers std::math::fixed::Fixed16::lt(Fixed16)
// @covers std::math::fixed::Fixed16::max(Fixed16)
// @covers std::math::fixed::Fixed16::min(Fixed16)
// @covers std::math::fixed::Fixed16::mul(Fixed16)
// @covers std::math::fixed::Fixed16::mul_i8(i8)
// @covers std::math::fixed::Fixed16::neg()
// @covers std::math::fixed::Fixed16::one()
// @covers std::math::fixed::Fixed16::sub(Fixed16)
// @covers std::math::fixed::Fixed16::to_i8()
// @covers std::math::fixed::Fixed16::to_i8_rounded()
// @covers std::math::fixed::Fixed16::to_raw()
// @covers std::math::fixed::Fixed16::zero()
// @covers std::math::fixed::Fixed32::abs()
// @covers std::math::fixed::Fixed32::add(Fixed32)
// @covers std::math::fixed::Fixed32::ceil()
// @covers std::math::fixed::Fixed32::clamp(Fixed32, Fixed32)
// @covers std::math::fixed::Fixed32::cmp(Fixed32)
// @covers std::math::fixed::Fixed32::div(Fixed32)
// @covers std::math::fixed::Fixed32::div_i32(i32)
// @covers std::math::fixed::Fixed32::eq(Fixed32)
// @covers std::math::fixed::Fixed32::floor()
// @covers std::math::fixed::Fixed32::fractional_part()
// @covers std::math::fixed::Fixed32::from_i16(i16)
// @covers std::math::fixed::Fixed32::from_i32(i32)
// @covers std::math::fixed::Fixed32::from_parts(i16, u16)
// @covers std::math::fixed::Fixed32::from_raw(i32)
// @covers std::math::fixed::Fixed32::ge(Fixed32)
// @covers std::math::fixed::Fixed32::gt(Fixed32)
// @covers std::math::fixed::Fixed32::integer_part()
// @covers std::math::fixed::Fixed32::is_negative()
// @covers std::math::fixed::Fixed32::is_positive()
// @covers std::math::fixed::Fixed32::is_zero()
// @covers std::math::fixed::Fixed32::le(Fixed32)
// @covers std::math::fixed::Fixed32::lt(Fixed32)
// @covers std::math::fixed::Fixed32::max(Fixed32)
// @covers std::math::fixed::Fixed32::min(Fixed32)
// @covers std::math::fixed::Fixed32::mul(Fixed32)
// @covers std::math::fixed::Fixed32::mul_i32(i32)
// @covers std::math::fixed::Fixed32::neg()
// @covers std::math::fixed::Fixed32::one()
// @covers std::math::fixed::Fixed32::round()
// @covers std::math::fixed::Fixed32::sub(Fixed32)
// @covers std::math::fixed::Fixed32::to_i32()
// @covers std::math::fixed::Fixed32::to_i32_rounded()
// @covers std::math::fixed::Fixed32::to_raw()
// @covers std::math::fixed::Fixed32::zero()
// @covers std::math::fixed::fixed16_to_fixed32(Fixed16)
// @covers std::math::fixed::fixed32_half_pi()
// @covers std::math::fixed::fixed32_inv_pi()
// @covers std::math::fixed::fixed32_inv_sqrt2()
// @covers std::math::fixed::fixed32_pi()
// @covers std::math::fixed::fixed32_quarter_pi()
// @covers std::math::fixed::fixed32_sqrt2()
// @covers std::math::fixed::fixed32_to_fixed16(Fixed32)
// @covers std::math::fixed::fixed32_two_pi()
@test("fixed-point public API")
pub fn test_fixed_point_public_api() {
    let a = Fixed32::from_i32(2)
    let b = Fixed32::from_parts(1, 32768)
    let _ = Fixed32::from_raw(1)
    let _ = Fixed32::from_i16(2)
    expect(a.to_i32() == 2, "conversion")
    let _ = a.to_raw()
    let _ = b.to_i32_rounded()
    let _ = Fixed32::zero()
    let _ = Fixed32::one()
    let _ = b.integer_part()
    let _ = b.fractional_part()
    let _ = a.is_zero()
    let _ = a.is_negative()
    let _ = a.is_positive()
    let _ = a.add(b)
    let _ = a.sub(b)
    let _ = a.neg()
    let _ = a.abs()
    let _ = a.mul(b)
    let _ = a.mul_i32(2)
    let _ = a.div(b)
    let _ = a.div_i32(2)
    let _ = a.cmp(b)
    let _ = a.eq(b)
    let _ = a.lt(b)
    let _ = a.gt(b)
    let _ = a.le(b)
    let _ = a.ge(b)
    let _ = a.min(b)
    let _ = a.max(b)
    let _ = a.clamp(Fixed32::zero(), Fixed32::one())
    let _ = b.floor()
    let _ = b.ceil()
    let _ = b.round()

    let x = Fixed16::from_i8(2)
    let y = Fixed16::from_raw(384)
    let _ = x.to_raw()
    let _ = y.to_i8()
    let _ = y.to_i8_rounded()
    let _ = Fixed16::zero()
    let _ = Fixed16::one()
    let _ = y.integer_part()
    let _ = y.fractional_part()
    let _ = x.is_zero()
    let _ = x.is_negative()
    let _ = x.add(y)
    let _ = x.sub(y)
    let _ = x.neg()
    let _ = x.abs()
    let _ = x.mul(y)
    let _ = x.mul_i8(2)
    let _ = x.div(y)
    let _ = x.cmp(y)
    let _ = x.eq(y)
    let _ = x.lt(y)
    let _ = x.gt(y)
    let _ = x.min(y)
    let _ = x.max(y)
    let _ = x.clamp(Fixed16::zero(), Fixed16::one())

    let _ = fixed16_to_fixed32(x)
    let _ = fixed32_to_fixed16(a)
    let _ = fixed32_pi()
    let _ = fixed32_two_pi()
    let _ = fixed32_half_pi()
    let _ = fixed32_quarter_pi()
    let _ = fixed32_inv_pi()
    let _ = fixed32_sqrt2()
    let _ = fixed32_inv_sqrt2()
}
