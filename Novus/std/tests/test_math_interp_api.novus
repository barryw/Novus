from std::math::fixed import Fixed32
from std::math::interp import *
from std::test::test import expect

// @covers std::math::interp::bezier_cubic(Fixed32, Fixed32, Fixed32, Fixed32, Fixed32)
// @covers std::math::interp::bezier_quadratic(Fixed32, Fixed32, Fixed32, Fixed32)
// @covers std::math::interp::damp(Fixed32, Fixed32, Fixed32)
// @covers std::math::interp::inv_lerp(Fixed32, Fixed32, Fixed32)
// @covers std::math::interp::lerp(Fixed32, Fixed32, Fixed32)
// @covers std::math::interp::lerp_clamped(Fixed32, Fixed32, Fixed32)
// @covers std::math::interp::lerp_i32(i32, i32, Fixed32)
// @covers std::math::interp::move_towards(Fixed32, Fixed32, Fixed32)
// @covers std::math::interp::move_towards_i32(i32, i32, i32)
// @covers std::math::interp::ping_pong(Fixed32, Fixed32)
// @covers std::math::interp::remap(Fixed32, Fixed32, Fixed32, Fixed32, Fixed32)
// @covers std::math::interp::repeat(Fixed32, Fixed32)
// @covers std::math::interp::smootherstep(Fixed32)
// @covers std::math::interp::smoothstep(Fixed32)
// @covers std::math::interp::smoothstep_range(Fixed32, Fixed32, Fixed32)
// @covers std::math::interp::spring_damp(Fixed32, Fixed32, &var Fixed32, Fixed32, Fixed32)
// @covers std::math::interp::step(Fixed32, Fixed32)
// @covers std::math::interp::step_i32(i32, i32)
@test("interpolation public API")
pub fn test_interpolation_public_api() {
    let zero = Fixed32::zero()
    let one = Fixed32::one()
    let half = Fixed32::from_raw(32768)
    expect(lerp(zero, one, half).to_raw() == 32768, "lerp")
    let _ = lerp_i32(0, 10, half)
    let _ = inv_lerp(zero, one, half)
    let _ = remap(half, zero, one, zero, one)
    let _ = smoothstep(half)
    let _ = smoothstep_range(zero, one, half)
    let _ = smootherstep(half)
    let _ = step(half, one)
    let _ = step_i32(5, 7)
    let _ = lerp_clamped(zero, one, half)
    let _ = move_towards(zero, one, half)
    let _ = move_towards_i32(0, 10, 2)
    let _ = damp(zero, one, half)
    var velocity = Fixed32::zero()
    let _ = spring_damp(zero, one, &var velocity, half, half)
    let _ = bezier_quadratic(zero, half, one, half)
    let _ = bezier_cubic(zero, half, half, one, half)
    let _ = ping_pong(half, one)
    let _ = repeat(half, one)
}
