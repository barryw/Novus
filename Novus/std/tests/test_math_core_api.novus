from std::math::core import *
from std::test::test import expect

// @covers std::math::core::abs(i16)
// @covers std::math::core::abs(i32)
// @covers std::math::core::abs(i8)
// @covers std::math::core::abs_i16(i16)
// @covers std::math::core::abs_i32(i32)
// @covers std::math::core::abs_i8(i8)
// @covers std::math::core::clamp(i32, i32, i32)
// @covers std::math::core::clamp(u32, u32, u32)
// @covers std::math::core::clamp_i16(i16, i16, i16)
// @covers std::math::core::clamp_i32(i32, i32, i32)
// @covers std::math::core::clamp_i8(i8, i8, i8)
// @covers std::math::core::clamp_u16(u16, u16, u16)
// @covers std::math::core::clamp_u32(u32, u32, u32)
// @covers std::math::core::clamp_u8(u8, u8, u8)
// @covers std::math::core::diff(i16, i16)
// @covers std::math::core::diff(i32, i32)
// @covers std::math::core::diff(u16, u16)
// @covers std::math::core::diff(u32, u32)
// @covers std::math::core::diff_i16(i16, i16)
// @covers std::math::core::diff_i32(i32, i32)
// @covers std::math::core::diff_u16(u16, u16)
// @covers std::math::core::diff_u32(u32, u32)
// @covers std::math::core::div_ceil(u16, u16)
// @covers std::math::core::div_ceil(u32, u32)
// @covers std::math::core::div_ceil_u16(u16, u16)
// @covers std::math::core::div_ceil_u32(u32, u32)
// @covers std::math::core::div_round(u16, u16)
// @covers std::math::core::div_round(u32, u32)
// @covers std::math::core::div_round_u16(u16, u16)
// @covers std::math::core::div_round_u32(u32, u32)
// @covers std::math::core::is_power_of_two(u16)
// @covers std::math::core::is_power_of_two(u32)
// @covers std::math::core::is_power_of_two_u16(u16)
// @covers std::math::core::is_power_of_two_u32(u32)
// @covers std::math::core::max(i16, i16)
// @covers std::math::core::max(i32, i32)
// @covers std::math::core::max(u16, u16)
// @covers std::math::core::max(u32, u32)
// @covers std::math::core::max_i16(i16, i16)
// @covers std::math::core::max_i32(i32, i32)
// @covers std::math::core::max_i8(i8, i8)
// @covers std::math::core::max_u16(u16, u16)
// @covers std::math::core::max_u32(u32, u32)
// @covers std::math::core::max_u8(u8, u8)
// @covers std::math::core::min(i16, i16)
// @covers std::math::core::min(i32, i32)
// @covers std::math::core::min(u16, u16)
// @covers std::math::core::min(u32, u32)
// @covers std::math::core::min_i16(i16, i16)
// @covers std::math::core::min_i32(i32, i32)
// @covers std::math::core::min_i8(i8, i8)
// @covers std::math::core::min_u16(u16, u16)
// @covers std::math::core::min_u32(u32, u32)
// @covers std::math::core::min_u8(u8, u8)
// @covers std::math::core::next_power_of_two(u16)
// @covers std::math::core::next_power_of_two(u32)
// @covers std::math::core::next_power_of_two_u16(u16)
// @covers std::math::core::next_power_of_two_u32(u32)
// @covers std::math::core::sign(i32)
// @covers std::math::core::sign_i16(i16)
// @covers std::math::core::sign_i32(i32)
// @covers std::math::core::sign_i8(i8)
@test("integer math public API")
pub fn test_integer_math_public_api() {
    expect(abs((i32)-7) == 7, "absolute value")
    let _ = abs((i16)-7)
    let _ = abs((i8)-7)
    let _ = abs_i32(-7)
    let _ = abs_i16(-7)
    let _ = abs_i8(-7)
    let _ = min((i32)1, (i32)2)
    let _ = min((i16)1, (i16)2)
    let _ = min((u32)1, (u32)2)
    let _ = min((u16)1, (u16)2)
    let _ = min_i32(1, 2)
    let _ = min_i16(1, 2)
    let _ = min_i8(1, 2)
    let _ = min_u32(1, 2)
    let _ = min_u16(1, 2)
    let _ = min_u8(1, 2)
    let _ = max((i32)1, (i32)2)
    let _ = max((i16)1, (i16)2)
    let _ = max((u32)1, (u32)2)
    let _ = max((u16)1, (u16)2)
    let _ = max_i32(1, 2)
    let _ = max_i16(1, 2)
    let _ = max_i8(1, 2)
    let _ = max_u32(1, 2)
    let _ = max_u16(1, 2)
    let _ = max_u8(1, 2)
    let _ = clamp((i32)2, (i32)1, (i32)3)
    let _ = clamp((u32)2, (u32)1, (u32)3)
    let _ = clamp_i32(2, 1, 3)
    let _ = clamp_i16(2, 1, 3)
    let _ = clamp_i8(2, 1, 3)
    let _ = clamp_u32(2, 1, 3)
    let _ = clamp_u16(2, 1, 3)
    let _ = clamp_u8(2, 1, 3)
    let _ = sign(7)
    let _ = sign_i32(7)
    let _ = sign_i16(7)
    let _ = sign_i8(7)
    let _ = is_power_of_two((u32)8)
    let _ = is_power_of_two((u16)8)
    let _ = is_power_of_two_u32(8)
    let _ = is_power_of_two_u16(8)
    let _ = next_power_of_two((u32)7)
    let _ = next_power_of_two((u16)7)
    let _ = next_power_of_two_u32(7)
    let _ = next_power_of_two_u16(7)
    let _ = div_ceil((u32)7, (u32)3)
    let _ = div_ceil((u16)7, (u16)3)
    let _ = div_ceil_u32(7, 3)
    let _ = div_ceil_u16(7, 3)
    let _ = div_round((u32)7, (u32)3)
    let _ = div_round((u16)7, (u16)3)
    let _ = div_round_u32(7, 3)
    let _ = div_round_u16(7, 3)
    let _ = diff((i32)7, (i32)3)
    let _ = diff((i16)7, (i16)3)
    let _ = diff((u32)7, (u32)3)
    let _ = diff((u16)7, (u16)3)
    let _ = diff_i32(7, 3)
    let _ = diff_i16(7, 3)
    let _ = diff_u32(7, 3)
    let _ = diff_u16(7, 3)
}
