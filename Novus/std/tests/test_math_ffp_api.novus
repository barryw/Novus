from std::core import Result
from std::math::ffp import *
from std::test::test import expect

// @covers std::math::ffp::FFP::abs()
// @covers std::math::ffp::FFP::acos()
// @covers std::math::ffp::FFP::add(FFP)
// @covers std::math::ffp::FFP::asin()
// @covers std::math::ffp::FFP::atan()
// @covers std::math::ffp::FFP::ceil()
// @covers std::math::ffp::FFP::cmp(FFP)
// @covers std::math::ffp::FFP::cos()
// @covers std::math::ffp::FFP::cosh()
// @covers std::math::ffp::FFP::div(FFP)
// @covers std::math::ffp::FFP::eq(FFP)
// @covers std::math::ffp::FFP::exp()
// @covers std::math::ffp::FFP::floor()
// @covers std::math::ffp::FFP::from_i32(i32)
// @covers std::math::ffp::FFP::from_ieee(u32)
// @covers std::math::ffp::FFP::from_raw(u32)
// @covers std::math::ffp::FFP::gt(FFP)
// @covers std::math::ffp::FFP::is_negative()
// @covers std::math::ffp::FFP::is_positive()
// @covers std::math::ffp::FFP::is_zero()
// @covers std::math::ffp::FFP::ln()
// @covers std::math::ffp::FFP::log10()
// @covers std::math::ffp::FFP::lt(FFP)
// @covers std::math::ffp::FFP::mul(FFP)
// @covers std::math::ffp::FFP::neg()
// @covers std::math::ffp::FFP::pow(FFP)
// @covers std::math::ffp::FFP::sign()
// @covers std::math::ffp::FFP::sin()
// @covers std::math::ffp::FFP::sinh()
// @covers std::math::ffp::FFP::sqrt()
// @covers std::math::ffp::FFP::sub(FFP)
// @covers std::math::ffp::FFP::tan()
// @covers std::math::ffp::FFP::tanh()
// @covers std::math::ffp::FFP::to_i32()
// @covers std::math::ffp::FFP::to_ieee()
// @covers std::math::ffp::FFP::to_raw()
// @covers std::math::ffp::FFP::zero()
// @covers std::math::ffp::FfpError::message()
// @covers std::math::ffp::close_ffp_libraries()
// @covers std::math::ffp::ffp_e()
// @covers std::math::ffp::ffp_half()
// @covers std::math::ffp::ffp_half_pi()
// @covers std::math::ffp::ffp_libraries_open()
// @covers std::math::ffp::ffp_one()
// @covers std::math::ffp::ffp_pi()
// @covers std::math::ffp::ffp_to_fixed32(FFP)
// @covers std::math::ffp::ffp_two_pi()
// @covers std::math::ffp::fixed32_to_ffp(i32)
// @covers std::math::ffp::open_ffp_libraries()
@test("FFP public API")
pub fn test_ffp_public_api() {
    match open_ffp_libraries() {
        Result::Err(error) => {
            expect(unsafe { error.message()[0] } == (u8)'m', "open error message")
            return
        },
        Result::Ok(_) => {}
    }
    expect(ffp_libraries_open(), "libraries open")

    let zero = FFP::zero()
    let one = FFP::from_i32(1)
    let two = FFP::from_raw(FFP::from_i32(2).to_raw())
    let _ = FFP::from_ieee(0x3F800000)
    let _ = zero.to_i32()
    let _ = one.add(two)
    let _ = two.sub(one)
    let _ = two.mul(one)
    let _ = two.div(one)
    let _ = one.neg()
    let _ = one.neg().abs()
    let _ = one.floor()
    let _ = one.ceil()
    let _ = one.cmp(two)
    let _ = one.sign()
    let _ = zero.is_zero()
    let _ = one.neg().is_negative()
    let _ = one.is_positive()
    let _ = one.eq(one)
    let _ = one.lt(two)
    let _ = two.gt(one)
    let _ = two.sqrt()
    let _ = one.sin()
    let _ = one.cos()
    let _ = one.tan()
    let _ = one.atan()
    let _ = one.asin()
    let _ = one.acos()
    let _ = one.exp()
    let _ = one.ln()
    let _ = one.log10()
    let _ = two.pow(two)
    let _ = one.sinh()
    let _ = one.cosh()
    let _ = one.tanh()
    let _ = one.to_ieee()
    let _ = ffp_pi()
    let _ = ffp_half_pi()
    let _ = ffp_two_pi()
    let _ = ffp_e()
    let _ = ffp_one()
    let _ = ffp_half()
    let converted = fixed32_to_ffp(65536)
    let _ = ffp_to_fixed32(converted)

    close_ffp_libraries()
    expect(!ffp_libraries_open(), "libraries closed")

    let missing = FfpError::MathFfpLibraryNotFound
    let _ = missing.message()
}
