// Test suite for std::prefs preferences system
// Tests creation, getters, setters, file I/O, and version handling

from std::prefs::prefs import Prefs, PrefsError
from std::test::test import expect, expect_true, expect_false, expect_eq
from std::strings::core import Str
from std::ffi::dos import DeleteFile

// =============================================================================
// Creation Tests
// =============================================================================

@test("Prefs::new creates empty prefs")
pub fn test_new_creates_empty_prefs() {
    let result = Prefs::new("test_app", 1)
    match result {
        Result::Ok(var prefs) => {
            expect_eq(prefs.len(), 0, "new prefs has 0 entries")
            expect_true(prefs.is_empty(), "new prefs is empty")
            expect_eq(prefs.version(), 1, "version is 1")
            expect_false(prefs.is_dirty(), "new prefs is not dirty")
        },
        Result::Err(_) => {
            expect(false, "Prefs::new should succeed")
        }
    }
}

// =============================================================================
// String Getter/Setter Tests
// =============================================================================

@test("set_str and get_str work")
pub fn test_set_and_get_str() {
    let result = Prefs::new("test_app", 1)
    match result {
        Result::Ok(var prefs) => {
            let set_result = prefs.set_str("name", "value")
            expect_true(set_result.is_ok(), "set_str succeeds")

            let value = prefs.get_str("name", "default")
            expect_true(value.equals("value"), "get_str returns set value")
            expect_true(prefs.is_dirty(), "prefs is dirty after set")
        },
        Result::Err(_) => expect(false, "Prefs::new should succeed")
    }
}

@test("get_str returns default for missing key")
pub fn test_get_str_default() {
    let result = Prefs::new("test_app", 1)
    match result {
        Result::Ok(prefs) => {
            let value = prefs.get_str("missing", "default_value")
            expect_true(value.equals("default_value"), "get_str returns default")
        },
        Result::Err(_) => expect(false, "Prefs::new should succeed")
    }
}

@test("try_get_str returns None for missing key")
pub fn test_try_get_str_none() {
    let result = Prefs::new("test_app", 1)
    match result {
        Result::Ok(prefs) => {
            let opt = prefs.try_get_str("missing")
            expect_true(opt.is_none(), "try_get_str returns None")
        },
        Result::Err(_) => expect(false, "Prefs::new should succeed")
    }
}

@test("try_get_str returns Some for existing key")
pub fn test_try_get_str_some() {
    let result = Prefs::new("test_app", 1)
    match result {
        Result::Ok(var prefs) => {
            prefs.set_str("key", "value")
            match prefs.try_get_str("key") {
                Option::Some(v) => {
                    expect_true(v.equals("value"), "try_get_str returns correct value")
                },
                Option::None => expect(false, "try_get_str should return Some")
            }
        },
        Result::Err(_) => expect(false, "Prefs::new should succeed")
    }
}

