// =============================================================================
// Boolean Getter/Setter Tests
// =============================================================================

@test("set_bool and get_bool work with true")
pub fn test_set_and_get_bool_true() {
    let result = Prefs::new("test_app", 1)
    match result {
        Result::Ok(var prefs) => {
            prefs.set_bool("enabled", true)
            let value = prefs.get_bool("enabled", false)
            expect_true(value, "get_bool returns true")
        },
        Result::Err(_) => expect(false, "Prefs::new should succeed")
    }
}

@test("set_bool and get_bool work with false")
pub fn test_set_and_get_bool_false() {
    let result = Prefs::new("test_app", 1)
    match result {
        Result::Ok(var prefs) => {
            prefs.set_bool("disabled", false)
            let value = prefs.get_bool("disabled", true)
            expect_false(value, "get_bool returns false")
        },
        Result::Err(_) => expect(false, "Prefs::new should succeed")
    }
}

@test("get_bool parses 1 as true")
pub fn test_get_bool_parses_1() {
    let result = Prefs::new("test_app", 1)
    match result {
        Result::Ok(var prefs) => {
            prefs.set_str("flag", "1")
            let value = prefs.get_bool("flag", false)
            expect_true(value, "get_bool parses '1' as true")
        },
        Result::Err(_) => expect(false, "Prefs::new should succeed")
    }
}

@test("get_bool parses 0 as false")
pub fn test_get_bool_parses_0() {
    let result = Prefs::new("test_app", 1)
    match result {
        Result::Ok(var prefs) => {
            prefs.set_str("flag", "0")
            let value = prefs.get_bool("flag", true)
            expect_false(value, "get_bool parses '0' as false")
        },
        Result::Err(_) => expect(false, "Prefs::new should succeed")
    }
}

@test("get_bool returns default for invalid value")
pub fn test_get_bool_invalid() {
    let result = Prefs::new("test_app", 1)
    match result {
        Result::Ok(var prefs) => {
            prefs.set_str("flag", "maybe")
            let value = prefs.get_bool("flag", true)
            expect_true(value, "get_bool returns default for invalid")
        },
        Result::Err(_) => expect(false, "Prefs::new should succeed")
    }
}

// =============================================================================
// Contains and Remove Tests
// =============================================================================

@test("contains returns false for missing key")
pub fn test_contains_missing() {
    let result = Prefs::new("test_app", 1)
    match result {
        Result::Ok(prefs) => {
            expect_false(prefs.contains("missing"), "contains returns false")
        },
        Result::Err(_) => expect(false, "Prefs::new should succeed")
    }
}

@test("contains returns true for existing key")
pub fn test_contains_existing() {
    let result = Prefs::new("test_app", 1)
    match result {
        Result::Ok(var prefs) => {
            prefs.set_str("key", "value")
            expect_true(prefs.contains("key"), "contains returns true")
        },
        Result::Err(_) => expect(false, "Prefs::new should succeed")
    }
}

@test("remove removes existing key")
pub fn test_remove_existing() {
    let result = Prefs::new("test_app", 1)
    match result {
        Result::Ok(var prefs) => {
            prefs.set_str("key", "value")
            let removed = prefs.remove("key")
            expect_true(removed, "remove returns true for existing key")
            expect_false(prefs.contains("key"), "key is gone after remove")
        },
        Result::Err(_) => expect(false, "Prefs::new should succeed")
    }
}

@test("remove returns false for missing key")
pub fn test_remove_missing() {
    let result = Prefs::new("test_app", 1)
    match result {
        Result::Ok(var prefs) => {
            let removed = prefs.remove("missing")
            expect_false(removed, "remove returns false for missing key")
        },
        Result::Err(_) => expect(false, "Prefs::new should succeed")
    }
}

@test("clear removes all entries")
pub fn test_clear() {
    let result = Prefs::new("test_app", 1)
    match result {
        Result::Ok(var prefs) => {
            prefs.set_str("a", "1")
            prefs.set_str("b", "2")
            prefs.set_str("c", "3")
            expect_eq(prefs.len(), 3, "has 3 entries before clear")

            prefs.clear()
            expect_true(prefs.is_empty(), "is empty after clear")
            expect_eq(prefs.len(), 0, "has 0 entries after clear")
        },
        Result::Err(_) => expect(false, "Prefs::new should succeed")
    }
}

// =============================================================================
// Key Validation Tests
// =============================================================================

@test("set_str rejects empty key")
pub fn test_empty_key_rejected() {
    let result = Prefs::new("test_app", 1)
    match result {
        Result::Ok(var prefs) => {
            let set_result = prefs.set_str("", "value")
            match set_result {
                Result::Err(PrefsError::InvalidKey) => {
                    expect(true, "empty key rejected with InvalidKey")
                },
                _ => expect(false, "empty key should be rejected")
            }
        },
        Result::Err(_) => expect(false, "Prefs::new should succeed")
    }
}

@test("set_str rejects key with equals sign")
pub fn test_key_with_equals_rejected() {
    let result = Prefs::new("test_app", 1)
    match result {
        Result::Ok(var prefs) => {
            let set_result = prefs.set_str("key=bad", "value")
            match set_result {
                Result::Err(PrefsError::InvalidKey) => {
                    expect(true, "key with = rejected")
                },
                _ => expect(false, "key with = should be rejected")
            }
        },
        Result::Err(_) => expect(false, "Prefs::new should succeed")
    }
}

@test("dotted key names work")
pub fn test_dotted_key_names() {
    let result = Prefs::new("test_app", 1)
    match result {
        Result::Ok(var prefs) => {
            prefs.set_str("window.width", "640")
            prefs.set_str("window.height", "480")
            prefs.set_str("ui.theme.name", "dark")

            let width = prefs.get_u32("window.width", 0)
            let height = prefs.get_u32("window.height", 0)
            let theme = prefs.get_str("ui.theme.name", "")

            expect_eq(width, 640, "dotted key window.width works")
            expect_eq(height, 480, "dotted key window.height works")
            expect_true(theme.equals("dark"), "dotted key ui.theme.name works")
        },
        Result::Err(_) => expect(false, "Prefs::new should succeed")
    }
}

// =============================================================================
// Update Existing Key Tests
// =============================================================================

@test("set_str updates existing key")
pub fn test_update_existing_key() {
    let result = Prefs::new("test_app", 1)
    match result {
        Result::Ok(var prefs) => {
            prefs.set_str("key", "first")
            prefs.set_str("key", "second")

            let value = prefs.get_str("key", "")
            expect_true(value.equals("second"), "value is updated")
            expect_eq(prefs.len(), 1, "still only 1 entry")
        },
        Result::Err(_) => expect(false, "Prefs::new should succeed")
    }
}

// =============================================================================
// File I/O Tests (using RAM: for testing)
// =============================================================================

// Note: These tests use RAM: instead of ENV:/ENVARC: for isolation.
// The actual save/load will write to ENV: and ENVARC:.

@test("save creates file and load reads it back")
pub fn test_save_and_load_roundtrip() {
    // Clean up any existing test files
    DeleteFile("RAM:test_prefs_app.prefs")

    // Create and save prefs
    let create_result = Prefs::new("test_prefs_app", 1)
    match create_result {
        Result::Ok(var prefs) => {
            prefs.set_str("name", "Test App")
            prefs.set_u32("window.width", 800)
            prefs.set_u32("window.height", 600)
            prefs.set_bool("fullscreen", false)
            prefs.set_i32("volume", -5)

            // We'll test the internal write_to_file directly since
            // save() writes to ENV:/ENVARC: which may not exist in test
            let save_result = prefs.write_to_file("RAM:test_prefs_app.prefs")
            expect_true(save_result.is_ok(), "write_to_file succeeds")
        },
        Result::Err(_) => expect(false, "Prefs::new should succeed")
    }

    // Now load it back by creating a file handle and parsing
    // Since load_any looks for ENV:/ENVARC:, we'll verify the file content instead
    // by re-reading manually

    // For now just verify the file was created
    // Full round-trip test would need ENV: available

    // Clean up
    DeleteFile("RAM:test_prefs_app.prefs")
}

@test("load returns NotFound for missing file")
pub fn test_load_not_found() {
    // Ensure file doesn't exist
    DeleteFile("ENV:definitely_not_exists_xyz.prefs")
    DeleteFile("ENVARC:definitely_not_exists_xyz.prefs")

    let result = Prefs::load("definitely_not_exists_xyz", 1)
    match result {
        Result::Err(PrefsError::NotFound) => {
            expect(true, "load returns NotFound")
        },
        _ => expect(false, "load should return NotFound for missing file")
    }
}

// =============================================================================
// Empty Value Tests
// =============================================================================

@test("empty value is allowed")
pub fn test_empty_value() {
    let result = Prefs::new("test_app", 1)
    match result {
        Result::Ok(var prefs) => {
            let set_result = prefs.set_str("key", "")
            expect_true(set_result.is_ok(), "set_str with empty value succeeds")

            let value = prefs.get_str("key", "default")
            expect_eq(value.len(), 0, "empty value is preserved")
        },
        Result::Err(_) => expect(false, "Prefs::new should succeed")
    }
}

// =============================================================================
// Dirty Flag Tests
// =============================================================================

@test("dirty flag set after modification")
pub fn test_dirty_flag() {
    let result = Prefs::new("test_app", 1)
    match result {
        Result::Ok(var prefs) => {
            expect_false(prefs.is_dirty(), "not dirty initially")

            prefs.set_str("key", "value")
            expect_true(prefs.is_dirty(), "dirty after set")
        },
        Result::Err(_) => expect(false, "Prefs::new should succeed")
    }
}

@test("dirty flag set after remove")
pub fn test_dirty_after_remove() {
    let result = Prefs::new("test_app", 1)
    match result {
        Result::Ok(var prefs) => {
            prefs.set_str("key", "value")

            // Reset dirty by creating fresh prefs with same data
            let result2 = Prefs::new("test_app2", 1)
            match result2 {
                Result::Ok(var prefs2) => {
                    prefs2.set_str("key", "value")
                    // Pretend we just loaded it
                    // Actually we can't reset dirty from outside...

                    // Just verify remove sets dirty
                    prefs2.remove("key")
                    expect_true(prefs2.is_dirty(), "dirty after remove")
                },
                Result::Err(_) => {}
            }
        },
        Result::Err(_) => expect(false, "Prefs::new should succeed")
    }
}

// =============================================================================
// Multiple Entries Tests
// =============================================================================

@test("multiple entries work correctly")
pub fn test_multiple_entries() {
    let result = Prefs::new("test_app", 1)
    match result {
        Result::Ok(var prefs) => {
            prefs.set_str("a", "1")
            prefs.set_str("b", "2")
            prefs.set_str("c", "3")
            prefs.set_str("d", "4")
            prefs.set_str("e", "5")

            expect_eq(prefs.len(), 5, "has 5 entries")

            expect_true(prefs.get_str("a", "").equals("1"), "a is 1")
            expect_true(prefs.get_str("b", "").equals("2"), "b is 2")
            expect_true(prefs.get_str("c", "").equals("3"), "c is 3")
            expect_true(prefs.get_str("d", "").equals("4"), "d is 4")
            expect_true(prefs.get_str("e", "").equals("5"), "e is 5")
        },
        Result::Err(_) => expect(false, "Prefs::new should succeed")
    }
}

// =============================================================================
// Whitespace Handling Tests
// =============================================================================

@test("values with whitespace preserved")
pub fn test_whitespace_in_value() {
    let result = Prefs::new("test_app", 1)
    match result {
        Result::Ok(var prefs) => {
            prefs.set_str("path", "C:/Program Files/My App")

            let value = prefs.get_str("path", "")
            expect_true(value.equals("C:/Program Files/My App"), "whitespace preserved")
        },
        Result::Err(_) => expect(false, "Prefs::new should succeed")
    }
}
