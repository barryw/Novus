// @covers std::collections::vec::Vec::insert(usize, T)
@test("Vec::insert at beginning")
pub fn test_vec_insert_beginning() {
    var v = Vec::<i32>::new()
    let _ = v.push(20)
    let _ = v.push(30)

    let success = v.insert(0, 10)
    match success {
        Ok(_) => expect(true, "insert at 0 succeeds"),
        Err(_) => expect(false, "insert at 0 should succeed")
    }
    expect_eq(v.len(), 3, "len is 3 after insert")

    match v.get(0) {
        Some(val) => expect_eq(*val, 10, "element 0 is 10"),
        None => expect(false, "should have element 0")
    }

    match v.get(1) {
        Some(val) => expect_eq(*val, 20, "element 1 is 20"),
        None => expect(false, "should have element 1")
    }

    match v.get(2) {
        Some(val) => expect_eq(*val, 30, "element 2 is 30"),
        None => expect(false, "should have element 2")
    }

}

// @covers std::collections::vec::Vec::insert(usize, T)
@test("Vec::insert in middle")
pub fn test_vec_insert_middle() {
    var v = Vec::<i32>::new()
    let _ = v.push(10)
    let _ = v.push(30)

    let success = v.insert(1, 20)
    match success {
        Ok(_) => expect(true, "insert at 1 succeeds"),
        Err(_) => expect(false, "insert at 1 should succeed")
    }
    expect_eq(v.len(), 3, "len is 3 after insert")

    match v.get(0) {
        Some(val) => expect_eq(*val, 10, "element 0 is 10"),
        None => expect(false, "should have element 0")
    }

    match v.get(1) {
        Some(val) => expect_eq(*val, 20, "element 1 is 20"),
        None => expect(false, "should have element 1")
    }

    match v.get(2) {
        Some(val) => expect_eq(*val, 30, "element 2 is 30"),
        None => expect(false, "should have element 2")
    }

}

// @covers std::collections::vec::Vec::insert(usize, T)
@test("Vec::insert at end (append)")
pub fn test_vec_insert_end() {
    var v = Vec::<i32>::new()
    let _ = v.push(10)
    let _ = v.push(20)

    let success = v.insert(2, 30)
    match success {
        Ok(_) => expect(true, "insert at end succeeds"),
        Err(_) => expect(false, "insert at end should succeed")
    }
    expect_eq(v.len(), 3, "len is 3 after insert")

    match v.get(2) {
        Some(val) => expect_eq(*val, 30, "element 2 is 30"),
        None => expect(false, "should have element 2")
    }

}

// @covers std::collections::vec::Vec::insert(usize, T)
@test("Vec::insert returns false for out of bounds")
pub fn test_vec_insert_oob() {
    var v = Vec::<i32>::new()
    let _ = v.push(10)

    let success = v.insert(5, 100)
    match success {
        Ok(_) => expect(false, "insert beyond len should fail"),
        Err(_) => expect(true, "insert correctly fails")
    }
    expect_eq(v.len(), 1, "len unchanged after failed insert")

}

// ============================================================================
// Remove Tests
// ============================================================================

// @covers std::collections::vec::Vec::remove(usize)
@test("Vec::remove from beginning")
pub fn test_vec_remove_beginning() {
    var v = Vec::<i32>::new()
    let _ = v.push(10)
    let _ = v.push(20)
    let _ = v.push(30)

    let r = v.remove(0)
    match r {
        Ok(val) => expect_eq(val, 10, "removed value is 10"),
        Err(_) => expect(false, "should have removed value")
    }

    expect_eq(v.len(), 2, "len is 2 after remove")

    match v.get(0) {
        Some(val) => expect_eq(*val, 20, "element 0 is now 20"),
        None => expect(false, "should have element 0")
    }

    match v.get(1) {
        Some(val) => expect_eq(*val, 30, "element 1 is now 30"),
        None => expect(false, "should have element 1")
    }

}

// @covers std::collections::vec::Vec::remove(usize)
@test("Vec::remove from middle")
pub fn test_vec_remove_middle() {
    var v = Vec::<i32>::new()
    let _ = v.push(10)
    let _ = v.push(20)
    let _ = v.push(30)

    let r = v.remove(1)
    match r {
        Ok(val) => expect_eq(val, 20, "removed value is 20"),
        Err(_) => expect(false, "should have removed value")
    }

    expect_eq(v.len(), 2, "len is 2 after remove")

    match v.get(0) {
        Some(val) => expect_eq(*val, 10, "element 0 is 10"),
        None => expect(false, "should have element 0")
    }

    match v.get(1) {
        Some(val) => expect_eq(*val, 30, "element 1 is now 30"),
        None => expect(false, "should have element 1")
    }

}

// @covers std::collections::vec::Vec::remove(usize)
@test("Vec::remove from end")
pub fn test_vec_remove_end() {
    var v = Vec::<i32>::new()
    let _ = v.push(10)
    let _ = v.push(20)
    let _ = v.push(30)

    let r = v.remove(2)
    match r {
        Ok(val) => expect_eq(val, 30, "removed value is 30"),
        Err(_) => expect(false, "should have removed value")
    }

    expect_eq(v.len(), 2, "len is 2 after remove")

}

// @covers std::collections::vec::Vec::remove(usize)
@test("Vec::remove returns None for out of bounds")
pub fn test_vec_remove_oob() {
    var v = Vec::<i32>::new()
    let _ = v.push(10)

    let r = v.remove(5)
    match r {
        Ok(_) => expect(false, "should not remove out of bounds"),
        Err(_) => expect(true, "correctly returned error")
    }

    expect_eq(v.len(), 1, "len unchanged after failed remove")

}

// ============================================================================
// Clear and Truncate Tests
// ============================================================================

// @covers std::collections::vec::Vec::clear()
@test("Vec::clear removes all elements")
pub fn test_vec_clear() {
    var v = Vec::<i32>::new()
    let _ = v.push(10)
    let _ = v.push(20)
    let _ = v.push(30)

    let cap_before = v.capacity()
    v.clear()

    expect_eq(v.len(), 0, "len is 0 after clear")
    expect_true(v.is_empty(), "vec is empty after clear")
    expect_eq(v.capacity(), cap_before, "capacity unchanged after clear")

}

// @covers std::collections::vec::Vec::truncate(usize)
@test("Vec::truncate shortens vector")
pub fn test_vec_truncate() {
    var v = Vec::<i32>::new()
    let _ = v.push(10)
    let _ = v.push(20)
    let _ = v.push(30)
    let _ = v.push(40)
    let _ = v.push(50)

    v.truncate(3)

    expect_eq(v.len(), 3, "len is 3 after truncate")

    match v.get(2) {
        Some(val) => expect_eq(*val, 30, "element 2 is still 30"),
        None => expect(false, "should have element 2")
    }

    match v.get(3) {
        Some(_) => expect(false, "should not have element 3"),
        None => expect(true, "correctly no element 3")
    }

}

// @covers std::collections::vec::Vec::truncate(usize)
@test("Vec::truncate to 0 clears")
pub fn test_vec_truncate_zero() {
    var v = Vec::<i32>::new()
    let _ = v.push(10)
    let _ = v.push(20)

    v.truncate(0)

    expect_eq(v.len(), 0, "len is 0 after truncate to 0")
    expect_true(v.is_empty(), "vec is empty after truncate to 0")

}

// @covers std::collections::vec::Vec::truncate(usize)
@test("Vec::truncate with len >= current does nothing")
pub fn test_vec_truncate_noop() {
    var v = Vec::<i32>::new()
    let _ = v.push(10)
    let _ = v.push(20)

    v.truncate(10)

    expect_eq(v.len(), 2, "len unchanged when truncate > len")

}

// ============================================================================
// Reserve and Capacity Tests
// ============================================================================

// @covers std::collections::vec::Vec::reserve(usize)
@test("Vec::reserve increases capacity")
pub fn test_vec_reserve() {
    var v = Vec::<i32>::new()
    let _ = v.push(10)

    let success = v.reserve(100)
    match success {
        Ok(_) => expect(true, "reserve succeeds"),
        Err(_) => expect(false, "reserve should succeed")
    }
    expect_true(v.capacity() >= 101, "capacity is at least 101")
    expect_eq(v.len(), 1, "len unchanged after reserve")

}

// ============================================================================
// is_empty Tests
// ============================================================================

// @covers std::collections::vec::Vec::is_empty()
@test("Vec::is_empty true for new vec")
pub fn test_vec_is_empty_new() {
    let v = Vec::<i32>::new()
    expect_true(v.is_empty(), "new vec is empty")
}

// @covers std::collections::vec::Vec::is_empty()
@test("Vec::is_empty false after push")
pub fn test_vec_is_empty_after_push() {
    var v = Vec::<i32>::new()
    let _ = v.push(10)
    expect_false(v.is_empty(), "vec with element is not empty")
}

// @covers std::collections::vec::Vec::is_empty()
@test("Vec::is_empty true after clearing")
pub fn test_vec_is_empty_after_clear() {
    var v = Vec::<i32>::new()
    let _ = v.push(10)
    v.clear()
    expect_true(v.is_empty(), "vec after clear is empty")
}

// @covers std::collections::vec::Vec::is_empty()
@test("Vec::is_empty true after popping all")
pub fn test_vec_is_empty_after_pop_all() {
    var v = Vec::<i32>::new()
    let _ = v.push(10)
    v.pop()
    expect_true(v.is_empty(), "vec after popping all is empty")
}

// ============================================================================
// len and capacity Tests
// ============================================================================

// @covers std::collections::vec::Vec::len()
@test("Vec::len tracks element count")
pub fn test_vec_len_tracking() {
    var v = Vec::<i32>::new()

    expect_eq(v.len(), 0, "len 0 initially")

    let _ = v.push(10)
    expect_eq(v.len(), 1, "len 1 after push")

    let _ = v.push(20)
    expect_eq(v.len(), 2, "len 2 after push")

    v.pop()
    expect_eq(v.len(), 1, "len 1 after pop")

    v.clear()
    expect_eq(v.len(), 0, "len 0 after clear")

}

// @covers std::collections::vec::Vec::capacity()
@test("Vec::capacity grows as needed")
pub fn test_vec_capacity_grows() {
    var v = Vec::<i32>::new()

    // Push many elements to trigger growth
    var i: i32 = 0
    while i < 20 {
        let _ = v.push(i)
        i++
    }

    expect_true(v.capacity() >= 20, "capacity at least 20")
    expect_eq(v.len(), 20, "len is 20")

}

// ============================================================================
// with_capacity Tests
// ============================================================================

// @covers std::collections::vec::Vec::with_capacity(usize)
@test("Vec::with_capacity allocates capacity")
pub fn test_vec_with_capacity() {
    match Vec::<i32>::with_capacity(10) {
        Ok(var v) => {
            expect_eq(v.capacity(), 10, "capacity is 10")
            expect_eq(v.len(), 0, "len is 0")
            expect_true(v.is_empty(), "vec is empty")
        },
        Err(_) => expect(false, "with_capacity should succeed")
    }
}

// @covers std::collections::vec::Vec::with_capacity(usize)
@test("Vec::with_capacity zero returns empty vec")
pub fn test_vec_with_capacity_zero() {
    match Vec::<i32>::with_capacity(0) {
        Ok(v) => {
            expect_eq(v.capacity(), 0, "capacity is 0")
            expect_eq(v.len(), 0, "len is 0")
        },
        Err(_) => expect(false, "with_capacity(0) should succeed")
    }
}

// @covers std::collections::vec::Vec::with_capacity(usize)
@test("Vec::with_capacity can push elements")
pub fn test_vec_with_capacity_push() {
    match Vec::<i32>::with_capacity(5) {
        Ok(var v) => {
            let _ = v.push(10)
            let _ = v.push(20)
            let _ = v.push(30)

            expect_eq(v.len(), 3, "len is 3")
            expect_true(v.capacity() >= 5, "capacity is at least 5")

            match v.get(1) {
                Some(val) => expect_eq(*val, 20, "element 1 is 20"),
                None => expect(false, "should have element 1")
            }

        },
        Err(_) => expect(false, "with_capacity should succeed")
    }
}

// ============================================================================
// Different Type Tests (u32, u8, bool)
// ============================================================================

@test("Vec<u32> works correctly")
pub fn test_vec_u32() {
    var v = Vec::<u32>::new()

    let _ = v.push(100)
    let _ = v.push(200)
    let _ = v.push(300)

    expect_eq(v.len(), 3, "len is 3")

    match v.get(1) {
        Some(val) => expect_eq(*val, 200, "element 1 is 200"),
        None => expect(false, "should have element 1")
    }

}

@test("Vec<u8> works correctly")
pub fn test_vec_u8() {
    var v = Vec::<u8>::new()

    let _ = v.push(10)
    let _ = v.push(20)
    let _ = v.push(30)

    expect_eq(v.len(), 3, "len is 3")

    let p = v.pop()
    match p {
        Some(val) => expect_eq(val, 30, "popped value is 30"),
        None => expect(false, "should have popped value")
    }

}

@test("Vec<bool> works correctly")
pub fn test_vec_bool() {
    var v = Vec::<bool>::new()

    let _ = v.push(true)
    let _ = v.push(false)
    let _ = v.push(true)

    expect_eq(v.len(), 3, "len is 3")

    match v.get(1) {
        Some(val) => expect_false(*val, "element 1 is false"),
        None => expect(false, "should have element 1")
    }

}

// ============================================================================
// with_capacity in match arms (regression test for compiler bug)
// ============================================================================

// @covers std::collections::vec::Vec::with_capacity(usize)
@test("Vec::with_capacity works inside match arms")
pub fn test_vec_with_capacity_in_match() {
    let x: i32 = 5
    match x {
        5 => {
            match Vec::<i32>::with_capacity(10) {
                Ok(var v) => {
                    let _ = v.push(100)
                    expect_eq(v.len(), 1, "len is 1")
                },
                Err(_) => expect(false, "with_capacity should succeed")
            }
        },
        _ => expect(false, "should match 5")
    }
}

// @covers std::collections::vec::Vec::as_ptr()
// @covers std::collections::vec::Vec::as_mut_ptr()
// @covers std::collections::vec::Vec::as_slice()
// @covers std::collections::vec::Vec::as_mut_slice()
// @covers std::collections::vec::Vec::shrink_to_fit()
@test("Vec exposes bounded views and can release spare capacity")
pub fn test_vec_views_and_shrink() {
    match Vec::<i32>::with_capacity(8) {
        Ok(var v) => {
            let _ = v.push(10)
            let _ = v.push(20)
            unsafe { expect_eq(v.as_ptr()[0], 10, "immutable pointer") }
            {
                var values = v.as_mut_slice()
                expect_true(values.set(0, 11).is_ok(), "mutable slice")
            }
            expect_eq(*v.as_slice().get(0).unwrap(), 11, "immutable slice")
            let values = v.as_mut_ptr()
            unsafe { values[1] = 22 }
            expect_eq(*v.as_slice().get(1).unwrap(), 22, "mutable pointer")
            expect_true(v.shrink_to_fit().is_ok(), "shrink succeeds")
            expect_eq(v.capacity(), v.len(), "capacity fits length")
            @drop_in_place(&var v)
            expect_true(v.is_empty(), "drop_in_place releases the vector early")
        },
        Err(_) => expect(false, "with_capacity should succeed"),
    }
}
