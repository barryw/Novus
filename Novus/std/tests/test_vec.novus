// Standard Library Tests - Vec<T> Type
// Tests for std::collections::vec::Vec (dynamic array)
//
// Run with: novus test Novus/std/tests/test_vec.novus

from std::collections::vec import Vec
from std::core import Option
from std::test::test import expect, expect_true, expect_false, expect_eq

// ============================================================================
// Creation Tests
// ============================================================================

// @covers std::collections::vec::Vec::new()
@test("Vec::new creates empty vector")
pub fn test_vec_new() {
    let v = Vec::<i32>::new()
    expect_eq(v.len(), 0, "new vec has len 0")
    expect_eq(v.capacity(), 0, "new vec has capacity 0")
    expect_true(v.is_empty(), "new vec is empty")
}

// ============================================================================
// Push Tests
// ============================================================================

// @covers std::collections::vec::Vec::push(T)
@test("Vec::push adds elements")
pub fn test_vec_push() {
    var v = Vec::<i32>::new()

    let r1 = v.push(10)
    match r1 {
        Ok(_) => expect(true, "first push succeeds"),
        Err(_) => expect(false, "first push should succeed")
    }
    expect_eq(v.len(), 1, "len is 1 after first push")

    let r2 = v.push(20)
    match r2 {
        Ok(_) => expect(true, "second push succeeds"),
        Err(_) => expect(false, "second push should succeed")
    }
    expect_eq(v.len(), 2, "len is 2 after second push")

    let r3 = v.push(30)
    match r3 {
        Ok(_) => expect(true, "third push succeeds"),
        Err(_) => expect(false, "third push should succeed")
    }
    expect_eq(v.len(), 3, "len is 3 after third push")

}

// @covers std::collections::vec::Vec::push(T)
@test("Vec::push grows capacity automatically")
pub fn test_vec_push_grows() {
    var v = Vec::<i32>::new()

    // Push more than initial capacity
    var i: i32 = 0
    while i < 10 {
        let success = v.push(i)
        match success {
            Ok(_) => expect(true, "push succeeds"),
            Err(_) => expect(false, "push should succeed")
        }
        i++
    }

    expect_eq(v.len(), 10, "len is 10 after 10 pushes")
    expect_true(v.capacity() >= 10, "capacity is at least 10")

}

// ============================================================================
// Pop Tests
// ============================================================================

// @covers std::collections::vec::Vec::pop()
@test("Vec::pop removes and returns last element")
pub fn test_vec_pop() {
    var v = Vec::<i32>::new()
    let _ = v.push(10)
    let _ = v.push(20)
    let _ = v.push(30)

    let p1 = v.pop()
    match p1 {
        Some(val) => expect_eq(val, 30, "popped value is 30"),
        None => expect(false, "should have returned value")
    }
    expect_eq(v.len(), 2, "len is 2 after pop")

    let p2 = v.pop()
    match p2 {
        Some(val) => expect_eq(val, 20, "popped value is 20"),
        None => expect(false, "should have returned value")
    }
    expect_eq(v.len(), 1, "len is 1 after second pop")

}

// @covers std::collections::vec::Vec::pop()
@test("Vec::pop returns None on empty vec")
pub fn test_vec_pop_empty() {
    var v = Vec::<i32>::new()

    let p = v.pop()
    match p {
        Some(_) => expect(false, "should not return value from empty vec"),
        None => expect(true, "correctly returned None")
    }
}

// @covers std::collections::vec::Vec::pop()
@test("Vec::pop after push/pop cycles")
pub fn test_vec_pop_push_cycle() {
    var v = Vec::<i32>::new()

    let _ = v.push(1)
    let _ = v.push(2)
    v.pop()
    let _ = v.push(3)

    expect_eq(v.len(), 2, "len is 2 after push/pop/push")

    let p = v.pop()
    match p {
        Some(val) => expect_eq(val, 3, "last element is 3"),
        None => expect(false, "should have returned value")
    }

}

// ============================================================================
// Get Tests
// ============================================================================

// @covers std::collections::vec::Vec::get(usize)
@test("Vec::get returns correct element")
pub fn test_vec_get() {
    var v = Vec::<i32>::new()
    let _ = v.push(10)
    let _ = v.push(20)
    let _ = v.push(30)

    match v.get(0) {
        Some(val) => expect_eq(*val, 10, "element 0 is 10"),
        None => expect(false, "should have returned value")
    }

    match v.get(1) {
        Some(val) => expect_eq(*val, 20, "element 1 is 20"),
        None => expect(false, "should have returned value")
    }

    match v.get(2) {
        Some(val) => expect_eq(*val, 30, "element 2 is 30"),
        None => expect(false, "should have returned value")
    }

}

// @covers std::collections::vec::Vec::get(usize)
@test("Vec::get returns None for out of bounds")
pub fn test_vec_get_oob() {
    var v = Vec::<i32>::new()
    let _ = v.push(10)
    let _ = v.push(20)

    match v.get(2) {
        Some(_) => expect(false, "should return None for index 2"),
        None => expect(true, "correctly returned None")
    }

    match v.get(100) {
        Some(_) => expect(false, "should return None for index 100"),
        None => expect(true, "correctly returned None")
    }

}

// @covers std::collections::vec::Vec::get(usize)
@test("Vec::get on empty vec returns None")
pub fn test_vec_get_empty() {
    let v = Vec::<i32>::new()

    match v.get(0) {
        Some(_) => expect(false, "should return None for empty vec"),
        None => expect(true, "correctly returned None")
    }
}

// ============================================================================
// Set Tests
// ============================================================================

// @covers std::collections::vec::Vec::set(usize, T)
@test("Vec::set updates element")
pub fn test_vec_set() {
    var v = Vec::<i32>::new()
    let _ = v.push(10)
    let _ = v.push(20)
    let _ = v.push(30)

    let success = v.set(1, 200)
    match success {
        Ok(_) => expect(true, "set succeeds"),
        Err(_) => expect(false, "set should succeed")
    }

    match v.get(1) {
        Some(val) => expect_eq(*val, 200, "element 1 is now 200"),
        None => expect(false, "should have returned value")
    }

}

// @covers std::collections::vec::Vec::set(usize, T)
@test("Vec::set returns false for out of bounds")
pub fn test_vec_set_oob() {
    var v = Vec::<i32>::new()
    let _ = v.push(10)

    let success = v.set(5, 100)
    match success {
        Ok(_) => expect(false, "set should fail for out of bounds"),
        Err(_) => expect(true, "set correctly fails")
    }

}

// @covers std::collections::vec::Vec::get_mut(usize)
@test("Vec::get_mut updates in place")
pub fn test_vec_get_mut() {
    var v = Vec::<i32>::new()
    let _ = v.push(10)
    let _ = v.push(20)

    match v.get_mut(1) {
        Some(value) => { *value = 42 },
        None => expect(false, "element 1 should exist")
    }

    match v.get(1) {
        Some(value) => expect_eq(*value, 42, "mutable borrow updates element"),
        None => expect(false, "element 1 should exist")
    }
}

