pub fn test_parse_u32_positive() {
    let s: Str = "12345"
    let result = s.parse_u32()
    match result {
        Ok(val) => expect_eq(val, 12345, "parsed value is 12345"),
        Err(_) => expect(false, "parse should succeed")
    }
}

// @covers std::string::core::Str::parse_u32()
@test("parse_u32 parses zero")
pub fn test_parse_u32_zero() {
    let s: Str = "0"
    let result = s.parse_u32()
    match result {
        Ok(val) => expect_eq(val, 0, "parsed value is 0"),
        Err(_) => expect(false, "parse should succeed")
    }
}

// @covers std::string::core::Str::parse_u32()
@test("parse_u32 parses large number")
pub fn test_parse_u32_large() {
    let s: Str = "4000000000"
    let result = s.parse_u32()
    match result {
        Ok(val) => expect_eq(val, (u32)4000000000, "parsed value is 4000000000"),
        Err(_) => expect(false, "parse should succeed")
    }
}

