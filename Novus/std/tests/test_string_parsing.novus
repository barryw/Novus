// @covers std::string::core::Str::parse_i32()
@test("parse_i32 parses negative number")
pub fn test_parse_i32_negative() {
    let s: Str = "-123"
    let result = s.parse_i32()
    match result {
        Ok(val) => expect_eq(val, -123, "parsed value is -123"),
        Err(_) => expect(false, "parse should succeed")
    }
}

// @covers std::string::core::Str::parse_i32()
@test("parse_i32 parses negative one")
pub fn test_parse_i32_negative_one() {
    let s: Str = "-1"
    let result = s.parse_i32()
    match result {
        Ok(val) => expect_eq(val, -1, "parsed value is -1"),
        Err(_) => expect(false, "parse should succeed")
    }
}

// =============================================================================
// parse_i32 tests - error cases
// =============================================================================

// @covers std::string::core::Str::parse_i32()
@test("parse_i32 fails on empty string")
pub fn test_parse_i32_empty() {
    let s: Str = ""
    let result = s.parse_i32()
    match result {
        Ok(_) => expect(false, "empty should fail"),
        Err(_) => expect(true, "empty string returns error")
    }
}

// @covers std::string::core::Str::parse_i32()
@test("parse_i32 fails on invalid characters")
pub fn test_parse_i32_invalid_chars() {
    let s: Str = "12a34"
    let result = s.parse_i32()
    match result {
        Ok(_) => expect(false, "invalid chars should fail"),
        Err(_) => expect(true, "invalid chars returns error")
    }
}

// @covers std::string::core::Str::parse_i32()
@test("parse_i32 fails on letters only")
pub fn test_parse_i32_letters() {
    let s: Str = "abc"
    let result = s.parse_i32()
    match result {
        Ok(_) => expect(false, "letters should fail"),
        Err(_) => expect(true, "letters returns error")
    }
}

// @covers std::string::core::Str::parse_i32()
@test("parse_i32 fails on just minus sign")
pub fn test_parse_i32_just_minus() {
    let s: Str = "-"
    let result = s.parse_i32()
    match result {
        Ok(_) => expect(false, "just minus should fail"),
        Err(_) => expect(true, "just minus returns error")
    }
}

