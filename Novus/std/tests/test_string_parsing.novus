// =============================================================================
// parse_bool tests - valid booleans
// =============================================================================

// @covers std::string::core::Str::parse_bool()
@test("parse_bool parses 'true'")
pub fn test_parse_bool_true() {
    let s: Str = "true"
    let result = s.parse_bool()
    match result {
        Ok(val) => expect_eq(val, true, "parsed value is true"),
        Err(_) => expect(false, "parse should succeed")
    }
}

// @covers std::string::core::Str::parse_bool()
@test("parse_bool parses 'false'")
pub fn test_parse_bool_false() {
    let s: Str = "false"
    let result = s.parse_bool()
    match result {
        Ok(val) => expect_eq(val, false, "parsed value is false"),
        Err(_) => expect(false, "parse should succeed")
    }
}

// @covers std::string::core::Str::parse_bool()
@test("parse_bool parses 'TRUE'")
pub fn test_parse_bool_upper_true() {
    let s: Str = "TRUE"
    let result = s.parse_bool()
    match result {
        Ok(val) => expect_eq(val, true, "TRUE is true"),
        Err(_) => expect(false, "parse should succeed")
    }
}

// @covers std::string::core::Str::parse_bool()
@test("parse_bool parses 'FALSE'")
pub fn test_parse_bool_upper_false() {
    let s: Str = "FALSE"
    let result = s.parse_bool()
    match result {
        Ok(val) => expect_eq(val, false, "FALSE is false"),
        Err(_) => expect(false, "parse should succeed")
    }
}

// @covers std::string::core::Str::parse_bool()
@test("parse_bool parses '1'")
pub fn test_parse_bool_one() {
    let s: Str = "1"
    let result = s.parse_bool()
    match result {
        Ok(val) => expect_eq(val, true, "1 is true"),
        Err(_) => expect(false, "parse should succeed")
    }
}

// @covers std::string::core::Str::parse_bool()
@test("parse_bool parses '0'")
pub fn test_parse_bool_zero() {
    let s: Str = "0"
    let result = s.parse_bool()
    match result {
        Ok(val) => expect_eq(val, false, "0 is false"),
        Err(_) => expect(false, "parse should succeed")
    }
}

