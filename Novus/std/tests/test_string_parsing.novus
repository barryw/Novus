// =============================================================================
// parse_hex tests - valid hex strings
// =============================================================================

// @covers std::string::core::Str::parse_hex()
@test("parse_hex parses lowercase hex")
pub fn test_parse_hex_lowercase() {
    let s: Str = "ff"
    let result = s.parse_hex()
    match result {
        Ok(val) => expect_eq(val, 255, "ff is 255"),
        Err(_) => expect(false, "parse should succeed")
    }
}

// @covers std::string::core::Str::parse_hex()
@test("parse_hex parses uppercase hex")
pub fn test_parse_hex_uppercase() {
    let s: Str = "FF"
    let result = s.parse_hex()
    match result {
        Ok(val) => expect_eq(val, 255, "FF is 255"),
        Err(_) => expect(false, "parse should succeed")
    }
}

// @covers std::string::core::Str::parse_hex()
@test("parse_hex parses mixed case hex")
pub fn test_parse_hex_mixed_case() {
    let s: Str = "aAbB"
    let result = s.parse_hex()
    match result {
        Ok(val) => expect_eq(val, 43707, "aAbB is 43707"),
        Err(_) => expect(false, "parse should succeed")
    }
}

// @covers std::string::core::Str::parse_hex()
@test("parse_hex parses with 0x prefix")
pub fn test_parse_hex_with_prefix() {
    let s: Str = "0xff"
    let result = s.parse_hex()
    match result {
        Ok(val) => expect_eq(val, 255, "0xff is 255"),
        Err(_) => expect(false, "parse should succeed")
    }
}

// @covers std::string::core::Str::parse_hex()
@test("parse_hex parses with 0X prefix")
pub fn test_parse_hex_with_upper_prefix() {
    let s: Str = "0XFF"
    let result = s.parse_hex()
    match result {
        Ok(val) => expect_eq(val, 255, "0XFF is 255"),
        Err(_) => expect(false, "parse should succeed")
    }
}

// @covers std::string::core::Str::parse_hex()
@test("parse_hex parses zero")
pub fn test_parse_hex_zero() {
    let s: Str = "0"
    let result = s.parse_hex()
    match result {
        Ok(val) => expect_eq(val, 0, "0 is 0"),
        Err(_) => expect(false, "parse should succeed")
    }
}

// @covers std::string::core::Str::parse_hex()
@test("parse_hex parses large value")
pub fn test_parse_hex_large() {
    let s: Str = "deadbeef"
    let result = s.parse_hex()
    match result {
        Ok(val) => expect_eq(val, (u32)3735928559, "deadbeef correct"),
        Err(_) => expect(false, "parse should succeed")
    }
}

