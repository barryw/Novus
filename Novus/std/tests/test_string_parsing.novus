// Test suite for std::string::core parsing functions
// Tests parse_i32, parse_u32, parse_hex, parse_bool

from std::string::core import Str, ParseError
from std::test::test import expect, expect_true, expect_false, expect_eq

// =============================================================================
// parse_i32 tests - positive numbers
// =============================================================================

// @covers std::string::core::Str::parse_i32()
@test("parse_i32 parses positive number")
pub fn test_parse_i32_positive() {
    let s: Str = "42"
    let result = s.parse_i32()
    match result {
        Ok(val) => expect_eq(val, 42, "parsed value is 42"),
        Err(_) => expect(false, "parse should succeed")
    }
}

// @covers std::string::core::Str::parse_i32()
@test("parse_i32 parses large positive number")
pub fn test_parse_i32_large_positive() {
    let s: Str = "1000000"
    let result = s.parse_i32()
    match result {
        Ok(val) => expect_eq(val, 1000000, "parsed value is 1000000"),
        Err(_) => expect(false, "parse should succeed")
    }
}

// @covers std::string::core::Str::parse_i32()
@test("parse_i32 parses zero")
pub fn test_parse_i32_zero() {
    let s: Str = "0"
    let result = s.parse_i32()
    match result {
        Ok(val) => expect_eq(val, 0, "parsed value is 0"),
        Err(_) => expect(false, "parse should succeed")
    }
}

