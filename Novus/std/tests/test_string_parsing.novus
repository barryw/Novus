// =============================================================================
// parse_i32 with whitespace tests
// =============================================================================

// @covers std::string::core::Str::parse_i32()
@test("parse_i32 handles leading spaces")
pub fn test_parse_i32_leading_spaces() {
    let s: Str = "  42"
    let result = s.parse_i32()
    // This tests whether trim is called internally or not
    // Behavior depends on implementation - may pass or fail
    match result {
        Ok(val) => expect_eq(val, 42, "leading spaces handled"),
        Err(_) => expect(true, "leading spaces may cause error")
    }
}
