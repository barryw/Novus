// =============================================================================
// StringBuilder::push_hex tests
// =============================================================================

@test("StringBuilder::push_hex formats lowercase hex")
pub fn test_sb_push_hex() {
    let result = StringBuilder::new()
    match result {
        Ok(sb) => {
            var builder = sb
            let _ = builder.push_hex(255)  // 0xff
            // "ff" = 2 chars
            expect_eq(builder.len(), 2, "len for 'ff'")
            builder.drop()
        },
        Err(_) => expect(false, "StringBuilder::new should succeed")
    }
}

@test("StringBuilder::push_hex formats zero")
pub fn test_sb_push_hex_zero() {
    let result = StringBuilder::new()
    match result {
        Ok(sb) => {
            var builder = sb
            let _ = builder.push_hex(0)
            expect_eq(builder.len(), 1, "len for '0'")
            builder.drop()
        },
        Err(_) => expect(false, "StringBuilder::new should succeed")
    }
}

@test("StringBuilder::push_hex formats large value")
pub fn test_sb_push_hex_large() {
    let result = StringBuilder::new()
    match result {
        Ok(sb) => {
            var builder = sb
            let _ = builder.push_hex(65535)  // 0xffff
            // "ffff" = 4 chars
            expect_eq(builder.len(), 4, "len for 'ffff'")
            builder.drop()
        },
        Err(_) => expect(false, "StringBuilder::new should succeed")
    }
}

