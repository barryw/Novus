// Test suite for std::string::core StringBuilder
// Tests the StringBuilder type for efficient string construction

from std::string::core import StringBuilder, String, Str
from std::test::test import expect, expect_true, expect_false, expect_eq

// =============================================================================
// StringBuilder::new tests
// =============================================================================

@test("StringBuilder::new creates empty builder")
pub fn test_sb_new() {
    let result = StringBuilder::new()
    match result {
        Ok(sb) => {
            var builder = sb
            expect_eq(builder.len(), 0, "new builder has len 0")
            expect_true(builder.is_empty(), "new builder is empty")
            builder.drop()
        },
        Err(_) => expect(false, "StringBuilder::new should succeed")
    }
}

// =============================================================================
// StringBuilder::with_capacity tests
// =============================================================================

@test("StringBuilder::with_capacity allocates correctly")
pub fn test_sb_with_capacity() {
    let result = StringBuilder::with_capacity(256)
    match result {
        Ok(sb) => {
            var builder = sb
            expect_eq(builder.len(), 0, "with_capacity builder has len 0")
            expect_true(builder.is_empty(), "with_capacity builder is empty")
            builder.drop()
        },
        Err(_) => expect(false, "StringBuilder::with_capacity should succeed")
    }
}

// =============================================================================
// StringBuilder::push_str tests
// =============================================================================

@test("StringBuilder::push_str appends strings")
pub fn test_sb_push_str() {
    let result = StringBuilder::new()
    match result {
        Ok(sb) => {
            var builder = sb
            let _ = builder.push_str("Hello")
            expect_eq(builder.len(), 5, "len after first push")

            let _ = builder.push_str(", ")
            let _ = builder.push_str("World!")
            expect_eq(builder.len(), 13, "len after all pushes")
            builder.drop()
        },
        Err(_) => expect(false, "StringBuilder::new should succeed")
    }
}

// =============================================================================
// StringBuilder::push_byte tests
// =============================================================================

@test("StringBuilder::push_byte appends single bytes")
pub fn test_sb_push_byte() {
    let result = StringBuilder::new()
    match result {
        Ok(sb) => {
            var builder = sb
            let _ = builder.push_byte(65)  // 'A'
            let _ = builder.push_byte(66)  // 'B'
            let _ = builder.push_byte(67)  // 'C'
            expect_eq(builder.len(), 3, "len after 3 bytes")
            builder.drop()
        },
        Err(_) => expect(false, "StringBuilder::new should succeed")
    }
}

