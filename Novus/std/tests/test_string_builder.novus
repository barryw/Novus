// =============================================================================
// StringBuilder combined operations tests
// =============================================================================

@test("StringBuilder builds complex string")
pub fn test_sb_complex_build() {
    let result = StringBuilder::new()
    match result {
        Ok(sb) => {
            var builder = sb
            builder.push_str("Count: ").unwrap()
            let _ = builder.push_i32(42)
            builder.push_str(", Hex: 0x").unwrap()
            let _ = builder.push_hex(255)
            builder.push_str(", Flag: ").unwrap()
            let _ = builder.push_bool(true)

            // "Count: 42, Hex: 0xff, Flag: true"
            // 7 + 2 + 9 + 2 + 8 + 4 = 32
            expect_eq(builder.len(), 32, "complex string len")
            builder.drop()
        },
        Err(_) => expect(false, "StringBuilder::new should succeed")
    }
}

// =============================================================================
// StringBuilder::len and is_empty tests
// =============================================================================

@test("StringBuilder::len tracks content")
pub fn test_sb_len() {
    let result = StringBuilder::new()
    match result {
        Ok(sb) => {
            var builder = sb
            expect_eq(builder.len(), 0, "initial len is 0")

            builder.push_str("abc").unwrap()
            expect_eq(builder.len(), 3, "len after 'abc'")

            builder.push_byte(100).unwrap()
            expect_eq(builder.len(), 4, "len after byte")
            builder.drop()
        },
        Err(_) => expect(false, "StringBuilder::new should succeed")
    }
}

@test("StringBuilder::is_empty reflects state")
pub fn test_sb_is_empty() {
    let result = StringBuilder::new()
    match result {
        Ok(sb) => {
            var builder = sb
            expect_true(builder.is_empty(), "new builder is empty")

            builder.push_byte(65).unwrap()
            expect_false(builder.is_empty(), "builder with content not empty")
            builder.drop()
        },
        Err(_) => expect(false, "StringBuilder::new should succeed")
    }
}
