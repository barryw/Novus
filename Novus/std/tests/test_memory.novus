// Test suite for std::memory::block memory management
// Tests MemoryBlock, Allocation<T>, and Box<T>

from std::memory::block import MemoryBlock, Allocation, Box
from amiga::raw::consts import MEMF_PUBLIC, MEMF_CLEAR, MEMF_ANY
from amiga::raw::exec import FreeMem
from std::test::test import expect, expect_true, expect_false, expect_eq, expect_not_null

// =============================================================================
// MemoryBlock::alloc tests
// =============================================================================

// @covers std::memory::block::MemoryBlock::alloc(usize, u32)
// @covers std::test::test::expect_eq(T, T, Str)
@test("MemoryBlock::alloc allocates memory")
pub fn test_memblock_alloc() {
    let opt = MemoryBlock::alloc(1024, MEMF_PUBLIC)
    match opt {
        Result::Ok(var block) => {
            expect_eq(block.size(), 1024, "size is 1024")
            expect_false(block.is_empty(), "block is not empty")
            // Drop will free automatically
        },
        Result::Err(_) => expect(false, "allocation should succeed")
    }
}

// @covers std::memory::block::MemoryBlock::alloc(usize, u32)
@test("MemoryBlock::alloc with zero size")
pub fn test_memblock_alloc_zero() {
    let opt = MemoryBlock::alloc(0, MEMF_PUBLIC)
    match opt {
        Result::Ok(var block) => {
            expect_eq(block.size(), 0, "zero size allocation")
            expect_true(block.is_empty(), "zero block is empty")
            expect_eq(block.as_bytes().len(), 0, "zero block has an empty byte view")
            expect_eq(block.as_mut_bytes().len(), 0, "zero block has an empty mutable byte view")
            // Drop will free automatically
        },
        Result::Err(_) => expect(false, "zero allocation should succeed")
    }
}

// @covers std::memory::block::MemoryBlock::alloc(usize, u32)
@test("MemoryBlock::alloc with MEMF_CLEAR zeros memory")
pub fn test_memblock_alloc_clear() {
    let opt = MemoryBlock::alloc(100, MEMF_PUBLIC | MEMF_CLEAR)
    match opt {
        Result::Ok(var block) => {
            let ptr = block.ptr()
            // Check that memory is zeroed
            var all_zero = true
            while var i < 100 {
                if unsafe { ptr[i] } != 0 {
                    all_zero = false
                }
                i = i + 1
            }
            expect_true(all_zero, "MEMF_CLEAR zeros memory")
            // Drop will free automatically
        },
        Result::Err(_) => expect(false, "allocation should succeed")
    }
}

// =============================================================================
// MemoryBlock::try_alloc tests
// =============================================================================

// @covers std::memory::block::MemoryBlock::try_alloc(usize, u32)
@test("MemoryBlock::try_alloc returns Result")
pub fn test_memblock_try_alloc() {
    let result = MemoryBlock::try_alloc(512, MEMF_PUBLIC)
    match result {
        Ok(var block) => {
            expect_eq(block.size(), 512, "size is 512")
            // Drop will free automatically
        },
        Err(_) => expect(false, "try_alloc should succeed")
    }
}

// =============================================================================
// MemoryBlock::ptr and MemoryBlock::size tests
// =============================================================================

// @covers std::memory::block::MemoryBlock::ptr()
@test("MemoryBlock::ptr returns valid pointer")
pub fn test_memblock_ptr() {
    let opt = MemoryBlock::alloc(64, MEMF_PUBLIC)
    match opt {
        Result::Ok(var block) => {
            let ptr = block.ptr()
            // Write and read back
            unsafe {
                ptr[0] = 42
                ptr[1] = 123
                expect_eq(ptr[0], 42, "can write/read byte 0")
                expect_eq(ptr[1], 123, "can write/read byte 1")
            }
            // Drop will free automatically
        },
        Result::Err(_) => expect(false, "allocation should succeed")
    }
}

// @covers std::memory::block::MemoryBlock::size()
@test("MemoryBlock::size returns allocation size")
pub fn test_memblock_size() {
    let opt = MemoryBlock::alloc(256, MEMF_PUBLIC)
    match opt {
        Result::Ok(var block) => {
            expect_eq(block.size(), 256, "size matches request")
            // Drop will free automatically
        },
        Result::Err(_) => expect(false, "allocation should succeed")
    }
}

// =============================================================================
// MemoryBlock::is_empty tests
// =============================================================================

// @covers std::memory::block::MemoryBlock::is_empty()
@test("MemoryBlock::is_empty false for allocated block")
pub fn test_memblock_is_empty_false() {
    let opt = MemoryBlock::alloc(100, MEMF_PUBLIC)
    match opt {
        Result::Ok(var block) => {
            expect_false(block.is_empty(), "allocated block not empty")
            // Drop will free automatically
        },
        Result::Err(_) => expect(false, "allocation should succeed")
    }
}

// @covers std::memory::block::MemoryBlock::is_empty()
@test("MemoryBlock::is_empty true for zero-size block")
pub fn test_memblock_is_empty_true() {
    let opt = MemoryBlock::alloc(0, MEMF_PUBLIC)
    match opt {
        Result::Ok(var block) => {
            expect_true(block.is_empty(), "zero-size block is empty")
            // Drop will free automatically
        },
        Result::Err(_) => expect(false, "allocation should succeed")
    }
}

// =============================================================================
// MemoryBlock::into_raw tests
// =============================================================================

// @covers std::memory::block::MemoryBlock::into_raw()
@test("MemoryBlock::into_raw transfers ownership")
pub fn test_memblock_into_raw() {
    let opt = MemoryBlock::alloc(128, MEMF_PUBLIC)
    match opt {
        Result::Ok(var block) => {
            // Store original values
            let orig_size = block.size()
            let orig_ptr = block.ptr()

            // Transfer ownership
            let _ = block.into_raw()

            // Block should now be empty (size = 0)
            expect_eq(block.size(), 0, "block size is 0 after into_raw")
            expect_true(block.is_empty(), "block is empty after into_raw")

            // Manually free the original pointer since we took ownership
            unsafe {
                FreeMem(orig_ptr, orig_size)
            }
            // Drop on block is now a no-op since size = 0
        },
        Result::Err(_) => expect(false, "allocation should succeed")
    }
}

// =============================================================================
// MemoryBlock::free tests
// =============================================================================

// @covers std::memory::block::MemoryBlock::free()
@test("MemoryBlock::free clears the block")
pub fn test_memblock_free() {
    let opt = MemoryBlock::alloc(64, MEMF_PUBLIC)
    match opt {
        Result::Ok(var block) => {
            expect_false(block.is_empty(), "before free: not empty")

            block.free()

            expect_eq(block.size(), 0, "after free: size is 0")
            expect_true(block.is_empty(), "after free: is empty")
            // Drop is now a no-op since size = 0
        },
        Result::Err(_) => expect(false, "allocation should succeed")
    }
}

// @covers std::memory::block::MemoryBlock::free()
@test("MemoryBlock::free is safe to call twice")
pub fn test_memblock_free_twice() {
    let opt = MemoryBlock::alloc(32, MEMF_PUBLIC)
    match opt {
        Result::Ok(var block) => {
            block.free()
            block.free()  // Should be safe - size is 0 after first free
            expect_true(block.is_empty(), "still empty after double free")
            // Drop is now a no-op since size = 0
        },
        Result::Err(_) => expect(false, "allocation should succeed")
    }
}

// =============================================================================
// MemoryBlock::resize tests
// =============================================================================

// @covers std::memory::block::MemoryBlock::resize(usize, u32)
@test("MemoryBlock::resize grows block")
pub fn test_memblock_resize_grow() {
    let opt = MemoryBlock::alloc(64, MEMF_PUBLIC)
    match opt {
        Result::Ok(var block) => {
            // Write some data
            let ptr = block.ptr()
            unsafe {
                ptr[0] = 11
                ptr[1] = 22
                ptr[2] = 33
            }

            // Resize to larger
            let success = block.resize(256, MEMF_PUBLIC)
            expect_true(success.is_ok(), "resize succeeds")
            expect_eq(block.size(), 256, "new size is 256")

            // Data should be preserved
            let new_ptr = block.ptr()
            unsafe {
                expect_eq(new_ptr[0], 11, "data[0] preserved")
                expect_eq(new_ptr[1], 22, "data[1] preserved")
                expect_eq(new_ptr[2], 33, "data[2] preserved")
            }

            // Drop will free automatically
        },
        Result::Err(_) => expect(false, "allocation should succeed")
    }
}

// @covers std::memory::block::MemoryBlock::resize(usize, u32)
@test("MemoryBlock::resize shrinks block")
pub fn test_memblock_resize_shrink() {
    let opt = MemoryBlock::alloc(256, MEMF_PUBLIC)
    match opt {
        Result::Ok(var block) => {
            // Write data
            let ptr = block.ptr()
            unsafe { ptr[0] = 100 }

            // Resize to smaller
            let success = block.resize(32, MEMF_PUBLIC)
            expect_true(success.is_ok(), "shrink succeeds")
            expect_eq(block.size(), 32, "new size is 32")

            // Data within new bounds preserved
            let new_ptr = block.ptr()
            unsafe { expect_eq(new_ptr[0], 100, "data[0] preserved after shrink") }

            // Drop will free automatically
        },
        Result::Err(_) => expect(false, "allocation should succeed")
    }
}

// @covers std::memory::block::MemoryBlock::resize(usize, u32)
@test("MemoryBlock::resize to same size is no-op")
pub fn test_memblock_resize_same() {
    let opt = MemoryBlock::alloc(100, MEMF_PUBLIC)
    match opt {
        Result::Ok(var block) => {
            let success = block.resize(100, MEMF_PUBLIC)
            expect_true(success.is_ok(), "same-size resize succeeds")
            expect_eq(block.size(), 100, "size unchanged")
            // Drop will free automatically
        },
        Result::Err(_) => expect(false, "allocation should succeed")
    }
}

// @covers std::memory::block::MemoryBlock::new(usize)
// @covers std::memory::block::MemoryBlock::as_bytes()
// @covers std::memory::block::MemoryBlock::as_mut_bytes()
@test("MemoryBlock::new provides zeroed bounded views")
pub fn test_memblock_bounded_views() {
    match MemoryBlock::new(4) {
        Result::Ok(var block) => {
            expect_eq(block.as_bytes().len(), 4, "byte view length")
            {
                var bytes = block.as_mut_bytes()
                expect_true(bytes.set(1, 42).is_ok(), "bounded mutation")
            }
            expect_eq(*block.as_bytes().get(0).unwrap(), 0, "new block is zeroed")
            expect_eq(*block.as_bytes().get(1).unwrap(), 42, "mutation persisted")
        },
        Result::Err(_) => expect(false, "allocation should succeed"),
    }
}

// @covers std::memory::block::RawMemoryBlock::ptr()
// @covers std::memory::block::RawMemoryBlock::size()
// @covers std::memory::block::MemoryBlock::from_raw(RawMemoryBlock)
@test("MemoryBlock raw ownership round-trips")
pub fn test_memblock_raw_roundtrip() {
    match MemoryBlock::new(16) {
        Result::Ok(block) => {
            let raw = block.into_raw()
            expect_not_null(raw.ptr(), "raw pointer")
            expect_eq(raw.size(), 16, "raw size")
            match unsafe { MemoryBlock::from_raw(raw) } {
                Result::Ok(restored) => expect_eq(restored.size(), 16, "restored block"),
                Result::Err(_) => expect(false, "valid raw block rejected"),
            }
        },
        Result::Err(_) => expect(false, "allocation should succeed"),
    }
}

// @covers std::memory::block::Allocation::new(usize, u32)
// @covers std::memory::block::Allocation::try_new(usize, u32)
// @covers std::memory::block::Allocation::count()
// @covers std::memory::block::Allocation::size_bytes()
// @covers std::memory::block::Allocation::as_ptr()
// @covers std::memory::block::Allocation::as_mut_ptr()
// @covers std::memory::block::Allocation::is_empty()
// @covers std::memory::block::Allocation::free()
// @covers std::memory::block::Allocation::resize(usize, u32)
@test("Allocation tracks typed capacity and ownership")
pub fn test_typed_allocation() {
    match Allocation::<u32>::new(3, MEMF_PUBLIC | MEMF_CLEAR) {
        Result::Ok(var allocation) => {
            expect_eq(allocation.count(), 3, "element count")
            expect_eq(allocation.size_bytes(), 12, "byte count")
            expect_false(allocation.is_empty(), "allocation is nonempty")
            let writable = allocation.as_mut_ptr()
            unsafe { writable[1] = 42 }
            let readable = allocation.as_ptr()
            unsafe { expect_eq(readable[1], 42, "typed pointer roundtrip") }
            expect_true(allocation.resize(5, MEMF_PUBLIC).is_ok(), "resize succeeds")
            expect_eq(allocation.count(), 5, "resized count")
            allocation.free()
            expect_true(allocation.is_empty(), "free clears count")
        },
        Result::Err(_) => expect(false, "allocation should succeed"),
    }
    match Allocation::<u16>::try_new(2, MEMF_PUBLIC) {
        Result::Ok(allocation) => expect_eq(allocation.count(), 2, "try_new count"),
        Result::Err(_) => expect(false, "try_new should succeed"),
    }
}

// @covers std::memory::block::Box::new(T)
// @covers std::memory::block::Box::new_in(T, u32)
// @covers std::memory::block::Box::try_new(T)
// @covers std::memory::block::Box::try_new_in(T, u32)
// @covers std::memory::block::Box::get()
// @covers std::memory::block::Box::get_mut()
// @covers std::memory::block::Box::free()
@test("Box owns and mutates one typed value")
pub fn test_box() {
    match Box::<u32>::new(10) {
        Result::Ok(var boxed) => {
            expect_eq(*boxed.get(), 10, "initial value")
            let value = boxed.get_mut()
            *value = 42
            expect_eq(*boxed.get(), 42, "mutated value")
            boxed.free()
        },
        Result::Err(_) => expect(false, "box allocation should succeed"),
    }
    match Box::<u16>::new_in(1, MEMF_PUBLIC) {
        Result::Ok(boxed) => expect_eq(*boxed.get(), 1, "new_in value"),
        Result::Err(_) => expect(false, "new_in should succeed"),
    }
    match Box::<u8>::try_new(2) {
        Result::Ok(boxed) => expect_eq(*boxed.get(), 2, "try_new value"),
        Result::Err(_) => expect(false, "try_new should succeed"),
    }
    match Box::<i32>::try_new_in(-3, MEMF_PUBLIC) {
        Result::Ok(boxed) => expect_eq(*boxed.get(), -3, "try_new_in value"),
        Result::Err(_) => expect(false, "try_new_in should succeed"),
    }
}
