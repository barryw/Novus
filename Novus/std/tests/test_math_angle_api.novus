from std::math::angle import *
from std::math::fixed import Fixed32
from std::test::test import expect

// @covers std::math::angle::angle_approx_eq(u16, u16, u16)
// @covers std::math::angle::angle_between(u16, u16, u16)
// @covers std::math::angle::angle_damp(u16, u16, Fixed32)
// @covers std::math::angle::angle_diff(u16, u16)
// @covers std::math::angle::angle_diff_abs(u16, u16)
// @covers std::math::angle::angle_from_4way(u8)
// @covers std::math::angle::angle_from_8way(u8)
// @covers std::math::angle::angle_from_delta(i32, i32)
// @covers std::math::angle::angle_from_delta_i16(i16, i16)
// @covers std::math::angle::angle_lerp(u16, u16, Fixed32)
// @covers std::math::angle::angle_move_towards(u16, u16, u16)
// @covers std::math::angle::angle_smoothstep(u16, u16, Fixed32)
// @covers std::math::angle::angle_snap(u16, u16)
// @covers std::math::angle::angle_snap_45(u16)
// @covers std::math::angle::angle_snap_4way(u16)
// @covers std::math::angle::angle_snap_8way(u16)
// @covers std::math::angle::angle_snap_90(u16)
// @covers std::math::angle::angle_to_4way(u16)
// @covers std::math::angle::angle_to_8way(u16)
// @covers std::math::angle::facing_down(u16)
// @covers std::math::angle::facing_left(u16)
// @covers std::math::angle::facing_right(u16)
// @covers std::math::angle::facing_up(u16)
// @covers std::math::angle::normalize(u16)
// @covers std::math::angle::normalize_i32(i32)
// @covers std::math::angle::quadrant(u16)
@test("angle public API")
pub fn test_angle_public_api() {
    let half = Fixed32::from_raw(32768)
    expect(normalize(7) == 7 && normalize_i32(-1) == 65535, "normalization")
    let _ = angle_diff(0, 100)
    let _ = angle_diff_abs(0, 100)
    let _ = angle_between(50, 0, 100)
    let _ = angle_approx_eq(50, 51, 1)
    let _ = angle_lerp(0, 100, half)
    let _ = angle_smoothstep(0, 100, half)
    let _ = angle_move_towards(0, 100, 10)
    let _ = angle_damp(0, 100, half)
    let _ = angle_snap(51, 10)
    let _ = angle_snap_45(5000)
    let _ = angle_snap_90(10000)
    let _ = angle_snap_8way(5000)
    let _ = angle_snap_4way(10000)
    let _ = angle_to_8way(5000)
    let _ = angle_to_4way(10000)
    let _ = angle_from_8way(1)
    let _ = angle_from_4way(1)
    let _ = quadrant(20000)
    let _ = facing_right(0)
    let _ = facing_left(32768)
    let _ = facing_up(49152)
    let _ = facing_down(16384)
    let _ = angle_from_delta(1, 1)
    let _ = angle_from_delta_i16(1, 1)
}
