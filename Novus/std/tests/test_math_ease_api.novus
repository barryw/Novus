from std::math::ease import *
from std::math::fixed import Fixed32
from std::test::test import expect

// @covers std::math::ease::ease_in_back(Fixed32)
// @covers std::math::ease::ease_in_bounce(Fixed32)
// @covers std::math::ease::ease_in_circ(Fixed32)
// @covers std::math::ease::ease_in_cubic(Fixed32)
// @covers std::math::ease::ease_in_elastic(Fixed32)
// @covers std::math::ease::ease_in_expo(Fixed32)
// @covers std::math::ease::ease_in_out_back(Fixed32)
// @covers std::math::ease::ease_in_out_bounce(Fixed32)
// @covers std::math::ease::ease_in_out_circ(Fixed32)
// @covers std::math::ease::ease_in_out_cubic(Fixed32)
// @covers std::math::ease::ease_in_out_elastic(Fixed32)
// @covers std::math::ease::ease_in_out_expo(Fixed32)
// @covers std::math::ease::ease_in_out_quad(Fixed32)
// @covers std::math::ease::ease_in_out_quart(Fixed32)
// @covers std::math::ease::ease_in_out_quint(Fixed32)
// @covers std::math::ease::ease_in_out_sine(Fixed32)
// @covers std::math::ease::ease_in_quad(Fixed32)
// @covers std::math::ease::ease_in_quart(Fixed32)
// @covers std::math::ease::ease_in_quint(Fixed32)
// @covers std::math::ease::ease_in_sine(Fixed32)
// @covers std::math::ease::ease_linear(Fixed32)
// @covers std::math::ease::ease_out_back(Fixed32)
// @covers std::math::ease::ease_out_bounce(Fixed32)
// @covers std::math::ease::ease_out_circ(Fixed32)
// @covers std::math::ease::ease_out_cubic(Fixed32)
// @covers std::math::ease::ease_out_elastic(Fixed32)
// @covers std::math::ease::ease_out_expo(Fixed32)
// @covers std::math::ease::ease_out_quad(Fixed32)
// @covers std::math::ease::ease_out_quart(Fixed32)
// @covers std::math::ease::ease_out_quint(Fixed32)
// @covers std::math::ease::ease_out_sine(Fixed32)
// @covers std::math::ease::ease_steps(Fixed32, i32)
// @covers std::math::ease::ease_steps_start(Fixed32, i32)
@test("easing public API")
pub fn test_easing_public_api() {
    let t = Fixed32::from_raw(32768)
    expect(ease_linear(t).to_raw() == t.to_raw(), "linear")
    let _ = ease_in_quad(t)
    let _ = ease_out_quad(t)
    let _ = ease_in_out_quad(t)
    let _ = ease_in_cubic(t)
    let _ = ease_out_cubic(t)
    let _ = ease_in_out_cubic(t)
    let _ = ease_in_quart(t)
    let _ = ease_out_quart(t)
    let _ = ease_in_out_quart(t)
    let _ = ease_in_quint(t)
    let _ = ease_out_quint(t)
    let _ = ease_in_out_quint(t)
    let _ = ease_in_sine(t)
    let _ = ease_out_sine(t)
    let _ = ease_in_out_sine(t)
    let _ = ease_in_expo(t)
    let _ = ease_out_expo(t)
    let _ = ease_in_out_expo(t)
    let _ = ease_in_circ(t)
    let _ = ease_out_circ(t)
    let _ = ease_in_out_circ(t)
    let _ = ease_in_back(t)
    let _ = ease_out_back(t)
    let _ = ease_in_out_back(t)
    let _ = ease_in_elastic(t)
    let _ = ease_out_elastic(t)
    let _ = ease_in_out_elastic(t)
    let _ = ease_in_bounce(t)
    let _ = ease_out_bounce(t)
    let _ = ease_in_out_bounce(t)
    let _ = ease_steps(t, 4)
    let _ = ease_steps_start(t, 4)
}
