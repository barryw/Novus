// ============================================================================
// Window Manipulation Tests
// ============================================================================

@test("WindowHandle::to_front and to_back don't crash")
pub fn test_window_depth_operations() {
    let result = WindowHandle::simple("Depth Test", 200, 150)
    match result {
        Result::Ok(window) => {
            var w = window
            // These shouldn't crash
            w.to_front()
            w.to_back()
            w.to_front()
            expect(true, "depth operations completed")
        },
        Result::Err(_) => {
            expect(false, "window should open")
        }
    }
}

@test("WindowHandle::activate gives focus")
pub fn test_window_activate() {
    let result = WindowHandle::simple("Activate Test", 200, 150)
    match result {
        Result::Ok(window) => {
            var w = window
            w.activate()
            expect(true, "activate completed without crash")
        },
        Result::Err(_) => {
            expect(false, "window should open")
        }
    }
}

@test("WindowHandle::move_by changes position")
pub fn test_window_move_by() {
    let result = WindowHandle::simple("Move Test", 200, 150)
    match result {
        Result::Ok(window) => {
            var w = window
            // Move the window
            w.move_by(10, 10)
            w.move_by(-5, -5)
            expect(true, "move_by completed without crash")
        },
        Result::Err(_) => {
            expect(false, "window should open")
        }
    }
}

@test("WindowHandle::resize_by changes size")
pub fn test_window_resize_by() {
    let result = WindowHandle::simple("Resize Test", 200, 150)
    match result {
        Result::Ok(window) => {
            var w = window
            let orig_width = w.width()
            let orig_height = w.height()

            // Resize the window
            w.resize_by(50, 30)

            // New size should be larger (may not be exact due to constraints)
            expect_true(w.width() >= orig_width, "width should increase or stay same")
            expect_true(w.height() >= orig_height, "height should increase or stay same")
        },
        Result::Err(_) => {
            expect(false, "window should open")
        }
    }
}

