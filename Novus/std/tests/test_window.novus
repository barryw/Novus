// Window Tests for Novus Standard Library
// Tests window creation, manipulation, and cleanup
from std::test::test import expect, expect_true, expect_eq
from amiga::sys::intuition import WindowHandle, open_window
from amiga::raw::structs import TagItem, Window, MsgPort, Screen
from amiga::raw::consts import TAG_DONE, WA_Left, WA_Top, WA_Width, WA_Height, WA_Title, WA_Flags, WA_IDCMP
from amiga::raw::consts import WFLG_CLOSEGADGET, WFLG_DRAGBAR, WFLG_DEPTHGADGET, WFLG_SIZEGADGET, WFLG_BORDERLESS, WFLG_ACTIVATE
from amiga::raw::consts import WFLG_WINDOWACTIVE, WFLG_ZOOMED
from amiga::raw::consts import IDCMP_CLOSEWINDOW
from amiga::raw::graphics import WaitTOF
from amiga::raw::layers import WhichLayer
from amiga::sys::intuition::errors import IntuitionError

fn wait_for_intuition() {
    for frame in 0..10 {
        unsafe { WaitTOF() }
    }
}

// ============================================================================
// Window Creation Tests
// ============================================================================
// @covers-ndk function|intuition.library|OpenWindowTagList
// @covers-ndk function|intuition.library|CloseWindow
// @ndk-side-effects OpenWindowTagList creates a real Workbench window and its IDCMP port; WindowHandle Drop drains messages and CloseWindow releases both, with the suite-level memory check proving no retained allocation
// @covers amiga::sys::intuition::window::WindowHandle::simple(Str, i16, i16)
@test("WindowHandle::simple opens a window successfully")
pub fn test_window_simple_opens() {
    let result = WindowHandle::simple("Test Window", 200, 150)
    match result {
        Result::Ok(window) => {
            var w = window
            expect_true(w.as_raw() != (*Window)0, "window pointer should be non-null")
        },
        // Window is automatically closed when w goes out of scope (Drop)
        Result::Err(_) => {
            expect(false, "WindowHandle::simple should succeed")
        }
    }
}

// @covers amiga::sys::intuition::window::WindowHandle::width()
// @covers amiga::sys::intuition::window::WindowHandle::height()
@test("WindowHandle::simple has correct dimensions")
pub fn test_window_simple_dimensions() {
    let result = WindowHandle::simple("Dim Test", 320, 200)
    match result {
        Result::Ok(window) => {
            var w = window
            // Note: actual dimensions may differ slightly due to borders
            expect_true(w.width() >= 320, "width should be at least requested")
            expect_true(w.height() >= 200, "height should be at least requested")
        },
        Result::Err(_) => {
            expect(false, "window should open")
        }
    }
}

// @covers amiga::sys::intuition::window::WindowHandle::borderless(i16, i16)
@test("WindowHandle::borderless opens without borders")
pub fn test_window_borderless_opens() {
    let result = WindowHandle::borderless(100, 80)
    match result {
        Result::Ok(window) => {
            var w = window
            expect_true(w.as_raw() != (*Window)0, "borderless window should open")
            // Borderless windows have exact dimensions
            expect_eq((i32)w.width(), 100, "borderless width exact")
            expect_eq((i32)w.height(), 80, "borderless height exact")
        },
        Result::Err(_) => {
            expect(false, "borderless window should open")
        }
    }
}

