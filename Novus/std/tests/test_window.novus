// ============================================================================
// Multiple Windows Tests
// ============================================================================
@test("Multiple windows can be opened simultaneously")
pub fn test_multiple_windows() {
    let result1 = WindowHandle::simple("Window 1", 200, 150)
    let result2 = WindowHandle::simple("Window 2", 200, 150)
    let result3 = WindowHandle::simple("Window 3", 200, 150)
    match result1 {
        Result::Ok(w1) => {
            var window1 = w1
            match result2 {
                Result::Ok(w2) => {
                    var window2 = w2
                    match result3 {
                        Result::Ok(w3) => {
                            var window3 = w3
                            // All three windows should be open
                            expect_true(window1.as_raw() != window2.as_raw(), "windows have different handles")
                            expect_true(window2.as_raw() != window3.as_raw(), "windows have different handles")
                        },
                        Result::Err(_) => expect(false, "window 3 should open")
                    }
                },
                Result::Err(_) => expect(false, "window 2 should open")
            }
        },
        Result::Err(_) => expect(false, "window 1 should open")
    }
}

// @covers-ndk function|intuition.library|MoveWindowInFrontOf
// @covers-ndk function|layers.library|WhichLayer
// @ndk-side-effects MoveWindowInFrontOf rearranges overlapping window layers and WhichLayer observes the target above its peer at their shared coordinate
// @covers amiga::sys::intuition::window::WindowHandle::move_in_front_of(&WindowHandle)
@test("WindowHandle::move_in_front_of changes depth order")
pub fn test_window_move_in_front_of() {
    let result1 = WindowHandle::simple("Back", 200, 150)
    let result2 = WindowHandle::simple("Front", 200, 150)
    match result1 {
        Result::Ok(w1) => {
            var back_window = w1
            match result2 {
                Result::Ok(w2) => {
                    var front_window = w2
                    // Move back_window in front of front_window
                    back_window.move_in_front_of(&front_window)
                    wait_for_intuition()
                    unsafe {
                        let screen = (*back_window.as_raw()).WScreen
                        expect(WhichLayer(&(*screen).LayerInfo, 60, 80) == (*back_window.as_raw()).WLayer, "MoveWindowInFrontOf makes the target visible above its peer")
                    }
                },
                Result::Err(_) => expect(false, "front window should open")
            }
        },
        Result::Err(_) => expect(false, "back window should open")
    }
}
