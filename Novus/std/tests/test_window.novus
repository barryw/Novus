// @covers-ndk function|intuition.library|ModifyIDCMP
// @ndk-side-effects ModifyIDCMP replaces the window's live event subscription with exactly IDCMP_CLOSEWINDOW and reports success
// @covers amiga::sys::intuition::window::WindowHandle::modify_idcmp(u32)
@test("WindowHandle::modify_idcmp changes event mask")
pub fn test_window_modify_idcmp() {
    let result = WindowHandle::simple("IDCMP Test", 200, 150)
    match result {
        Result::Ok(window) => {
            var w = window
            let modify_result = w.modify_idcmp(IDCMP_CLOSEWINDOW)
            match modify_result {
                Result::Ok(_) => unsafe {
                    expect((*w.as_raw()).IDCMPFlags == IDCMP_CLOSEWINDOW, "ModifyIDCMP stores the requested event mask")
                },
                Result::Err(_) => expect(false, "modify_idcmp should succeed")
            }
        },
        Result::Err(_) => {
            expect(false, "window should open")
        }
    }
}

// @covers-ndk function|intuition.library|SetMouseQueue
// @ndk-side-effects SetMouseQueue installs a 20-message mouse queue and the restoring call returns 20 as the exact replaced limit
// @covers amiga::sys::intuition::window::WindowHandle::set_mouse_queue(u16)
@test("WindowHandle::set_mouse_queue changes queue size")
pub fn test_window_set_mouse_queue() {
    let result = WindowHandle::simple("Queue Test", 200, 150)
    match result {
        Result::Ok(window) => {
            var w = window
            let old_size = w.set_mouse_queue(20)
            expect_true(old_size >= 0, "old queue size should be valid")
            let replaced_size = w.set_mouse_queue((u16)old_size)
            expect(replaced_size == 20, "SetMouseQueue returns the queue size it replaced")
        },
        Result::Err(_) => {
            expect(false, "window should open")
        }
    }
}

