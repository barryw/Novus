// ============================================================================
// Window Manipulation Tests
// ============================================================================
// @covers-ndk function|intuition.library|WindowToFront
// @covers-ndk function|intuition.library|WindowToBack
// @covers-ndk function|layers.library|WhichLayer
// @ndk-side-effects WindowToFront and WindowToBack defer layer rearrangement to Intuition; WhichLayer observes the target alternately above and below an overlapping peer after input ticks
// @covers amiga::sys::intuition::window::WindowHandle::to_front()
// @covers amiga::sys::intuition::window::WindowHandle::to_back()
@test("WindowHandle::to_front and to_back change depth order")
pub fn test_window_depth_operations() {
    let result = WindowHandle::simple("Depth Test", 200, 150)
    match result {
        Result::Ok(window) => {
            var w = window
            match WindowHandle::simple("Depth Peer", 180, 120) {
                Result::Ok(peer_window) => {
                    var peer = peer_window
                    let screen = w.get_screen()
                    w.to_front()
                    wait_for_intuition()
                    unsafe {
                        expect(WhichLayer(&(*screen).LayerInfo, 60, 80) == (*w.as_raw()).WLayer, "WindowToFront makes the target visible above its peer")
                    }
                    w.to_back()
                    wait_for_intuition()
                    unsafe {
                        expect(WhichLayer(&(*screen).LayerInfo, 60, 80) != (*w.as_raw()).WLayer, "WindowToBack places the peer above the target")
                    }
                    w.to_front()
                    wait_for_intuition()
                    unsafe {
                        expect(WhichLayer(&(*screen).LayerInfo, 60, 80) == (*w.as_raw()).WLayer, "target can return above its peer")
                    }
                },
                Result::Err(_) => expect(false, "peer window should open")
            }
        },
        Result::Err(_) => {
            expect(false, "window should open")
        }
    }
}

// @covers-ndk function|intuition.library|ActivateWindow
// @ndk-side-effects ActivateWindow transfers WFLG_WINDOWACTIVE from the peer to the target after Intuition processes the requests
// @covers amiga::sys::intuition::window::WindowHandle::activate()
@test("WindowHandle::activate gives focus")
pub fn test_window_activate() {
    let result = WindowHandle::simple("Activate Test", 200, 150)
    match result {
        Result::Ok(window) => {
            var w = window
            match WindowHandle::simple("Activate Peer", 180, 120) {
                Result::Ok(peer_window) => {
                    var peer = peer_window
                    peer.activate()
                    wait_for_intuition()
                    w.activate()
                    wait_for_intuition()
                    unsafe {
                        expect(((*w.as_raw()).Flags & WFLG_WINDOWACTIVE) != 0, "ActivateWindow marks the target active")
                        expect(((*peer.as_raw()).Flags & WFLG_WINDOWACTIVE) == 0, "ActivateWindow clears the previous active window")
                    }
                },
                Result::Err(_) => expect(false, "peer window should open")
            }
        },
        Result::Err(_) => {
            expect(false, "window should open")
        }
    }
}

// @covers-ndk function|intuition.library|MoveWindow
// @ndk-side-effects MoveWindow defers each signed relative move; the live Window records the exact accumulated LeftEdge and TopEdge deltas after input ticks
// @covers amiga::sys::intuition::window::WindowHandle::move_by(i16, i16)
@test("WindowHandle::move_by changes position")
pub fn test_window_move_by() {
    let result = WindowHandle::simple("Move Test", 200, 150)
    match result {
        Result::Ok(window) => {
            var w = window
            let raw = w.as_raw()
            let original_left = unsafe { (*raw).LeftEdge }
            let original_top = unsafe { (*raw).TopEdge }

            w.move_by(10, 10)
            wait_for_intuition()
            unsafe {
                expect((*raw).LeftEdge == original_left + 10 && (*raw).TopEdge == original_top + 10, "MoveWindow applies the requested positive delta")
            }
            w.move_by(-5, -5)
            wait_for_intuition()
            unsafe {
                expect((*raw).LeftEdge == original_left + 5 && (*raw).TopEdge == original_top + 5, "MoveWindow applies the requested negative delta")
            }
        },
        Result::Err(_) => {
            expect(false, "window should open")
        }
    }
}

// @covers-ndk function|intuition.library|SizeWindow
// @ndk-side-effects SizeWindow defers resizing and updates the live Window to the exact requested width and height within its limits
// @covers amiga::sys::intuition::window::WindowHandle::resize_by(i16, i16)
@test("WindowHandle::resize_by changes size")
pub fn test_window_resize_by() {
    let result = WindowHandle::simple("Resize Test", 200, 150)
    match result {
        Result::Ok(window) => {
            var w = window
            let orig_width = w.width()
            let orig_height = w.height()
            // Resize the window
            w.resize_by(50, 30)
            wait_for_intuition()
            expect_true(w.width() == orig_width + 50, "SizeWindow applies the requested width delta")
            expect_true(w.height() == orig_height + 30, "SizeWindow applies the requested height delta")
        },
        Result::Err(_) => {
            expect(false, "window should open")
        }
    }
}

// @covers-ndk function|intuition.library|ChangeWindowBox
// @ndk-side-effects ChangeWindowBox defers one atomic absolute position and size change; all four live Window fields match after an input tick
// @covers amiga::sys::intuition::window::WindowHandle::set_bounds(i16, i16, i16, i16)
@test("WindowHandle::set_bounds sets position and size")
pub fn test_window_set_bounds() {
    let result = WindowHandle::simple("Bounds Test", 200, 150)
    match result {
        Result::Ok(window) => {
            var w = window
            w.set_bounds(120, 80, 300, 220)
            wait_for_intuition()
            let raw = w.as_raw()
            unsafe {
                expect((*raw).LeftEdge == 120 && (*raw).TopEdge == 80 && (*raw).Width == 300 && (*raw).Height == 220, "ChangeWindowBox applies the requested position and size")
            }
        },
        Result::Err(_) => {
            expect(false, "window should open")
        }
    }
}

// @covers-ndk function|intuition.library|WindowLimits
// @ndk-side-effects WindowLimits accepts four valid constraints containing the current size and stores the exact minimum and maximum dimensions
// @covers amiga::sys::intuition::window::WindowHandle::set_limits(i32, i32, u32, u32)
@test("WindowHandle::set_limits constrains sizing")
pub fn test_window_set_limits() {
    let result = WindowHandle::simple("Limits Test", 200, 150)
    match result {
        Result::Ok(window) => {
            var w = window
            let accepted = w.set_limits(100, 80, 400, 300)
            let raw = w.as_raw()
            unsafe {
                expect((*raw).MinWidth == 100 && (*raw).MinHeight == 80 && (*raw).MaxWidth == 400 && (*raw).MaxHeight == 300, "WindowLimits stores all four constraints")
            }
            expect_true(accepted, "WindowLimits accepts constraints containing the current size")
        },
        Result::Err(_) => {
            expect(false, "window should open")
        }
    }
}

// @covers-ndk function|intuition.library|ZipWindow
// @ndk-side-effects ZipWindow defers each change and toggles WFLG_ZOOMED on the first input tick, then restores the original state on the second
// @covers amiga::sys::intuition::window::WindowHandle::zoom()
@test("WindowHandle::zoom toggles size")
pub fn test_window_zoom() {
    let result = WindowHandle::simple("Zoom Test", 200, 150)
    match result {
        Result::Ok(window) => {
            var w = window
            let raw = w.as_raw()
            let initially_zoomed = unsafe { ((*raw).Flags & WFLG_ZOOMED) != 0 }

            w.zoom()
            wait_for_intuition()
            let toggled = unsafe { ((*raw).Flags & WFLG_ZOOMED) != 0 }

            expect(toggled != initially_zoomed, "ZipWindow toggles WFLG_ZOOMED")
            w.zoom()
            wait_for_intuition()
            // Toggle back
            unsafe {
                expect((((*raw).Flags & WFLG_ZOOMED) != 0) == initially_zoomed, "second ZipWindow restores the original zoom state")
            }
        },
        Result::Err(_) => {
            expect(false, "window should open")
        }
    }
}

