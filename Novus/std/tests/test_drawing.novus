// Drawing Tests for Novus Standard Library
// Tests graphics primitives by drawing and reading back pixels

from std::test::test import expect, expect_true, expect_false, expect_eq
from amiga::sys::intuition import ScreenHandle, WindowHandle
from amiga::sys::graphics::draw import DrawContext, DrawMode
from amiga::sys::graphics::shapes import Point, Rect
from amiga::raw::structs import Window, RastPort
from amiga::sys::graphics::errors import GraphicsError

// ============================================================================
// DrawContext Creation Tests
// ============================================================================

@test("DrawContext::from_window creates context from window")
pub fn test_draw_context_from_window() {
    let win_result = WindowHandle::simple("Draw Test", 200, 150)
    match win_result {
        Result::Ok(window) => {
            var w = window
            let ctx_result = DrawContext::from_rastport(w.rastport())
            match ctx_result {
                Result::Ok(ctx) => {
                    expect(true, "DrawContext created successfully")
                },
                Result::Err(_) => {
                    expect(false, "DrawContext::from_window should succeed")
                }
            }
        },
        Result::Err(_) => expect(false, "window should open")
    }
}

@test("DrawContext::from_rastport rejects null pointer")
pub fn test_draw_context_null_rastport() {
    let ctx_result = unsafe { DrawContext::borrow_raw((*RastPort)0) }
    match ctx_result {
        Result::Ok(_) => expect(false, "should reject null RastPort"),
        Result::Err(err) => {
            // Should get InvalidRastPort error
            expect(true, "correctly rejected null RastPort")
        }
    }
}

// ============================================================================
// Pen Operations Tests
// ============================================================================

@test("DrawContext::pen and get_pen work correctly")
pub fn test_draw_pen_get_set() {
    let win_result = WindowHandle::simple("Pen Test", 200, 150)
    match win_result {
        Result::Ok(window) => {
            var w = window
            let ctx_result = DrawContext::from_rastport(w.rastport())
            match ctx_result {
                Result::Ok(ctx) => {
                    // Set pen to color 1
                    ctx.pen(1)
                    let pen = ctx.pen_color()
                    expect_eq((u32)pen, 1, "get_pen returns set value")

                    // Set to color 2
                    ctx.pen(2)
                    let pen2 = ctx.pen_color()
                    expect_eq((u32)pen2, 2, "get_pen returns new value")
                },
                Result::Err(_) => expect(false, "context should create")
            }
        },
        Result::Err(_) => expect(false, "window should open")
    }
}

