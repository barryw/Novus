from std::math::fixed import Fixed32
from std::math::vec2 import *
from std::test::test import expect

// @covers std::math::vec2::Vec2::add(Vec2)
// @covers std::math::vec2::Vec2::clamp(Vec2, Vec2)
// @covers std::math::vec2::Vec2::clamp_rect(Fixed32, Fixed32, Fixed32, Fixed32)
// @covers std::math::vec2::Vec2::cross(Vec2)
// @covers std::math::vec2::Vec2::div(Fixed32)
// @covers std::math::vec2::Vec2::div_i32(i32)
// @covers std::math::vec2::Vec2::dot(Vec2)
// @covers std::math::vec2::Vec2::eq(Vec2)
// @covers std::math::vec2::Vec2::from_i16(i16, i16)
// @covers std::math::vec2::Vec2::from_i32(i32, i32)
// @covers std::math::vec2::Vec2::get_x()
// @covers std::math::vec2::Vec2::get_y()
// @covers std::math::vec2::Vec2::hadamard(Vec2)
// @covers std::math::vec2::Vec2::is_zero()
// @covers std::math::vec2::Vec2::length_approx()
// @covers std::math::vec2::Vec2::length_sq()
// @covers std::math::vec2::Vec2::max(Vec2)
// @covers std::math::vec2::Vec2::min(Vec2)
// @covers std::math::vec2::Vec2::neg()
// @covers std::math::vec2::Vec2::new(Fixed32, Fixed32)
// @covers std::math::vec2::Vec2::perp()
// @covers std::math::vec2::Vec2::perp_cw()
// @covers std::math::vec2::Vec2::reflect(Vec2)
// @covers std::math::vec2::Vec2::rotate(u16)
// @covers std::math::vec2::Vec2::rotate_180()
// @covers std::math::vec2::Vec2::rotate_270()
// @covers std::math::vec2::Vec2::rotate_90()
// @covers std::math::vec2::Vec2::scale(Fixed32)
// @covers std::math::vec2::Vec2::scale_i32(i32)
// @covers std::math::vec2::Vec2::set_x(Fixed32)
// @covers std::math::vec2::Vec2::set_y(Fixed32)
// @covers std::math::vec2::Vec2::sub(Vec2)
// @covers std::math::vec2::Vec2::to_i16()
// @covers std::math::vec2::Vec2::to_i32()
// @covers std::math::vec2::Vec2::to_i32_rounded()
// @covers std::math::vec2::Vec2::unit_x()
// @covers std::math::vec2::Vec2::unit_y()
// @covers std::math::vec2::Vec2::zero()
// @covers std::math::vec2::Vec2i::add(Vec2i)
// @covers std::math::vec2::Vec2i::cross(Vec2i)
// @covers std::math::vec2::Vec2i::dot(Vec2i)
// @covers std::math::vec2::Vec2i::eq(Vec2i)
// @covers std::math::vec2::Vec2i::get_x()
// @covers std::math::vec2::Vec2i::get_y()
// @covers std::math::vec2::Vec2i::is_zero()
// @covers std::math::vec2::Vec2i::length_sq()
// @covers std::math::vec2::Vec2i::max(Vec2i)
// @covers std::math::vec2::Vec2i::min(Vec2i)
// @covers std::math::vec2::Vec2i::neg()
// @covers std::math::vec2::Vec2i::new(i32, i32)
// @covers std::math::vec2::Vec2i::perp()
// @covers std::math::vec2::Vec2i::scale(i32)
// @covers std::math::vec2::Vec2i::sub(Vec2i)
// @covers std::math::vec2::Vec2i::to_vec2()
// @covers std::math::vec2::Vec2i::unit_x()
// @covers std::math::vec2::Vec2i::unit_y()
// @covers std::math::vec2::Vec2i::zero()
// @covers std::math::vec2::angle_from_direction(Vec2)
// @covers std::math::vec2::direction_from_angle(u16)
// @covers std::math::vec2::distance_approx(Vec2, Vec2)
// @covers std::math::vec2::distance_sq(Vec2, Vec2)
// @covers std::math::vec2::lerp_vec2(Vec2, Vec2, Fixed32)
@test("vector public API")
pub fn test_vector_public_api() {
    let one = Fixed32::one()
    var a = Vec2::new(one, Fixed32::from_i32(2))
    let b = Vec2::from_i32(3, 4)
    let _ = Vec2::from_i16(3, 4)
    let _ = Vec2::zero()
    let _ = Vec2::unit_x()
    let _ = Vec2::unit_y()
    expect(a.get_x().to_i32() == 1, "x coordinate")
    let _ = a.get_y()
    a.set_x(one)
    a.set_y(one)
    let _ = a.to_i32()
    let _ = a.to_i32_rounded()
    let _ = a.to_i16()
    let _ = a.add(b)
    let _ = a.sub(b)
    let _ = a.neg()
    let _ = a.scale(one)
    let _ = a.scale_i32(2)
    let _ = a.div(one)
    let _ = a.div_i32(2)
    let _ = a.hadamard(b)
    let _ = a.dot(b)
    let _ = a.cross(b)
    let _ = a.length_sq()
    let _ = a.length_approx()
    let _ = a.is_zero()
    let _ = a.eq(b)
    let _ = a.min(b)
    let _ = a.max(b)
    let _ = a.clamp(Vec2::zero(), b)
    let _ = a.clamp_rect(Fixed32::zero(), Fixed32::zero(), one, one)
    let _ = a.perp()
    let _ = a.perp_cw()
    let _ = a.reflect(Vec2::unit_x())
    let _ = a.rotate(0)
    let _ = a.rotate_90()
    let _ = a.rotate_180()
    let _ = a.rotate_270()
    let _ = distance_sq(a, b)
    let _ = distance_approx(a, b)
    let _ = lerp_vec2(a, b, one)
    let direction = direction_from_angle(0)
    let _ = angle_from_direction(direction)

    let p = Vec2i::new(1, 2)
    let q = Vec2i::new(3, 4)
    let _ = Vec2i::zero()
    let _ = Vec2i::unit_x()
    let _ = Vec2i::unit_y()
    let _ = p.get_x()
    let _ = p.get_y()
    let _ = p.add(q)
    let _ = p.sub(q)
    let _ = p.neg()
    let _ = p.scale(2)
    let _ = p.dot(q)
    let _ = p.cross(q)
    let _ = p.length_sq()
    let _ = p.is_zero()
    let _ = p.eq(q)
    let _ = p.min(q)
    let _ = p.max(q)
    let _ = p.perp()
    let _ = p.to_vec2()
}
