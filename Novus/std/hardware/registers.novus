// Hardware register constants for Amiga custom chip
// Module: std::hardware::registers
//
// This module provides symbolic names for Amiga custom chip registers.
// All register addresses are offsets from the custom chip base ($DFF000).
//
// Safety: These are just constants - actual hardware access must be in unsafe blocks
// or through the safe wrapper APIs in std::graphics::copper

// Custom chip base address
pub const CUSTOM_BASE: u32 = $DFF000

//
// Copper Registers
//

pub const COP1LC: u32 = $080   // Copper list 1 location (pointer)
pub const COP2LC: u32 = $084   // Copper list 2 location (pointer)
pub const COPJMP1: u32 = $088  // Copper jump 1 (strobe)
pub const COPJMP2: u32 = $08A  // Copper jump 2 (strobe)

//
// Display Control Registers
//

pub const BPLCON0: u32 = $100  // Bitplane control register 0
pub const BPLCON1: u32 = $102  // Bitplane control register 1
pub const BPLCON2: u32 = $104  // Bitplane control register 2
pub const BPL1MOD: u32 = $108  // Bitplane modulo (odd planes)
pub const BPL2MOD: u32 = $10A  // Bitplane modulo (even planes)

//
// Bitplane Pointer Registers
//

pub const BPL1PTH: u32 = $0E0  // Bitplane 1 pointer (high 3 bits)
pub const BPL1PTL: u32 = $0E2  // Bitplane 1 pointer (low 15 bits)
pub const BPL2PTH: u32 = $0E4  // Bitplane 2 pointer (high 3 bits)
pub const BPL2PTL: u32 = $0E6  // Bitplane 2 pointer (low 15 bits)
pub const BPL3PTH: u32 = $0E8  // Bitplane 3 pointer (high 3 bits)
pub const BPL3PTL: u32 = $0EA  // Bitplane 3 pointer (low 15 bits)
pub const BPL4PTH: u32 = $0EC  // Bitplane 4 pointer (high 3 bits)
pub const BPL4PTL: u32 = $0EE  // Bitplane 4 pointer (low 15 bits)
pub const BPL5PTH: u32 = $0F0  // Bitplane 5 pointer (high 3 bits)
pub const BPL5PTL: u32 = $0F2  // Bitplane 5 pointer (low 15 bits)
pub const BPL6PTH: u32 = $0F4  // Bitplane 6 pointer (high 3 bits)
pub const BPL6PTL: u32 = $0F6  // Bitplane 6 pointer (low 15 bits)
pub const BPL7PTH: u32 = $0F8  // Bitplane 7 pointer (high 3 bits) [AGA only]
pub const BPL7PTL: u32 = $0FA  // Bitplane 7 pointer (low 15 bits) [AGA only]
pub const BPL8PTH: u32 = $0FC  // Bitplane 8 pointer (high 3 bits) [AGA only]
pub const BPL8PTL: u32 = $0FE  // Bitplane 8 pointer (low 15 bits) [AGA only]

//
// Display Window Registers
//

pub const DIWSTRT: u32 = $08E  // Display window start
pub const DIWSTOP: u32 = $090  // Display window stop
pub const DDFSTRT: u32 = $092  // Display data fetch start
pub const DDFSTOP: u32 = $094  // Display data fetch stop

//
// Sprite Registers
//

pub const SPR0PTH: u32 = $120  // Sprite 0 pointer (high 3 bits)
pub const SPR0PTL: u32 = $122  // Sprite 0 pointer (low 15 bits)
pub const SPR1PTH: u32 = $124  // Sprite 1 pointer (high 3 bits)
pub const SPR1PTL: u32 = $126  // Sprite 1 pointer (low 15 bits)
pub const SPR2PTH: u32 = $128  // Sprite 2 pointer (high 3 bits)
pub const SPR2PTL: u32 = $12A  // Sprite 2 pointer (low 15 bits)
pub const SPR3PTH: u32 = $12C  // Sprite 3 pointer (high 3 bits)
pub const SPR3PTL: u32 = $12E  // Sprite 3 pointer (low 15 bits)
pub const SPR4PTH: u32 = $130  // Sprite 4 pointer (high 3 bits)
pub const SPR4PTL: u32 = $132  // Sprite 4 pointer (low 15 bits)
pub const SPR5PTH: u32 = $134  // Sprite 5 pointer (high 3 bits)
pub const SPR5PTL: u32 = $136  // Sprite 5 pointer (low 15 bits)
pub const SPR6PTH: u32 = $138  // Sprite 6 pointer (high 3 bits)
pub const SPR6PTL: u32 = $13A  // Sprite 6 pointer (low 15 bits)
pub const SPR7PTH: u32 = $13C  // Sprite 7 pointer (high 3 bits)
pub const SPR7PTL: u32 = $13E  // Sprite 7 pointer (low 15 bits)

//
// Color Registers (32 colors in OCS/ECS, 256 in AGA)
//

pub const COLOR00: u32 = $180  // Color 0 (background)
pub const COLOR01: u32 = $182  // Color 1
pub const COLOR02: u32 = $184  // Color 2
pub const COLOR03: u32 = $186  // Color 3
pub const COLOR04: u32 = $188  // Color 4
pub const COLOR05: u32 = $18A  // Color 5
pub const COLOR06: u32 = $18C  // Color 6
pub const COLOR07: u32 = $18E  // Color 7
pub const COLOR08: u32 = $190  // Color 8
pub const COLOR09: u32 = $192  // Color 9
pub const COLOR10: u32 = $194  // Color 10
pub const COLOR11: u32 = $196  // Color 11
pub const COLOR12: u32 = $198  // Color 12
pub const COLOR13: u32 = $19A  // Color 13
pub const COLOR14: u32 = $19C  // Color 14
pub const COLOR15: u32 = $19E  // Color 15
pub const COLOR16: u32 = $1A0  // Color 16
pub const COLOR17: u32 = $1A2  // Color 17
pub const COLOR18: u32 = $1A4  // Color 18
pub const COLOR19: u32 = $1A6  // Color 19
pub const COLOR20: u32 = $1A8  // Color 20
pub const COLOR21: u32 = $1AA  // Color 21
pub const COLOR22: u32 = $1AC  // Color 22
pub const COLOR23: u32 = $1AE  // Color 23
pub const COLOR24: u32 = $1B0  // Color 24
pub const COLOR25: u32 = $1B2  // Color 25
pub const COLOR26: u32 = $1B4  // Color 26
pub const COLOR27: u32 = $1B6  // Color 27
pub const COLOR28: u32 = $1B8  // Color 28
pub const COLOR29: u32 = $1BA  // Color 29
pub const COLOR30: u32 = $1BC  // Color 30
pub const COLOR31: u32 = $1BE  // Color 31

//
// Blitter Registers
//

pub const BLTCON0: u32 = $040  // Blitter control register 0
pub const BLTCON1: u32 = $042  // Blitter control register 1
pub const BLTAFWM: u32 = $044  // Blitter first word mask for source A
pub const BLTALWM: u32 = $046  // Blitter last word mask for source A
pub const BLTAPT: u32 = $050   // Blitter pointer to source A (32-bit)
pub const BLTBPT: u32 = $04C   // Blitter pointer to source B (32-bit)
pub const BLTCPT: u32 = $048   // Blitter pointer to source C (32-bit)
pub const BLTDPT: u32 = $054   // Blitter pointer to destination D (32-bit)
pub const BLTSIZE: u32 = $058  // Blitter start and size
pub const BLTAMOD: u32 = $064  // Blitter modulo for source A
pub const BLTBMOD: u32 = $062  // Blitter modulo for source B
pub const BLTCMOD: u32 = $060  // Blitter modulo for source C
pub const BLTDMOD: u32 = $066  // Blitter modulo for destination D
pub const BLTADAT: u32 = $074  // Blitter source A data register
pub const BLTBDAT: u32 = $072  // Blitter source B data register
pub const BLTCDAT: u32 = $070  // Blitter source C data register

//
// DMA Control
//

pub const DMACON: u32 = $096   // DMA control write (clear or set)
pub const DMACONR: u32 = $002  // DMA control read
pub const INTENA: u32 = $09A   // Interrupt enable bits (clear or set)
pub const INTENAR: u32 = $01C  // Interrupt enable bits (read)
pub const INTREQ: u32 = $09C   // Interrupt request bits (clear or set)
pub const INTREQR: u32 = $01E  // Interrupt request bits (read)

//
// Audio/Disk Control
//

pub const ADKCON: u32 = $09E   // Audio/disk control write (clear or set)
pub const ADKCONR: u32 = $010  // Audio/disk control read

//
// System Status
//

pub const VPOSR: u32 = $004    // Vertical beam position (and target ID)
pub const VHPOSR: u32 = $006   // Vertical/horizontal beam position

//
// Helper Functions
//

/// Check if a register address is safe to write from the copper
///
/// The copper cannot safely write to:
/// - COP1LC, COP2LC (would cause infinite loops)
/// - COPJMP1, COPJMP2 (can only be strobed)
pub fn is_register_safe_for_copper(reg_addr: u32) -> bool {
    let offset = reg_addr & $1FF

    // Check for dangerous registers
    if offset == $080 {  // COP1LC
        return false
    }
    if offset == $084 {  // COP2LC
        return false
    }
    if offset == $088 {  // COPJMP1
        return false
    }
    if offset == $08A {  // COPJMP2
        return false
    }

    // Check if in valid custom chip range
    if offset > $1FF {
        return false
    }

    return true
}

/// Get color register offset for a given color index (0-31)
pub fn color_register(index: u8) -> u32 {
    return COLOR00 + (((u32)index) * 2)
}

/// Convert RGB components to 12-bit Amiga color value (0x0RGB format)
///
/// Each component should be 0-15 (4 bits)
pub fn rgb12(r: u8, g: u8, b: u8) -> u16 {
    let r4: u16 = ((u16)r) & $F
    let g4: u16 = ((u16)g) & $F
    let b4: u16 = ((u16)b) & $F
    return (r4 << 8) | (g4 << 4) | b4
}

/// Convert 8-bit RGB components to 12-bit Amiga color (scales down)
pub fn rgb12_from_u8(r: u8, g: u8, b: u8) -> u16 {
    let r4: u8 = r / 17  // Scale 0-255 to 0-15
    let g4: u8 = g / 17
    let b4: u8 = b / 17
    return rgb12(r4, g4, b4)
}

