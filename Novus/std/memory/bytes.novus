from std::core import Error, Option, Result
from std::memory::slice import Slice, MutSlice

/// Error returned when a byte access would cross the buffer boundary.
pub enum ByteError {
    OutOfBounds,
}

impl ByteError {
    pub fn message(&self) -> *u8 {
        return "Byte access is out of bounds"
    }
}

impl Error for ByteError {
    fn message(&self) -> *u8 {
        return ByteError::message(self)
    }
}

fn contains(len: u32, offset: u32, width: u32) -> bool {
    return offset <= len && width <= len - offset
}

/// Bounds-checked, offset-based access to encoded bytes.
pub struct ByteReader {
    bytes: Slice<u8>,
}

impl ByteReader {
    pub fn new(bytes: Slice<u8>) -> ByteReader {
        return ByteReader { bytes: bytes }
    }

    pub fn len(&self) -> u32 {
        return self.bytes.len()
    }

    pub fn read_u8(&self, offset: u32) -> Result<u8, ByteError> {
        match self.bytes.get(offset) {
            Option::Some(value) => return Result::Ok(*value),
            Option::None => return Result::Err(ByteError::OutOfBounds),
        }
    }

    pub fn read_be_u16(&self, offset: u32) -> Result<u16, ByteError> {
        if !contains(self.bytes.len(), offset, 2) {
            return Result::Err(ByteError::OutOfBounds)
        }
        let high = unsafe { *self.bytes.get_unchecked(offset) }
        let low = unsafe { *self.bytes.get_unchecked(offset + 1) }
        return Result::Ok(((u16)high << 8) | (u16)low)
    }

    pub fn read_be_u32(&self, offset: u32) -> Result<u32, ByteError> {
        if !contains(self.bytes.len(), offset, 4) {
            return Result::Err(ByteError::OutOfBounds)
        }
        let b0 = unsafe { *self.bytes.get_unchecked(offset) }
        let b1 = unsafe { *self.bytes.get_unchecked(offset + 1) }
        let b2 = unsafe { *self.bytes.get_unchecked(offset + 2) }
        let b3 = unsafe { *self.bytes.get_unchecked(offset + 3) }
        return Result::Ok(((u32)b0 << 24) | ((u32)b1 << 16) | ((u32)b2 << 8) | (u32)b3)
    }
}

/// Bounds-checked, offset-based mutation of encoded bytes.
pub struct ByteWriter {
    bytes: MutSlice<u8>,
}

impl ByteWriter {
    pub fn new(consuming bytes: MutSlice<u8>) -> ByteWriter {
        return ByteWriter { bytes: bytes }
    }

    pub fn len(&self) -> u32 {
        return self.bytes.len()
    }

    pub fn write_u8(&var self, offset: u32, value: u8) -> Result<(), ByteError> {
        match self.bytes.set(offset, value) {
            Result::Ok(_) => return Result::Ok(()),
            Result::Err(_) => return Result::Err(ByteError::OutOfBounds),
        }
    }

    pub fn read_be_u32(&self, offset: u32) -> Result<u32, ByteError> {
        if !contains(self.bytes.len(), offset, 4) {
            return Result::Err(ByteError::OutOfBounds)
        }
        let b0 = unsafe { *self.bytes.get_unchecked(offset) }
        let b1 = unsafe { *self.bytes.get_unchecked(offset + 1) }
        let b2 = unsafe { *self.bytes.get_unchecked(offset + 2) }
        let b3 = unsafe { *self.bytes.get_unchecked(offset + 3) }
        return Result::Ok(((u32)b0 << 24) | ((u32)b1 << 16) | ((u32)b2 << 8) | (u32)b3)
    }

    pub fn write_be_u16(&var self, offset: u32, value: u16) -> Result<(), ByteError> {
        if !contains(self.bytes.len(), offset, 2) {
            return Result::Err(ByteError::OutOfBounds)
        }
        unsafe {
            self.bytes.set_unchecked(offset, (u8)(value >> 8))
            self.bytes.set_unchecked(offset + 1, (u8)value)
        }
        return Result::Ok(())
    }

    pub fn write_be_u32(&var self, offset: u32, value: u32) -> Result<(), ByteError> {
        if !contains(self.bytes.len(), offset, 4) {
            return Result::Err(ByteError::OutOfBounds)
        }
        unsafe {
            self.bytes.set_unchecked(offset, (u8)(value >> 24))
            self.bytes.set_unchecked(offset + 1, (u8)(value >> 16))
            self.bytes.set_unchecked(offset + 2, (u8)(value >> 8))
            self.bytes.set_unchecked(offset + 3, (u8)value)
        }
        return Result::Ok(())
    }

    pub fn fill(&var self, value: u8) -> Result<(), ByteError> {
        var offset: u32 = 0
        while offset < self.bytes.len() {
            unsafe { self.bytes.set_unchecked(offset, value) }
            offset++
        }
        return Result::Ok(())
    }
}
