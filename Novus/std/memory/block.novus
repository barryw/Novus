// Novus Standard Library - Safe Memory Management
// Namespace: std::mem
// Unified memory management API with automatic size tracking

from std::core import Option, Result, From, Drop
from std::memory::errors import MemoryError
from amiga::raw::exec import AllocMem, FreeMem, CopyMem
from amiga::raw::consts import MEMF_PUBLIC, MEMF_CHIP, MEMF_FAST, MEMF_CLEAR, MEMF_ANY
from std::memory::slice import Slice, MutSlice

/// MemoryBlock - Raw memory allocation with automatic size tracking
///
/// This is the fundamental building block for all memory operations.
/// Contains both pointer and size, eliminating manual size tracking bugs.
///
/// Use this for:
/// - Low-level memory operations
/// - Building higher-level abstractions
/// - FFI buffers where you need raw bytes
///
/// For type-safe allocations, prefer Allocation<T> or Box<T>.
///
/// Example:
/// ```novus
/// let block = MemoryBlock::alloc(1024, MEMF_FAST)
/// match block {
///     Result::Ok(var b) => {
///         defer {
///             b.free()
///         }
///         // Use b.ptr() and b.size()
///         let ptr: *u8 = b.ptr()
///         ptr[0] = 42
///     },
///     Result::Err(_) => {
///         // Allocation failed
///     }
/// }
/// ```
pub struct MemoryBlock {
    /// The ptr value stored by `MemoryBlock`.
    ptr: *u8,
    /// The size value stored by `MemoryBlock`.
    size: usize,
}

/// Named ownership state returned when an allocation crosses into a lower
/// layer. The pair cannot be accidentally reordered like a tuple.
pub struct RawMemoryBlock {
    /// The ptr value stored by `RawMemoryBlock`.
    ptr: *u8
    /// The size value stored by `RawMemoryBlock`.
    size: usize
}

impl RawMemoryBlock {
    /// Returns the ptr value associated with `RawMemoryBlock`.
    ///
    /// # Returns
    /// The resulting `*u8` value.
    pub fn ptr(&self) -> *u8 { return self.ptr }
    /// Returns the size value associated with `RawMemoryBlock`.
    ///
    /// # Returns
    /// The resulting `usize` value.
    pub fn size(&self) -> usize { return self.size }
}

impl MemoryBlock {
    /// Allocate zero-initialized application memory without exposing Exec flags.
    pub fn new(size: usize) -> Result<MemoryBlock, MemoryError> {
        return MemoryBlock::alloc(size, MEMF_PUBLIC | MEMF_CLEAR)
    }

    /// Allocate raw memory of specified size
    /// Returns an error if allocation fails.
    ///
    /// Example:
    /// ```novus
    /// let mem = MemoryBlock::alloc(1024, MEMF_FAST)
    /// match mem {
    ///     Result::Ok(var block) => {
    ///         defer {
    ///             block.free()
    ///         }
    ///         // Use block
    ///     },
    ///     Result::Err(_) => { /* failed */ }
    /// }
    /// ```
    pub fn alloc(size: usize, flags: u32) -> Result<MemoryBlock, MemoryError> {
        if size == 0 {
            // Zero-size allocation returns valid empty block
            return Result::Ok(MemoryBlock { ptr: null, size: 0 })
        }

        var ptr: *u8 = null
        unsafe {
            ptr = AllocMem(size, flags)
        }

        // Check if allocation failed (returns null pointer)
        if (u32)ptr == 0 {
            return Result::Err(MemoryError::OutOfMemory)
        }

        return Result::Ok(MemoryBlock { ptr: ptr, size: size })
    }

    /// Allocate and return Result with typed error
    ///
    /// Example:
    /// ```novus
    /// var block = MemoryBlock::try_alloc(1024, MEMF_FAST)?
    /// defer {
    ///     block.free()
    /// }
    /// ```
    pub fn try_alloc(size: usize, flags: u32) -> Result<MemoryBlock, MemoryError> {
        return MemoryBlock::alloc(size, flags)
    }

    /// Get pointer to allocated memory
    pub fn ptr(&self) -> *u8 {
        return self.ptr
    }

    /// Get size of allocated memory in bytes
    pub fn size(&self) -> usize {
        return self.size
    }

    /// Borrow the allocation as bounded bytes without exposing its raw pointer.
    pub fn as_bytes(&self) -> Slice<u8> {
        if self.size == 0 {
            return unsafe { Slice::<u8>::new(&*((*u8)self), 0) }
        }
        return unsafe { Slice::<u8>::new(&*self.ptr, self.size) }
    }

    /// Mutably borrow the allocation as bounded bytes.
    pub fn as_mut_bytes(&var self) -> MutSlice<u8> {
        if self.size == 0 {
            return unsafe { MutSlice::<u8>::new(&var *((*u8)self), 0) }
        }
        return unsafe { MutSlice::<u8>::new(&var *self.ptr, self.size) }
    }

    /// Check if this is an empty (zero-size) block
    pub fn is_empty(&self) -> bool {
        return self.size == 0
    }

    /// Take ownership of the raw pointer, preventing automatic cleanup
    ///
    /// This "leaks" the memory from the MemoryBlock's perspective - the caller
    /// is now responsible for freeing the memory manually via FreeMem.
    /// Returns a named raw allocation state.
    ///
    /// Use this when you need to store the raw pointer elsewhere (e.g., in a
    /// struct that manages its own memory) without triggering double-free.
    ///
    /// Example:
    /// ```novus
    /// let block = MemoryBlock::alloc(1024, MEMF_FAST)?
    /// let raw = block.into_raw()
    /// // block is now "empty" - Drop won't free anything
    /// // caller must manually: FreeMem(raw.ptr(), raw.size())
    /// ```
    pub fn into_raw(consuming self) -> RawMemoryBlock {
        let ptr = self.ptr
        let size = self.size
        // Clear our fields so Drop won't free
        self.ptr = null
        self.size = 0
        return RawMemoryBlock { ptr: ptr, size: size }
    }

    /// Adopt an explicitly owned raw allocation.
    @unsafe
    pub fn from_raw(consuming raw: RawMemoryBlock) -> Result<MemoryBlock, MemoryError> {
        return Result::Err(MemoryError::InvalidAddress) if raw.size > 0 && raw.ptr == null
        return Result::Ok(MemoryBlock { ptr: raw.ptr, size: raw.size })
    }

    /// Free the memory block
    /// After calling free(), the block becomes invalid
    ///
    /// NOTE: No size parameter needed! Size is tracked automatically.
    pub fn free(&var self) {
        if self.size > 0 {
            unsafe { FreeMem(self.ptr, self.size) }
            self.ptr = null
            self.size = 0
        }
    }

    /// Resize the memory block (realloc equivalent)
    /// Returns Ok on success or the allocation error.
    /// On failure, original block is unchanged
    pub fn resize(&var self, new_size: usize, flags: u32) -> Result<(), MemoryError> {
        if new_size == self.size {
            return Result::Ok(())
        }

        let new_block_opt = MemoryBlock::alloc(new_size, flags)
        match new_block_opt {
            Result::Ok(var new_block) => {
                // Copy old data to new block
                var copy_size: usize = self.size
                if new_size < self.size {
                    copy_size = new_size
                }

                let new_ptr = new_block.ptr()
                if copy_size > 0 {
                    unsafe { CopyMem(self.ptr, new_ptr, copy_size) }
                }

                // Free old block
                self.free()

                // Take ownership of new block's memory (prevents double-free)
                let raw = new_block.into_raw()
                self.ptr = raw.ptr()
                self.size = raw.size()

                return Result::Ok(())
            },
            Result::Err(error) => return Result::Err(error),
        }
    }
}

// Automatic cleanup for MemoryBlock (RAII)
impl Drop for MemoryBlock {
    fn drop(&var self) {
        self.free()
    }
}

/// Allocation<T> - Type-safe bulk memory allocation
///
/// Safer alternative to MemoryBlock with compile-time type checking.
/// Automatically tracks element count and total size.
///
/// Use this for:
/// - Arrays/buffers of typed elements
/// - Manual memory pools
/// - Collections implementation (Vec, HashMap internals)
///
/// Example:
/// ```novus
/// let buffer = Allocation::new(1024, MEMF_CHIP)
/// match buffer {
///     Result::Ok(var alloc) => {
///         defer {
///             alloc.free()
///         }
///
///         let ptr: *u8 = alloc.as_mut_ptr()
///         ptr[0] = 42
///     },
///     Result::Err(_) => { /* failed */ }
/// }
/// ```
pub struct Allocation<T> {
    /// The block value stored by `Allocation`.
    block: MemoryBlock,
    /// The count value stored by `Allocation`.
    count: usize,
}

impl<T> Allocation<T> {
    /// Allocate memory for `count` elements of type T
    /// Returns an error if allocation fails.
    pub fn new(count: usize, flags: u32) -> Result<Allocation<T>, MemoryError> {
        if count == 0 {
            return Result::Ok(Allocation {
                block: MemoryBlock { ptr: null, size: 0 },
                count: 0,
            })
        }

        let element_size: usize = @sizeof(T)

        // Check for overflow: count * element_size
        if element_size > ($FFFFFFFF / count) {
            return Result::Err(MemoryError::OutOfMemory)  // Would overflow
        }

        let total_bytes: usize = count * element_size

        match MemoryBlock::alloc(total_bytes, flags) {
            Result::Ok(block) => {
                return Result::Ok(Allocation {
                    block: block,
                    count: count,
                })
            },
            Result::Err(error) => return Result::Err(error)
        }
    }

    /// Allocate and return Result with typed error
    pub fn try_new(count: usize, flags: u32) -> Result<Allocation<T>, MemoryError> {
        return Allocation::<T>::new(count, flags)
    }

    /// Get number of elements
    pub fn count(&self) -> usize {
        return self.count
    }

    /// Get total size in bytes
    pub fn size_bytes(&self) -> usize {
        return self.block.size()
    }

    /// Get immutable pointer
    pub fn as_ptr(&self) -> *T {
        return (*T)self.block.ptr()
    }

    /// Get mutable pointer
    pub fn as_mut_ptr(&var self) -> *T {
        return (*T)self.block.ptr()
    }

    /// Check if empty
    pub fn is_empty(&self) -> bool {
        return self.count == 0
    }

    /// Free the allocation
    /// NOTE: No size parameter needed!
    pub fn free(&var self) {
        self.block.free()
        self.count = 0
    }

    /// Resize allocation to new element count
    pub fn resize(&var self, new_count: usize, flags: u32) -> Result<(), MemoryError> {
        let element_size: usize = @sizeof(T)

        // Check for overflow: new_count * element_size
        if new_count > 0 && element_size > ($FFFFFFFF / new_count) {
            return Result::Err(MemoryError::OutOfMemory)  // Would overflow
        }

        let new_bytes: usize = new_count * element_size

        self.block.resize(new_bytes, flags)?
        self.count = new_count
        return Result::Ok(())
    }
}

// Automatic cleanup for Allocation<T> (RAII)
impl<T> Drop for Allocation<T> {
    fn drop(&var self) {
        self.free()
    }
}

/// Box<T> - Single heap-allocated value
///
/// Simplest way to allocate a single value on the heap.
/// Size is completely automatic.
///
/// Use this for:
/// - Large structs that don't fit on stack
/// - Recursive data structures
/// - Heap-allocated values
///
/// Example:
/// ```novus
/// struct BigData {
///     buffer: [u8; 4096],
/// }
///
/// let boxed = Box::new(BigData { buffer: [0; 4096] })
/// match boxed {
///     Some(var b) => {
///         defer {
///             b.free()
///         }
///
///         let val: *BigData = b.get_mut()
///         val.buffer[0] = 42
///     },
///     None => { /* failed */ }
/// }
/// ```
pub struct Box<T> {
    /// The alloc value stored by `Box`.
    alloc: Allocation<T>,
}

impl<T> Box<T> {
    /// Allocate and initialize a Box with the given value
    /// Uses MEMF_PUBLIC by default
    pub fn new(consuming value: T) -> Result<Box<T>, MemoryError> {
        return Box::<T>::new_in(value, MEMF_PUBLIC)
    }

    /// Allocate with specific memory flags
    pub fn new_in(consuming value: T, flags: u32) -> Result<Box<T>, MemoryError> {
        let element_size: usize = @sizeof(T)
        let total_bytes: usize = element_size

        match MemoryBlock::alloc(total_bytes, flags) {
            Result::Ok(block) => {
                var alloc = Allocation {
                    block: block,
                    count: 1,
                }
                let ptr: *T = alloc.as_mut_ptr()
                *ptr = value
                return Result::Ok(Box { alloc: alloc })
            },
            Result::Err(error) => return Result::Err(error)
        }
    }

    /// Try allocate with Result
    pub fn try_new(consuming value: T) -> Result<Box<T>, MemoryError> {
        return Box::<T>::new(value)
    }

    /// Try allocate with specific flags
    pub fn try_new_in(consuming value: T, flags: u32) -> Result<Box<T>, MemoryError> {
        return Box::<T>::new_in(value, flags)
    }

    /// Get immutable reference
    pub fn get(&self) -> &T {
        return unsafe { &*self.alloc.as_ptr() }
    }

    /// Get mutable reference
    pub fn get_mut(&var self) -> &var T {
        return unsafe { &var *self.alloc.as_mut_ptr() }
    }

    /// Free the box
    /// NOTE: No size parameter needed!
    pub fn free(&var self) {
        self.alloc.free()
    }
}

// Automatic cleanup for Box<T> (RAII)
impl<T> Drop for Box<T> {
    fn drop(&var self) {
        self.free()
    }
}

