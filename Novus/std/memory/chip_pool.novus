// Chip RAM Pooled Allocator
// Module: std::memory::chip_pool
//
// Uses AmigaOS V39+ Exec pool functions for efficient chip RAM allocation.
// Pools minimize fragmentation through puddle-based allocation.

from std::core import Result, Option, Drop
from std::ffi::exec import CreatePool, DeletePool, AllocPooled, FreePooled, AvailMem, Forbid, Permit
from std::ffi::amiga_consts import MEMF_CHIP, MEMF_CLEAR, MEMF_LARGEST

// ============================================================================
// Pool Size Classes
// ============================================================================

/// Size class for pool allocation
pub enum PoolSizeClass {
    /// 4KB blocks - sprites, small samples
    Small,
    /// 8KB blocks - copper lists, medium samples
    Medium,
    /// 16KB blocks - streaming buffers
    Large,
    /// 32KB blocks - large streaming buffers
    Huge,
}

// Size constants for each class
pub const POOL_SMALL_SIZE: u32 = 4096      // 4KB
pub const POOL_MEDIUM_SIZE: u32 = 8192     // 8KB
pub const POOL_LARGE_SIZE: u32 = 16384     // 16KB
pub const POOL_HUGE_SIZE: u32 = 32768      // 32KB

// Puddle sizes - how much memory Exec allocates at a time for each pool
// Larger puddles = fewer allocations, but more waste if not fully used
const SMALL_PUDDLE: u32 = 32768    // 32KB puddles for small pool (8 blocks)
const MEDIUM_PUDDLE: u32 = 65536   // 64KB puddles for medium pool (8 blocks)
const LARGE_PUDDLE: u32 = 65536    // 64KB puddles for large pool (4 blocks)
const HUGE_PUDDLE: u32 = 131072    // 128KB puddles for huge pool (4 blocks)

// Threshold - allocations above this bypass the puddle system
// Set equal to max block size so all allocations use puddles
const THRESHOLD: u32 = 32768

// ============================================================================
// Pool Entry - Tracks individual allocations for FreePooled
// ============================================================================

/// Maximum tracked allocations per size class
const MAX_ALLOCS_PER_CLASS: u32 = 64

/// Tracks an individual allocation (needed for FreePooled)
struct PoolAlloc {
    ptr: *u8,
    size: u32,
}

impl PoolAlloc {
    fn new() -> PoolAlloc {
        return PoolAlloc { ptr: (*u8)0, size: 0 }
    }

    fn is_valid(&self) -> bool {
        return self.ptr != (*u8)0
    }
}

/// A size-class pool using Exec's pooled allocation
struct SizePool {
    pool_header: *u8,           // Exec pool handle
    block_size: u32,            // Size of blocks in this pool
    allocs: [PoolAlloc; 64],    // Track allocations for FreePooled
    alloc_count: u32,           // Number of active allocations
    total_allocated: u32,       // Total bytes allocated from this pool
}

impl SizePool {
    fn new() -> SizePool {
        return SizePool {
            pool_header: (*u8)0,
            block_size: 0,
            allocs: [PoolAlloc::new(); 64],
            alloc_count: 0,
            total_allocated: 0,
        }
    }

    fn init(&mut self, block_size: u32, puddle_size: u32) -> bool {
        self.block_size = block_size
        self.pool_header = CreatePool(MEMF_CHIP, puddle_size, THRESHOLD)
        return self.pool_header != (*u8)0
    }

    fn alloc(&mut self) -> Option<*u8> {
        if !self.pool_header {
            return Option::None
        }

        if self.alloc_count >= MAX_ALLOCS_PER_CLASS {
            return Option::None  // Tracking array full
        }

        let ptr = AllocPooled(self.pool_header, self.block_size)
        if !ptr {
            return Option::None
        }

        // Track the allocation
        self.allocs[self.alloc_count] = PoolAlloc { ptr: ptr, size: self.block_size }
        self.alloc_count = self.alloc_count + 1
        self.total_allocated = self.total_allocated + self.block_size

        return Option::Some(ptr)
    }

    fn free(&mut self, ptr: *u8) -> bool {
        if !self.pool_header || !ptr {
            return false
        }

        // Find and remove the allocation from tracking
        var i: u32 = 0
        while i < self.alloc_count {
            if self.allocs[i].ptr == ptr {
                let size = self.allocs[i].size

                // Free the memory
                FreePooled(self.pool_header, ptr, size)

                // Remove from tracking by shifting
                var j = i
                while j < self.alloc_count - 1 {
                    self.allocs[j] = self.allocs[j + 1]
                    j = j + 1
                }
                self.allocs[self.alloc_count - 1] = PoolAlloc::new()
                self.alloc_count = self.alloc_count - 1
                self.total_allocated = self.total_allocated - size

                return true
            }
            i = i + 1
        }

        return false  // Not found in this pool
    }

    fn shutdown(&mut self) {
        if self.pool_header {
            // DeletePool frees all memory at once - no need to free individually
            DeletePool(self.pool_header)
            self.pool_header = (*u8)0
            self.alloc_count = 0
            self.total_allocated = 0
        }
    }

    fn in_use_count(&self) -> u32 {
        return self.alloc_count
    }

    fn bytes_allocated(&self) -> u32 {
        return self.total_allocated
    }
}

// ============================================================================
// ChipPool - Global pooled allocator
// ============================================================================

/// Global chip RAM pool manager
///
/// Uses AmigaOS V39+ Exec pool functions for efficient allocation.
/// Provides size-class based allocation to minimize fragmentation:
/// - Small (4KB): sprites, small samples
/// - Medium (8KB): copper lists, medium samples
/// - Large (16KB): streaming buffers
/// - Huge (32KB): large streaming buffers
///
/// For allocations larger than 32KB, use direct AllocMem.
pub struct ChipPool {
    small_pool: SizePool,
    medium_pool: SizePool,
    large_pool: SizePool,
    huge_pool: SizePool,
    initialized: bool,
}

// Global singleton instance
static mut g_chip_pool: ChipPool = ChipPool {
    small_pool: SizePool {
        pool_header: (*u8)0,
        block_size: 0,
        allocs: [PoolAlloc { ptr: (*u8)0, size: 0 }; 64],
        alloc_count: 0,
        total_allocated: 0,
    },
    medium_pool: SizePool {
        pool_header: (*u8)0,
        block_size: 0,
        allocs: [PoolAlloc { ptr: (*u8)0, size: 0 }; 64],
        alloc_count: 0,
        total_allocated: 0,
    },
    large_pool: SizePool {
        pool_header: (*u8)0,
        block_size: 0,
        allocs: [PoolAlloc { ptr: (*u8)0, size: 0 }; 64],
        alloc_count: 0,
        total_allocated: 0,
    },
    huge_pool: SizePool {
        pool_header: (*u8)0,
        block_size: 0,
        allocs: [PoolAlloc { ptr: (*u8)0, size: 0 }; 64],
        alloc_count: 0,
        total_allocated: 0,
    },
    initialized: false,
}

impl ChipPool {
    /// Initialize the global chip pool
    ///
    /// Creates Exec pools for each size class. Call this once at startup.
    /// Pools will auto-initialize on first use if not called explicitly.
    pub fn init() -> bool {
        unsafe {
            if g_chip_pool.initialized {
                return true
            }

            // Initialize each size class pool
            if !g_chip_pool.small_pool.init(POOL_SMALL_SIZE, SMALL_PUDDLE) {
                return false
            }
            if !g_chip_pool.medium_pool.init(POOL_MEDIUM_SIZE, MEDIUM_PUDDLE) {
                g_chip_pool.small_pool.shutdown()
                return false
            }
            if !g_chip_pool.large_pool.init(POOL_LARGE_SIZE, LARGE_PUDDLE) {
                g_chip_pool.small_pool.shutdown()
                g_chip_pool.medium_pool.shutdown()
                return false
            }
            if !g_chip_pool.huge_pool.init(POOL_HUGE_SIZE, HUGE_PUDDLE) {
                g_chip_pool.small_pool.shutdown()
                g_chip_pool.medium_pool.shutdown()
                g_chip_pool.large_pool.shutdown()
                return false
            }

            g_chip_pool.initialized = true
            return true
        }
    }

    /// Determine the best size class for a given size
    pub fn size_class_for(size: u32) -> Option<PoolSizeClass> {
        if size == 0 {
            return Option::None
        }
        if size <= POOL_SMALL_SIZE {
            return Option::Some(PoolSizeClass::Small)
        }
        if size <= POOL_MEDIUM_SIZE {
            return Option::Some(PoolSizeClass::Medium)
        }
        if size <= POOL_LARGE_SIZE {
            return Option::Some(PoolSizeClass::Large)
        }
        if size <= POOL_HUGE_SIZE {
            return Option::Some(PoolSizeClass::Huge)
        }
        return Option::None  // Too large for pooled allocation
    }

    /// Get actual block size for a size class
    pub fn block_size(class: PoolSizeClass) -> u32 {
        match class {
            PoolSizeClass::Small => POOL_SMALL_SIZE,
            PoolSizeClass::Medium => POOL_MEDIUM_SIZE,
            PoolSizeClass::Large => POOL_LARGE_SIZE,
            PoolSizeClass::Huge => POOL_HUGE_SIZE,
        }
    }

    /// Allocate chip RAM from the pool
    ///
    /// Returns a pointer to chip RAM that can hold at least `size` bytes.
    /// The actual allocated size may be larger (rounded up to size class).
    /// For sizes > 32KB, returns None (use direct AllocMem instead).
    ///
    /// Note: Uses Forbid/Permit for defense-in-depth interrupt safety.
    /// Nested Forbid/Permit is safe (reference counted by Exec).
    pub fn alloc(size: u32) -> Option<*u8> {
        if size == 0 {
            return Option::None
        }

        unsafe {
            Forbid()

            if !g_chip_pool.initialized {
                if !ChipPool::init() {
                    Permit()
                    return Option::None
                }
            }

            // Determine size class and allocate from appropriate pool
            if size <= POOL_SMALL_SIZE {
                let result = g_chip_pool.small_pool.alloc()
                Permit()
                return result
            }
            if size <= POOL_MEDIUM_SIZE {
                let result = g_chip_pool.medium_pool.alloc()
                Permit()
                return result
            }
            if size <= POOL_LARGE_SIZE {
                let result = g_chip_pool.large_pool.alloc()
                Permit()
                return result
            }
            if size <= POOL_HUGE_SIZE {
                let result = g_chip_pool.huge_pool.alloc()
                Permit()
                return result
            }

            Permit()
            return Option::None
        }
    }

    /// Free chip RAM back to the pool
    ///
    /// Returns true if the pointer was found and freed.
    /// Returns false if the pointer wasn't from this pool.
    ///
    /// Note: Uses Forbid/Permit for defense-in-depth interrupt safety.
    /// Nested Forbid/Permit is safe (reference counted by Exec).
    pub fn free(ptr: *u8) -> bool {
        if !ptr {
            return false
        }

        unsafe {
            Forbid()

            if !g_chip_pool.initialized {
                Permit()
                return false
            }

            // Try each pool - order doesn't matter for correctness
            if g_chip_pool.small_pool.free(ptr) {
                Permit()
                return true
            }
            if g_chip_pool.medium_pool.free(ptr) {
                Permit()
                return true
            }
            if g_chip_pool.large_pool.free(ptr) {
                Permit()
                return true
            }
            if g_chip_pool.huge_pool.free(ptr) {
                Permit()
                return true
            }

            Permit()
            return false
        }
    }

    /// Get pool statistics
    pub fn stats() -> PoolStats {
        unsafe {
            return PoolStats {
                small_count: g_chip_pool.small_pool.in_use_count(),
                small_bytes: g_chip_pool.small_pool.bytes_allocated(),
                medium_count: g_chip_pool.medium_pool.in_use_count(),
                medium_bytes: g_chip_pool.medium_pool.bytes_allocated(),
                large_count: g_chip_pool.large_pool.in_use_count(),
                large_bytes: g_chip_pool.large_pool.bytes_allocated(),
                huge_count: g_chip_pool.huge_pool.in_use_count(),
                huge_bytes: g_chip_pool.huge_pool.bytes_allocated(),
                chip_available: AvailMem(MEMF_CHIP),
                chip_largest: AvailMem(MEMF_CHIP | MEMF_LARGEST),
            }
        }
    }

    /// Shutdown and free all pool memory
    ///
    /// Calling DeletePool on each Exec pool frees all memory at once.
    pub fn shutdown() {
        unsafe {
            g_chip_pool.small_pool.shutdown()
            g_chip_pool.medium_pool.shutdown()
            g_chip_pool.large_pool.shutdown()
            g_chip_pool.huge_pool.shutdown()
            g_chip_pool.initialized = false
        }
    }
}

// ============================================================================
// Pool Statistics
// ============================================================================

/// Statistics about pool usage
pub struct PoolStats {
    small_count: u32,       // Active small allocations
    small_bytes: u32,       // Bytes in small pool
    medium_count: u32,      // Active medium allocations
    medium_bytes: u32,      // Bytes in medium pool
    large_count: u32,       // Active large allocations
    large_bytes: u32,       // Bytes in large pool
    huge_count: u32,        // Active huge allocations
    huge_bytes: u32,        // Bytes in huge pool
    chip_available: u32,    // Available chip RAM
    chip_largest: u32,      // Largest contiguous chip block
}

impl PoolStats {
    /// Total allocations across all pools
    pub fn total_count(&self) -> u32 {
        return self.small_count + self.medium_count + self.large_count + self.huge_count
    }

    /// Total bytes allocated across all pools
    pub fn total_bytes(&self) -> u32 {
        return self.small_bytes + self.medium_bytes + self.large_bytes + self.huge_bytes
    }
}
