from std::core import Copy, Eq, Index, IndexMut, Iterable, Option, Result
from std::memory::errors import MemoryError

/// Generic slice type - an owner-tied reference plus an array length
///
/// This allows passing arrays to functions without losing size information.
/// Unlike raw pointers (*T), slices carry their length.
///
/// Example:
/// ```novus
/// fn sum(numbers: Slice<i32>) -> i32 {
///     var total = 0
///     var i: usize = 0
///     while i < numbers.len {
///         total = total + *numbers.get(i).unwrap()
///         i = i + 1
///     }
///     return total
/// }
///
/// let arr = [1, 2, 3, 4, 5]
/// let result = sum(&arr)  // Array coerces to an owner-tied slice
/// ```
pub struct Slice<T> {
    ptr: &T,
    len: usize,
}

impl<T> Iterable<T> for Slice<T> {
    fn len(&self) -> usize { return self.len }

    @unsafe
    fn get_unchecked(&self, index: usize) -> &T {
        unsafe { return &((*T)self.ptr)[index] }
    }
}

impl<T> Slice<T> {
    /// Create a view from raw contiguous parts.
    /// SAFETY: `ptr` must cover at least `len` consecutive elements.
    @unsafe
    pub fn new(ptr: &T, len: usize) -> Slice<T> {
        return Slice { ptr: ptr, len: len }
    }

    /// Get the length of the slice
    pub fn len(&self) -> usize {
        return self.len
    }

    /// Check if the slice is empty
    pub fn is_empty(&self) -> bool {
        return self.len == 0
    }

    /// Get an element without checking the index.
    /// SAFETY: `index` must be less than `len()`.
    @unsafe
    pub fn get_unchecked(&self, index: usize) -> &T {
        unsafe { return &((*T)self.ptr)[index] }
    }

    /// Get element at index with bounds checking
    pub fn get(&self, index: usize) -> Option<&T> {
        if index >= self.len {
            return Option::None
        }
        unsafe { return Option::Some(&((*T)self.ptr)[index]) }
    }

    /// Borrow the first `count` elements without exposing raw slice parts.
    pub fn take(&self, count: usize) -> Option<Slice<T>> {
        if count > self.len { return Option::None }
        return Option::Some(Slice { ptr: self.ptr, len: count })
    }
}

impl<T> Eq for Slice<T> where T: Eq {
    @inline
    fn eq(&self, other: &Slice<T>) -> bool {
        return false unless self.len == other.len
        for index in 0..self.len {
            unsafe {
                return false unless self.get_unchecked(index).eq(other.get_unchecked(index))
            }
        }
        return true
    }
}

impl<T> Index<usize, &T> for Slice<T> {
    fn index(&self, consuming index: usize) -> &T {
        return self.get(index).unwrap()
    }
}

impl<T> Iterable<T> for MutSlice<T> {
    fn len(&self) -> usize { return self.len }

    @unsafe
    fn get_unchecked(&self, index: usize) -> &T {
        unsafe { return &((*T)self.ptr)[index] }
    }
}

/// Mutable owner-tied slice. While this view is live, the source cannot be
/// borrowed through any other mutable or immutable reference.
pub struct MutSlice<T> {
    ptr: &var T,
    len: usize,
}

impl<T> MutSlice<T> {
    /// SAFETY: `ptr` must exclusively cover at least `len` elements.
    @unsafe
    pub fn new(ptr: &var T, len: usize) -> MutSlice<T> {
        return MutSlice { ptr: ptr, len: len }
    }

    pub fn len(&self) -> usize {
        return self.len
    }

    pub fn is_empty(&self) -> bool {
        return self.len == 0
    }

    pub fn get(&self, index: usize) -> Option<&T> {
        if index >= self.len {
            return Option::None
        }
        unsafe { return Option::Some(&((*T)self.ptr)[index]) }
    }

    pub fn get_mut(&var self, index: usize) -> Option<&var T> {
        if index >= self.len {
            return Option::None
        }
        unsafe { return Option::Some(&var ((*T)self.ptr)[index]) }
    }

    /// Get an element without checking the index.
    /// SAFETY: `index` must be less than `len()`.
    @unsafe
    pub fn get_unchecked(&self, index: usize) -> &T {
        unsafe { return &((*T)self.ptr)[index] }
    }

    /// Replace an element without checking the index.
    /// SAFETY: `index` must be less than `len()`.
    @unsafe
    pub fn set_unchecked(&var self, index: usize, consuming value: T) {
        unsafe {
            let raw: *T = (*T)self.ptr
            @drop_in_place(&var raw[index])
            raw[index] = value
        }
    }

    pub fn set(&var self, index: usize, consuming value: T) -> Result<(), MemoryError> {
        if index >= self.len {
            return Result::Err(MemoryError::IndexOutOfBounds)
        }
        unsafe {
            let raw: *T = (*T)self.ptr
            @drop_in_place(&var raw[index])
            raw[index] = value
        }
        return Result::Ok(())
    }

    /// Copy equally-sized slices after one boundary check. `T: Copy` prevents
    /// duplicating owned values; the raw loop is safe because both lengths were
    /// validated before entering it.
    pub fn copy_from(&var self, source: Slice<T>) -> Result<(), MemoryError> where T: Copy {
        if self.len != source.len { return Result::Err(MemoryError::LengthMismatch) }
        unsafe {
            let destination: *T = (*T)self.ptr
            let input: *T = (*T)source.ptr
            for index in 0..self.len {
                destination[index] = input[index]
            }
        }
        return Result::Ok(())
    }

    /// Fill the entire slice after proving the loop bound once.
    pub fn fill(&var self, value: T) where T: Copy {
        unsafe {
            let destination: *T = (*T)self.ptr
            for index in 0..self.len {
                destination[index] = value
            }
        }
    }
}

impl<T> Index<usize, &T> for MutSlice<T> {
    fn index(&self, consuming index: usize) -> &T {
        return self.get(index).unwrap()
    }
}

impl<T> IndexMut<usize, T> for MutSlice<T> {
    fn index_set(&var self, consuming index: usize, consuming value: T) {
        self.set(index, value).unwrap()
    }
}
