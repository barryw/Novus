// std::math::sqrt - Integer and fixed-point square root
// Namespace: std::math::sqrt
//
// High-performance square root implementations for 68020+ Amigas.
// All core routines are implemented in optimized 68k assembly.
//
// Features:
// - Automatic FPU detection and dispatch (cached for performance)
// - Hardware FSQRT on 68881/68882/68040/68060
// - Optimized Newton-Raphson with BFFFO for software fallback
// - Overflow-safe hypot() for large values
//
// All sqrt functions use overloading - just call sqrt(value) and the
// compiler selects the appropriate implementation based on the argument type.

from std::math::fixed import Fixed32

// ============================================================================
// External Assembly Functions (defined in stubs/math_sqrt.s)
// ============================================================================

// FPU detection (cached)
extern fn math_has_fpu() -> i32

// Software sqrt implementations (68020+ optimized)
extern fn math_sqrt_sw_u32(x: u32) -> u32
extern fn math_sqrt_sw_i32(x: i32) -> i32
extern fn math_sqrt_sw_u16(x: u16) -> u16
extern fn math_sqrt_sw_fixed32(raw: i32) -> i32

// DEBUG: Echo function to test if values are passed correctly
extern fn math_echo_u32(x: u32) -> u32

// FPU sqrt implementations (68881/68882/68040/68060)
extern fn math_sqrt_fpu_u32(x: u32) -> u32
extern fn math_sqrt_fpu_i32(x: i32) -> i32
extern fn math_sqrt_fpu_fixed32(raw: i32) -> i32

// Composite functions (with internal FPU dispatch)
extern fn math_distance(x1: i32, y1: i32, x2: i32, y2: i32) -> i32
extern fn math_hypot(a: i32, b: i32) -> i32
extern fn math_inv_sqrt(x: u32) -> i32
extern fn math_sqrt_fast(x: u32) -> u32

// ============================================================================
// Public API - Overloaded sqrt with automatic FPU dispatch
// ============================================================================

/// Integer square root of a u32
/// Uses FPU FSQRT instruction when available, falls back to optimized assembly
@inline
pub fn sqrt(x: u32) -> u32 {
    return math_sqrt_sw_u32(x)
}

/// Integer square root of an i32 (returns 0 for negative inputs)
/// Uses FPU when available
@inline
pub fn sqrt(x: i32) -> i32 {
    // DEBUG: Force software path
    return math_sqrt_sw_i32(x)
}

/// Integer square root of a u16
/// Uses optimized 16-bit assembly routine
@inline
pub fn sqrt(x: u16) -> u16 {
    return math_sqrt_sw_u16(x)
}

/// Square root of a Fixed32 value
/// Uses FPU when available for much faster computation
@inline
pub fn sqrt(x: Fixed32) -> Fixed32 {
    // DEBUG: Force software path
    let raw = x.to_raw()
    return Fixed32::from_raw(math_sqrt_sw_fixed32(raw))
}

// ============================================================================
// Fast Approximate Square Root
// ============================================================================

/// Fast approximate square root using Newton-Raphson
/// Good to about 2% accuracy after 3 iterations
/// Much faster than full precision when precision isn't critical
/// Note: On FPU machines, uses hardware FSQRT (faster AND more accurate)
@inline
pub fn sqrt_fast(x: u32) -> u32 {
    return math_sqrt_fast(x)
}

// ============================================================================
// Distance Calculations
// ============================================================================

/// Integer distance between two points
/// Returns floor(sqrt(dx² + dy²))
@inline
pub fn distance(x1: i32, y1: i32, x2: i32, y2: i32) -> i32 {
    return math_distance(x1, y1, x2, y2)
}

/// Check if distance is less than a threshold (avoids sqrt)
/// Compares dx² + dy² against threshold²
@inline
@suppress("W0001", "Arithmetic is intentional")
pub fn distance_less_than(x1: i32, y1: i32, x2: i32, y2: i32, threshold: i32) -> bool {
    let dx = x2 - x1
    let dy = y2 - y1
    let dist_sq = dx * dx + dy * dy
    let thresh_sq = threshold * threshold
    return dist_sq < thresh_sq
}

/// Check if distance is within a threshold (avoids sqrt)
@inline
@suppress("W0001", "Arithmetic is intentional")
pub fn distance_within(x1: i32, y1: i32, x2: i32, y2: i32, threshold: i32) -> bool {
    let dx = x2 - x1
    let dy = y2 - y1
    let dist_sq = dx * dx + dy * dy
    let thresh_sq = threshold * threshold
    return dist_sq <= thresh_sq
}

// ============================================================================
// Inverse Square Root (for normalization)
// ============================================================================

/// Approximate inverse square root (1/sqrt(x)) for u32
/// Returns result as 16.16 fixed-point raw value
/// Useful for vector normalization
@inline
pub fn inv_sqrt(x: u32) -> i32 {
    return math_inv_sqrt(x)
}

// ============================================================================
// Hypotenuse (safe from overflow)
// ============================================================================

/// Calculate hypotenuse sqrt(a² + b²) safely
/// Uses scaling to avoid overflow for large values
@inline
pub fn hypot(a: i32, b: i32) -> i32 {
    return math_hypot(a, b)
}
