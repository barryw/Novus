// std::math::sqrt - Integer and fixed-point square root
// Namespace: std::math::sqrt
//
// Efficient square root implementations for 68k Amigas without FPUs.
// Uses binary search and Newton-Raphson methods optimized for integer math.

from std::math::fixed import Fixed32

// ============================================================================
// Integer Square Root
// ============================================================================

/// Integer square root of a u32
/// Returns floor(sqrt(x))
/// Uses binary search method - O(16) iterations for 32-bit values
@suppress("W0001", "Bit operations are intentional")
pub fn sqrt_u32(x: u32) -> u32 {
    if x == 0u32 {
        return 0u32
    }
    if x == 1u32 {
        return 1u32
    }

    // Binary search for sqrt
    var low: u32 = 1u32
    var high: u32 = x
    var result: u32 = 0u32

    // Optimization: start high at a reasonable upper bound
    // sqrt(x) <= x/2 + 1 for x >= 2
    if high > 2u32 {
        high = (x >> 1u32) + 1u32
    }

    while low <= high {
        let mid = (low + high) >> 1u32

        // Check if mid*mid == x
        // Be careful of overflow: check mid <= x/mid instead of mid*mid <= x
        if mid <= x / mid {
            result = mid
            low = mid + 1u32
        } else {
            high = mid - 1u32
        }
    }

    return result
}

/// Integer square root of an i32 (returns 0 for negative inputs)
@inline
pub fn sqrt_i32(x: i32) -> i32 {
    if x <= 0 {
        return 0
    }
    return (i32)sqrt_u32((u32)x)
}

/// Integer square root of a u16
/// Faster version for smaller values
@suppress("W0001", "Bit operations are intentional")
pub fn sqrt_u16(x: u16) -> u16 {
    if x == 0u16 {
        return 0u16
    }
    if x == 1u16 {
        return 1u16
    }

    var low: u16 = 1u16
    var high: u16 = x
    var result: u16 = 0u16

    if high > 2u16 {
        high = (x >> 1u16) + 1u16
    }

    while low <= high {
        let mid = (low + high) >> 1u16

        if mid <= x / mid {
            result = mid
            low = mid + 1u16
        } else {
            high = mid - 1u16
        }
    }

    return result
}

// ============================================================================
// Fast Approximate Square Root
// ============================================================================

/// Fast approximate square root using Newton-Raphson
/// Good to about 2% accuracy after 3 iterations
/// Much faster than binary search for when precision isn't critical
@suppress("W0001", "Arithmetic is intentional")
pub fn sqrt_u32_fast(x: u32) -> u32 {
    if x == 0u32 {
        return 0u32
    }
    if x == 1u32 {
        return 1u32
    }

    // Initial guess: start with x/2 or a better estimate
    var guess: u32 = x >> 1u32

    // Find a reasonable starting point
    // Count leading zeros to get magnitude
    var temp: u32 = x
    var shifts: u32 = 0u32
    while temp > 255u32 {
        temp = temp >> 2u32
        shifts = shifts + 1u32
    }

    // Use a small lookup table for initial guess
    // This significantly speeds up convergence
    if shifts > 0u32 {
        guess = 16u32 << shifts
    }

    // Newton-Raphson: guess = (guess + x/guess) / 2
    // 3-4 iterations is usually enough for 32-bit precision
    guess = (guess + x / guess) >> 1u32
    guess = (guess + x / guess) >> 1u32
    guess = (guess + x / guess) >> 1u32

    // One final check - Newton-Raphson can overshoot
    if guess * guess > x {
        guess = guess - 1u32
    }

    return guess
}

// ============================================================================
// Fixed-Point Square Root
// ============================================================================

/// Square root of a Fixed32 value
/// Returns sqrt(x) as Fixed32
/// Only works for non-negative values
@suppress("W0001", "Arithmetic is intentional")
@suppress("W0002", "Cast is intentional")
pub fn sqrt_fixed32(x: Fixed32) -> Fixed32 {
    let raw = x.to_raw()
    if raw <= 0 {
        return Fixed32::zero()
    }

    // For Fixed32 (16.16), we need to be careful about the fractional part
    // sqrt(x) where x is in 16.16 format
    // If x = n * 2^-16, then sqrt(x) = sqrt(n) * 2^-8
    // So we need to shift the input up by 16 bits before sqrt, then result is correct

    // To avoid overflow, we use 64-bit intermediate
    let scaled: i64 = ((i64)raw) << 16
    var guess: i64 = scaled >> 1

    // Find reasonable starting point
    var temp: i64 = scaled
    var shifts: i64 = 0
    while temp > 255 {
        temp = temp >> 2
        shifts = shifts + 1
    }

    if shifts > 0 {
        guess = 16 << shifts
    }

    // Newton-Raphson iterations
    if guess > 0 {
        guess = (guess + scaled / guess) >> 1
        guess = (guess + scaled / guess) >> 1
        guess = (guess + scaled / guess) >> 1
        guess = (guess + scaled / guess) >> 1
    }

    return Fixed32::from_raw((i32)guess)
}

// ============================================================================
// Distance Calculations (using sqrt)
// ============================================================================

/// Integer distance between two points
/// Returns floor(sqrt(dx² + dy²))
@suppress("W0001", "Arithmetic is intentional")
pub fn distance_i32(x1: i32, y1: i32, x2: i32, y2: i32) -> i32 {
    let dx = x2 - x1
    let dy = y2 - y1
    let dist_sq = dx * dx + dy * dy

    if dist_sq <= 0 {
        return 0
    }
    return (i32)sqrt_u32((u32)dist_sq)
}

/// Check if distance is less than a threshold (avoids sqrt)
/// Compares dx² + dy² against threshold²
@inline
@suppress("W0001", "Arithmetic is intentional")
pub fn distance_less_than(x1: i32, y1: i32, x2: i32, y2: i32, threshold: i32) -> bool {
    let dx = x2 - x1
    let dy = y2 - y1
    let dist_sq = dx * dx + dy * dy
    let thresh_sq = threshold * threshold
    return dist_sq < thresh_sq
}

/// Check if distance is within a threshold (avoids sqrt)
@inline
@suppress("W0001", "Arithmetic is intentional")
pub fn distance_within(x1: i32, y1: i32, x2: i32, y2: i32, threshold: i32) -> bool {
    let dx = x2 - x1
    let dy = y2 - y1
    let dist_sq = dx * dx + dy * dy
    let thresh_sq = threshold * threshold
    return dist_sq <= thresh_sq
}

// ============================================================================
// Inverse Square Root (for normalization)
// ============================================================================

/// Approximate inverse square root (1/sqrt(x)) for u32
/// Returns result as 16.16 fixed-point raw value
/// Useful for vector normalization
@suppress("W0001", "Arithmetic is intentional")
pub fn inv_sqrt_u32(x: u32) -> i32 {
    if x == 0u32 {
        return 0x7FFFFFFF  // Return max value for divide by zero
    }

    let sqrt_x = sqrt_u32(x)
    if sqrt_x == 0u32 {
        return 0x7FFFFFFF
    }

    // 1/sqrt_x in 16.16 fixed point = 65536 / sqrt_x
    // But we need more precision, so use 65536 * 65536 / sqrt_x then shift
    // = 2^32 / sqrt_x
    // To avoid overflow, compute (2^16 / sqrt_x) << 16 / sqrt_x... tricky

    // Simpler: (65536 / sqrt_x) gives us the integer part in 16.16
    // For x=1, sqrt=1, 1/sqrt = 65536 (1.0 in 16.16)
    // For x=4, sqrt=2, 1/sqrt = 32768 (0.5 in 16.16)

    let result: u32 = 65536u32 / sqrt_x
    return (i32)result << 16 >> 16  // Adjust scaling
}

// ============================================================================
// Hypotenuse (safe from overflow)
// ============================================================================

/// Calculate hypotenuse sqrt(a² + b²) safely
/// Uses scaling to avoid overflow for large values
@suppress("W0001", "Arithmetic is intentional")
pub fn hypot_i32(a: i32, b: i32) -> i32 {
    var x = a
    var y = b

    // Make both positive
    if x < 0 { x = -x }
    if y < 0 { y = -y }

    // Handle trivial cases
    if x == 0 { return y }
    if y == 0 { return x }

    // Ensure x >= y
    if y > x {
        let temp = x
        x = y
        y = temp
    }

    // Scale down if values are large to avoid overflow
    // If x > 46340 (sqrt(2^31-1)), we risk overflow in x*x
    if x > 46340 {
        // Scale both down by 256, compute, scale result up
        x = x >> 8
        y = y >> 8
        let dist_sq = x * x + y * y
        return (i32)sqrt_u32((u32)dist_sq) << 8
    }

    let dist_sq = x * x + y * y
    return (i32)sqrt_u32((u32)dist_sq)
}

// ============================================================================
// Function Overloading - Unified sqrt Interface
// ============================================================================

/// Overloaded sqrt for u32
pub fn sqrt(x: u32) -> u32 {
    return sqrt_u32(x)
}

/// Overloaded sqrt for u16
pub fn sqrt(x: u16) -> u16 {
    return sqrt_u16(x)
}

/// Overloaded sqrt for Fixed32
pub fn sqrt(x: Fixed32) -> Fixed32 {
    return sqrt_fixed32(x)
}

/// Overloaded sqrt_fast for u32
pub fn sqrt_fast(x: u32) -> u32 {
    return sqrt_u32_fast(x)
}
