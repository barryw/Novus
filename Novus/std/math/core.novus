// std::math::core - Basic integer math utilities
// Namespace: std::math::core
//
// Provides fundamental math operations that are missing from the language:
// abs, min, max, clamp, sign, etc.
//
// All functions are designed to be fast on 68k processors.

// ============================================================================
// Absolute Value
// ============================================================================

/// Absolute value of an i32
/// Returns the magnitude without sign
@inline
pub fn abs_i32(x: i32) -> i32 {
    if x < 0 {
        return -x
    }
    return x
}

/// Absolute value of an i16
@inline
pub fn abs_i16(x: i16) -> i16 {
    if x < 0i16 {
        return -x
    }
    return x
}

/// Absolute value of an i8
@inline
pub fn abs_i8(x: i8) -> i8 {
    if x < 0i8 {
        return -x
    }
    return x
}

// ============================================================================
// Minimum
// ============================================================================

/// Minimum of two i32 values
@inline
pub fn min_i32(a: i32, b: i32) -> i32 {
    if a < b {
        return a
    }
    return b
}

/// Minimum of two i16 values
@inline
pub fn min_i16(a: i16, b: i16) -> i16 {
    if a < b {
        return a
    }
    return b
}

/// Minimum of two i8 values
@inline
pub fn min_i8(a: i8, b: i8) -> i8 {
    if a < b {
        return a
    }
    return b
}

/// Minimum of two u32 values
@inline
pub fn min_u32(a: u32, b: u32) -> u32 {
    if a < b {
        return a
    }
    return b
}

/// Minimum of two u16 values
@inline
pub fn min_u16(a: u16, b: u16) -> u16 {
    if a < b {
        return a
    }
    return b
}

/// Minimum of two u8 values
@inline
pub fn min_u8(a: u8, b: u8) -> u8 {
    if a < b {
        return a
    }
    return b
}

