// std::math::core - Basic integer math utilities
// Namespace: std::math::core
//
// Provides fundamental math operations that are missing from the language:
// abs, min, max, clamp, sign, etc.
//
// All functions use optimized 68020+ assembly for maximum performance.

// ============================================================================
// External Assembly Functions (defined in stubs/math_core.s)
// ============================================================================

// Absolute value
extern fn asm_abs_i32(x: i32) -> i32
extern fn asm_abs_i16(x: i16) -> i16
extern fn asm_abs_i8(x: i8) -> i8

// Minimum (signed)
extern fn asm_min_i32(a: i32, b: i32) -> i32
extern fn asm_min_i16(a: i16, b: i16) -> i16
extern fn asm_min_i8(a: i8, b: i8) -> i8

// Minimum (unsigned)
extern fn asm_min_u32(a: u32, b: u32) -> u32
extern fn asm_min_u16(a: u16, b: u16) -> u16
extern fn asm_min_u8(a: u8, b: u8) -> u8

// Maximum (signed)
extern fn asm_max_i32(a: i32, b: i32) -> i32
extern fn asm_max_i16(a: i16, b: i16) -> i16
extern fn asm_max_i8(a: i8, b: i8) -> i8

// Maximum (unsigned)
extern fn asm_max_u32(a: u32, b: u32) -> u32
extern fn asm_max_u16(a: u16, b: u16) -> u16
extern fn asm_max_u8(a: u8, b: u8) -> u8

// Clamp (signed)
extern fn asm_clamp_i32(val: i32, min_val: i32, max_val: i32) -> i32
extern fn asm_clamp_i16(val: i16, min_val: i16, max_val: i16) -> i16
extern fn asm_clamp_i8(val: i8, min_val: i8, max_val: i8) -> i8

// Clamp (unsigned)
extern fn asm_clamp_u32(val: u32, min_val: u32, max_val: u32) -> u32
extern fn asm_clamp_u16(val: u16, min_val: u16, max_val: u16) -> u16
extern fn asm_clamp_u8(val: u8, min_val: u8, max_val: u8) -> u8

// Sign
extern fn asm_sign_i32(x: i32) -> i32
extern fn asm_sign_i16(x: i16) -> i16
extern fn asm_sign_i8(x: i8) -> i8

// Power of two
extern fn asm_is_power_of_two_u32(x: u32) -> bool
extern fn asm_is_power_of_two_u16(x: u16) -> bool
extern fn asm_next_power_of_two_u32(x: u32) -> u32
extern fn asm_next_power_of_two_u16(x: u16) -> u16

// Division with rounding
extern fn asm_div_ceil_u32(a: u32, b: u32) -> u32
extern fn asm_div_ceil_u16(a: u16, b: u16) -> u16
extern fn asm_div_round_u32(a: u32, b: u32) -> u32
extern fn asm_div_round_u16(a: u16, b: u16) -> u16

// Difference (absolute)
extern fn asm_diff_u32(a: u32, b: u32) -> u32
extern fn asm_diff_u16(a: u16, b: u16) -> u16
extern fn asm_diff_i32(a: i32, b: i32) -> i32
extern fn asm_diff_i16(a: i16, b: i16) -> i16

// ============================================================================
// Public API - Thin wrappers around assembly functions
// ============================================================================

// Absolute value
/// Absolute value of an i32. Returns the magnitude without sign.
@inline
pub fn abs_i32(x: i32) -> i32 { return asm_abs_i32(x) }
/// Absolute value of an i16.
@inline
pub fn abs_i16(x: i16) -> i16 { return asm_abs_i16(x) }
/// Absolute value of an i8.
@inline
pub fn abs_i8(x: i8) -> i8 { return asm_abs_i8(x) }

// Minimum (signed)
/// Minimum of two i32 values.
@inline
pub fn min_i32(a: i32, b: i32) -> i32 { return asm_min_i32(a, b) }
/// Minimum of two i16 values.
@inline
pub fn min_i16(a: i16, b: i16) -> i16 { return asm_min_i16(a, b) }
/// Minimum of two i8 values.
@inline
pub fn min_i8(a: i8, b: i8) -> i8 { return asm_min_i8(a, b) }

// Minimum (unsigned)
/// Minimum of two u32 values.
@inline
pub fn min_u32(a: u32, b: u32) -> u32 { return asm_min_u32(a, b) }
/// Minimum of two u16 values.
@inline
pub fn min_u16(a: u16, b: u16) -> u16 { return asm_min_u16(a, b) }
/// Minimum of two u8 values.
@inline
pub fn min_u8(a: u8, b: u8) -> u8 { return asm_min_u8(a, b) }

// Maximum (signed)
/// Maximum of two i32 values.
@inline
pub fn max_i32(a: i32, b: i32) -> i32 { return asm_max_i32(a, b) }
/// Maximum of two i16 values.
@inline
pub fn max_i16(a: i16, b: i16) -> i16 { return asm_max_i16(a, b) }
/// Maximum of two i8 values.
@inline
pub fn max_i8(a: i8, b: i8) -> i8 { return asm_max_i8(a, b) }

// Maximum (unsigned)
/// Maximum of two u32 values.
@inline
pub fn max_u32(a: u32, b: u32) -> u32 { return asm_max_u32(a, b) }
/// Maximum of two u16 values.
@inline
pub fn max_u16(a: u16, b: u16) -> u16 { return asm_max_u16(a, b) }
/// Maximum of two u8 values.
@inline
pub fn max_u8(a: u8, b: u8) -> u8 { return asm_max_u8(a, b) }

// Clamp (signed)
/// Clamp an i32 value to a range [min_val, max_val].
@inline
pub fn clamp_i32(val: i32, min_val: i32, max_val: i32) -> i32 { return asm_clamp_i32(val, min_val, max_val) }
/// Clamp an i16 value to a range [min_val, max_val].
@inline
pub fn clamp_i16(val: i16, min_val: i16, max_val: i16) -> i16 { return asm_clamp_i16(val, min_val, max_val) }
/// Clamp an i8 value to a range [min_val, max_val].
@inline
pub fn clamp_i8(val: i8, min_val: i8, max_val: i8) -> i8 { return asm_clamp_i8(val, min_val, max_val) }

// Clamp (unsigned)
/// Clamp a u32 value to a range [min_val, max_val].
@inline
pub fn clamp_u32(val: u32, min_val: u32, max_val: u32) -> u32 { return asm_clamp_u32(val, min_val, max_val) }
/// Clamp a u16 value to a range [min_val, max_val].
@inline
pub fn clamp_u16(val: u16, min_val: u16, max_val: u16) -> u16 { return asm_clamp_u16(val, min_val, max_val) }
/// Clamp a u8 value to a range [min_val, max_val].
@inline
pub fn clamp_u8(val: u8, min_val: u8, max_val: u8) -> u8 { return asm_clamp_u8(val, min_val, max_val) }

// Sign
/// Returns the sign of an i32: -1 if negative, 0 if zero, 1 if positive.
@inline
pub fn sign_i32(x: i32) -> i32 { return asm_sign_i32(x) }
/// Returns the sign of an i16: -1 if negative, 0 if zero, 1 if positive.
@inline
pub fn sign_i16(x: i16) -> i16 { return asm_sign_i16(x) }
/// Returns the sign of an i8: -1 if negative, 0 if zero, 1 if positive.
@inline
pub fn sign_i8(x: i8) -> i8 { return asm_sign_i8(x) }

// Power of two
/// Check if a u32 is a power of two.
@inline
pub fn is_power_of_two_u32(x: u32) -> bool { return asm_is_power_of_two_u32(x) }
/// Check if a u16 is a power of two.
@inline
pub fn is_power_of_two_u16(x: u16) -> bool { return asm_is_power_of_two_u16(x) }
/// Round up to the next power of two for u32. Returns 0 if x is 0.
@inline
pub fn next_power_of_two_u32(x: u32) -> u32 { return asm_next_power_of_two_u32(x) }
/// Round up to the next power of two for u16. Returns 0 if x is 0.
@inline
pub fn next_power_of_two_u16(x: u16) -> u16 { return asm_next_power_of_two_u16(x) }

// Division with rounding
/// Ceiling division for u32: (a + b - 1) / b
@inline
pub fn div_ceil_u32(a: u32, b: u32) -> u32 { return asm_div_ceil_u32(a, b) }
/// Ceiling division for u16: (a + b - 1) / b
@inline
pub fn div_ceil_u16(a: u16, b: u16) -> u16 { return asm_div_ceil_u16(a, b) }
/// Rounded division for u32: (a + b/2) / b
@inline
pub fn div_round_u32(a: u32, b: u32) -> u32 { return asm_div_round_u32(a, b) }
/// Rounded division for u16: (a + b/2) / b
@inline
pub fn div_round_u16(a: u16, b: u16) -> u16 { return asm_div_round_u16(a, b) }

// Difference (absolute)
/// Absolute difference between two u32 values.
@inline
pub fn diff_u32(a: u32, b: u32) -> u32 { return asm_diff_u32(a, b) }
/// Absolute difference between two u16 values.
@inline
pub fn diff_u16(a: u16, b: u16) -> u16 { return asm_diff_u16(a, b) }
/// Absolute difference between two i32 values.
@inline
pub fn diff_i32(a: i32, b: i32) -> i32 { return asm_diff_i32(a, b) }
/// Absolute difference between two i16 values.
@inline
pub fn diff_i16(a: i16, b: i16) -> i16 { return asm_diff_i16(a, b) }

// ============================================================================
// Function Overloading - Unified abs/min/max Interface
// ============================================================================

/// Overloaded abs for i32
pub fn abs(x: i32) -> i32 { return abs_i32(x) }
/// Overloaded abs for i16
pub fn abs(x: i16) -> i16 { return abs_i16(x) }
/// Overloaded abs for i8
pub fn abs(x: i8) -> i8 { return abs_i8(x) }

/// Overloaded min for i32
pub fn min(a: i32, b: i32) -> i32 { return min_i32(a, b) }
/// Overloaded min for u32
pub fn min(a: u32, b: u32) -> u32 { return min_u32(a, b) }
/// Overloaded min for i16
pub fn min(a: i16, b: i16) -> i16 { return min_i16(a, b) }
/// Overloaded min for u16
pub fn min(a: u16, b: u16) -> u16 { return min_u16(a, b) }

/// Overloaded max for i32
pub fn max(a: i32, b: i32) -> i32 { return max_i32(a, b) }
/// Overloaded max for u32
pub fn max(a: u32, b: u32) -> u32 { return max_u32(a, b) }
/// Overloaded max for i16
pub fn max(a: i16, b: i16) -> i16 { return max_i16(a, b) }
/// Overloaded max for u16
pub fn max(a: u16, b: u16) -> u16 { return max_u16(a, b) }

/// Overloaded clamp for i32
pub fn clamp(x: i32, lo: i32, hi: i32) -> i32 { return clamp_i32(x, lo, hi) }
/// Overloaded clamp for u32
pub fn clamp(x: u32, lo: u32, hi: u32) -> u32 { return clamp_u32(x, lo, hi) }

/// Overloaded sign for i32
pub fn sign(x: i32) -> i32 { return sign_i32(x) }

/// Overloaded is_power_of_two for u32
pub fn is_power_of_two(x: u32) -> bool { return is_power_of_two_u32(x) }
/// Overloaded is_power_of_two for u16
pub fn is_power_of_two(x: u16) -> bool { return is_power_of_two_u16(x) }

/// Overloaded next_power_of_two for u32
pub fn next_power_of_two(x: u32) -> u32 { return next_power_of_two_u32(x) }
/// Overloaded next_power_of_two for u16
pub fn next_power_of_two(x: u16) -> u16 { return next_power_of_two_u16(x) }

/// Overloaded div_ceil for u32
pub fn div_ceil(a: u32, b: u32) -> u32 { return div_ceil_u32(a, b) }
/// Overloaded div_ceil for u16
pub fn div_ceil(a: u16, b: u16) -> u16 { return div_ceil_u16(a, b) }

/// Overloaded div_round for u32
pub fn div_round(a: u32, b: u32) -> u32 { return div_round_u32(a, b) }
/// Overloaded div_round for u16
pub fn div_round(a: u16, b: u16) -> u16 { return div_round_u16(a, b) }

/// Overloaded diff for i32
pub fn diff(a: i32, b: i32) -> i32 { return diff_i32(a, b) }
/// Overloaded diff for u32
pub fn diff(a: u32, b: u32) -> u32 { return diff_u32(a, b) }
/// Overloaded diff for i16
pub fn diff(a: i16, b: i16) -> i16 { return diff_i16(a, b) }
/// Overloaded diff for u16
pub fn diff(a: u16, b: u16) -> u16 { return diff_u16(a, b) }
