// std::math::angle - Angle manipulation utilities
// Namespace: std::math::angle
//
// Extended angle utilities beyond what's in trig.novus.
// Provides angle normalization, difference, and interpolation.
//
// Angle representation: Binary Angular Measurement (BAMS)
// - u16: 0-65535 maps to 0-360 degrees
// - Wraps naturally due to u16 overflow
// - 16384 = 90°, 32768 = 180°, 49152 = 270°

from std::math::fixed import Fixed32
from std::math::trig import ANGLE_QUARTER, ANGLE_HALF, ANGLE_THREE_QUARTER, ANGLE_FULL, atan2_angle

// ============================================================================
// Angle Constants (additional)
// ============================================================================

/// 45 degrees in angle units
pub const ANGLE_45: u16 = 8192u16

/// 30 degrees in angle units
pub const ANGLE_30: u16 = 5461u16

/// 60 degrees in angle units
pub const ANGLE_60: u16 = 10923u16

/// 15 degrees in angle units
pub const ANGLE_15: u16 = 2731u16

/// 10 degrees in angle units
pub const ANGLE_10: u16 = 1820u16

/// 5 degrees in angle units
pub const ANGLE_5: u16 = 910u16

/// 1 degree in angle units (more precise than ANGLE_ONE_DEGREE in trig)
pub const ANGLE_1: u16 = 182u16

// ============================================================================
// Angle Normalization
// ============================================================================

/// Normalize angle to [0, 65535] range
/// For u16 this is a no-op since it naturally wraps
/// Included for API completeness when porting code
@inline
pub fn normalize(angle: u16) -> u16 {
    return angle  // u16 naturally wraps
}

/// Normalize a signed angle (i32) to u16 range
/// Handles negative angles correctly
@suppress("W0001", "Arithmetic is intentional")
@suppress("W0002", "Cast is intentional")
pub fn normalize_i32(angle: i32) -> u16 {
    // Reduce to reasonable range first
    var a = angle

    // Handle very large values
    while a >= 65536 {
        a = a - 65536
    }
    while a < 0 {
        a = a + 65536
    }

    return (u16)a
}

// ============================================================================
// Angle Difference
// ============================================================================

/// Get the signed difference between two angles
/// Returns the shortest path from 'from' to 'to'
/// Result is in range [-32768, 32767] (i.e., -180° to +180°)
@suppress("W0001", "Arithmetic is intentional")
@suppress("W0002", "Cast is intentional")
pub fn angle_diff(angle_from: u16, angle_to: u16) -> i16 {
    // The trick: subtracting u16 values gives the wrapped difference
    // Then interpret as signed for shortest path
    let diff: u16 = angle_to - angle_from
    return (i16)diff
}

/// Get the absolute (unsigned) difference between two angles
/// Always returns the smaller of the two possible arcs
@suppress("W0001", "Arithmetic is intentional")
@suppress("W0002", "Cast is intentional")
pub fn angle_diff_abs(a: u16, b: u16) -> u16 {
    let signed_diff = angle_diff(a, b)
    if signed_diff < 0i16 {
        return (u16)(-signed_diff)
    }
    return (u16)signed_diff
}

// ============================================================================
// Angle Comparison
// ============================================================================

/// Check if angle is between start and end (going clockwise)
/// Handles wrap-around correctly
@suppress("W0001", "Arithmetic is intentional")
pub fn angle_between(angle: u16, start: u16, end: u16) -> bool {
    // Normalize so start is at 0
    let norm_angle = angle - start
    let norm_end = end - start
    return norm_angle <= norm_end
}

/// Check if two angles are approximately equal within tolerance
@suppress("W0001", "Arithmetic is intentional")
pub fn angle_approx_eq(a: u16, b: u16, tolerance: u16) -> bool {
    let diff = angle_diff_abs(a, b)
    return diff <= tolerance
}

// ============================================================================
// Angle Interpolation
// ============================================================================

/// Linear interpolation between two angles (shortest path)
/// t should be in range [0.0, 1.0] as Fixed32
@suppress("W0001", "Arithmetic is intentional")
@suppress("W0002", "Cast is intentional")
pub fn angle_lerp(angle_from: u16, angle_to: u16, t: Fixed32) -> u16 {
    // Get signed difference (shortest path)
    let diff = angle_diff(angle_from, angle_to)

    // Scale difference by t
    let scaled = Fixed32::from_i32((i32)diff).mul(t)

    // Add to starting angle
    return angle_from + (u16)(i16)scaled.to_i32()
}

/// Smoothstep interpolation between two angles
@suppress("W0001", "Arithmetic is intentional")
@suppress("W0002", "Cast is intentional")
pub fn angle_smoothstep(angle_from: u16, angle_to: u16, t: Fixed32) -> u16 {
    // Apply smoothstep to t
    let t_smooth = t.mul(t).mul(Fixed32::from_i32(3).sub(Fixed32::from_i32(2).mul(t)))

    return angle_lerp(angle_from, angle_to, t_smooth)
}

// ============================================================================
// Angle Movement
// ============================================================================

/// Move angle towards target by at most max_delta
/// Takes the shortest path
@suppress("W0001", "Arithmetic is intentional")
@suppress("W0002", "Cast is intentional")
pub fn angle_move_towards(current: u16, target: u16, max_delta: u16) -> u16 {
    let diff = angle_diff(current, target)

    // Already at target?
    if diff == 0i16 {
        return target
    }

    var abs_diff = diff
    if abs_diff < 0i16 {
        abs_diff = -abs_diff
    }

    // Can reach target in one step?
    if (u16)abs_diff <= max_delta {
        return target
    }

    // Move towards target
    if diff > 0i16 {
        return current + max_delta
    }
    return current - max_delta
}

/// Rotate angle towards target with damping
/// Good for smooth camera/turret following
@suppress("W0001", "Arithmetic is intentional")
@suppress("W0002", "Cast is intentional")
pub fn angle_damp(current: u16, target: u16, factor: Fixed32) -> u16 {
    let diff = angle_diff(current, target)
    let scaled = Fixed32::from_i32((i32)diff).mul(factor)
    return current + (u16)(i16)scaled.to_i32()
}

// ============================================================================
// Angle Snapping
// ============================================================================

/// Snap angle to nearest multiple of snap_angle
@suppress("W0001", "Arithmetic is intentional")
@suppress("W0002", "Cast is intentional")
pub fn angle_snap(angle: u16, snap_angle: u16) -> u16 {
    if snap_angle == 0u16 {
        return angle
    }

    // Round to nearest snap point
    let half_snap = snap_angle >> 1u16
    let adjusted = angle + half_snap
    let quotient = adjusted / snap_angle
    return quotient * snap_angle
}

/// Snap angle to nearest 45-degree increment
@inline
pub fn angle_snap_45(angle: u16) -> u16 {
    return angle_snap(angle, ANGLE_45)
}

/// Snap angle to nearest 90-degree increment
@inline
pub fn angle_snap_90(angle: u16) -> u16 {
    return angle_snap(angle, ANGLE_QUARTER)
}

/// Snap angle to nearest cardinal/ordinal direction (8-way)
@inline
pub fn angle_snap_8way(angle: u16) -> u16 {
    return angle_snap(angle, ANGLE_45)
}

/// Snap angle to cardinal direction only (4-way: N, E, S, W)
@inline
pub fn angle_snap_4way(angle: u16) -> u16 {
    return angle_snap(angle, ANGLE_QUARTER)
}

// ============================================================================
// Direction Helpers
// ============================================================================

/// Get direction index (0-7) for 8-way movement
/// 0 = right, 1 = down-right, 2 = down, etc. (clockwise)
@inline
@suppress("W0001", "Arithmetic is intentional")
pub fn angle_to_8way(angle: u16) -> u8 {
    // Add half a sector (22.5°) then divide by sector size (45°)
    let adjusted = angle + 4096u16  // Half of 8192
    return (u8)(adjusted / 8192u16)
}

/// Get direction index (0-3) for 4-way movement
/// 0 = right, 1 = down, 2 = left, 3 = up
@inline
@suppress("W0001", "Arithmetic is intentional")
pub fn angle_to_4way(angle: u16) -> u8 {
    let adjusted = angle + 8192u16  // Half of 16384
    return (u8)(adjusted / 16384u16)
}

/// Convert 8-way direction index to angle
@inline
@suppress("W0001", "Arithmetic is intentional")
pub fn angle_from_8way(direction: u8) -> u16 {
    return (u16)direction * 8192u16
}

/// Convert 4-way direction index to angle
@inline
@suppress("W0001", "Arithmetic is intentional")
pub fn angle_from_4way(direction: u8) -> u16 {
    return (u16)direction * 16384u16
}

// ============================================================================
// Quadrant Helpers
// ============================================================================

/// Get which quadrant an angle is in (0-3)
/// 0 = Q1 (0-90°), 1 = Q2 (90-180°), 2 = Q3 (180-270°), 3 = Q4 (270-360°)
@inline
@suppress("W0001", "Bit operations are intentional")
pub fn quadrant(angle: u16) -> u8 {
    return (u8)(angle >> 14u16)
}

/// Check if angle is in the right half (facing right, -90° to +90°)
@inline
@suppress("W0001", "Arithmetic is intentional")
pub fn facing_right(angle: u16) -> bool {
    // Right half is -90° to +90°, i.e., 270° to 90° (with wraparound)
    // That's 49152 to 16384 (wrapping through 0)
    return angle >= 49152u16 || angle <= 16384u16
}

/// Check if angle is in the left half (facing left)
@inline
pub fn facing_left(angle: u16) -> bool {
    return !facing_right(angle)
}

/// Check if angle is in the upper half (facing up, 0° to 180°)
@inline
@suppress("W0001", "Arithmetic is intentional")
pub fn facing_up(angle: u16) -> bool {
    return angle < ANGLE_HALF
}

/// Check if angle is in the lower half (facing down, 180° to 360°)
@inline
pub fn facing_down(angle: u16) -> bool {
    return angle >= ANGLE_HALF
}

// ============================================================================
// Angle from delta
// ============================================================================

/// Calculate angle from dx, dy deltas
/// Uses atan2 approximation from trig module
@suppress("W0001", "Arithmetic is intentional")
pub fn angle_from_delta(dx: i32, dy: i32) -> u16 {
    return atan2_angle(dy, dx)
}

/// Calculate angle from dx, dy deltas (i16 version)
@inline
@suppress("W0002", "Cast is intentional")
pub fn angle_from_delta_i16(dx: i16, dy: i16) -> u16 {
    return angle_from_delta((i32)dx, (i32)dy)
}
