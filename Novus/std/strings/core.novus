// Novus Standard Library - Strings Module
// Namespace: std::strings
// Powerful, ergonomic, Amiga-optimized string types

from std::core import Option, Result, Drop, Clone, AsRef, Iterator, Write, Ord, Error
from std::collections::vec import Vec
from std::memory::block import MemoryBlock
from std::ffi::exec import FreeMem
from std::ffi::amiga_consts import MEMF_PUBLIC, MEMF_CLEAR

// ============================================================================
// Error Types
// ============================================================================

/// Errors that can occur during string operations
pub enum StringError {
    /// Index out of bounds: (index, length)
    OutOfBounds(u32, u32),
    /// Invalid UTF-8 byte sequence at position
    InvalidUtf8(u32),
    /// Memory allocation failed
    AllocationFailed,
    /// String too long (for BCPL strings: max 255 bytes)
    TooLong(u32),
    /// Invalid format during parsing or formatting
    InvalidFormat,
    /// Null pointer passed where valid pointer expected
    NullPointer,
}

impl StringError {
    pub fn message(&self) -> *u8 {
        match *self {
            StringError::OutOfBounds(_, _) => return "Index out of bounds",
            StringError::InvalidUtf8(_) => return "Invalid UTF-8 sequence",
            StringError::AllocationFailed => return "String allocation failed",
            StringError::TooLong(_) => return "String too long",
            StringError::InvalidFormat => return "Invalid string format",
            StringError::NullPointer => return "Null pointer",
        }
    }
}

impl Error for StringError {
    fn message(&self) -> *u8 {
        return StringError::message(self)
    }
}

// ============================================================================
// Str - Borrowed String Slice (Fat Pointer)
// ============================================================================

/// Borrowed string slice - immutable view into string data
///
/// This is a "fat pointer" containing a pointer and length.
/// It does NOT own the data - just a view into existing memory.
/// Size: 8 bytes (4 bytes ptr + 4 bytes len).
///
/// Use this for:
/// - Function parameters (avoid copying)
/// - Temporary views / substrings
/// - String slices
///
/// Example:
/// ```novus
/// fn greet(name: Str) {
///     // name is just a view, no allocation
/// }
/// let s: Str = Str::from_cstr("Hello")
/// greet(s)  // Zero-cost pass
/// ```
pub struct Str {
    ptr: *u8,
    len: u32,
}

impl Str {
    /// Create a Str from a raw pointer and length
    ///
    /// SAFETY: Caller must ensure ptr points to valid memory of at least len bytes
    pub fn from_raw(ptr: *u8, len: u32) -> Str {
        return Str { ptr: ptr, len: len }
    }

    /// Create a Str from a null-terminated C string
    /// Scans for null terminator to determine length
    ///
    /// Returns None if ptr is null
    pub fn from_cstr(ptr: *u8) -> Option<Str> {
        // Check for null pointer before calling strlen
        if (u32)ptr == 0 {
            return Option::None
        }
        return Option::Some(Str { ptr: ptr, len: strlen(ptr) })
    }

    /// Get the length of the string in bytes
    @inline
    pub fn len(&self) -> u32 {
        return self.len
    }

    /// Check if the string is empty
    @inline
    pub fn is_empty(&self) -> bool {
        return self.len == 0u32
    }

    /// Get a pointer to the string data
    @inline
    pub fn as_ptr(&self) -> *u8 {
        return self.ptr
    }

    /// Get the byte at the given index
    /// Returns None if index is out of bounds
    pub fn get(&self, index: u32) -> Option<u8> {
        return if index >= self.len { Option::None } else { Option::Some(self.ptr[index]) }
    }

    /// Create a substring slice
    /// Returns Result with bounds checking
    ///
    /// Example:
    /// ```novus
    /// let s = Str::from_cstr("Hello, World!")
    /// let hello_result = s.slice(0, 5)
    /// match hello_result {
    ///     Ok(hello) => // use hello
    ///     Err(e) => // handle error
    /// }
    /// ```
    pub fn slice(&self, start: u32, end: u32) -> Result<Str, StringError> {
        if start > end {
            return Result::Err(StringError::OutOfBounds(start, self.len))
        }
        if end > self.len {
            return Result::Err(StringError::OutOfBounds(end, self.len))
        }

        let new_len: u32 = end - start
        let new_ptr: *u8 = self.ptr + start

        return Result::Ok(Str { ptr: new_ptr, len: new_len })
    }

    /// Create a slice from start to end of string
    pub fn slice_from(&self, start: u32) -> Result<Str, StringError> {
        if start > self.len {
            return Result::Err(StringError::OutOfBounds(start, self.len))
        }

        let new_len: u32 = self.len - start
        let new_ptr: *u8 = self.ptr + start

        return Result::Ok(Str { ptr: new_ptr, len: new_len })
    }

    /// Create a slice from beginning to end
    pub fn slice_to(&self, end: u32) -> Result<Str, StringError> {
        if end > self.len {
            return Result::Err(StringError::OutOfBounds(end, self.len))
        }

        return Result::Ok(Str { ptr: self.ptr, len: end })
    }

    /// Compare two strings for equality
    ///
    /// On 68020+, uses optimized inline assembly with cmpm.l for ~4x speedup on long strings.
    /// Falls back to byte-by-byte on 68000/68010 or for short strings.
    pub fn equals(&self, other: Str) -> bool {
        if self.len != other.len {
            return false
        }

#if M68020_PLUS
        // 68020+ optimization using inline assembly
        // Uses cmpm.l for efficient memory comparison (compares and auto-increments)
        let len: u32 = self.len

        // For strings >= 8 bytes, use optimized 32-bit comparison loop
        if len >= 8 {
            let word_count: u32 = len / 4
            let self_ptr: *u8 = self.ptr
            let other_ptr: *u8 = other.ptr

            // Compare 32-bit words using cmpm.l (a0)+,(a1)+
            // Returns 1 if equal, 0 if not equal
            let words_equal: u32 = unsafe asm(self_ptr in a0, other_ptr in a1, word_count in d1) -> u32 in d0 clobbers(d1) {
                subq.l  #1,d1           ; Convert count to dbra format (count-1)
                bmi.s   words_eq        ; If count was 0, skip loop
            words_loop:
                cmpm.l  (a0)+,(a1)+     ; Compare longwords, advance pointers
                dbne    d1,words_loop   ; Continue if equal and count not exhausted
                bne.s   words_ne        ; If last compare was not equal, fail
            words_eq:
                moveq   #1,d0           ; Equal - return 1
                bra.s   words_done
            words_ne:
                moveq   #0,d0           ; Not equal - return 0
            words_done:
            }

            if words_equal == 0 {
                return false
            }

            // Compare remaining bytes (0-3) using cmpm.b
            let remaining: u32 = len - (word_count * 4)
            if remaining > 0 {
                // a0 and a1 are already advanced past the compared longs
                // We need fresh pointers offset to the remaining bytes
                let rem_self: *u8 = (*u8)((u32)self.ptr + word_count * 4)
                let rem_other: *u8 = (*u8)((u32)other.ptr + word_count * 4)

                let bytes_equal: u32 = unsafe asm(rem_self in a0, rem_other in a1, remaining in d1) -> u32 in d0 clobbers(d1) {
                    subq.l  #1,d1           ; Convert count to dbra format
                    bmi.s   bytes_eq        ; If count was 0, skip loop
                bytes_loop:
                    cmpm.b  (a0)+,(a1)+     ; Compare bytes, advance pointers
                    dbne    d1,bytes_loop   ; Continue if equal and count not exhausted
                    bne.s   bytes_ne        ; If last compare was not equal, fail
                bytes_eq:
                    moveq   #1,d0           ; Equal
                    bra.s   bytes_done
                bytes_ne:
                    moveq   #0,d0           ; Not equal
                bytes_done:
                }

                if bytes_equal == 0 {
                    return false
                }
            }

            return true
        }
#endif

        // Fallback: byte-by-byte comparison (for 68000/68010 or short strings)
        while var i < self.len {
            if self.ptr[i] != other.ptr[i] {
                return false
            }
            i = i + 1
        }

        return true
    }

    /// Compare two strings lexicographically
    /// Returns: <0 if self < other, 0 if equal, >0 if self > other
    @suppress("W0002", "Safe truncation for string comparison: byte values (0-255) and length differences fit in i32 range")
    pub fn compare(&self, other: Str) -> i32 {
        var min_len: u32 = self.len
        if other.len < self.len {
            min_len = other.len
        }

        while var i < min_len {
            let a: u8 = self.ptr[i]
            let b: u8 = other.ptr[i]
            if a != b {
                return (i32)a - (i32)b
            }
            i++
        }

        // All common bytes equal, compare lengths
        return (i32)self.len - (i32)other.len
    }

    /// Case-insensitive equality check
    ///
    /// Compares two strings ignoring ASCII case (a-z == A-Z).
    /// Only converts ASCII letters; other characters are compared as-is.
    ///
    /// # Example
    /// ```novus
    /// let a = "Hello"
    /// let b = "HELLO"
    /// if a.eq_ignore_case(b) {
    ///     println("Equal!")  // Will print
    /// }
    /// ```
    pub fn eq_ignore_case(&self, other: Str) -> bool {
        if self.len != other.len {
            return false
        }

        for i in 0u32..self.len {
            var ca = self.ptr[i]
            var cb = other.ptr[i]

            // Convert lowercase ASCII to uppercase
            if ca >= $61 && ca <= $7A {
                ca = ca - $20
            }
            if cb >= $61 && cb <= $7A {
                cb = cb - $20
            }

            if ca != cb {
                return false
            }
        }

        return true
    }

    /// Check if string starts with prefix
    pub fn starts_with(&self, prefix: Str) -> bool {
        if prefix.len > self.len {
            return false
        }

        while var i < prefix.len {
            if self.ptr[i] != prefix.ptr[i] {
                return false
            }
            i++
        }

        return true
    }

    /// Check if string ends with suffix
    pub fn ends_with(&self, suffix: Str) -> bool {
        if suffix.len > self.len {
            return false
        }

        let offset: u32 = self.len - suffix.len
        while var i < suffix.len {
            if self.ptr[offset + i] != suffix.ptr[i] {
                return false
            }
            i++
        }

        return true
    }

    /// Check if string starts with prefix (case-insensitive)
    pub fn starts_with_ignore_case(&self, prefix: Str) -> bool {
        if prefix.len > self.len {
            return false
        }

        for i in 0u32..prefix.len {
            var ca = self.ptr[i]
            var cb = prefix.ptr[i]

            // Convert lowercase ASCII to uppercase
            if ca >= $61 && ca <= $7A {
                ca = ca - $20
            }
            if cb >= $61 && cb <= $7A {
                cb = cb - $20
            }

            if ca != cb {
                return false
            }
        }

        return true
    }

    /// Check if string contains substring
    pub fn contains(&self, needle: Str) -> bool {
        return self.find(needle).is_some()
    }

    /// Find first occurrence of substring
    /// Returns Some(index) if found, None if not found
    pub fn find(&self, needle: Str) -> Option<u32> {
        if needle.len == 0 {
            return Option::Some(0u32)
        }
        if needle.len > self.len {
            return Option::None
        }

        let last_pos: u32 = self.len - needle.len
        while var i <= last_pos {
            // Check if needle matches at position i
            var matches: bool = true
            while var j < needle.len {
                if self.ptr[i + j] != needle.ptr[j] {
                    matches = false
                    j = needle.len  // Break inner loop
                }
                j++
            }

            if matches {
                return Option::Some(i)
            }
            i++
        }

        return Option::None
    }

    /// Find first occurrence of byte
    pub fn find_byte(&self, byte: u8) -> Option<u32> {
        while var i < self.len {
            if self.ptr[i] == byte {
                return Option::Some(i)
            }
            i++
        }
        return Option::None
    }

    /// Find last occurrence of byte
    pub fn rfind_byte(&self, byte: u8) -> Option<u32> {
        if self.len == 0 {
            return Option::None
        }

        var i: u32 = self.len - 1u32
        var found: bool = false
        while !found {
            if self.ptr[i] == byte {
                return Option::Some(i)
            }
            if i == 0 {
                return Option::None
            }
            i--
        }
        return Option::None
    }

    /// Trim whitespace from both ends
    pub fn trim(&self) -> Str {
        let s1: Str = self.trim_start()
        return s1.trim_end()
    }

    /// Trim whitespace from start
    pub fn trim_start(&self) -> Str {
        while var start < self.len {
            let ch: u8 = self.ptr[start]
            if ch != $20 && ch != $09 && ch != $0A && ch != $0D {
                // Not space, tab, LF, or CR - stop trimming
                let new_len: u32 = self.len - start
                let new_ptr: *u8 = self.ptr + start
                return Str { ptr: new_ptr, len: new_len }
            }
            start++
        }

        // All whitespace
        return Str { ptr: self.ptr, len: 0u32 }
    }

    /// Trim whitespace from end
    pub fn trim_end(&self) -> Str {
        if self.len == 0 {
            return Str { ptr: self.ptr, len: 0u32 }
        }

        var end: u32 = self.len
        var done: bool = false
        while !done {
            let ch: u8 = self.ptr[end - 1u32]
            if ch != $20 && ch != $09 && ch != $0A && ch != $0D {
                // Not whitespace - we found the end
                return Str { ptr: self.ptr, len: end }
            }
            end--
            if end == 0 {
                // All whitespace
                return Str { ptr: self.ptr, len: 0u32 }
            }
        }
        return Str { ptr: self.ptr, len: 0u32 }
    }

    /// Convert to owned String (allocates)
    pub fn to_string(&self) -> Result<String, StringError> {
        return String::new_from_str(Str { ptr: self.ptr, len: self.len })
    }

    /// Get a null-terminated C string pointer
    /// WARNING: Only safe if the underlying data is null-terminated!
    /// For string literals this is safe. For slices, you must ensure null termination.
    pub fn as_cstr(&self) -> *u8 {
        return self.ptr
    }
}

// ============================================================================
// String - Owned, Heap-Allocated, Mutable String
// ============================================================================

/// Owned string backed by Vec<u8>
///
/// Heap-allocated, growable, mutable string.
/// Uses Vec<u8> for storage (same growth strategy).
///
/// Use this for:
/// - Building strings dynamically
/// - Mutable string data
/// - Concatenation and modifications
/// - Owning string data
///
/// Example:
/// ```novus
/// var s = String::new()
/// s.push_str(Str::from_cstr("Hello"))
/// s.push_str(Str::from_cstr(", World!"))
/// ```
pub struct String {
    vec: Vec<u8>,
}

impl String {
    /// Create a new empty string
    pub fn new() -> String {
        return String { vec: Vec::<u8>::new() }
    }

    /// Create a string with pre-allocated capacity
    ///
    /// Returns `Result::Err(StringError::AllocationFailed)` if allocation fails.
    ///
    /// # Example
    /// ```novus
    /// let s = String::with_capacity(100)?
    /// ```
    pub fn with_capacity(capacity: u32) -> Result<String, StringError> {
        // Use Vec::new for zero capacity to avoid allocation
        if capacity == 0 {
            return Result::Ok(String::new())
        }

        // Create a new String and reserve capacity on its internal Vec
        var result = String::new()
        match result.vec.reserve(capacity) {
            Result::Ok(_) => return Result::Ok(result),
            Result::Err(_) => return Result::Err(StringError::AllocationFailed),
        }
    }

    /// Create a String from a Str slice (allocates and copies)
    pub fn new_from_str(s: Str) -> Result<String, StringError> {
        // Create empty string and reserve capacity
        var string = String::new()
        match string.vec.reserve(s.len()) {
            Result::Ok(_) => {},
            Result::Err(_) => return Result::Err(StringError::AllocationFailed),
        }

        // Copy bytes from Str into Vec
        while var i < s.len() {
            match string.vec.push(s.as_ptr()[i]) {
                Result::Ok(_) => {},
                Result::Err(_) => return Result::Err(StringError::AllocationFailed),
            }
            i++
        }

        return Result::Ok(string)
    }

    /// Get the length of the string in bytes
    @inline
    pub fn len(&self) -> u32 {
        return self.vec.len
    }

    /// Check if the string is empty
    @inline
    pub fn is_empty(&self) -> bool {
        return self.vec.is_empty()
    }

    /// Get the capacity
    @inline
    pub fn capacity(&self) -> u32 {
        return self.vec.capacity()
    }

    /// Get the string as a Str slice
    @inline
    pub fn as_str(&self) -> Str {
        return Str::from_raw((*u8)self.vec.as_ptr(), self.vec.len)
    }

    /// Push a string slice onto the end
    ///
    /// Returns `Result::Err(StringError::AllocationFailed)` if allocation fails.
    ///
    /// # Example
    /// ```novus
    /// var s = String::new()
    /// s.push_str(Str::from_cstr("Hello")?)?
    /// ```
    pub fn push_str(&var self, s: Str) -> Result<(), StringError> {
        if s.is_empty() {
            return Result::Ok(())
        }

        // Copy bytes from Str
        while var i < s.len() {
            match self.vec.push(s.as_ptr()[i]) {
                Result::Ok(_) => {},
                Result::Err(_) => return Result::Err(StringError::AllocationFailed),
            }
            i++
        }

        return Result::Ok(())
    }

    /// Push a single byte onto the end
    ///
    /// Returns `Result::Err(StringError::AllocationFailed)` if allocation fails.
    ///
    /// # Example
    /// ```novus
    /// var s = String::new()
    /// s.push_byte(65)?  // Push 'A'
    /// ```
    pub fn push_byte(&var self, byte: u8) -> Result<(), StringError> {
        match self.vec.push(byte) {
            Result::Ok(_) => return Result::Ok(()),
            Result::Err(_) => return Result::Err(StringError::AllocationFailed),
        }
    }

    /// Clear the string (keeps capacity)
    pub fn clear(&var self) {
        self.vec.clear()
    }

    /// Reserve additional capacity
    ///
    /// Returns `Result::Err(StringError::AllocationFailed)` if allocation fails.
    ///
    /// # Example
    /// ```novus
    /// var s = String::new()
    /// s.reserve(100)?
    /// ```
    pub fn reserve(&var self, additional: u32) -> Result<(), StringError> {
        match self.vec.reserve(additional) {
            Result::Ok(_) => return Result::Ok(()),
            Result::Err(_) => return Result::Err(StringError::AllocationFailed),
        }
    }

    /// Get mutable pointer to underlying buffer
    pub fn as_mut_ptr(&var self) -> *u8 {
        return (*u8)self.vec.as_mut_ptr()
    }

    /// Get immutable pointer to underlying buffer
    pub fn as_ptr(&self) -> *u8 {
        return (*u8)self.vec.as_ptr()
    }

    /// Manually free the string's memory
    /// Call this when you need explicit cleanup (e.g., in tests)
    pub fn drop(&var self) {
        self.vec.drop()
    }
}

// Automatic cleanup for String (RAII)
impl Drop for String {
    fn drop(&var self) {
        self.vec.drop()
    }
}

// ============================================================================
// Fixed-Size String Types (Stack-Allocated)
// ============================================================================

/// 32-byte fixed string for short names
pub struct NameString {
    buf: [u8; 32],
    len: u32,
}

impl NameString {
    pub fn new() -> NameString {
        return NameString { buf: [0u8; 32], len: 0u32 }
    }

    pub fn len(&self) -> u32 {
        return self.len
    }

    pub fn is_empty(&self) -> bool {
        return self.len == 0u32
    }

    pub fn capacity(&self) -> u32 {
        return 32
    }

    pub fn as_str(&self) -> Str {
        return Str::from_raw((*u8)(&self.buf), self.len)
    }

    pub fn as_mut_ptr(&var self) -> *u8 {
        return (*u8)(&self.buf)
    }

    pub fn push_str(&var self, s: Str) -> Result<(), StringError> {
        if self.len + s.len() > 32 {
            return Result::Err(StringError::TooLong(self.len + s.len()))
        }

        while var i < s.len() {
            self.buf[self.len + i] = s.as_ptr()[i]
            i++
        }

        self.len += s.len()
        return Result::Ok(())
    }

    pub fn push_byte(&var self, byte: u8) -> Result<(), StringError> {
        if self.len >= 32 {
            return Result::Err(StringError::TooLong(self.len + 1))
        }

        self.buf[self.len] = byte
        self.len++
        return Result::Ok(())
    }

    pub fn clear(&var self) {
        self.len = 0
    }
}

/// 128-byte fixed string for gadget buffers
pub struct GadgetString {
    buf: [u8; 128],
    len: u32,
}

impl GadgetString {
    pub fn new() -> GadgetString {
        return GadgetString { buf: [0u8; 128], len: 0u32 }
    }

    pub fn len(&self) -> u32 {
        return self.len
    }

    pub fn is_empty(&self) -> bool {
        return self.len == 0u32
    }

    pub fn capacity(&self) -> u32 {
        return 128
    }

    pub fn as_str(&self) -> Str {
        return Str::from_raw((*u8)(&self.buf), self.len)
    }

    pub fn as_mut_ptr(&var self) -> *u8 {
        return (*u8)(&self.buf)
    }

    pub fn push_str(&var self, s: Str) -> Result<(), StringError> {
        if self.len + s.len() > 128 {
            return Result::Err(StringError::TooLong(self.len + s.len()))
        }

        while var i < s.len() {
            self.buf[self.len + i] = s.as_ptr()[i]
            i++
        }

        self.len += s.len()
        return Result::Ok(())
    }

    pub fn push_byte(&var self, byte: u8) -> Result<(), StringError> {
        if self.len >= 128 {
            return Result::Err(StringError::TooLong(self.len + 1))
        }

        self.buf[self.len] = byte
        self.len++
        return Result::Ok(())
    }

    pub fn clear(&var self) {
        self.len = 0
    }
}

