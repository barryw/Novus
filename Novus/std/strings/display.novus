// std::fmt_primitives - Display and Debug implementations for primitive types
// Auto-imported by compiler for string interpolation support

from std::strings::format import Formatter, Display, Debug
from std::strings::core import Str, String
from std::error::errors import StringError

// Helper functions for integer to string conversion
// These are built-in compiler intrinsics that will be implemented in the runtime

extern fn i8_to_string(value: i8, buffer: *u8, buffer_size: u32) -> u32
extern fn i16_to_string(value: i16, buffer: *u8, buffer_size: u32) -> u32
extern fn i32_to_string(value: i32, buffer: *u8, buffer_size: u32) -> u32
extern fn i64_to_string(value: i64, buffer: *u8, buffer_size: u32) -> u32

extern fn u8_to_string(value: u8, buffer: *u8, buffer_size: u32) -> u32
extern fn u16_to_string(value: u16, buffer: *u8, buffer_size: u32) -> u32
extern fn u32_to_string(value: u32, buffer: *u8, buffer_size: u32) -> u32
extern fn u64_to_string(value: u64, buffer: *u8, buffer_size: u32) -> u32

// i8 implementations
impl Display for i8 {
    fn fmt(&self, f: &var Formatter) -> bool {
        var buffer = [0; 16]
        let len = i8_to_string(*self, (*u8)&buffer[0], 16)
        return f.write_str(Str::from_raw((*u8)&buffer[0], len))
    }
}

impl Debug for i8 {
    fn fmt(&self, f: &var Formatter) -> bool {
        var buffer = [0; 16]
        let len = i8_to_string(*self, (*u8)&buffer[0], 16)
        return f.write_str(Str::from_raw((*u8)&buffer[0], len))
    }
}

