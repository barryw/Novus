// bool implementations
impl Display for bool {
    fn fmt(&self, f: &var Formatter) -> bool {
        return f.write_str(if *self { "true" } else { "false" })
    }
}

impl Debug for bool {
    fn fmt(&self, f: &var Formatter) -> bool {
        return f.write_str(if *self { "true" } else { "false" })
    }
}

// Str implementations - string slices just write themselves directly
impl Display for Str {
    fn fmt(&self, f: &var Formatter) -> bool {
        // Work around: create a copy of the Str by accessing fields
        let str_copy = Str::from_raw(self.ptr, self.len)
        return f.write_str(str_copy)
    }
}

impl Debug for Str {
    fn fmt(&self, f: &var Formatter) -> bool {
        // For debug, we could add quotes, but for now just use Display
        // Work around: create a copy of the Str by accessing fields
        let str_copy = Str::from_raw(self.ptr, self.len)
        return f.write_str(str_copy)
    }
}

// String implementations - owned strings convert to Str and write
impl Display for String {
    fn fmt(&self, f: &var Formatter) -> bool {
        return f.write_str(self.as_str())
    }
}

impl Debug for String {
    fn fmt(&self, f: &var Formatter) -> bool {
        // For debug, we could add quotes, but for now just use Display
        return f.write_str(self.as_str())
    }
}
