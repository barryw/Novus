// Novus Standard Library - Buffered Window
// Namespace: std::ui::buffered_window
//
// Automatic double-buffered window with content preservation on resize.
// Designed for modern Amigas (68040+, 16MB+ RAM).
//
// Key Features:
// - Developer draws to off-screen buffer (never directly to window)
// - Content automatically preserved across resize operations
// - Refresh events handled transparently
// - RAII cleanup of all resources
//
// Example:
//   let window = BufferedWindow::new("My App", 640, 480)?
//
//   // Draw to buffer (not window directly!)
//   let ctx = window.draw_context()?
//   ctx.pen(1)
//   ctx.rect_fill(&Rect::from_pos_size(10, 10, 50, 50))
//
//   // Present buffer to screen
//   window.present()?
//
//   // Event loop
//   forever {
//       match window.wait_event() {
//           WindowEvent::Close => break,
//           WindowEvent::Resize(w, h) => {
//               // Buffer automatically resized!
//               // Just redraw and present
//               redraw_content(&window)?
//               window.present()?
//           },
//           WindowEvent::Refresh(_) => {
//               // Automatically blits buffer to window
//               // Developer doesn't need to do anything!
//           },
//           _ => {}
//       }
//   }

from std::core import Option, Result, Drop
from std::error::errors import IntuitionError, GraphicsError
from std::ui::window import WindowHandle, WindowEvent
from std::graphics::draw import DrawContext
from std::graphics::shapes import Rect
from std::ffi::amiga_structs import TagItem, Window, Screen, BitMap, RastPort
from std::ffi::amiga_consts import *
from std::ffi::graphics import AllocBitMap, FreeBitMap, BltBitMapRastPort, WaitBlit, InitRastPort
from std::ffi::intuition import BeginRefresh, EndRefresh
from std::ffi::exec import FreeVec, AllocVec
from std::strings::core import Str

// Minterm for straight copy (D = S)
const BLIT_COPY: u8 = $C0

// ============================================================================
// BufferedWindow - Automatic Double-Buffered Window
// ============================================================================

/// Double-buffered window with automatic content preservation.
///
/// This window maintains an off-screen bitmap buffer that matches the window's
/// dimensions. All drawing operations should target the buffer (via draw_context()),
/// not the window directly.
///
/// The buffer is automatically:
/// - Resized when the window is resized (NEWSIZE event)
/// - Blitted to the window on refresh events (REFRESHWINDOW)
/// - Cleaned up when the window is dropped (RAII)
///
/// Memory usage: width × height × depth bytes (e.g., 640×480×8 = 300KB)
/// Optimized for modern Amigas with 16MB+ RAM.
pub struct BufferedWindow {
    window: WindowHandle,      // RAII window wrapper
    buffer: *BitMap,            // Off-screen bitmap (owned)
    buffer_rp: *RastPort,       // RastPort for drawing to buffer (owned)
    width: i16,                 // Current buffer width
    height: i16,                // Current buffer height
    depth: u8,                  // Bitmap depth (from screen)
}

impl BufferedWindow {
    /// Create a buffered window with standard gadgets.
    ///
    /// Opens a SIMPLE_REFRESH window with close/drag/depth/size gadgets.
    /// Allocates an off-screen bitmap buffer matching the window dimensions.
    ///
    /// The buffer depth matches the screen's depth for optimal blitting.
    ///
    /// Returns Err if:
    /// - Window fails to open (IntuitionError)
    /// - Buffer allocation fails (GraphicsError)
    pub fn new(title: Str, width: i16, height: i16) -> Result<BufferedWindow, IntuitionError> {
        // Open window with SIMPLE_REFRESH (we handle all refresh)
        let window = WindowHandle::simple(title, width, height)?

        // Get screen and depth for buffer allocation
        let screen: *Screen = window.get_screen()
        // Screen has embedded BitMap struct (not a pointer), access directly
        let depth: u8 = unsafe { (*screen).BitMap.Depth }

        // Allocate off-screen bitmap buffer
        // BMF_CLEAR: Clear to color 0
        // BMF_DISPLAYABLE: Allocate in optimal format for blitting to screen
        // Pass pointer to screen's embedded BitMap as friend bitmap
        let buffer_result = allocate_buffer(width, height, depth, (*BitMap) unsafe { &(*screen).BitMap })
        match buffer_result {
            Result::Ok(buffer) => {
                // Allocate and initialize RastPort for drawing to buffer
                let buffer_rp_result = create_buffer_rastport(buffer)
                match buffer_rp_result {
                    Result::Ok(buffer_rp) => {
                        return Result::Ok(BufferedWindow {
                            window: window,
                            buffer: buffer,
                            buffer_rp: buffer_rp,
                            width: width,
                            height: height,
                            depth: depth,
                        })
                    },
                    Result::Err(err) => {
                        // Cleanup buffer before returning error
                        WaitBlit()
                        FreeBitMap(buffer)
                        return Result::Err(IntuitionError::WindowOpenFailed)
                    }
                }
            },
            Result::Err(err) => {
                return Result::Err(IntuitionError::WindowOpenFailed)
            }
        }
    }

    /// Get the underlying WindowHandle.
    ///
    /// Use this for operations not specific to buffering (e.g., set_titles).
    pub fn window_handle(&self) -> &WindowHandle {
        return &self.window
    }

    /// Get the off-screen buffer's RastPort for drawing.
    ///
    /// IMPORTANT: Always draw to this buffer, NOT to the window directly!
    ///
    /// After drawing, call present() to blit the buffer to the visible window.
    pub fn buffer_rastport(&self) -> *RastPort {
        return self.buffer_rp
    }

    /// Get a DrawContext for the off-screen buffer.
    ///
    /// This is the recommended way to draw to the buffer.
    ///
    /// Example:
    /// ```novus
    /// let ctx = window.draw_context()?
    /// ctx.pen(1)
    /// ctx.line(0, 0, 100, 100)
    /// window.present()?
    /// ```
    pub fn draw_context(&self) -> Result<DrawContext, GraphicsError> {
        return DrawContext::from_rastport(self.buffer_rp)
    }

    /// Get current buffer dimensions.
    pub fn buffer_size(&self) -> (i16, i16) {
        return (self.width, self.height)
    }

    /// Blit the entire off-screen buffer to the visible window.
    ///
    /// Call this after drawing to the buffer to make changes visible.
    /// This is a fast operation (BltBitMapRastPort uses the Blitter).
    ///
    /// Example:
    /// ```novus
    /// // Draw to buffer
    /// let ctx = window.draw_context()?
    /// ctx.clear(0)
    /// ctx.pen(1)
    /// ctx.rect_fill(&Rect::from_pos_size(10, 10, 50, 50))
    ///
    /// // Make it visible
    /// window.present()?
    /// ```
    pub fn present(&self) -> Result<(), GraphicsError> {
        unsafe {
            // Blit entire buffer to window at (0,0)
            // BLIT_COPY minterm = $C0 (D = S)
            BltBitMapRastPort(
                self.buffer,                    // Source bitmap
                0, 0,                           // Source x, y
                (*self.window.handle()).RPort,  // Dest RastPort (window)
                0, 0,                           // Dest x, y
                self.width, self.height,        // Size
                BLIT_COPY                       // Minterm (straight copy)
            )

            // Wait for blit to complete before allowing buffer modifications
            WaitBlit()
        }
        return Result::Ok(())
    }

    /// Wait for and process the next window event.
    ///
    /// This wraps WindowHandle::wait_event() but adds automatic refresh handling:
    /// - REFRESHWINDOW events trigger automatic buffer→window blit
    /// - NEWSIZE events trigger automatic buffer resize
    ///
    /// IMPORTANT: On NEWSIZE, the buffer is resized but NOT cleared.
    /// Content outside the new dimensions is lost. You should redraw after resize:
    ///
    /// ```novus
    /// match window.wait_event() {
    ///     WindowEvent::Resize(w, h) => {
    ///         redraw_content(&window)?  // Redraw to new buffer
    ///         window.present()?         // Show it
    ///     },
    ///     ...
    /// }
    /// ```
    pub fn wait_event(&var self) -> WindowEvent {
        let event = self.window.wait_event()

        match event {
            WindowEvent::Refresh(guard) => {
                // Automatically blit buffer to window
                // BeginRefresh already called by RefreshGuard
                unsafe {
                    BltBitMapRastPort(
                        self.buffer,
                        0, 0,
                        (*guard.window()).RPort,
                        0, 0,
                        self.width, self.height,
                        BLIT_COPY
                    )
                    WaitBlit()
                }
                // EndRefresh automatically called when RefreshGuard drops
                return event
            },
            WindowEvent::Resize(new_width, new_height) => {
                // Resize buffer to match new window dimensions
                let resize_result = self.resize_buffer(new_width, new_height)
                match resize_result {
                    Result::Ok(_) => {},
                    Result::Err(_) => {
                        // Buffer resize failed - keep old buffer
                        // This should be very rare (out of memory)
                    }
                }
                return event
            },
            _ => {
                return event
            }
        }
    }

    /// Poll for a single event (non-blocking).
    ///
    /// Like wait_event() but returns None if no events are pending.
    /// Also handles REFRESHWINDOW and NEWSIZE automatically.
    pub fn poll_event(&var self) -> Option<WindowEvent> {
        let event_opt = self.window.poll_event()

        match event_opt {
            Option::Some(event) => {
                match event {
                    WindowEvent::Refresh(guard) => {
                        // Automatically blit buffer to window
                        unsafe {
                            BltBitMapRastPort(
                                self.buffer,
                                0, 0,
                                (*guard.window()).RPort,
                                0, 0,
                                self.width, self.height,
                                BLIT_COPY
                            )
                            WaitBlit()
                        }
                        return Option::Some(event)
                    },
                    WindowEvent::Resize(new_width, new_height) => {
                        // Resize buffer to match new window dimensions
                        let resize_result = self.resize_buffer(new_width, new_height)
                        match resize_result {
                            Result::Ok(_) => {},
                            Result::Err(_) => {}
                        }
                        return Option::Some(event)
                    },
                    _ => {
                        return Option::Some(event)
                    }
                }
            },
            Option::None => {
                return Option::None
            }
        }
    }

    /// Resize the off-screen buffer to match new window dimensions.
    ///
    /// This is called automatically by wait_event() on NEWSIZE.
    /// You can also call it manually if needed.
    ///
    /// The old buffer contents are LOST. Redraw after resizing.
    ///
    /// Returns Err if buffer allocation fails (rare - out of memory).
    fn resize_buffer(&var self, new_width: i16, new_height: i16) -> Result<(), GraphicsError> {
        // Don't resize if dimensions haven't changed
        if new_width == self.width && new_height == self.height {
            return Result::Ok(())
        }

        // Get screen for friend bitmap
        // Screen has embedded BitMap struct (not a pointer)
        let screen: *Screen = self.window.get_screen()
        let friend_bitmap: *BitMap = (*BitMap) unsafe { &(*screen).BitMap }

        // Allocate new buffer
        let new_buffer_result = allocate_buffer(new_width, new_height, self.depth, friend_bitmap)
        match new_buffer_result {
            Result::Ok(new_buffer) => {
                // Allocate new RastPort
                let new_rp_result = create_buffer_rastport(new_buffer)
                match new_rp_result {
                    Result::Ok(new_rp) => {
                        // Free old buffer and RastPort
                        unsafe {
                            WaitBlit()  // Ensure no pending operations
                            FreeBitMap(self.buffer)
                            // Free old RastPort memory
                            FreeVec((*u8)self.buffer_rp)
                        }

                        // Install new buffer
                        self.buffer = new_buffer
                        self.buffer_rp = new_rp
                        self.width = new_width
                        self.height = new_height

                        return Result::Ok(())
                    },
                    Result::Err(err) => {
                        // Cleanup new buffer and keep old one
                        WaitBlit()
                        FreeBitMap(new_buffer)
                        return Result::Err(err)
                    }
                }
            },
            Result::Err(err) => {
                return Result::Err(err)
            }
        }
    }

    /// Clear the buffer to a solid color.
    ///
    /// Convenience method for clearing the entire off-screen buffer.
    /// Call present() afterward to make it visible.
    pub fn clear(&self, color_index: u8) {
        let ctx_result = self.draw_context()
        match ctx_result {
            Result::Ok(ctx) => {
                ctx.clear(color_index)
            },
            Result::Err(_) => {}
        }
    }
}

// Automatic cleanup for BufferedWindow (RAII)
impl Drop for BufferedWindow {
    fn drop(&var self) {
        // Check if buffer is non-null
        if self.buffer {
            unsafe {
                // CRITICAL: Wait for blitter before freeing bitmap
                WaitBlit()
                FreeBitMap(self.buffer)
                self.buffer = (*BitMap)0

                // Free RastPort memory
                if self.buffer_rp {
                    FreeVec((*u8)self.buffer_rp)
                    self.buffer_rp = (*RastPort)0
                }
            }
        }
        // window.drop() called automatically (RAII composition!)
    }
}

// ============================================================================
// Helper Functions
// ============================================================================

/// Allocate an off-screen bitmap buffer.
///
/// Uses AllocBitMap() with BMF_CLEAR | BMF_DISPLAYABLE flags.
/// The friend_bitmap parameter optimizes allocation for blitting to that bitmap.
fn allocate_buffer(width: i16, height: i16, depth: u8, friend_bitmap: *BitMap) -> Result<*BitMap, GraphicsError> {
    // BMF_CLEAR = 1, BMF_DISPLAYABLE = 2
    let flags: u32 = 1 | 2
    let bitmap = AllocBitMap((u32)width, (u32)height, (u32)depth, flags, friend_bitmap)

    if bitmap {
        return Result::Ok(bitmap)
    }

    return Result::Err(GraphicsError::BitMapAllocFailed)
}

/// Create and initialize a RastPort for drawing to a bitmap.
///
/// Allocates memory for a RastPort struct and initializes it with InitRastPort().
/// The RastPort's BitMap field is set to the provided bitmap.
fn create_buffer_rastport(bitmap: *BitMap) -> Result<*RastPort, GraphicsError> {
    // Allocate RastPort structure
    // AllocVec from std::ffi::exec (imported at top)
    // MEMF_PUBLIC, MEMF_CLEAR from std::ffi::amiga_consts (wildcard import)

    // RastPort is about 100 bytes, round up to 128 for safety
    let rp_ptr = AllocVec(128, MEMF_PUBLIC | MEMF_CLEAR)
    if !rp_ptr {
        return Result::Err(GraphicsError::InvalidRastPort)
    }

    let rp: *RastPort = (*RastPort)rp_ptr

    unsafe {
        // Initialize RastPort to safe defaults
        InitRastPort(rp)

        // Attach our bitmap to the RastPort
        // Use intermediate variable - Novus doesn't support (*ptr).field = value syntax
        let rp_ref = rp
        rp_ref.BitMap = bitmap
    }

    return Result::Ok(rp)
}

// ============================================================================
// Advanced Usage Notes
// ============================================================================
//
// ## Partial Redraws
//
// For efficiency, you can redraw only changed regions:
//
// ```novus
// fn update_region(window: &BufferedWindow, region: &Rect) {
//     let ctx = window.draw_context()?
//     // Draw only to region
//     ctx.rect_fill(region)
//
//     // Blit only the changed region (manual optimization)
//     unsafe {
//         BltBitMapRastPort(
//             window.buffer,
//             region.x_min, region.y_min,
//             (*window.window.handle()).RPort,
//             region.x_min, region.y_min,
//             region.width(), region.height(),
//             BLIT_COPY
//         )
//         WaitBlit()
//     }
// }
// ```
//
// ## Memory Usage
//
// Buffer size = width × height × depth / 8 bytes
// Examples:
// - 320×200×8 = 62.5 KB (classic resolution)
// - 640×480×8 = 300 KB (VGA)
// - 800×600×8 = 468 KB (SVGA)
// - 1024×768×8 = 768 KB (XGA)
//
// On modern Amigas (16MB+ RAM), these are trivial allocations.
//
// ## Triple Buffering
//
// For animation, allocate multiple buffers and rotate:
//
// ```novus
// struct TripleBuffered {
//     window: BufferedWindow,
//     back_buffer: *BitMap,
//     // Draw to back_buffer, swap with window.buffer, present
// }
// ```
//
// ## Blitter Optimization
//
// BltBitMapRastPort() uses the Blitter, which runs asynchronously.
// WaitBlit() ensures completion before modifying source/dest bitmaps.
// The Blitter is ~4× faster than CPU on 68000, ~2× on 68040/060.
//
