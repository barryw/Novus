// Novus Standard Library - Screen Management
// Namespace: std::ui::screen
//
// High-level wrappers for Intuition screen functions with RAII cleanup.
// For low-level FFI access, use std::ffi::intuition

from std::core import Option, Result, Drop
from std::error::errors import IntuitionError
from std::strings::core import Str
from std::memory::slice import Slice
from std::ffi::amiga_structs import TagItem, Screen, RastPort, BitMap, ViewPort
from std::ffi::intuition import OpenScreenTagList, CloseScreen, ScreenToFront, ScreenToBack, MoveScreen, ShowTitle, OpenWindowTagList
from std::ffi::amiga_consts import TAG_DONE, SA_*, WA_*, WFLG_*, IDCMP_*, CUSTOMSCREEN, OSCAN_TEXT, HIRES_KEY, LORESLACE_KEY, HIRESLACE_KEY, NTSC_MONITOR_ID
from std::ui::window import WindowHandle, open_window

// ============================================================================
// ScreenHandle - RAII wrapper for Intuition screens
// ============================================================================

/// RAII wrapper for Intuition screens with automatic cleanup
///
/// ScreenHandle provides:
/// - Automatic screen closing on drop (RAII)
/// - Safe field accessors without unsafe blocks
/// - Builder pattern for ergonomic screen creation
///
/// # Example
/// ```novus
/// let screen = ScreenHandle::lores("My Screen", 4)?
/// // ... use screen ...
/// // Screen automatically closed when handle goes out of scope
/// ```
pub struct ScreenHandle {
    screen: *Screen,
}

impl ScreenHandle {
    /// Open a screen with the given tag array
    ///
    /// Returns Err if screen fails to open.
    /// The tag array must include TAG_DONE as the last element.
    pub fn open(tags: Slice<TagItem>) -> Result<ScreenHandle, IntuitionError> {
        let screen = OpenScreenTagList(null, tags.ptr)

        if let scr = screen {
            return Result::Ok(ScreenHandle { screen: scr })
        }

        return Result::Err(IntuitionError::ScreenOpenFailed)
    }

    /// Create ScreenHandle from raw pointer (takes ownership)
    ///
    /// The screen will be automatically closed when the ScreenHandle is dropped.
    /// Only use this if you own the screen and it should be closed.
    pub fn from_raw(screen: *Screen) -> ScreenHandle {
        return ScreenHandle { screen: screen }
    }

    /// Extract raw pointer and prevent automatic cleanup
    ///
    /// This transfers ownership to the caller. The caller is responsible
    /// for closing the screen manually.
    pub fn into_raw(consuming self) -> *Screen {
        return self.screen
    }

    /// Get the raw Screen pointer for FFI calls
    pub fn handle(&self) -> *Screen {
        return self.screen
    }

    /// Get screen width
    pub fn width(&self) -> i16 {
        unsafe {
            return (*self.screen).Width
        }
    }

    /// Get screen height
    pub fn height(&self) -> i16 {
        unsafe {
            return (*self.screen).Height
        }
    }

    /// Get the screen's RastPort for drawing operations
    pub fn rastport(&self) -> *RastPort {
        unsafe {
            let rp_ref = &(*self.screen).RastPort
            return (*RastPort)rp_ref
        }
    }

    /// Get the screen's ViewPort for display manipulation
    pub fn viewport(&self) -> *ViewPort {
        unsafe {
            let vp_ref = &(*self.screen).ViewPort
            return (*ViewPort)vp_ref
        }
    }

    /// Get the screen's BitMap
    pub fn bitmap(&self) -> *BitMap {
        unsafe {
            let bm_ref = &(*self.screen).BitMap
            return (*BitMap)bm_ref
        }
    }

    /// Bring screen to front
    pub fn to_front(&self) {
        ScreenToFront(self.screen)
    }

    /// Send screen to back
    pub fn to_back(&self) {
        ScreenToBack(self.screen)
    }

    /// Move screen by delta (dx, dy)
    pub fn move_by(&self, dx: i16, dy: i16) {
        MoveScreen(self.screen, dx, dy)
    }

    /// Show or hide the screen title bar
    pub fn show_title(&self, show: bool) {
        let show_val: i16 = if show { 1 } else { 0 }
        ShowTitle(self.screen, show_val)
    }

    // ========================================================================
    // Window creation on this screen
    // ========================================================================

    /// Open a simple window on this screen
    ///
    /// Creates a window with standard gadgets (close, drag, depth, size)
    /// that is automatically associated with this screen.
    ///
    /// # Example
    /// ```novus
    /// let screen = ScreenHandle::lores("Game", 5)?
    /// let window = screen.open_window("Controls", 100, 50, 200, 100)?
    /// ```
    @suppress("W0002", "Casting dimensions to u32 for tags")
    pub fn open_window(&self, title: Str, x: i16, y: i16, width: i16, height: i16) -> Result<WindowHandle, IntuitionError> {
        let flags = WFLG_CLOSEGADGET | WFLG_DRAGBAR | WFLG_DEPTHGADGET | WFLG_SIZEGADGET | WFLG_SIZEBRIGHT | WFLG_SIZEBBOTTOM | WFLG_ACTIVATE
        let idcmp = IDCMP_CLOSEWINDOW | IDCMP_NEWSIZE | IDCMP_REFRESHWINDOW

        let tags = [
            TagItem { ti_Tag: WA_Left, ti_Data: (u32)x },
            TagItem { ti_Tag: WA_Top, ti_Data: (u32)y },
            TagItem { ti_Tag: WA_Width, ti_Data: (u32)width },
            TagItem { ti_Tag: WA_Height, ti_Data: (u32)height },
            TagItem { ti_Tag: WA_MinWidth, ti_Data: 50 },
            TagItem { ti_Tag: WA_MinHeight, ti_Data: 20 },
            TagItem { ti_Tag: WA_MaxWidth, ti_Data: (u32)self.width() },
            TagItem { ti_Tag: WA_MaxHeight, ti_Data: (u32)self.height() },
            TagItem { ti_Tag: WA_Title, ti_Data: (u32)title.ptr },
            TagItem { ti_Tag: WA_CustomScreen, ti_Data: (u32)self.screen },
            TagItem { ti_Tag: WA_Flags, ti_Data: flags },
            TagItem { ti_Tag: WA_IDCMP, ti_Data: idcmp },
            TagItem { ti_Tag: TAG_DONE, ti_Data: 0 }
        ]

        // Use the standalone open_window function and wrap in WindowHandle
        let result = open_window(&tags[0])
        match result {
            Result::Ok(win) => return Result::Ok(WindowHandle::from_raw(win)),
            Result::Err(e) => return Result::Err(e)
        }
    }

    /// Open a borderless backdrop window covering the entire screen
    ///
    /// This is useful for full-screen drawing where you want to handle
    /// all rendering yourself without window chrome.
    ///
    /// # Example
    /// ```novus
    /// let screen = ScreenHandle::lores("Demo", 5)?
    /// let window = screen.open_backdrop()?
    /// // Draw directly to window.rastport()
    /// ```
    @suppress("W0002", "Casting i16 to u32 for tags")
    pub fn open_backdrop(&self) -> Result<WindowHandle, IntuitionError> {
        let flags = WFLG_BORDERLESS | WFLG_BACKDROP | WFLG_ACTIVATE
        // Don't enable IDCMP_MOUSEMOVE by default - it floods the message port
        // and can cause hangs if messages aren't processed
        let idcmp = IDCMP_RAWKEY | IDCMP_MOUSEBUTTONS

        let tags = [
            TagItem { ti_Tag: WA_Left, ti_Data: 0 },
            TagItem { ti_Tag: WA_Top, ti_Data: 0 },
            TagItem { ti_Tag: WA_Width, ti_Data: (u32)self.width() },
            TagItem { ti_Tag: WA_Height, ti_Data: (u32)self.height() },
            TagItem { ti_Tag: WA_CustomScreen, ti_Data: (u32)self.screen },
            TagItem { ti_Tag: WA_Flags, ti_Data: flags },
            TagItem { ti_Tag: WA_IDCMP, ti_Data: idcmp },
            TagItem { ti_Tag: TAG_DONE, ti_Data: 0 }
        ]

        // Use the standalone open_window function and wrap in WindowHandle
        let result = open_window(&tags[0])
        match result {
            Result::Ok(win) => return Result::Ok(WindowHandle::from_raw(win)),
            Result::Err(e) => return Result::Err(e)
        }
    }

    // ========================================================================
    // Convenience constructors
    // ========================================================================

    /// Open a standard lores screen (320x256, PAL) or (320x200, NTSC)
    ///
    /// # Arguments
    /// * `title` - Screen title
    /// * `depth` - Number of bitplanes (1-5 for OCS/ECS, 1-8 for AGA)
    ///
    /// # Example
    /// ```novus
    /// let screen = ScreenHandle::lores("Game Screen", 5)?  // 32 colors
    /// ```
    @suppress("W0002", "Casting depth to u32 for tag")
    pub fn lores(title: Str, depth: i16) -> Result<ScreenHandle, IntuitionError> {
        // TODO: Detect PAL/NTSC at runtime
        // For now, hardcoded to NTSC (200 lines)
        let tags = [
            TagItem { ti_Tag: SA_DisplayID, ti_Data: NTSC_MONITOR_ID },
            TagItem { ti_Tag: SA_Width, ti_Data: 320 },
            TagItem { ti_Tag: SA_Height, ti_Data: 200 },
            TagItem { ti_Tag: SA_Depth, ti_Data: (u32)depth },
            TagItem { ti_Tag: SA_Title, ti_Data: (u32)title.ptr },
            TagItem { ti_Tag: SA_Type, ti_Data: CUSTOMSCREEN },
            TagItem { ti_Tag: TAG_DONE, ti_Data: 0 }
        ]

        return ScreenHandle::open(&tags)
    }

    /// Open a hires screen (640x256, PAL) or (640x200, NTSC)
    ///
    /// # Arguments
    /// * `title` - Screen title
    /// * `depth` - Number of bitplanes (1-4 for OCS/ECS hires, 1-8 for AGA)
    ///
    /// # Example
    /// ```novus
    /// let screen = ScreenHandle::hires("Workbench Clone", 2)?  // 4 colors
    /// ```
    @suppress("W0002", "Casting depth to u32 for tag")
    pub fn hires(title: Str, depth: i16) -> Result<ScreenHandle, IntuitionError> {
        // TODO: Detect PAL/NTSC at runtime
        // For now, hardcoded to NTSC (200 lines)
        // NTSC hires = NTSC_MONITOR_ID | HIRES_KEY = 0x00011000 | 0x00008000 = 0x00019000
        let ntsc_hires: u32 = NTSC_MONITOR_ID | HIRES_KEY
        let tags = [
            TagItem { ti_Tag: SA_DisplayID, ti_Data: ntsc_hires },
            TagItem { ti_Tag: SA_Width, ti_Data: 640 },
            TagItem { ti_Tag: SA_Height, ti_Data: 200 },
            TagItem { ti_Tag: SA_Depth, ti_Data: (u32)depth },
            TagItem { ti_Tag: SA_Title, ti_Data: (u32)title.ptr },
            TagItem { ti_Tag: SA_Type, ti_Data: CUSTOMSCREEN },
            TagItem { ti_Tag: TAG_DONE, ti_Data: 0 }
        ]

        return ScreenHandle::open(&tags)
    }

    /// Open a custom screen with specified dimensions
    ///
    /// # Arguments
    /// * `title` - Screen title
    /// * `width` - Screen width in pixels
    /// * `height` - Screen height in pixels
    /// * `depth` - Number of bitplanes
    ///
    /// # Example
    /// ```novus
    /// let screen = ScreenHandle::custom("Demo", 320, 256, 5)?
    /// ```
    @suppress("W0002", "Casting dimensions to u32 for tags")
    pub fn custom(title: Str, width: i16, height: i16, depth: i16) -> Result<ScreenHandle, IntuitionError> {
        let tags = [
            TagItem { ti_Tag: SA_Width, ti_Data: (u32)width },
            TagItem { ti_Tag: SA_Height, ti_Data: (u32)height },
            TagItem { ti_Tag: SA_Depth, ti_Data: (u32)depth },
            TagItem { ti_Tag: SA_Title, ti_Data: (u32)title.ptr },
            TagItem { ti_Tag: SA_Type, ti_Data: CUSTOMSCREEN },
            TagItem { ti_Tag: TAG_DONE, ti_Data: 0 }
        ]

        return ScreenHandle::open(&tags)
    }

    /// Open a lores interlaced screen (320x512, PAL) or (320x400, NTSC)
    ///
    /// # Arguments
    /// * `title` - Screen title
    /// * `depth` - Number of bitplanes (1-5 for OCS/ECS, 1-8 for AGA)
    ///
    /// # Example
    /// ```novus
    /// let screen = ScreenHandle::lores_lace("Interlaced Demo", 5)?  // 32 colors
    /// ```
    @suppress("W0002", "Casting depth to u32 for tag")
    pub fn lores_lace(title: Str, depth: i16) -> Result<ScreenHandle, IntuitionError> {
        // TODO: Detect PAL/NTSC at runtime
        // For now, hardcoded to NTSC (400 lines interlaced)
        // NTSC lores lace = NTSC_MONITOR_ID | LORESLACE_KEY
        let ntsc_lores_lace: u32 = NTSC_MONITOR_ID | LORESLACE_KEY
        let tags = [
            TagItem { ti_Tag: SA_DisplayID, ti_Data: ntsc_lores_lace },
            TagItem { ti_Tag: SA_Width, ti_Data: 320 },
            TagItem { ti_Tag: SA_Height, ti_Data: 400 },
            TagItem { ti_Tag: SA_Depth, ti_Data: (u32)depth },
            TagItem { ti_Tag: SA_Title, ti_Data: (u32)title.ptr },
            TagItem { ti_Tag: SA_Type, ti_Data: CUSTOMSCREEN },
            TagItem { ti_Tag: TAG_DONE, ti_Data: 0 }
        ]

        return ScreenHandle::open(&tags)
    }

    /// Open a hires interlaced screen (640x512, PAL) or (640x400, NTSC)
    ///
    /// # Arguments
    /// * `title` - Screen title
    /// * `depth` - Number of bitplanes (1-4 for OCS/ECS hires, 1-8 for AGA)
    ///
    /// # Example
    /// ```novus
    /// let screen = ScreenHandle::hires_lace("HiRes Interlaced", 2)?  // 4 colors
    /// ```
    @suppress("W0002", "Casting depth to u32 for tag")
    pub fn hires_lace(title: Str, depth: i16) -> Result<ScreenHandle, IntuitionError> {
        // TODO: Detect PAL/NTSC at runtime
        // For now, hardcoded to NTSC (400 lines interlaced)
        // NTSC hires lace = NTSC_MONITOR_ID | HIRESLACE_KEY
        let ntsc_hires_lace: u32 = NTSC_MONITOR_ID | HIRESLACE_KEY
        let tags = [
            TagItem { ti_Tag: SA_DisplayID, ti_Data: ntsc_hires_lace },
            TagItem { ti_Tag: SA_Width, ti_Data: 640 },
            TagItem { ti_Tag: SA_Height, ti_Data: 400 },
            TagItem { ti_Tag: SA_Depth, ti_Data: (u32)depth },
            TagItem { ti_Tag: SA_Title, ti_Data: (u32)title.ptr },
            TagItem { ti_Tag: SA_Type, ti_Data: CUSTOMSCREEN },
            TagItem { ti_Tag: TAG_DONE, ti_Data: 0 }
        ]

        return ScreenHandle::open(&tags)
    }
}

impl Drop for ScreenHandle {
    fn drop(&var self) {
        if let scr = self.screen {
            CloseScreen(scr)
            self.screen = (*Screen)0
        }
    }
}

// ============================================================================
// ScreenBuilder - Fluent API for screen creation
// ============================================================================

/// Builder for creating screens with a fluent API
///
/// This provides a more ergonomic way to create screens than raw TagItem arrays.
///
/// # Example
/// ```novus
/// let screen = ScreenBuilder::new()
///     .title("My Game")
///     .size(320, 256)
///     .depth(5)
///     .behind(true)
///     .build()?
/// ```
pub struct ScreenBuilder {
    width: i16,
    height: i16,
    depth: i16,
    title_ptr: *u8,
    behind: bool,
    quiet: bool,
    show_title: bool,
    autoscroll: bool,
    display_id: u32,
    overscan: u32,
}

impl ScreenBuilder {
    /// Create a new screen builder with default settings
    ///
    /// Defaults:
    /// - Size: 320x256 (PAL lores)
    /// - Depth: 3 (8 colors)
    /// - Title: none
    /// - Behind: false (opens in front)
    /// - ShowTitle: true
    pub fn new() -> ScreenBuilder {
        return ScreenBuilder {
            width: 320,
            height: 256,
            depth: 3,
            title_ptr: (*u8)0,
            behind: false,
            quiet: false,
            show_title: true,
            autoscroll: false,
            display_id: 0,
            overscan: OSCAN_TEXT,
        }
    }

    /// Set the screen title
    ///
    /// NOTE: The title string must remain valid for the lifetime of the screen.
    /// Use string literals or long-lived String allocations.
    pub fn title(self, t: Str) -> ScreenBuilder {
        self.title_ptr = t.ptr
        return self
    }

    /// Set screen dimensions
    pub fn size(self, w: i16, h: i16) -> ScreenBuilder {
        self.width = w
        self.height = h
        return self
    }

    /// Set screen width
    pub fn width(self, w: i16) -> ScreenBuilder {
        self.width = w
        return self
    }

    /// Set screen height
    pub fn height(self, h: i16) -> ScreenBuilder {
        self.height = h
        return self
    }

    /// Set number of bitplanes (color depth)
    ///
    /// Common values:
    /// - 1: 2 colors
    /// - 2: 4 colors
    /// - 3: 8 colors
    /// - 4: 16 colors
    /// - 5: 32 colors (OCS/ECS max for lores)
    /// - 6: 64 colors (AGA only, or EHB mode)
    /// - 8: 256 colors (AGA only)
    pub fn depth(self, d: i16) -> ScreenBuilder {
        self.depth = d
        return self
    }

    /// Open screen behind other screens
    pub fn behind(self, b: bool) -> ScreenBuilder {
        self.behind = b
        return self
    }

    /// Quiet mode - Intuition won't render into the screen
    pub fn quiet(self, q: bool) -> ScreenBuilder {
        self.quiet = q
        return self
    }

    /// Show or hide the title bar
    pub fn show_title(self, show: bool) -> ScreenBuilder {
        self.show_title = show
        return self
    }

    /// Enable autoscroll for screens larger than display
    pub fn autoscroll(self, enabled: bool) -> ScreenBuilder {
        self.autoscroll = enabled
        return self
    }

    /// Set display mode ID (for specific monitor modes)
    pub fn display_id(self, id: u32) -> ScreenBuilder {
        self.display_id = id
        return self
    }

    /// Set overscan type
    ///
    /// Use OSCAN_TEXT, OSCAN_STANDARD, OSCAN_MAX, or OSCAN_VIDEO
    pub fn overscan(self, oscan: u32) -> ScreenBuilder {
        self.overscan = oscan
        return self
    }

    /// Build and open the screen
    ///
    /// Returns Err if screen fails to open.
    @suppress("W0002", "Casting values to u32 for tags")
    pub fn build(self) -> Result<ScreenHandle, IntuitionError> {
        // TODO: Detect PAL/NTSC at runtime
        // For now, default to NTSC if no display_id set
        let display = if self.display_id != 0 { self.display_id } else { NTSC_MONITOR_ID }

        // Convert booleans to Amiga TRUE/FALSE
        let show_title_val: u32 = if self.show_title { 1 } else { 0 }
        let quiet_val: u32 = if self.quiet { 1 } else { 0 }

        let tags = [
            TagItem { ti_Tag: SA_DisplayID, ti_Data: display },
            TagItem { ti_Tag: SA_Width, ti_Data: (u32)self.width },
            TagItem { ti_Tag: SA_Height, ti_Data: 200 },
            TagItem { ti_Tag: SA_Depth, ti_Data: (u32)self.depth },
            TagItem { ti_Tag: SA_Title, ti_Data: (u32)self.title_ptr },
            TagItem { ti_Tag: SA_Type, ti_Data: CUSTOMSCREEN },
            TagItem { ti_Tag: SA_ShowTitle, ti_Data: show_title_val },
            TagItem { ti_Tag: SA_Quiet, ti_Data: quiet_val },
            TagItem { ti_Tag: TAG_DONE, ti_Data: 0 }
        ]

        return ScreenHandle::open(&tags)
    }
}
