// Safe GadTools window and control builder for AmigaOS 2.0+ (V36 API).

from std::core import Option, Result
from std::error::errors import IntuitionError
from std::ffi::amiga_structs import Gadget, IntuiMessage, Menu, NewGadget, Screen, TagItem, Window
from std::ffi::amiga_consts import *
from std::ffi::exec import AllocVec, CopyMem, FreeVec, WaitPort
from std::ffi::gadtools import CreateContext, CreateGadgetA, CreateMenusA, FreeGadgets, FreeMenus, FreeVisualInfo, GetVisualInfoA, GT_GetIMsg, GT_RefreshWindow, GT_ReplyIMsg, LayoutMenusA, NewMenu
from std::ffi::intuition import ClearMenuStrip, CloseWindow, LockPubScreen, OpenWindowTagList, SetMenuStrip, UnlockPubScreen
from std::strings::core import Str
from std::ui::menu import GadToolsMenuBuilder, GadToolsMenuStrip

/// Events enabled by GadToolsWindow's fixed IDCMP mask.
pub enum GadToolsEvent {
    Close,
    MenuPick(u16, u16),
    MenuSubPick(u16, u16, u16),
    GadgetUp(u32),
    GadgetDown(u32),
    Unknown(u32),
}

pub struct GadgetBounds {
    x: i16
    y: i16
    width: i16
    height: i16
}

/// Compile-time UI descriptions use static string data and fixed-size arrays.
/// Use GadToolsBuilder instead when controls or menus are created at runtime.
pub struct StaticGadget {
    kind: u32
    id: u16
    label: *u8
    x: i16
    y: i16
    width: i16
    height: i16
    placement: u32
    tags: [TagItem; 3]
}

pub struct StaticMenuEntry {
    raw: NewMenu
}

pub struct StaticGadToolsUi {
    title: *u8
    bounds: GadgetBounds
    gadgets: *StaticGadget
    gadget_count: u32
    menus: *StaticMenuEntry
}

impl GadgetBounds {
    pub const fn new(x: i16, y: i16, width: i16, height: i16) -> GadgetBounds {
        return GadgetBounds { x: x, y: y, width: width, height: height }
    }
}

impl StaticGadget {
    pub const fn checkbox(id: u16, label: *u8, x: i16, y: i16, width: i16, height: i16, checked: bool) -> StaticGadget {
        return StaticGadget {
            kind: CHECKBOX_KIND, id: id, label: label,
            x: x, y: y, width: width, height: height,
            placement: PLACETEXT_LEFT,
            tags: [
                TagItem { ti_Tag: GTCB_Checked, ti_Data: (u32)checked },
                TagItem { ti_Tag: TAG_DONE, ti_Data: 0 },
                TagItem { ti_Tag: TAG_DONE, ti_Data: 0 }
            ]
        }
    }

    @suppress("W0002", "GTIN_Number stores a signed 32-bit value in tag data")
    pub const fn integer(id: u16, label: *u8, x: i16, y: i16, width: i16, height: i16, value: i32, max_chars: u16) -> StaticGadget {
        return StaticGadget {
            kind: INTEGER_KIND, id: id, label: label,
            x: x, y: y, width: width, height: height,
            placement: PLACETEXT_LEFT,
            tags: [
                TagItem { ti_Tag: GTIN_Number, ti_Data: (u32)value },
                TagItem { ti_Tag: GTIN_MaxChars, ti_Data: (u32)max_chars },
                TagItem { ti_Tag: TAG_DONE, ti_Data: 0 }
            ]
        }
    }

    pub const fn button(id: u16, label: *u8, x: i16, y: i16, width: i16, height: i16) -> StaticGadget {
        return StaticGadget {
            kind: BUTTON_KIND, id: id, label: label,
            x: x, y: y, width: width, height: height,
            placement: PLACETEXT_IN,
            tags: [
                TagItem { ti_Tag: TAG_DONE, ti_Data: 0 },
                TagItem { ti_Tag: TAG_DONE, ti_Data: 0 },
                TagItem { ti_Tag: TAG_DONE, ti_Data: 0 }
            ]
        }
    }
}

impl StaticMenuEntry {
    pub const fn title(label: *u8) -> StaticMenuEntry {
        return StaticMenuEntry { raw: NewMenu {
            nm_Type: (u8)NM_TITLE, nm_Label: label, nm_CommKey: null,
            nm_Flags: 0, nm_MutualExclude: 0, nm_UserData: null
        } }
    }

    pub const fn item(label: *u8, key: *u8) -> StaticMenuEntry {
        return StaticMenuEntry { raw: NewMenu {
            nm_Type: (u8)NM_ITEM, nm_Label: label, nm_CommKey: key,
            nm_Flags: 0, nm_MutualExclude: 0, nm_UserData: null
        } }
    }

    pub const fn sub_item(label: *u8, key: *u8) -> StaticMenuEntry {
        return StaticMenuEntry { raw: NewMenu {
            nm_Type: (u8)NM_SUB, nm_Label: label, nm_CommKey: key,
            nm_Flags: 0, nm_MutualExclude: 0, nm_UserData: null
        } }
    }

    pub const fn separator() -> StaticMenuEntry {
        return StaticMenuEntry { raw: NewMenu {
            nm_Type: (u8)NM_ITEM, nm_Label: (*u8)(-1), nm_CommKey: null,
            nm_Flags: 0, nm_MutualExclude: 0, nm_UserData: null
        } }
    }

    pub const fn end() -> StaticMenuEntry {
        return StaticMenuEntry { raw: NewMenu {
            nm_Type: (u8)NM_END, nm_Label: null, nm_CommKey: null,
            nm_Flags: 0, nm_MutualExclude: 0, nm_UserData: null
        } }
    }
}

pub struct GadToolsBuilder {
    screen: *Screen
    visual_info: *u8
    gadgets: *Gadget
    previous: *Gadget
    labels: **u8
    label_count: u32
    label_capacity: u32
}

impl GadToolsBuilder {
    /// Lock Workbench and create a GadTools context using only V36 APIs.
    pub fn workbench() -> Result<GadToolsBuilder, IntuitionError> {
        unsafe {
            let screen = LockPubScreen(null)
            if !screen {
                return Result::Err(IntuitionError::InvalidScreen)
            }

            let visual_info = GetVisualInfoA(screen, null)
            if !visual_info {
                UnlockPubScreen(null, screen)
                return Result::Err(IntuitionError::GadgetCreateFailed)
            }

            var gadgets: *Gadget = null
            let previous = CreateContext(&var gadgets)
            if !previous {
                FreeVisualInfo(visual_info)
                UnlockPubScreen(null, screen)
                return Result::Err(IntuitionError::GadgetCreateFailed)
            }

            let label_capacity: u32 = 16
            let labels = AllocVec(label_capacity * 4u32, MEMF_PUBLIC | MEMF_CLEAR)
            if !labels {
                FreeGadgets(gadgets)
                FreeVisualInfo(visual_info)
                UnlockPubScreen(null, screen)
                return Result::Err(IntuitionError::GadgetCreateFailed)
            }

            return Result::Ok(GadToolsBuilder {
                screen: screen,
                visual_info: visual_info,
                gadgets: gadgets,
                previous: previous,
                labels: (**u8)labels,
                label_count: 0,
                label_capacity: label_capacity,
            })
        }
    }

    pub fn menu_builder(&self) -> GadToolsMenuBuilder {
        return GadToolsMenuBuilder::new(self.screen)
    }

    pub fn add_checkbox(&var self, id: u16, label: Str, bounds: GadgetBounds, checked: bool) -> Result<(), IntuitionError> {
        let tags = [
            TagItem { ti_Tag: GTCB_Checked, ti_Data: if checked { 1 } else { 0 } },
            TagItem { ti_Tag: TAG_DONE, ti_Data: 0 }
        ]
        return self.add_gadget(CHECKBOX_KIND, id, label, bounds, PLACETEXT_LEFT, &tags[0])
    }

    @suppress("W0002", "GTIN_Number stores a signed 32-bit value in tag data")
    pub fn add_integer(&var self, id: u16, label: Str, bounds: GadgetBounds, value: i32, max_chars: u16) -> Result<(), IntuitionError> {
        let tags = [
            TagItem { ti_Tag: GTIN_Number, ti_Data: (u32)value },
            TagItem { ti_Tag: GTIN_MaxChars, ti_Data: (u32)max_chars },
            TagItem { ti_Tag: TAG_DONE, ti_Data: 0 }
        ]
        return self.add_gadget(INTEGER_KIND, id, label, bounds, PLACETEXT_LEFT, &tags[0])
    }

    pub fn add_button(&var self, id: u16, label: Str, bounds: GadgetBounds) -> Result<(), IntuitionError> {
        return self.add_gadget(BUTTON_KIND, id, label, bounds, PLACETEXT_IN, null)
    }

    fn add_gadget(&var self, kind: u32, id: u16, label: Str, bounds: GadgetBounds, placement: u32, tags: *TagItem) -> Result<(), IntuitionError> {
        unsafe {
            let label_ptr = self.alloc_label(label)
            if !label_ptr {
                return Result::Err(IntuitionError::GadgetCreateFailed)
            }

            var definition = NewGadget {
                ng_LeftEdge: bounds.x,
                ng_TopEdge: bounds.y,
                ng_Width: bounds.width,
                ng_Height: bounds.height,
                ng_GadgetText: label_ptr,
                ng_TextAttr: (*self.screen).Font,
                ng_GadgetID: id,
                ng_Flags: placement,
                ng_VisualInfo: self.visual_info,
                ng_UserData: null,
            }

            let gadget = CreateGadgetA(kind, self.previous, &var definition, tags)
            if !gadget {
                return Result::Err(IntuitionError::GadgetCreateFailed)
            }
            self.previous = gadget
            return Result::Ok(())
        }
    }

    @suppress("W0002", "Amiga window tags carry signed coordinates as u32")
    pub fn build(&var self, title: Str, bounds: GadgetBounds, consuming menu_strip: GadToolsMenuStrip) -> Result<GadToolsWindow, IntuitionError> {
        let title_ptr = self.alloc_label(title)
        if !title_ptr {
            return Result::Err(IntuitionError::WindowOpenFailed)
        }
        return self.build_static(title_ptr, bounds, menu_strip)
    }

    @suppress("W0002", "Amiga window tags carry signed coordinates as u32")
    fn build_static(&var self, title: *u8, bounds: GadgetBounds, consuming menu_strip: GadToolsMenuStrip) -> Result<GadToolsWindow, IntuitionError> {
        unsafe {
            let tags = [
                TagItem { ti_Tag: WA_Title, ti_Data: (u32)title },
                TagItem { ti_Tag: WA_CustomScreen, ti_Data: (u32)self.screen },
                TagItem { ti_Tag: WA_Left, ti_Data: (u32)bounds.x },
                TagItem { ti_Tag: WA_Top, ti_Data: (u32)bounds.y },
                TagItem { ti_Tag: WA_Width, ti_Data: (u32)bounds.width },
                TagItem { ti_Tag: WA_Height, ti_Data: (u32)bounds.height },
                TagItem { ti_Tag: WA_Gadgets, ti_Data: (u32)self.gadgets },
                TagItem { ti_Tag: WA_IDCMP, ti_Data: IDCMP_CLOSEWINDOW | IDCMP_MENUPICK | CHECKBOXIDCMP | INTEGERIDCMP | BUTTONIDCMP },
                TagItem { ti_Tag: WA_Flags, ti_Data: WFLG_CLOSEGADGET | WFLG_DRAGBAR | WFLG_DEPTHGADGET | WFLG_ACTIVATE },
                TagItem { ti_Tag: TAG_DONE, ti_Data: 0 }
            ]

            let window = OpenWindowTagList(null, &tags[0])
            if !window {
                return Result::Err(IntuitionError::WindowOpenFailed)
            }
            if SetMenuStrip(window, menu_strip.raw_menu()) == 0 {
                CloseWindow(window)
                return Result::Err(IntuitionError::MenuCreateFailed)
            }
            GT_RefreshWindow(window, null)

            let result = GadToolsWindow {
                window: window,
                screen: self.screen,
                visual_info: self.visual_info,
                gadgets: self.gadgets,
                labels: self.labels,
                label_count: self.label_count,
                menu_strip: Option::Some(menu_strip),
            }

            self.screen = null
            self.visual_info = null
            self.gadgets = null
            self.previous = null
            self.labels = null
            self.label_count = 0
            self.label_capacity = 0
            return Result::Ok(result)
        }
    }

    fn alloc_label(&var self, label: Str) -> *u8 {
        unsafe {
            if self.label_count >= self.label_capacity {
                let new_capacity = self.label_capacity * 2u32
                let new_labels = AllocVec(new_capacity * 4u32, MEMF_PUBLIC | MEMF_CLEAR)
                if !new_labels {
                    return null
                }
                CopyMem((*u8)self.labels, new_labels, self.label_count * 4u32)
                FreeVec((*u8)self.labels)
                self.labels = (**u8)new_labels
                self.label_capacity = new_capacity
            }

            let copy = AllocVec(label.len + 1u32, MEMF_PUBLIC | MEMF_CLEAR)
            if !copy {
                return null
            }
            CopyMem(label.ptr, copy, label.len)
            let result = (*u8)copy
            self.labels[self.label_count] = result
            self.label_count++
            return result
        }
    }
}

impl StaticGadToolsUi {
    /// Open a compile-time UI without copying labels or allocating builder arrays.
    @suppress("W0002", "Amiga window tags carry signed coordinates as u32")
    pub fn open(&self) -> Result<StaticGadToolsWindow, IntuitionError> {
        var result = StaticGadToolsWindow {
            window: null,
            screen: null,
            visual_info: null,
            gadgets: null,
            menu: null,
        }

        unsafe {
            result.screen = LockPubScreen(null)
            if !result.screen {
                return Result::Err(IntuitionError::InvalidScreen)
            }

            result.visual_info = GetVisualInfoA(result.screen, null)
            if !result.visual_info {
                return Result::Err(IntuitionError::GadgetCreateFailed)
            }
        }

        var previous = unsafe { CreateContext(&var result.gadgets) }
        if !previous {
            return Result::Err(IntuitionError::GadgetCreateFailed)
        }

        var gadget_index: u32 = 0
        forever {
            if gadget_index >= self.gadget_count { break }

            var definition = NewGadget {
                ng_LeftEdge: self.gadgets[gadget_index].x,
                ng_TopEdge: self.gadgets[gadget_index].y,
                ng_Width: self.gadgets[gadget_index].width,
                ng_Height: self.gadgets[gadget_index].height,
                ng_GadgetText: self.gadgets[gadget_index].label,
                ng_TextAttr: unsafe { (*result.screen).Font },
                ng_GadgetID: self.gadgets[gadget_index].id,
                ng_Flags: self.gadgets[gadget_index].placement,
                ng_VisualInfo: result.visual_info,
                ng_UserData: null,
            }

            unsafe {
                let gadget = CreateGadgetA(
                    self.gadgets[gadget_index].kind,
                    previous,
                    &var definition,
                    &self.gadgets[gadget_index].tags[0]
                )
                if !gadget {
                    return Result::Err(IntuitionError::GadgetCreateFailed)
                }
                previous = gadget
            }
            gadget_index++
        }

        unsafe {
            result.menu = CreateMenusA((*NewMenu)self.menus, null)
            if !result.menu {
                return Result::Err(IntuitionError::MenuCreateFailed)
            }
            if LayoutMenusA(result.menu, result.visual_info, null) == 0 {
                return Result::Err(IntuitionError::MenuCreateFailed)
            }

            let window_tags = [
                TagItem { ti_Tag: WA_Title, ti_Data: (u32)self.title },
                TagItem { ti_Tag: WA_CustomScreen, ti_Data: (u32)result.screen },
                TagItem { ti_Tag: WA_Left, ti_Data: (u32)self.bounds.x },
                TagItem { ti_Tag: WA_Top, ti_Data: (u32)self.bounds.y },
                TagItem { ti_Tag: WA_Width, ti_Data: (u32)self.bounds.width },
                TagItem { ti_Tag: WA_Height, ti_Data: (u32)self.bounds.height },
                TagItem { ti_Tag: WA_Gadgets, ti_Data: (u32)result.gadgets },
                TagItem { ti_Tag: WA_IDCMP, ti_Data: IDCMP_CLOSEWINDOW | IDCMP_MENUPICK | CHECKBOXIDCMP | INTEGERIDCMP | BUTTONIDCMP },
                TagItem { ti_Tag: WA_Flags, ti_Data: WFLG_CLOSEGADGET | WFLG_DRAGBAR | WFLG_DEPTHGADGET | WFLG_ACTIVATE },
                TagItem { ti_Tag: TAG_DONE, ti_Data: 0 }
            ]

            result.window = OpenWindowTagList(null, &window_tags[0])
            if !result.window {
                return Result::Err(IntuitionError::WindowOpenFailed)
            }
            if SetMenuStrip(result.window, result.menu) == 0 {
                return Result::Err(IntuitionError::MenuCreateFailed)
            }
            GT_RefreshWindow(result.window, null)
            return Result::Ok(result)
        }
    }
}

/// Zero-allocation owner returned by StaticGadToolsUi.
pub struct StaticGadToolsWindow {
    window: *Window
    screen: *Screen
    visual_info: *u8
    gadgets: *Gadget
    menu: *Menu
}

impl StaticGadToolsWindow {
    pub fn wait_event(&self) -> GadToolsEvent {
        unsafe {
            let port = (*self.window).UserPort
            forever {
                WaitPort(port)
                let message = GT_GetIMsg(port)
                if message {
                    let event = decode_event(message)
                    GT_ReplyIMsg(message)
                    return event
                }
            }
        }
    }
}

impl Drop for StaticGadToolsWindow {
    fn drop(&var self) {
        unsafe {
            let window = self.window
            let menu = self.menu
            let gadgets = self.gadgets
            let visual_info = self.visual_info
            let screen = self.screen
            if window {
                if menu { ClearMenuStrip(window) }
                let port = (*window).UserPort
                forever {
                    let message = GT_GetIMsg(port)
                    if !message { break }
                    GT_ReplyIMsg(message)
                }
                CloseWindow(window)
            }
            if menu { FreeMenus(menu) }
            if gadgets { FreeGadgets(gadgets) }
            if visual_info { FreeVisualInfo(visual_info) }
            if screen { UnlockPubScreen(null, screen) }
        }
    }
}

impl Drop for GadToolsBuilder {
    fn drop(&var self) {
        unsafe {
            if self.gadgets { FreeGadgets(self.gadgets) }
            if self.visual_info { FreeVisualInfo(self.visual_info) }
            if self.labels {
                var i: u32 = 0
                forever {
                    if i >= self.label_count { break }
                    if self.labels[i] { FreeVec(self.labels[i]) }
                    i++
                }
                FreeVec((*u8)self.labels)
                self.labels = null
            }
            if self.screen { UnlockPubScreen(null, self.screen) }
        }
    }
}

pub struct GadToolsWindow {
    window: *Window
    screen: *Screen
    visual_info: *u8
    gadgets: *Gadget
    labels: **u8
    label_count: u32
    menu_strip: Option<GadToolsMenuStrip>
}

impl GadToolsWindow {
    pub fn wait_event(&self) -> GadToolsEvent {
        unsafe {
            let port = (*self.window).UserPort
            forever {
                WaitPort(port)
                let message = GT_GetIMsg(port)
                if message {
                    let event = decode_event(message)
                    GT_ReplyIMsg(message)
                    return event
                }
            }
        }
    }
}

impl Drop for GadToolsWindow {
    fn drop(&var self) {
        unsafe {
            if self.window {
                ClearMenuStrip(self.window)
                let port = (*self.window).UserPort
                forever {
                    let message = GT_GetIMsg(port)
                    if !message { break }
                    GT_ReplyIMsg(message)
                }
                CloseWindow(self.window)
                self.window = null
            }
            if self.gadgets { FreeGadgets(self.gadgets) }
            if self.visual_info { FreeVisualInfo(self.visual_info) }
            if self.labels {
                var i: u32 = 0
                forever {
                    if i >= self.label_count { break }
                    if self.labels[i] { FreeVec(self.labels[i]) }
                    i++
                }
                FreeVec((*u8)self.labels)
                self.labels = null
            }
            if self.screen {
                UnlockPubScreen(null, self.screen)
                self.screen = null
            }
        }
    }
}

fn decode_event(message: *IntuiMessage) -> GadToolsEvent {
    unsafe {
        return match (*message).Class {
            IDCMP_CLOSEWINDOW => GadToolsEvent::Close,
            IDCMP_MENUPICK => {
                let code = (*message).Code
                let menu = code & $001F
                let item = (code >> 5) & $003F
                let sub = (code >> 11) & $001F
                if sub == $001F {
                    GadToolsEvent::MenuPick(menu, item)
                } else {
                    GadToolsEvent::MenuSubPick(menu, item, sub)
                }
            },
            IDCMP_GADGETUP => {
                let gadget = (*Gadget)(*message).IAddress
                GadToolsEvent::GadgetUp((u32)(*gadget).GadgetID)
            },
            IDCMP_GADGETDOWN => {
                let gadget = (*Gadget)(*message).IAddress
                GadToolsEvent::GadgetDown((u32)(*gadget).GadgetID)
            },
            _ => GadToolsEvent::Unknown((*message).Class),
        }
    }
}
