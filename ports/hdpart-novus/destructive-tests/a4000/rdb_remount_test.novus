// Explicit cold-start proof for the disposable lifecycle HDF.

from std::core import Option, Result
from amiga::raw::consts import ACCESS_READ
from amiga::storage import BlockDevice
from amiga::sys::dos import DirLockHandle
from amiga::timer import Duration, delay
from std::test::test import expect_eq
from format import prepare_node
from rdb_io import load_rdb

fn wait_for_root() -> Option<DirLockHandle> {
    var attempt: u32 = 0
    while attempt < 20 {
        match DirLockHandle::lock("NVT0:", ACCESS_READ) {
            Result::Ok(value) => return Option::Some(value),
            Result::Err(_) => {},
        }
        match delay(Duration::millis(100)) {
            Result::Ok(_) => {},
            Result::Err(_) => return Option::None,
        }
        attempt++
    }
    return Option::None
}

fn probe() -> i32 {
    var disk = match BlockDevice::open("uaehf.device", 1) {
        Result::Ok(value) => value,
        Result::Err(_) => return 50,
    }
    if disk.geometry().total_blocks() != 131072 || disk.geometry().block_bytes() != 512 {
        return 51
    }
    let model = match load_rdb(&var disk) {
        Result::Ok(value) => value,
        Result::Err(_) => return 52,
    }
    let prepared = match prepare_node("NVT0", "uaehf.device", 1, &model, 0) {
        Result::Ok(value) => value,
        Result::Err(_) => return 53,
    }
    let _registered = match prepared.register(0, true) {
        Result::Ok(value) => value,
        Result::Err(_) => return 54,
    }
    return match wait_for_root() {
        Option::Some(_) => 0,
        Option::None => 55,
    }
}

#[stack_size(32768)]
@test("cold-start RDB mounts from the disposable HDF")
pub fn test_disposable_rdb_remount() {
    expect_eq(probe(), 0, "persisted partition mounts after restart")
}
