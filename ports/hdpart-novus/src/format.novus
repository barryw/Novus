// Safe formatting plan derived from HDPart's RDB model.

from std::core import Error, From, Option, Result
from std::string import Str
from amiga::dos import EmbeddedFileSystem, FileSystem, FileSystemError, MountSpec, PartitionGeometry, Volume, open_volume
from amiga::sys::dos import HandlerImage
from rdb import RdbModel
from safety import DeviceIdentity, mounted_device_name_exists, mounted_partition_name

pub enum FormatError {
    MissingPartition,
    InvalidEnvironment,
    HandlerUnavailable,
    NameConflict,
    MountFailed,
    FormatFailed,
}

impl FormatError {
    pub fn message(&self) -> *u8 {
        return match self {
            FormatError::MissingPartition => "Partition index is out of range",
            FormatError::InvalidEnvironment => "Partition has an invalid DOS environment",
            FormatError::HandlerUnavailable => "No compatible filesystem handler is available",
            FormatError::NameConflict => "Another mounted device already uses this partition name",
            FormatError::MountFailed => "The filesystem handler did not mount the partition",
            FormatError::FormatFailed => "The filesystem rejected the format request",
        }
    }
}

impl Error for FormatError {
    fn message(&self) -> *u8 { return FormatError::message(self) }
}

impl From<FileSystemError> for FormatError {
    fn convert(consuming error: FileSystemError) -> FormatError {
        return match error {
            FileSystemError::HandlerUnavailable => FormatError::HandlerUnavailable,
            FileSystemError::InvalidEnvironment => FormatError::InvalidEnvironment,
            FileSystemError::MountFailed => FormatError::MountFailed,
            FileSystemError::FormatFailed => FormatError::FormatFailed,
        }
    }
}

/// Describe the partition semantically; Tier 1 creates the NDK environment.
pub fn geometry_for(model: &RdbModel, index: usize) -> Result<PartitionGeometry, FormatError> {
    let partition = model.partition(index).ok_or(FormatError::MissingPartition)?
    let geometry = PartitionGeometry::new(
        model.block_bytes(),
        model.heads(),
        model.sectors(),
        partition.low_cylinder(),
        partition.high_cylinder(),
        partition.dos_type()
    )?.with_buffers(partition.buffers())?
        .with_transfer(partition.max_transfer(), partition.mask())?
        .with_boot_priority(partition.boot_priority())
    return Result::Ok(geometry)
}

fn format_mounted(name: Str, volume_name: Str, dos_type: u32) -> Result<(), FormatError> {
    let mounted = open_volume(name)?
    return Result::Ok(mounted.format(volume_name, dos_type)?)
}

/// Resolve the best handler source without exposing DOS nodes or segment ownership.
pub fn file_system_for(model: &RdbModel, index: usize) -> Result<FileSystem, FormatError> {
    let partition = model.partition(index).ok_or(FormatError::MissingPartition)?
    let embedded = match model.embedded_file_system(partition.dos_type()) {
        Option::Some(value) => Option::Some(EmbeddedFileSystem::from_system(HandlerImage::new(
            value.image(), value.global_vec(), value.stack_size(), value.priority()
        ))),
        Option::None => Option::None,
    }
    return Result::Ok(FileSystem::resolve_embedded(partition.dos_type(), embedded)?)
}

/// Format one exact partition, reusing its live mount when present.
pub fn format_partition(
    driver: Str,
    unit: u32,
    model: &RdbModel,
    index: usize,
    volume_name: Str
) -> Result<(), FormatError> {
    let partition = model.partition(index).ok_or(FormatError::MissingPartition)?
    let identity = DeviceIdentity { driver: driver, unit: unit }
    let mounted_partition = mounted_partition_name(&identity, partition.low_cylinder(), partition.high_cylinder())
        .or_error(FormatError::MountFailed)?
    match mounted_partition {
        Option::Some(name) => return format_mounted(name.as_str(), volume_name, partition.dos_type()),
        Option::None => {},
    }
    if mounted_device_name_exists(partition.name()) {
        return Result::Err(FormatError::NameConflict)
    }

    let geometry = geometry_for(model, index)?
    let file_system = file_system_for(model, index)?
    let mounted = file_system.mount(MountSpec::new(partition.name(), driver, unit, geometry))?
    return Result::Ok(mounted.format(volume_name, partition.dos_type())?)
}
