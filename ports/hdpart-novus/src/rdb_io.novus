// RDB loading and writing through the owning BlockDevice boundary.

from std::core import Error, From, Result
from std::memory import Buffer, ByteError, ByteReader, MemoryError
from amiga::storage import BlockDevice, BlockDeviceError
from rdb import BLOCK_BYTES, RdbError, RdbModel

const RDB_SCAN_BLOCKS: usize = 16
const RDB_END_BLOCK: u32 = $FFFFFFFF

pub enum RdbDeviceError {
    Device(BlockDeviceError),
    Model(RdbError),
    UnsupportedBlockSize,
    AllocationFailed,
    InvalidReservedArea,
}

impl From<BlockDeviceError> for RdbDeviceError {
    fn convert(consuming error: BlockDeviceError) -> RdbDeviceError {
        return RdbDeviceError::Device(error)
    }
}

impl From<RdbError> for RdbDeviceError {
    fn convert(consuming error: RdbError) -> RdbDeviceError {
        return RdbDeviceError::Model(error)
    }
}

impl From<ByteError> for RdbDeviceError {
    fn convert(consuming _error: ByteError) -> RdbDeviceError {
        return RdbDeviceError::InvalidReservedArea
    }
}

impl From<MemoryError> for RdbDeviceError {
    fn convert(consuming _error: MemoryError) -> RdbDeviceError {
        return RdbDeviceError::AllocationFailed
    }
}

impl RdbDeviceError {
    pub fn message(&self) -> *u8 {
        return match self {
            RdbDeviceError::Device(_) => "Could not read the block device",
            RdbDeviceError::Model(_) => "The device has an invalid RDB",
            RdbDeviceError::UnsupportedBlockSize => "RDB loading requires 512-byte device blocks",
            RdbDeviceError::AllocationFailed => "Could not allocate the RDB read buffer",
            RdbDeviceError::InvalidReservedArea => "The RDB reserved area is outside the device",
        }
    }
}

impl Error for RdbDeviceError {
    fn message(&self) -> *u8 { return RdbDeviceError::message(self) }
}

/// Locate and load the complete reserved RDB area without exposing an IORequest
/// or raw buffer pointer to application code.
pub fn load_rdb(device: &var BlockDevice) -> Result<RdbModel, RdbDeviceError> {
    return Result::Err(RdbDeviceError::UnsupportedBlockSize) unless device.geometry().block_bytes() == BLOCK_BYTES

    var header: [u8] = [0; 512]
    var header_block = RDB_SCAN_BLOCKS
    var high_reserved_block: u32 = 0
    var scan: usize = 0
    while scan < RDB_SCAN_BLOCKS && scan < (usize)device.geometry().total_blocks() {
        device.read_blocks(scan, &var header)?
        match RdbModel::from_header(&header) {
            Result::Ok(model) => {
                let reader = ByteReader::new(&header)
                high_reserved_block = reader.read_be_u32(132)?
                return Result::Err(RdbDeviceError::UnsupportedBlockSize) unless model.block_bytes() == BLOCK_BYTES
                header_block = scan
                break
            },
            Result::Err(_) => {},
        }
        scan++
    }
    return Result::Err(RdbDeviceError::Model(RdbError::MissingRigidDiskBlock)) if header_block == RDB_SCAN_BLOCKS
    return Result::Err(RdbDeviceError::InvalidReservedArea) unless (usize)high_reserved_block >= header_block && high_reserved_block < device.geometry().total_blocks() && high_reserved_block < $FFFFFFFF / BLOCK_BYTES

    let byte_count = (usize)(high_reserved_block + 1) * BLOCK_BYTES
    var storage = Buffer::new(byte_count)?
    {
        let bytes = storage.as_mut_bytes()
        device.read_blocks(0, bytes)?
    }
    return Result::Ok(RdbModel::from_image(storage.as_bytes())?)
}

/// Validate and write the complete RDSK/PART/FSHD/LSEG chain. Capacity is
/// checked before the first device write so an oversized model writes nothing.
pub fn write_rdb(device: &var BlockDevice, model: &RdbModel) -> Result<(), RdbDeviceError> {
    return Result::Err(RdbDeviceError::UnsupportedBlockSize) unless device.geometry().block_bytes() == BLOCK_BYTES && model.block_bytes() == BLOCK_BYTES
    model.validate()?

    return Result::Err(RdbDeviceError::InvalidReservedArea) unless model.serialized_block_count() - 1 <= model.rdb_blocks_high()
    return Result::Err(RdbDeviceError::InvalidReservedArea) unless model.rdb_blocks_high() < device.geometry().total_blocks() && model.cylinder_blocks() > 0
    return Result::Err(RdbDeviceError::InvalidReservedArea) unless model.cylinders() <= device.geometry().total_blocks() / model.cylinder_blocks()

    var block: [u8] = [0; 512]
    model.write_header(&var block)?
    device.write_blocks(0, &block)?

    for partition_index in 0..model.partition_count() {
        let partition = model.partition(partition_index).ok_or(RdbDeviceError::InvalidReservedArea)?
        let next = if partition_index + 1 < model.partition_count() {
            (u32)(partition_index + 2)
        } else {
            RDB_END_BLOCK
        }
        partition.write_block(model, next, &var block)?
        device.write_blocks(1 + partition_index, &block)?
    }

    var current: usize = 1 + model.partition_count()
    for file_system_index in 0..model.file_system_count() {
        let file_system = model.file_system(file_system_index).ok_or(RdbDeviceError::InvalidReservedArea)?
        let segment_count = (usize)file_system.lseg_block_count()
        let first_segment = if segment_count > 0 { (u32)(current + 1) } else { RDB_END_BLOCK }
        let next_file_system = if file_system_index + 1 < model.file_system_count() {
            (u32)(current + 1 + segment_count)
        } else {
            RDB_END_BLOCK
        }
        file_system.write_header(next_file_system, first_segment, &var block)?
        device.write_blocks(current, &block)?

        for segment_index in 0..segment_count {
            let segment_block = current + 1 + segment_index
            let next_segment = if segment_index + 1 < segment_count {
                (u32)(segment_block + 1)
            } else {
                RDB_END_BLOCK
            }
            file_system.write_lseg_block(segment_index, next_segment, &var block)?
            device.write_blocks(segment_block, &block)?
        }
        current = current + 1 + segment_count
    }
    return Result::Ok(())
}
