from std::collections import ArrayVec
from std::core import Clone, Option, Result
from rdb import RdbError, RdbFileSystem, RdbModel

pub fn file_system_preset(dos_type: u32) -> u16 {
    return 0 if dos_type == $444F5300
    return 1 if dos_type == $444F5301
    return 2 if dos_type == $444F5302
    return 3 if dos_type == $444F5303
    return 4 if dos_type == $444F5304
    return 5 if dos_type == $444F5305
    return 6 if dos_type == $50465303
    return 7 if dos_type == $50445303
    return 8 if dos_type == $53465300
    return 9 if dos_type == $53465302
    return 10
}

pub fn preset_dos_type(index: u16, current: u32) -> u32 {
    return $444F5300 if index == 0
    return $444F5301 if index == 1
    return $444F5302 if index == 2
    return $444F5303 if index == 3
    return $444F5304 if index == 4
    return $444F5305 if index == 5
    return $50465303 if index == 6
    return $50445303 if index == 7
    return $53465300 if index == 8
    return $53465302 if index == 9
    return current
}

pub struct FileSystemPool {
    entries: ArrayVec<RdbFileSystem, 8>
}

impl FileSystemPool {
    pub fn new() -> FileSystemPool {
        return FileSystemPool { entries: ArrayVec::<RdbFileSystem, 8>::new() }
    }

    pub fn len(&self) -> usize { return self.entries.len() }
    pub fn is_empty(&self) -> bool { return self.entries.is_empty() }
    pub fn entries(&self) -> &ArrayVec<RdbFileSystem, 8> { return &self.entries }
    pub fn get(&self, index: usize) -> Option<&RdbFileSystem> { return self.entries.get(index) }

    pub fn add(&var self, consuming file_system: RdbFileSystem) -> Result<usize, RdbError> {
        for index in 0..self.entries.len() {
            let Option::Some(current) = self.entries.get(index) else { continue }
            return Result::Ok(index) if current.dos_type() == file_system.dos_type()
        }
        let index = self.entries.len()
        self.entries.push(file_system)?
        return Result::Ok(index)
    }

    pub fn merge(&var self, model: &RdbModel) -> Result<(), RdbError> {
        for index in 0..model.file_system_count() {
            let file_system = model.file_system(index).ok_or(RdbError::InvalidRange)?
            let copy = file_system.clone().ok_or(RdbError::AllocationFailed)?
            let _ = self.add(copy)?
        }
        return Result::Ok(())
    }

    pub fn set_dos_type(&var self, index: usize, dos_type: u32) -> Result<(), RdbError> {
        let file_system = self.entries.get_mut(index).ok_or(RdbError::InvalidRange)?
        file_system.set_dos_type(dos_type)
        return Result::Ok(())
    }

    pub fn remove(&var self, index: usize) -> Result<(), RdbError> {
        let removed = self.entries.remove(index)
        return Result::Err(RdbError::InvalidRange) if removed.is_none()
        return Result::Ok(())
    }
}
