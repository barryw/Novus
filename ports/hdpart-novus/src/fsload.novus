from std::core import Error, Option, Result
from std::ffi::amiga_consts import MEMF_PUBLIC, MODE_OLDFILE, OFFSET_BEGINNING, OFFSET_END
from std::memory::block import MemoryBlock
from std::memory::slice import Slice
from std::os::dos import OwnedFileHandle
from std::strings::core import Str
from rdb import RdbFileSystem

const MAX_HANDLER_BYTES: u32 = 512u32 * 1024u32
const PFS3: u32 = $50465303
const PDS3: u32 = $50445303
const SFS2: u32 = $53465302

pub enum FsLoadError {
    OpenFailed,
    ReadFailed,
    TooLarge,
    NotLoadFile,
    OutOfMemory,
}

impl FsLoadError {
    pub fn message(&self) -> *u8 {
        return match self {
            FsLoadError::OpenFailed => "Could not open the filesystem handler.",
            FsLoadError::ReadFailed => "Could not read the filesystem handler.",
            FsLoadError::TooLarge => "The filesystem handler is larger than 512K.",
            FsLoadError::NotLoadFile => "The file is not an Amiga Hunk load file.",
            FsLoadError::OutOfMemory => "Not enough memory to load the filesystem handler.",
        }
    }
}

impl Error for FsLoadError {
    fn message(&self) -> *u8 { return FsLoadError::message(self) }
}

fn byte(image: &Slice<u8>, index: u32) -> u8 {
    return *image.get_unchecked(index)
}

pub fn is_hunk_file(image: Slice<u8>) -> bool {
    return false unless image.len() >= 4u32
    return byte(&image, 0u32) == 0u8 && byte(&image, 1u32) == 0u8 &&
        byte(&image, 2u32) == 3u8 && byte(&image, 3u32) == $F3u8
}

fn parse_number_pair(image: &Slice<u8>, start: u32, end: u32) -> Option<(u32, u32)> {
    var cursor = start
    return Option::None unless cursor < end && byte(image, cursor) >= (u8)'0' && byte(image, cursor) <= (u8)'9'
    var major = 0u32
    while cursor < end && byte(image, cursor) >= (u8)'0' && byte(image, cursor) <= (u8)'9' {
        major = if major <= 6553u32 { major * 10u32 + (u32)(byte(image, cursor) - (u8)'0') } else { 65535u32 }
        cursor++
    }
    return Option::None unless cursor < end && byte(image, cursor) == (u8)'.'
    cursor++
    return Option::None unless cursor < end && byte(image, cursor) >= (u8)'0' && byte(image, cursor) <= (u8)'9'
    var minor = 0u32
    while cursor < end && byte(image, cursor) >= (u8)'0' && byte(image, cursor) <= (u8)'9' {
        minor = if minor <= 6553u32 { minor * 10u32 + (u32)(byte(image, cursor) - (u8)'0') } else { 65535u32 }
        cursor++
    }
    return Option::Some(((major << 16u32) | minor, cursor))
}

pub fn parse_version(image: Slice<u8>) -> u32 {
    if image.len() >= 5u32 {
        for index in 0u32..image.len() - 4u32 {
            let cookie = byte(&image, index) == (u8)'$' && byte(&image, index + 1u32) == (u8)'V' &&
                byte(&image, index + 2u32) == (u8)'E' && byte(&image, index + 3u32) == (u8)'R' &&
                byte(&image, index + 4u32) == (u8)':'
            if cookie {
                var cursor = index + 5u32
                var end = cursor + 200u32
                if end > image.len() { end = image.len() }
                while cursor < end {
                    match parse_number_pair(&image, cursor, end) {
                        Option::Some(pair) => {
                            let (version, _) = pair
                            return version
                        },
                        Option::None => cursor++,
                    }
                }
                break
            }
        }
    }
    if image.len() >= 4u32 {
        for index in 0u32..image.len() - 1u32 {
            if byte(&image, index) == (u8)' ' {
                match parse_number_pair(&image, index + 1u32, image.len()) {
                    Option::Some(pair) => {
                        let (version, end) = pair
                        return version if end + 1u32 < image.len() && byte(&image, end) == (u8)' ' && byte(&image, end + 1u32) == (u8)'('
                    },
                    Option::None => {},
                }
            }
        }
    }
    return 0u32
}

pub fn detect_dos_type(image: Slice<u8>) -> u32 {
    return 0u32 unless image.len() >= 4u32
    var pfs = 0u32
    var pds = 0u32
    var sfs = 0u32
    for index in 0u32..image.len() - 3u32 {
        continue if byte(&image, index + 3u32) > 15u8
        let a = byte(&image, index)
        let b = byte(&image, index + 1u32)
        let c = byte(&image, index + 2u32)
        if a == (u8)'P' && b == (u8)'F' && c == (u8)'S' { pfs++ }
        if a == (u8)'P' && b == (u8)'D' && c == (u8)'S' { pds++ }
        if a == (u8)'S' && b == (u8)'F' && c == (u8)'S' { sfs++ }
    }
    return SFS2 if sfs >= 2u32 && sfs >= pfs && sfs >= pds
    return PFS3 if pfs >= 2u32 && pfs >= pds
    return PDS3 if pds >= 2u32
    return 0u32
}

pub fn load_file_system(path: Str) -> Result<RdbFileSystem, FsLoadError> {
    let file = match OwnedFileHandle::open(path, MODE_OLDFILE as i32) {
        Result::Ok(value) => value,
        Result::Err(_) => return Result::Err(FsLoadError::OpenFailed),
    }
    match file.seek(0, OFFSET_END as i32) {
        Result::Ok(_) => {},
        Result::Err(_) => return Result::Err(FsLoadError::ReadFailed),
    }
    let end = match file.seek(0, OFFSET_BEGINNING as i32) {
        Result::Ok(value) => value,
        Result::Err(_) => return Result::Err(FsLoadError::ReadFailed),
    }
    return Result::Err(FsLoadError::ReadFailed) unless end > 0
    let size = end as u32
    return Result::Err(FsLoadError::TooLarge) if size > MAX_HANDLER_BYTES
    var storage = match MemoryBlock::alloc(size, MEMF_PUBLIC) {
        Result::Ok(value) => value,
        Result::Err(_) => return Result::Err(FsLoadError::OutOfMemory),
    }
    match file.read_all(storage.ptr(), size) {
        Result::Ok(read) => return Result::Err(FsLoadError::ReadFailed) unless read == size,
        Result::Err(_) => return Result::Err(FsLoadError::ReadFailed),
    }
    let image = storage.as_bytes()
    return Result::Err(FsLoadError::NotLoadFile) unless is_hunk_file(image)
    var dos_type = detect_dos_type(image)
    if dos_type == 0u32 { dos_type = PFS3 }
    return match RdbFileSystem::embedded(dos_type, parse_version(image), $1B0u32, 4096u32, 10, -1, image) {
        Result::Ok(value) => Result::Ok(value),
        Result::Err(_) => Result::Err(FsLoadError::OutOfMemory),
    }
}
