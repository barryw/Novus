from std::core import Result
from std::test::test import expect_true
from filesystem_pool import FileSystemPool, file_system_preset, preset_dos_type
from rdb import RdbFileSystem, RdbModel

fn filesystem_pool_is_correct() -> bool {
    let image: [u8] = [1, 2, 3, 4]
    let Result::Ok(file_system) = RdbFileSystem::embedded($50465303, $00130002, 0, 4096, 0, -1, &image) else { return false }
    var source = RdbModel::new(100, 16, 63)
    return false if source.add_file_system(file_system).is_err()

    var pool = FileSystemPool::new()
    return false if pool.merge(&source).is_err()
    return false unless pool.len() == 1
    return false if pool.merge(&source).is_err()
    return false unless pool.len() == 1

    let Result::Ok(second_file_system) = RdbFileSystem::embedded($53465300, $00140001, 0, 4096, 0, -1, &image) else { return false }
    var second_disk = RdbModel::new(200, 16, 63)
    return false if second_disk.add_file_system(second_file_system).is_err()
    return false if pool.merge(&second_disk).is_err()
    return false unless pool.len() == 2
    return false if pool.merge(&source).is_err()
    return false unless pool.len() == 2

    return false if pool.set_dos_type(0, $53465300).is_err()
    return false unless pool.get(0).unwrap().dos_type() == $53465300
    return false if pool.remove(0).is_err()
    return pool.len() == 1 && pool.get(0).unwrap().dos_type() == $53465300
}

@test("filesystem pool merges, edits, and removes entries")
pub fn test_filesystem_pool() {
    expect_true(filesystem_pool_is_correct(), "filesystem pool remains consistent")
}

@test("filesystem presets cover native and embedded handlers")
pub fn test_file_system_presets() {
    let types: [u32] = [$444F5300, $444F5301, $444F5302, $444F5303, $444F5304, $444F5305, $50465303, $50445303, $53465300, $53465302]
    for index in 0..10 {
        let dos_type = types[index as u32]
        expect_true(file_system_preset(dos_type) == index, "preset index matches DosType")
        expect_true(preset_dos_type(index, 0) == dos_type, "preset restores DosType")
    }
    expect_true(file_system_preset($41424344) == 10, "unknown DosType uses Custom")
    expect_true(preset_dos_type(10, $41424344) == $41424344, "Custom preserves DosType")
}
