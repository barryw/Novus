from safety import DeviceIdentity, DeviceLiveness, classify_live_device, mounted_device_name_exists
from std::test::test import expect_true

fn live_safety_is_correct() -> bool {
    return false unless mounted_device_name_exists("DH0")
    return false if mounted_device_name_exists("NOVUS_NOT_MOUNTED")

    let floppy = DeviceIdentity { driver: "trackdisk.device", unit: 0 }
    match classify_live_device(&floppy) {
        DeviceLiveness::Mounted => {},
        _ => return false,
    }

    // This A4000 boots from a host-directory DH0:, which has no startup
    // message identifying a raw backing device. The classifier must fail closed.
    let missing = DeviceIdentity { driver: "not-a-real.device", unit: 99 }
    return match classify_live_device(&missing) {
        DeviceLiveness::Mounted => true,
        _ => false,
    }
}

@test("live device safety fails closed")
pub fn test_live_device_safety() {
    expect_true(live_safety_is_correct(), "mounted and unidentified devices are protected")
}
