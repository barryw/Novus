// @covers amiga::sys::gadtools::builder::GadToolsWindow::cycle(u16)
// @covers amiga::sys::gadtools::builder::GadToolsWindow::list_view(u16)
// @covers amiga::sys::gadtools::builder::GadToolsWindow::string(u16)
// @covers amiga::sys::gadtools::builder::GadToolsWindow::text(u16)
// @covers amiga::sys::gadtools::builder::GadToolsWindow::checkbox(u16)
// @covers amiga::sys::gadtools::builder::CycleControl::set_active(u16)
// @covers amiga::sys::gadtools::builder::ListViewControl::set_selected(Option<u16>)
// @covers amiga::sys::gadtools::builder::StringControl::set_value(Str)
// @covers amiga::sys::gadtools::builder::StringControl::value()
// @covers amiga::sys::gadtools::builder::TextControl::set_text(Str)
// @covers amiga::sys::gadtools::builder::CheckboxControl::set_checked(bool)
// @covers amiga::sys::gadtools::builder::CheckboxControl::checked()
// @covers amiga::sys::gadtools::menu::GadToolsMenuBuilder::add_menu(Str)
// @covers amiga::sys::gadtools::menu::GadToolsMenuBuilder::build()
// @covers amiga::sys::gadtools::menu::MenuHandle::add_item(Str)
@test("HDPart controls survive repeated model replacement")
pub fn test_ui_controls() {
    expect_true(run_ui_controls().is_ok(), "controls open, update, and close safely")
}

fn run_canvas() -> u32 {
    let builder = WindowBuilder::workbench()
    let mut_builder = match builder {
        Result::Ok(value) => value,
        Result::Err(_) => return 1,
    }
    var ui = mut_builder
    if ui.add_button(1, "Close", Bounds::new(150, 100, 60, 14)).is_err() { return 2 }
    var menus = ui.menu_builder()
    var project = menus.add_menu("Project")
    project.add_item("Close")
    let menu = match menus.build() {
        Result::Ok(value) => value,
        Result::Err(_) => return 3,
    }
    let built = ui.build("Canvas contracts", Bounds::new(40, 30, 240, 150), menu)
    let window_value = match built {
        Result::Ok(value) => value,
        Result::Err(_) => return 4,
    }
    var app_window = window_value
    let canvas = match Canvas::for_window(&app_window) {
        Result::Ok(value) => value,
        Result::Err(_) => return 5,
    }
    canvas.clear(0)
    canvas.pen(1)
    canvas.background_pen(0)
    canvas.pens(1, 0)
    canvas.mode(DrawMode::Jam1)
    canvas.move_to(10, 10)
    canvas.line_to(30, 10)
    canvas.line(10, 20, 30, 20)
    canvas.fill(&Rect::new(10, 30, 20, 40))
    canvas.outline(&Rect::new(25, 30, 35, 40))
    canvas.erase(&Rect::new(12, 32, 14, 34))
    canvas.circle(50, 35, 5)
    canvas.ellipse(&Ellipse::new(70, 35, 6, 4))
    if canvas.pixel(90, 35).is_err() { return 6 }
    if canvas.pixel_at(&Point::new(91, 35)).is_err() { return 7 }
    if canvas.system().get_pixel(90, 35) != 1 { return 8 }
    if canvas.system().get_pixel(91, 35) != 1 { return 9 }
    return 0
}

// @covers amiga::graphics::ApplicationCanvas::for_window(&ApplicationWindow)
// @covers amiga::graphics::ApplicationCanvas::pen(u8)
// @covers amiga::graphics::ApplicationCanvas::background_pen(u8)
// @covers amiga::graphics::ApplicationCanvas::pens(u8, u8)
// @covers amiga::graphics::ApplicationCanvas::mode(DrawMode)
// @covers amiga::graphics::ApplicationCanvas::move_to(i16, i16)
// @covers amiga::graphics::ApplicationCanvas::line_to(i16, i16)
// @covers amiga::graphics::ApplicationCanvas::line(i16, i16, i16, i16)
// @covers amiga::graphics::ApplicationCanvas::fill(&Rect)
// @covers amiga::graphics::ApplicationCanvas::outline(&Rect)
// @covers amiga::graphics::ApplicationCanvas::erase(&Rect)
// @covers amiga::graphics::ApplicationCanvas::circle(i16, i16, i16)
// @covers amiga::graphics::ApplicationCanvas::ellipse(&Ellipse)
// @covers amiga::graphics::ApplicationCanvas::pixel(i16, i16)
// @covers amiga::graphics::ApplicationCanvas::pixel_at(&Point)
// @covers amiga::graphics::ApplicationCanvas::clear(u8)
// @covers amiga::graphics::ApplicationCanvas::system()
// @covers amiga::ui::ApplicationWindow::system()
// @covers amiga::sys::gadtools::builder::GadToolsWindow::rastport()
// @covers amiga::sys::graphics::draw::DrawContext::pens(u8, u8)
// @covers amiga::sys::graphics::draw::DrawContext::rect_outline(&Rect)
// @covers amiga::sys::graphics::draw::DrawContext::circle(i16, i16, i16)
// @covers amiga::sys::graphics::draw::DrawContext::ellipse_shape(&Ellipse)
@test("application canvas delegates bounded drawing to its window")
pub fn test_application_canvas() {
    let stage = run_canvas()
    if stage != 0 { write("canvas stage %lu\n", stage) }
    expect_eq(stage, 0, "canvas opens, draws, reads back, and closes safely")
}
