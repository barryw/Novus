// HDPart UI-01 control creation without raw GadTools pointers or tag lists.

from std::core import Option, Result
from std::test::test import expect_eq, expect_true
from amiga::ui import Bounds, UiError, WindowBuilder
from amiga::graphics import Canvas, DrawMode, Ellipse, Point, Rect

const DRIVER: u16 = 1
const PARTITIONS: u16 = 2
const NAME: u16 = 3
const STATUS: u16 = 4
const QUIT: u16 = 5
const BOOTABLE: u16 = 6
const SIZE: u16 = 7

fn run_ui_controls() -> Result<(), UiError> {
    var ui = WindowBuilder::workbench()?
    let drivers = ["scsi.device", "uaehf.device"]
    let partitions = ["DH0  DOS3  0-511", "DH1  DOS3  512-1023"]
    let rescanned_drivers = ["scsi.device", "uaehf.device", "trackdisk.device"]
    let rescanned_partitions = ["DH0  DOS3  0-255", "DH1  DOS3  256-767", "DH2  DOS3  768-1023"]

    ui.add_cycle(DRIVER, "Driver", Bounds::new(64, 18, 220, 14), &drivers, 0)?
    ui.add_list_view(PARTITIONS, Bounds::new(12, 40, 272, 50), &partitions, Option::None)?
    ui.add_string(NAME, "Name", Bounds::new(64, 96, 100, 14), "DH0", 31)?
    ui.add_text(STATUS, Bounds::new(12, 122, 180, 12), "Status: RDB OK")?
    ui.add_checkbox(BOOTABLE, "Bootable", Bounds::new(82, 140, 26, 11), false)?
    ui.add_integer(SIZE, "Size", Bounds::new(130, 140, 58, 11), 10, 10)?
    ui.add_button(QUIT, "Quit", Bounds::new(214, 120, 70, 14))?
    let _ = ui.system()

    var menus = ui.menu_builder()
    var project = menus.add_menu("Project")
    let item = project.add_item("Quit")
    var configured_item = item
    let keyed_item = configured_item.with_command_key((u8)'Q')
    var checkable_item = keyed_item
    let checked_item = checkable_item.with_checkmark()
    var initially_checked = checked_item
    let final_item = initially_checked.checked()
    let _ = final_item.system()
    project.add_separator()
    let _ = project.system()
    let _ = menus.system()
    let menu = menus.build()?
    var window = ui.build("HDPart controls", Bounds::new(40, 30, 304, 162), menu)?
    let _ = window.system()
    let _ = window.child_builder()?
    window.fill_rect(0, 2, 2, 4, 4)
    window.outline_rect(1, 2, 2, 4, 4)
    window.set_menu_enabled(0, 0, false)
    window.set_menu_enabled(0, 0, true)
    window.refresh()

    match window.control(QUIT) {
        Option::Some(control) => {
            if control.id() != QUIT { return Result::Err(UiError::ControlFailed) }
            control.set_enabled(false)
            control.set_enabled(true)
            let _ = control.system()
        },
        Option::None => return Result::Err(UiError::ControlFailed),
    }

    // Invalid updates leave the current model installed.
    match window.replace_cycle(DRIVER, &drivers, 2) {
        Result::Err(_) => {},
        Result::Ok(_) => return Result::Err(UiError::ControlFailed),
    }
    match window.replace_list(DRIVER, &partitions, Option::None) {
        Result::Err(_) => {},
        Result::Ok(_) => return Result::Err(UiError::ControlFailed),
    }

    // HDPart replaces both models after scans and every partition edit. Reuse
    // the same two owner slots enough times to expose leaks or stale pointers.
    var generation: u32 = 0
    while generation < 256 {
        if (generation & 1) == 0 {
            window.replace_cycle(DRIVER, &rescanned_drivers, 2)?
            window.replace_list(PARTITIONS, &rescanned_partitions, Option::Some(2))?
        } else {
            window.replace_cycle(DRIVER, &drivers, 1)?
            window.replace_list(PARTITIONS, &partitions, Option::Some(1))?
        }
        generation++
    }

    match window.cycle(DRIVER) {
        Option::Some(control) => {
            control.set_active(1)
            let _ = control.system()
        },
        Option::None => return Result::Err(UiError::ControlFailed),
    }
    match window.list_view(PARTITIONS) {
        Option::Some(control) => {
            control.set_selected(Option::Some(1))
            let _ = control.system()
        },
        Option::None => return Result::Err(UiError::ControlFailed),
    }
    match window.string(NAME) {
        Option::Some(control) => {
            match control.set_value("DH1") {
                Result::Ok(_) => {},
                Result::Err(_) => return Result::Err(UiError::ControlFailed),
            }
            match control.value() {
                Option::Some(value) => {
                    if !value.equals("DH1") {
                        return Result::Err(UiError::ControlFailed)
                    }
                },
                Option::None => return Result::Err(UiError::ControlFailed),
            }
            let _ = control.system()
        },
        Option::None => return Result::Err(UiError::ControlFailed),
    }
    match window.text(STATUS) {
        Option::Some(control) => {
            match control.set_text("Status: state OK") {
                Result::Ok(_) => {},
                Result::Err(_) => return Result::Err(UiError::ControlFailed),
            }
            let _ = control.system()
        },
        Option::None => return Result::Err(UiError::ControlFailed),
    }
    if window.string(DRIVER).is_some() {
        return Result::Err(UiError::ControlFailed)
    }
    match window.checkbox(BOOTABLE) {
        Option::Some(control) => {
            control.set_checked(true)
            if !control.checked() { return Result::Err(UiError::ControlFailed) }
            let _ = control.system()
        },
        Option::None => return Result::Err(UiError::ControlFailed),
    }

    match window.integer(SIZE) {
        Option::Some(control) => {
            control.set_value(-1)
            if control.value().unwrap_or(0) != -1 { return Result::Err(UiError::ControlFailed) }
            control.set_u32_saturating(4294967295)
            if control.u32_value().unwrap_or(0) != 2147483647 { return Result::Err(UiError::ControlFailed) }
            let _ = control.system()
        },
        Option::None => return Result::Err(UiError::ControlFailed),
    }

    return Result::Ok(())
}

