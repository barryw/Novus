// Simple Vec test that compiles with current features
// This tests generic structs and impl blocks without method calls

struct Vec<T> {
    ptr: *T,
    len: u32,
    capacity: u32,
}

impl<T> Vec<T> {
    fn len(&self) -> u32 {
        return self.len
    }

    fn is_empty(&self) -> bool {
        return self.len == 0u32
    }

    fn capacity(&self) -> u32 {
        return self.capacity
    }
}

fn main() -> i32 {
    // Create a Vec manually (no constructor yet)
    var numbers: Vec<i32> = Vec::<i32> {
        ptr: 0 as *i32,
        len: 0u32,
        capacity: 0u32,
    }

    // Access fields directly for now
    let len: u32 = numbers.len
    let cap: u32 = numbers.capacity
    let empty: bool = len == 0u32

    // Set some values
    numbers.len = 5u32
    numbers.capacity = 10u32

    // Read them back
    let len2: u32 = numbers.len
    let cap2: u32 = numbers.capacity

    // Calculate if we have space
    let has_space: bool = cap2 > len2

    return 0
}
