// modular_framework_showcase.novus
// A file-level facade like this can be split into config, display, input, and
// plugin modules. Consumers then import or re-export the same public names.

from std::io import println
from std::core import Result, Drop

pub const APP_NAME: *u8 = "ModularShowcase"
pub const VERSION: u32 = 0x0001_0000
pub const DISPLAY_WIDTH: u16 = 320
pub const DISPLAY_HEIGHT: u16 = 256

pub enum FrameworkError {
    InitFailed,
    InvalidPlugin,
}

impl FrameworkError {
    pub fn message(&self) -> *u8 {
        match *self {
            FrameworkError::InitFailed => "Initialization failed",
            FrameworkError::InvalidPlugin => "Invalid plugin",
        }
    }
}

struct FrameBuffer {
    width: u16,
    height: u16,
    data: *u8,
}

pub struct Display {
    frame_buffer: FrameBuffer,
    frame_count: u32,
    active: bool,
}

impl Display {
    pub fn init() -> Result<Display, FrameworkError> {
        let frame_buffer = FrameBuffer {
            width: DISPLAY_WIDTH,
            height: DISPLAY_HEIGHT,
            data: null,
        }
        return Result::Ok(Display {
            frame_buffer: frame_buffer,
            frame_count: 0,
            active: true,
        })
    }

    pub fn present(&var self) {
        self.frame_count += 1
    }

    pub fn frame_count(&self) -> u32 {
        return self.frame_count
    }
}

impl Drop for Display {
    fn drop(&var self) {
        self.active = false
    }
}

pub struct Input {
    quit_requested: bool,
}

impl Input {
    pub fn init() -> Result<Input, FrameworkError> {
        return Result::Ok(Input { quit_requested: false })
    }

    pub fn poll(&var self) {
    }

    pub fn should_quit(&self) -> bool {
        return self.quit_requested
    }
}

pub struct PluginContext {
    frame: u32,
    delta_time: fixed32,
}

pub trait Plugin {
    fn name(&self) -> *u8
    fn on_init(&var self) -> Result<(), FrameworkError>
    fn on_update(&var self, context: &PluginContext) -> Result<(), FrameworkError>
    fn on_shutdown(&var self)
}

pub struct FrameCounterPlugin {
    frames: u32,
}

impl FrameCounterPlugin {
    pub fn new() -> FrameCounterPlugin {
        return FrameCounterPlugin { frames: 0 }
    }
}

impl Plugin for FrameCounterPlugin {
    fn name(&self) -> *u8 {
        return "FrameCounter"
    }

    fn on_init(&var self) -> Result<(), FrameworkError> {
        println("[Plugin] initialized")
        return Result::Ok(())
    }

    fn on_update(&var self, context: &PluginContext) -> Result<(), FrameworkError> {
        self.frames += 1
        return Result::Ok(())
    }

    fn on_shutdown(&var self) {
        println(f"[Plugin] processed {self.frames} frames")
    }
}

pub struct Framework {
    display: Display,
    input: Input,
    running: bool,
}

impl Framework {
    pub fn init() -> Result<Framework, FrameworkError> {
        let display = Display::init()?
        let input = Input::init()?
        return Result::Ok(Framework {
            display: display,
            input: input,
            running: false,
        })
    }

    pub fn run<T>(&var self, plugin: &var T, max_frames: u32) -> Result<(), FrameworkError> where T: Plugin {
        plugin.on_init()?
        self.running = true
        var frame = 0u32

        while self.running && frame < max_frames {
            self.input.poll()
            if self.input.should_quit() {
                break
            }

            let context = PluginContext {
                frame: frame,
                delta_time: 16.67,
            }
            plugin.on_update(&context)?
            self.display.present()
            frame += 1
        }

        plugin.on_shutdown()
        self.running = false
        return Result::Ok(())
    }
}

impl Drop for Framework {
    fn drop(&var self) {
        self.running = false
    }
}

fn main() -> i32 {
    println(f"{APP_NAME} {VERSION >> 16}.{VERSION & 0xFFFF}")

    match Framework::init() {
        Result::Ok(var framework) => {
            var plugin = FrameCounterPlugin::new()
            match framework.run(&var plugin, 20) {
                Result::Ok(_) => println(f"Presented {framework.display.frame_count()} frames"),
                Result::Err(error) => println(error.message()),
            }
        },
        Result::Err(error) => {
            println(error.message())
            return 1
        },
    }

    return 0
}
