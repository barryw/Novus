@test("Cidr::new clamps prefix > 32")
pub fn test_cidr_new_clamp_high() {
    let ip = Ipv4Addr::new(10, 0, 0, 0)
    let cidr = Cidr::new(ip, 64)  // Invalid, should clamp to 32

    expect_eq(cidr.prefix_len(), 32, "prefix should be clamped to 32")
}

