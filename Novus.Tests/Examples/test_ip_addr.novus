    let ip = cidr.ip()
    let octets = ip.octets()

    expect_eq(octets[0], 10, "private class A first octet")
    expect_eq(octets[1], 0, "private class A second octet")
    expect_eq(octets[2], 0, "private class A third octet")
    expect_eq(octets[3], 0, "private class A fourth octet")
    expect_eq(cidr.prefix_len(), 8, "private class A prefix")
}

