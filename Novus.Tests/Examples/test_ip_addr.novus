    expect_eq(cidr.prefix_len(), 0, "prefix 0 allowed")
}

// ============================================================================
// CIDR Tests - Network Address
// ============================================================================

@test("Cidr::network for /24")
pub fn test_cidr_network_24() {
    let ip = Ipv4Addr::new(192, 168, 1, 100)
    let cidr = Cidr::new(ip, 24)
    let network = cidr.network()
    let octets = network.octets()

    expect_eq(octets[0], 192, "network first octet")
    expect_eq(octets[1], 168, "network second octet")
    expect_eq(octets[2], 1, "network third octet")
    expect_eq(octets[3], 0, "network fourth octet (masked)")
}

@test("Cidr::network for /16")
pub fn test_cidr_network_16() {
    let ip = Ipv4Addr::new(172, 16, 45, 123)
    let cidr = Cidr::new(ip, 16)
    let network = cidr.network()
    let octets = network.octets()

    expect_eq(octets[0], 172, "network first octet")
    expect_eq(octets[1], 16, "network second octet")
    expect_eq(octets[2], 0, "network third octet (masked)")
    expect_eq(octets[3], 0, "network fourth octet (masked)")
}

@test("Cidr::network for /8")
pub fn test_cidr_network_8() {
    let ip = Ipv4Addr::new(10, 123, 45, 67)
    let cidr = Cidr::new(ip, 8)
    let network = cidr.network()
    let octets = network.octets()

    expect_eq(octets[0], 10, "network first octet")
    expect_eq(octets[1], 0, "network second octet (masked)")
    expect_eq(octets[2], 0, "network third octet (masked)")
    expect_eq(octets[3], 0, "network fourth octet (masked)")
}

@test("Cidr::network for /32")
pub fn test_cidr_network_32() {
    let ip = Ipv4Addr::new(192, 168, 1, 100)
    let cidr = Cidr::new(ip, 32)
    let network = cidr.network()
    let octets = network.octets()

    expect_eq(octets[0], 192, "network first octet unchanged")
    expect_eq(octets[1], 168, "network second octet unchanged")
    expect_eq(octets[2], 1, "network third octet unchanged")
    expect_eq(octets[3], 100, "network fourth octet unchanged")
}

