@test("Cidr::contains positive - network address")
pub fn test_cidr_contains_network() {
    let cidr = Cidr::new(Ipv4Addr::new(192, 168, 1, 0), 24)
    let ip = Ipv4Addr::new(192, 168, 1, 0)
    expect_true(cidr.contains(ip), "192.168.1.0 in 192.168.1.0/24")
}

@test("Cidr::contains positive - broadcast address")
pub fn test_cidr_contains_broadcast() {
    let cidr = Cidr::new(Ipv4Addr::new(192, 168, 1, 0), 24)
    let ip = Ipv4Addr::new(192, 168, 1, 255)
    expect_true(cidr.contains(ip), "192.168.1.255 in 192.168.1.0/24")
}

@test("Cidr::contains positive - middle of range")
pub fn test_cidr_contains_middle() {
    let cidr = Cidr::new(Ipv4Addr::new(192, 168, 1, 0), 24)
    let ip = Ipv4Addr::new(192, 168, 1, 100)
    expect_true(cidr.contains(ip), "192.168.1.100 in 192.168.1.0/24")
}

@test("Cidr::contains negative - different subnet")
pub fn test_cidr_contains_different_subnet() {
    let cidr = Cidr::new(Ipv4Addr::new(192, 168, 1, 0), 24)
    let ip = Ipv4Addr::new(192, 168, 2, 1)
    expect_false(cidr.contains(ip), "192.168.2.1 not in 192.168.1.0/24")
}

@test("Cidr::contains negative - completely different network")
pub fn test_cidr_contains_different_network() {
    let cidr = Cidr::new(Ipv4Addr::new(192, 168, 1, 0), 24)
    let ip = Ipv4Addr::new(10, 0, 0, 1)
    expect_false(cidr.contains(ip), "10.0.0.1 not in 192.168.1.0/24")
}

@test("Cidr::contains /16 range")
pub fn test_cidr_contains_16() {
    let cidr = Cidr::new(Ipv4Addr::new(172, 16, 0, 0), 16)

    expect_true(cidr.contains(Ipv4Addr::new(172, 16, 0, 1)), "172.16.0.1 in 172.16.0.0/16")
    expect_true(cidr.contains(Ipv4Addr::new(172, 16, 255, 255)), "172.16.255.255 in 172.16.0.0/16")
    expect_false(cidr.contains(Ipv4Addr::new(172, 17, 0, 0)), "172.17.0.0 not in 172.16.0.0/16")
}

@test("Cidr::contains /8 range")
pub fn test_cidr_contains_8() {
    let cidr = Cidr::new(Ipv4Addr::new(10, 0, 0, 0), 8)

    expect_true(cidr.contains(Ipv4Addr::new(10, 0, 0, 1)), "10.0.0.1 in 10.0.0.0/8")
    expect_true(cidr.contains(Ipv4Addr::new(10, 255, 255, 255)), "10.255.255.255 in 10.0.0.0/8")
    expect_false(cidr.contains(Ipv4Addr::new(11, 0, 0, 0)), "11.0.0.0 not in 10.0.0.0/8")
}

@test("Cidr::contains /32 single host")
pub fn test_cidr_contains_32() {
    let cidr = Cidr::new(Ipv4Addr::new(192, 168, 1, 100), 32)

    expect_true(cidr.contains(Ipv4Addr::new(192, 168, 1, 100)), "exact match for /32")
    expect_false(cidr.contains(Ipv4Addr::new(192, 168, 1, 101)), "192.168.1.101 not in /32")
    expect_false(cidr.contains(Ipv4Addr::new(192, 168, 1, 99)), "192.168.1.99 not in /32")
}

