// Comprehensive tests for std::net::addr - IP address and CIDR functionality
// Run with: novus test test_ip_addr.novus

from std::test::test import expect, expect_true, expect_false, expect_eq, expect_eq, expect_eq, expect_eq, expect_eq
from std::net::addr import Ipv4Addr, SocketAddrV4, Cidr, AddrParseError
from std::core import Result

// ============================================================================
// Ipv4Addr Construction Tests
// ============================================================================

@test("Ipv4Addr::new creates correct octets")
pub fn test_ipv4_new() {
    let addr = Ipv4Addr::new(192, 168, 1, 100)
    let octets = addr.octets()
    expect_eq(octets[0], 192, "first octet")
    expect_eq(octets[1], 168, "second octet")
    expect_eq(octets[2], 1, "third octet")
    expect_eq(octets[3], 100, "fourth octet")
}

@test("Ipv4Addr::new with zeros")
pub fn test_ipv4_new_zeros() {
    let addr = Ipv4Addr::new(0, 0, 0, 0)
    let octets = addr.octets()
    expect_eq(octets[0], 0, "first octet zero")
    expect_eq(octets[1], 0, "second octet zero")
    expect_eq(octets[2], 0, "third octet zero")
    expect_eq(octets[3], 0, "fourth octet zero")
}

@test("Ipv4Addr::new with max values")
pub fn test_ipv4_new_max() {
    let addr = Ipv4Addr::new(255, 255, 255, 255)
    let octets = addr.octets()
    expect_eq(octets[0], 255, "first octet max")
    expect_eq(octets[1], 255, "second octet max")
    expect_eq(octets[2], 255, "third octet max")
    expect_eq(octets[3], 255, "fourth octet max")
}

@test("Ipv4Addr::from_u32 creates correct address")
pub fn test_ipv4_from_u32() {
    // 192.168.1.100 = 0xC0A80164
    let addr = Ipv4Addr::from_u32(0xC0A80164)
    let octets = addr.octets()
    expect_eq(octets[0], 192, "from_u32 first octet")
    expect_eq(octets[1], 168, "from_u32 second octet")
    expect_eq(octets[2], 1, "from_u32 third octet")
    expect_eq(octets[3], 100, "from_u32 fourth octet")
}

@test("Ipv4Addr::from_u32 with zero")
pub fn test_ipv4_from_u32_zero() {
    let addr = Ipv4Addr::from_u32(0)
    expect_true(addr.is_any(), "from_u32(0) should be any address")
}

@test("Ipv4Addr::from_u32 with max")
pub fn test_ipv4_from_u32_max() {
    let addr = Ipv4Addr::from_u32(0xFFFFFFFF)
    expect_true(addr.is_broadcast(), "from_u32(max) should be broadcast")
}

@test("Ipv4Addr::to_u32 roundtrip")
pub fn test_ipv4_to_u32_roundtrip() {
    let original: u32 = 0xC0A80164
    let addr = Ipv4Addr::from_u32(original)
    let result = addr.to_u32()
    expect_eq(result, original, "to_u32 should roundtrip")
}

@test("Ipv4Addr::from_network_order on big-endian")
pub fn test_ipv4_from_network_order() {
    // On Amiga (big-endian), network order = host order
    let addr = Ipv4Addr::from_network_order(0x0A000001)  // 10.0.0.1
    let octets = addr.octets()
    expect_eq(octets[0], 10, "network order first octet")
    expect_eq(octets[1], 0, "network order second octet")
    expect_eq(octets[2], 0, "network order third octet")
    expect_eq(octets[3], 1, "network order fourth octet")
}

// ============================================================================
// Ipv4Addr Special Address Constructors
// ============================================================================

@test("Ipv4Addr::localhost returns 127.0.0.1")
pub fn test_ipv4_localhost() {
    let addr = Ipv4Addr::localhost()
    let octets = addr.octets()
    expect_eq(octets[0], 127, "localhost first octet")
    expect_eq(octets[1], 0, "localhost second octet")
    expect_eq(octets[2], 0, "localhost third octet")
    expect_eq(octets[3], 1, "localhost fourth octet")
}

@test("Ipv4Addr::any returns 0.0.0.0")
pub fn test_ipv4_any() {
    let addr = Ipv4Addr::any()
    let octets = addr.octets()
    expect_eq(octets[0], 0, "any first octet")
    expect_eq(octets[1], 0, "any second octet")
    expect_eq(octets[2], 0, "any third octet")
    expect_eq(octets[3], 0, "any fourth octet")
}

@test("Ipv4Addr::broadcast returns 255.255.255.255")
pub fn test_ipv4_broadcast() {
    let addr = Ipv4Addr::broadcast()
    let octets = addr.octets()
    expect_eq(octets[0], 255, "broadcast first octet")
    expect_eq(octets[1], 255, "broadcast second octet")
    expect_eq(octets[2], 255, "broadcast third octet")
    expect_eq(octets[3], 255, "broadcast fourth octet")
}

