// ============================================================================
// Ipv4Addr Format Tests
// ============================================================================

@test("Ipv4Addr::format writes correct string")
pub fn test_ipv4_format() {
    let addr = Ipv4Addr::new(192, 168, 1, 100)
    var buf: [u8] = [0; 16]
    let len = addr.format((*u8)&buf[0])

    // Check length (192.168.1.100 = 13 chars)
    expect_eq(len, 13, "format length for 192.168.1.100")

    // Check individual characters
    expect_eq(buf[0], 49, "char '1'")   // '1'
    expect_eq(buf[1], 57, "char '9'")   // '9'
    expect_eq(buf[2], 50, "char '2'")   // '2'
    expect_eq(buf[3], 46, "char '.'")   // '.'
}

@test("Ipv4Addr::format single digit octets")
pub fn test_ipv4_format_single_digits() {
    let addr = Ipv4Addr::new(1, 2, 3, 4)
    var buf: [u8] = [0; 16]
    let len = addr.format((*u8)&buf[0])

    // 1.2.3.4 = 7 chars
    expect_eq(len, 7, "format length for 1.2.3.4")
}

@test("Ipv4Addr::format max value octets")
pub fn test_ipv4_format_max() {
    let addr = Ipv4Addr::new(255, 255, 255, 255)
    var buf: [u8] = [0; 16]
    let len = addr.format((*u8)&buf[0])

    // 255.255.255.255 = 15 chars
    expect_eq(len, 15, "format length for 255.255.255.255")
}

@test("Ipv4Addr::format zero address")
pub fn test_ipv4_format_zero() {
    let addr = Ipv4Addr::new(0, 0, 0, 0)
    var buf: [u8] = [0; 16]
    let len = addr.format((*u8)&buf[0])

    // 0.0.0.0 = 7 chars
    expect_eq(len, 7, "format length for 0.0.0.0")
}

// ============================================================================
// SocketAddrV4 Tests
// ============================================================================

@test("SocketAddrV4::new creates correct address")
pub fn test_socket_addr_new() {
    let ip = Ipv4Addr::new(192, 168, 1, 100)
    let addr = SocketAddrV4::new(ip, 8080)

    expect_eq(addr.port(), 8080, "port should be 8080")
    let got_ip = addr.ip()
    let octets = got_ip.octets()
    expect_eq(octets[0], 192, "ip first octet")
}

@test("SocketAddrV4 with port 0")
pub fn test_socket_addr_port_zero() {
    let ip = Ipv4Addr::new(0, 0, 0, 0)
    let addr = SocketAddrV4::new(ip, 0)
    expect_eq(addr.port(), 0, "port should be 0")
}

@test("SocketAddrV4 with max port")
pub fn test_socket_addr_port_max() {
    let ip = Ipv4Addr::localhost()
    let addr = SocketAddrV4::new(ip, 65535)
    expect_eq(addr.port(), 65535, "port should be 65535")
}

@test("SocketAddrV4 common ports")
pub fn test_socket_addr_common_ports() {
    let ip = Ipv4Addr::new(8, 8, 8, 8)

    let http = SocketAddrV4::new(ip, 80)
    expect_eq(http.port(), 80, "HTTP port")

    let https = SocketAddrV4::new(ip, 443)
    expect_eq(https.port(), 443, "HTTPS port")

    let ssh = SocketAddrV4::new(ip, 22)
    expect_eq(ssh.port(), 22, "SSH port")
}

