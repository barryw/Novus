// Test PutMsg to a newly created port (not pr_MsgPort)

from amiga::raw::dos import VPrintf, Delay
from amiga::raw::exec import AllocMem, FreeMem, PutMsg, GetMsg, CreateMsgPort, DeleteMsgPort
from amiga::raw::consts import MEMF_PUBLIC, MEMF_CLEAR
from amiga::raw::structs import Message, MsgPort

pub fn main() -> i32 {
    VPrintf("1-START\n", (*u8)0)

    // Create a new message port
    let port = CreateMsgPort()
    if (u32)port == 0 {
        VPrintf("PORT FAIL\n", (*u8)0)
        return 1
    }

    var port_val: u32 = (u32)port
    VPrintf("PORT=%08lx\n", (*u8)&port_val)

    var sigbit: u32 = (u32)port.mp_SigBit
    VPrintf("SIGBIT=%ld\n", (*u8)&sigbit)

    // Allocate message
    let msg_size: u32 = 24
    let msg_mem = unsafe { AllocMem(msg_size, MEMF_PUBLIC | MEMF_CLEAR) }
    if (u32)msg_mem == 0 {
        VPrintf("ALLOC FAIL\n", (*u8)0)
        DeleteMsgPort(port)
        return 1
    }

    VPrintf("2-ALLOCATED\n", (*u8)0)

    let msg = (*Message)msg_mem
    msg.mn_Node.ln_Type = 5  // NT_MESSAGE
    msg.mn_ReplyPort = null
    msg.mn_Length = (u16)msg_size

    VPrintf("3-ABOUT TO PUTMSG\n", (*u8)0)

    // Put message to our NEW port (not pr_MsgPort)
    PutMsg(port, msg)

    VPrintf("4-PUTMSG DONE\n", (*u8)0)
    Delay(10)
    VPrintf("5-DELAY OK\n", (*u8)0)

    // Get the message back
    let got_msg = GetMsg(port)
    var got_val: u32 = (u32)got_msg
    VPrintf("GOT=%08lx\n", (*u8)&got_val)

    // Free the message
    unsafe {
        FreeMem(msg_mem, msg_size)
    }

    // Delete the port
    DeleteMsgPort(port)

    VPrintf("6-DONE\n", (*u8)0)
    return 0
}
