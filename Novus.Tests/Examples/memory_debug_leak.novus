// Example: Memory Leak Detection
//
// Description:
//   Demonstrates memory leak detection in debug builds.
//   Allocates memory but intentionally doesn't free it.
//   When compiled with --safety-level 2 or 3, an Amiga system
//   requester will appear on exit showing the leak with source
//   file and line number.
//
// Build:
//   novus compile memory_debug_leak.novus --safety-level 2
//
// Expected Behavior:
//   On exit, shows a requester:
//   "MEMORY LEAK: 256 bytes at 0xXXXXXX
//    Allocated at memory_debug_leak.novus:28
//    (allocation #1)"
//
// Exit code: 0

from amiga::raw::exec import AllocMem, FreeMem
from amiga::raw::consts import MEMF_ANY

pub fn main() -> i32 {
    unsafe {
        // Allocate memory - this will be tracked
        let ptr1 = AllocMem(256, MEMF_ANY)

        if ptr1 == null {
            return 1  // Allocation failed
        }

        // Write something to prove it's valid memory
        let byte_ptr: *u8 = (*u8)ptr1
        byte_ptr[0] = 42

        // Allocate more memory
        let ptr2 = AllocMem(128, MEMF_ANY)

        if ptr2 == null {
            FreeMem(ptr1, 256)
            return 1
        }

        // Free only the second allocation
        FreeMem(ptr2, 128)

        // INTENTIONAL BUG: ptr1 is never freed!
        // The memory debugger should catch this and report:
        // - Address where the leak occurred
        // - Size: 256 bytes
        // - Source location: memory_debug_leak.novus:28

        return 0
    }
}
