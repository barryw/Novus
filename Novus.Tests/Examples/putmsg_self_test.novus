// Test PutMsg to our own port - simplest possible case

from std::ffi::dos import VPrintf, Delay
from std::ffi::exec import AllocMem, FreeMem, PutMsg, GetMsg, FindTask
from std::ffi::amiga_consts import MEMF_PUBLIC, MEMF_CLEAR
from std::ffi::amiga_structs import Process, Message, MsgPort

pub fn main() -> i32 {
    VPrintf("1-START\n", (*u8)0)

    // Get our own Process structure
    let me = (*Process)FindTask(null)
    var me_val: u32 = (u32)me
    VPrintf("ME=%08lx\n", (*u8)&me_val)

    // Allocate message
    let msg_size: u32 = 24
    let msg_mem = unsafe { AllocMem(msg_size, MEMF_PUBLIC | MEMF_CLEAR) }
    if (u32)msg_mem == 0 {
        VPrintf("ALLOC FAIL\n", (*u8)0)
        return 1
    }

    VPrintf("2-ALLOCATED\n", (*u8)0)

    let msg = (*Message)msg_mem
    msg.mn_Node.ln_Type = 5  // NT_MESSAGE
    msg.mn_ReplyPort = null  // No reply expected
    msg.mn_Length = (u16)msg_size

    VPrintf("3-MSG SETUP\n", (*u8)0)

    // Get pointer to our own MsgPort
    let my_port = (*MsgPort)(*u8)&me.pr_MsgPort
    var port_val: u32 = (u32)my_port
    VPrintf("PORT=%08lx\n", (*u8)&port_val)

    VPrintf("4-ABOUT TO PUTMSG\n", (*u8)0)

    // Put message to our own port
    PutMsg(my_port, msg)

    VPrintf("5-PUTMSG DONE\n", (*u8)0)

    // Get the message back
    let got_msg = GetMsg(my_port)
    var got_val: u32 = (u32)got_msg
    VPrintf("GOT=%08lx\n", (*u8)&got_val)

    // Free the message
    unsafe {
        FreeMem(msg_mem, msg_size)
    }

    VPrintf("6-DONE\n", (*u8)0)
    return 0
}
