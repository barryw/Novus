// Test multiple Vec generic method instantiations
from std::collections::vec import Vec
from std::core import Result, Option

fn main() {
    // Create a Vec<u32> with capacity
    let vec_opt = Vec::<u32>::with_capacity(8)

    match vec_opt {
        Result::Ok(vec) => {
            var v = vec

            // Test push (returns Result)
            let _ = v.push(10)
            let _ = v.push(20)
            let _ = v.push(30)

            // Test pop (returns Option<T>)
            let popped = v.pop()

            // Test set (returns bool)
            let set_success = v.set(0, 100)

            // Test clear (returns void)
            v.clear()

            // Test is_empty (returns bool)
            let empty = v.is_empty()

            // Test capacity (returns u32)
            let cap = v.capacity()

            // Clean up
            v.drop()
        },
        Result::Err(_) => {
            let dummy = 0
        }
    }
}
