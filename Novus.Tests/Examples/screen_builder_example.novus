// Screen and Window Builder API Examples
// Demonstrates the fluent APIs for creating screens and windows
//
// Run: novus compile screen_builder_example.novus -o screen_builder --safety-level 0 -O2

from std::ui::screen import ScreenHandle, ScreenBuilder
from std::ui::window import WindowHandle, WindowBuilder
from std::ffi::dos import Delay
from std::ffi::graphics import SetAPen, RectFill, Move, Text
from std::ffi::amiga_consts import OSCAN_STANDARD

pub fn main() -> i32 {
    // =========================================================================
    // Example 1: Simple convenience constructor (easiest way)
    // =========================================================================
    // ScreenHandle::lores() creates a standard 320x256 PAL screen
    // The screen is automatically closed when it goes out of scope (RAII)

    let result1 = ScreenHandle::lores("Simple Lores Screen", 4)  // 16 colors
    match result1 {
        Result::Ok(screen1) => {
            // Draw something on the screen
            let rp = screen1.rastport()
            SetAPen(rp, 1)
            RectFill(rp, 10, 20, 100, 80)

            Delay(100)  // 2 seconds
            // Screen automatically closes here
        },
        Result::Err(_) => {
            return 1
        }
    }

    // =========================================================================
    // Example 2: ScreenBuilder fluent API (more control)
    // =========================================================================
    // Use ScreenBuilder when you need more options than convenience methods
    // Note: Method chaining must be on the same line in Novus

    let result2 = ScreenBuilder::new().title("Builder Demo").size(320, 256).depth(5).show_title(false).build()

    match result2 {
        Result::Ok(screen2) => {
            // Full-screen drawing without title bar interference
            let rp = screen2.rastport()

            // Draw a gradient of colors
            let mut y: i16 = 0
            while y < 256 {
                SetAPen(rp, (u32)(y / 8))  // Cycle through 32 colors
                RectFill(rp, 0, y, 319, y + 7)
                y = y + 8
            }

            Delay(100)
        },
        Result::Err(_) => {
            return 2
        }
    }

    // =========================================================================
    // Example 3: Hires screen
    // =========================================================================

    let result3 = ScreenHandle::hires("Workbench Clone", 2)  // 4 colors for hires
    match result3 {
        Result::Ok(screen3) => {
            let rp3 = screen3.rastport()

            // Draw something in hires
            SetAPen(rp3, 1)
            RectFill(rp3, 20, 20, 620, 30)

            Move(rp3, 250, 128)
            Text(rp3, "640x256 HiRes Mode", 18)

            Delay(100)
        },
        Result::Err(_) => {
            return 3
        }
    }

    // =========================================================================
    // Example 4: Screen with window
    // =========================================================================

    let result4 = ScreenHandle::lores("Screen With Window", 4)
    match result4 {
        Result::Ok(screen4) => {
            // Open a window on this screen using WindowBuilder
            let win_result4 = WindowBuilder::new().title("My Window").position(20, 20).size(200, 100).activate(true).screen(screen4.handle()).build()

            match win_result4 {
                Result::Ok(win4) => {
                    let rp4 = win4.rastport()
                    SetAPen(rp4, 2)
                    RectFill(rp4, 5, 15, 190, 90)
                    Delay(100)
                    // Window closes automatically (RAII)
                },
                Result::Err(_) => {
                    return 4
                }
            }
            // Screen closes automatically after window
        },
        Result::Err(_) => {
            return 4
        }
    }

    // =========================================================================
    // Example 5: WindowBuilder on Workbench
    // =========================================================================

    let win_result5 = WindowBuilder::new().title("WindowBuilder Demo").position(50, 50).size(300, 150).activate(true).build()

    match win_result5 {
        Result::Ok(win5) => {
            let rp5 = win5.rastport()
            SetAPen(rp5, 1)
            RectFill(rp5, 10, 20, 280, 130)
            Delay(100)
        },
        Result::Err(_) => {
            return 5
        }
    }

    // =========================================================================
    // Example 6: Interlaced screen (320x512 lores interlace)
    // =========================================================================

    let result6 = ScreenHandle::lores_lace("Interlace Demo", 4)
    match result6 {
        Result::Ok(screen6) => {
            let rp6 = screen6.rastport()

            // Draw bars across the full 512 pixel height
            let mut y6: i16 = 0
            while y6 < 512 {
                SetAPen(rp6, (u32)((y6 / 32) % 16))
                RectFill(rp6, 0, y6, 319, y6 + 31)
                y6 = y6 + 32
            }

            Delay(100)
        },
        Result::Err(_) => {
            return 6
        }
    }

    // All examples completed successfully!
    return 0
}
