// Test automatic string literal to reference coercion
// This should compile without errors

from std::ui::window import WindowHandle

pub fn main() -> i32 {
    // Before: had to write &"Novus Window"
    // Now: can write just "Novus Window" and it auto-coerces to &Str
    let result = WindowHandle::simple("Novus Window", 320, 200)

    return 0
}
