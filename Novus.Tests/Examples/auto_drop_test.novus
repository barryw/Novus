from std::collections import Vec
from std::io import WriteOut

fn test_auto_drop() -> i32 {
    // Create a Vec<i32> - drop() should be called automatically at end of scope
    let vec_opt: Option<Vec<i32>> = Vec::with_capacity(10u32)
    match vec_opt {
        Some(vec) => {
            var v: Vec<i32> = vec
            v.push(42i32)
            v.push(99i32)
            WriteOut("Pushed values\n")
            // drop() should be called automatically here!
            return 0
        },
        None => {
            WriteOut("Failed to allocate\n")
            return 1
        }
    }
}

fn main() -> i32 {
    WriteOut("Testing automatic drop...\n")
    let result = test_auto_drop()
    WriteOut("Test complete!\n")
    return result
}
