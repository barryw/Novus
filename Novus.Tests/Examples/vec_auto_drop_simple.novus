// Simpler test for automatic drop() - direct assignment
from std::collections import Vec

fn test_auto_drop() -> i32 {
    // Create an empty vec - no allocation, so can't fail
    var vec: Vec<i32> = Vec::new()

    // Compiler should auto-inject: defer vec.drop()

    // Try to push (will fail since no capacity, but that's ok)
    let success1 = vec.push(42i32)
    let success2 = vec.push(100i32)

    // Return based on whether pushes succeeded
    // (They won't since Vec is empty, but testing defer)
    if success1 && success2 {
        return 0
    } else {
        return 1
    }
    // vec.drop() should be called here automatically
}

fn main() -> i32 {
    return test_auto_drop()
}
