// Test passing String as parameter to non-FFI function

from dos import Output, Write

// Non-FFI function that takes String parameter
fn write_message(msg: String) -> i32 {
    let stdout = Output()
    if stdout == 0 {
        return -1
    }
    // Use String fields directly
    return Write(stdout, msg, msg.len)
}

pub fn main() -> u32 {
    let greeting = "Hello from String params!"

    // Pass String to our function (not FFI!)
    let result = write_message(greeting)

    return 0
}
