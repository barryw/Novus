// Test Result<T, E> with arbitrary struct types
// Verifies that Result can contain user-defined structs, not just primitives

from std::error import DosError

// Simple struct to test basic struct in Result
struct Point {
    x: i32,
    y: i32
}

// More complex struct with multiple fields
struct Rectangle {
    x: i32,
    y: i32,
    width: u32,
    height: u32
}

// Nested struct to test complex types
struct Color {
    r: u8,
    g: u8,
    b: u8
}

struct StyledRect {
    bounds: Rectangle,
    color: Color
}

// Test 1: Simple struct in Ok variant
fn create_point(x: i32, y: i32) -> Result<Point, DosError> {
    if x < 0 || y < 0 {
        return Result::Err(DosError::InvalidInput)
    }

    let p: Point = Point { x: x, y: y }
    return Result::Ok(p)
}

// Test 2: More complex struct in Ok variant
fn create_rectangle(x: i32, y: i32, w: u32, h: u32) -> Result<Rectangle, DosError> {
    if w == 0u32 || h == 0u32 {
        return Result::Err(DosError::InvalidInput)
    }

    let rect: Rectangle = Rectangle { x: x, y: y, width: w, height: h }
    return Result::Ok(rect)
}

// Test 3: Nested struct in Ok variant
fn create_styled_rect() -> Result<StyledRect, DosError> {
    let rect: Rectangle = Rectangle { x: 10, y: 20, width: 100u32, height: 50u32 }
    let color: Color = Color { r: 255u8, g: 128u8, b: 64u8 }
    let styled: StyledRect = StyledRect { bounds: rect, color: color }

    return Result::Ok(styled)
}

// Test 4: Function that extracts and uses struct fields from Result
fn calculate_area(result: Result<Rectangle, DosError>) -> i32 {
    match result {
        Ok(rect) => {
            // Extract struct from Result and use its fields
            let area: u32 = rect.width * rect.height
            return (i32)area
        },
        Err(err) => {
            return -1
        },
    }
}

pub fn main() -> i32 {
    // Test 1: Simple struct - success case
    let point_result = create_point(10, 20)
    match point_result {
        Ok(p) => {
            if p.x != 10 || p.y != 20 {
                return 1  // Failed: wrong point values
            }
        },
        Err(err) => {
            return 2  // Failed: expected Ok
        },
    }

    // Test 2: Simple struct - error case
    let point_err = create_point(-5, 10)
    match point_err {
        Ok(p) => {
            return 3  // Failed: expected Err
        },
        Err(err) => {
            // Success - got error as expected
            let check: i32 = 0
        },
    }

    // Test 3: Complex struct - success case
    let rect_result = create_rectangle(0, 0, 100u32, 50u32)
    match rect_result {
        Ok(rect) => {
            if rect.width != 100u32 || rect.height != 50u32 {
                return 4  // Failed: wrong rectangle dimensions
            }
        },
        Err(err) => {
            return 5  // Failed: expected Ok
        },
    }

    // Test 4: Complex struct - error case (zero width)
    let rect_err = create_rectangle(10, 20, 0u32, 50u32)
    match rect_err {
        Ok(rect) => {
            return 6  // Failed: expected Err
        },
        Err(err) => {
            // Success - got error as expected
            let check: i32 = 0
        },
    }

    // Test 5: Nested struct extraction
    let styled_result = create_styled_rect()
    match styled_result {
        Ok(styled) => {
            // Access nested struct fields
            if styled.bounds.width != 100u32 {
                return 7  // Failed: wrong width
            }
            if styled.color.r != 255u8 {
                return 8  // Failed: wrong color
            }
        },
        Err(err) => {
            return 9  // Failed: expected Ok
        },
    }

    // Test 6: Passing Result to function
    let rect_for_calc = create_rectangle(0, 0, 10u32, 20u32)
    let area = calculate_area(rect_for_calc)
    if area != 200 {
        return 10  // Failed: wrong area calculation
    }

    // Test 7: Passing error Result to function
    let rect_err_calc = create_rectangle(0, 0, 0u32, 20u32)
    let area_err = calculate_area(rect_err_calc)
    if area_err != -1 {
        return 11  // Failed: expected -1 for error case
    }

    return 0  // All tests passed!
}
