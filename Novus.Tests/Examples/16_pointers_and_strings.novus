// Pointers and String Literals Example
// Demonstrates pointer types (*T) and string literal support

// Example: Using pointers and strings
pub fn main() -> u32 {
    // String literals have type *u8 (pointer to u8)
    let greeting: *u8 = "Hello, Amiga!"
    let message: *u8 = "Novus supports pointers and strings!\n"

    // Pointers are 32-bit addresses on 68000
    let text: *u8 = "Testing escape sequences:\n\tTab\n\tNewline\n"

    // You can store string literals in variables
    let name: *u8 = "Novus"
    let version: *u8 = "0.1.0"

    // String literals with various content
    let path: *u8 = "sys:tools/commodities"
    let special: *u8 = "Quotes: \"hello\" and backslash: \\"

    return 42u32
}

// Note: To actually use strings with AmigaDOS, you would:
// 1. Declare extern DOS functions (dos_output, dos_write)
// 2. Link with dos_stubs.o for C calling convention wrappers
// 3. Use VBCC's startup.o and -lamiga for library management
