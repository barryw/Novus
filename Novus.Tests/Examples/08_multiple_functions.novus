// Example 08: Multiple Functions
// Demonstrates multiple function definitions

pub fn add(a: i32, b: i32) -> i32 {
    return a + b
}

pub fn subtract(a: i32, b: i32) -> i32 {
    return a - b
}

pub fn multiply(a: i32, b: i32) -> i32 {
    return a * b
}

pub fn main() -> u32 {
    return 42u32
}
