// Test spawning with data - add delay before PutMsg

from std::core import Result
from amiga::sys::dos::errors import DosError
from amiga::sys::exec import spawn_task_fn
from amiga::raw::dos import VPrintf, Delay
from amiga::raw::exec import AllocMem, FreeMem, PutMsg, MEMF_PUBLIC, MEMF_CLEAR
from amiga::raw::structs import Process, Message

fn worker() -> i32 {
    VPrintf("Worker: running\n", (*u8)0)
    // Wait a bit so parent can send message
    Delay(50)
    VPrintf("Worker: done\n", (*u8)0)
    return 0
}

pub fn main() -> i32 {
    VPrintf("Main: starting\n", (*u8)0)

    let data: *u8 = (*u8)12345

    VPrintf("Main: spawning worker\n", (*u8)0)

    // Use spawn_task_fn (no data) to get the handle
    let result = spawn_task_fn("DataWorker", worker, 8192)
    var process: *u8 = null

    match result {
        Result::Err(_) => {
            VPrintf("Main: spawn failed\n", (*u8)0)
            return 1
        },
        Result::Ok(handle) => {
            VPrintf("Main: spawn succeeded\n", (*u8)0)
            process = handle.process
        }
    }

    // Wait a bit to let child start
    VPrintf("Main: waiting for child to start\n", (*u8)0)
    Delay(10)

    // Now try to send message
    VPrintf("Main: allocating message\n", (*u8)0)
    let msg_size: u32 = 24  // sizeof(Message) + 4
    let msg_mem = unsafe { AllocMem(msg_size, MEMF_PUBLIC | MEMF_CLEAR) }
    if (u32)msg_mem == 0 {
        VPrintf("Main: alloc failed\n", (*u8)0)
        return 1
    }

    let msg = (*Message)msg_mem
    msg.mn_Node.ln_Type = 5  // NT_MESSAGE
    msg.mn_ReplyPort = null
    msg.mn_Length = (u16)msg_size

    VPrintf("Main: sending message\n", (*u8)0)
    let child_proc = (*Process)process
    PutMsg(&child_proc.pr_MsgPort, msg)

    VPrintf("Main: message sent\n", (*u8)0)

    // Give worker time to finish
    Delay(100)

    VPrintf("Main: done\n", (*u8)0)
    return 0
}
