// Example: Redeclaration Fix
//
// Description:
//   Tests that variable redeclaration in different scopes works correctly.
//
// Expected Output:
//   Exit code: 0

pub fn main() -> i32 {
    // Test 1: Boolean || with phi-style merge
    let a: bool = true
    let b: bool = false

    let result1: bool = a || b  // true || false = true
    if !result1 {
        return 1  // FAIL: Should be true
    }

    // Test 2: Boolean && with phi-style merge
    let c: bool = true
    let d: bool = true

    let result2: bool = c && d  // true && true = true
    if !result2 {
        return 2  // FAIL: Should be true
    }

    // Test 3: Nested || operations
    let e: bool = false
    let f: bool = false
    let g: bool = false

    let result3: bool = e || f || g  // false || false || false = false
    if result3 {
        return 3  // FAIL: Should be false
    }

    // All tests passed
    return 42
}
