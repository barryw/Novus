// Test PutMsg specifically

from std::core import Result
from std::error::errors import DosError
from std::os::task import spawn_task_fn
from std::ffi::dos import VPrintf, Delay
from std::ffi::exec import AllocMem, FreeMem, PutMsg, MEMF_PUBLIC, MEMF_CLEAR
from std::ffi::amiga_structs import Process, Message, MsgPort

fn worker() -> i32 {
    VPrintf("W-START\n", (*u8)0)
    Delay(100)
    VPrintf("W-END\n", (*u8)0)
    return 0
}

pub fn main() -> i32 {
    VPrintf("1-START\n", (*u8)0)
    Delay(25)

    let result = spawn_task_fn("Worker", worker, 8192)
    var process: *u8 = (*u8)0

    match result {
        Result::Err(_) => {
            VPrintf("ERR\n", (*u8)0)
            return 1
        },
        Result::Ok(handle) => {
            VPrintf("2-SPAWNED\n", (*u8)0)
            process = handle.process
        }
    }

    Delay(25)

    // Allocate message
    let msg_size: u32 = 24
    let msg_mem = unsafe { AllocMem(msg_size, MEMF_PUBLIC | MEMF_CLEAR) }
    if (u32)msg_mem == 0 {
        VPrintf("ALLOC FAIL\n", (*u8)0)
        return 1
    }

    VPrintf("3-ALLOCATED\n", (*u8)0)
    Delay(25)

    let msg = (*Message)msg_mem
    msg.mn_Node.ln_Type = 5
    msg.mn_ReplyPort = (*MsgPort)0
    msg.mn_Length = (u16)msg_size

    VPrintf("4-MSG SETUP\n", (*u8)0)
    Delay(25)

    let child_proc = (*Process)process

    VPrintf("5-ABOUT TO PUTMSG\n", (*u8)0)
    Delay(25)

    // THE CRASH POINT
    PutMsg(&child_proc.pr_MsgPort, msg)

    VPrintf("6-PUTMSG DONE\n", (*u8)0)
    Delay(150)

    VPrintf("7-DONE\n", (*u8)0)
    return 0
}
