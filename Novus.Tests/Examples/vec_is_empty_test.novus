from std::core import Vec

fn main() -> i32 {
    // Create empty vector
    var v: Vec<i32> = Vec::new()

    // Test: is_empty should return true (non-zero)
    let empty: bool = v.is_empty()

    // Return the boolean value directly (true = 1, false = 0)
    // We want to return non-zero for success
    if empty {
        return 42  // Success - is_empty returned true
    }

    return 1  // Failed - is_empty returned false
}
