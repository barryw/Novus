// Import System Example
// Demonstrates importing DOS library functions using the module system

from dos import Output, Write

pub fn main() -> i32 {
    // Get stdout handle
    let stdout: i32 = Output()

    // Write a message to stdout
    let message: *u8 = "Hello from the import system!\n"
    let length: i32 = 31i32  // Length of message

    Write(stdout, message, length)

    return 0
}
