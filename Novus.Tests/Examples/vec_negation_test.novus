from std::collections import Vec

fn main() -> i32 {
    // Create empty vector
    var v: Vec<i32> = Vec::new()

    // Test direct negation in conditional
    // If vector is empty (which it should be), !is_empty() returns false, skip the return 1
    // If vector is NOT empty, !is_empty() returns true, return 1 (error)
    if !v.is_empty() {
        return 1
    }

    // If we get here, the negation worked correctly!
    return 42
}
