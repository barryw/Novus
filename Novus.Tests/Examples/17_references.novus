// Example: References and Borrowing
// Demonstrates immutable and mutable references

// Function that reads a value through an immutable reference
fn read_value(x: &i32) -> i32 {
    return *x
}

// Function that increments a value through a mutable reference
fn increment(x: &mut i32) {
    var val = *x
    *x = val + 1
}

// Function that doubles a value through a mutable reference
fn double(x: &mut i32) {
    var val = *x
    *x = val * 2
}

pub fn main() -> i32 {
    var num = 42

    // Read using immutable reference
    var value1 = read_value(&num)

    // Modify using mutable reference
    increment(&mut num)

    // Read again
    var value2 = read_value(&num)

    // Double the value
    double(&mut num)

    // Final read
    var final_value = read_value(&num)

    // Should be: (42 + 1) * 2 = 86
    return final_value
}
