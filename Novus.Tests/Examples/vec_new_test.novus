// Test Vec::new() associated function
// Tests that generic associated functions work correctly

// Define a minimal Vec type for testing (no external dependencies)
pub struct TestVec<T> {
    ptr: *T,
    len: u32,
    capacity: u32,
}

impl<T> TestVec<T> {
    // Associated function (no self parameter)
    pub fn create_empty(ptr: *T) -> TestVec<T> {
        return TestVec {
            ptr: ptr,
            len: 0u32,
            capacity: 0u32,
        }
    }

    // Method (has self parameter)
    pub fn is_empty(&self) -> bool {
        return self.len == 0u32
    }

    // Method
    pub fn len(&self) -> u32 {
        return self.len
    }
}

fn main() -> i32 {
    // Create null pointer
    let null_ptr: *i32 = (*i32)0

    // Test associated function call with type inference
    var v: TestVec<i32> = TestVec::create_empty(null_ptr)

    // Verify it's empty
    if !v.is_empty() {
        return 1
    }

    // Verify length is zero
    if v.len() != 0u32 {
        return 2
    }

    // Success!
    return 42
}
