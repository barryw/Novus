// Vec<T> Demo - Tests dynamic arrays on the Amiga
// This example creates a vector of integers, manipulates it, and prints results

struct Vec<T> {
    ptr: *T,
    len: u32,
    capacity: u32,
}

impl<T> Vec<T> {
    // Create a new empty vector
    fn new() -> Vec<T> {
        return Vec::<T> {
            ptr: 0 as *T,
            len: 0u32,
            capacity: 0u32,
        }
    }

    // Create a vector with initial capacity
    fn with_capacity(capacity: u32) -> Vec<T> {
        // TODO: Allocate memory using Exec AllocMem
        let ptr: *T = 0 as *T  // Placeholder
        return Vec::<T> {
            ptr: ptr,
            len: 0u32,
            capacity: capacity,
        }
    }

    // Get current length
    fn len(&self) -> u32 {
        return self.len
    }

    // Check if empty
    fn is_empty(&self) -> bool {
        return self.len == 0u32
    }

