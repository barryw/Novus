// Prime Sieve - Find all primes up to 10,000
// Real stress test with substantial computation
// Uses Sieve of Eratosthenes algorithm

from std::io import write
from std::strings import Str
from std::collections import Vec

pub fn main() -> i32 {
    let max: u32 = 10000

    write("========================================\n")
    write("Prime Sieve: Finding primes up to %ld\n", max)
    write("========================================\n\n")

    // Allocate sieve array
    write("Allocating sieve array (%ld bytes)...\n", max + 1)
    var sieve = Vec::<bool>::new()

    // Initialize all as potentially prime
    var i: u32 = 0
    while i <= max {
        sieve.push(true)
        i = i + 1
    }

    write("Sieve allocated successfully\n")
    write("Running Sieve of Eratosthenes...\n\n")

    // 0 and 1 are not prime
    sieve.set(0, false)
    sieve.set(1, false)

    // Run the sieve algorithm
    var p: u32 = 2
    while p * p <= max {
        let ptr = sieve.as_ptr()
        let is_prime = ptr[p]
        let check = (u32)is_prime
        if check != 0 {
            // Mark all multiples of p as composite
            var multiple: u32 = p * p
            while multiple <= max {
                sieve.set(multiple, false)
                multiple = multiple + p
            }
        }
        p = p + 1
    }

    write("Sieve complete! Counting primes...\n\n")

    // Count and display primes
    var prime_count: u32 = 0
    var line_count: u32 = 0

    i = 2
    while i <= max {
        let data = sieve.as_ptr()
        let val = data[i]
        let is_prime_val = (u32)val
        if is_prime_val != 0 {
            write("%ld ", i)
            prime_count = prime_count + 1
            line_count = line_count + 1

            // Print newline every 10 primes for readability
            if line_count >= 10 {
                write("\n")
                line_count = 0
            }
        }
        i = i + 1
    }

    write("\n\n========================================\n")
    write("Total primes found: %ld\n", prime_count)
    write("Largest number checked: %ld\n", max)
    write("========================================\n")

    return 0
}
