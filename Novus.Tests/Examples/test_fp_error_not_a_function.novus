// Test error message: passing a non-function where function pointer expected

fn apply_operation(x: i32, y: i32, op: fn(i32, i32) -> i32) -> i32 {
    return op(x, y)
}

fn main() -> i32 {
    let some_number = 42

    // ERROR: some_number is i32, not a function
    let result = apply_operation(10, 5, some_number)
    return result
}
