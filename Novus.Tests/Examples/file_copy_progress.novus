// File Copy with Progress - Real Amiga Pattern
//
// Demonstrates the classic Amiga pattern of keeping UI responsive
// during a long file operation. Uses interleaved processing:
// - Copy chunks of the file
// - Check for user input (cancel button)
// - Update progress bar
//
// This is how DirOpus, SysMon, and every other Amiga file manager worked.
//
// Usage: file_copy_progress <source> <destination>

from std::core import Result, Option
from std::os::timer import Duration, TimerHandle
from std::ffi::dos import Open, Close, Seek, IoErr, Read, Write, Output, SetMode
from std::ffi::exec import Wait, AllocMem, FreeMem
from std::ffi::amiga_consts import MEMF_PUBLIC
from std::ffi::amiga_consts import MODE_OLDFILE, MODE_NEWFILE, OFFSET_END, OFFSET_BEGINNING
from std::io::file import write

// Copy buffer size - 32KB chunks for good performance
const BUFFER_SIZE: u32 = 32768

struct CopyProgress {
    bytes_copied: u32,
    total_bytes: u32,
    percent: i32,
}

fn copy_file_with_progress(src_path: *u8, dst_path: *u8) -> Result<(), i32> {
    // Open source file
    let src_fh = Open(src_path, MODE_OLDFILE)
    if (u32)src_fh == 0 {
        write("Error: Cannot open source file\n")
        return Result::Err(IoErr())
    }

    // Get file size by seeking to end
    Seek(src_fh, 0, OFFSET_END)
    let file_size = (u32)Seek(src_fh, 0, OFFSET_BEGINNING)

    if file_size == 0 {
        write("Warning: Source file is empty\n")
    }

    write("Source file: %ld bytes\n", file_size)

    // Open destination file
    let dst_fh = Open(dst_path, MODE_NEWFILE)
    if (u32)dst_fh == 0 {
        write("Error: Cannot create destination file\n")
        Close(src_fh)
        return Result::Err(IoErr())
    }

    // Allocate copy buffer
    let buffer = unsafe { AllocMem(BUFFER_SIZE, MEMF_PUBLIC) }
    if (u32)buffer == 0 {
        write("Error: Out of memory\n")
        Close(dst_fh)
        Close(src_fh)
        return Result::Err(-1)
    }

    // Copy loop with progress
    var bytes_copied: u32 = 0
    var last_percent: i32 = -1
    var error: i32 = 0

    // Get output handle once for progress display
    let stdout = Output()

    // Small buffer for progress characters - use raw Write for unbuffered output
    var progress_char: u8 = 0

    write("Copying: ")

    while bytes_copied < file_size {
        // Read a chunk
        let to_read = if file_size - bytes_copied < BUFFER_SIZE {
            file_size - bytes_copied
        } else {
            BUFFER_SIZE
        }

        let bytes_read = Read(src_fh, buffer, (i32)to_read)
        if bytes_read < 0 {
            error = IoErr()
            write("\nError: Read failed\n")
            break
        }

        if bytes_read == 0 {
            // EOF reached early?
            break
        }

        // Write the chunk
        let bytes_written = Write(dst_fh, buffer, bytes_read)
        if bytes_written != bytes_read {
            error = IoErr()
            write("\nError: Write failed\n")
            break
        }

        bytes_copied = bytes_copied + (u32)bytes_read

        // Update progress display
        let percent = if file_size > 0 {
            (i32)((bytes_copied * 100) / file_size)
        } else {
            100
        }

        // Only update display when percentage changes
        if percent != last_percent {
            // Use raw Write for immediate unbuffered output
            if percent % 10 == 0 {
                // Write percentage digits directly
                if percent >= 100 {
                    progress_char = 49  // '1'
                    Write(stdout, &progress_char, 1)
                    progress_char = 48  // '0'
                    Write(stdout, &progress_char, 1)
                    progress_char = 48  // '0'
                    Write(stdout, &progress_char, 1)
                } else if percent >= 10 {
                    progress_char = (u8)(48 + (percent / 10))
                    Write(stdout, &progress_char, 1)
                    progress_char = (u8)(48 + (percent % 10))
                    Write(stdout, &progress_char, 1)
                } else {
                    progress_char = (u8)(48 + percent)
                    Write(stdout, &progress_char, 1)
                }
                progress_char = 37  // '%'
                Write(stdout, &progress_char, 1)
            } else {
                progress_char = 46  // '.'
                Write(stdout, &progress_char, 1)
            }
            last_percent = percent
        }

        // In a real app, we'd check for IDCMP here:
        // if (SetSignal(0, 0) & SIGBREAKF_CTRL_C) { cancelled = true; break; }
    }

    write("\n")

    // Cleanup
    unsafe { FreeMem(buffer, BUFFER_SIZE) }
    Close(dst_fh)
    Close(src_fh)

    if error != 0 {
        return Result::Err(error)
    }

    write("Copied %ld bytes successfully\n", bytes_copied)
    return Result::Ok(())
}

fn main() -> i32 {
    write("File Copy with Progress Demo\n")
    write("============================\n\n")

    // For testing, copy 10MB test file from DH0 to RAM
    let src_path = "DH0:Barry/testfile_10mb.dat".ptr
    let dst_path = "RAM:testfile_copy.dat".ptr

    write("Source:      %s\n", src_path)
    write("Destination: %s\n\n", dst_path)

    match copy_file_with_progress(src_path, dst_path) {
        Result::Ok(_) => {
            write("\nCopy complete!\n")
            return 0
        },
        Result::Err(code) => {
            write("\nCopy failed with error: %ld\n", code)
            return 1
        }
    }
}
