// Example 09: Function Calls
// Demonstrates calling functions with arguments

pub fn add(a: i32, b: i32) -> i32 {
    return a + b
}

pub fn subtract(a: i32, b: i32) -> i32 {
    return a - b
}

pub fn multiply(a: i32, b: i32) -> i32 {
    return a * b
}

pub fn compute(x: i32, y: i32) -> i32 {
    return add(multiply(x, y), subtract(x, y))
}

pub fn main() -> u32 {
    return (i32)compute(10, 5)
}
