from std::collections import Vec
from std::io import println

fn test_single_vec() -> i32 {
    let vec_opt = Vec::with_capacity(10u32)
    match vec_opt {
        Some(vec) => {
            // Compiler auto-injects: defer vec.drop()
            // Vec is mutable through pattern binding
            vec.push(42)
            vec.push(100)
            println("Vec created and populated")
            return 0
            // vec.drop() should be called here in generated C
        },
        None => {
            println("Failed to allocate Vec")
            return 1
        }
    }
}

fn test_two_vecs() -> i32 {
    let vec1_opt = Vec::with_capacity(5u32)
    match vec1_opt {
        Some(vec1) => {
            // Compiler auto-injects: defer vec1.drop()
            vec1.push(1)

            let vec2_opt = Vec::with_capacity(5u32)
            match vec2_opt {
                Some(vec2) => {
                    // Compiler auto-injects: defer vec2.drop()
                    vec2.push(2)
                    println("Two Vecs created")
                    return 0
                    // Should cleanup: vec2.drop(), then vec1.drop()
                },
                None => {
                    println("Failed to allocate vec2")
                    return 1
                    // Should cleanup: vec1.drop()
                }
            }
        },
        None => {
            println("Failed to allocate vec1")
            return 1
        }
    }
}

fn main() -> i32 {
    println("Testing single Vec...")
    let result1 = test_single_vec()

    println("Testing two Vecs...")
    let result2 = test_two_vecs()

    if result1 == 0 && result2 == 0 {
        println("All tests passed!")
        return 0
    } else {
        println("Some tests failed")
        return 1
    }
}
