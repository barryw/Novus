from amiga::raw::structs import timeval
from amiga::raw::resources::battclock import ReadBattClock
from amiga::raw::devices::timer import CmpTime

pub fn main() -> i32 {
    var now = timeval { tv_secs: 0, tv_micro: 0 }
    let comparison = unsafe { CmpTime(&now, &now) }
    let clock = unsafe { ReadBattClock() }
    return comparison + (i32)(clock & 0)
}
