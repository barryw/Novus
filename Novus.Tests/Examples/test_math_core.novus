// Test std::math::core assembly functions
from std::math::core import abs_i32, abs_i16, min_i32, max_i32, min_u32, max_u32
from std::math::core import clamp_i32, clamp_u32, sign_i32
from std::math::core import is_power_of_two_u32, next_power_of_two_u32
from std::math::core import div_ceil_u32, div_round_u32
from std::math::core import diff_i32, diff_u32
from std::test::test import expect_eq, expect_true, expect_false

// ============================================================================
// Absolute Value Tests
// ============================================================================

@test
pub fn test_abs_i32_positive() {
    expect_eq(abs_i32(42), 42, "abs of positive")
}

@test
pub fn test_abs_i32_negative() {
    expect_eq(abs_i32(-42), 42, "abs of negative")
}

@test
pub fn test_abs_i32_zero() {
    expect_eq(abs_i32(0), 0, "abs of zero")
}

// ============================================================================
// Min/Max Tests (Signed)
// ============================================================================

@test
pub fn test_min_i32() {
    expect_eq(min_i32(5, 10), 5, "min(5, 10)")
    expect_eq(min_i32(10, 5), 5, "min(10, 5)")
    expect_eq(min_i32(-5, 5), -5, "min(-5, 5)")
}

@test
pub fn test_max_i32() {
    expect_eq(max_i32(5, 10), 10, "max(5, 10)")
    expect_eq(max_i32(10, 5), 10, "max(10, 5)")
    expect_eq(max_i32(-5, 5), 5, "max(-5, 5)")
}

// ============================================================================
// Min/Max Tests (Unsigned)
// ============================================================================

@test
pub fn test_min_u32() {
    expect_eq(min_u32(5u32, 10u32), 5u32, "min(5, 10) unsigned")
    expect_eq(min_u32(10u32, 5u32), 5u32, "min(10, 5) unsigned")
}

@test
pub fn test_max_u32() {
    expect_eq(max_u32(5u32, 10u32), 10u32, "max(5, 10) unsigned")
    expect_eq(max_u32(10u32, 5u32), 10u32, "max(10, 5) unsigned")
}

// ============================================================================
// Clamp Tests
// ============================================================================

@test
pub fn test_clamp_i32_in_range() {
    expect_eq(clamp_i32(5, 0, 10), 5, "clamp in range")
}

@test
pub fn test_clamp_i32_below_min() {
    expect_eq(clamp_i32(-5, 0, 10), 0, "clamp below min")
}

@test
pub fn test_clamp_i32_above_max() {
    expect_eq(clamp_i32(15, 0, 10), 10, "clamp above max")
}

@test
pub fn test_clamp_u32() {
    expect_eq(clamp_u32(5u32, 0u32, 10u32), 5u32, "clamp_u32 in range")
    expect_eq(clamp_u32(15u32, 0u32, 10u32), 10u32, "clamp_u32 above max")
}

// ============================================================================
// Sign Tests
// ============================================================================

@test
pub fn test_sign_i32_positive() {
    expect_eq(sign_i32(42), 1, "sign of positive")
}

@test
pub fn test_sign_i32_negative() {
    expect_eq(sign_i32(-42), -1, "sign of negative")
}

@test
pub fn test_sign_i32_zero() {
    expect_eq(sign_i32(0), 0, "sign of zero")
}

// ============================================================================
// Power of Two Tests
// ============================================================================

@test
pub fn test_is_power_of_two_true() {
    expect_true(is_power_of_two_u32(1u32), "1 is power of two")
    expect_true(is_power_of_two_u32(2u32), "2 is power of two")
    expect_true(is_power_of_two_u32(4u32), "4 is power of two")
    expect_true(is_power_of_two_u32(256u32), "256 is power of two")
}

@test
pub fn test_is_power_of_two_false() {
    expect_false(is_power_of_two_u32(0u32), "0 is not power of two")
    expect_false(is_power_of_two_u32(3u32), "3 is not power of two")
    expect_false(is_power_of_two_u32(5u32), "5 is not power of two")
    expect_false(is_power_of_two_u32(100u32), "100 is not power of two")
}

@test
pub fn test_next_power_of_two() {
    expect_eq(next_power_of_two_u32(0u32), 0u32, "next_power_of_two(0)")
    expect_eq(next_power_of_two_u32(1u32), 1u32, "next_power_of_two(1)")
    expect_eq(next_power_of_two_u32(3u32), 4u32, "next_power_of_two(3)")
    expect_eq(next_power_of_two_u32(5u32), 8u32, "next_power_of_two(5)")
    expect_eq(next_power_of_two_u32(17u32), 32u32, "next_power_of_two(17)")
}

// ============================================================================
// Division Rounding Tests
// ============================================================================

@test
pub fn test_div_ceil_u32() {
    expect_eq(div_ceil_u32(10u32, 3u32), 4u32, "ceil(10/3) = 4")
    expect_eq(div_ceil_u32(9u32, 3u32), 3u32, "ceil(9/3) = 3")
    expect_eq(div_ceil_u32(11u32, 3u32), 4u32, "ceil(11/3) = 4")
}

@test
pub fn test_div_round_u32() {
    expect_eq(div_round_u32(10u32, 3u32), 3u32, "round(10/3) = 3")
    expect_eq(div_round_u32(11u32, 3u32), 4u32, "round(11/3) = 4")
    expect_eq(div_round_u32(10u32, 4u32), 3u32, "round(10/4) = 3")
}

// ============================================================================
// Difference Tests
// ============================================================================

@test
pub fn test_diff_i32() {
    expect_eq(diff_i32(10, 3), 7, "diff(10, 3)")
    expect_eq(diff_i32(3, 10), 7, "diff(3, 10)")
    expect_eq(diff_i32(-5, 5), 10, "diff(-5, 5)")
}

@test
pub fn test_diff_u32() {
    expect_eq(diff_u32(10u32, 3u32), 7u32, "diff(10, 3) unsigned")
    expect_eq(diff_u32(3u32, 10u32), 7u32, "diff(3, 10) unsigned")
}
