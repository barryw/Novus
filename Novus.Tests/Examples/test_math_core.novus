// Test suite for std::math::core
// Updated to use function overloading - all suffixed functions renamed to base names

from std::math::core import *
from std::test::test import expect_eq, expect_true, expect_false

// ============================================================================
// Absolute Value Tests
// ============================================================================

@test
pub fn test_abs_i32_positive() {
    expect_eq(abs_i32(42), 42, "abs of positive should be unchanged")
}

@test
pub fn test_abs_i32_negative() {
    expect_eq(abs_i32(-42), 42, "abs of negative should be positive")
}

@test
pub fn test_abs_i32_zero() {
    expect_eq(abs_i32(0), 0, "abs of zero should be zero")
}

@test
pub fn test_abs_i16_positive() {
    expect_eq((i32)abs(100i16), 100, "abs i16 positive")
}

@test
pub fn test_abs_i16_negative() {
    expect_eq((i32)abs(-100i16), 100, "abs i16 negative")
}

@test
pub fn test_abs_i8_positive() {
    expect_eq((i32)abs(50i8), 50, "abs i8 positive")
}

@test
pub fn test_abs_i8_negative() {
    expect_eq((i32)abs(-50i8), 50, "abs i8 negative")
}

// ============================================================================
// Minimum Tests
// ============================================================================

@test
pub fn test_min_i32_first_smaller() {
    expect_eq(min_i32(5, 10), 5, "min should return first when smaller")
}

@test
pub fn test_min_i32_second_smaller() {
    expect_eq(min_i32(10, 5), 5, "min should return second when smaller")
}

@test
pub fn test_min_i32_equal() {
    expect_eq(min_i32(7, 7), 7, "min of equals should return value")
}

@test
pub fn test_min_i32_negative() {
    expect_eq(min_i32(-5, -10), -10, "min of negatives")
}

@test
pub fn test_min_u32() {
    expect_eq((i32)min(100u32, 200u32), 100, "min u32")
}

@test
pub fn test_min_u16() {
    expect_eq((i32)min(50u16, 30u16), 30, "min u16")
}

// ============================================================================
// Maximum Tests
// ============================================================================

@test
pub fn test_max_i32_first_larger() {
    expect_eq(max_i32(10, 5), 10, "max should return first when larger")
}

@test
pub fn test_max_i32_second_larger() {
    expect_eq(max_i32(5, 10), 10, "max should return second when larger")
}

@test
pub fn test_max_i32_equal() {
    expect_eq(max_i32(7, 7), 7, "max of equals should return value")
}

@test
pub fn test_max_i32_negative() {
    expect_eq(max_i32(-5, -10), -5, "max of negatives")
}

@test
pub fn test_max_u32() {
    expect_eq((i32)max(100u32, 200u32), 200, "max u32")
}

// ============================================================================
// Clamp Tests
// ============================================================================

@test
pub fn test_clamp_i32_within_range() {
    expect_eq(clamp_i32(50, 0, 100), 50, "clamp within range unchanged")
}

@test
pub fn test_clamp_i32_below_min() {
    expect_eq(clamp_i32(-10, 0, 100), 0, "clamp below min returns min")
}

@test
pub fn test_clamp_i32_above_max() {
    expect_eq(clamp_i32(150, 0, 100), 100, "clamp above max returns max")
}

@test
pub fn test_clamp_i32_at_min() {
    expect_eq(clamp_i32(0, 0, 100), 0, "clamp at min boundary")
}

@test
pub fn test_clamp_i32_at_max() {
    expect_eq(clamp_i32(100, 0, 100), 100, "clamp at max boundary")
}

@test
pub fn test_clamp_u32() {
    expect_eq((i32)clamp(500u32, 100u32, 200u32), 200, "clamp u32 above max")
}

// ============================================================================
// Sign Tests
// ============================================================================

@test
pub fn test_sign_i32_positive() {
    expect_eq(sign_i32(42), 1, "sign of positive is 1")
}

@test
pub fn test_sign_i32_negative() {
    expect_eq(sign_i32(-42), -1, "sign of negative is -1")
}

@test
pub fn test_sign_i32_zero() {
    expect_eq(sign_i32(0), 0, "sign of zero is 0")
}

@test
pub fn test_sign_i16_positive() {
    expect_eq((i32)sign(100i16), 1, "sign i16 positive")
}

@test
pub fn test_sign_i16_negative() {
    expect_eq((i32)sign(-100i16), -1, "sign i16 negative")
}

// ============================================================================
// Power of Two Tests
// ============================================================================

@test
pub fn test_is_power_of_two_u32_true() {
    expect_true(is_power_of_two(1u32), "1 is power of two")
    expect_true(is_power_of_two(2u32), "2 is power of two")
    expect_true(is_power_of_two(4u32), "4 is power of two")
    expect_true(is_power_of_two(256u32), "256 is power of two")
    expect_true(is_power_of_two(65536u32), "65536 is power of two")
}

@test
pub fn test_is_power_of_two_u32_false() {
    expect_false(is_power_of_two(0u32), "0 is not power of two")
    expect_false(is_power_of_two(3u32), "3 is not power of two")
    expect_false(is_power_of_two(5u32), "5 is not power of two")
    expect_false(is_power_of_two(100u32), "100 is not power of two")
}

@test
pub fn test_next_power_of_two_u32() {
    expect_eq((i32)next_power_of_two(1u32), 1, "next_pow2(1) = 1")
    expect_eq((i32)next_power_of_two(3u32), 4, "next_pow2(3) = 4")
    expect_eq((i32)next_power_of_two(5u32), 8, "next_pow2(5) = 8")
    expect_eq((i32)next_power_of_two(17u32), 32, "next_pow2(17) = 32")
    expect_eq((i32)next_power_of_two(256u32), 256, "next_pow2(256) = 256")
}

@test
pub fn test_next_power_of_two_u16() {
    expect_eq((i32)next_power_of_two(100u16), 128, "next_pow2_u16(100) = 128")
}

// ============================================================================
// Division Tests
// ============================================================================

@test
pub fn test_div_ceil_u32() {
    expect_eq((i32)div_ceil(10u32, 3u32), 4, "10/3 ceil = 4")
    expect_eq((i32)div_ceil(9u32, 3u32), 3, "9/3 ceil = 3")
    expect_eq((i32)div_ceil(1u32, 4u32), 1, "1/4 ceil = 1")
}

@test
pub fn test_div_round_u32() {
    expect_eq((i32)div_round(10u32, 3u32), 3, "10/3 round = 3")
    expect_eq((i32)div_round(11u32, 3u32), 4, "11/3 round = 4")
    expect_eq((i32)div_round(5u32, 2u32), 3, "5/2 round = 3")
}

// ============================================================================
// Difference Tests
// ============================================================================

@test
pub fn test_diff_u32() {
    expect_eq((i32)diff(10u32, 3u32), 7, "diff(10i32, 3i32) = 7")
    expect_eq((i32)diff(3u32, 10u32), 7, "diff(3i32, 10i32) = 7")
    expect_eq((i32)diff(5u32, 5u32), 0, "diff(5i32, 5i32) = 0")
}

@test
pub fn test_diff_i32() {
    expect_eq(diff(10i32, 3i32), 7, "diff(10i32, 3i32) = 7")
    expect_eq(diff(-10, 3), 13, "diff(-10, 3) = 13")
    expect_eq(diff(-5, -10), 5, "diff(-5, -10) = 5")
}

