// Test basic Result<T, E> construction and pattern matching

from std::error import DosError

fn make_ok() -> Result<i32, DosError> {
    return Result::Ok(42)
}

fn make_err() -> Result<i32, DosError> {
    return Result::Err(DosError::InvalidInput)
}

pub fn main() -> i32 {
    // Test Ok variant
    let ok_result = make_ok()
    match ok_result {
        Ok(value) => {
            if value != 42 {
                return 1  // Failed: expected 42
            }
        },
        Err(err) => {
            return 2  // Failed: expected Ok
        },
    }

    // Test Err variant
    let err_result = make_err()
    match err_result {
        Ok(value) => {
            return 3  // Failed: expected Err
        },
        Err(err) => {
            // Success - got error as expected
            let check: i32 = 0
        },
    }

    return 0  // All tests passed
}
