from std::collections import Vec
from std::io import WriteOut

fn main() -> i32 {
    WriteOut("Testing automatic drop...\n")

    // Create a Vec - drop() should be called automatically at end of scope
    var vec: Vec<i32> = Vec::new()
    vec.push(42i32)
    vec.push(99i32)
    WriteOut("Pushed two values\n")

    // drop() should be called automatically here!
    WriteOut("Exiting (drop should have been called)\n")
    return 0
}
