// Example: Struct Literals
//
// Description:
//   Demonstrates struct initialization using field: value literal syntax.
//
// Expected Output:
//   Exit code: 0

struct Point {
    x: i32,
    y: i32,
}

fn make_point() -> Point {
    return Point {
        x: 10,
        y: 20,
    }
}

fn main() -> i32 {
    let p: Point = Point {
        x: 5,
        y: 10,
    }

    return p.x + p.y
}
