from std::collections import Vec

fn main() -> i32 {
    var v: Vec<i32> = Vec::new()

    // Call is_empty and see what we get back
    let result: bool = v.is_empty()

    // Just branch based on result
    // If empty (result = true), return 100
    // If not empty (result = false), return 200
    if result {
        return 100
    }
    return 200
}
