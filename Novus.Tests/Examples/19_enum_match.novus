// Example: Enums with Pattern Matching
//
// Description:
//   Demonstrates enum declarations with associated data and pattern matching
//   to destructure enum values.
//
// Expected Output:
//   Exit code: 0 (successful enum pattern matching)

enum Command {
    Quit,
    Move(i32, i32),
    Write(i32),
    ChangeColor(i32, i32, i32)
}

fn process_command(cmd: Command) -> i32 {
    match cmd {
        Command::Quit => {
            return 0
        },
        Command::Move(x, y) => {
            return x + y
        },
        Command::Write(text) => {
            return text
        },
        Command::ChangeColor(r, g, b) => {
            return r + g + b
        }
    }
}

pub fn main() -> i32 {
    // Test simple variant
    var quit_cmd = Command::Quit
    var result1 = process_command(quit_cmd)

    // Test variant with data
    var move_cmd = Command::Move(10, 20)
    var result2 = process_command(move_cmd)

    // Test another variant
    var write_cmd = Command::Write(42)
    var result3 = process_command(write_cmd)

    // Test variant with multiple fields
    var color_cmd = Command::ChangeColor(1, 2, 3)
    var result4 = process_command(color_cmd)

    // Verify results
    // result1 = 0, result2 = 30, result3 = 42, result4 = 6
    // Return 0 if all correct
    if result1 == 0 {
        if result2 == 30 {
            if result3 == 42 {
                if result4 == 6 {
                    return 0
                }
            }
        }
    }

    return 1
}
