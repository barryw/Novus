// Test: const fn (compile-time evaluated functions)
// Run with: novus test test_const_fn.novus
//
// This demonstrates the const fn feature for Novus.
// A const fn is a function that can be evaluated at compile-time when
// called with constant arguments. This enables compile-time computation
// for constants, array sizes, and other places that require constant values.

from std::test::test import expect_eq_i32, expect_true

// ============================================================================
// Const Function Definitions
// ============================================================================

// Simple const fn - pure arithmetic
// Note: "double" is a reserved C keyword, so we use "times_two" instead
const fn times_two(x: i32) -> i32 {
    return x * 2
}

// Const fn with multiple parameters
const fn add(a: i32, b: i32) -> i32 {
    return a + b
}

// Const fn with local variables
const fn complex_calc(x: i32) -> i32 {
    let doubled = x * 2
    let tripled = x * 3
    return doubled + tripled  // x * 5
}

// Const fn with conditionals
const fn max(a: i32, b: i32) -> i32 {
    if a > b {
        return a
    }
    return b
}

const fn min(a: i32, b: i32) -> i32 {
    if a < b {
        return a
    }
    return b
}

// Const fn calling another const fn
const fn times_four(x: i32) -> i32 {
    return times_two(times_two(x))
}

// Public const fn for library use
pub const fn clamp(value: i32, low: i32, high: i32) -> i32 {
    return min(max(value, low), high)
}

// Fibonacci (const fn can use recursion with bounded depth)
const fn fib(n: i32) -> i32 {
    if n <= 1 {
        return n
    }
    return fib(n - 1) + fib(n - 2)
}

// Absolute value
const fn abs(x: i32) -> i32 {
    if x < 0 {
        return -x
    }
    return x
}

// Power function (x^n for small n)
const fn pow(base: i32, exp: i32) -> i32 {
    if exp == 0 {
        return 1
    }
    if exp == 1 {
        return base
    }
    return base * pow(base, exp - 1)
}

// ============================================================================
// Compile-time evaluated constants using const fn
// ============================================================================

const WIDTH: i32 = 320
const HEIGHT: i32 = 200
const DOUBLED_WIDTH: i32 = times_two(WIDTH)    // = 640, evaluated at compile time
const BUFFER_SIZE: i32 = add(WIDTH, HEIGHT)    // = 520, evaluated at compile time
const FIB_8: i32 = fib(8)                      // = 21, compile-time recursive evaluation
const CLAMPED_VALUE: i32 = clamp(999, 0, 100)  // = 100, uses nested const fn calls

// ============================================================================
// Test Cases
// ============================================================================

@test("times_two multiplies by 2")
pub fn test_times_two() {
    expect_eq_i32(times_two(21), 42, "times_two(21)")
    expect_eq_i32(times_two(0), 0, "times_two(0)")
    expect_eq_i32(times_two(-5), -10, "times_two(-5)")
}

@test("add sums two numbers")
pub fn test_add() {
    expect_eq_i32(add(10, 20), 30, "add(10, 20)")
    expect_eq_i32(add(-5, 5), 0, "add(-5, 5)")
    expect_eq_i32(add(0, 0), 0, "add(0, 0)")
}

@test("complex_calc computes x * 5 using local variables")
pub fn test_complex_calc() {
    expect_eq_i32(complex_calc(10), 50, "complex_calc(10)")
    expect_eq_i32(complex_calc(1), 5, "complex_calc(1)")
    expect_eq_i32(complex_calc(0), 0, "complex_calc(0)")
}

@test("max returns the larger value")
pub fn test_max() {
    expect_eq_i32(max(15, 7), 15, "max(15, 7)")
    expect_eq_i32(max(7, 15), 15, "max(7, 15)")
    expect_eq_i32(max(5, 5), 5, "max(5, 5)")
    expect_eq_i32(max(-10, -5), -5, "max(-10, -5)")
}

@test("min returns the smaller value")
pub fn test_min() {
    expect_eq_i32(min(15, 7), 7, "min(15, 7)")
    expect_eq_i32(min(7, 15), 7, "min(7, 15)")
    expect_eq_i32(min(5, 5), 5, "min(5, 5)")
    expect_eq_i32(min(-10, -5), -10, "min(-10, -5)")
}

@test("times_four calls times_two twice")
pub fn test_times_four() {
    expect_eq_i32(times_four(5), 20, "times_four(5)")
    expect_eq_i32(times_four(1), 4, "times_four(1)")
    expect_eq_i32(times_four(0), 0, "times_four(0)")
}

@test("clamp restricts value to range [low, high]")
pub fn test_clamp() {
    expect_eq_i32(clamp(150, 0, 100), 100, "clamp above high")
    expect_eq_i32(clamp(-50, 0, 100), 0, "clamp below low")
    expect_eq_i32(clamp(50, 0, 100), 50, "clamp in range")
    expect_eq_i32(clamp(0, 0, 100), 0, "clamp at low")
    expect_eq_i32(clamp(100, 0, 100), 100, "clamp at high")
}

@test("fib computes Fibonacci numbers recursively")
pub fn test_fib() {
    expect_eq_i32(fib(0), 0, "fib(0)")
    expect_eq_i32(fib(1), 1, "fib(1)")
    expect_eq_i32(fib(2), 1, "fib(2)")
    expect_eq_i32(fib(5), 5, "fib(5)")
    expect_eq_i32(fib(10), 55, "fib(10)")
}

@test("abs returns absolute value")
pub fn test_abs() {
    expect_eq_i32(abs(-42), 42, "abs(-42)")
    expect_eq_i32(abs(42), 42, "abs(42)")
    expect_eq_i32(abs(0), 0, "abs(0)")
}

@test("pow computes base^exp")
pub fn test_pow() {
    expect_eq_i32(pow(2, 0), 1, "pow(2, 0)")
    expect_eq_i32(pow(2, 1), 2, "pow(2, 1)")
    expect_eq_i32(pow(2, 8), 256, "pow(2, 8)")
    expect_eq_i32(pow(3, 3), 27, "pow(3, 3)")
    expect_eq_i32(pow(10, 2), 100, "pow(10, 2)")
}

@test("compile-time constants are evaluated correctly")
pub fn test_compile_time_constants() {
    expect_eq_i32(WIDTH, 320, "WIDTH")
    expect_eq_i32(HEIGHT, 200, "HEIGHT")
    expect_eq_i32(DOUBLED_WIDTH, 640, "DOUBLED_WIDTH = times_two(320)")
    expect_eq_i32(BUFFER_SIZE, 520, "BUFFER_SIZE = add(320, 200)")
    expect_eq_i32(FIB_8, 21, "FIB_8 = fib(8)")
    expect_eq_i32(CLAMPED_VALUE, 100, "CLAMPED_VALUE = clamp(999, 0, 100)")
}

@test("const fn with comparison operators")
pub fn test_comparisons() {
    expect_true(max(10, 5) > min(10, 5), "max > min")
    expect_true(abs(-10) == abs(10), "abs symmetry")
    expect_true(times_two(5) == times_four(5) / 2, "times_two vs times_four")
}
