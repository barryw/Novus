// MUI Demo Application - Demonstrates the MUI builder API for Novus
from std::ui::mui import MUIAppBuilder, MUIGroupBuilder, MUIApp, MenuBuilder, MenuItemBuilder, MenuStrip
from std::ui::mui import MUITabsBuilder, set_attr, set_text, get_attr, make_button, make_text
from std::ui::mui import make_radio, make_progress, set_progress, app_busy
from std::ui::mui import MENU_NEW, MENU_OPEN, MENU_SAVE, MENU_QUIT, MENU_CUT, MENU_COPY, MENU_PASTE, MENU_ABOUT
from std::ffi::mui_tags import *
from std::ffi::exec import Wait

// Gadget IDs (app-specific)
const GAD_QUIT: u32 = 1
const GAD_BTN1: u32 = 10
const GAD_BTN2: u32 = 11
const GAD_SLIDER: u32 = 20
const GAD_CHECK: u32 = 21
const GAD_STRING: u32 = 22
const GAD_RADIO: u32 = 30
const GAD_PROGRESS: u32 = 40
const GAD_BUSY: u32 = 41

// MUI keeps this pointer array, so it must outlive build_advanced_tab().
static RADIO_ENTRIES: [*u8] = ["Option A", "Option B", "Option C", (*u8)0]

// Holds references to all gadgets needed for event handling
struct Gadgets {
    status_text: *u8,
    btn1: *u8,
    btn2: *u8,
    slider: *u8,
    checkbox: *u8,
    string_gad: *u8,
    radio: *u8,
    progress: *u8,
    busy_btn: *u8,
    quit_btn: *u8,
    window: *u8,
}

fn build_menustrip() -> *u8 {
    var menustrip = MenuBuilder::new()
    menustrip
        .menu("Project")
        .item("New", "N", MENU_NEW)
        .item("Open...", "O", MENU_OPEN)
        .item("Save", "S", MENU_SAVE)
        .separator()
        .item("Quit", "Q", MENU_QUIT)
    menustrip
        .menu("Edit")
        .item("Cut", "X", MENU_CUT)
        .item("Copy", "C", MENU_COPY)
        .item("Paste", "V", MENU_PASTE)
    menustrip
        .menu("Help")
        .item("About...", "?", MENU_ABOUT)
    return menustrip.build().ptr()
}

fn build_controls_tab(root: *MUIGroupBuilder) -> (*u8, *u8, *u8, *u8, *u8, *u8) {
    var controls = (*root).vgroup()
    controls
        .frame(MUIV_Frame_Group)
        .frame_title("Basic Controls")

    // Button row
    var btn_row = controls.hgroup()
    btn_row.same_size()
    let btn1 = btn_row.button(GAD_BTN1, "Button 1")
    let btn2 = btn_row.button(GAD_BTN2, "Button 2")
    controls.child(btn_row.build())

    // Slider row
    var slider_row = controls.hgroup()
    slider_row.label("Volume:")
    let slider = slider_row.slider(GAD_SLIDER, 0, 100, 50)
    controls.child(slider_row.build())

    // String input row
    var string_row = controls.hgroup()
    string_row.label("Name:")
    let string_gad = string_row.string(GAD_STRING, "Type here", 64)
    controls.child(string_row.build())

    // Checkbox
    let checkbox = controls.checkbox(GAD_CHECK, "Enable feature", false)

    return (controls.build(), btn1, btn2, slider, string_gad, checkbox)
}

fn build_advanced_tab(root: *MUIGroupBuilder) -> (*u8, *u8, *u8, *u8) {
    var advanced = (*root).vgroup()
    advanced.frame(MUIV_Frame_Group)
    advanced.frame_title("Advanced Controls")

    // Radio buttons
    advanced.label("Select an option:")
    let radio = make_radio(GAD_RADIO, &RADIO_ENTRIES[0], 0)
    advanced
        .child(radio)
        .hbar()

    // Progress bar
    advanced.label("Progress:")
    let progress = make_progress(GAD_PROGRESS, 100, true)
    advanced.child(progress)

    // Busy button
    var busy_row = advanced.hgroup()
    busy_row.hspace()
    let busy_btn = busy_row.button(GAD_BUSY, "Simulate Work")
    busy_row.hspace()
    advanced.child(busy_row.build())

    return (advanced.build(), radio, progress, busy_btn)
}

fn build_about_tab(root: *MUIGroupBuilder) -> *u8 {
    var about = (*root).vgroup()
    about
        .frame(MUIV_Frame_Group)
        .vspace()
    about.label("\033cMUI Demo for Novus")
    about.label("\033cVersion 1.3")
    about.vspace()
    about.label("\033cA modern language for classic Amigas")
    about.vspace()
    return about.build()
}

fn setup_notifications(app: *MUIApp, gadgets: *Gadgets) {
    (*app).on_close((*gadgets).window)
    (*app).on_button((*gadgets).btn1, GAD_BTN1)
    (*app).on_button((*gadgets).btn2, GAD_BTN2)
    (*app).on_button((*gadgets).quit_btn, GAD_QUIT)
    (*app).on_button((*gadgets).busy_btn, GAD_BUSY)
    (*app).on_slider((*gadgets).slider, GAD_SLIDER)
    (*app).on_checkbox((*gadgets).checkbox, GAD_CHECK)
    (*app).on_string((*gadgets).string_gad, GAD_STRING)
    (*app).notify_val((*gadgets).radio, MUIA_Radio_Active, MUIV_EveryTime, (*app).app_object(), MUIM_Application_ReturnID, GAD_RADIO)

    // Menu notifications
    (*app).on_menu(MENU_NEW)
    (*app).on_menu(MENU_OPEN)
    (*app).on_menu(MENU_SAVE)
    (*app).on_menu(MENU_QUIT)
    (*app).on_menu(MENU_CUT)
    (*app).on_menu(MENU_COPY)
    (*app).on_menu(MENU_PASTE)
    (*app).on_menu(MENU_ABOUT)
}

fn handle_event(id: u32, app: *MUIApp, gadgets: *Gadgets) -> bool {
    match id {
        GAD_QUIT | MENU_QUIT => return false,
        MENU_NEW => set_text((*gadgets).status_text, "Menu: New"),
        MENU_OPEN => set_text((*gadgets).status_text, "Menu: Open"),
        MENU_SAVE => set_text((*gadgets).status_text, "Menu: Save"),
        MENU_CUT => set_text((*gadgets).status_text, "Menu: Cut"),
        MENU_COPY => set_text((*gadgets).status_text, "Menu: Copy"),
        MENU_PASTE => set_text((*gadgets).status_text, "Menu: Paste"),
        GAD_BTN1 => set_text((*gadgets).status_text, "Button 1 clicked!"),
        GAD_BTN2 => set_text((*gadgets).status_text, "Button 2 clicked!"),
        GAD_SLIDER => set_text((*gadgets).status_text, "Slider moved!"),
        GAD_STRING => set_text((*gadgets).status_text, "Name entered!"),
        MENU_ABOUT => {
            (*app).request((*gadgets).window, "About".ptr, "MUI Demo\nWritten in Novus\n\nA modern language for classic Amigas".ptr, "OK".ptr)
        },
        GAD_CHECK => {
            let checked = get_attr((*gadgets).checkbox, MUIA_Selected, (*u32)0)
            set_text((*gadgets).status_text, if checked != 0 { "Feature enabled" } else { "Feature disabled" })
        },
        GAD_RADIO => {
            let sel = get_attr((*gadgets).radio, MUIA_Radio_Active, (*u32)0)
            set_text((*gadgets).status_text, if sel == 0 { "Selected: Option A" } else if sel == 1 { "Selected: Option B" } else { "Selected: Option C" })
        },
        GAD_BUSY => {
            set_text((*gadgets).status_text, "Working...")
            app_busy((*app).app_object(), true)
            var i: i32 = 0
            forever {
                if i > 100 { break }
                set_progress((*gadgets).progress, i)
                i = i + 10
            }
            app_busy((*app).app_object(), false)
            set_text((*gadgets).status_text, "Work complete!")
        },
        _ => {
            if id == (u32)MUIV_Application_ReturnID_Quit { return false }
        }
    }
    return true
}

fn run_event_loop(app: *MUIApp, gadgets: *Gadgets) {
    var signals: u32 = 0
    var running = true
    forever {
        if !running { break }
        let id = (*app).run_once(&signals)
        running = handle_event(id, app, gadgets)
        if running && signals != 0 { signals = Wait(signals) }
    }
}

fn main() -> i32 {
    // Build application
    var app_builder = MUIAppBuilder::new("MUI Demo")
    app_builder
        .author("Novus")
        .version("$VER: mui_demo 1.3 (12.12.2025)")
        .base("MUIDEMO")
        .menustrip(build_menustrip())

    // Build window
    var win_builder = app_builder.window("MUI Demo Window")
    win_builder.id($4D554944)
    var root = win_builder.vgroup()
    root.frame(MUIV_Frame_Group)

    // Status bar
    let status_text = make_text("Status: Ready")
    root.child(status_text)

    // Build tab pages
    var tabs = MUITabsBuilder::new(&app_builder)
    let (controls_page, btn1, btn2, slider, string_gad, checkbox) = build_controls_tab(&root)
    let (advanced_page, radio, progress, busy_btn) = build_advanced_tab(&root)
    let about_page = build_about_tab(&root)

    // Assemble tabs
    tabs
        .add_tab("Controls", controls_page)
        .add_tab("Advanced", advanced_page)
        .add_tab("About", about_page)
    root
        .child(tabs.build())
        .hbar()

    // Quit button
    var quit_row = root.hgroup()
    quit_row.hspace()
    let quit_btn = quit_row.button(GAD_QUIT, "Quit")
    quit_row.hspace()
    root.child(quit_row.build())

    // Finalize window and app
    win_builder.root(root.build())
    let window = win_builder.build()
    let app_result = app_builder.build()

    match app_result {
        Result::Ok(app) => {
            var gadgets = Gadgets {
                status_text: status_text,
                btn1: btn1,
                btn2: btn2,
                slider: slider,
                checkbox: checkbox,
                string_gad: string_gad,
                radio: radio,
                progress: progress,
                busy_btn: busy_btn,
                quit_btn: quit_btn,
                window: window,
            }

            setup_notifications(&app, &gadgets)
            app.open_window(window)
            run_event_loop(&app, &gadgets)
        },
        Result::Err(err) => return 20
    }
    return 0
}
