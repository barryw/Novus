// BufferedWindow Demo - Automatic Content Preservation
//
// Demonstrates:
// - BufferedWindow with automatic double buffering
// - Content preservation across window resize
// - Automatic refresh handling (no manual redraw on REFRESHWINDOW)
// - Drawing to off-screen buffer with DrawContext
//
// Try this:
// 1. Resize the window (shrink and expand)
// 2. Drag another window over this window
// 3. Move this window around
//
// The content (checkerboard pattern) is automatically preserved!

from std::ui::buffered_window import BufferedWindow
from std::ui::window import WindowEvent
from std::graphics::draw import DrawContext, DrawMode
from std::graphics::shapes import Rect
from std::io::file import write

/// Draw a checkerboard pattern to demonstrate content preservation.
///
/// This is called:
/// - Initially when window opens
/// - After window resize (to fill new dimensions)
fn draw_checkerboard(window: &BufferedWindow) {
    let result = window.draw_context()
    match result {
        Result::Ok(ctx) => {
            // Get buffer dimensions
            let (width, height) = window.buffer_size()

            // Clear to color 0 (background)
            ctx.clear(0)

            // Draw checkerboard (32×32 pixel squares)
            let square_size: i16 = 32
            var y: i16 = 0
            var row: i16 = 0

            while y < height {
                var x: i16 = 0
                var col: i16 = 0

                while x < width {
                    // Alternate colors based on row+col parity
                    let color: u8 = if (row + col) % 2 == 0 {
                        1  // Color 1 (white on default palette)
                    } else {
                        2  // Color 2 (black on default palette)
                    }

                    ctx.pen(color)

                    // Calculate square bounds (clipped to buffer size)
                    let x_max: i16 = if x + square_size - 1 < width {
                        x + square_size - 1
                    } else {
                        width - 1
                    }

                    let y_max: i16 = if y + square_size - 1 < height {
                        y + square_size - 1
                    } else {
                        height - 1
                    }

                    ctx.fill_rect(x, y, x_max, y_max)

                    x = x + square_size
                    col = col + 1
                }

                y = y + square_size
                row = row + 1
            }

            // Draw a border around the entire buffer (color 3)
            ctx.pen(3)
            ctx.outline_rect(0, 0, width - 1, height - 1)

            // Draw diagonal lines for visual reference
            ctx.pen(4)
            ctx.line(0, 0, width - 1, height - 1)
            ctx.line(0, height - 1, width - 1, 0)
        },
        Result::Err(_) => {
            write("ERROR: Failed to get draw context\n")
        }
    }
}

pub fn main() -> i32 {
    write("BufferedWindow Demo - Content Preservation\n")
    write("Resize the window and watch the content stay intact!\n\n")

    // Create buffered window (640×480 initial size)
    let result = BufferedWindow::new("Buffered Window Demo - Resize Me!", 640, 480)

    match result {
        Result::Ok(mut window) => {
            // Draw initial checkerboard
            write("Drawing initial checkerboard...\n")
            draw_checkerboard(&window)

            // Present buffer to screen
            let present_result = window.present()
            match present_result {
                Result::Ok(_) => {
                    write("Initial content displayed!\n\n")
                    write("Instructions:\n")
                    write("- Resize window: Content automatically preserved!\n")
                    write("- Drag another window over this one: Content restored!\n")
                    write("- Move window: No flicker!\n")
                    write("- Click close gadget to exit\n\n")
                },
                Result::Err(_) => {
                    write("ERROR: Failed to present buffer\n")
                    return 20
                }
            }

            // Event loop
            var event_count: i32 = 0
            forever {
                let event = window.wait_event()
                event_count = event_count + 1

                match event {
                    WindowEvent::Close => {
                        write("Close gadget clicked - exiting\n")
                        break
                    },
                    WindowEvent::Resize(new_width, new_height) => {
                        // Buffer automatically resized by wait_event()!
                        // We just need to redraw content and present
                        write("Window resized to {new_width}×{new_height}\n")
                        write("  → Buffer automatically resized\n")
                        write("  → Redrawing content...\n")

                        draw_checkerboard(&window)
                        let resize_present = window.present()
                        match resize_present {
                            Result::Ok(_) => {
                                write("  → Content redrawn and displayed!\n\n")
                            },
                            Result::Err(_) => {
                                write("  → ERROR: Failed to present after resize\n")
                            }
                        }
                    },
                    WindowEvent::Refresh(_) => {
                        // Refresh is AUTOMATICALLY handled by wait_event()!
                        // The buffer was already blitted to the window.
                        // Developer doesn't need to do anything.
                        write("Refresh event (auto-handled) - event #{event_count}\n")
                    },
                    WindowEvent::MouseButton(x, y, pressed) => {
                        if pressed {
                            // Draw a marker at mouse click position
                            let ctx_result = window.draw_context()
                            match ctx_result {
                                Result::Ok(ctx) => {
                                    ctx.pen(5)
                                    ctx.cross(x, y, 10)

                                    let click_present = window.present()
                                    match click_present {
                                        Result::Ok(_) => {
                                            write("Drew marker at ({x}, {y})\n")
                                        },
                                        Result::Err(_) => {}
                                    }
                                },
                                Result::Err(_) => {}
                            }
                        }
                    },
                    _ => {
                        // Ignore other events (but log them for debugging)
                        write("Event: {event} (event #{event_count})\n")
                    }
                }
            }

            write("\nTotal events processed: {event_count}\n")
            write("BufferedWindow automatically cleaned up (RAII)!\n")
            return 0
        },
        Result::Err(_) => {
            write("ERROR: Failed to open buffered window\n")
            return 20  // RETURN_FAIL
        }
    }
}
