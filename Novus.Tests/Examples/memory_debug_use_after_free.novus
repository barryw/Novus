// Example: Use-After-Free Detection
//
// Description:
//   Demonstrates automatic use-after-free detection in debug builds.
//   Allocates memory, frees it, then attempts to read from the memory.
//   The compiler automatically inserts UAF checks before pointer dereferences.
//
// Build:
//   novus compile memory_debug_use_after_free.novus --safety-level 3
//
// Expected Behavior:
//   Shows a dialog: "USE AFTER FREE DETECTED!"
//   with information about where the memory was allocated, freed,
//   and where the invalid access occurred.
//
// How it works:
//   In debug mode (--safety-level 3):
//   1. FreeMem doesn't actually release memory back to the OS
//   2. Memory is poisoned with 0xDE pattern
//   3. Memory is marked as "freed" in our tracking table
//   4. The compiler inserts __novus_check_ptr_access() before pointer dereferences
//   5. When you try to dereference freed memory, we detect it and show an error
//
// Exit code: 0 (if detection works, shows dialog first)

from amiga::raw::exec import AllocMem, FreeMem
from amiga::raw::consts import MEMF_ANY

pub fn main() -> i32 {
    unsafe {
        // Allocate a buffer - this will be tracked in debug mode
        let ptr = AllocMem(64, MEMF_ANY)

        if ptr == null {
            return 1  // Allocation failed
        }

        let byte_ptr: *u8 = (*u8)ptr

        // Write some data
        byte_ptr[0] = 42
        byte_ptr[1] = 123

        // Free the memory
        // In debug mode, this doesn't actually free - it poisons and tracks
        FreeMem(ptr, 64)

        // INTENTIONAL BUG: Use-after-free!
        // The compiler will automatically insert a check before this dereference.
        // This will trigger the USE AFTER FREE dialog with the exact line number!
        let value = byte_ptr[0]

        // Note: We won't reach here - the UAF check above will show the dialog
        // But if we did, this double-free would also be caught
        FreeMem(ptr, 64)

        return (i32)value
    }
}
