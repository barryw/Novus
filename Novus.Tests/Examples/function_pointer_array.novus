// Test function pointer arrays (dispatch tables)

fn op_add(a: i32, b: i32) -> i32 {
    return a + b;
}

fn op_sub(a: i32, b: i32) -> i32 {
    return a - b;
}

fn op_mul(a: i32, b: i32) -> i32 {
    return a * b;
}

fn op_div(a: i32, b: i32) -> i32 {
    return a / b;
}

fn main() -> i32 {
    // Array of function pointers (dispatch table)
    let operations: [4]fn(i32, i32) -> i32 = [op_add, op_sub, op_mul, op_div]

    let a = 20
    let b = 5

    // Call each operation
    let sum = operations[0](a, b)   // 20 + 5 = 25
    let diff = operations[1](a, b)  // 20 - 5 = 15
    let prod = operations[2](a, b)  // 20 * 5 = 100
    let quot = operations[3](a, b)  // 20 / 5 = 4

    // sum + diff + prod + quot = 25 + 15 + 100 + 4 = 144
    return sum + diff + prod + quot
}
