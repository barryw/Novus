// Enum examples - demonstrating Swift/Rust-style enums in Novus

// Simple enum (like Swift)
enum Color {
    Red,
    Green,
    Blue,
}

// Generic Option<T> type (like Swift's Optional)
enum Option<T> {
    Some(T),
    None,
}

// Generic Result<T, E> type (like Swift's Result)
enum Result<T, E> {
    Ok(T),
    Err(E),
}

// Error type
enum IoError {
    NotFound,
    PermissionDenied,
    InvalidInput,
}

fn test_option() -> i32 {
    let some_value: Option<i32> = Option::Some(42);
    let no_value: Option<i32> = Option::None;

    // Match expression (like Swift's switch)
    match some_value {
        Option::Some(x) => {
            return x;
        },
        Option::None => {
            return 0;
        },
    }
}

fn test_result() -> i32 {
    let success: Result<i32, IoError> = Result::Ok(100);
    let failure: Result<i32, IoError> = Result::Err(IoError::NotFound);

    match success {
        Result::Ok(value) => {
            return value;
        },
        Result::Err(err) => {
            match err {
                IoError::NotFound => return -1,
                IoError::PermissionDenied => return -2,
                IoError::InvalidInput => return -3,
            }
        },
    }
}

fn test_color() -> i32 {
    let color = Color::Red;

    match color {
        Color::Red => return 1,
        Color::Green => return 2,
        Color::Blue => return 3,
    }
}

pub fn main() -> i32 {
    let option_result = test_option();
    let result_result = test_result();
    let color_result = test_color();

    return option_result + result_result + color_result;
}
