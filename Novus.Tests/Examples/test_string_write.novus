// Test String with console output

from exec import OpenLibrary, CloseLibrary
from dos import Output, Write

pub fn main() -> u32 {
    // Open dos.library
    let dosname = "dos.library"
    let dosbase = OpenLibrary(dosname, 0)
    if dosbase == 0 {
        return 1
    }

    // Get stdout handle
    let stdout = Output()
    if stdout == 0 {
        CloseLibrary(dosbase)
        return 2
    }

    // Test String parameter passing to our function
    let msg1 = "String param test: "
    let msg2 = "Hello from Novus!\n"

    // Write both messages
    Write(stdout, msg1, msg1.len)
    Write(stdout, msg2, msg2.len)

    CloseLibrary(dosbase)
    return 0
}
