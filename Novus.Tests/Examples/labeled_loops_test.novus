// Test for labeled loops (break label, continue label)
// Demonstrates breaking and continuing outer loops from inner loops

from std::io::file import write
from std::string::core import Str

pub fn main() -> i32 {
    // Test 1: break outer while loop
    var count1: i32 = 0
    outer1: while true {
        var inner: i32 = 0
        while inner < 5 {
            count1++
            if count1 == 7 {
                break outer1  // Break outer loop when count reaches 7
            }
            inner++
        }
    }
    if count1 != 7 {
        write("Test 1 FAILED: break outer while\n")
        return 1
    }
    write("Test 1 PASSED: break outer while\n")

    // Test 2: continue outer while loop
    var sum2: i32 = 0
    var i: i32 = 0
    outer2: while i < 5 {
        i++
        var j: i32 = 0
        while j < 3 {
            j++
            if i == 3 && j == 2 {
                continue outer2  // Skip rest of inner loop and continue outer
            }
            sum2++
        }
    }
    // Without continue: 5 * 3 = 15
    // With continue at i=3, j=2: skips j=2,3 of i=3, so 15 - 2 = 13
    if sum2 != 13 {
        write("Test 2 FAILED: continue outer while\n")
        return 2
    }
    write("Test 2 PASSED: continue outer while\n")

    // Test 3: break outer forever loop
    var count3: i32 = 0
    outer3: forever {
        forever {
            count3++
            if count3 >= 10 {
                break outer3  // Break both loops
            }
        }
    }
    if count3 != 10 {
        write("Test 3 FAILED: break outer forever\n")
        return 3
    }
    write("Test 3 PASSED: break outer forever\n")

    // Test 4: labeled break with postfix condition
    var count4: i32 = 0
    outer4: while true {
        var k: i32 = 0
        while k < 100 {
            count4++
            k++
            break outer4 if count4 == 5  // Break outer when count is 5
        }
    }
    if count4 != 5 {
        write("Test 4 FAILED: labeled break with postfix\n")
        return 4
    }
    write("Test 4 PASSED: labeled break with postfix\n")

    // Test 5: multiple labels
    var result5: i32 = 0
    outer5: while true {
        middle: while true {
            var x: i32 = 0
            while x < 3 {
                x++
                result5++
                if result5 == 3 {
                    break middle  // Break middle, continue outer
                }
                if result5 == 5 {
                    break outer5  // Break all the way out
                }
            }
        }
    }
    if result5 != 5 {
        write("Test 5 FAILED: multiple labels\n")
        return 5
    }
    write("Test 5 PASSED: multiple labels\n")

    write("All labeled loop tests PASSED!\n")
    return 0
}
