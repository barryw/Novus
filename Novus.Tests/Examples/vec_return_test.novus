from std::collections import Vec

fn main() -> i32 {
    // Create empty vector using Vec::new()
    var v: Vec<i32> = Vec::new()

    // Test: should be empty
    if !v.is_empty() {
        return 1
    }

    // Test: push elements
    v.push(10)
    v.push(20)
    v.push(30)

    // Test: should have 3 elements
    if v.len() != 3u32 {
        return 2
    }

    // Test: set element
    let ok: bool = v.set(1u32, 25)
    if !ok {
        return 3
    }

    // Test: clear
    v.clear()
    if v.len() != 0u32 {
        return 4
    }

    // Clean up
    v.drop()

    // Success!
    return 42
}
