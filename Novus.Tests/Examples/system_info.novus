// system_info.novus - Runtime hardware detection test
// This demonstrates that CPU, FPU, and Chipset are detected at runtime
//
// Test by running on different Amiga configs and checking exit code:
// - Returns 0 if running on 68040
// - Returns 1 if running on 68060
// - Returns 2 if running on 68020
// - Returns 3 otherwise

from std::system import get_cpu, get_fpu, get_chipset, SystemCPU

fn main() -> i32 {
    // Return different values based on detected CPU
    // This proves runtime detection works!
    let cpu = get_cpu()

    if cpu == SystemCPU::M68040 {
        return 0
    } else if cpu == SystemCPU::M68060 {
        return 1
    } else if cpu == SystemCPU::M68020 {
        return 2
    } else {
        return 3
    }
}
