// Example: Thread spawning with signal handling
//
// Description:
//   Spawns a lightweight thread (Exec Task) that does computation.
//   Demonstrates spawn_thread, run_thread_loop, and ThreadHandle.
//
// NOTE: Threads CANNOT use DOS functions!
//   No file I/O, no console output, no write() calls in thread!
//
// Expected Output:
//   Main process reports thread completion
//   Exit code: 0

from std::io::core import write
from std::strings::core import Str
from std::system::thread import spawn_thread, run_thread_loop, ThreadHandle
from std::ffi::exec import Wait, Signal, FindTask
from std::ffi::amiga_consts import SIGBREAKF_CTRL_C, SIGBREAKF_CTRL_D

// State for the worker thread
struct ComputeState {
    sum: i32,
    iterations: i32,
    max_iterations: i32,
}

// Worker tick function - does computation
// NOTE: Cannot use write() or any DOS functions here!
fn compute_tick(state_ptr: *u8) -> bool {
    let state = (*ComputeState)state_ptr

    // Do some computation
    var i: i32 = 0
    while i < 1000 {
        state.sum = state.sum + i
        i++
    }

    state.iterations++

    // Continue until we reach max iterations
    return state.iterations < state.max_iterations
}

// Thread entry point
fn thread_entry() -> i32 {
    var state = ComputeState {
        sum: 0,
        iterations: 0,
        max_iterations: 100,
    }

    // Custom signal for completion notification
    // Signal bit 20 = 1 << 20 = 0x100000 = 1048576
    let done_signal = 1048576u32

    // Run thread loop - will wake on signals
    run_thread_loop(done_signal, (*u8)&state, compute_tick)

    // Final sum is in state.sum
    // Can't print it (no DOS), but we return it
    return state.sum
}

pub fn main() -> i32 {
    write("Starting thread example...\n")

    // Spawn the worker thread
    let result = spawn_thread("Compute", thread_entry, 4096)

    match result {
        Err(_) => {
            write("Failed to spawn thread!\n")
            return 1
        },
        Ok(handle) => {
            write("Thread spawned successfully\n")

            // Signal the thread to start processing
            // (Our thread uses signal 20 as its wake signal)
            // Signal bit 20 = 1 << 20 = 0x100000 = 1048576
            var signals_sent: i32 = 0
            while signals_sent < 100 {
                handle.signal(1048576u32)
                signals_sent++

                // Small delay between signals
                var delay: i32 = 0
                while delay < 10000 {
                    delay++
                }
            }

            write("Sent all signals to thread\n")

            // Send break signal to terminate
            handle.break_ctrl_c()

            write("Thread example complete\n")
            return 0
        }
    }
}

