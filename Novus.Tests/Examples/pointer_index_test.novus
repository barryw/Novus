// Test pointer indexing by using pointer parameters
fn sum_three(ptr: *i32) -> i32 {
    // Test pointer read indexing
    return ptr[0] + ptr[1] + ptr[2]
}

fn write_values(ptr: *i32) {
    // Test pointer write indexing
    ptr[0] = 1
    ptr[1] = 2
    ptr[2] = 3
}

fn main() -> i32 {
    // Just declare the functions - they won't be called
    // This tests that the code generation for pointer indexing compiles
    return 42
}
