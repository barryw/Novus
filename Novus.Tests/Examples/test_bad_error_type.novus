// Example: Error Type Validation
//
// Description:
//   Tests proper error type handling by the type system.
//
// Expected Output:
//   Compiles successfully

fn make_result() -> Result<i32, i32> {
    return Result::Ok(42)
}

fn make_bad_result() -> Result<i32, i32> {
    return Result::Err(123)  // Using i32 as error type
}

pub fn main() -> i32 {
    let result = make_bad_result()

    match result {
        Ok(value) => {
            return 1  // Failed
        },
        Err(code) => {
            return code  // Return the "error" code
        },
    }
}
