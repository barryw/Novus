// Simple Prime Sieve - Find primes up to 1000
// Demonstrates Vec, loops, and string operations

from std::io import write
from std::strings import Str
from std::collections import Vec

pub fn main() -> i32 {
    let max: u32 = 1000

    write("=== Prime Sieve ===\n")
    write("Finding primes up to %ld\n\n", max)

    // Allocate sieve
    let opt_sieve = Vec::<bool>::with_capacity(max + 1)

    // Check allocation
    var alloc_failed: bool = false
    match opt_sieve {
        Some(_) => alloc_failed = false,
        None => alloc_failed = true
    }

    if alloc_failed {
        write("ERROR: Allocation failed!\n")
        return 1
    }

    // Initialize sieve - all true initially
    var sieve = Vec::<bool>::new()
    var i: u32 = 0
    while i <= max {
        sieve.push(true)
        i = i + 1
    }

    write("Sieve allocated (%ld bytes)\n", max + 1)

    // Mark 0 and 1 as not prime
    sieve.set(0, false)
    sieve.set(1, false)

    // Sieve algorithm
    var p: u32 = 2
    while p * p <= max {
        if sieve.get(p) {
            var m: u32 = p * p
            while m <= max {
                sieve.set(m, false)
                m = m + p
            }
        }
        p = p + 1
    }

    // Count and display primes
    write("\nPrimes:\n")
    var count: u32 = 0
    i = 2
    while i <= max {
        if sieve.get(i) {
            write("%ld ", i)
            count = count + 1
            if count % 10 == 0 {
                write("\n")
            }
        }
        i = i + 1
    }

    write("\n\nTotal: %ld primes\n", count)
    return 0
}
