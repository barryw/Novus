// Example 11: Implicit Returns and Local Variables
// Demonstrates implicit returns (no 'return' keyword needed) and let/var

pub fn add(a: i32, b: i32) -> i32 {
    a + b  // Implicit return - last expression is the return value
}

pub fn calculate(x: i32) -> i32 {
    let doubled: i32 = x * 2  // Immutable variable
    var result: i32 = doubled + 10  // Mutable variable
    result = result * 2
    result  // Implicit return
}

pub fn main() -> u32 {
    let x: i32 = 5
    let y: i32 = 10
    let sum = add(x, y)  // Type inference!
    let final_result = calculate(sum)
    (u32)final_result  // Implicit return with cast
}
