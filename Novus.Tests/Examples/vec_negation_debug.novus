from std::core import Vec

fn main() -> i32 {
    var v: Vec<i32> = Vec::new()

    // Get is_empty result
    let empty: bool = v.is_empty()

    // Manually negate by comparing with false
    // This is what the compiler does for !empty
    let not_empty: bool = empty == false

    // Return the negated value
    // Should be 0 if empty=true, 1 if empty=false
    if not_empty {
        return 1
    }
    return 0
}
