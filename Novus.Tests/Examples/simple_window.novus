// Simple Window Example with Menus - Modern Ergonomic Version
//
// Demonstrates:
// - WindowHandle RAII wrapper with automatic cleanup
// - GadTools hierarchical menu builder
// - Type-safe event handling via WindowEvent enum
// - Menu event decoding with MenuSelection

from amiga::sys::intuition import WindowHandle, WindowEvent
from amiga::sys::gadtools import GadToolsMenuBuilder, MenuSelection
from std::string::core import Str
from std::io::file import write

pub fn main() -> i32 {
    // Open a simple window with standard gadgets
    let result = WindowHandle::simple("Novus Window with Menus", 800, 600)

    match result {
        Result::Ok(window) => {
            // Get the screen for menu builder
            let screen = window.get_screen()

            // Build menus using the hierarchical builder API
            var builder = GadToolsMenuBuilder::new(screen)

            // Add File menu with items
            var file_menu = builder.add_menu("File")
            file_menu.add_item("New")
            file_menu.add_item("Open")
            file_menu.add_separator()
            file_menu.add_item("Quit")

            // Add Edit menu with items
            var edit_menu = builder.add_menu("Edit")
            edit_menu.add_item("Cut")
            edit_menu.add_item("Copy")
            edit_menu.add_item("Paste")

            // Build and attach menus
            let menu_result = builder.build()
            match menu_result {
                Result::Ok(menu_strip) => {
                    let attach_result = menu_strip.attach(window.window)
                    match attach_result {
                        Result::Ok(_) => {
                            write("Menus attached successfully!\n")
                        },
                        Result::Err(_) => {
                            write("Failed to attach menus\n")
                            return 20
                        }
                    }

                    // Activate the window
                    window.activate()

                    forever {
                        let event = window.wait_event()

                        match event {
                            WindowEvent::Close => {
                                break
                            },
                            WindowEvent::MenuPick(code) => {
                                let sel = MenuSelection::from_code(code)
                                write("Menu selected: menu={sel.menu} item={sel.item} sub={sel.sub}\n")
                            },
                            _ => {
                                write("event: {event}\n")
                            }
                        }
                    }

                    // Detach menus before window closes
                    menu_strip.detach(window.window)
                    // MenuStrip automatically cleaned up via Drop
                    return 0
                },
                Result::Err(_) => {
                    write("Failed to build menus\n")
                    return 20
                }
            }
        },
        Result::Err(_) => {
            return 20  // RETURN_FAIL
        }
    }
}
