// Simple Window Example - Modern Ergonomic Version
//
// Demonstrates the WindowHandle RAII wrapper with:
// - Automatic window cleanup (no manual message draining!)
// - Type-safe event handling via WindowEvent enum
// - Simple blocking event loop
// - Convenience constructor (simple window preset)
//
// Compare to the original 106-line version - this is just 30 lines!

from std::graphics::intuition import WindowHandle, WindowEvent
from std::strings::core import Str

pub fn main() -> i32 {
    // Open a simple window with standard gadgets
    // WindowHandle automatically handles cleanup on drop!
    let result = WindowHandle::simple("Novus Window", 800, 600)

    match result {
        Result::Ok(window) => {
            // Event loop - wait for events until close
            let mut running = true
            while running {
                // Wait for next event (blocks until event arrives)
                let event = window.wait_event()

                // Handle the event with pattern matching
                match event {
                    WindowEvent::Close => {
                        // User clicked close gadget - stop loop
                        running = false
                    },
                    _ => {
                        // Continue running for other events
                    }
                }
            }

            // Window is automatically cleaned up here (Drop impl)!
            // No need to manually drain messages or call CloseWindow.
            return 0
        },
        Result::Err(_) => {
            return 20  // RETURN_FAIL
        }
    }
}
