// String test with proper DOS library initialization

from std::ffi::dos import DOSBase, OpenDOSLibrary, CloseDOSLibrary, Output, Write

// Function that takes String parameter
fn print_string(stdout: i32, msg: String) -> i32 {
    return Write(stdout, msg, msg.len)
}

pub fn main() -> u32 {
    // Initialize DOS library
    let dosbase = OpenDOSLibrary()
    if dosbase == 0 {
        return 1  // Failed to open dos.library
    }

    // Get stdout handle
    let stdout = Output()
    if stdout == 0 {
        CloseDOSLibrary()
        return 2  // Failed to get stdout
    }

    // Test String parameter passing
    let msg1 = "String type works!\n"
    print_string(stdout, msg1)

    let msg2 = "Parameters: OK\n"
    print_string(stdout, msg2)

    let msg3 = "Member access: "
    Write(stdout, msg3, msg3.len)

    // Show the length
    let test = "12345"
    // TODO: Need integer to string conversion to print the length
    // For now, just verify it compiles

    let goodbye = "Done!\n"
    print_string(stdout, goodbye)

    CloseDOSLibrary()
    return 0
}
