// Test: Dual CLI/Workbench Startup Support
//
// This program can be launched from either CLI or Workbench.
// It demonstrates that the runtime correctly detects the launch method.

from amiga::workbench::args import is_workbench, get_workbench_startup
from std::io::file import write

pub fn main() -> i32 {
    if is_workbench() {
        return workbench_main()
    } else {
        return cli_main()
    }
}

fn cli_main() -> i32 {
    write("Launched from CLI (Shell)\n")
    write("Test passed!\n")
    return 0
}

fn workbench_main() -> i32 {
    write("Launched from Workbench\n")

    // Get Workbench startup message
    let wb_opt = get_workbench_startup()
    let wb = match wb_opt {
        Some(w) => w,
        None => {
            write("ERROR: Failed to get Workbench startup message\n")
            return 20
        }
    }

    let num_args = wb.num_args()
    write("Number of WBArgs: ")
    write_u32(num_args)
    write("\n")

    write("Test passed!\n")
    return 0
}

// Helper to write a u32 as a string
fn write_u32(value: u32) {
    var buf: [u8] = [0; 12]
    let len = u32_to_str(value, (*u8)&buf, 12)
    buf[len] = 0
    write((*u8)&buf)
}

// Simple u32 to string conversion
fn u32_to_str(value: u32, buf: *u8, buf_size: u32) -> u32 {
    if buf_size == 0 {
        return 0
    }

    if value == 0 {
        buf[0] = $30  // '0'
        return 1
    }

    // Convert digits in reverse
    var temp: [u8] = [0; 12]
    var len: u32 = 0

    var n = value
    while n > 0 {
        let digit = n % 10
        temp[len] = (u8)($30 + digit)
        n = n / 10
        len++
    }

    // Reverse into output buffer
    if len >= buf_size {
        len = buf_size - 1
    }

    var i: u32 = 0
    while i < len {
        let idx = len - 1 - i
        buf[i] = temp[idx]
        i++
    }

    return len
}
