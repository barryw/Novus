// blitter_test.novus - Test the Blitter API
// Tests BlitterOps high-level functions for Amiga blitter operations

from std::graphics::blitter import BlitterOps, BlitterError, BlitOp
from std::graphics::blitter import MINTERM_COPY, MINTERM_COOKIE_CUT, MINTERM_SET, MINTERM_CLEAR
from std::graphics::bitmap import BitMapHandle
from std::core import Result

fn main() -> i32 {
    // Test 1: Create bitmaps (flags=0, friend=null)
    let src_result = BitMapHandle::alloc(320, 200, 4, 0, null)
    let dst_result = BitMapHandle::alloc(320, 200, 4, 0, null)

    match src_result {
        Result::Err(e) => {
            return 1
        },
        Result::Ok(src) => {
            match dst_result {
                Result::Err(e) => {
                    return 2
                },
                Result::Ok(dst) => {
                    var dst_mut = dst

                    // Test 2: Copy rect
                    let copy_result = BlitterOps::copy_rect(
                        &src, 0, 0,
                        &mut dst_mut, 100, 50,
                        64, 32
                    )

                    match copy_result {
                        Result::Err(e) => {
                            return 3
                        },
                        Result::Ok(_) => {}
                    }

                    // Test 3: Clear rect
                    let clear_result = BlitterOps::clear_rect(
                        &mut dst_mut, 0, 0, 320, 200
                    )

                    match clear_result {
                        Result::Err(e) => {
                            return 4
                        },
                        Result::Ok(_) => {}
                    }

                    // Test 4: Fill rect with pattern (no FillMode parameter now)
                    let fill_result = BlitterOps::fill_rect(
                        &mut dst_mut, 10, 10, 100, 50,
                        $AAAA
                    )

                    match fill_result {
                        Result::Err(e) => {
                            return 5
                        },
                        Result::Ok(_) => {}
                    }

                    // Test 5: Draw line
                    let line_result = BlitterOps::draw_line(
                        &mut dst_mut,
                        0, 0,
                        319, 199,
                        $FFFF
                    )

                    match line_result {
                        Result::Err(e) => {
                            return 6
                        },
                        Result::Ok(_) => {}
                    }

                    // Test 6: Copy with XOR operation
                    let xor_result = BlitterOps::copy_rect_op(
                        &src, 0, 0,
                        &mut dst_mut, 50, 50,
                        32, 32,
                        BlitOp::Xor
                    )

                    match xor_result {
                        Result::Err(e) => {
                            return 7
                        },
                        Result::Ok(_) => {}
                    }

                    // Test 7: Draw XOR line (for cursors)
                    let xor_line_result = BlitterOps::draw_line_xor(
                        &mut dst_mut,
                        100, 0,
                        100, 199,
                        $FFFF
                    )

                    match xor_line_result {
                        Result::Err(e) => {
                            return 8
                        },
                        Result::Ok(_) => {}
                    }

                    // Test 8: Invert rect
                    let invert_result = BlitterOps::invert_rect(
                        &mut dst_mut, 50, 50, 100, 100
                    )

                    match invert_result {
                        Result::Err(e) => {
                            return 9
                        },
                        Result::Ok(_) => {}
                    }

                    // All tests passed!
                    return 0
                }
            }
        }
    }
}
