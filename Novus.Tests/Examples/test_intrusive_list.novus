// Comprehensive tests for IntrusiveList<T>
// Run with: novus test test_intrusive_list.novus

from amiga::sys::exec::intrusive_list import IntrusiveList, init_min_node
from amiga::raw::structs import MinNode, MinList
from std::test::test import expect_true, expect_false, expect_eq, expect_null, expect_not_null, fail

// Test struct - MinNode MUST be the first field for intrusive list compatibility
struct TestItem {
    node: MinNode,
    value: u32,
}

// Helper to create a new test item with initialized node
fn new_test_item(val: u32) -> TestItem {
    var item = TestItem {
        node: MinNode {
            mln_Succ: null,
            mln_Pred: null,
        },
        value: val,
    }
    return item
}

// ============================================================================
// Basic Creation Tests
// ============================================================================

@test("New list should be empty")
pub fn test_new_list_is_empty() {
    var list = IntrusiveList::<TestItem>::new()
    list.init()
    expect_true(list.is_empty(), "new list should be empty")
}

@test("New list should have length 0")
pub fn test_new_list_len_zero() {
    var list = IntrusiveList::<TestItem>::new()
    list.init()
    expect_eq(list.len(), 0, "new list length should be 0")
}

@test("New list first() should return None")
pub fn test_new_list_first_none() {
    var list = IntrusiveList::<TestItem>::new()
    list.init()
    match list.first() {
        Option::Some(_) => fail("first() on empty list should return None"),
        Option::None => { },
    }
}

@test("New list last() should return None")
pub fn test_new_list_last_none() {
    var list = IntrusiveList::<TestItem>::new()
    list.init()
    match list.last() {
        Option::Some(_) => fail("last() on empty list should return None"),
        Option::None => { },
    }
}

// ============================================================================
// Add Tail Tests
// ============================================================================

@test("add_tail single item makes list non-empty")
pub fn test_add_tail_single_not_empty() {
    var list = IntrusiveList::<TestItem>::new()
    list.init()
    var item = new_test_item(42)

    list.add_tail(&item)

    expect_false(list.is_empty(), "list should not be empty after add_tail")
    expect_eq(list.len(), 1, "list length should be 1")
}

@test("add_tail single item is both first and last")
pub fn test_add_tail_single_is_first_and_last() {
    var list = IntrusiveList::<TestItem>::new()
    list.init()
    var item = new_test_item(100)

    list.add_tail(&item)

    match list.first() {
        Option::None => fail("first() should return item"),
        Option::Some(ptr) => expect_eq(ptr.value, 100, "first item value should be 100"),
    }

    match list.last() {
        Option::None => fail("last() should return item"),
        Option::Some(ptr) => expect_eq(ptr.value, 100, "last item value should be 100"),
    }
}

@test("add_tail multiple items maintains order")
pub fn test_add_tail_order() {
    var list = IntrusiveList::<TestItem>::new()
    list.init()
    var item1 = new_test_item(10)
    var item2 = new_test_item(20)
    var item3 = new_test_item(30)

    list.add_tail(&item1)
    list.add_tail(&item2)
    list.add_tail(&item3)

    expect_eq(list.len(), 3, "list should have 3 items")

    // First should be 10, last should be 30
    match list.first() {
        Option::None => fail("first() should return item"),
        Option::Some(ptr) => expect_eq(ptr.value, 10, "first item should be 10"),
    }

    match list.last() {
        Option::None => fail("last() should return item"),
        Option::Some(ptr) => expect_eq(ptr.value, 30, "last item should be 30"),
    }
}

// ============================================================================
// Add Head Tests
// ============================================================================

@test("add_head single item makes list non-empty")
pub fn test_add_head_single_not_empty() {
    var list = IntrusiveList::<TestItem>::new()
    list.init()
    var item = new_test_item(42)

    list.add_head(&item)

    expect_false(list.is_empty(), "list should not be empty after add_head")
    expect_eq(list.len(), 1, "list length should be 1")
}

@test("add_head multiple items reverses insertion order")
pub fn test_add_head_reverse_order() {
    var list = IntrusiveList::<TestItem>::new()
    list.init()
    var item1 = new_test_item(10)
    var item2 = new_test_item(20)
    var item3 = new_test_item(30)

    // Add in order 10, 20, 30 to head -> list becomes 30, 20, 10
    list.add_head(&item1)
    list.add_head(&item2)
    list.add_head(&item3)

    expect_eq(list.len(), 3, "list should have 3 items")

    // First should be 30 (last added to head), last should be 10 (first added)
    match list.first() {
        Option::None => fail("first() should return item"),
        Option::Some(ptr) => expect_eq(ptr.value, 30, "first item should be 30"),
    }

    match list.last() {
        Option::None => fail("last() should return item"),
        Option::Some(ptr) => expect_eq(ptr.value, 10, "last item should be 10"),
    }
}

// ============================================================================
// Remove Head Tests
// ============================================================================

@test("remove_head from empty list returns None")
pub fn test_remove_head_empty() {
    var list = IntrusiveList::<TestItem>::new()
    list.init()

    match list.remove_head() {
        Option::Some(_) => fail("remove_head from empty list should return None"),
        Option::None => { },
    }
}

@test("remove_head returns correct item and decrements length")
pub fn test_remove_head_returns_first() {
    var list = IntrusiveList::<TestItem>::new()
    list.init()
    var item1 = new_test_item(10)
    var item2 = new_test_item(20)

    list.add_tail(&item1)
    list.add_tail(&item2)

    match list.remove_head() {
        Option::None => fail("remove_head should return item"),
        Option::Some(ptr) => expect_eq(ptr.value, 10, "removed item should be 10"),
    }

    expect_eq(list.len(), 1, "list length should be 1 after remove_head")
}

@test("remove_head all items leaves empty list")
pub fn test_remove_head_until_empty() {
    var list = IntrusiveList::<TestItem>::new()
    list.init()
    var item1 = new_test_item(10)
    var item2 = new_test_item(20)
    var item3 = new_test_item(30)

    list.add_tail(&item1)
    list.add_tail(&item2)
    list.add_tail(&item3)

    // Remove all items in order
    match list.remove_head() {
        Option::None => fail("first remove_head should succeed"),
        Option::Some(ptr) => expect_eq(ptr.value, 10, "first removed should be 10"),
    }

    match list.remove_head() {
        Option::None => fail("second remove_head should succeed"),
        Option::Some(ptr) => expect_eq(ptr.value, 20, "second removed should be 20"),
    }

    match list.remove_head() {
        Option::None => fail("third remove_head should succeed"),
        Option::Some(ptr) => expect_eq(ptr.value, 30, "third removed should be 30"),
    }

    expect_true(list.is_empty(), "list should be empty after removing all items")
    expect_eq(list.len(), 0, "list length should be 0")

    // Further removes should return None
    match list.remove_head() {
        Option::Some(_) => fail("remove_head on empty list should return None"),
        Option::None => { },
    }
}

