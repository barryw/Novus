}

// ============================================================================
// Length Counting Tests
// ============================================================================

@test("len counts correctly after various operations")
pub fn test_len_after_operations() {
    var list = IntrusiveList::<TestItem>::new()
    list.init()
    var item1 = new_test_item(1)
    var item2 = new_test_item(2)
    var item3 = new_test_item(3)
    var item4 = new_test_item(4)

    expect_eq(list.len(), 0, "initial len should be 0")

    list.add_tail(&item1)
    expect_eq(list.len(), 1, "len after first add should be 1")

    list.add_head(&item2)
    expect_eq(list.len(), 2, "len after second add should be 2")

    list.add_tail(&item3)
    expect_eq(list.len(), 3, "len after third add should be 3")

    list.insert_after(&item1, &item4)
    expect_eq(list.len(), 4, "len after insert_after should be 4")

    list.remove(&item2)
    expect_eq(list.len(), 3, "len after remove should be 3")

    list.remove_head()
    expect_eq(list.len(), 2, "len after remove_head should be 2")

    list.remove_tail()
    expect_eq(list.len(), 1, "len after remove_tail should be 1")
}

// ============================================================================
// Edge Cases
// ============================================================================

@test("multiple empty list checks")
pub fn test_multiple_empty_checks() {
    var list = IntrusiveList::<TestItem>::new()
    list.init()

    // Multiple checks on new list
    expect_true(list.is_empty(), "first empty check")
    expect_true(list.is_empty(), "second empty check")
    expect_eq(list.len(), 0, "first len check")
    expect_eq(list.len(), 0, "second len check")
}

@test("re-add removed item works correctly")
pub fn test_readd_removed_item() {
    var list = IntrusiveList::<TestItem>::new()
    list.init()
    var item = new_test_item(42)

    list.add_tail(&item)
    expect_eq(list.len(), 1, "len should be 1 after first add")

    list.remove(&item)
    expect_true(list.is_empty(), "list should be empty after remove")

    // Re-add the same item
    list.add_tail(&item)
    expect_eq(list.len(), 1, "len should be 1 after re-add")

    match list.first() {
        Option::None => fail("first() should return re-added item"),
        Option::Some(ptr) => expect_eq(ptr.value, 42, "re-added item value should be 42"),
    }
}

@test("interleaved add_head and add_tail")
pub fn test_interleaved_adds() {
    var list = IntrusiveList::<TestItem>::new()
    list.init()
    var item1 = new_test_item(1)
    var item2 = new_test_item(2)
    var item3 = new_test_item(3)
    var item4 = new_test_item(4)

    list.add_tail(&item1)  // [1]
    list.add_head(&item2)  // [2, 1]
    list.add_tail(&item3)  // [2, 1, 3]
    list.add_head(&item4)  // [4, 2, 1, 3]

    expect_eq(list.len(), 4, "list should have 4 items")

    // Verify order: 4, 2, 1, 3
    match list.first() {
        Option::None => fail("first() should return item"),
        Option::Some(ptr) => expect_eq(ptr.value, 4, "first should be 4"),
    }

    match list.last() {
        Option::None => fail("last() should return item"),
        Option::Some(ptr) => expect_eq(ptr.value, 3, "last should be 3"),
    }
}

@test("as_min_list returns valid pointer")
pub fn test_as_min_list() {
    var list = IntrusiveList::<TestItem>::new()
    list.init()
    var item = new_test_item(42)

    list.add_tail(&item)

    let min_list_ptr = list.as_min_list()
    expect_not_null((*u8)min_list_ptr, "as_min_list should return non-null pointer")
}

// ============================================================================
// Large List Tests
// ============================================================================

@test("add and remove many items")
pub fn test_many_items() {
    var list = IntrusiveList::<TestItem>::new()
    list.init()

    // Create an array of items on the stack
    var items: [TestItem] = [
        new_test_item(0),
        new_test_item(1),
        new_test_item(2),
        new_test_item(3),
        new_test_item(4),
        new_test_item(5),
        new_test_item(6),
        new_test_item(7),
        new_test_item(8),
        new_test_item(9),
    ]

    // Add all items
    var i: u32 = 0
    while i < 10 {
        list.add_tail(&items[i])
        i = i + 1
    }

    expect_eq(list.len(), 10, "list should have 10 items")

    // Remove all from head
    var removed: u32 = 0
    while !list.is_empty() {
        match list.remove_head() {
            Option::None => fail("remove_head should succeed"),
            Option::Some(ptr) => {
                expect_eq(ptr.value, removed, "removed item value should match")
                removed = removed + 1
            },
        }
    }

    expect_eq(removed, 10, "should have removed 10 items")
    expect_true(list.is_empty(), "list should be empty")
}
