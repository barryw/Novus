@test("remove_tail returns correct item and decrements length")
pub fn test_remove_tail_returns_last() {
    var list = IntrusiveList::<TestItem>::new()
    list.init()
    var item1 = new_test_item(10)
    var item2 = new_test_item(20)

    list.add_tail(&item1)
    list.add_tail(&item2)

    match list.remove_tail() {
        Option::None => fail("remove_tail should return item"),
        Option::Some(ptr) => expect_eq(ptr.value, 20, "removed item should be 20"),
    }

    expect_eq(list.len(), 1, "list length should be 1 after remove_tail")
