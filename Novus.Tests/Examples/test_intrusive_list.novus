@test("remove_tail all items leaves empty list")
pub fn test_remove_tail_until_empty() {
    var list = IntrusiveList::<TestItem>::new()
    list.init()
    var item1 = new_test_item(10)
    var item2 = new_test_item(20)
    var item3 = new_test_item(30)

    list.add_tail(&item1)
    list.add_tail(&item2)
    list.add_tail(&item3)

    // Remove all items from tail (reverse order)
    match list.remove_tail() {
        Option::None => fail("first remove_tail should succeed"),
        Option::Some(ptr) => expect_eq(ptr.value, 30, "first removed should be 30"),
    }

    match list.remove_tail() {
        Option::None => fail("second remove_tail should succeed"),
        Option::Some(ptr) => expect_eq(ptr.value, 20, "second removed should be 20"),
    }

    match list.remove_tail() {
        Option::None => fail("third remove_tail should succeed"),
        Option::Some(ptr) => expect_eq(ptr.value, 10, "third removed should be 10"),
    }

    expect_true(list.is_empty(), "list should be empty after removing all items")
}

// ============================================================================
// Remove Specific Node Tests
// ============================================================================

@test("remove middle node maintains list integrity")
pub fn test_remove_middle_node() {
    var list = IntrusiveList::<TestItem>::new()
    list.init()
    var item1 = new_test_item(10)
    var item2 = new_test_item(20)
    var item3 = new_test_item(30)

    list.add_tail(&item1)
    list.add_tail(&item2)
    list.add_tail(&item3)

    // Remove the middle item
    list.remove(&item2)

    expect_eq(list.len(), 2, "list should have 2 items after remove")

    // Check remaining order: 10 -> 30
    match list.first() {
        Option::None => fail("first() should return item"),
        Option::Some(ptr) => expect_eq(ptr.value, 10, "first should be 10"),
    }

    match list.last() {
        Option::None => fail("last() should return item"),
        Option::Some(ptr) => expect_eq(ptr.value, 30, "last should be 30"),
    }
}

@test("remove first node updates first pointer")
pub fn test_remove_first_node() {
    var list = IntrusiveList::<TestItem>::new()
    list.init()
    var item1 = new_test_item(10)
    var item2 = new_test_item(20)

    list.add_tail(&item1)
    list.add_tail(&item2)

    list.remove(&item1)

    expect_eq(list.len(), 1, "list should have 1 item after remove")

    match list.first() {
        Option::None => fail("first() should return item"),
        Option::Some(ptr) => expect_eq(ptr.value, 20, "first should now be 20"),
    }
}

@test("remove last node updates last pointer")
pub fn test_remove_last_node() {
    var list = IntrusiveList::<TestItem>::new()
    list.init()
    var item1 = new_test_item(10)
    var item2 = new_test_item(20)

    list.add_tail(&item1)
    list.add_tail(&item2)

    list.remove(&item2)

    expect_eq(list.len(), 1, "list should have 1 item after remove")

    match list.last() {
        Option::None => fail("last() should return item"),
        Option::Some(ptr) => expect_eq(ptr.value, 10, "last should now be 10"),
    }
}

@test("remove only node leaves empty list")
pub fn test_remove_only_node() {
    var list = IntrusiveList::<TestItem>::new()
    list.init()
    var item = new_test_item(42)

    list.add_tail(&item)
    list.remove(&item)

    expect_true(list.is_empty(), "list should be empty after removing only item")
    expect_eq(list.len(), 0, "list length should be 0")
}

// ============================================================================
// Insert After Tests
// ============================================================================

@test("insert_after at end adds to tail")
pub fn test_insert_after_at_end() {
    var list = IntrusiveList::<TestItem>::new()
    list.init()
    var item1 = new_test_item(10)
    var item2 = new_test_item(20)

    list.add_tail(&item1)
    list.insert_after(&item1, &item2)

    expect_eq(list.len(), 2, "list should have 2 items")

    match list.last() {
        Option::None => fail("last() should return item"),
        Option::Some(ptr) => expect_eq(ptr.value, 20, "last should be 20"),
    }
}

@test("insert_after in middle inserts correctly")
pub fn test_insert_after_middle() {
    var list = IntrusiveList::<TestItem>::new()
    list.init()
    var item1 = new_test_item(10)
    var item2 = new_test_item(20)
    var item3 = new_test_item(15) // Insert between 10 and 20

    list.add_tail(&item1)
    list.add_tail(&item2)

    list.insert_after(&item1, &item3)

    expect_eq(list.len(), 3, "list should have 3 items")

    // Check order: 10 -> 15 -> 20
    match list.first() {
        Option::None => fail("first() should return item"),
        Option::Some(first_ptr) => {
            expect_eq(first_ptr.value, 10, "first should be 10")
            match list.next(first_ptr) {
                Option::None => fail("next should return middle item"),
                Option::Some(middle_ptr) => {
                    expect_eq(middle_ptr.value, 15, "middle should be 15")
                    match list.next(middle_ptr) {
                        Option::None => fail("next should return last item"),
                        Option::Some(last_ptr) => {
                            expect_eq(last_ptr.value, 20, "last should be 20")
                        },
                    }
                },
            }
        },
    }
}

// ============================================================================
// Insert Before Tests
// ============================================================================

@test("insert_before at head adds to front")
pub fn test_insert_before_at_head() {
    var list = IntrusiveList::<TestItem>::new()
    list.init()
    var item1 = new_test_item(10)
    var item2 = new_test_item(5)

    list.add_tail(&item1)
    list.insert_before(&item1, &item2)

    expect_eq(list.len(), 2, "list should have 2 items")

    match list.first() {
        Option::None => fail("first() should return item"),
        Option::Some(ptr) => expect_eq(ptr.value, 5, "first should be 5"),
    }
}

@test("insert_before in middle inserts correctly")
pub fn test_insert_before_middle() {
    var list = IntrusiveList::<TestItem>::new()
    list.init()
    var item1 = new_test_item(10)
    var item2 = new_test_item(30)
    var item3 = new_test_item(20) // Insert before 30

    list.add_tail(&item1)
    list.add_tail(&item2)

    list.insert_before(&item2, &item3)

    expect_eq(list.len(), 3, "list should have 3 items")

    // Check order: 10 -> 20 -> 30
    match list.first() {
        Option::None => fail("first() should return item"),
        Option::Some(first_ptr) => {
            expect_eq(first_ptr.value, 10, "first should be 10")
            match list.next(first_ptr) {
                Option::None => fail("next should return middle item"),
                Option::Some(middle_ptr) => {
                    expect_eq(middle_ptr.value, 20, "middle should be 20")
                    match list.next(middle_ptr) {
                        Option::None => fail("next should return last item"),
                        Option::Some(last_ptr) => {
                            expect_eq(last_ptr.value, 30, "last should be 30")
                        },
                    }
                },
            }
        },
    }
}

// ============================================================================
// Navigation Tests (next/prev)
// ============================================================================

@test("next traverses list forward")
pub fn test_next_traversal() {
    var list = IntrusiveList::<TestItem>::new()
    list.init()
    var item1 = new_test_item(1)
    var item2 = new_test_item(2)
    var item3 = new_test_item(3)

    list.add_tail(&item1)
    list.add_tail(&item2)
    list.add_tail(&item3)

    var count: u32 = 0
    var expected: u32 = 1

    match list.first() {
        Option::None => fail("first() should return item"),
        Option::Some(var current) => {
            expect_eq(current.value, expected, "first value should match")
            count = count + 1
            expected = expected + 1

            match list.next(current) {
                Option::None => fail("next should return second item"),
                Option::Some(var next_ptr) => {
                    expect_eq(next_ptr.value, expected, "second value should match")
                    count = count + 1
                    expected = expected + 1

                    match list.next(next_ptr) {
                        Option::None => fail("next should return third item"),
                        Option::Some(var third_ptr) => {
                            expect_eq(third_ptr.value, expected, "third value should match")
                            count = count + 1

                            // Next on last should return None
                            match list.next(third_ptr) {
                                Option::Some(_) => fail("next on last should return None"),
                                Option::None => { },
                            }
                        },
                    }
                },
            }
        },
    }

    expect_eq(count, 3, "should have traversed 3 items")
}

@test("prev traverses list backward")
pub fn test_prev_traversal() {
    var list = IntrusiveList::<TestItem>::new()
    list.init()
    var item1 = new_test_item(1)
    var item2 = new_test_item(2)
    var item3 = new_test_item(3)

    list.add_tail(&item1)
    list.add_tail(&item2)
    list.add_tail(&item3)

    match list.last() {
        Option::None => fail("last() should return item"),
        Option::Some(var current) => {
            expect_eq(current.value, 3, "last value should be 3")

            match list.prev(current) {
                Option::None => fail("prev should return second item"),
                Option::Some(var prev_ptr) => {
                    expect_eq(prev_ptr.value, 2, "previous value should be 2")

                    match list.prev(prev_ptr) {
                        Option::None => fail("prev should return first item"),
                        Option::Some(var first_ptr) => {
                            expect_eq(first_ptr.value, 1, "first value should be 1")

                            // Prev on first should return None
                            match list.prev(first_ptr) {
                                Option::Some(_) => fail("prev on first should return None"),
                                Option::None => { },
                            }
                        },
                    }
                },
            }
        },
    }
}

