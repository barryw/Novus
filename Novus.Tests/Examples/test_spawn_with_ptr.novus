// Minimal test for spawn_task_fn_with_ptr to isolate the illegal instruction issue

from std::core import Result
from std::error::errors import DosError
from std::os::task import spawn_task_fn_with_ptr, ProcessHandle
from std::ffi::exec import FindTask, WaitPort, GetMsg, FreeMem, Delay
from std::ffi::amiga_structs import Process, MsgPort, Message, Task
from std::io::print import print_i32, print_str, print_newline

// Simple worker that just receives a data pointer and exits
fn worker() -> i32 {
    print_str("Worker: started")
    print_newline()

    // Get our process structure
    let me_ptr = FindTask(null)
    print_str("Worker: got me_ptr")
    print_newline()

    let me = (*Process)me_ptr
    print_str("Worker: cast to Process")
    print_newline()

    // Get pointer to embedded MsgPort (pr_MsgPort is after pr_Task)
    let msgport_offset = (u32)me_ptr + @sizeof(Task)
    print_str("Worker: computed msgport_offset = ")
    print_i32((i32)msgport_offset)
    print_newline()

    let my_port = (*MsgPort)msgport_offset
    print_str("Worker: cast to MsgPort")
    print_newline()

    // Wait for startup message
    print_str("Worker: calling WaitPort")
    print_newline()

    WaitPort(my_port)

    print_str("Worker: WaitPort returned, calling GetMsg")
    print_newline()

    let startup_msg = GetMsg(my_port)
    if (u32)startup_msg == 0 {
        print_str("Worker: GetMsg returned null!")
        print_newline()
        return 1
    }

    print_str("Worker: got startup message")
    print_newline()

    // Extract the data pointer from the message
    let data_offset = (u32)startup_msg + @sizeof(Message)
    let data_field_ptr = (**u8)data_offset
    let data_value = *data_field_ptr

    print_str("Worker: extracted data value = ")
    print_i32((i32)data_value)
    print_newline()

    // Free the startup message
    let msg_size = @sizeof(Message) + @sizeof(*u8)
    unsafe { FreeMem((*u8)startup_msg, msg_size) }

    print_str("Worker: exiting normally")
    print_newline()

    return 0
}

pub fn main() -> i32 {
    print_str("Main: starting test")
    print_newline()

    // Pass a simple value as the data pointer
    let test_value: *u8 = (*u8)42

    print_str("Main: spawning worker with data = ")
    print_i32(42)
    print_newline()

    let spawn_result = spawn_task_fn_with_ptr("TestWorker", worker, test_value, 8192)
    match spawn_result {
        Result::Err(_) => {
            print_str("Main: spawn failed!")
            print_newline()
            return 1
        },
        Result::Ok(handle) => {
            print_str("Main: spawn succeeded, waiting for completion")
            print_newline()

            // Wait a moment for the worker to finish
            Delay(100)

            print_str("Main: test complete")
            print_newline()
            return 0
        }
    }
}
