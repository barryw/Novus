// Error Handling Demo for Novus
// Demonstrates comprehensive error taxonomy and Result<T, E> usage

from io import write_out_result, print, println
from error import DosError, ExecError, NovusError, novus_error_from_dos, novus_error_from_exec

// Example 1: Basic Result handling with match
pub fn example_basic_result() -> u32 {
    println("=== Example 1: Basic Result Handling ===")

    let result = write_out_result("Testing Result type...\n")

    match result {
        Ok(bytes) => {
            print("Success! Wrote ")
            // Note: Would print bytes here when integer-to-string conversion is implemented
            println(" bytes")
            return 0
        },
        Err(err) => {
            println("Error: Failed to write to stdout")
            return 1
        },
    }
}

// Example 2: Handling specific error types
pub fn example_specific_errors() -> u32 {
    println("=== Example 2: Specific Error Types ===")

    let result = write_out_result("Checking specific errors...\n")

    match result {
        Ok(bytes) => {
            println("Write succeeded")
        },
        Err(err) => {
            // Match on specific error variants
            match err {
                DosError::NotFound => {
                    println("Error: File not found")
                    return 205
                },
                DosError::DiskFull => {
                    println("Error: Disk is full!")
                    return 221
                },
                DosError::WriteProtected => {
                    println("Error: Disk is write protected")
                    return 223
                },
                DosError::InvalidInput => {
                    println("Error: Invalid input")
                    return 1
                },
                _ => {
                    println("Error: Unknown DOS error")
                    return 999
                },
            }
        },
    }

    return 0
}

// Example 3: Cross-subsystem error handling
// This function might fail with either DOS or Exec errors
pub fn example_mixed_subsystems() -> Result<i32, NovusError> {
    println("=== Example 3: Cross-Subsystem Errors ===")

    // Simulate a DOS operation
    let dos_result = write_out_result("Testing DOS operation...\n")

    match dos_result {
        Ok(bytes) => {
            println("DOS operation succeeded")
        },
        Err(dos_err) => {
            // Convert DosError to NovusError for cross-subsystem handling
            let novus_err = novus_error_from_dos(dos_err)
            return Result::Err(novus_err)
        },
    }

    // Simulate an Exec operation that might fail
    // For this demo, we'll pretend it always succeeds
    // In real code: let mem_ptr = AllocMem(size, flags)
    // if mem_ptr == 0 { return Result::Err(novus_error_from_exec(ExecError::NoMem)) }

    println("All operations succeeded!")
    return Result::Ok(42)
}

// Example 4: Helper pattern - propagate errors up the stack
pub fn helper_that_might_fail() -> Result<i32, DosError> {
    let result = write_out_result("Helper function executing...\n")

    match result {
        Ok(bytes) => {
            return Result::Ok(bytes)
        },
        Err(err) => {
            // Error propagates to caller
            return Result::Err(err)
        },
    }
}

pub fn caller_handles_helper_error() -> u32 {
    println("=== Example 4: Error Propagation ===")

    let result = helper_that_might_fail()

    match result {
        Ok(bytes) => {
            println("Helper succeeded!")
            return 0
        },
        Err(err) => {
            println("Helper failed with error")
            return 1
        },
    }
}

// Example 5: Ignoring errors with convenience functions
pub fn example_fire_and_forget() {
    println("=== Example 5: Fire-and-Forget Output ===")

    // print() and println() ignore errors - useful for debug logging
    // where you don't want to handle failures
    print("This is ")
    print("fire-and-forget ")
    println("output!")

    println("Even if stdout is unavailable, this won't crash")
}

// Main function - runs all examples
pub fn main() -> u32 {
    println("Novus Error Handling Demo")
    println("=========================")
    println("")

    example_basic_result()
    println("")

    example_specific_errors()
    println("")

    let mixed_result = example_mixed_subsystems()
    match mixed_result {
        Ok(value) => {
            println("Mixed subsystems example succeeded")
        },
        Err(err) => {
            println("Mixed subsystems example failed")
        },
    }
    println("")

    caller_handles_helper_error()
    println("")

    example_fire_and_forget()
    println("")

    println("=== Demo Complete ===")
    return 0
}
