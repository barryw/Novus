// Test Result<T, E> with I/O operations

from error import DosError
from dos import Output, Write

fn write_output(message: String) -> Result<i32, DosError> {
    let stdout = Output()
    if stdout == 0 {
        return Result::Err(DosError::InvalidInput)
    }

    let bytes = Write(stdout, message, message.len)
    if bytes >= 0 {
        return Result::Ok(bytes)
    }

    return Result::Err(DosError::Unknown)
}

pub fn main() -> i32 {
    // Test writing to stdout
    let result = write_output("Result test: OK\n")

    match result {
        Ok(bytes_written) => {
            // Success - bytes were written
            if bytes_written > 0 {
                return 0  // Test passed
            }
            return 1  // Failed: no bytes written
        },
        Err(err) => {
            // I/O error occurred
            return 2  // Failed: unexpected error
        },
    }
}
