// Test if child can write to a file to prove it runs

from std::core import Result
from amiga::sys::dos::errors import DosError
from amiga::sys::exec import spawn_task_fn
from amiga::raw::dos import VPrintf, Delay, Open, Write, Close
from amiga::raw::consts import MODE_NEWFILE

fn worker() -> i32 {
    // Try to create a file to prove we ran
    let fh = Open("RAM:worker_ran.txt\0", MODE_NEWFILE)
    if fh != 0 {
        let msg: *u8 = "Worker was here!\n"
        Write(fh, msg, 17)
        Close(fh)
    }
    return 0
}

pub fn main() -> i32 {
    VPrintf("M: starting\n", (*u8)0)

    let result = spawn_task_fn("FileWorker", worker, 8192)

    match result {
        Result::Err(_) => {
            VPrintf("M: spawn failed\n", (*u8)0)
            return 1
        },
        Result::Ok(_) => {
            VPrintf("M: spawn succeeded\n", (*u8)0)
        }
    }

    // Wait for child to finish
    Delay(100)

    VPrintf("M: done - check RAM:worker_ran.txt\n", (*u8)0)
    return 0
}
