// Simplest possible exec call test

from amiga::raw::dos import VPrintf
from amiga::raw::exec import FindTask

pub fn main() -> i32 {
    VPrintf("1\n", (*u8)0)

    let me = FindTask(null)
    var me_val: u32 = (u32)me

    VPrintf("ME=%08lx\n", (*u8)&me_val)
    VPrintf("2\n", (*u8)0)

    return 0
}
