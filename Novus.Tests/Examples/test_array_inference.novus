// Test array type inference - should work without explicit size!

from std::ffi::amiga_structs import TagItem
from std::ffi::amiga_consts import WA_Left, WA_Top, WA_Width, WA_Height, WA_Title, WA_Flags, WA_IDCMP, TAG_DONE
from std::ffi::amiga_consts import WFLG_CLOSEGADGET, WFLG_DRAGBAR, WFLG_DEPTHGADGET, WFLG_ACTIVATE, IDCMP_CLOSEWINDOW
from std::strings::core import Str

pub fn main() -> i32 {
    // Test: No type annotation at all - fully inferred!
    let tags = [
        TagItem { ti_Tag: WA_Left, ti_Data: 50 },
        TagItem { ti_Tag: WA_Top, ti_Data: 50 },
        TagItem { ti_Tag: WA_Width, ti_Data: 320 },
        TagItem { ti_Tag: WA_Height, ti_Data: 200 },
        TagItem { ti_Tag: WA_Title, ti_Data: "Novus Window" },
        TagItem { ti_Tag: WA_Flags, ti_Data: WFLG_CLOSEGADGET | WFLG_DRAGBAR | WFLG_DEPTHGADGET | WFLG_ACTIVATE },
        TagItem { ti_Tag: WA_IDCMP, ti_Data: IDCMP_CLOSEWINDOW },
        TagItem { ti_Tag: TAG_DONE, ti_Data: 0 }
    ]

    return 0
}
