// Idiomatic Novus using the same V36 Intuition/GadTools APIs as the C reference.
// No FFI imports, raw pointers, unsafe blocks, C, or assembly.

from amiga::ui import Bounds, Event, StaticControl, StaticMenu, StaticUi

const QUIT_BUTTON: u16 = 1

static GADGETS: [StaticControl] = [
    StaticControl::checkbox(2, "Enable feature", 24, 34, 170, 14, true),
    StaticControl::integer(3, "Value", 24, 58, 170, 18, 42, 3),
    StaticControl::button(QUIT_BUTTON, "Quit", 124, 88, 70, 18),
]

static MENUS: [StaticMenu] = [
    StaticMenu::title("File"),
    StaticMenu::item("Quit", "Q"),
    StaticMenu::end(),
]

static UI: StaticUi = StaticUi {
    title: "Idiomatic GUI",
    bounds: Bounds { x: 40, y: 30, width: 230, height: 135 },
    gadgets: GADGETS,
    gadget_count: 3,
    menus: MENUS,
}

pub fn main() -> i32 {
    let Result::Ok(window) = UI.open() else { return 20 }

    forever {
        match window.wait_event() {
            Event::Close => { break },
            Event::GadgetUp(QUIT_BUTTON, _) => { break },
            Event::MenuPick(0, 0) => { break },
            _ => {},
        }
    }

    return 0
}
