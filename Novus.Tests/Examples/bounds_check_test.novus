// Test array bounds checking with different safety levels

pub fn access_in_bounds() -> i32 {
    let arr = [1, 2, 3, 4, 5]
    let x = arr[2]  // Valid access
    return x
}

pub fn access_out_of_bounds() -> i32 {
    let arr = [1, 2, 3, 4, 5]
    let x = arr[10]  // Out of bounds! Should panic with bounds check enabled
    return x
}

pub fn store_out_of_bounds() -> i32 {
    var arr = [1, 2, 3]
    arr[5] = 99  // Out of bounds! Should panic with bounds check enabled
    return arr[0]
}

pub fn main() -> i32 {
    // Test in-bounds access - should always work
    let result = access_in_bounds()

    // Test out-of-bounds access - will panic if bounds checking enabled
    // let bad = access_out_of_bounds()

    return result
}
