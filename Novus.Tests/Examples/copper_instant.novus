// Instant Copper Test - No delay, immediate cleanup
// Tests if copper activation itself is causing the hang

from std::core import Result
from amiga::sys::graphics::copper import CopperListBuilder, CopperError
from amiga::sys::hardware::registers import rgb12
from amiga::raw::graphics import WaitTOF

pub fn main() -> i32 {
    // Ensure graphics.library is opened
    unsafe {
        WaitTOF()
    }

    // Create a simple copper list that sets the background to blue
    var builder = CopperListBuilder::new()
    let _ = builder.wait(0, 0)
    let _ = builder.move_color(0, rgb12(0, 0, 15))

    // Build and activate
    let build_result = builder.build()
    match build_result {
        Result::Ok(copper_list) => {
            unsafe {
                copper_list.activate()
            }
            // Immediately deactivate - no delay
            // Copper list auto-deactivated when it goes out of scope
            return 0
        },
        Result::Err(error) => {
            return 1
        }
    }
}
