// Test suite for std::math::sqrt

from std::math::sqrt import *
from std::math::fixed import Fixed32
from std::test::test import expect_eq_i32, expect_true, expect_false

// ============================================================================
// Integer Square Root Tests
// ============================================================================

@test
pub fn test_sqrt_u32_zero() {
    expect_eq_i32((i32)sqrt_u32(0u32), 0, "sqrt(0) = 0")
}

@test
pub fn test_sqrt_u32_one() {
    expect_eq_i32((i32)sqrt_u32(1u32), 1, "sqrt(1) = 1")
}

@test
pub fn test_sqrt_u32_perfect_squares() {
    expect_eq_i32((i32)sqrt_u32(4u32), 2, "sqrt(4) = 2")
    expect_eq_i32((i32)sqrt_u32(9u32), 3, "sqrt(9) = 3")
    expect_eq_i32((i32)sqrt_u32(16u32), 4, "sqrt(16) = 4")
    expect_eq_i32((i32)sqrt_u32(25u32), 5, "sqrt(25) = 5")
    expect_eq_i32((i32)sqrt_u32(100u32), 10, "sqrt(100) = 10")
    expect_eq_i32((i32)sqrt_u32(10000u32), 100, "sqrt(10000) = 100")
}

@test
pub fn test_sqrt_u32_non_perfect() {
    // Should return floor of square root
    expect_eq_i32((i32)sqrt_u32(2u32), 1, "sqrt(2) = 1")
    expect_eq_i32((i32)sqrt_u32(3u32), 1, "sqrt(3) = 1")
    expect_eq_i32((i32)sqrt_u32(5u32), 2, "sqrt(5) = 2")
    expect_eq_i32((i32)sqrt_u32(8u32), 2, "sqrt(8) = 2")
    expect_eq_i32((i32)sqrt_u32(10u32), 3, "sqrt(10) = 3")
}

@test
pub fn test_sqrt_u32_large() {
    expect_eq_i32((i32)sqrt_u32(65536u32), 256, "sqrt(65536) = 256")
    expect_eq_i32((i32)sqrt_u32(1000000u32), 1000, "sqrt(1000000) = 1000")
}

@test
pub fn test_sqrt_i32_positive() {
    expect_eq_i32(sqrt_i32(25), 5, "sqrt_i32(25) = 5")
    expect_eq_i32(sqrt_i32(100), 10, "sqrt_i32(100) = 10")
}

@test
pub fn test_sqrt_i32_negative() {
    expect_eq_i32(sqrt_i32(-25), 0, "sqrt_i32(-25) = 0")
    expect_eq_i32(sqrt_i32(-1), 0, "sqrt_i32(-1) = 0")
}

@test
pub fn test_sqrt_i32_zero() {
    expect_eq_i32(sqrt_i32(0), 0, "sqrt_i32(0) = 0")
}

// ============================================================================
// u16 Square Root Tests
// ============================================================================

@test
pub fn test_sqrt_u16_perfect() {
    expect_eq_i32((i32)sqrt_u16(0u16), 0, "sqrt_u16(0) = 0")
    expect_eq_i32((i32)sqrt_u16(1u16), 1, "sqrt_u16(1) = 1")
    expect_eq_i32((i32)sqrt_u16(4u16), 2, "sqrt_u16(4) = 2")
    expect_eq_i32((i32)sqrt_u16(144u16), 12, "sqrt_u16(144) = 12")
    expect_eq_i32((i32)sqrt_u16(256u16), 16, "sqrt_u16(256) = 16")
}

@test
pub fn test_sqrt_u16_non_perfect() {
    expect_eq_i32((i32)sqrt_u16(10u16), 3, "sqrt_u16(10) = 3")
    expect_eq_i32((i32)sqrt_u16(50u16), 7, "sqrt_u16(50) = 7")
}

// ============================================================================
// Fast Square Root Tests
// ============================================================================

@test
pub fn test_sqrt_u32_fast_zero() {
    expect_eq_i32((i32)sqrt_u32_fast(0u32), 0, "sqrt_fast(0) = 0")
}

@test
pub fn test_sqrt_u32_fast_one() {
    expect_eq_i32((i32)sqrt_u32_fast(1u32), 1, "sqrt_fast(1) = 1")
}

@test
pub fn test_sqrt_u32_fast_perfect() {
    // Fast sqrt should be close to exact for perfect squares
    let r4 = sqrt_u32_fast(4u32)
    let r16 = sqrt_u32_fast(16u32)
    let r100 = sqrt_u32_fast(100u32)

    expect_true((i32)r4 >= 1 && (i32)r4 <= 3, "sqrt_fast(4) ≈ 2")
    expect_true((i32)r16 >= 3 && (i32)r16 <= 5, "sqrt_fast(16) ≈ 4")
    expect_true((i32)r100 >= 9 && (i32)r100 <= 11, "sqrt_fast(100) ≈ 10")
}

@test
pub fn test_sqrt_u32_fast_large() {
    let r = sqrt_u32_fast(1000000u32)
    // Should be approximately 1000
    expect_true((i32)r >= 950 && (i32)r <= 1050, "sqrt_fast(1000000) ≈ 1000")
}

// ============================================================================
// Fixed-Point Square Root Tests
// ============================================================================

@test
pub fn test_sqrt_fixed32_zero() {
    let result = sqrt_fixed32(Fixed32::zero())
    expect_eq_i32(result.to_raw(), 0, "sqrt_fixed32(0) = 0")
}

@test
pub fn test_sqrt_fixed32_one() {
    let result = sqrt_fixed32(Fixed32::one())
    // sqrt(1) = 1, so should be around 65536
    let raw = result.to_raw()
    expect_true(raw > 60000 && raw < 70000, "sqrt_fixed32(1) ≈ 1.0")
}

@test
pub fn test_sqrt_fixed32_four() {
    let four = Fixed32::from_i32(4)
    let result = sqrt_fixed32(four)
    // sqrt(4) = 2
    expect_eq_i32(result.to_i32(), 2, "sqrt_fixed32(4) = 2")
}

@test
pub fn test_sqrt_fixed32_nine() {
    let nine = Fixed32::from_i32(9)
    let result = sqrt_fixed32(nine)
    // sqrt(9) = 3
    expect_eq_i32(result.to_i32(), 3, "sqrt_fixed32(9) = 3")
}

@test
pub fn test_sqrt_fixed32_negative() {
    let neg = Fixed32::from_i32(-4)
    let result = sqrt_fixed32(neg)
    expect_eq_i32(result.to_raw(), 0, "sqrt_fixed32(negative) = 0")
}

// ============================================================================
// Distance Tests
// ============================================================================

@test
pub fn test_distance_i32_pythagorean() {
    // 3-4-5 triangle
    let d = distance_i32(0, 0, 3, 4)
    expect_eq_i32(d, 5, "distance in 3-4-5 triangle")
}

@test
pub fn test_distance_i32_same_point() {
    let d = distance_i32(10, 20, 10, 20)
    expect_eq_i32(d, 0, "distance to same point is 0")
}

@test
pub fn test_distance_i32_horizontal() {
    let d = distance_i32(0, 0, 10, 0)
    expect_eq_i32(d, 10, "horizontal distance")
}

@test
pub fn test_distance_i32_vertical() {
    let d = distance_i32(0, 0, 0, 10)
    expect_eq_i32(d, 10, "vertical distance")
}

@test
pub fn test_distance_i32_negative_coords() {
    // Distance from (-3, -4) to (0, 0)
    let d = distance_i32(-3, -4, 0, 0)
    expect_eq_i32(d, 5, "distance with negative coords")
}

// ============================================================================
// Distance Comparison Tests
// ============================================================================

@test
pub fn test_distance_less_than_true() {
    // 3-4-5 triangle, distance = 5
    let result = distance_less_than(0, 0, 3, 4, 6)
    expect_true(result, "distance 5 < 6")
}

@test
pub fn test_distance_less_than_false() {
    let result = distance_less_than(0, 0, 3, 4, 4)
    expect_true(!result, "distance 5 not < 4")
}

@test
pub fn test_distance_less_than_equal() {
    let result = distance_less_than(0, 0, 3, 4, 5)
    expect_true(!result, "distance 5 not < 5")
}

@test
pub fn test_distance_within_true() {
    let result = distance_within(0, 0, 3, 4, 5)
    expect_true(result, "distance 5 <= 5")
}

@test
pub fn test_distance_within_above() {
    let result = distance_within(0, 0, 3, 4, 10)
    expect_true(result, "distance 5 <= 10")
}

@test
pub fn test_distance_within_below() {
    let result = distance_within(0, 0, 3, 4, 4)
    expect_true(!result, "distance 5 not <= 4")
}

// ============================================================================
// Hypotenuse Tests
// ============================================================================

@test
pub fn test_hypot_i32_345() {
    let h = hypot_i32(3, 4)
    expect_eq_i32(h, 5, "hypot(3, 4) = 5")
}

@test
pub fn test_hypot_i32_zero() {
    expect_eq_i32(hypot_i32(0, 0), 0, "hypot(0, 0) = 0")
    expect_eq_i32(hypot_i32(5, 0), 5, "hypot(5, 0) = 5")
    expect_eq_i32(hypot_i32(0, 5), 5, "hypot(0, 5) = 5")
}

@test
pub fn test_hypot_i32_negative() {
    let h = hypot_i32(-3, -4)
    expect_eq_i32(h, 5, "hypot(-3, -4) = 5")
}

@test
pub fn test_hypot_i32_large() {
    // Test with values that would overflow if squared directly
    // 30000² + 40000² = 2.5 billion, which overflows i32
    // hypot_i32 should handle this by scaling
    let h = hypot_i32(30000, 40000)
    // Should be approximately 50000
    expect_true(h > 45000 && h < 55000, "hypot(30000, 40000) ≈ 50000")
}

