// Comprehensive sprite library test
// Tests all sprite features including PAL/NTSC support, collision detection, and animation

from std::graphics::sprite import SpriteData, SpriteHandle, AttachedSpriteData, AttachedSpriteHandle
from std::graphics::sprite import detect_display_mode, read_sprite_collisions, clear_sprite_collisions
from std::graphics::palette import Color, rgb
from std::core import Result

// Simple 4x4 sprite data (2 bitplanes, 4 colors)
const SPRITE_DATA: [u16; 10] = [
    $0000, $0000,  // Control words
    $0FF0, $0000,  // Scanline 1: #### ....
    $1FF8, $0000,  // Scanline 2: .###### .
    $1FF8, $0000,  // Scanline 3: .###### .
    $0FF0, $0000   // Scanline 4: #### ....
]

// Alternate sprite for animation test
const SPRITE_DATA2: [u16; 10] = [
    $0000, $0000,  // Control words
    $00F0, $0000,  // Scanline 1: .... ####
    $01F8, $0000,  // Scanline 2: ...##### .
    $01F8, $0000,  // Scanline 3: ...##### .
    $00F0, $0000   // Scanline 4: .... ####
]

fn test_sprite_allocation() -> Result<(), i32> {
    // Test channel allocation
    let sprite = SpriteHandle::alloc(0)?

    // Test double allocation should fail
    let sprite2_result = SpriteHandle::alloc(0)
    match sprite2_result {
        Result::Ok(_) => return Result::Err(-1),  // Should have failed
        Result::Err(_) => {}  // Expected
    }

    return Result::Ok(())
}

fn test_sprite_display() -> Result<(), i32> {
    // Detect display mode
    detect_display_mode()

    // Create sprite data
    let sprite_data = SpriteData::from_raw(&SPRITE_DATA, 10u32)?

    // Allocate and display sprite
    let mut sprite = SpriteHandle::alloc(1)?

    // Set colors
    let colors: [Color; 3] = [
        rgb(255, 0, 0),    // Red
        rgb(0, 255, 0),    // Green
        rgb(0, 0, 255)     // Blue
    ]
    sprite.set_colors(&colors)?

    // Show at position
    sprite.show(&sprite_data, 100, 50)?

    // Test query methods
    if !sprite.is_visible() {
        return Result::Err(-2)
    }

    let (x, y) = sprite.position()
    if x != 100 || y != 50 {
        return Result::Err(-3)
    }

    // Move sprite
    sprite.move_to(200, 100)
    let (x2, y2) = sprite.position()
    if x2 != 200 || y2 != 100 {
        return Result::Err(-4)
    }

    // Hide sprite
    sprite.hide()

    return Result::Ok(())
}

fn test_sprite_animation() -> Result<(), i32> {
    let sprite_data1 = SpriteData::from_raw(&SPRITE_DATA, 10u32)?
    let sprite_data2 = SpriteData::from_raw(&SPRITE_DATA2, 10u32)?

    let mut sprite = SpriteHandle::alloc(2)?

    let colors: [Color; 3] = [
        rgb(255, 255, 0),
        rgb(255, 0, 255),
        rgb(0, 255, 255)
    ]
    sprite.set_colors(&colors)?

    // Show first frame
    sprite.show(&sprite_data1, 150, 75)?

    // Animate by changing image
    sprite.set_image(&sprite_data2)
    sprite.set_image(&sprite_data1)

    return Result::Ok(())
}

fn test_attached_sprite() -> Result<(), i32> {
    // Create 4-bitplane sprite data for 15-color sprite
    let plane01 = SpriteData::from_raw(&SPRITE_DATA, 10u32)?
    let plane23 = SpriteData::from_raw(&SPRITE_DATA2, 10u32)?

    let attached_data = AttachedSpriteData::from_sprites(plane01, plane23)?

    // Allocate attached sprite (uses channels 4 and 5)
    let mut attached = AttachedSpriteHandle::alloc_pair(4)?

    // Verify channel numbers
    let (ch0, ch1) = attached.channels()
    if ch0 != 4 || ch1 != 5 {
        return Result::Err(-5)
    }

    // Set 15 colors
    let colors: [Color; 15] = [
        rgb(255, 0, 0), rgb(0, 255, 0), rgb(0, 0, 255),
        rgb(255, 255, 0), rgb(255, 0, 255), rgb(0, 255, 255),
        rgb(128, 0, 0), rgb(0, 128, 0), rgb(0, 0, 128),
        rgb(128, 128, 0), rgb(128, 0, 128), rgb(0, 128, 128),
        rgb(192, 192, 192), rgb(64, 64, 64), rgb(255, 128, 0)
    ]
    attached.set_colors(&colors)?

    // Show attached sprite
    attached.show(&attached_data, 180, 90)?

    // Move it
    attached.move_to(220, 110)

    // Hide it
    attached.hide()

    return Result::Ok(())
}

fn test_collision_detection() -> Result<(), i32> {
    // Clear any previous collisions
    clear_sprite_collisions()

    // Read collision register
    let collisions = read_sprite_collisions()

    // In test environment, collisions should be 0
    if collisions != 0 {
        // This is fine - hardware might have collisions
    }

    return Result::Ok(())
}

fn main() -> Result<(), i32> {
    // Run all tests
    test_sprite_allocation()?
    test_sprite_display()?
    test_sprite_animation()?
    test_attached_sprite()?
    test_collision_detection()?

    return Result::Ok(())
}
