// Demonstrate String type with visible console output
// This test uses raw DOS Write() calls without library initialization

extern fn Write(file: i32, buffer: i32, length: i32) -> i32

// Get stdout handle - simplified version that assumes stdout = 1
fn get_stdout() -> i32 {
    return 1  // On Amiga, handle 1 is typically stdout
}

// Function that accepts String parameter
fn print_string(msg: String) -> i32 {
    let stdout = get_stdout()
    return Write(stdout, msg, msg.len)
}

// Function that returns String length
fn string_length(s: String) -> i32 {
    return s.len
}

pub fn main() -> u32 {
    // Test 1: Direct String usage
    let hello = "Hello from Novus String type!\n"
    print_string(hello)

    // Test 2: String parameter passing
    let msg = "String params work!\n"
    print_string(msg)

    // Test 3: Member access
    let test = "123"
    let len = string_length(test)

    // Exit with length (should be 3)
    return (u32)len
}
