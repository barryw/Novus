// Test for signal leaks in bounded channel creation/destruction

from std::core import Result, Option
from amiga::sys::dos::errors import DosError
from amiga::sys::exec::channel import bounded_channel, BoundedSender, BoundedReceiver
from amiga::raw::dos import VPrintf

pub fn main() -> i32 {
    VPrintf("Signal leak test - creating/destroying bounded channels\n", null)

    var i: i32 = 0
    while i < 100 {
        var iter: i32 = i + 1
        VPrintf("Iteration %ld: creating channel... ", (*u8)&iter)

        let result = bounded_channel::<i32>()
        match result {
            Result::Err(_) => {
                VPrintf("FAILED to create channel!\n", null)
                return 1
            },
            Result::Ok(pair) => {
                // Explicitly destructure to ensure Drop is called on each
                let (tx, rx) = pair
                VPrintf("OK, dropping... ", null)
                // tx and rx go out of scope here
            }
        }

        VPrintf("done\n", null)
        i = i + 1
    }

    VPrintf("All 100 iterations succeeded!\n", null)
    return 0
}
