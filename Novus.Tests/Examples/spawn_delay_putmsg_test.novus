// Test PutMsg with longer delay to ensure child is ready

from std::core import Result
from std::error::errors import DosError
from std::os::task import spawn_task_fn
from std::ffi::dos import VPrintf, Delay
from std::ffi::exec import AllocMem, FreeMem, PutMsg
from std::ffi::amiga_consts import MEMF_PUBLIC, MEMF_CLEAR
from std::ffi::amiga_structs import Process, Message, MsgPort

fn worker() -> i32 {
    VPrintf("W-START\n", (*u8)0)
    Delay(200)  // 4 seconds
    VPrintf("W-END\n", (*u8)0)
    return 0
}

pub fn main() -> i32 {
    VPrintf("1-START\n", (*u8)0)

    let result = spawn_task_fn("Worker", worker, 8192)
    var process: *u8 = null

    match result {
        Result::Err(_) => {
            VPrintf("ERR\n", (*u8)0)
            return 1
        },
        Result::Ok(handle) => {
            VPrintf("2-SPAWNED\n", (*u8)0)
            process = handle.process
        }
    }

    // Wait 2 seconds to ensure child is fully running
    VPrintf("3-WAITING 2 SECS\n", (*u8)0)
    Delay(100)

    // Allocate message
    let msg_size: u32 = 24
    let msg_mem = unsafe { AllocMem(msg_size, MEMF_PUBLIC | MEMF_CLEAR) }
    if (u32)msg_mem == 0 {
        VPrintf("ALLOC FAIL\n", (*u8)0)
        return 1
    }

    VPrintf("4-ALLOCATED\n", (*u8)0)

    let msg = (*Message)msg_mem
    msg.mn_Node.ln_Type = 5
    msg.mn_ReplyPort = null
    msg.mn_Length = (u16)msg_size

    VPrintf("5-MSG SETUP\n", (*u8)0)

    let child_proc = (*Process)process

    // Print addresses for debugging
    var proc_val: u32 = (u32)process
    VPrintf("PROC=%08lx\n", (*u8)&proc_val)

    var port_ptr: u32 = (u32)(*u8)&child_proc.pr_MsgPort
    VPrintf("PORT=%08lx\n", (*u8)&port_ptr)

    VPrintf("6-ABOUT TO PUTMSG\n", (*u8)0)

    // THE CRASH POINT
    PutMsg((*MsgPort)(*u8)&child_proc.pr_MsgPort, msg)

    VPrintf("7-PUTMSG DONE\n", (*u8)0)
    Delay(150)

    VPrintf("8-DONE\n", (*u8)0)
    return 0
}
