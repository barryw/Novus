from std::strings::core import String

fn consume(consuming s: String) {}

// This demonstrates valid usage where nested branches don't cause move errors
// because we only read from x, never consume it
fn test_nested_branches_valid(condition1: bool, condition2: bool) -> i32 {
    let x = String::new()

    if condition1 {
        if condition2 {
            let len1 = x.len()  // OK - just reading
        }
    }

    // OK - x was never moved, just read
    let len = x.len()
    consume(x)  // consume x at the end
    return 0
}

pub fn main() -> i32 {
    return test_nested_branches_valid(true, true)
}
