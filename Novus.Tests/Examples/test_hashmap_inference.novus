// Test Vec with explicit generic type parameters
from std::collections::vec import Vec
from std::core import Result

fn main() {
    // Call with explicit type parameter
    let vec_opt = Vec::<u32>::with_capacity(16)

    match vec_opt {
        Result::Ok(vec) => {
            var vec_mut = vec
            // Push u32 value
            let _ = vec_mut.push(42)
        },
        Result::Err(_) => {
            let dummy = 0
        }
    }
}
