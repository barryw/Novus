// ANSI Colors Demo - Shows Amiga console colors
//
// Demonstrates foreground and background colors
// using the std::console::ansi library.

from std::console::ansi import *
from std::io::core import write

pub fn main() -> i32 {
    write("Amiga Console Colors Demo\n")
    write("=========================\n\n")

    let rst = reset()

    // Foreground colors - one per line to minimize stack usage
    write("Foreground Colors:\n")
    write(f"  {fg(Color::Red)}Red{rst}\n")
    write(f"  {fg(Color::Green)}Green{rst}\n")
    write(f"  {fg(Color::Blue)}Blue{rst}\n")

    write("\nBackground Colors:\n")
    write(f"  {bg(Color::Red)} Red {rst}\n")
    write(f"  {bg(Color::Green)} Green {rst}\n")
    write(f"  {bg(Color::Blue)} Blue {rst}\n")

    write("\nDone!\n")
    return 0
}
