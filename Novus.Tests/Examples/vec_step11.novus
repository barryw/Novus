from std::collections import Vec

// Step 11: Push 4 elements (no reallocation), then drop
fn main() -> i32 {
    var v: Vec<i32> = Vec::new()

    if !v.push(10) { return 1 }
    if !v.push(20) { return 2 }
    if !v.push(30) { return 3 }
    if !v.push(40) { return 4 }
    // Stop BEFORE the 5th push that triggers reallocation

    v.drop()  // This should free the 16-byte buffer
    return 42
}
