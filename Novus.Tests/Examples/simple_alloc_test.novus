// Example: Memory Allocation
//
// Description:
//   Tests AmigaOS memory allocation using the new MemoryBlock API.
//   Demonstrates Option-based allocation and automatic size tracking.
//
// Expected Output:
//   Exit code: 42

from std::memory::block import MemoryBlock
from std::ffi::amiga_consts import MEMF_PUBLIC

pub fn main() -> i32 {
    // Allocate 100 bytes using MemoryBlock
    let block_opt = MemoryBlock::alloc(100, MEMF_PUBLIC)

    match block_opt {
        Result::Ok(block) => {
            // Allocation succeeded
            // Use the memory (size is tracked automatically)
            let ptr: *u8 = block.ptr()
            ptr[0] = 42u8  // Write to first byte

            // Free the memory (no size parameter needed!)
            var mut_block = block
            mut_block.free()

            // Success
            return 42
        },
        Result::Err(_) => {
            // Allocation failed
            return 1
        }
    }
}
