// Example: Memory Allocation
//
// Description:
//   Tests AmigaOS memory allocation using exec.library AllocMem FFI call.
//
// Expected Output:
//   Exit code: 0

from std::exec import SafeAllocMem, SafeFreeMem
from std::ffi::amiga_consts import MEMF_PUBLIC

fn main() -> i32 {
    // Simple test: allocate and free memory
    let ptr: *u8 = SafeAllocMem(100u32, MEMF_PUBLIC)

    // Check if allocation succeeded
    if (u32)ptr == 0u32 {
        return 1  // Allocation failed
    }

    // Free the memory
    SafeFreeMem(ptr, 100u32)

    // Success
    return 42
}
