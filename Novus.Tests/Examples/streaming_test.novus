// Streaming Audio Test
// Demonstrates playing long audio files that exceed Paula's 128KB limit
//
// Uses AudioStreamer for seamless triple-buffered STEREO playback

from std::core import Result
from std::audio::ptplayer import AudioAsset
from std::audio::streaming import AudioStreamer
from std::audio::errors import AudioError
from std::io::file import write
from std::hardware::chipset import DISPLAY, DisplayType
from std::ffi::graphics import WaitTOF

// ============================================================================
// Long audio file stored in fast RAM
// ============================================================================

// This file is ~31 seconds at 44.1kHz stereo - way too big for chip RAM!
// The compiler converts it to 11kHz mono 8-bit (~340KB)
// AudioStreamer handles playback via triple-buffering in STEREO
@audio("invention.wav", chip = false, sample_rate = 11025)
static music: AudioAsset = []

// ============================================================================
// Main
// ============================================================================

pub fn main() -> i32 {
    write("Streaming Audio Test\n")

    let is_pal = DISPLAY() == DisplayType::PAL
    write("Display: %s\n", if is_pal { "PAL" } else { "NTSC" })

    // Get the correct period for PAL/NTSC
    let period = if is_pal { music.period_pal } else { music.period_ntsc }

    // Create the streamer in STEREO mode (one left + one right channel)
    let streamer_result = AudioStreamer::new_stereo(music.data, music.size, period, music.sample_rate)

    match streamer_result {
        Result::Ok(var streamer) => {

            // Start playing (no loop)
            let play_result = streamer.play(false)
            match play_result {
                Result::Ok(_) => {
                    // Main loop - tick the streamer regularly
                    var frame_count: u32 = 0
                    while streamer.is_playing() {
                        // Tick the streamer to refill buffers as needed
                        let tick_result = streamer.tick()
                        match tick_result {
                            Result::Ok(_) => {},
                            Result::Err(_) => {
                                write("\nTick error!\n")
                                break
                            }
                        }

                        // Show progress every 50 frames
                        if frame_count % 50 == 0 {
                            let progress = streamer.progress()
                            write("\r%3lu%%", progress)
                        }
                        frame_count++

                        // Wait for next vertical blank
                        WaitTOF()
                    }

                    write("\nDone\n")
                },
                Result::Err(_) => {
                    write("ERROR: Failed to start playback\n")
                    return 2
                }
            }

            // Streamer cleans up automatically on drop
        },
        Result::Err(err) => {
            match err {
                AudioError::AllocationFailed => write("ERROR: Could not allocate chip RAM buffers\n"),
                AudioError::InvalidChannel => write("ERROR: Invalid channel\n"),
                AudioError::NoAllocation => write("ERROR: No audio channels available\n"),
                AudioError::NoMsgPort => write("ERROR: Could not create message port\n"),
                AudioError::NoIORequest => write("ERROR: Could not create I/O request\n"),
                AudioError::DeviceOpenFailed => write("ERROR: Could not open audio.device\n"),
                _ => write("ERROR: Failed to create streamer\n")
            }
            return 1
        }
    }

    return 0
}
