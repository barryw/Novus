// Test automatic drop() for Vec - should not leak memory
from std::collections import Vec

fn test_single_vec() -> i32 {
    let vec_opt = Vec::with_capacity(10u32)
    match vec_opt {
        Some(v) => {
            // Bind to mutable variable
            var vec = v
            // Compiler should auto-inject: defer vec.drop()
            vec.push(42i32)
            vec.push(100i32)
            return 0
            // vec.drop() should be called here automatically
        },
        None => {
            return 1
        }
    }
}

fn test_two_vecs() -> i32 {
    let vec1_opt = Vec::with_capacity(5u32)
    match vec1_opt {
        Some(v1) => {
            var vec1 = v1
            // Compiler should auto-inject: defer vec1.drop()
            vec1.push(1i32)

            let vec2_opt = Vec::with_capacity(5u32)
            match vec2_opt {
                Some(v2) => {
                    var vec2 = v2
                    // Compiler should auto-inject: defer vec2.drop()
                    vec2.push(2i32)
                    return 0
                    // Should cleanup: vec2.drop(), then vec1.drop() (LIFO)
                },
                None => {
                    return 1
                    // Should cleanup: vec1.drop()
                }
            }
        },
        None => {
            return 1
        }
    }
}

fn main() -> i32 {
    let result1 = test_single_vec()
    let result2 = test_two_vecs()

    if result1 == 0 && result2 == 0 {
        return 0  // Success
    } else {
        return 1  // Failure
    }
}
