// Test Fixed32 assembly optimizations
from std::math::fixed import Fixed32, FIXED32_ONE
from std::test::test import expect_eq, expect_true

// ============================================================================
// Fixed32 Conversion Tests
// ============================================================================

@test
pub fn test_fixed32_from_to_i32() {
    let a = Fixed32::from_i32(5)
    expect_eq(a.to_i32(), 5, "from_i32(5).to_i32() = 5")

    let b = Fixed32::from_i32(-7)
    expect_eq(b.to_i32(), -7, "from_i32(-7).to_i32() = -7")

    let c = Fixed32::from_i32(0)
    expect_eq(c.to_i32(), 0, "from_i32(0).to_i32() = 0")
}

@test
pub fn test_fixed32_to_i32_rounded() {
    // 2.7 in 16.16 = 2*65536 + 0.7*65536 = 131072 + 45875 = 176947
    let a = Fixed32::from_raw(176947)
    expect_eq(a.to_i32_rounded(), 3, "to_i32_rounded(2.7) = 3")

    // 2.3 in 16.16 = 2*65536 + 0.3*65536 = 131072 + 19661 = 150733
    let b = Fixed32::from_raw(150733)
    expect_eq(b.to_i32_rounded(), 2, "to_i32_rounded(2.3) = 2")

    // 2.5 exactly should round to 3
    let c = Fixed32::from_raw(163840)  // 2.5
    expect_eq(c.to_i32_rounded(), 3, "to_i32_rounded(2.5) = 3")
}

// ============================================================================
// Fixed32 Multiplication Tests
// ============================================================================

@test
pub fn test_fixed32_mul_integers() {
    let a = Fixed32::from_i32(3)
    let b = Fixed32::from_i32(4)
    let product = a.mul(b)
    expect_eq(product.to_i32(), 12, "3 * 4 = 12")

    let c = Fixed32::from_i32(7)
    let d = Fixed32::from_i32(8)
    expect_eq(c.mul(d).to_i32(), 56, "7 * 8 = 56")
}

@test
pub fn test_fixed32_mul_fractional() {
    // 2.5 * 2.0 = 5.0
    let a = Fixed32::from_raw(163840)  // 2.5
    let b = Fixed32::from_i32(2)
    expect_eq(a.mul(b).to_i32(), 5, "2.5 * 2 = 5")

    // 0.5 * 0.5 = 0.25 (raw 16384)
    let half = Fixed32::from_raw(32768)
    let quarter = half.mul(half)
    expect_eq(quarter.to_raw(), 16384, "0.5 * 0.5 = 0.25 (raw 16384)")
}

@test
pub fn test_fixed32_mul_negative() {
    let neg = Fixed32::from_i32(-3)
    let pos = Fixed32::from_i32(2)
    expect_eq(neg.mul(pos).to_i32(), -6, "-3 * 2 = -6")

    let neg2 = Fixed32::from_i32(-4)
    expect_eq(neg.mul(neg2).to_i32(), 12, "-3 * -4 = 12")
}

@test
pub fn test_fixed32_mul_i32() {
    let a = Fixed32::from_i32(3)
    expect_eq(a.mul_i32(4).to_i32(), 12, "3 * 4 (scalar) = 12")

    let b = Fixed32::from_raw(163840)  // 2.5
    expect_eq(b.mul_i32(4).to_i32(), 10, "2.5 * 4 (scalar) = 10")
}

// ============================================================================
// Fixed32 Division Tests
// ============================================================================

@test
pub fn test_fixed32_div_integers() {
    let a = Fixed32::from_i32(10)
    let b = Fixed32::from_i32(2)
    expect_eq(a.div(b).to_i32(), 5, "10 / 2 = 5")

    let c = Fixed32::from_i32(100)
    let d = Fixed32::from_i32(4)
    expect_eq(c.div(d).to_i32(), 25, "100 / 4 = 25")
}

@test
pub fn test_fixed32_div_fractional() {
    // 1 / 2 = 0.5 (raw 32768)
    let one = Fixed32::from_i32(1)
    let two = Fixed32::from_i32(2)
    expect_eq(one.div(two).to_raw(), 32768, "1 / 2 = 0.5 (raw 32768)")

    // 1 / 4 = 0.25 (raw 16384)
    let four = Fixed32::from_i32(4)
    expect_eq(one.div(four).to_raw(), 16384, "1 / 4 = 0.25 (raw 16384)")
}

@test
pub fn test_fixed32_div_negative() {
    let neg10 = Fixed32::from_i32(-10)
    let two = Fixed32::from_i32(2)
    expect_eq(neg10.div(two).to_i32(), -5, "-10 / 2 = -5")

    let neg2 = Fixed32::from_i32(-2)
    expect_eq(neg10.div(neg2).to_i32(), 5, "-10 / -2 = 5")
}

@test
pub fn test_fixed32_div_i32() {
    let a = Fixed32::from_i32(20)
    expect_eq(a.div_i32(4).to_i32(), 5, "20 / 4 (scalar) = 5")

    let b = Fixed32::from_i32(100)
    expect_eq(b.div_i32(10).to_i32(), 10, "100 / 10 (scalar) = 10")
}

// ============================================================================
// Fixed32 Edge Cases
// ============================================================================

@test
pub fn test_fixed32_mul_by_one() {
    let a = Fixed32::from_i32(42)
    let one = Fixed32::one()
    expect_eq(a.mul(one).to_i32(), 42, "42 * 1.0 = 42")
}

@test
pub fn test_fixed32_div_by_one() {
    let a = Fixed32::from_i32(42)
    let one = Fixed32::one()
    expect_eq(a.div(one).to_i32(), 42, "42 / 1.0 = 42")
}

@test
pub fn test_fixed32_mul_by_zero() {
    let a = Fixed32::from_i32(42)
    let zero = Fixed32::zero()
    expect_eq(a.mul(zero).to_i32(), 0, "42 * 0 = 0")
}

// Note: Division by zero returns max value (handled in assembly)
@test
pub fn test_fixed32_div_by_zero() {
    let a = Fixed32::from_i32(42)
    let zero = Fixed32::zero()
    let result = a.div(zero)
    // Should return max i32 value
    expect_eq(result.to_raw(), 2147483647, "div by zero returns MAX_I32")
}
