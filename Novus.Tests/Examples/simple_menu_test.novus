// Simple menu test - just window with menu activation
// Testing menu event handling without GadTools for now

from std::ui::window import WindowHandle, WindowEvent
from std::io::file import write

pub fn main() -> i32 {
    write("=== Simple Menu Test ===\n")
    write("Creating window...\n")

    let window_result = WindowHandle::simple("Menu Test", 400, 300)

    match window_result {
        Result::Ok(window) => {
            write("Window created successfully\n")
            window.activate()

            write("Window active - close to exit\n\n")

            // Event loop
            forever {
                let event = window.wait_event()

                match event {
                    WindowEvent::Close => {
                        write("Close window requested - exiting\n")
                        break
                    },
                    WindowEvent::MenuPick(code) => {
                        write("Menu selected: code=")
                        write_u16(code)
                        write("\n")
                    },
                    _ => {}
                }
            }

            // Window automatically cleaned up by Drop
        },
        Result::Err(err) => {
            write("Failed to create window\n")
            return -1
        }
    }

    write("\nMenu test completed.\n")
    return 0
}

// Helper to write u16 values
fn write_u16(value: u16) {
    unsafe {
        if value == 0 {
            write("0")
        } else if value == 1 {
            write("1")
        } else if value == 2 {
            write("2")
        } else if value == 3 {
            write("3")
        } else if value == 4 {
            write("4")
        } else if value == 5 {
            write("5")
        } else {
            write("?")
        }
    }
}
