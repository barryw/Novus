// Test @sizeof(T) in generic impl methods

struct Vec<T> {
    ptr: *T,
    len: u32,
    capacity: u32,
}

impl<T> Vec<T> {
    fn element_size(&self) -> u32 {
        return @sizeof(T)
    }

    fn bytes_used(&self) -> u32 {
        let size: u32 = @sizeof(T)
        return self.len * size
    }

    fn bytes_capacity(&self) -> u32 {
        let size: u32 = @sizeof(T)
        return self.capacity * size
    }
}

fn main() -> i32 {
    var numbers: Vec<i32> = Vec {
        ptr: (*i32)0,
        len: 5u32,
        capacity: 10u32,
    }

    // Test calling methods that use @sizeof(T)
    let elem_size: u32 = numbers.element_size()
    let used: u32 = numbers.bytes_used()
    let cap_bytes: u32 = numbers.bytes_capacity()

    // elem_size should be 4 (sizeof i32)
    // used should be 20 (5 * 4)
    // cap_bytes should be 40 (10 * 4)

    return 0
}
