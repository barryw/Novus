from std::collections import Vec

fn main() -> i32 {
    // Create empty vector
    var v: Vec<i32> = Vec::new()

    // Test negation: !v.is_empty() should be false for empty vec
    let is_not_empty: bool = !v.is_empty()

    // If negation works, is_not_empty should be false (0)
    // So we should return 42
    if is_not_empty {
        return 1  // Failed - negation is wrong
    }

    return 42  // Success - negation works
}
