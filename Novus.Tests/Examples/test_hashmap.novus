// Comprehensive tests for HashMap<K, V>
// Run with: novus test test_hashmap.novus

from std::core import Option, Hash, Eq, Result
from std::collections::hashmap import HashMap, HashMapIter, HashMapIterMut, KeyValueRef, KeyValueMut
from std::test::test import expect_true, expect_false, expect_eq, fail

// ============================================================================
// Basic Creation Tests
// ============================================================================

@test("New hashmap should be empty")
pub fn test_new_is_empty() {
    match HashMap::<u32, u32>::new() {
        Result::Err(_) => fail("allocation failed"),
        Result::Ok(var map) => {
            expect_true(map.is_empty(), "new map should be empty")
            expect_eq(map.len(), 0, "new map len should be 0")
        }
    }
}

@test("New hashmap should have default capacity 16")
pub fn test_new_capacity() {
    match HashMap::<u32, u32>::new() {
        Result::Err(_) => fail("allocation failed"),
        Result::Ok(var map) => {
            expect_eq(map.capacity(), 16, "default capacity should be 16")
        }
    }
}

@test("with_capacity rounds up to power of 2")
pub fn test_with_capacity_power_of_two() {
    match HashMap::<u32, u32>::with_capacity(10) {
        Result::Err(_) => fail("allocation failed"),
        Result::Ok(var map) => {
            expect_eq(map.capacity(), 16, "10 should round to 16")
        }
    }

    match HashMap::<u32, u32>::with_capacity(17) {
        Result::Err(_) => fail("allocation failed"),
        Result::Ok(var map) => {
            expect_eq(map.capacity(), 32, "17 should round to 32")
        }
    }
}

// ============================================================================
// Insert Tests
// ============================================================================

@test("Insert single item")
pub fn test_insert_single() {
    match HashMap::<u32, u32>::new() {
        Result::Err(_) => fail("allocation failed"),
        Result::Ok(var map) => {
            let _ = map.insert(1, 100)
            expect_eq(map.len(), 1, "len should be 1 after insert")
            expect_false(map.is_empty(), "should not be empty")
        }
    }
}

@test("Insert multiple items")
pub fn test_insert_multiple() {
    match HashMap::<u32, u32>::new() {
        Result::Err(_) => fail("allocation failed"),
        Result::Ok(var map) => {
            let _ = map.insert(1, 100)
            let _ = map.insert(2, 200)
            let _ = map.insert(3, 300)
            expect_eq(map.len(), 3, "len should be 3")
        }
    }
}

@test("Insert returns old value on update")
pub fn test_insert_update() {
    match HashMap::<u32, u32>::new() {
        Result::Err(_) => fail("allocation failed"),
        Result::Ok(var map) => {
            // First insert returns Result::Ok(Option::None)
            match map.insert(1, 100) {
                Result::Err(_) => fail("insert failed"),
                Result::Ok(Option::Some(_)) => fail("first insert should return None"),
                Result::Ok(Option::None) => { }
            }

            // Second insert with same key returns old value
            match map.insert(1, 200) {
                Result::Err(_) => fail("insert failed"),
                Result::Ok(opt) => {
                    match opt {
                        Option::None => fail("update should return old value"),
                        Option::Some(old) => expect_eq(old, 100, "old value should be 100")
                    }
                }
            }

            expect_eq(map.len(), 1, "len should still be 1")
        }
    }
}

// ============================================================================
// Get Tests
// ============================================================================

@test("Get existing key returns value")
pub fn test_get_existing() {
    match HashMap::<u32, u32>::new() {
        Result::Err(_) => fail("allocation failed"),
        Result::Ok(var map) => {
            let _ = map.insert(42, 1234)

            let key: u32 = 42
            match map.get(&key) {
                Option::None => fail("should find key 42"),
                Option::Some(val_ref) => expect_eq(*val_ref, 1234, "value should be 1234")
            }
        }
    }
}

@test("Get non-existing key returns None")
pub fn test_get_nonexisting() {
    match HashMap::<u32, u32>::new() {
        Result::Err(_) => fail("allocation failed"),
        Result::Ok(var map) => {
            let _ = map.insert(1, 100)

            let key: u32 = 999
            match map.get(&key) {
                Option::Some(_) => fail("should not find key 999"),
                Option::None => { }
            }
        }
    }
}

@test("Get on empty map returns None")
pub fn test_get_empty() {
    match HashMap::<u32, u32>::new() {
        Result::Err(_) => fail("allocation failed"),
        Result::Ok(var map) => {
            let key: u32 = 1
            match map.get(&key) {
                Option::Some(_) => fail("empty map should return None"),
                Option::None => { }
            }
        }
    }
}

// ============================================================================
// Get Mut Tests
// ============================================================================

@test("get_mut allows in-place modification")
pub fn test_get_mut_modify() {
    match HashMap::<u32, u32>::new() {
        Result::Err(_) => fail("allocation failed"),
        Result::Ok(var map) => {
            let _ = map.insert(1, 100)

            let key: u32 = 1
            match map.get_mut(&key) {
                Option::None => fail("should find key"),
                Option::Some(val_ref) => {
                    *val_ref = 999
                }
            }

            // Verify modification
            match map.get(&key) {
                Option::None => fail("should still find key"),
                Option::Some(val) => expect_eq(*val, 999, "value should be modified to 999")
            }
        }
    }
}

