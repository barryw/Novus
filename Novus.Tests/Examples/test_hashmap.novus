}

@test("contains_key returns false for non-existing key")
pub fn test_contains_nonexisting() {
    match HashMap::<u32, u32>::new() {
        Result::Err(_) => fail("allocation failed"),
        Result::Ok(var map) => {
            let _ = map.insert(42, 100)
            let key: u32 = 999
            expect_false(map.contains_key(&key), "should not contain key 999")
        }
    }
}

// ============================================================================
// Remove Tests
// ============================================================================

@test("Remove existing key returns value")
pub fn test_remove_existing() {
    match HashMap::<u32, u32>::new() {
        Result::Err(_) => fail("allocation failed"),
        Result::Ok(var map) => {
            let _ = map.insert(1, 100)
            let _ = map.insert(2, 200)

            let key: u32 = 1
            match map.remove(&key) {
                Option::None => fail("should remove key 1"),
                Option::Some(val) => expect_eq(val, 100, "removed value should be 100")
            }

            expect_eq(map.len(), 1, "len should be 1 after remove")
            expect_false(map.contains_key(&key), "should not contain removed key")
        }
    }
}

@test("Remove non-existing key returns None")
pub fn test_remove_nonexisting() {
    match HashMap::<u32, u32>::new() {
        Result::Err(_) => fail("allocation failed"),
        Result::Ok(var map) => {
            let _ = map.insert(1, 100)

            let key: u32 = 999
            match map.remove(&key) {
                Option::Some(_) => fail("should not find key to remove"),
                Option::None => { }
            }

            expect_eq(map.len(), 1, "len should still be 1")
        }
    }
}

@test("Remove all items leaves empty map")
pub fn test_remove_all() {
    match HashMap::<u32, u32>::new() {
        Result::Err(_) => fail("allocation failed"),
        Result::Ok(var map) => {
            let _ = map.insert(1, 100)
            let _ = map.insert(2, 200)
            let _ = map.insert(3, 300)

            let k1: u32 = 1
            let k2: u32 = 2
            let k3: u32 = 3
            map.remove(&k1)
            map.remove(&k2)
            map.remove(&k3)

            expect_true(map.is_empty(), "should be empty after removing all")
            expect_eq(map.len(), 0, "len should be 0")
        }
    }
}

// ============================================================================
// Clear Tests
// ============================================================================

@test("Clear empties the map")
pub fn test_clear() {
    match HashMap::<u32, u32>::new() {
        Result::Err(_) => fail("allocation failed"),
        Result::Ok(var map) => {
            let _ = map.insert(1, 100)
            let _ = map.insert(2, 200)
            let _ = map.insert(3, 300)

            map.clear()

            expect_true(map.is_empty(), "should be empty after clear")
            expect_eq(map.len(), 0, "len should be 0")
            expect_eq(map.tombstone_count(), 0, "tombstones should be 0")
        }
    }
}

@test("Clear preserves capacity")
pub fn test_clear_preserves_capacity() {
    match HashMap::<u32, u32>::with_capacity(64) {
        Result::Err(_) => fail("allocation failed"),
        Result::Ok(var map) => {
            let _ = map.insert(1, 100)
            let cap_before: u32 = map.capacity()

            map.clear()

            expect_eq(map.capacity(), cap_before, "capacity should be preserved")
        }
    }
}

// ============================================================================
// Collision Tests (Linear Probing)
// ============================================================================

@test("Handles hash collisions correctly")
pub fn test_collisions() {
    match HashMap::<u32, u32>::with_capacity(16) {
        Result::Err(_) => fail("allocation failed"),
        Result::Ok(var map) => {
            // Insert keys that will likely collide (multiples of 16 with capacity 16)
            // Hash of 0, 16, 32 will all map to index 0
            let _ = map.insert(0, 1000)
            let _ = map.insert(16, 1016)
            let _ = map.insert(32, 1032)

            expect_eq(map.len(), 3, "should have 3 items")

            let k0: u32 = 0
            let k16: u32 = 16
            let k32: u32 = 32

            match map.get(&k0) {
                Option::None => fail("should find key 0"),
                Option::Some(v) => expect_eq(*v, 1000, "value for 0")
            }

            match map.get(&k16) {
                Option::None => fail("should find key 16"),
                Option::Some(v) => expect_eq(*v, 1016, "value for 16")
            }

            match map.get(&k32) {
                Option::None => fail("should find key 32"),
                Option::Some(v) => expect_eq(*v, 1032, "value for 32")
            }
        }
    }
}

// ============================================================================
// Tombstone Tests
// ============================================================================

@test("Tombstones allow finding keys after removal")
pub fn test_tombstone_probing() {
    match HashMap::<u32, u32>::with_capacity(16) {
        Result::Err(_) => fail("allocation failed"),
        Result::Ok(var map) => {
            // Insert colliding keys
            let _ = map.insert(0, 100)
            let _ = map.insert(16, 200)  // Collides, probes to next slot
            let _ = map.insert(32, 300)  // Collides, probes further

            // Remove middle key (creates tombstone)
            let k16: u32 = 16
            map.remove(&k16)

            // Should still find key 32 (probing continues past tombstone)
            let k32: u32 = 32
            match map.get(&k32) {
                Option::None => fail("should find key 32 past tombstone"),
                Option::Some(v) => expect_eq(*v, 300, "value for 32")
            }
        }
    }
}

@test("Tombstones are reused on insert")
pub fn test_tombstone_reuse() {
    match HashMap::<u32, u32>::with_capacity(16) {
        Result::Err(_) => fail("allocation failed"),
        Result::Ok(var map) => {
            let _ = map.insert(0, 100)
            let _ = map.insert(16, 200)

            let k16: u32 = 16
            map.remove(&k16)
            expect_eq(map.tombstone_count(), 1, "should have 1 tombstone")

            // Re-insert same key (reuses tombstone)
            let _ = map.insert(16, 999)
            // Tombstone count should decrease since we reused it
            // (or stay same if inserted in different slot)
            expect_eq(map.len(), 2, "len should be 2")
        }
    }
}

// ============================================================================
// Reserve Tests
// ============================================================================

@test("reserve increases capacity")
pub fn test_reserve() {
    match HashMap::<u32, u32>::new() {
        Result::Err(_) => fail("allocation failed"),
        Result::Ok(var map) => {
            let old_cap: u32 = map.capacity()

            match map.reserve(100) {
                Result::Err(_) => fail("reserve should succeed"),
                Result::Ok(_) => {}
            }

            // Capacity should increase to accommodate 100 more items
            expect_true(map.capacity() > old_cap, "capacity should increase")
        }
    }
}

@test("reserve with sufficient capacity does nothing")
pub fn test_reserve_sufficient() {
    match HashMap::<u32, u32>::with_capacity(64) {
        Result::Err(_) => fail("allocation failed"),
        Result::Ok(var map) => {
            let _ = map.insert(1, 100)

            let old_cap: u32 = map.capacity()
            match map.reserve(10) {
                Result::Err(_) => fail("reserve should succeed"),
                Result::Ok(_) => {}
            }

            expect_eq(map.capacity(), old_cap, "capacity should not change")
        }
    }
}

// ============================================================================
// Compact Tests
// ============================================================================

@test("compact removes tombstones")
pub fn test_compact() {
    match HashMap::<u32, u32>::new() {
        Result::Err(_) => fail("allocation failed"),
        Result::Ok(var map) => {
            // Insert and remove several items to create tombstones
            var i: u32 = 0
            while i < 10 {
                let _ = map.insert(i, i * 100)
                i = i + 1
            }

            i = 0
            while i < 5 {
                let key: u32 = i
                map.remove(&key)
                i = i + 1
            }

            // May have tombstones (auto-compact might have run)
            let tombstones_before: u32 = map.tombstone_count()

            match map.compact() {
                Result::Ok(_) => {},
                Result::Err(_) => fail("compact should succeed"),
            }

            expect_eq(map.tombstone_count(), 0, "should have 0 tombstones after compact")
            expect_eq(map.len(), 5, "len should still be 5")
        }
    }
}

// ============================================================================
// Shrink to Fit Tests
// ============================================================================

@test("shrink_to_fit reduces capacity")
pub fn test_shrink_to_fit() {
    match HashMap::<u32, u32>::with_capacity(128) {
        Result::Err(_) => fail("allocation failed"),
        Result::Ok(var map) => {
            // Insert just a few items
            let _ = map.insert(1, 100)
            let _ = map.insert(2, 200)
            let _ = map.insert(3, 300)

            expect_eq(map.capacity(), 128, "initial capacity")

            match map.shrink_to_fit() {
                Result::Ok(_) => {},
                Result::Err(_) => fail("shrink_to_fit should succeed"),
            }

            // Capacity should reduce (but minimum is 16)
            expect_true(map.capacity() < 128, "capacity should decrease")
            expect_true(map.capacity() >= 16, "capacity should be at least 16")

            // Data should still be accessible
            let k1: u32 = 1
            match map.get(&k1) {
                Option::None => fail("should still find key 1"),
                Option::Some(v) => expect_eq(*v, 100, "value should be preserved")
            }
        }
    }
}

@test("shrink_to_fit on empty map frees memory")
pub fn test_shrink_empty() {
    match HashMap::<u32, u32>::new() {
        Result::Err(_) => fail("allocation failed"),
        Result::Ok(var map) => {
            let _ = map.insert(1, 100)
            let k: u32 = 1
            map.remove(&k)

            match map.shrink_to_fit() {
                Result::Ok(_) => {},
                Result::Err(_) => fail("shrink_to_fit should succeed"),
            }
            expect_eq(map.capacity(), 0, "empty map capacity should be 0")
        }
    }
}

// ============================================================================
// Iterator Tests
// ============================================================================

@test("iter visits all entries")
pub fn test_iter_all() {
    match HashMap::<u32, u32>::new() {
        Result::Err(_) => fail("allocation failed"),
        Result::Ok(var map) => {
            let _ = map.insert(1, 100)
            let _ = map.insert(2, 200)
            let _ = map.insert(3, 300)

            var iter: HashMapIter<u32, u32> = map.iter()
            var count: u32 = 0
            var sum: u32 = 0

            var done: bool = false
            while !done {
                match iter.next() {
                    Option::Some(kv) => {
                        count = count + 1
                        sum = sum + *kv.value
                    },
                    Option::None => {
                        done = true
                    }
                }
            }

            expect_eq(count, 3, "should iterate 3 items")
            expect_eq(sum, 600, "sum of values should be 600")
        }
    }
}

@test("iter skips tombstones")
pub fn test_iter_skips_tombstones() {
    match HashMap::<u32, u32>::new() {
        Result::Err(_) => fail("allocation failed"),
        Result::Ok(var map) => {
            let _ = map.insert(1, 100)
            let _ = map.insert(2, 200)
            let _ = map.insert(3, 300)

            let k2: u32 = 2
            map.remove(&k2)

            var iter: HashMapIter<u32, u32> = map.iter()
            var count: u32 = 0

            var done: bool = false
            while !done {
                match iter.next() {
                    Option::Some(_) => {
                        count = count + 1
                    },
                    Option::None => {
                        done = true
                    }
                }
            }

            expect_eq(count, 2, "should iterate 2 items (skipping tombstone)")
        }
    }
}

@test("iter on empty map returns None immediately")
pub fn test_iter_empty() {
    match HashMap::<u32, u32>::new() {
        Result::Err(_) => fail("allocation failed"),
        Result::Ok(var map) => {
            var iter: HashMapIter<u32, u32> = map.iter()

            match iter.next() {
                Option::Some(_) => fail("empty map iter should return None"),
                Option::None => { }
            }
        }
    }
}

@test("iter reset allows re-iteration")
pub fn test_iter_reset() {
    match HashMap::<u32, u32>::new() {
        Result::Err(_) => fail("allocation failed"),
        Result::Ok(var map) => {
            let _ = map.insert(1, 100)
            let _ = map.insert(2, 200)

            var iter: HashMapIter<u32, u32> = map.iter()

            // First iteration
            var count1: u32 = 0
            var done: bool = false
            while !done {
                match iter.next() {
                    Option::Some(_) => {
                        count1 = count1 + 1
                    },
                    Option::None => {
                        done = true
                    }
                }
            }

            // Reset and iterate again
            iter.reset()
            var count2: u32 = 0
            done = false
            while !done {
                match iter.next() {
                    Option::Some(_) => {
                        count2 = count2 + 1
                    },
                    Option::None => {
                        done = true
                    }
                }
            }

            expect_eq(count1, 2, "first iteration count")
            expect_eq(count2, 2, "second iteration count after reset")
        }
    }
}

