// Note: iter_mut test temporarily disabled due to code generation bug with
// mutable reference struct fields. The bug is that `*kv.value = x` generates
// `kv.value = x` instead of `*kv.value = x` in C. This needs a separate fix.

// ============================================================================
// Load Factor and Resize Tests
// ============================================================================

@test("load_factor returns correct percentage")
pub fn test_load_factor() {
    match HashMap::<u32, u32>::with_capacity(16) {
        Result::Err(_) => fail("allocation failed"),
        Result::Ok(var map) => {
            expect_eq(map.load_factor(), 0, "empty map load factor")

            let _ = map.insert(1, 100)
            let _ = map.insert(2, 200)
            let _ = map.insert(3, 300)
            let _ = map.insert(4, 400)

            // 4/16 = 25%
            expect_eq(map.load_factor(), 25, "25% load factor")
        }
    }
}

@test("Auto-resize on high load")
pub fn test_auto_resize() {
    match HashMap::<u32, u32>::with_capacity(16) {
        Result::Err(_) => fail("allocation failed"),
        Result::Ok(var map) => {
            // Insert enough to trigger resize (>70% of 16 = 12 items)
            var i: u32 = 0
            while i < 15 {
                let _ = map.insert(i, i * 100)
                i = i + 1
            }

            expect_true(map.capacity() > 16, "should have resized")
            expect_eq(map.len(), 15, "all items should be present")

            // Verify all items still accessible
            i = 0
            while i < 15 {
                let key: u32 = i
                match map.get(&key) {
                    Option::None => fail("missing key after resize"),
                    Option::Some(v) => {
                        expect_eq(*v, i * 100, "value should be preserved")
                    }
                }
                i = i + 1
            }
        }
    }
}

// ============================================================================
// Edge Cases
// ============================================================================

@test("Insert and get with key 0")
pub fn test_key_zero() {
    match HashMap::<u32, u32>::new() {
        Result::Err(_) => fail("allocation failed"),
        Result::Ok(var map) => {
            let _ = map.insert(0, 12345)

            let k: u32 = 0
            match map.get(&k) {
                Option::None => fail("should find key 0"),
                Option::Some(v) => expect_eq(*v, 12345, "value for key 0")
            }
        }
    }
}

@test("Many inserts and removes (stress test)")
pub fn test_stress() {
    match HashMap::<u32, u32>::new() {
        Result::Err(_) => fail("allocation failed"),
        Result::Ok(var map) => {
            // Insert 100 items
            var i: u32 = 0
            while i < 100 {
                let _ = map.insert(i, i * 10)
                i = i + 1
            }

            expect_eq(map.len(), 100, "should have 100 items")

            // Remove odd keys
            i = 1
            while i < 100 {
                var k: u32 = i
                map.remove(&k)
                i = i + 2
            }

            expect_eq(map.len(), 50, "should have 50 items after removing odds")

            // Verify even keys still present
            i = 0
            while i < 100 {
                k = i
                if map.contains_key(&k) {
                    // Should be even
                    expect_eq(i & 1, 0, "only even keys should remain")
                }
                i = i + 1
            }
        }
    }
}
