// CPU Fat Binary Benchmark Test
// This program demonstrates automatic CPU detection and optimization
// Compile with: novus cpu_benchmark.novus -o cpu_benchmark
// (Default --cpu auto creates a fat binary that works optimally on all CPUs)

from dos import Output, Write
from system import CPU, FPU, SystemCPU, SystemFPU

// Print header - CPU detection happens automatically in runtime
fn print_header() {
    let stdout = Output()

    Write(stdout, (i32)"========================================\n", 41)
    Write(stdout, (i32)"   Novus CPU Fat Binary Benchmark\n", 35)
    Write(stdout, (i32)"========================================\n", 41)
    Write(stdout, (i32)"\n", 1)

    // Display detected CPU
    Write(stdout, (i32)"Detected CPU: ", 14)
    match CPU {
        M68000 => Write(stdout, (i32)"68000\n", 6),
        M68010 => Write(stdout, (i32)"68010\n", 6),
        M68020 => Write(stdout, (i32)"68020\n", 6),
        M68030 => Write(stdout, (i32)"68030\n", 6),
        M68040 => Write(stdout, (i32)"68040\n", 6),
        M68060 => Write(stdout, (i32)"68060\n", 6),
    }

    // Display detected FPU
    Write(stdout, (i32)"Detected FPU: ", 14)
    match FPU {
        None => Write(stdout, (i32)"None\n", 5),
        M68881 => Write(stdout, (i32)"68881\n", 6),
        M68882 => Write(stdout, (i32)"68882\n", 6),
        M68040 => Write(stdout, (i32)"68040 FPU\n", 10),
        M68060 => Write(stdout, (i32)"68060 FPU\n", 10),
    }

    Write(stdout, (i32)"\n", 1)
    Write(stdout, (i32)"This binary contains 3 optimized versions:\n", 44)
    Write(stdout, (i32)"  - 68000: 16x16 multiply routines\n", 35)
    Write(stdout, (i32)"  - 68020+: muls.l, divu.l, barrel shifter\n", 43)
    Write(stdout, (i32)"  - 68060: shift/add sequences\n", 31)
    Write(stdout, (i32)"\n", 1)
    Write(stdout, (i32)"Runtime automatically selects the best\n", 39)
    Write(stdout, (i32)"version for your CPU!\n", 22)
    Write(stdout, (i32)"\n", 1)
}

// Benchmark: Multiply operations (optimized per CPU)
fn benchmark_multiply() -> u32 {
    var result: u32 = 0
    let iterations = 1000

    // Test multiply by 2 (optimized to shift/add on 68060)
    var i = 0
    while i < iterations {
        result = i * 2
        i = i + 1
    }

    // Test multiply by 3 (optimized to x+2x on 68060)
    i = 0
    while i < iterations {
        result = result + (i * 3)
        i = i + 1
    }

    // Test multiply by 10 (optimized to shift/add on 68060)
    i = 0
    while i < iterations {
        result = result + (i * 10)
        i = i + 1
    }

    // Test multiply by 256 (power of 2 - shift)
    i = 0
    while i < iterations {
        result = result + (i * 256)
        i = i + 1
    }

    return result
}

// Benchmark: Division operations (optimized per CPU)
fn benchmark_divide() -> u32 {
    var result: u32 = 0
    let iterations = 500

    // Test divide by 2 (power of 2 - optimized to shift)
    var i: u32 = 1000000
    var count = 0
    while count < iterations {
        result = result + (i / 2)
        count = count + 1
    }

    // Test divide by 4 (power of 2 - optimized to shift)
    i = 1000000
    count = 0
    while count < iterations {
        result = result + (i / 4)
        count = count + 1
    }

    // Test divide by 8 (power of 2 - optimized to shift)
    i = 1000000
    count = 0
    while count < iterations {
        result = result + (i / 8)
        count = count + 1
    }

    // Test divide by 256 (power of 2 - optimized to shift)
    i = 1000000
    count = 0
    while count < iterations {
        result = result + (i / 256)
        count = count + 1
    }

    return result
}

// Benchmark: Shift operations (uses barrel shifter on 68020+)
fn benchmark_shifts() -> u32 {
    var result: u32 = 0
    let iterations = 1000

    // Test left shift by 4 (uses barrel shifter on 68020+)
    var i: u32 = 1
    var count = 0
    while count < iterations {
        result = result + (i << 4)
        count = count + 1
    }

    // Test left shift by 16 (uses barrel shifter on 68020+)
    i = 1
    count = 0
    while count < iterations {
        result = result + (i << 16)
        count = count + 1
    }

    // Test right shift by 8
    i = $12345678
    count = 0
    while count < iterations {
        result = result + (i >> 8)
        count = count + 1
    }

    return result
}

// Complex calculation benchmark
// Formula: result = ((x * 10) + y) >> 2
fn benchmark_complex() -> u32 {
    let iterations = 500
    var result: u32 = 0

    var i = 0
    while i < iterations {
        let x = i
        let y = i * 2
        result = result + (((x * 10) + y) >> 2)
        i = i + 1
    }

    return result
}

// Practical example: Calculate Fibonacci numbers
fn benchmark_fibonacci() -> u32 {
    var a: u32 = 0
    var b: u32 = 1
    var i = 0

    while i < 20 {
        let next = a + b
        a = b
        b = next
        i = i + 1
    }

    return b
}

// Run all benchmarks with output
pub fn main() -> u32 {
    let stdout = Output()

    print_header()

    Write(stdout, (i32)"Running benchmarks...\n", 22)
    Write(stdout, (i32)"(Each test runs many iterations)\n", 33)
    Write(stdout, (i32)"\n", 1)

    Write(stdout, (i32)"--- Multiply Benchmark ---\n", 27)
    Write(stdout, (i32)"Testing: x*2, x*3, x*10, x*256\n", 31)
    let result1 = benchmark_multiply()
    Write(stdout, (i32)"Completed 4000 multiply operations\n", 36)
    Write(stdout, (i32)"\n", 1)

    Write(stdout, (i32)"--- Division Benchmark ---\n", 27)
    Write(stdout, (i32)"Testing: x/2, x/4, x/8, x/256\n", 30)
    let result2 = benchmark_divide()
    Write(stdout, (i32)"Completed 2000 division operations\n", 36)
    Write(stdout, (i32)"\n", 1)

    Write(stdout, (i32)"--- Shift Benchmark ---\n", 24)
    Write(stdout, (i32)"Testing: x<<4, x<<16, x>>8\n", 27)
    let result3 = benchmark_shifts()
    Write(stdout, (i32)"Completed 3000 shift operations\n", 33)
    Write(stdout, (i32)"\n", 1)

    Write(stdout, (i32)"--- Complex Calculation ---\n", 28)
    Write(stdout, (i32)"Formula: ((x * 10) + y) >> 2\n", 29)
    let result4 = benchmark_complex()
    Write(stdout, (i32)"Completed 500 complex calculations\n", 36)
    Write(stdout, (i32)"\n", 1)

    Write(stdout, (i32)"--- Fibonacci Benchmark ---\n", 28)
    let result5 = benchmark_fibonacci()
    Write(stdout, (i32)"Calculated 20th Fibonacci number: 6765\n", 40)
    Write(stdout, (i32)"\n", 1)

    Write(stdout, (i32)"========================================\n", 41)
    Write(stdout, (i32)"   Benchmark Complete!\n", 23)
    Write(stdout, (i32)"========================================\n", 41)
    Write(stdout, (i32)"\n", 1)
    Write(stdout, (i32)"This binary automatically selected the\n", 39)
    Write(stdout, (i32)"optimal code path for your CPU!\n", 32)
    Write(stdout, (i32)"\n", 1)
    Write(stdout, (i32)"Results vary by CPU due to different\n", 37)
    Write(stdout, (i32)"optimization strategies.\n", 25)

    return 0
}
