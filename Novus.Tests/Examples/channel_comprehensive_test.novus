// @covers amiga::sys::exec::channel::bounded_channel()
@test("Create bounded channel")
pub fn test_bounded_creation() {
    let result = bounded_channel::<i32>()
    match result {
        Result::Err(_) => fail("Failed to create bounded channel"),
        Result::Ok(pair) => {
            // Must destructure to ensure Drop is called on inner elements
            let (_tx, _rx) = pair
        }
    }
}

// @covers amiga::sys::exec::channel::BoundedSender::is_valid()
// @covers amiga::sys::exec::channel::BoundedSender::try_send(T)
// @covers amiga::sys::exec::channel::BoundedReceiver::recv()
// @covers amiga::sys::exec::channel::BoundedReceiver::try_recv()
@test("Bounded: send and receive a value")
pub fn test_bounded_send_recv() {
    let (tx, rx) = bounded_channel::<i32>().unwrap()

    // Use try_send to avoid blocking in single-process test
    expect(tx.is_valid(), "bounded sender is valid")
    let sent = tx.try_send(55)
    expect_true(sent.is_ok(), "try_send succeeded")
    expect_eq(rx.recv(), 55, "bounded blocking receive returns queued value")
    expect(rx.try_recv().is_none(), "bounded channel is empty after receive")
}

@test("Bounded: FIFO ordering with try_send")
pub fn test_bounded_fifo_ordering() {
    let (tx, rx) = bounded_channel::<i32>().unwrap()

    // Use try_send to avoid blocking in single-process test
    let _ = tx.try_send(1)
    let _ = tx.try_send(2)
    let _ = tx.try_send(3)

    // Receive in order
    let v1 = rx.try_recv()
    let v2 = rx.try_recv()
    let v3 = rx.try_recv()

    match v1 {
        Option::Some(v) => expect_eq(v, 1, "first value"),
        Option::None => fail("first recv failed")
    }

    match v2 {
        Option::Some(v) => expect_eq(v, 2, "second value"),
        Option::None => fail("second recv failed")
    }

    match v3 {
        Option::Some(v) => expect_eq(v, 3, "third value"),
        Option::None => fail("third recv failed")
    }
}

@test("Bounded: try_recv on empty channel returns None")
pub fn test_bounded_empty_channel() {
    let (tx, rx) = bounded_channel::<i32>().unwrap()

    match rx.try_recv() {
        Option::None => {}, // Expected
        Option::Some(_) => fail("Got value from empty channel")
    }
}

// @covers amiga::sys::exec::channel::BoundedReceiver::signal()
// @covers amiga::sys::exec::channel::BoundedReceiver::check(u32)
@test("Bounded: signal mask is valid")
pub fn test_bounded_signal_mask() {
    let (tx, rx) = bounded_channel::<i32>().unwrap()

    let mask = rx.signal()

    expect_true(mask > 0, "signal mask is non-zero")

    // Verify it's a power of 2 (only one bit set)
    let is_power_of_2 = (mask & (mask - 1)) == 0
    expect_true(is_power_of_2, "signal mask is a power of 2")
    expect_true(rx.check(mask), "bounded receiver recognizes its signal")
    expect_false(rx.check(0), "bounded receiver rejects unrelated signals")
}

// @covers amiga::sys::exec::channel::BoundedSender::send(T)
// @covers amiga::sys::exec::channel::BoundedReceiver::detach()
// @covers amiga::sys::exec::channel::BoundedReceiver::port()
// @covers amiga::sys::exec::channel::PortHandoff::new(*MsgPort)
// @covers amiga::sys::exec::channel::PortHandoff::port()
// @covers amiga::sys::exec::channel::PortHandoff::wait_for_ready()
// @covers amiga::sys::exec::channel::PortOwnership::port()
// @covers amiga::sys::exec::channel::PortOwnership::signal()
// @covers amiga::sys::exec::channel::complete_handoff(*PortHandoff)
@test("Bounded: blocking send with responder task")
pub fn test_bounded_blocking_send() {
    var (tx, rx) = bounded_channel::<i32>().unwrap()

    // Create handoff structure - this handles the race-free port transfer
    var handoff = match PortHandoff::new(rx.port()) {
        Result::Ok(value) => value,
        Result::Err(_) => {
            fail("Failed to create port handoff")
            return
        }
    }
    expect(handoff.port() == rx.port(), "handoff retains the transferred port")

    // Detach the port from rx - child will own it now
    // This prevents rx.drop() from calling DeleteMsgPort on a port
    // that the child has taken over
    rx.detach()

    // Spawn task with the handoff pointer
    let spawn_result = spawn_task_fn_with_ptr("BoundedResponder", bounded_responder_task, (*u8)&handoff, 8192)
    match spawn_result {
        Result::Err(_) => {
            fail("Failed to spawn responder task")
            return
        },
        Result::Ok(handle) => {
            // Wait for child to complete the handoff (take over port and signal us)
            // This is race-free - no arbitrary delays needed!
            if handoff.wait_for_ready().is_err() {
                fail("Failed while waiting for port handoff")
                return
            }

            // Now send - this will block until the task replies
            let sent = tx.send(999)
            expect_true(sent.is_ok(), "blocking send succeeded")
        }
    }
}

// @covers amiga::sys::exec::channel::take_over_port(*MsgPort)
@test("Bounded: detached port can be taken over")
pub fn test_take_over_port() {
    var (tx, rx) = bounded_channel::<i32>().unwrap()
    let port = rx.detach()
    match take_over_port(port) {
        Result::Ok(mask) => expect(mask != 0, "taken-over port receives a signal"),
        Result::Err(_) => fail("detached port takeover failed"),
    }
    DeleteMsgPort(port)
}

// ============================================================================
// Oneshot Channel Tests
// ============================================================================

// @covers amiga::sys::exec::channel::oneshot()
@test("Create oneshot channel")
pub fn test_oneshot_creation() {
    let result = oneshot::<i32>()
    match result {
        Result::Err(_) => fail("Failed to create oneshot"),
        Result::Ok(pair) => {
            // Must destructure to ensure Drop is called on inner elements
            let (_tx, _rx) = pair
        }
    }
}

// @covers amiga::sys::exec::channel::OneshotSender::send(T)
// @covers amiga::sys::exec::channel::OneshotReceiver::recv()
// @covers amiga::sys::exec::channel::OneshotReceiver::try_recv()
@test("Oneshot: send and receive a value")
pub fn test_oneshot_send_recv() {
    let (tx, rx) = oneshot::<i32>().unwrap()

    let sent = tx.send(777)
    expect_true(sent.is_ok(), "send succeeded")

    expect_eq(rx.recv().unwrap(), 777, "blocking oneshot receive returns queued value")
    expect(rx.try_recv().is_err(), "oneshot cannot receive twice")
}

@test("Oneshot: can only send once")
pub fn test_oneshot_single_send_only() {
    let (tx, rx) = oneshot::<i32>().unwrap()

    let first = tx.send(888)
    let second = tx.send(999)

    expect_true(first.is_ok(), "first send succeeded")
    expect_true(second.is_err(), "second send failed")
}

@test("Oneshot: can only receive once")
pub fn test_oneshot_single_recv_only() {
    let (tx, rx) = oneshot::<i32>().unwrap()

    let _ = tx.send(123)

    let first = rx.try_recv()
    let second = rx.try_recv()

    match first {
        Result::Err(_) => fail("first recv failed"),
        Result::Ok(value) => match value {
            Option::Some(v) => expect_eq(v, 123, "first recv got value"),
            Option::None => fail("first recv had no value")
        }
    }

    match second {
        Result::Err(_) => {}, // Already received is an explicit error
        Result::Ok(_) => fail("second recv unexpectedly succeeded")
    }
}

@test("Oneshot: try_recv on empty channel returns None")
pub fn test_oneshot_empty_channel() {
    let (tx, rx) = oneshot::<i32>().unwrap()

    match rx.try_recv() {
        Result::Err(_) => fail("try_recv failed"),
        Result::Ok(value) => match value {
            Option::None => {}, // Expected
            Option::Some(_) => fail("Got value without send")
        }
    }
}

// @covers amiga::sys::exec::channel::OneshotSender::is_sent()
@test("Oneshot: is_sent tracks send state")
pub fn test_oneshot_is_sent() {
    let (tx, rx) = oneshot::<i32>().unwrap()

    let before = tx.is_sent()
    let _ = tx.send(456)
    let after = tx.is_sent()

    expect_false(before, "is_sent false before send")
    expect_true(after, "is_sent true after send")
}

// @covers amiga::sys::exec::channel::OneshotReceiver::is_complete()
@test("Oneshot: is_complete tracks receive state")
pub fn test_oneshot_is_complete() {
    let (tx, rx) = oneshot::<i32>().unwrap()

    let before = rx.is_complete()
    let _ = tx.send(654)
    let middle = rx.is_complete()
    let _ = rx.try_recv()
    let after = rx.is_complete()

    expect_false(before, "is_complete false before recv")
    expect_false(middle, "is_complete false after send but before recv")
    expect_true(after, "is_complete true after recv")
}

// @covers amiga::sys::exec::channel::OneshotReceiver::signal()
@test("Oneshot: signal mask is valid")
pub fn test_oneshot_signal_mask() {
    let (tx, rx) = oneshot::<i32>().unwrap()

    let mask = rx.signal()

    expect_true(mask > 0, "signal mask is non-zero")

    // Verify it's a power of 2 (only one bit set)
    let is_power_of_2 = (mask & (mask - 1)) == 0
    expect_true(is_power_of_2, "signal mask is a power of 2")
}
