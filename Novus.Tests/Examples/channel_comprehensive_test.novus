// Comprehensive Channel Test Suite
//
// Tests all three channel types (unbounded, bounded, oneshot) across:
// - Creation and basic send/recv
// - Multiple messages and FIFO ordering
// - Non-blocking try_recv behavior
// - Signal mask integration
// - Drain functionality
// - Edge cases (empty channel, double send, etc.)
//
// Run with: novus test channel_comprehensive_test.novus

from std::core import Result, Option
from amiga::sys::dos::errors import DosError
from amiga::sys::exec::channel import channel, bounded_channel, oneshot
from amiga::sys::exec::channel import Sender, Receiver, BoundedSender, BoundedReceiver
from amiga::sys::exec::channel import OneshotSender, OneshotReceiver
from amiga::sys::exec::channel import PortHandoff, PortOwnership, complete_handoff
from amiga::sys::exec::channel import ChannelError, take_over_port
from std::test::test import expect, expect_true, expect_false, expect_eq, fail
from amiga::sys::exec import spawn_task_fn_with_ptr, ProcessHandle, receive_startup_data
from amiga::raw::exec import Wait, GetMsg, ReplyMsg, FindTask, WaitPort, FreeMem, CreateMsgPort, DeleteMsgPort
from amiga::raw::structs import MsgPort, Message, Process

static var DRAIN_SUM: i32 = 0
fn add_drained(value: i32) { DRAIN_SUM = DRAIN_SUM + value }

// ============================================================================
// Bounded channel responder task
// ============================================================================

fn bounded_responder_task() -> i32 {
    // Get handoff pointer from parent
    let handoff_opt = receive_startup_data()
    let handoff = match handoff_opt {
        Option::Some(ptr) => (*PortHandoff)ptr,
        Option::None => return 1
    }

    // Complete the handoff - takes over port and signals parent we're ready
    // PortOwnership tracks the signal bit and frees it on drop
    let ownership = match complete_handoff(handoff) {
        Result::Ok(o) => o,
        Result::Err(_) => return 1
    }

    // Wait for a channel message
    Wait(ownership.signal())

    // Get the message
    let msg = GetMsg(ownership.port())
    if (u32)msg == 0 {
        return 1
    }

    // Reply to it immediately
    ReplyMsg(msg)

    return 0
    // ownership is dropped here, freeing the signal bit
}

// ============================================================================
// Unbounded Channel Tests
// ============================================================================

// @covers amiga::sys::exec::channel::channel()
// @covers amiga::sys::exec::channel::ChannelError::message()
@test("Create unbounded channel")
pub fn test_unbounded_creation() {
    expect((u32)ChannelError::NoMemory.message() != 0, "channel errors have messages")
    let result = channel::<i32>()
    match result {
        Result::Err(_) => fail("Failed to create channel"),
        Result::Ok(pair) => {
            // Must destructure to ensure Drop is called on inner elements
            let (_tx, _rx) = pair
        }
    }
}

// @covers amiga::sys::exec::channel::Sender::send(T)
// @covers amiga::sys::exec::channel::Sender::is_valid()
// @covers amiga::sys::exec::channel::Receiver::recv()
// @covers amiga::sys::exec::channel::Receiver::try_recv()
@test("Unbounded: send and receive a value")
pub fn test_unbounded_send_recv() {
    let (tx, rx) = channel::<i32>().unwrap()

    expect(tx.is_valid(), "sender is valid")
    let _ = tx.send(42)
    expect_eq(rx.recv(), 42, "blocking receive returns queued value")
    expect(rx.try_recv().is_none(), "channel is empty after receive")
}

@test("Unbounded: FIFO ordering of messages")
pub fn test_unbounded_fifo_ordering() {
    let (tx, rx) = channel::<i32>().unwrap()

    // Send multiple values in order
    let _ = tx.send(10)
    let _ = tx.send(20)
    let _ = tx.send(30)
    let _ = tx.send(40)

    // Receive and verify FIFO order
    match rx.try_recv() {
        Option::Some(v) => expect_eq(v, 10, "first value"),
        Option::None => fail("first recv returned None")
    }

    match rx.try_recv() {
        Option::Some(v) => expect_eq(v, 20, "second value"),
        Option::None => fail("second recv returned None")
    }

    match rx.try_recv() {
        Option::Some(v) => expect_eq(v, 30, "third value"),
        Option::None => fail("third recv returned None")
    }

    match rx.try_recv() {
        Option::Some(v) => expect_eq(v, 40, "fourth value"),
        Option::None => fail("fourth recv returned None")
    }
}

@test("Unbounded: try_recv on empty channel returns None")
pub fn test_unbounded_empty_channel() {
    let (tx, rx) = channel::<i32>().unwrap()

    match rx.try_recv() {
        Option::None => {}, // Expected
        Option::Some(_) => fail("try_recv returned Some on empty channel")
    }
}

// @covers amiga::sys::exec::channel::Receiver::signal()
// @covers amiga::sys::exec::channel::Receiver::check(u32)
@test("Unbounded: signal mask is valid")
pub fn test_unbounded_signal_mask() {
    let (tx, rx) = channel::<i32>().unwrap()

    let mask = rx.signal()

    // Mask should be non-zero (Amiga has 32 signal bits, so mask can be up to 1<<31)
    expect_true(mask > 0, "signal mask is non-zero")

    // Verify it's a power of 2 (only one bit set)
    let is_power_of_2 = (mask & (mask - 1)) == 0
    expect_true(is_power_of_2, "signal mask is a power of 2")
    expect_true(rx.check(mask), "receiver recognizes its signal")
    expect_false(rx.check(0), "receiver rejects unrelated signals")
}

// @covers amiga::sys::exec::channel::Receiver::drain(fn(T))
@test("Unbounded: drain processes all messages")
pub fn test_unbounded_drain() {
    let (tx, rx) = channel::<i32>().unwrap()

    let _ = tx.send(100)
    let _ = tx.send(200)
    let _ = tx.send(300)

    DRAIN_SUM = 0
    rx.drain(add_drained)
    expect_eq(DRAIN_SUM, 600, "sum of drained values")
}

// @covers amiga::sys::exec::channel::Sender::clone()
@test("Unbounded: sender clone works")
pub fn test_unbounded_sender_clone() {
    let (tx, rx) = channel::<i32>().unwrap()

    let tx2 = tx.clone()

    let _ = tx.send(111)
    let _ = tx2.send(222)

    // Both should be received
    var got_first = false
    var got_second = false

    match rx.try_recv() {
        Option::Some(v) => {
            if v == 111 { got_first = true }
        },
        Option::None => {}
    }

    match rx.try_recv() {
        Option::Some(v) => {
            if v == 222 { got_second = true }
        },
        Option::None => {}
    }

    expect_true(got_first, "got value from original sender")
    expect_true(got_second, "got value from cloned sender")
}

// @covers amiga::sys::exec::channel::Sender::from_port(*MsgPort)
@test("Unbounded: sender can borrow an existing port")
pub fn test_sender_from_port() {
    let port = CreateMsgPort()
    expect(port != null, "raw port allocates")
    let sender = Sender::<i32>::from_port(port)
    expect(sender.is_valid() && sender.send(321).is_ok(), "borrowed sender queues a value")
    let message = GetMsg(port)
    expect(message != null, "borrowed port receives the value")
    if message != null {
        let payload = (*i32)((u32)message + @sizeof(Message))
        expect(*payload == 321, "borrowed sender preserves payload")
        unsafe { FreeMem((*u8)message, @sizeof(Message) + @sizeof(i32)) }
    }
    DeleteMsgPort(port)
}

@test("Unbounded: multiple recv on empty channel returns None")
pub fn test_unbounded_multiple_recv_on_empty() {
    let (tx, rx) = channel::<i32>().unwrap()

    let _ = tx.send(999)

    // Receive it
    match rx.try_recv() {
        Option::Some(_) => {},
        Option::None => {
            fail("First recv failed")
            return
        }
    }

    // Now channel is empty - all try_recv should return None
    match rx.try_recv() {
        Option::Some(_) => fail("Second recv got Some from empty channel"),
        Option::None => {}
    }

    match rx.try_recv() {
        Option::Some(_) => fail("Third recv got Some from empty channel"),
        Option::None => {}
    }

    match rx.try_recv() {
        Option::Some(_) => fail("Fourth recv got Some from empty channel"),
        Option::None => {}
    }
}

