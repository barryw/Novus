// Test: AmigaOS ABI Calling Conventions
//
// Description:
//   Verifies that AmigaOS library functions are called correctly using
//   the register-based ABI. Tests multiple functions with different
//   parameter types and registers.
//
// Expected Output:
//   Exits with code 0 if all tests pass
//   Exits with code 1-5 for various failure modes
//
// ABI Details:
//   - AllocMem(d0=size, d1=flags) -> d0=ptr [offset -198]
//   - FreeMem(a1=ptr, d0=size) [offset -210]
//   - Forbid() [offset -132]
//   - Permit() [offset -138]
//   - TypeOfMem(a1=ptr) -> d0=type [offset -534]

from std::ffi::exec import AllocMem, FreeMem, Forbid, Permit, TypeOfMem
from std::ffi::amiga_consts import MEMF_PUBLIC, MEMF_CHIP, MEMF_FAST, MEMF_CLEAR

pub fn main() -> i32 {
    // Test 1: AllocMem with two parameters in d0/d1
    let ptr1 = unsafe { AllocMem(100, MEMF_PUBLIC | MEMF_CLEAR) }
    if ptr1 == null {
        return 1  // Allocation failed
    }

    // Test 2: Verify memory was cleared (should be all zeros)
    let byte_ptr = ptr1
    if byte_ptr[0] != 0u8 || byte_ptr[50] != 0u8 || byte_ptr[99] != 0u8 {
        unsafe { FreeMem(ptr1, 100) }
        return 2  // Memory not cleared
    }

    // Test 3: Forbid/Permit (no parameters)
    Forbid()
    Permit()

    // Test 4: TypeOfMem with pointer parameter in a1
    let mem_type = TypeOfMem(ptr1)
    if mem_type == 0 {
        unsafe { FreeMem(ptr1, 100) }
        return 3  // Invalid memory type returned
    }

    // Test 5: FreeMem with mixed parameters (a1=ptr, d0=size)
    unsafe { FreeMem(ptr1, 100) }

    // Test 6: Allocate chip memory and verify type
    let chip_ptr = unsafe { AllocMem(64, MEMF_CHIP) }
    if chip_ptr == null {
        let chip_type = TypeOfMem(chip_ptr)
        unsafe { FreeMem(chip_ptr, 64) }

        // Chip memory should have bit 1 set
        if (chip_type & 2) == 0 {
            return 4  // Not chip memory
        }
    }

    // Test 7: Multiple allocations to stress test the ABI
    let ptrs: [*u8] = [u8; 5]
    var i: i32 = 0
    while i < 5 {
        ptrs[i] = unsafe { AllocMem(32, MEMF_PUBLIC) }
        if ptrs[i] == null {
            // Clean up and fail
            var j: i32 = 0
            while j < i {
                unsafe { FreeMem(ptrs[j], 32) }
                j = j + 1
            }
            return 5  // Allocation failed during stress test
        }
        i = i + 1
    }

    // Clean up stress test
    i = 0
    while i < 5 {
        unsafe { FreeMem(ptrs[i], 32) }
        i = i + 1
    }

    return 0  // All tests passed
}
