// Prime Sieve - Find all primes up to 100,000
// BEAST MODE - Full stress test for A4000
// Uses Sieve of Eratosthenes algorithm

from std::io::file import write
from std::string::core import Str
from std::collections::vec import Vec

pub fn main() -> i32 {
    let max: u32 = 100000

    write("==========================================\n")
    write("PRIME SIEVE - BEAST MODE\n")
    write("Finding all primes up to %ld\n", max)
    write("==========================================\n\n")

    // Allocate sieve array (100,001 bytes)
    write("Allocating sieve array (%ld bytes)...\n", max + 1)
    var sieve = Vec::<bool>::new()

    // Initialize all numbers as potentially prime
    write("Initializing sieve...\n")
    var i: u32 = 0
    while i <= max {
        sieve.push(true).unwrap()
        i++
    }

    write("Sieve allocated and initialized\n")
    write("Running Sieve of Eratosthenes...\n")
    write("This will take a while on the A4000...\n\n")

    // 0 and 1 are not prime
    sieve.set(0, false).unwrap()
    sieve.set(1, false).unwrap()

    // Sieve of Eratosthenes main algorithm
    var p: u32 = 2
    var sieve_ops: u32 = 0

    while p * p <= max {
        let is_prime = *sieve.get(p).unwrap()
        let check = (u32)is_prime

        if check != 0 {
            // p is prime - mark all multiples as composite
            var multiple: u32 = p * p
            while multiple <= max {
                sieve.set(multiple, false).unwrap()
                multiple = multiple + p
                sieve_ops++
            }

            // Progress indicator every 100 primes found
            if p % 100 == 0 {
                write("  Processing p=%ld...\n", p)
            }
        }
        p++
    }

    write("\nSieve complete! %ld operations performed\n", sieve_ops)
    write("Counting and displaying primes...\n\n")

    // Count and display all primes
    var prime_count: u32 = 0
    var line_count: u32 = 0

    i = 2
    while i <= max {
        let val = *sieve.get(i).unwrap()
        let is_prime_val = (u32)val

        if is_prime_val != 0 {
            write("%ld ", i)
            prime_count++
            line_count++

            // Newline every 10 primes for readability
            if line_count >= 10 {
                write("\n")
                line_count = 0
            }
        }
        i++
    }

    // Final statistics
    write("\n\n==========================================\n")
    write("RESULTS:\n")
    write("  Total primes found: %ld\n", prime_count)
    write("  Largest number checked: %ld\n", max)
    write("  Sieve operations: %ld\n", sieve_ops)
    write("  Memory used: %ld bytes\n", max + 1)
    write("==========================================\n")

    return 0
}
