// Example: Struct Member Mutation
//
// Description:
//   Tests mutating struct fields. Shows struct members can be modified when mutable.
//
// Expected Output:
//   Exit code: 0

struct Counter {
    value: i32,
}

impl Counter {
    fn new() -> Counter {
        return Counter {
            value: 0,
        }
    }

    fn increment(&mut self) {
        self.value++
    }

    fn get(&self) -> i32 {
        return self.value
    }
}

pub fn main() -> i32 {
    var c: Counter = Counter::new()
    c.increment()
    c.increment()
    c.increment()
    return c.get()
}
