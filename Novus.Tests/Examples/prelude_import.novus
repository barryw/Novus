// Portable prelude and platform errors remain separate.
from std::prelude import Result
from amiga::dos import DosError

fn test_error() -> i32 {
    let err = DosError::NotFound
    match err {
        DosError::NotFound => return 42,
        _ => return 0
    }
}

pub fn main() -> i32 {
    return test_error()
}
