// Check if DOSBase gets corrupted by PutMsg

from std::ffi::dos import VPrintf
from std::ffi::exec import AllocMem, PutMsg, FindTask
from std::ffi::amiga_consts import MEMF_PUBLIC, MEMF_CLEAR
from std::ffi::amiga_structs import Process, Message, MsgPort

// Declare DOSBase as external so we can read it
extern var DOSBase: *u8

pub fn main() -> i32 {
    // Print DOSBase before anything
    var db_val: u32 = (u32)DOSBase
    VPrintf("DOSBASE BEFORE=%08lx\n", (*u8)&db_val)

    // Get our own Process structure
    let me = (*Process)FindTask((*u8)0)

    // Allocate message
    let msg_size: u32 = 24
    let msg_mem = unsafe { AllocMem(msg_size, MEMF_PUBLIC | MEMF_CLEAR) }
    if (u32)msg_mem == 0 {
        VPrintf("ALLOC FAIL\n", (*u8)0)
        return 1
    }

    var msg_addr: u32 = (u32)msg_mem
    VPrintf("MSG ADDR=%08lx\n", (*u8)&msg_addr)

    let msg = (*Message)msg_mem
    msg.mn_Node.ln_Type = 5
    msg.mn_ReplyPort = (*MsgPort)0
    msg.mn_Length = (u16)msg_size

    let my_port = (*MsgPort)(*u8)&me.pr_MsgPort
    var port_addr: u32 = (u32)my_port
    VPrintf("PORT ADDR=%08lx\n", (*u8)&port_addr)

    // Check DOSBase before PutMsg
    db_val = (u32)DOSBase
    VPrintf("DOSBASE BEFORE PUTMSG=%08lx\n", (*u8)&db_val)

    // THE PUTMSG CALL
    PutMsg(my_port, msg)

    // Check DOSBase after PutMsg - THIS SHOULD NOT CRASH
    // because we're just reading a global variable
    db_val = (u32)DOSBase
    VPrintf("DOSBASE AFTER PUTMSG=%08lx\n", (*u8)&db_val)

    VPrintf("DONE\n", (*u8)0)
    return 0
}
