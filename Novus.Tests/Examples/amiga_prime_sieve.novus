// Prime Sieve - Find all primes up to 100,000
// Uses Sieve of Eratosthenes algorithm
// This will take some time on the A4000 and stress test the compiler output

from std::io import write
from std::strings import Str
from std::collections import Vec

pub fn main() -> i32 {
    let max: u32 = 100000

    write("Prime Sieve: Finding all primes up to %ld\n", max)
    write("Allocating sieve array...\n")

    // Create a vector to track which numbers are prime
    // true = prime, false = composite
    let sieve_opt = Vec::<bool>::with_capacity(max + 1)

    // Check if allocation succeeded
    let has_sieve = match sieve_opt {
        Some(_) => true,
        None => false
    }

    if !has_sieve {
        write("ERROR: Failed to allocate sieve array!\n")
        return 1
    }

    // We know sieve_opt is Some, extract it unsafely
    var sieve = Vec::<bool>::new()
    match sieve_opt {
        Some(s) => sieve = s,
        None => sieve = Vec::<bool>::new()
    }

    // Initialize all numbers as potentially prime
    var i: u32 = 0
    while i <= max {
        if !sieve.push(true) {
            write("ERROR: Failed to push to sieve!\n")
            return 1
        }
        i = i + 1
    }

    write("Sieve allocated (%ld bytes)\n", (max + 1) * 1)
    write("Running sieve algorithm...\n\n")

    // 0 and 1 are not prime
    sieve.set(0, false)
    sieve.set(1, false)

    var primes_found: u32 = 0
    var p: u32 = 2

    // Sieve of Eratosthenes
    while p * p <= max {
        // If p is still marked as prime
        if sieve.get(p) {
            // Mark all multiples of p as composite
            var multiple: u32 = p * p
            while multiple <= max {
                sieve.set(multiple, false)
                multiple = multiple + p
            }
        }
        p = p + 1
    }

    // Count and print primes
    write("Primes found:\n")
    write("-------------\n")

    i = 2
    while i <= max {
        if sieve.get(i) {
            write("%ld ", i)
            primes_found = primes_found + 1

            // Print newline every 10 primes for readability
            if primes_found % 10 == 0 {
                write("\n")
            }
        }
        i = i + 1
    }

    write("\n\n")
    write("Total primes found: %ld\n", primes_found)
    write("Largest prime checked: %ld\n", max)

    return 0
}
