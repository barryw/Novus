// Example 10: Local Variables
// Demonstrates let (immutable) and var (mutable) variables

pub fn compute(a: i32, b: i32) -> i32 {
    // Immutable variable - cannot be reassigned
    let sum: i32 = a + b

    // Mutable variable - can be reassigned
    var result: i32 = sum * 2
    result = result + 10

    return result
}

pub fn main() -> u32 {
    let x: i32 = 5
    let y: i32 = 10

    return (u32)compute(x, y)
}
