@test("ScopedData lock() and get() returns initial value")
pub fn test_scoped_data_get_initial() {
    match ScopedData::<u32>::new(123u32) {
        Option::Some(var data) => {
            let guard = data.lock()
            let value = guard.get()
            expect_eq_u32(value, 123u32, "get() should return initial value")
        },
        Option::None => fail("ScopedData::new() failed")
    }
}

@test("ScopedData lock() and get() returns zero")
pub fn test_scoped_data_get_zero() {
    match ScopedData::<u32>::new(0u32) {
        Option::Some(var data) => {
            let guard = data.lock()
            let value = guard.get()
            expect_eq_u32(value, 0u32, "get() should return 0")
        },
        Option::None => fail("ScopedData::new() failed")
    }
}

@test("ScopedData get() with i32 negative value")
pub fn test_scoped_data_get_negative() {
    match ScopedData::<i32>::new(-42) {
        Option::Some(var data) => {
            let guard = data.lock()
            let value = guard.get()
            expect_eq_i32(value, -42, "get() should return -42")
        },
        Option::None => fail("ScopedData::new() failed")
    }
}

// ============================================================================
// ScopedData<T> Lock and Set Tests
// ============================================================================

@test("ScopedData set() modifies value")
pub fn test_scoped_data_set() {
    match ScopedData::<u32>::new(0u32) {
        Option::Some(var data) => {
            {
                var guard = data.lock()
                guard.set(999u32)
            }
            let guard2 = data.lock()
            expect_eq_u32(guard2.get(), 999u32, "set() should modify value")
        },
        Option::None => fail("ScopedData::new() failed")
    }
}

@test("ScopedData set() to zero")
pub fn test_scoped_data_set_zero() {
    match ScopedData::<u32>::new(12345u32) {
        Option::Some(var data) => {
            {
                var guard = data.lock()
                guard.set(0u32)
            }
            let guard2 = data.lock()
            expect_eq_u32(guard2.get(), 0u32, "set() to 0 should work")
        },
        Option::None => fail("ScopedData::new() failed")
    }
}

@test("ScopedData set() multiple times")
pub fn test_scoped_data_set_multiple() {
    match ScopedData::<u32>::new(0u32) {
        Option::Some(var data) => {
            {
                var guard = data.lock()
                guard.set(1u32)
                guard.set(2u32)
                guard.set(3u32)
            }
            let guard2 = data.lock()
            expect_eq_u32(guard2.get(), 3u32, "last set() value should persist")
        },
        Option::None => fail("ScopedData::new() failed")
    }
}

@test("ScopedData set() across multiple lock/unlock cycles")
pub fn test_scoped_data_set_across_locks() {
    match ScopedData::<u32>::new(0u32) {
        Option::Some(var data) => {
            {
                var guard1 = data.lock()
                guard1.set(10u32)
            }
            {
                var guard2 = data.lock()
                let v1 = guard2.get()
                guard2.set(v1 + 5u32)
            }
            {
                var guard3 = data.lock()
                let v2 = guard3.get()
                guard3.set(v2 * 2u32)
            }
            let guard4 = data.lock()
            expect_eq_u32(guard4.get(), 30u32, "value should be 30 after operations")
        },
        Option::None => fail("ScopedData::new() failed")
    }
}

// ============================================================================
// ScopedData<T> Shared Lock Tests
// ============================================================================

@test("ScopedData lock_shared() provides read access")
pub fn test_scoped_data_lock_shared() {
    match ScopedData::<u32>::new(456u32) {
        Option::Some(var data) => {
            let guard: SharedScopedDataGuard<u32> = data.lock_shared()
            expect_eq_u32(guard.get(), 456u32, "lock_shared() should provide read access")
        },
        Option::None => fail("ScopedData::new() failed")
    }
}

@test("ScopedData lock_shared() across lock/unlock cycles")
pub fn test_scoped_data_lock_shared_cycles() {
    // Note: AmigaOS shared locks are NOT nestable from the same task
    // This test verifies shared lock works across multiple lock/unlock cycles
    match ScopedData::<u32>::new(789u32) {
        Option::Some(var data) => {
            {
                let guard1: SharedScopedDataGuard<u32> = data.lock_shared()
                expect_eq_u32(guard1.get(), 789u32, "first read sees value")
            }
            {
                let guard2: SharedScopedDataGuard<u32> = data.lock_shared()
                expect_eq_u32(guard2.get(), 789u32, "second read sees value")
            }
            {
                let guard3: SharedScopedDataGuard<u32> = data.lock_shared()
                expect_eq_u32(guard3.get(), 789u32, "third read sees value")
            }
        },
        Option::None => fail("ScopedData::new() failed")
    }
}

