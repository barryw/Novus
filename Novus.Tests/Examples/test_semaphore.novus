@test("new_public() creates named semaphore")
pub fn test_new_public_creates_semaphore() {
    match SemaphoreHandle::new_public("TestSem1", 0) {
        Option::Some(sem) => {
            expect_true(true, "new_public() should succeed")
        },
        Option::None => fail("new_public() failed")
    }
}

@test("new_public() with positive priority")
pub fn test_new_public_positive_priority() {
    match SemaphoreHandle::new_public("TestSem2", 10) {
        Option::Some(sem) => {
            expect_true(true, "new_public() with priority 10 should succeed")
        },
        Option::None => fail("new_public() failed")
    }
}

@test("new_public() with negative priority")
pub fn test_new_public_negative_priority() {
    match SemaphoreHandle::new_public("TestSem3", -5) {
        Option::Some(sem) => {
            expect_true(true, "new_public() with priority -5 should succeed")
        },
        Option::None => fail("new_public() failed")
    }
}

@test("find() locates existing public semaphore")
pub fn test_find_locates_semaphore() {
    match SemaphoreHandle::new_public("FindMe", 0) {
        Option::Some(owner) => {
            match SemaphoreHandle::find("FindMe") {
                Option::Some(found) => {
                    expect_true(true, "find() should locate semaphore")
                },
                Option::None => fail("find() should locate the semaphore")
            }
        },
        Option::None => fail("new_public() failed")
    }
}

@test("find() returns None for nonexistent semaphore")
pub fn test_find_nonexistent() {
    match SemaphoreHandle::find("ThisDoesNotExist12345") {
        Option::Some(sem) => {
            fail("find() should return None for nonexistent semaphore")
        },
        Option::None => {
            expect_true(true, "find() correctly returns None")
        }
    }
}

@test("found semaphore can be locked")
pub fn test_found_semaphore_can_lock() {
    match SemaphoreHandle::new_public("LockMe", 0) {
        Option::Some(owner) => {
            match SemaphoreHandle::find("LockMe") {
                Option::Some(found) => {
                    let guard = found.lock()
                    expect_true(true, "found semaphore should be lockable")
                },
                Option::None => fail("find() failed")
            }
        },
        Option::None => fail("new_public() failed")
    }
}

@test("found semaphore can be locked shared")
pub fn test_found_semaphore_can_lock_shared() {
    match SemaphoreHandle::new_public("ShareMe", 0) {
        Option::Some(owner) => {
            match SemaphoreHandle::find("ShareMe") {
                Option::Some(found) => {
                    let guard: SharedSemaphoreGuard = found.lock_shared()
                    expect_true(true, "found semaphore should be shareable")
                },
                Option::None => fail("find() failed")
            }
        },
        Option::None => fail("new_public() failed")
    }
}

@test("public semaphore removed from list on drop")
pub fn test_public_semaphore_removed_on_drop() {
    // Create and drop a public semaphore
    {
        match SemaphoreHandle::new_public("DropTest", 0) {
            Option::Some(sem) => { },
            Option::None => fail("new_public() failed")
        }
        // sem drops here
    }
    // Should not be findable anymore
    match SemaphoreHandle::find("DropTest") {
        Option::Some(sem) => {
            fail("semaphore should be removed from list after drop")
        },
        Option::None => {
            expect_true(true, "semaphore correctly removed on drop")
        }
    }
}

@test("multiple public semaphores with different names")
pub fn test_multiple_public_semaphores() {
    match SemaphoreHandle::new_public("Multi1", 0) {
        Option::Some(sem1) => {
            match SemaphoreHandle::new_public("Multi2", 0) {
                Option::Some(sem2) => {
                    match SemaphoreHandle::new_public("Multi3", 0) {
                        Option::Some(sem3) => {
                            // All should be findable
                            match SemaphoreHandle::find("Multi1") {
                                Option::Some(_) => {
                                    match SemaphoreHandle::find("Multi2") {
                                        Option::Some(_) => {
                                            match SemaphoreHandle::find("Multi3") {
                                                Option::Some(_) => {
                                                    expect_true(true, "all semaphores findable")
                                                },
                                                Option::None => fail("Multi3 not found")
                                            }
                                        },
                                        Option::None => fail("Multi2 not found")
                                    }
                                },
                                Option::None => fail("Multi1 not found")
                            }
                        },
                        Option::None => fail("third new_public() failed")
                    }
                },
                Option::None => fail("second new_public() failed")
            }
        },
        Option::None => fail("first new_public() failed")
    }
}

