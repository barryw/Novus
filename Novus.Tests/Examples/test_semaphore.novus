// ============================================================================
// ScopedData<T> Guard Drop Tests
// ============================================================================

@test("ScopedData exclusive guard releases on drop")
pub fn test_scoped_data_guard_drop() {
    match ScopedData::<u32>::new(0u32) {
        Option::Some(var data) => {
            {
                var guard = data.lock()
                guard.set(100u32)
            }
            // Should be able to lock again
            let guard2 = data.lock()
            expect_eq_u32(guard2.get(), 100u32, "guard should release on drop")
        },
        Option::None => fail("ScopedData::new() failed")
    }
}

@test("ScopedData shared guard releases on drop")
pub fn test_scoped_data_shared_guard_drop() {
    match ScopedData::<u32>::new(50u32) {
        Option::Some(var data) => {
            {
                let guard: SharedScopedDataGuard<u32> = data.lock_shared()
            }
            // Should be able to get exclusive lock
            var guard2 = data.lock()
            guard2.set(60u32)
            expect_eq_u32(guard2.get(), 60u32, "shared guard should release")
        },
        Option::None => fail("ScopedData::new() failed")
    }
}

