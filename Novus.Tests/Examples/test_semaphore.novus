// ============================================================================
// Edge Case Tests
// ============================================================================

@test("deeply nested locks work")
pub fn test_deeply_nested_locks() {
    match SemaphoreHandle::new() {
        Option::Some(sem) => {
            let g1 = sem.lock()
            let g2 = sem.lock()
            let g3 = sem.lock()
            let g4 = sem.lock()
            let g5 = sem.lock()
            expect_true(true, "5 nested locks should work")
        },
        Option::None => fail("new() failed")
    }
}

@test("guard drop order doesn't matter")
pub fn test_guard_drop_order() {
    match SemaphoreHandle::new() {
        Option::Some(sem) => {
            // Guards drop in reverse order (LIFO) but should still work
            let g1 = sem.lock()
            let g2 = sem.lock()
            // g2 drops first, then g1
            expect_true(true, "drop order should not matter")
        },
        Option::None => fail("new() failed")
    }
}

@test("many semaphores can coexist")
pub fn test_many_semaphores() {
    var count: u32 = 0u32
    // Create 10 semaphores
    match SemaphoreHandle::new() {
        Option::Some(s1) => {
            count = count + 1u32
            match SemaphoreHandle::new() {
                Option::Some(s2) => {
                    count = count + 1u32
                    match SemaphoreHandle::new() {
                        Option::Some(s3) => {
                            count = count + 1u32
                            match SemaphoreHandle::new() {
                                Option::Some(s4) => {
                                    count = count + 1u32
                                    match SemaphoreHandle::new() {
                                        Option::Some(s5) => {
                                            count = count + 1u32
                                            expect_eq_u32(count, 5u32, "should create 5 semaphores")
                                        },
                                        Option::None => fail("s5 failed")
                                    }
                                },
                                Option::None => fail("s4 failed")
                            }
                        },
                        Option::None => fail("s3 failed")
                    }
                },
                Option::None => fail("s2 failed")
            }
        },
        Option::None => fail("s1 failed")
    }
}

@test("ScopedData counter increment pattern")
pub fn test_scoped_data_counter() {
    match ScopedData::<u32>::new(0u32) {
        Option::Some(var counter) => {
            // Simulate increment pattern
            var i: u32 = 0u32
            while i < 10u32 {
                var loop_guard = counter.lock()
                let v = loop_guard.get()
                loop_guard.set(v + 1u32)
                i = i + 1u32
            }
            let final_guard = counter.lock()
            expect_eq_u32(final_guard.get(), 10u32, "counter should be 10")
        },
        Option::None => fail("ScopedData::new() failed")
    }
}

@test("public semaphore with long name")
pub fn test_public_semaphore_long_name() {
    match SemaphoreHandle::new_public("ThisIsAVeryLongSemaphoreName", 0) {
        Option::Some(sem) => {
            match SemaphoreHandle::find("ThisIsAVeryLongSemaphoreName") {
                Option::Some(found) => {
                    expect_true(true, "long name should work")
                },
                Option::None => fail("find() with long name failed")
            }
        },
        Option::None => fail("new_public() with long name failed")
    }
}
