// Comprehensive tests for semaphore functionality
// Run with: novus test test_semaphore.novus
//
// Tests cover:
// - SemaphoreHandle: new, new_public, find, lock, try_lock, lock_shared, try_lock_shared
// - SemaphoreGuard: RAII release
// - SharedSemaphoreGuard: RAII release, type safety
// - ScopedData<T>: lock, try_lock, lock_shared, try_lock_shared, get, set
// - Edge cases: nested locks, multiple semaphores, guard drop order
// - Negative cases: find nonexistent, try_lock when held

from std::core import Option, Result
from std::os::exec import SemaphoreHandle, SemaphoreGuard, SharedSemaphoreGuard
from std::os::exec import ScopedData, ScopedDataGuard, SharedScopedDataGuard
from std::test::test import expect_true, expect_false, expect_eq_u32, expect_eq_i32, fail

// ============================================================================
// SemaphoreHandle::new() Tests
// ============================================================================

@test("new() creates valid semaphore")
pub fn test_new_creates_semaphore() {
    match SemaphoreHandle::new() {
        Option::Some(sem) => {
            expect_true(true, "new() should succeed")
        },
        Option::None => {
            fail("new() should not return None")
        }
    }
}

@test("new() can be called multiple times")
pub fn test_new_multiple_semaphores() {
    match SemaphoreHandle::new() {
        Option::Some(sem1) => {
            match SemaphoreHandle::new() {
                Option::Some(sem2) => {
                    match SemaphoreHandle::new() {
                        Option::Some(sem3) => {
                            expect_true(true, "multiple new() calls should succeed")
                        },
                        Option::None => fail("third new() failed")
                    }
                },
                Option::None => fail("second new() failed")
            }
        },
        Option::None => fail("first new() failed")
    }
}

// ============================================================================
// SemaphoreHandle::lock() Tests
// ============================================================================

@test("lock() obtains exclusive access")
pub fn test_lock_obtains_access() {
    match SemaphoreHandle::new() {
        Option::Some(sem) => {
            let guard = sem.lock()
            expect_true(true, "lock() should succeed")
        },
        Option::None => fail("new() failed")
    }
}

@test("lock() can be called multiple times (nested)")
pub fn test_lock_nested() {
    match SemaphoreHandle::new() {
        Option::Some(sem) => {
            let guard1 = sem.lock()
            let guard2 = sem.lock()
            let guard3 = sem.lock()
            expect_true(true, "nested lock() should work (same task)")
        },
        Option::None => fail("new() failed")
    }
}

@test("lock() guard releases on drop")
pub fn test_lock_guard_releases() {
    match SemaphoreHandle::new() {
        Option::Some(sem) => {
            // First lock in inner scope
            {
                let guard = sem.lock()
                // guard drops here
            }
            // Should be able to lock again
            let guard2 = sem.lock()
            expect_true(true, "guard should release on drop")
        },
        Option::None => fail("new() failed")
    }
}

@test("lock() works on multiple different semaphores")
pub fn test_lock_different_semaphores() {
    match SemaphoreHandle::new() {
        Option::Some(sem1) => {
            match SemaphoreHandle::new() {
                Option::Some(sem2) => {
                    let guard1 = sem1.lock()
                    let guard2 = sem2.lock()
                    expect_true(true, "locking different semaphores should work")
                },
                Option::None => fail("second new() failed")
            }
        },
        Option::None => fail("first new() failed")
    }
}

// ============================================================================
// SemaphoreHandle::try_lock() Tests
// ============================================================================

@test("try_lock() succeeds on available semaphore")
pub fn test_try_lock_succeeds_when_available() {
    match SemaphoreHandle::new() {
        Option::Some(sem) => {
            match sem.try_lock() {
                Option::Some(guard) => {
                    expect_true(true, "try_lock() should succeed")
                },
                Option::None => fail("try_lock() should succeed when available")
            }
        },
        Option::None => fail("new() failed")
    }
}

@test("try_lock() succeeds multiple times (nested, same task)")
pub fn test_try_lock_nested_same_task() {
    match SemaphoreHandle::new() {
        Option::Some(sem) => {
            match sem.try_lock() {
                Option::Some(guard1) => {
                    // Same task can nest locks
                    match sem.try_lock() {
                        Option::Some(guard2) => {
                            expect_true(true, "nested try_lock() should work (same task)")
                        },
                        Option::None => fail("nested try_lock() should succeed for same task")
                    }
                },
                Option::None => fail("first try_lock() failed")
            }
        },
        Option::None => fail("new() failed")
    }
}

@test("try_lock() guard releases on drop")
pub fn test_try_lock_guard_releases() {
    match SemaphoreHandle::new() {
        Option::Some(sem) => {
            {
                match sem.try_lock() {
                    Option::Some(guard) => { },
                    Option::None => fail("try_lock() should succeed")
                }
            }
            // Should be able to try_lock again
            match sem.try_lock() {
                Option::Some(guard) => {
                    expect_true(true, "guard should release on drop")
                },
                Option::None => fail("second try_lock() should succeed")
            }
        },
        Option::None => fail("new() failed")
    }
}

// ============================================================================
// SemaphoreHandle::lock_shared() Tests
// ============================================================================

@test("lock_shared() obtains shared access")
pub fn test_lock_shared_obtains_access() {
    match SemaphoreHandle::new() {
        Option::Some(sem) => {
            let guard: SharedSemaphoreGuard = sem.lock_shared()
            expect_true(true, "lock_shared() should succeed")
        },
        Option::None => fail("new() failed")
    }
}

@test("lock_shared() works on different semaphores")
pub fn test_lock_shared_different_semaphores() {
    // Note: AmigaOS ObtainSemaphoreShared is NOT nestable from the same task!
    // Multiple readers means multiple DIFFERENT tasks, not multiple calls from one task.
    // This test verifies shared locks work on different semaphores.
    match SemaphoreHandle::new() {
        Option::Some(sem1) => {
            match SemaphoreHandle::new() {
                Option::Some(sem2) => {
                    let guard1: SharedSemaphoreGuard = sem1.lock_shared()
                    let guard2: SharedSemaphoreGuard = sem2.lock_shared()
                    expect_true(true, "lock_shared() on different semaphores should work")
                },
                Option::None => fail("new() failed for sem2")
            }
        },
        Option::None => fail("new() failed for sem1")
    }
}

@test("lock_shared() guard releases on drop")
pub fn test_lock_shared_guard_releases() {
    match SemaphoreHandle::new() {
        Option::Some(sem) => {
            {
                let guard: SharedSemaphoreGuard = sem.lock_shared()
            }
            // Should be able to get exclusive lock now
            let guard2 = sem.lock()
            expect_true(true, "shared guard should release on drop")
        },
        Option::None => fail("new() failed")
    }
}

// ============================================================================
// SemaphoreHandle::try_lock_shared() Tests
// ============================================================================

@test("try_lock_shared() succeeds on available semaphore")
pub fn test_try_lock_shared_succeeds() {
    match SemaphoreHandle::new() {
        Option::Some(sem) => {
            match sem.try_lock_shared() {
                Option::Some(guard) => {
                    expect_true(true, "try_lock_shared() should succeed")
                },
                Option::None => fail("try_lock_shared() should succeed when available")
            }
        },
        Option::None => fail("new() failed")
    }
}

@test("try_lock_shared() works on different semaphores")
pub fn test_try_lock_shared_different_sems() {
    // Note: AmigaOS shared locks are NOT nestable from the same task
    match SemaphoreHandle::new() {
        Option::Some(sem1) => {
            match SemaphoreHandle::new() {
                Option::Some(sem2) => {
                    match sem1.try_lock_shared() {
                        Option::Some(guard1) => {
                            match sem2.try_lock_shared() {
                                Option::Some(guard2) => {
                                    expect_true(true, "try_lock_shared() on different sems works")
                                },
                                Option::None => fail("second try_lock_shared() failed")
                            }
                        },
                        Option::None => fail("first try_lock_shared() failed")
                    }
                },
                Option::None => fail("new() failed for sem2")
            }
        },
        Option::None => fail("new() failed for sem1")
    }
}

// ============================================================================
// Mixed lock/lock_shared Tests
// ============================================================================

@test("lock after lock_shared released")
pub fn test_lock_after_shared_released() {
    match SemaphoreHandle::new() {
        Option::Some(sem) => {
            {
                let shared: SharedSemaphoreGuard = sem.lock_shared()
            }
            let exclusive = sem.lock()
            expect_true(true, "exclusive lock should work after shared released")
        },
        Option::None => fail("new() failed")
    }
}

@test("lock_shared after lock released")
pub fn test_shared_after_lock_released() {
    match SemaphoreHandle::new() {
        Option::Some(sem) => {
            {
                let exclusive = sem.lock()
            }
            let shared: SharedSemaphoreGuard = sem.lock_shared()
            expect_true(true, "shared lock should work after exclusive released")
        },
        Option::None => fail("new() failed")
    }
}

