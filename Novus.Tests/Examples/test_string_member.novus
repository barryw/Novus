// Example: String Struct Member
//
// Description:
//   Tests String type (fat pointer) as a struct member field.
//
// Expected Output:
//   Exit code: 0

from std::strings::core import Str

fn test_len(s: Str) -> i32 {
    return s.len
}

pub fn main() -> i32 {
    let message = "Hello"
    let len = test_len(message)
    return (u32)len
}
