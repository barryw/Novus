// Example: String Struct Member
//
// Description:
//   Tests String type (fat pointer) as a struct member field.
//
// Expected Output:
//   Exit code: 0

fn test_len(s: String) -> i32 {
    return s.len
}

pub fn main() -> u32 {
    let message = "Hello"
    let len = test_len(message)
    return (u32)len
}
