from std::core import Result

pub fn divide(a: i32, b: i32) -> i32 {
    if b == 0 {
        panic!("Division by zero!")
    }
    return a / b
}

pub fn main() -> i32 {
    // This should work fine
    let result = divide(10, 2)

    // This would trigger a panic with a GUI dialog
    // let bad_result = divide(10, 0)

    return result
}
