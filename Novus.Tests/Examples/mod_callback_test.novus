// MOD Player Single-Play Test
// Plays a MOD file once and exits when finished

from std::core import Result
from std::audio::ptplayer import ModPlayer, ModAsset
from std::audio::errors import AudioError
from std::hardware::chipset import DISPLAY, DisplayType
from std::io::file import write
from std::os::timer import AsyncTimer, Duration, WaitResult, TimerError

// Embed MOD in fast RAM
@embed("GSLINGER.MOD", chip = false)
static music: [u8] = []

pub fn main() -> i32 {
    let is_pal = DISPLAY() == DisplayType::PAL

    write("MOD Player Test\n")
    write("===============\n\n")

    var player = ModPlayer::new(is_pal).unwrap()
    player.init_asset(&music, 0).unwrap()

    write("Playing: GSLINGER.MOD\n")
    write("Press Ctrl-C to stop...\n\n")

    player.set_single_play(true)
    player.play()

    var timer = AsyncTimer::new().unwrap()
    var seconds: u32 = 0
    var user_stopped = false

    while !player.is_finished() {
        match timer.wait_or_break(Duration::secs(1)) {
            WaitResult::Timer => {
                seconds++
                let mins = seconds / 60u32
                let secs = seconds % 60u32
                let pct = player.progress()

                write("Time: %ld:%02ld  Pos: %ld/%ld (%ld%%)\r",
                    mins, secs,
                    (u32)player.song_position(), (u32)player.song_length(),
                    (u32)pct)
            },
            WaitResult::Break => {
                user_stopped = true
                break
            },
            WaitResult::TimerAndBreak => {
                user_stopped = true
                break
            },
        }
    }

    player.stop()
    write(if user_stopped { "\nStopped by user.\n" } else { "\nSong finished.\n" })

    return 0
}
