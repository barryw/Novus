// Example: Boolean Types
//
// Description:
//   Tests boolean type with logical operations (&&, ||, !) and comparisons.
//
// Expected Output:
//   Exit code: result of boolean logic

pub fn test_bool_literals() -> bool {
    let x: bool = true
    let y: bool = false
    return x
}

pub fn test_comparison_lt() -> bool {
    let a: u32 = 10u32
    let b: u32 = 20u32
    return a < b  // true
}

pub fn test_comparison_gt() -> bool {
    let a: u32 = 30u32
    let b: u32 = 20u32
    return a > b  // true
}

pub fn test_comparison_eq() -> bool {
    let a: i32 = 42
    let b: i32 = 42
    return a == b  // true
}

pub fn test_comparison_ne() -> bool {
    let a: i32 = 10
    let b: i32 = 20
    return a != b  // true
}

pub fn test_logical_and() -> bool {
    let x: bool = true
    let y: bool = true
    return x && y  // true
}

pub fn test_logical_or() -> bool {
    let x: bool = true
    let y: bool = false
    return x || y  // true
}

pub fn test_logical_not() -> bool {
    let x: bool = false
    return !x  // true
}

pub fn test_bool_in_if() -> u32 {
    let condition: bool = true
    if condition {
        return 42u32
    }
    return 0u32
}

pub fn test_comparison_in_if() -> u32 {
    let a: u32 = 10u32
    let b: u32 = 20u32
    if a < b {
        return 1u32
    } else {
        return 0u32
    }
}

pub fn main() -> u32 {
    let result: bool = test_comparison_lt()
    if result {
        return 42u32
    }
    return 0u32
}
