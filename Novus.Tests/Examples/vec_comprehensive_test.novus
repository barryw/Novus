from std::core import Vec, Option

fn main() -> i32 {
    // Test 1: Create empty vector
    var v: Vec<i32> = Vec::new()

    if !v.is_empty() {
        return 1  // FAIL: New vector should be empty
    }

    if v.len() != 0u32 {
        return 2  // FAIL: New vector length should be 0
    }

    // Test 2: Push elements
    v.push(10)
    v.push(20)
    v.push(30)

    if v.len() != 3u32 {
        return 3  // FAIL: Should have 3 elements
    }

    if v.is_empty() {
        return 4  // FAIL: Should not be empty
    }

    // Test 3: Get elements
    let val0: Option<i32> = v.get(0u32)
    let val1: Option<i32> = v.get(1u32)
    let val2: Option<i32> = v.get(2u32)

    // Note: Can't match on Option yet, so we'll skip validation
    // In a real test we'd match and verify values are 10, 20, 30

    // Test 4: Set element
    let success: bool = v.set(1u32, 25)
    if !success {
        return 5  // FAIL: Set should succeed
    }

    // Test 5: Pop element
    let popped: Option<i32> = v.pop()
    // Should be Some(30)

    if v.len() != 2u32 {
        return 6  // FAIL: Should have 2 elements after pop
    }

    // Test 6: Push more elements to trigger growth
    v.push(40)
    v.push(50)
    v.push(60)
    v.push(70)

    if v.len() != 6u32 {
        return 7  // FAIL: Should have 6 elements
    }

    // Test 7: Clear
    v.clear()

    if v.len() != 0u32 {
        return 8  // FAIL: Should be empty after clear
    }

    if !v.is_empty() {
        return 9  // FAIL: Should be empty after clear
    }

    // Capacity should still be > 0 after clear
    if v.capacity() == 0u32 {
        return 10  // FAIL: Capacity should remain after clear
    }

    // Test 8: with_capacity
    var v2: Vec<i32> = Vec::with_capacity(10u32)

    if v2.capacity() < 10u32 {
        return 11  // FAIL: Should have at least requested capacity
    }

    if v2.len() != 0u32 {
        return 12  // FAIL: with_capacity should create empty vector
    }

    // Add some elements
    v2.push(100)
    v2.push(200)
    v2.push(300)

    // Test 9: Out of bounds get should return None (we can't match yet, so just call it)
    let out_of_bounds: Option<i32> = v2.get(100u32)

    // Test 10: Out of bounds set should return false
    let set_result: bool = v2.set(100u32, 999)
    if set_result {
        return 13  // FAIL: Set out of bounds should return false
    }

    // Clean up
    v.drop()
    v2.drop()

    // All tests passed!
    return 42
}
