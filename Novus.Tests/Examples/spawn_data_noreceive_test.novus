// Test spawning with data but worker doesn't receive it

from std::core import Result
from std::error::errors import DosError
from std::os::task import spawn_task_fn_with_ptr
from std::ffi::dos import VPrintf, Delay

fn worker() -> i32 {
    VPrintf("Worker: running (ignoring data)\n", (*u8)0)
    return 0
}

pub fn main() -> i32 {
    VPrintf("Main: starting\n", (*u8)0)

    let data: *u8 = (*u8)12345

    VPrintf("Main: spawning worker with data\n", (*u8)0)

    let result = spawn_task_fn_with_ptr("DataWorker", worker, data, 8192)
    match result {
        Result::Err(_) => {
            VPrintf("Main: spawn failed\n", (*u8)0)
            return 1
        },
        Result::Ok(handle) => {
            VPrintf("Main: spawn succeeded\n", (*u8)0)
        }
    }

    // Give worker time to run
    Delay(100)

    VPrintf("Main: done\n", (*u8)0)
    return 0
}
