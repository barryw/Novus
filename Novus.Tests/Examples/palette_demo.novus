// Palette Demo - Demonstrates std::graphics::palette color management
// Shows chipset-aware color operations with automatic scaling

from std::graphics::palette import Color, rgb, from_rgb4, set_color, load_palette
from std::graphics::palette import BLACK, WHITE, RED, GREEN, BLUE
from std::system import CHIPSET, CPU, SystemChipset
from std::io import print, println
from std::fmt import format

fn main() -> i32 {
    println("=== Novus Palette Demo ===")
    println("")

    // Detect hardware
    let chipset = CHIPSET()
    let cpu = CPU()
    print("Chipset: ")
    println(chipset.to_string())
    print("CPU: ")
    println(cpu.to_string())
    println("")

    // Show maximum colors for current chipset
    match chipset {
        SystemChipset::OCS => {
            println("OCS mode: 32 colors, 4-bit precision (0-15 per channel)")
        },
        SystemChipset::ECS => {
            println("ECS mode: 32 colors, 4-bit precision (0-15 per channel)")
        },
        SystemChipset::AGA => {
            println("AGA mode: 256 colors, 8-bit precision (0-255 per channel)")
        }
    }
    println("")

    // Demonstrate Color creation
    println("Creating colors:")

    let color1 = rgb(255, 128, 64)
    println("  rgb(255, 128, 64) - 8-bit orange")

    let color2 = from_rgb4(15, 8, 4)
    println("  from_rgb4(15, 8, 4) - 4-bit orange (scaled to 8-bit)")

    let color3 = Color { r: 192, g: 96, b: 32 }
    println("  Color { r: 192, g: 96, b: 32 } - struct literal")
    println("")

    // Show 4-bit conversion
    println("Converting to 4-bit (OCS/ECS):")
    let (r4, g4, b4) = color1.to_rgb4()
    print("  rgb(255, 128, 64) -> 4-bit: (")
    print(format("{}", r4))
    print(", ")
    print(format("{}", g4))
    print(", ")
    print(format("{}", b4))
    println(")")
    println("")

    // Show predefined colors
    println("Predefined colors:")
    println("  BLACK:   (0, 0, 0)")
    println("  WHITE:   (255, 255, 255)")
    println("  RED:     (255, 0, 0)")
    println("  GREEN:   (0, 255, 0)")
    println("  BLUE:    (0, 0, 255)")
    println("")

    // Create a demo palette
    println("Demo palette (4 colors):")
    let palette: [Color; 4] = [
        BLACK,
        RED,
        GREEN,
        BLUE
    ]

    var i: i32 = 0
    while i < 4 {
        let c = palette[i]
        print("  Color ")
        print(format("{}", i))
        print(": RGB(")
        print(format("{}", c.r))
        print(", ")
        print(format("{}", c.g))
        print(", ")
        print(format("{}", c.b))
        println(")")
        i = i + 1
    }
    println("")

    println("Note: To actually set colors, you need a valid ViewPort pointer")
    println("Example: set_color(vp, 1, RED) or load_palette(vp, &palette)")
    println("")

    println("Demo complete!")
    return 0
}
