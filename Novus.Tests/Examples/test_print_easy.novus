from dos import Output, Write

// strlen implemented in assembly (string_utils.s)
extern fn strlen(str: i32) -> i32

fn print(message: i32) -> i32 {
    let stdout = Output()
    if stdout == 0 {
        return -1
    }
    let len = strlen(message)
    return Write(stdout, message, len)
}

pub fn main() -> u32 {
    print((i32)"Hello, world!")
    print((i32)"\nNo more length counting!")
    print((i32)"\nSuccess!\n")
    return 0
}
