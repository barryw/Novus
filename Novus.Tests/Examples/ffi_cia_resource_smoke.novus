from amiga::raw::exec import OpenResource
from amiga::raw::resources::cia import AbleICR
from amiga::raw::structs import Library
from amiga::raw::consts import operation_not_permitted

pub fn main() -> i32 {
    let cia = unsafe { OpenResource("ciaa.resource") }
    if cia == null {
        return 1
    }

    let state = unsafe { AbleICR((*Library)cia, 0) }
    return (i32)(state & 0) + (i32)(operation_not_permitted & 0)
}
