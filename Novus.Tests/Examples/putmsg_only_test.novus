// Test ONLY PutMsg - no GetMsg, no FreeMem

from amiga::raw::dos import VPrintf, Delay
from amiga::raw::exec import AllocMem, PutMsg, FindTask
from amiga::raw::consts import MEMF_PUBLIC, MEMF_CLEAR
from amiga::raw::structs import Process, Message, MsgPort

pub fn main() -> i32 {
    VPrintf("1-START\n", (*u8)0)

    // Get our own Process structure
    let me = (*Process)FindTask(null)
    var me_val: u32 = (u32)me
    VPrintf("ME=%08lx\n", (*u8)&me_val)

    // Allocate message
    let msg_size: u32 = 24
    let msg_mem = unsafe { AllocMem(msg_size, MEMF_PUBLIC | MEMF_CLEAR) }
    if (u32)msg_mem == 0 {
        VPrintf("ALLOC FAIL\n", (*u8)0)
        return 1
    }

    VPrintf("2-ALLOCATED\n", (*u8)0)

    let msg = (*Message)msg_mem
    msg.mn_Node.ln_Type = 5  // NT_MESSAGE
    msg.mn_ReplyPort = null
    msg.mn_Length = (u16)msg_size

    VPrintf("3-MSG SETUP\n", (*u8)0)

    // Get pointer to our own MsgPort
    let my_port = (*MsgPort)(*u8)&me.pr_MsgPort
    var port_val: u32 = (u32)my_port
    VPrintf("PORT=%08lx\n", (*u8)&port_val)

    VPrintf("4-ABOUT TO PUTMSG\n", (*u8)0)

    // Put message to our own port
    PutMsg(my_port, msg)

    VPrintf("5-PUTMSG DONE\n", (*u8)0)
    Delay(10)

    VPrintf("5b-AFTER DELAY\n", (*u8)0)

    // Intentionally leak the message - don't call GetMsg or FreeMem
    // Just exit cleanly
    VPrintf("6-EXITING (leak ok)\n", (*u8)0)
    return 0
}
