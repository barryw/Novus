// Example: FP Error - Return Type
//
// Description:
//   Negative test: should reject function pointers with wrong return type.
//
// Expected Output:
//   Compilation error expected

fn print_sum(a: i32, b: i32) {
    // Returns void, not i32
}

fn apply_operation(x: i32, y: i32, op: fn(i32, i32) -> i32) -> i32 {
    return op(x, y)
}

fn main() -> i32 {
    // ERROR: print_sum returns void, but we need fn(i32, i32) -> i32
    let result = apply_operation(10, 5, print_sum)
    return result
}
