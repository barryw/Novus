// Example: Variable Mutation
//
// Description:
//   Tests basic variable reassignment. Shows mutable variables can be updated.
//
// Expected Output:
//   Exit code: updated value

struct Counter {
    value: i32,
}

impl Counter {
    fn increment(&mut self) {
        self.value++
    }
}

pub fn main() -> i32 {
    var c: Counter = Counter {
        value: 0,
    }

    // This should modify c.value from 0 to 1
    c.increment()

    return c.value
}
