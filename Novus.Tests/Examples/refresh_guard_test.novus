// RefreshGuard RAII Test - demonstrates automatic BeginRefresh/EndRefresh
from std::ui::window import WindowHandle, WindowEvent, RefreshGuard
from std::io::file import write

pub fn main() -> i32 {
    let result = WindowHandle::app_window("RefreshGuard Test", 640, 480)

    match result {
        Result::Ok(window) => {
            write("Window opened. Waiting for events...\n")
            write("Try resizing or covering/uncovering the window to trigger refresh events\n")

            forever {
                let event = window.wait_event()

                match event {
                    WindowEvent::Close => {
                        write("Close event - exiting\n")
                        break
                    },
                    WindowEvent::Resize(w, h) => {
                        write("Resize: {w}x{h}\n")
                    },
                    WindowEvent::Refresh(guard) => {
                        // BeginRefresh was automatically called by RefreshGuard constructor
                        write("Refresh event received\n")
                        write("RefreshGuard is active - BeginRefresh already called\n")
                        // You can do custom rendering here using guard.window() if needed
                        // EndRefresh will be automatically called when guard drops at end of this scope!
                    },
                    _ => {
                        write("Other event\n")
                    }
                }
                // RefreshGuard drops here (if it was created in Refresh branch)
                // This automatically calls EndRefresh - no manual cleanup needed!
            }

            write("Exiting main loop\n")
            return 0
        },
        Result::Err(_) => {
            write("Failed to open window\n")
            return 20  // RETURN_FAIL
        }
    }
}
