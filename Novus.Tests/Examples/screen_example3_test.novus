// Test Examples 1, 2, and 3 from screen_builder_example
// Run: novus compile screen_example3_test.novus -o screen_example3_test --safety-level 0

from std::ui::screen import ScreenHandle, ScreenBuilder
from std::ffi::dos import Delay
from std::ffi::graphics import SetAPen, RectFill, Move, Text
from std::io::file import println

pub fn main() -> i32 {
    println("=== Examples 1-3 Test ===")

    // Example 1
    println("Example 1: lores()...")
    let result1 = ScreenHandle::lores("Simple Lores Screen", 4)
    match result1 {
        Result::Ok(screen1) => {
            let rp = screen1.rastport()
            SetAPen(rp, 1)
            RectFill(rp, 10, 20, 100, 80)
            Delay(100)
            println("Example 1 done.")
        },
        Result::Err(_) => {
            println("Example 1 FAILED!")
            return 1
        }
    }

    // Example 2
    println("Example 2: ScreenBuilder...")
    let result2 = ScreenBuilder::new().title("Builder Demo").width(320).depth(5).show_title(false).build()
    match result2 {
        Result::Ok(screen2) => {
            let rp = screen2.rastport()
            let scr_height = screen2.height()
            var y: i16 = 0
            while y < scr_height {
                SetAPen(rp, (u32)(y / 8))
                RectFill(rp, 0, y, 319, y + 7)
                y = y + 8
            }
            Delay(100)
            println("Example 2 done.")
        },
        Result::Err(_) => {
            println("Example 2 FAILED!")
            return 2
        }
    }

    // Example 3 - hires
    println("Example 3: hires()...")
    let result3 = ScreenHandle::hires("Workbench Clone", 2)
    match result3 {
        Result::Ok(screen3) => {
            let rp3 = screen3.rastport()
            SetAPen(rp3, 1)
            RectFill(rp3, 20, 20, 620, 30)
            Move(rp3, 250, 128)
            Text(rp3, "640x200 HiRes Mode", 18)
            Delay(100)
            println("Example 3 done.")
        },
        Result::Err(_) => {
            println("Example 3 FAILED!")
            return 3
        }
    }

    println("All done!")
    return 0
}
