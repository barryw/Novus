// ANSI Console Test - Demonstrates ANSI escape sequence usage in Novus
//
// This test exercises the std::io::ansi library functions
// for cursor control, colors, and text styling.

from std::io::ansi import *
from std::io::file import write

pub fn main() -> i32 {
    write("ANSI Console Test\n")
    write("=================\n\n")

    // Test 1: Simple pen functions
    write("Test 1: Pens\n")
    let rst = reset()

    write(f"{fg(Pen::Pen1)}Pen1 text{rst} | ")
    write(f"{fg(Pen::Pen2)}Pen2 text{rst} | ")
    write(f"{fg(Pen::Pen3)}Pen3 text{rst}\n\n")

    // Test 2: Text styling
    write("Test 2: Styles\n")
    write(f"{bold()}Bold{rst} | ")
    write(f"{underline()}Underline{rst} | ")
    write(f"{reverse()}Reverse{rst}\n\n")

    // Test 3: Builder pattern
    write("Test 3: Builder pattern\n")
    var builder = Ansi::new()
    builder.bold()
    builder.fg(Pen::Pen2)  // White on standard WB
    builder.bg(Pen::Pen3)  // Blue on standard WB
    write(f"{builder.build()}Bold Pen2 on Pen3{rst}\n\n")

    // Test 4: Cursor movement
    write("Test 4: Cursor positioning\n")
    let pos = move_to(1, 1)  // Would move to top-left
    write("  move_to(1, 1) = [")
    // Print the bytes in hex-like format
    var i: u32 = 0u32
    while i < pos.len() {
        if i > 0 {
            write(" ")
        }
        let byte = pos.as_str().get(i)
        match byte {
            Option::Some(b) => {
                // Just show we got a byte
                write(".")
            },
            Option::None => {}
        }
        i++
    }
    write("]\n")

    let up = cursor_up(5)
    write("  cursor_up(5) length = ")
    // Show length
    if up.len() > 0 {
        write("OK\n")
    } else {
        write("ERROR\n")
    }

    // Test 5: Clear functions
    write("\nTest 5: Clear sequence lengths\n")
    write(f"  clear_screen() = {clear_screen()} (function)\n")

    let clr = clear(ClearMode::All)
    write("  clear(ClearMode::All) length = ")
    if clr.len() > 0 {
        write("OK\n")
    } else {
        write("ERROR\n")
    }

    // Test 6: Background pens
    write("\nTest 6: Background pens\n")
    write(f"{bg(Pen::Pen1)} Pen1 BG {rst} ")
    write(f"{bg(Pen::Pen3)} Pen3 BG {rst}\n\n")

    // Test 7: Default size
    write("Test 7: Default console size\n")
    let size = default_size()
    write("  Default: 80x25 (width=")
    if size.width == 80u32 {
        write("80")
    } else {
        write("?")
    }
    write(", height=")
    if size.height == 25u32 {
        write("25")
    } else {
        write("?")
    }
    write(")\n")

    write("\nAll tests completed!\n")
    return 0
}
