// Minimal allocation test - find where it hangs

from std::string::core import Str
from amiga::raw::exec import AllocMem, FreeMem

extern fn write(format: *u8, ...args) -> i32

fn main() -> i32 {
    write("1. Starting\n".ptr)

    // Test AllocMem directly
    var ptr: *u8 = null
    unsafe {
        ptr = AllocMem(256, 65537)  // MEMF_PUBLIC | MEMF_CLEAR
    }

    write("2. After AllocMem\n".ptr)

    if let p = ptr {
        write("4. AllocMem succeeded\n".ptr)

        // Try to write to it
        unsafe {
            *p = 72  // 'H'
        }

        write("5. Wrote to memory\n".ptr)

        unsafe {
            FreeMem(p, 256)
        }

        write("6. FreeMem done\n".ptr)
    } else {
        write("3. AllocMem returned NULL\n".ptr)
        return 1
    }

    return 0
}
