// Test const generics basic functionality

pub struct Buffer<const N: u32> {
    bytes: [u8; N],
    len: u32
}

impl<const N: u32> Buffer<N> {
    pub fn new() -> Buffer<N> {
        return Buffer { bytes: [0u8; N], len: 0 }
    }

    pub fn capacity(&self) -> u32 {
        return N
    }

    pub fn set(&var self, index: u32, value: u8) {
        self.bytes[index] = value
    }

    pub fn get(&self, index: u32) -> u8 {
        return self.bytes[index]
    }
}

pub fn main() -> i32 {
    // Test with type inference
    let buf1 = Buffer::<16>::new()
    if buf1.capacity() != 16 {
        return 1
    }

    // Test with explicit type annotation
    let buf2: Buffer<16> = Buffer::<16>::new()
    if buf2.capacity() != 16 {
        return 2
    }

    // Test with different const values
    let buf3: Buffer<32> = Buffer::<32>::new()
    if buf3.capacity() != 32 {
        return 3
    }

    let buf4: Buffer<64> = Buffer::<64>::new()
    if buf4.capacity() != 64 {
        return 4
    }

    // Test that different const values create distinct types
    var buf5 = Buffer::<8>::new()
    if buf5.capacity() != 8 {
        return 5
    }
    buf5.set(7u32, 42u8)
    if buf5.get(7u32) != 42u8 {
        return 6
    }
    if @sizeof(Buffer<8>) != 12u32 || @sizeof(Buffer<32>) != 36u32 {
        return 7
    }

    return 0
}
