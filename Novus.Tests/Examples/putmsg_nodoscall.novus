// Test PutMsg then exit without any DOS calls

from amiga::raw::dos import VPrintf
from amiga::raw::exec import AllocMem, PutMsg, FindTask
from amiga::raw::consts import MEMF_PUBLIC, MEMF_CLEAR
from amiga::raw::structs import Process, Message, MsgPort

pub fn main() -> i32 {
    VPrintf("1-START\n", (*u8)0)

    // Get our own Process structure
    let me = (*Process)FindTask(null)

    // Allocate message
    let msg_size: u32 = 24
    let msg_mem = unsafe { AllocMem(msg_size, MEMF_PUBLIC | MEMF_CLEAR) }
    if (u32)msg_mem == 0 {
        VPrintf("ALLOC FAIL\n", (*u8)0)
        return 1
    }

    VPrintf("2-ALLOCATED\n", (*u8)0)

    let msg = (*Message)msg_mem
    msg.mn_Node.ln_Type = 5
    msg.mn_ReplyPort = null
    msg.mn_Length = (u16)msg_size

    let my_port = (*MsgPort)(*u8)&me.pr_MsgPort

    VPrintf("3-ABOUT TO PUTMSG\n", (*u8)0)

    // THE PUTMSG CALL
    PutMsg(my_port, msg)

    // NO MORE DOS CALLS - just return immediately
    // If crash happens here, it's in our cleanup code
    return 0
}
