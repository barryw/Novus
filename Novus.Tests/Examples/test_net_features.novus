// Tests for networking features added in stdlib fixes
// Run with: novus test test_net_features.novus
//
// These tests validate functionality that requires bsdsocket.library
// and will only work on AmigaOS with TCP/IP stack installed.

from std::test::test import expect, expect_true, expect_false, expect_eq, expect_eq, expect_eq
from std::net::errors import NetError
from std::net::addr import Ipv4Addr, SocketAddrV4
from std::net::socket import is_tcp_functional
from std::ffi::bsdsocket import bsd_timeval, fd_set, FD_ZERO, FD_SET, FD_CLR, FD_ISSET

// ============================================================================
// NetError Display Tests
// ============================================================================

@test("NetError::Other message returns correct string")
pub fn test_neterror_other_message() {
    let err = NetError::Other(0)
    let msg = err.message()
    // message() returns a *u8 to a null-terminated string
    expect_true(msg as u32 != 0, "Other message not null")
}

@test("NetError::ConnectionRefused has message")
pub fn test_neterror_refused_message() {
    let err = NetError::ConnectionRefused
    let msg = err.message()
    // Should not be null
    expect_true(msg as u32 != 0, "message should not be null")
}

@test("NetError::TimedOut has message")
pub fn test_neterror_timeout_message() {
    let err = NetError::TimedOut
    let msg = err.message()
