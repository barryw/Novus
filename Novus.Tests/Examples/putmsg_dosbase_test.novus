// Test if PutMsg corrupts DOSBase

from std::ffi::dos import VPrintf, Delay
from std::ffi::exec import AllocMem, PutMsg, FindTask
from std::ffi::amiga_consts import MEMF_PUBLIC, MEMF_CLEAR
from std::ffi::amiga_structs import Process, Message, MsgPort

pub fn main() -> i32 {
    VPrintf("1-START\n", (*u8)0)
    Delay(5)
    VPrintf("2-DELAY OK\n", (*u8)0)

    // Get our own Process structure
    let me = (*Process)FindTask(null)

    // Allocate message
    let msg_size: u32 = 24
    let msg_mem = unsafe { AllocMem(msg_size, MEMF_PUBLIC | MEMF_CLEAR) }
    if (u32)msg_mem == 0 {
        VPrintf("ALLOC FAIL\n", (*u8)0)
        return 1
    }

    VPrintf("3-ALLOCATED\n", (*u8)0)
    Delay(5)
    VPrintf("4-DELAY OK\n", (*u8)0)

    let msg = (*Message)msg_mem
    msg.mn_Node.ln_Type = 5
    msg.mn_ReplyPort = null
    msg.mn_Length = (u16)msg_size

    let my_port = (*MsgPort)(*u8)&me.pr_MsgPort

    VPrintf("5-BEFORE PUTMSG\n", (*u8)0)
    Delay(5)
    VPrintf("6-DELAY BEFORE OK\n", (*u8)0)

    // THE PUTMSG CALL
    PutMsg(my_port, msg)

    VPrintf("7-AFTER PUTMSG\n", (*u8)0)

    // Try Delay immediately after PutMsg
    Delay(5)

    VPrintf("8-DELAY AFTER OK\n", (*u8)0)
    return 0
}
