// ReAction GUI Demo
// Tests the ReAction builder API

from std::ui::reaction import ReActionBuilder
from std::ui::reaction import ReActionWindow
from std::ui::reaction import ReActionEvent
from std::ui::reaction import LayoutOrientation
from std::ui::reaction import BevelStyle
from std::ui::reaction import LayoutHandle
from std::ui::reaction import GadgetHandle
from std::ffi::intuition import LockPubScreen
from std::ffi::intuition import UnlockPubScreen

// Gadget IDs
const GAD_OK: u32 = 1
const GAD_CANCEL: u32 = 2
const GAD_CHECKBOX: u32 = 3
const GAD_INTEGER: u32 = 4

fn main() -> i32 {
    // Lock the default public screen
    let screen = LockPubScreen((*u8)0)
    if !screen {
        return 20
    }

    // Create builder
    var builder = ReActionBuilder::new(screen)

    // Create root vertical layout
    var root = builder.layout(LayoutOrientation::Vertical)
    root.space_outer()

    // Add a group with some controls
    var group = root.add_layout(LayoutOrientation::Vertical)
    group.with_bevel(BevelStyle::Group).with_label("Options")

    group.add_checkbox(GAD_CHECKBOX, "Enable feature")
    group.add_integer(GAD_INTEGER, 100).with_minimum(0).with_maximum(999)

    // Add buttons in horizontal layout
    var buttons = root.add_layout(LayoutOrientation::Horizontal)
    buttons.add_button(GAD_OK, "OK")
    buttons.add_button(GAD_CANCEL, "Cancel")

    // Build the window
    let window_result = builder.build("ReAction Demo")

    match window_result {
        Result::Ok(window) => {
            // Event loop
            var running = true
            forever {
                if !running {
                    break
                }

                let event = window.wait_event()
                match event {
                    ReActionEvent::Close => {
                        running = false
                    },
                    ReActionEvent::GadgetUp(id) => {
                        if id == GAD_OK {
                            // OK clicked
                            running = false
                        } else if id == GAD_CANCEL {
                            // Cancel clicked
                            running = false
                        }
                    },
                    _ => {}
                }
            }
            // Window cleaned up by Drop
        },
        Result::Err(err) => {
            // Failed to create window
        }
    }

    UnlockPubScreen((*u8)0, screen)
    return 0
}
