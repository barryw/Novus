// Demonstrate String type - no more manual length counting!

from std::ffi::dos import Output, Write

pub fn main() -> u32 {
    let message = "Hello, String type!"

    // Access String fields
    let ptr = message.ptr
    let len = message.len

    // Use with DOS Write (auto-extracts .ptr when passed as i32)
    let stdout = Output()
    Write(stdout, message, len)

    return 0
}
