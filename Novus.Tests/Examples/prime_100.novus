// Prime Numbers up to 100
// Simple example demonstrating loops and Vec

from std::io::file import write
from std::string::core import Str
from std::collections::vec import Vec

pub fn main() -> i32 {
    write("Prime numbers up to 100:\n\n")

    // Create sieve
    var sieve = Vec::<bool>::new()

    // Initialize with all true
    var i: u32 = 0
    while i <= 100 {
        sieve.push(true).unwrap()
        i++
    }

    // Mark 0 and 1 as not prime
    sieve.set(0, false).unwrap()
    sieve.set(1, false).unwrap()

    // Sieve of Eratosthenes
    var p: u32 = 2
    while p * p <= 100 {
        let is_prime = *sieve.get(p).unwrap()
        let check = (u32)is_prime
        if check != 0 {
            var m: u32 = p * p
            while m <= 100 {
                sieve.set(m, false).unwrap()
                m = m + p
            }
        }
        p++
    }

    // Print primes
    var count: u32 = 0
    i = 2
    while i <= 100 {
        let val = *sieve.get(i).unwrap()
        let is_set = (u32)val
        if is_set != 0 {
            write("%ld ", i)
            count++
            if count % 10 == 0 {
                write("\n")
            }
        }
        i++
    }

    write("\n\nFound %ld primes\n", count)
    return 0
}
