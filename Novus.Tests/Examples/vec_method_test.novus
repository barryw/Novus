// Test method calls with Vec<T>

struct Vec<T> {
    ptr: *T,
    len: u32,
    capacity: u32,
}

impl<T> Vec<T> {
    fn len(&self) -> u32 {
        return self.len
    }

    fn is_empty(&self) -> bool {
        return self.len == 0u32
    }

    fn capacity(&self) -> u32 {
        return self.capacity
    }
}

fn main() -> i32 {
    // For now, just verify the impl block compiles
    // We'll add full functionality when we have allocators
    return 42
}
