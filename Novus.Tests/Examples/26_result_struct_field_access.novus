// Test: Verify we can access fields from struct extracted from Result
from error import DosError

struct Point {
    x: i32,
    y: i32
}

fn make_point() -> Result<Point, DosError> {
    let p: Point = Point { x: 42, y: 100 }
    return Result::Ok(p)
}

pub fn main() -> i32 {
    let result = make_point()

    match result {
        Ok(point) => {
            // Extract the point and verify its fields
            let x_value: i32 = point.x
            let y_value: i32 = point.y

            // Verify x is 42
            if x_value != 42 {
                return 1  // Failed: x should be 42
            }

            // Verify y is 100
            if y_value != 100 {
                return 2  // Failed: y should be 100
            }

            // Success! Both fields are correct
            return 0
        },
        Err(err) => {
            return 3  // Failed: expected Ok
        },
    }
}
