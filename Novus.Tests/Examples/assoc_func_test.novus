// Test associated functions (static methods)
// Simple test without complex generics

pub struct Counter {
    value: i32,
}

impl Counter {
    // Associated function - creates a new counter at zero
    pub fn zero() -> Counter {
        return Counter { value: 0 }
    }

    // Associated function - creates a counter with a specific value
    pub fn at(n: i32) -> Counter {
        return Counter { value: n }
    }

    // Method - increments the counter
    pub fn increment(&mut self) {
        self.value = self.value + 1
    }

    // Method - gets the current value
    pub fn get(&self) -> i32 {
        return self.value
    }
}

fn main() -> i32 {
    // Test associated function: Counter::zero()
    var c1: Counter = Counter::zero()
    if c1.get() != 0 {
        return 1
    }

    // Test associated function: Counter::at(10)
    var c2: Counter = Counter::at(10)
    if c2.get() != 10 {
        return 2
    }

    // Test methods work too
    c2.increment()
    if c2.get() != 11 {
        return 3
    }

    // Success!
    return 42
}
