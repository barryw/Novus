// Minimal test for spawning with data to isolate Guru 80000004

from std::core import Result, Option
from std::error::errors import DosError
from std::os::task import spawn_task_fn_with_ptr, receive_startup_data
from std::ffi::dos import VPrintf, Delay

fn worker() -> i32 {
    VPrintf("Worker: started\n", (*u8)0)

    let data_opt = receive_startup_data()
    match data_opt {
        Option::Some(ptr) => {
            VPrintf("Worker: got data pointer\n", (*u8)0)
        },
        Option::None => {
            VPrintf("Worker: no data received\n", (*u8)0)
        }
    }

    VPrintf("Worker: exiting\n", (*u8)0)
    return 0
}

pub fn main() -> i32 {
    VPrintf("Main: starting\n", (*u8)0)

    let data: *u8 = (*u8)12345

    VPrintf("Main: spawning worker\n", (*u8)0)

    let result = spawn_task_fn_with_ptr("TestWorker", worker, data, 8192)
    match result {
        Result::Err(_) => {
            VPrintf("Main: spawn failed\n", (*u8)0)
            return 1
        },
        Result::Ok(handle) => {
            VPrintf("Main: spawn succeeded\n", (*u8)0)
        }
    }

    // Give worker time to run
    Delay(100)

    VPrintf("Main: done\n", (*u8)0)
    return 0
}
