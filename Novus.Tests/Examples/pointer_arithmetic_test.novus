// Test pointer arithmetic with element size scaling
fn test_add(ptr: *i32, offset: u32) -> *i32 {
    // Should scale offset by 4 (sizeof(i32))
    return ptr + offset
}

fn test_sub(ptr: *i32, offset: u32) -> *i32 {
    // Should scale offset by 4 (sizeof(i32))
    return ptr - offset
}

fn test_add_const(ptr: *i32) -> *i32 {
    // Constant offset: should use LEA with scaled displacement
    return ptr + 5u32
}

fn main() -> i32 {
    // Just define the functions - they won't be called
    // This tests that pointer arithmetic code generation works
    return 42
}
