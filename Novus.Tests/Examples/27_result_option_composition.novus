// Test: Result<Option<T>, E> - Composing Result and Option together
// Verifies that nested generics work correctly for real-world patterns

from std::error import DosError

// Test with simple i32 type first
fn find_number(id: i32) -> Result<Option<i32>, DosError> {
    if id == 1 {
        // Found a number
        return Result::Ok(Option::Some(42))
    }

    if id == 2 {
        // No number found - return Ok with None
        return Result::Ok(Option::None())
    }

    // Error case
    return Result::Err(DosError::NotFound)
}

pub fn main() -> i32 {
    // Test 1: Ok(Some(value)) - Success with data
    let result1 = find_number(1)
    match result1 {
        Ok(opt1) => {
            match opt1 {
                Some(value1) => {
                    if value1 == 42 {
                        // Success!
                        let check: i32 = 0
                    }
                },
                None => {
                    return 1  // Failed: expected Some
                },
            }
        },
        Err(err1) => {
            return 2  // Failed: expected Ok
        },
    }

    // Test 2: Ok(None) - Success but no data
    let result2 = find_number(2)
    match result2 {
        Ok(opt2) => {
            match opt2 {
                Some(value2) => {
                    return 3  // Failed: expected None
                },
                None => {
                    // Correct: got None
                    let check: i32 = 0
                },
            }
        },
        Err(err2) => {
            return 4  // Failed: expected Ok
        },
    }

    // Test 3: Err(error) - Actual error
    let result3 = find_number(99)
    match result3 {
        Ok(opt3) => {
            return 5  // Failed: expected Err
        },
        Err(err3) => {
            // Correct: got error
            let check: i32 = 0
        },
    }

    // Test 4: Verify the types compose correctly
    // Result<Option<i32>, DosError> should be a valid type
    let test_result: Result<Option<i32>, DosError> = Result::Ok(Option::Some(100))

    match test_result {
        Ok(opt4) => {
            match opt4 {
                Some(val4) => {
                    if val4 == 100 {
                        // Type composition works!
                        return 0  // All tests passed!
                    }
                    return 6  // Wrong value
                },
                None => {
                    return 7  // Unexpected None
                },
            }
        },
        Err(err4) => {
            return 8  // Unexpected error
        },
    }
}
