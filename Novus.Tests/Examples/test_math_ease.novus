// ============================================================================
// Step Easing Tests
// ============================================================================

@test
pub fn test_ease_steps() {
    // 4 steps: 0, 0.25, 0.5, 0.75
    let t_early = ease_steps(Fixed32::from_raw(16000), 4)  // Just under 0.25
    expect_eq(t_early.to_raw(), 0, "steps before first threshold = 0")

    let t_late = ease_steps(Fixed32::from_raw(50000), 4)  // About 0.76
    // floor(0.76 / 0.25) = floor(3.04) = 3, so 3 * 0.25 = 0.75
    let raw = t_late.to_raw()
    expect_true(raw >= 47000 && raw <= 51000, "steps at 0.76 ≈ 0.75")
}

@test
pub fn test_ease_steps_start() {
    // With steps_start, we jump at the start of each step
    let t = ease_steps_start(Fixed32::from_raw(1000), 4)  // Very small value
    // Should jump to 0.25 immediately
    let raw = t.to_raw()
    expect_true(raw >= 14000 && raw <= 18000, "steps_start jumps to 0.25")
}

