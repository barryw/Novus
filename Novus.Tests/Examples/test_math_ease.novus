// Test suite for std::math::ease

from std::math::ease import *
from std::math::fixed import Fixed32
from std::test::test import expect_eq, expect_true, expect_false

// ============================================================================
// Helper: Check if value is approximately between min and max (as raw Fixed32)
// ============================================================================

fn approx_between(val: Fixed32, min_raw: i32, max_raw: i32) -> bool {
    let raw = val.to_raw()
    return raw >= min_raw && raw <= max_raw
}

fn is_near_zero(val: Fixed32) -> bool {
    let raw = val.to_raw()
    // Widen tolerance for fixed-point precision
    return raw >= -3000 && raw <= 3000
}

fn is_near_one(val: Fixed32) -> bool {
    let raw = val.to_raw()
    // Widen tolerance for fixed-point precision
    return raw >= 62000 && raw <= 69000
}

fn is_near_half(val: Fixed32) -> bool {
    let raw = val.to_raw()
    return raw >= 30000 && raw <= 36000
}

// ============================================================================
// Linear Tests
// ============================================================================

@test
pub fn test_ease_linear() {
    let t0 = ease_linear(Fixed32::zero())
    let t1 = ease_linear(Fixed32::one())
    let th = ease_linear(Fixed32::from_raw(32768))

    expect_true(is_near_zero(t0), "linear(0) = 0")
    expect_true(is_near_one(t1), "linear(1) = 1")
    expect_true(is_near_half(th), "linear(0.5) = 0.5")
}

// ============================================================================
// Quadratic Tests
// ============================================================================

@test
pub fn test_ease_in_quad_endpoints() {
    let t0 = ease_in_quad(Fixed32::zero())
    let t1 = ease_in_quad(Fixed32::one())

    expect_true(is_near_zero(t0), "in_quad(0) = 0")
    expect_true(is_near_one(t1), "in_quad(1) = 1")
}

@test
pub fn test_ease_in_quad_middle() {
    let th = ease_in_quad(Fixed32::from_raw(32768))  // 0.5
    // 0.5² = 0.25
    expect_true(approx_between(th, 14000, 18000), "in_quad(0.5) ≈ 0.25")
}

@test
pub fn test_ease_out_quad_endpoints() {
    let t0 = ease_out_quad(Fixed32::zero())
    let t1 = ease_out_quad(Fixed32::one())

    expect_true(is_near_zero(t0), "out_quad(0) = 0")
    expect_true(is_near_one(t1), "out_quad(1) = 1")
}

@test
pub fn test_ease_out_quad_middle() {
    let th = ease_out_quad(Fixed32::from_raw(32768))  // 0.5
    // 1 - (1-0.5)² = 1 - 0.25 = 0.75
    expect_true(approx_between(th, 46000, 52000), "out_quad(0.5) ≈ 0.75")
}

@test
pub fn test_ease_in_out_quad_endpoints() {
    let t0 = ease_in_out_quad(Fixed32::zero())
    let t1 = ease_in_out_quad(Fixed32::one())

    expect_true(is_near_zero(t0), "in_out_quad(0) = 0")
    expect_true(is_near_one(t1), "in_out_quad(1) = 1")
}

@test
pub fn test_ease_in_out_quad_middle() {
    let th = ease_in_out_quad(Fixed32::from_raw(32768))
    // Should be 0.5 at midpoint
    expect_true(is_near_half(th), "in_out_quad(0.5) ≈ 0.5")
}

