// ============================================================================
// Back Tests
// ============================================================================

@test
pub fn test_ease_in_back_endpoints() {
    let t0 = ease_in_back(Fixed32::zero())
    let t1 = ease_in_back(Fixed32::one())

    expect_true(is_near_zero(t0), "in_back(0) = 0")
    expect_true(is_near_one(t1), "in_back(1) = 1")
}

@test
pub fn test_ease_in_back_overshoots() {
    // Back easing should go negative at the start
    let t_early = ease_in_back(Fixed32::from_raw(16384))  // 0.25
    expect_true(t_early.to_raw() < 0, "in_back overshoots negative")
}

@test
pub fn test_ease_out_back_endpoints() {
    let t0 = ease_out_back(Fixed32::zero())
    let t1 = ease_out_back(Fixed32::one())

    expect_true(is_near_zero(t0), "out_back(0) = 0")
    expect_true(is_near_one(t1), "out_back(1) = 1")
}

@test
pub fn test_ease_out_back_overshoots() {
    // Back easing should overshoot past 1.0
    let t_late = ease_out_back(Fixed32::from_raw(49152))  // 0.75
    expect_true(t_late.to_raw() > 65536, "out_back overshoots past 1.0")
}

