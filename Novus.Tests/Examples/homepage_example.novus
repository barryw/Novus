// Homepage showcase example - novuslang.com imports this source directly.
// Keep its behavior equivalent to homepage_example.c when changing the comparison.
// Compile: novus compile homepage_example.novus -o homepage_example --release -O3

from std::ui::screen import ScreenHandle
from std::ffi::dos import Delay
from std::ffi::graphics import SetAPen, RectFill

pub fn main() -> i32 {
    let result = ScreenHandle::lores("Demo Screen", 5)

    match result {
        Result::Ok(screen) => {
            let rp = screen.rastport()
            SetAPen(rp, 2)
            RectFill(rp, 10, 20, 100, 80)
            Delay(150)
            return 0
        },
        Result::Err(_) => {
            return 1
        }
    }
}
