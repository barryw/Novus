// Homepage showcase example - novuslang.com imports this source directly.
// Keep its behavior equivalent to homepage_example.c when changing the comparison.
// Compile: novus compile homepage_example.novus -o homepage_example --release -O3

from amiga::sys::intuition import ScreenHandle
from amiga::raw::dos import Delay
from amiga::raw::graphics import SetAPen, RectFill

pub fn main() -> i32 {
    // Generated startup code opens only the Amiga libraries this program uses
    // and closes them at exit, so there are no library bases to manage here.

    // lores detects PAL/NTSC, chooses 320x256 or 320x200, and builds the tags.
    let result = ScreenHandle::lores("Demo Screen", 5)

    // Result makes screen-open failure explicit without null checks or gotos.
    match result {
        Result::Ok(screen) => {
            // ScreenHandle owns the screen. Drop calls CloseScreen on every exit,
            // and this borrowed RastPort cannot outlive it.
            let rp = screen.rastport()
            SetAPen(rp, 2)
            RectFill(rp, 10, 20, 100, 80)
            Delay(150)
            return 0
        },
        Result::Err(_) => {
            return 1
        }
    }
}
