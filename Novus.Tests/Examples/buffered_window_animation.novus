// BufferedWindow Animation Demo - Bouncing Ball with Trails
//
// Demonstrates:
// - BufferedWindow for flicker-free animation
// - Partial buffer updates (draw only what changed)
// - Content preservation during window resize
// - Smooth animation using off-screen rendering
//
// This creates a bouncing ball that leaves a trail. When you resize
// the window, the trail is preserved and the ball bounces within
// the new dimensions.

from std::ui::buffered_window import BufferedWindow
from std::ui::window import WindowEvent
from std::graphics::draw import DrawContext
from std::graphics::shapes import Point
from std::ffi::graphics import WaitTOF
from std::io::file import write

/// Ball state for animation
struct Ball {
    x: i16,
    y: i16,
    vx: i16,      // Velocity X
    vy: i16,      // Velocity Y
    radius: i16,
}

impl Ball {
    /// Create a new ball at position with velocity
    fn new(x: i16, y: i16, vx: i16, vy: i16, radius: i16) -> Ball {
        return Ball {
            x: x,
            y: y,
            vx: vx,
            vy: vy,
            radius: radius,
        }
    }

    /// Update ball position and handle wall bouncing
    fn update(&mut self, width: i16, height: i16) {
        // Update position
        self.x = self.x + self.vx
        self.y = self.y + self.vy

        // Bounce off walls
        if self.x - self.radius < 0 {
            self.x = self.radius
            self.vx = -self.vx
        }
        if self.x + self.radius >= width {
            self.x = width - self.radius - 1
            self.vx = -self.vx
        }

        if self.y - self.radius < 0 {
            self.y = self.radius
            self.vy = -self.vy
        }
        if self.y + self.radius >= height {
            self.y = height - self.radius - 1
            self.vy = -self.vy
        }
    }

    /// Draw the ball to the buffer
    fn draw(&self, ctx: &DrawContext) {
        ctx.pen(3)
        ctx.circle(self.x, self.y, self.radius)

        // Fill the ball
        let mut r: i16 = self.radius
        while r > 0 {
            ctx.circle(self.x, self.y, r)
            r = r - 1
        }
    }
}

/// Simple frame-rate limiting (busy wait)
fn delay_frames(frames: i32) {
    let mut i: i32 = 0
    while i < frames {
        WaitTOF()  // Wait for vertical blank (50Hz PAL / 60Hz NTSC)
        i = i + 1
    }
}

pub fn main() -> i32 {
    write("BufferedWindow Animation Demo - Bouncing Ball\n\n")

    // Create buffered window
    let result = BufferedWindow::new("Bouncing Ball - Resize Me!", 640, 480)

    match result {
        Result::Ok(mut window) => {
            // Clear buffer to black
            window.clear(0)

            // Create ball in center with random-ish velocity
            let (width, height) = window.buffer_size()
            let mut ball = Ball::new(
                width / 2,
                height / 2,
                5,  // vx
                3,  // vy
                10  // radius
            )

            // Present initial cleared buffer
            let _ = window.present()

            write("Animation started! The ball will leave a trail.\n")
            write("Resize the window - the trail is preserved!\n")
            write("Click close gadget to exit\n\n")

            let mut running: bool = true
            let mut frame_count: i32 = 0

            while running {
                // Poll for events (non-blocking)
                let event_opt = window.poll_event()
                match event_opt {
                    Option::Some(event) => {
                        match event {
                            WindowEvent::Close => {
                                write("Close gadget clicked - exiting\n")
                                running = false
                            },
                            WindowEvent::Resize(new_width, new_height) => {
                                // Buffer automatically resized!
                                // Trail is preserved, but we need to re-present
                                write("Window resized to {new_width}×{new_height}\n")

                                // Update ball to stay in bounds
                                let (w, h) = window.buffer_size()
                                if ball.x >= w {
                                    ball.x = w / 2
                                }
                                if ball.y >= h {
                                    ball.y = h / 2
                                }

                                // Clear buffer and restart trail
                                window.clear(0)
                                let _ = window.present()
                            },
                            WindowEvent::Refresh(_) => {
                                // Auto-handled, but note it
                                write("Refresh event (auto-handled)\n")
                            },
                            _ => {}
                        }
                    },
                    Option::None => {
                        // No events - continue animation
                    }
                }

                if running {
                    // Update ball physics
                    let (w, h) = window.buffer_size()
                    ball.update(w, h)

                    // Draw ball to buffer (leaves a trail)
                    let ctx_result = window.draw_context()
                    match ctx_result {
                        Result::Ok(ctx) => {
                            ball.draw(&ctx)
                        },
                        Result::Err(_) => {}
                    }

                    // Present buffer to screen
                    let _ = window.present()

                    // Limit to ~25 FPS (2 frames @ 50Hz PAL)
                    delay_frames(2)

                    frame_count = frame_count + 1

                    // Debug output every 100 frames
                    if frame_count % 100 == 0 {
                        write("Frame {frame_count}: Ball at ({ball.x}, {ball.y})\n")
                    }
                }
            }

            write("\nTotal frames rendered: {frame_count}\n")
            write("BufferedWindow automatically cleaned up!\n")
            return 0
        },
        Result::Err(_) => {
            write("ERROR: Failed to open buffered window\n")
            return 20
        }
    }
}
