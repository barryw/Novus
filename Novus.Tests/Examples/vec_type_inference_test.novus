// Test automatic type inference for Vec
// This should compile without explicit type annotations!
from std::collections import Vec

fn test_inference() -> i32 {
    // No type annotation - compiler should infer Vec<i32> from push() call
    var vec = Vec::new()

    // This call should resolve the generic type to Vec<i32>
    vec.push(42i32)
    vec.push(99i32)

    return 0
}

fn main() -> i32 {
    return test_inference()
}
