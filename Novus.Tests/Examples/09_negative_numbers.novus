// Example: Negative Numbers
//
// Description:
//   Tests handling of negative number literals and negative arithmetic with signed types.
//
// Expected Output:
//   Exit code: calculated result

fn negative_i8() -> i8 {
    return -42i8
}

fn negative_i16() -> i16 {
    return -1000i16
}

fn negative_i32() -> i32 {
    return -999999i32
}

pub fn main() -> i32 {
    return -42
}
