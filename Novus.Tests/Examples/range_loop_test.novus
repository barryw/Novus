// Test for range-based for loops
// Demonstrates for i in start..end and for i in start..=end syntax

from std::io::core import write
from std::strings::core import Str

pub fn main() -> i32 {
    // Test 1: Exclusive range (0..5 gives 0,1,2,3,4)
    let mut sum1: i32 = 0
    for i in 0..5 {
        sum1 = sum1 + i
    }
    // sum1 should be 0+1+2+3+4 = 10
    if sum1 != 10 {
        write("Test 1 FAILED: exclusive range\n")
        return 1
    }
    write("Test 1 PASSED: exclusive range (0..5)\n")

    // Test 2: Inclusive range (1..=5 gives 1,2,3,4,5)
    let mut sum2: i32 = 0
    for i in 1..=5 {
        sum2 = sum2 + i
    }
    // sum2 should be 1+2+3+4+5 = 15
    if sum2 != 15 {
        write("Test 2 FAILED: inclusive range\n")
        return 2
    }
    write("Test 2 PASSED: inclusive range (1..=5)\n")

    // Test 3: Range with variables
    let start: i32 = 2
    let end: i32 = 7
    let mut sum3: i32 = 0
    for i in start..end {
        sum3 = sum3 + i
    }
    // sum3 should be 2+3+4+5+6 = 20
    if sum3 != 20 {
        write("Test 3 FAILED: range with variables\n")
        return 3
    }
    write("Test 3 PASSED: range with variables\n")

    // Test 4: Break in range loop
    let mut sum4: i32 = 0
    for i in 0..100 {
        if i == 5 {
            break
        }
        sum4 = sum4 + i
    }
    // sum4 should be 0+1+2+3+4 = 10
    if sum4 != 10 {
        write("Test 4 FAILED: break in range loop\n")
        return 4
    }
    write("Test 4 PASSED: break in range loop\n")

    // Test 5: Continue in range loop
    let mut sum5: i32 = 0
    for i in 0..10 {
        if i == 5 {
            continue
        }
        sum5 = sum5 + i
    }
    // sum5 should be 0+1+2+3+4+6+7+8+9 = 40
    if sum5 != 40 {
        write("Test 5 FAILED: continue in range loop\n")
        return 5
    }
    write("Test 5 PASSED: continue in range loop\n")

    // Test 6: Nested range loops
    let mut sum6: i32 = 0
    for i in 0..3 {
        for j in 0..4 {
            sum6 = sum6 + 1
        }
    }
    // sum6 should be 3*4 = 12
    if sum6 != 12 {
        write("Test 6 FAILED: nested range loops\n")
        return 6
    }
    write("Test 6 PASSED: nested range loops\n")

    // Test 7: Empty range (5..5 should not execute body)
    let mut sum7: i32 = 0
    for i in 5..5 {
        sum7 = sum7 + 1
    }
    if sum7 != 0 {
        write("Test 7 FAILED: empty range\n")
        return 7
    }
    write("Test 7 PASSED: empty range (5..5)\n")

    // Test 8: Labeled break with range loop
    let mut count8: i32 = 0
    outer: for i in 0..10 {
        for j in 0..10 {
            count8 = count8 + 1
            if count8 == 15 {
                break outer
            }
        }
    }
    if count8 != 15 {
        write("Test 8 FAILED: labeled break with range\n")
        return 8
    }
    write("Test 8 PASSED: labeled break with range\n")

    write("All range loop tests PASSED!\n")
    return 0
}
