// Bouncing Ball - OS-Managed Sprite Demo
//
// Demonstrates OS sprite control using std::graphics::os_sprite
// Features:
// - OS-managed sprite allocation (uses graphics.library)
// - Intuition window integration
// - Physics-based ball movement with bouncing
// - Automatic error conversion via From<T> trait
//
// This example showcases the ? operator automatically converting
// IntuitionError -> NovusError and GraphicsError -> NovusError via From trait implementations

from std::core import Result
from std::graphics::sprite import SpriteData, init_sprite_system
from std::graphics::os_sprite import OsSpriteHandle
from std::error::errors import NovusError
from std::ui::window import WindowHandle
from std::ffi::amiga_structs import ViewPort
from std::ffi::graphics import WaitTOF

// Ball physics state
struct Ball {
    x: i16,
    y: i16,
    vx: i16,
    vy: i16,
}

impl Ball {
    fn new(x: i16, y: i16, vx: i16, vy: i16) -> Ball {
        return Ball {
            x: x,
            y: y,
            vx: vx,
            vy: vy,
        }
    }

    fn update(&var self, min_x: i16, max_x: i16, min_y: i16, max_y: i16) {
        self.x = self.x + self.vx
        self.y = self.y + self.vy

        if self.x <= min_x || self.x >= max_x {
            self.vx = -self.vx
            if self.x < min_x {
                self.x = min_x
            }
            if self.x > max_x {
                self.x = max_x
            }
        }

        if self.y <= min_y || self.y >= max_y {
            self.vy = -self.vy
            if self.y < min_y {
                self.y = min_y
            }
            if self.y > max_y {
                self.y = max_y
            }
        }
    }
}

fn main() -> Result<(), NovusError> {
    // Initialize sprite system (enables DMA and detects PAL/NTSC)
    init_sprite_system()

    // Set sprite colors (sprite 0 uses color registers 17-19)
    // Color 17 = sprite color 1, Color 18 = sprite color 2, Color 19 = sprite color 3
    unsafe {
        let color_regs = (*u16)$DFF180  // Base of color registers
        color_regs[17] = $0F00u16  // Color 1: Red
        color_regs[18] = $00F0u16  // Color 2: Green
        color_regs[19] = $0FF0u16  // Color 3: Yellow (our ball)
    }

    // Create ball sprite data (16x16 ball pattern)
    // Format: VSTART/VSTOP control words, then 2 words per scanline (bitplanes), then terminator
    // Both bitplanes set to same value = color 3 (sprite color register 19)
    let ball_sprite_raw = [
        $2C40u16, $3C00u16,  // Control: VSTART=$2C (44), VSTOP=$3C (60), X=0
        // Scanline 0-15 (16 lines for 16-pixel tall sprite)
        $0000u16, $0000u16,  // Line 0: empty
        $0000u16, $0000u16,  // Line 1: empty
        $0000u16, $0000u16,  // Line 2: empty
        $07E0u16, $07E0u16,  // Line 3:  .XXXXXX. (color 3)
        $1FF8u16, $1FF8u16,  // Line 4: XXXXXXXX (color 3)
        $3FFCu16, $3FFCu16,  // Line 5: XXXXXXXXXX (color 3)
        $7FFEu16, $7FFEu16,  // Line 6: XXXXXXXXXXXX (color 3)
        $7FFEu16, $7FFEu16,  // Line 7: XXXXXXXXXXXX (color 3)
        $7FFEu16, $7FFEu16,  // Line 8: XXXXXXXXXXXX (color 3)
        $7FFEu16, $7FFEu16,  // Line 9: XXXXXXXXXXXX (color 3)
        $3FFCu16, $3FFCu16,  // Line 10: XXXXXXXXXX (color 3)
        $1FF8u16, $1FF8u16,  // Line 11: XXXXXXXX (color 3)
        $07E0u16, $07E0u16,  // Line 12:  .XXXXXX. (color 3)
        $0000u16, $0000u16,  // Line 13: empty
        $0000u16, $0000u16,  // Line 14: empty
        $0000u16, $0000u16,  // Line 15: empty
        $0000u16, $0000u16   // Terminator
    ]

    let sprite_data = SpriteData::from_raw(
        (*u16)&ball_sprite_raw,
        36u32  // 2 control + 16*2 data + 2 terminator = 36 words
    )?

    // Create window (returns IntuitionError, but ? will auto-convert to GraphicsError via From trait)
    let window = WindowHandle::simple("OS Sprite Demo", 320, 200)?

    // Get viewport from window screen
    let screen = window.get_screen()
    let viewport = &(*screen).ViewPort

    // Allocate OS sprite (any available sprite)
    var sprite = OsSpriteHandle::alloc(viewport, -1)?

    // Initialize ball physics
    let min_x: i16 = 10
    let max_x: i16 = 300
    let min_y: i16 = 10
    let max_y: i16 = 190

    var ball = Ball::new(160, 100, 3, 2)

    // Show sprite at initial position
    sprite.show(&sprite_data, ball.x, ball.y)?

    // Animation loop (run for ~5 seconds at 50 fps)
    var frame: u32 = 0u32
    while frame < 250u32 {
        WaitTOF()
        ball.update(min_x, max_x, min_y, max_y)
        sprite.move_to(ball.x, ball.y)?
        frame = frame + 1u32
    }

    // Hide sprite before cleanup
    sprite.hide()?

    // Window and sprite automatically cleaned up via Drop trait
    return Result::Ok(())
}
