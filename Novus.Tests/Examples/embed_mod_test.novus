// @embed attribute test for MOD files
// Demonstrates the unified asset embedding system

from std::core import Result
from amiga::sys::hardware::ptplayer import ModPlayer, ModAsset
from amiga::sys::audio::errors import AudioError
from amiga::sys::hardware::chipset import DISPLAY, DisplayType
from amiga::sys::exec::memory::chip import is_chip_ram
from std::io::file import write, wait_for_key

// Embed MOD in fast RAM using @embed (auto-detects .mod extension)
// chip=false means it goes to fast RAM with automatic chip RAM copy on play
@embed("GSLINGER.MOD", chip = false)
static music: [u8] = []

pub fn main() -> i32 {
    write("@embed MOD Test\n\n")

    let is_pal = DISPLAY() == DisplayType::PAL
    write("Display: %s\n", if is_pal { "PAL" } else { "NTSC" })
    write("MOD data at: 0x%lx (%s)\n",
          (u32)music.data,
          if is_chip_ram(music.data) { "chip RAM" } else { "fast RAM" })
    write("MOD size: %ld bytes\n\n", music.size)

    let player_result = ModPlayer::new(is_pal)
    match player_result {
        Result::Ok(var player) => {
            write("Initializing (copying to chip RAM)...\n")

            let init_result = player.init_asset(&music, 0)
            match init_result {
                Result::Ok(_) => {
                    player.play()
                    write("Playing! Press any key to stop...\n")
                    wait_for_key()
                    player.stop()
                    write("Done!\n")
                    return 0
                },
                Result::Err(err) => {
                    match err {
                        AudioError::ChipCacheError => write("ERROR: Out of chip RAM\n"),
                        _ => write("ERROR: Init failed\n")
                    }
                    return 2
                }
            }
        },
        Result::Err(_) => {
            write("ERROR: Failed to create player\n")
            return 1
        }
    }
}
