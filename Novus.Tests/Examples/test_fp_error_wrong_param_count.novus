// Example: FP Error - Param Count
//
// Description:
//   Negative test: should reject function pointers with wrong parameter count.
//
// Expected Output:
//   Compilation error expected

fn negate(x: i32) -> i32 {
    return -x
}

fn apply_operation(x: i32, y: i32, op: fn(i32, i32) -> i32) -> i32 {
    return op(x, y)
}

fn main() -> i32 {
    // ERROR: negate takes 1 parameter, but we need fn(i32, i32) -> i32 (2 parameters)
    let result = apply_operation(10, 5, negate)
    return result
}
