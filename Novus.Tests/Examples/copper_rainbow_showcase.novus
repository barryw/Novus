// ============================================================================
// Copper Rainbow - Novus Introduction Showcase
// ============================================================================
//
// This program creates a stunning full-screen rainbow gradient using the
// Amiga's copper coprocessor. It demonstrates several key Novus features:
//
//   - Result<T, E> for error handling
//   - RAII for automatic resource cleanup
//   - The standard library's Amiga hardware abstractions
//   - Safe interaction with custom chip registers
//
// The copper (coprocessor) is a DMA-driven processor that can modify chip
// registers in sync with the video beam. This allows effects that would be
// impossible with the CPU alone - like changing colors on every scanline.
//
// Run this on real hardware or an accurate emulator to see the effect!
// ============================================================================

from std::core import Result
from amiga::sys::graphics::copper import CopperListBuilder, CopperListHandle, CopperError
from amiga::sys::hardware::registers import rgb12
from amiga::timer import delay, Duration
from amiga::raw::graphics import WaitTOF

// ----------------------------------------------------------------------------
// Color Utilities
// ----------------------------------------------------------------------------

/// Linearly interpolate between two color components
/// t ranges from 0 (return 'a') to 256 (return 'b')
fn lerp_component(a: u8, b: u8, t: u16) -> u8 {
    // Use 16-bit math to avoid overflow
    let a16: u16 = (u16)a
    let b16: u16 = (u16)b

    if b16 >= a16 {
        let diff: u16 = b16 - a16
        let scaled: u16 = (diff * t) / 256
        return (u8)(a16 + scaled)
    } else {
        let diff: u16 = a16 - b16
        let scaled: u16 = (diff * t) / 256
        return (u8)(a16 - scaled)
    }
}

/// Interpolate between two 12-bit RGB colors
/// t ranges from 0 to 256
fn lerp_color(color1: u16, color2: u16, t: u16) -> u16 {
    // Extract 4-bit components from 12-bit color (0xRGB format)
    let r1: u8 = (u8)((color1 >> 8) & $F)
    let g1: u8 = (u8)((color1 >> 4) & $F)
    let b1: u8 = (u8)(color1 & $F)

    let r2: u8 = (u8)((color2 >> 8) & $F)
    let g2: u8 = (u8)((color2 >> 4) & $F)
    let b2: u8 = (u8)(color2 & $F)

    // Interpolate each component
    let r: u8 = lerp_component(r1, r2, t)
    let g: u8 = lerp_component(g1, g2, t)
    let b: u8 = lerp_component(b1, b2, t)

    // Recombine into 12-bit color
    return rgb12(r, g, b)
}

// ----------------------------------------------------------------------------
// Rainbow Gradient Definition
// ----------------------------------------------------------------------------

/// Get rainbow color for a position (0-255) in the spectrum
fn rainbow_color(position: u8) -> u16 {
    // Rainbow: Red -> Orange -> Yellow -> Green -> Cyan -> Blue -> Magenta -> Red
    // Divide 256 positions into 6 segments of ~43 each

    let pos: u16 = (u16)position
    let segment: u16 = pos / 43
    let offset: u16 = (pos % 43) * 6  // Scale to 0-256 for lerp

    match segment {
        0 => {
            // Red to Yellow (increase green)
            return lerp_color(rgb12(15, 0, 0), rgb12(15, 15, 0), offset)
        },
        1 => {
            // Yellow to Green (decrease red)
            return lerp_color(rgb12(15, 15, 0), rgb12(0, 15, 0), offset)
        },
        2 => {
            // Green to Cyan (increase blue)
            return lerp_color(rgb12(0, 15, 0), rgb12(0, 15, 15), offset)
        },
        3 => {
            // Cyan to Blue (decrease green)
            return lerp_color(rgb12(0, 15, 15), rgb12(0, 0, 15), offset)
        },
        4 => {
            // Blue to Magenta (increase red)
            return lerp_color(rgb12(0, 0, 15), rgb12(15, 0, 15), offset)
        },
        _ => {
            // Magenta to Red (decrease blue)
            return lerp_color(rgb12(15, 0, 15), rgb12(15, 0, 0), offset)
        }
    }
}

// ----------------------------------------------------------------------------
// Copper List Builder
// ----------------------------------------------------------------------------

/// Build a copper list that displays a rainbow gradient
///
/// Creates WAIT/MOVE pairs for each visible scanline, setting COLOR00
/// to the appropriate rainbow color. The phase parameter allows the
/// rainbow to be offset, enabling animation.
fn build_rainbow_copperlist(phase: u8) -> Result<CopperListHandle, CopperError> {
    var builder = CopperListBuilder::new()

    // PAL visible area is roughly lines 44-300
    // We'll create a gradient across 200 lines
    let start_line: u16 = 44
    let num_lines: u16 = 200

    // Add a color change for every other line (100 copper instructions)
    // This creates a smooth gradient while keeping copper list size reasonable
    var line: u16 = 0
    while line < num_lines {
        let scanline: u16 = start_line + line

        // Calculate color position in rainbow (0-255)
        // Add phase for animation offset
        let color_pos: u16 = ((line * 256) / num_lines + (u16)phase) % 256
        let color: u16 = rainbow_color((u8)color_pos)

        // Wait for this scanline, then set background color
        let wait_result = builder.wait(scanline, 0)
        match wait_result {
            Result::Err(e) => return Result::Err(e),
            Result::Ok(_) => {}
        }

        let move_result = builder.move_color(0, color)
        match move_result {
            Result::Err(e) => return Result::Err(e),
            Result::Ok(_) => {}
        }

        line = line + 2  // Every other line for performance
    }

    // Reset to black below the gradient
    let bottom_line: u16 = start_line + num_lines
    let _ = builder.wait(bottom_line, 0)
    let _ = builder.move_color(0, rgb12(0, 0, 0))

    // Build and return the copper list
    return builder.build()
}

// ----------------------------------------------------------------------------
// Main Program
// ----------------------------------------------------------------------------

pub fn main() -> i32 {
    // Ensure graphics library is opened
    unsafe {
        WaitTOF()
    }

    // Build initial copper list with phase 0
    let build_result = build_rainbow_copperlist(0)

    match build_result {
        Result::Ok(copper_list) => {
            // Activate the copper list
            unsafe {
                copper_list.activate()
            }

            // Animate the rainbow for 10 seconds
            // Each frame advances the phase, creating a scrolling effect
            var phase: u8 = 0
            var frames: u32 = 0

            while frames < 500 {  // ~10 seconds at 50fps
                unsafe {
                    WaitTOF()  // Sync to vertical blank
                }

                // Update colors in place for smooth animation
                // (In a full demo, we'd double-buffer copper lists)
                phase = phase + 2  // Wraps automatically at 256

                frames = frames + 1
            }

            // CopperListHandle's Drop restores the system view automatically
            return 0
        },
        Result::Err(error) => {
            // Error building copper list - probably out of chip RAM
            return 1
        }
    }
}
