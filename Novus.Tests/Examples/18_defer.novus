// Example: Defer Statement
// Demonstrates automatic cleanup with defer (executes in LIFO order)

fn cleanup_resource(id: i32) -> i32 {
    // In a real scenario, this might close files, free memory, etc.
    // Return the resource ID to confirm cleanup
    return id
}

fn open_resource(id: i32) -> i32 {
    return id * 100
}

pub fn main() -> i32 {
    var result = 0

    // Open first resource
    var resource1 = open_resource(1)

    // Defer cleanup - will execute when function returns
    defer {
        var cleanup1 = cleanup_resource(1)
        result = result + cleanup1
    }

    // Open second resource
    var resource2 = open_resource(2)

    // Another deferred cleanup
    defer {
        var cleanup2 = cleanup_resource(2)
        result = result + cleanup2
    }

    // Open third resource
    var resource3 = open_resource(3)

    // Third deferred cleanup
    defer {
        var cleanup3 = cleanup_resource(3)
        result = result + cleanup3
    }

    // Defers execute in LIFO order when function returns:
    // 1. Third defer: cleanup(3)  -> result = 0 + 3 = 3
    // 2. Second defer: cleanup(2) -> result = 3 + 2 = 5
    // 3. First defer: cleanup(1)  -> result = 5 + 1 = 6

    // Return the accumulated result (should be 6)
    return result
}
