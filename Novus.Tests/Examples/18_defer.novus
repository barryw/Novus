// Example: Defer Statement
//
// Description:
//   Demonstrates defer blocks for cleanup that execute in LIFO order at scope exit.
//   IMPORTANT: Return value is computed BEFORE defer blocks execute!
//
// Expected Output:
//   Exit code: 0 (defers execute after return value is computed)

fn cleanup_resource(id: i32) -> i32 {
    // In a real scenario, this might close files, free memory, etc.
    // Return the resource ID to confirm cleanup
    return id
}

fn open_resource(id: i32) -> i32 {
    return id * 100
}

pub fn main() -> i32 {
    // Open first resource
    var resource1 = open_resource(1)

    // Defer cleanup - will execute when function returns (LIFO order)
    defer {
        var cleanup1 = cleanup_resource(1)
        // In a real program, this would close file handles, free memory, etc.
    }

    // Open second resource
    var resource2 = open_resource(2)

    // Another deferred cleanup
    defer {
        var cleanup2 = cleanup_resource(2)
    }

    // Open third resource
    var resource3 = open_resource(3)

    // Third deferred cleanup
    defer {
        var cleanup3 = cleanup_resource(3)
    }

    // Execution order:
    // 1. Return value (0) is computed
    // 2. Third defer executes: cleanup_resource(3)
    // 3. Second defer executes: cleanup_resource(2)
    // 4. First defer executes: cleanup_resource(1)
    // 5. Function returns with value 0
    //
    // Note: Defer blocks execute AFTER return value is computed,
    // so they cannot affect the return value!

    return 0
}
