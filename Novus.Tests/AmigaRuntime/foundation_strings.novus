// Target-executed conformance tests for literals, Str, String, and interpolation.

from std::string::core import FixedCString, FixedString, Str, String, StringError
from std::test::test import expect, expect_true

fn takes_str(value: Str) -> u32 {
    return value.len
}

@test("string literals expose stable bytes and lengths")
pub fn foundation_string_literals() {
    let value: Str = "Novus"
    expect(value.len == 5, "literal length")
    unsafe {
        expect(value.as_ptr()[0] == 'N', "first byte")
        expect(value.as_ptr()[4] == 's', "last byte")
    }
}

@test("string literals coerce into Str parameters")
pub fn foundation_string_coercion() {
    expect(takes_str("Amiga") == 5, "literal coercion")
}

@test("Str slicing and comparison")
pub fn foundation_str_operations() {
    let value: Str = "foundation"
    match value.slice(0, 4) {
        Ok(prefix) => expect_true(prefix.equals("foun"), "slice"),
        Err(_) => expect(false, "slice should succeed"),
    }
    expect_true(value.starts_with("found"), "starts_with")
    expect_true(value.ends_with("tion"), "ends_with")
}

@test("owned String appends and preserves contents")
pub fn foundation_owned_string() {
    match String::new_from_str("Novus") {
        Ok(string) => {
            var value = string
            match value.push_str(" 68k") {
                Ok(_) => expect(true, "append succeeds"),
                Err(_) => expect(false, "append should succeed"),
            }
            expect_true(value.as_str().equals("Novus 68k"), "appended contents")
        },
        Err(_) => expect(false, "String allocation should succeed"),
    }
}

@test("const-sized strings enforce capacity and C termination")
pub fn foundation_fixed_strings() {
    match FixedString::<5>::new_from_str("Novus") {
        Ok(value) => expect_true(value.as_str().equals("Novus"), "fixed contents"),
        Err(_) => expect(false, "fixed string should fit"),
    }

    match FixedCString::<4>::new_from_str("SYS:") {
        Ok(value) => {
            expect_true(value.as_str().equals("SYS:"), "C string contents")
            unsafe {
                expect(value.as_cstr()[4] == 0, "full C string remains terminated")
            }
        },
        Err(_) => expect(false, "C string should fit exactly"),
    }

    match FixedCString::<3>::new_from_str("four") {
        Err(StringError::TooLong(4)) => expect(true, "overflow rejected"),
        _ => expect(false, "overlong C string must fail"),
    }
}

@test("f-string interpolation composes Display values")
pub fn foundation_fstrings() {
    let language: Str = "Novus"
    let cpu: i32 = 68020
    let message = f"{language} {cpu}"
    expect_true(message.equals("Novus 68020"), "interpolated contents")
}

@test("for-in advances stateful Iterator values")
pub fn foundation_iterator_for_in() {
    var count: u32 = 0
    var total: u32 = 0
    for part in "a,bb,ccc".split(',') {
        count++
        total = total + part.len()
    }
    expect(count == 3, "iterator item count")
    expect(total == 6, "iterator yielded values")
}
