from std::test::test import expect
from amiga::raw::consts import MEMF_CHIP, MEMF_CLEAR
from amiga::raw::exec import AllocVec, FreeVec
from amiga::raw::structs import AnimComp, AnimOb, RastPort, VSprite, ViewPort
from amiga::sys::graphics::gels import AnimObBuilder, BobHandle, GelError, GelsSystem, VSpriteHandle
from amiga::sys::intuition::screen import ScreenHandle

fn collision_callback(first: *VSprite, second: *VSprite) {}
fn anim_object_callback(object: *AnimOb) -> i16 { return 0 }
fn anim_frame_callback(component: *AnimComp) -> i16 { return 0 }

@test("GELS system initializes and releases its sentinels")
pub fn gels_system_lifecycle() {
    let screen = ScreenHandle::lores("Tier 2 GELS init", 2).unwrap()
    let rp = unsafe { (*RastPort)screen.rastport() }
    let vp = screen.viewport()
    let gels = GelsSystem::init(rp, vp)
    expect(gels.is_ok(), "GELS system initializes")
}

