// @covers amiga::sys::graphics::gels::AnimObHandle::hide(&var GelsSystem)
// @covers amiga::sys::graphics::gels::AnimObHandle::is_active()
// @covers amiga::sys::graphics::gels::AnimObHandle::move_by(i16, i16)
// @covers amiga::sys::graphics::gels::AnimObHandle::move_to(i16, i16)
// @covers amiga::sys::graphics::gels::AnimObHandle::position()
// @covers amiga::sys::graphics::gels::AnimObHandle::set_acceleration(i16, i16)
// @covers amiga::sys::graphics::gels::AnimObHandle::set_collision_masks(u16, u16)
// @covers amiga::sys::graphics::gels::AnimObHandle::set_velocity(i16, i16)
// @covers amiga::sys::graphics::gels::AnimObHandle::set_velocity_pixels(i16, i16)
// @covers amiga::sys::graphics::gels::AnimObHandle::show(&var GelsSystem)
// @covers amiga::sys::graphics::gels::AnimObHandle::velocity()
@test("GELS handles create, render, animate, and release native objects")
pub fn gels_contracts() {
    expect((u32)GelError::OutOfMemory.message() != 0, "GELS errors have messages")
    let _ = GelError::InvalidDimensions.to_graphics_error()
    let screen = ScreenHandle::lores("Tier 2 GELS", 2).unwrap()
    let rp = unsafe { (*RastPort)screen.rastport() }
    let vp = screen.viewport()
    let image = AllocVec(128, MEMF_CHIP | MEMF_CLEAR)
    let shadow = AllocVec(32, MEMF_CHIP | MEMF_CLEAR)
    expect(image != null && shadow != null, "GELS image buffers allocate in chip RAM")

    {
        var gels = GelsSystem::init(rp, vp).unwrap()
        expect(gels.is_initialized() && gels.gels_info() != null, "GELS initializes")
        expect(gels.rast_port() == rp && gels.view_port() == vp, "GELS retains display pointers")
        gels.set_bounds(0, 319, 0, 199)
        expect(gels.set_collision(16, collision_callback).is_err(), "collision type is validated")
        expect(gels.set_collision(0, collision_callback).is_ok(), "collision callback installs")
        gels.inc_active()
        expect(gels.active_count() == 1, "manual active increment is visible")
        gels.dec_active()
        expect(gels.active_count() == 0, "manual active decrement is visible")
        gels.sort()
        gels.animate()
        gels.do_collision()

        expect(VSpriteHandle::new(&gels, 0, 4, 1, image).is_err(), "invalid VSprite dimensions are rejected")
        var sprite = VSpriteHandle::new(&gels, 16, 4, 1, image).unwrap()
        sprite.move_to(20, 20)
        sprite.move_by(2, 3)
        let (sprite_x, sprite_y) = sprite.position()
        expect(sprite_x == 22 && sprite_y == 23, "VSprite position updates")
        sprite.set_collision_masks(1, 2)
        let (sprite_me, sprite_hit) = sprite.collision_masks()
        expect(sprite_me == 1 && sprite_hit == 2, "VSprite collision masks update")
        sprite.set_image(image)
        sprite.set_collision_mask(shadow)
        let old_flags = sprite.flags()
        sprite.set_flags(old_flags)
        expect(sprite.as_ptr() != null && !sprite.is_active(), "VSprite exposes inactive native state")
        expect(sprite.hide(&var gels).is_err(), "inactive VSprite cannot hide twice")
        expect(sprite.show(&var gels).is_ok() && sprite.is_active(), "VSprite activates")
        expect(sprite.show(&var gels).is_err(), "active VSprite cannot activate twice")

        expect(BobHandle::new(&gels, 0, 4, 1, image, shadow).is_err(), "invalid BOB dimensions are rejected")
        var bob = BobHandle::new(&gels, 16, 4, 1, image, shadow).unwrap()
        bob.move_to(60, 30)
        bob.move_by(2, 3)
        let (bob_x, bob_y) = bob.position()
        expect(bob_x == 62 && bob_y == 33, "BOB position updates")
        bob.set_collision_masks(4, 8)
        let (bob_me, bob_hit) = bob.collision_masks()
        expect(bob_me == 4 && bob_hit == 8, "BOB collision masks update")
        bob.set_image(image)
        bob.set_shadow(shadow)
        expect(bob.width() == 16 && bob.height() == 4 && bob.depth() == 1, "BOB dimensions are retained")
        expect(bob.as_ptr() != null && bob.vsprite_ptr() != null && !bob.is_active(), "BOB exposes inactive native state")
        expect(bob.hide(&var gels).is_err(), "inactive BOB cannot hide twice")
        expect(bob.show(&var gels).is_ok() && bob.is_active(), "BOB activates")
        expect(bob.show(&var gels).is_err(), "active BOB cannot activate twice")

        let spare_sprite = GelsSystem::create_vsprite(&gels, 16, 4, 1, image)
        let spare_bob = GelsSystem::create_bob(&gels, 16, 4, 1, image, shadow)
        expect(spare_sprite.is_ok() && spare_bob.is_ok(), "GELS convenience constructors work")

        var empty_builder = gels.create_anim_builder()
        expect(empty_builder.build().is_err(), "animation requires a frame")
        var builder = AnimObBuilder::new(&var gels)
        builder.set_position(10, 12)
        builder.set_velocity(64, 0)
        builder.set_acceleration(1, 2)
        builder.set_on_animate(anim_object_callback)
        var sequence = builder.add_sequence()
        sequence.set_looping()
        sequence.set_chain_to(0)
        var frame = sequence.add_frame(16, 4, 1, image, shadow)
        frame.set_duration(2)
        frame.set_offset(1, 2)
        frame.set_on_enter(anim_frame_callback)
        frame.set_collision_masks(16, 32)
        var animation = builder.build().unwrap()
        expect(animation.frame_count() == 1 && animation.as_ptr() != null, "animation builds one frame")
        animation.move_to(30, 40)
        animation.move_by(2, 3)
        let (anim_x, anim_y) = animation.position()
        expect(anim_x == 32 && anim_y == 43, "animation position updates")
        animation.set_velocity(64, 128)
        animation.set_velocity_pixels(2, 3)
        let (vel_x, vel_y) = animation.velocity()
        expect(vel_x == 128 && vel_y == 192, "animation velocity updates")
        animation.set_acceleration(3, 4)
        let (accel_x, accel_y) = animation.acceleration()
        expect(accel_x == 3 && accel_y == 4, "animation acceleration updates")
        animation.set_collision_masks(16, 32)
        let (anim_me, anim_hit) = animation.collision_masks()
        expect(anim_me == 16 && anim_hit == 32, "animation collision masks update")
        expect(animation.hide(&var gels).is_err(), "inactive animation cannot hide twice")
        expect(animation.show(&var gels).is_ok() && animation.is_active(), "animation activates")
        expect(animation.show(&var gels).is_err(), "active animation cannot activate twice")

        gels.render_frame()
        expect(animation.hide(&var gels).is_ok() && !animation.is_active(), "animation hides")
        expect(bob.hide(&var gels).is_ok() && !bob.is_active(), "BOB hides")
        expect(sprite.hide(&var gels).is_ok() && !sprite.is_active(), "VSprite hides")
        expect(gels.active_count() == 0, "all active GELS objects are released")
    }

    FreeVec(shadow)
    FreeVec(image)
}
