        var pairs: [i32] = [ID_TEST, ID_ITEM_TEST]
        expect(CollectionChunks(fixture.iff, &var pairs[0], 1) == 0, "one collection pair installs")
        expect(StopChunk(fixture.iff, ID_TEST, ID_BODY_TEST) == 0 && ParseIFF(fixture.iff, PARSE_SCAN) == 0,
            "scan collects pair-selected chunks")
        let collection = FindCollection(fixture.iff, ID_TEST, ID_ITEM_TEST)
        expect(collection != null && unsafe { (*collection).ci_Next != null }, "two collection nodes are available")
        expect(pairs[0] == ID_TEST && pairs[1] == ID_ITEM_TEST, "declaration array is not mutated")
    }
    close_fixture(&var fixture)
}

// @covers-ndk function|iffparse.library|FindCollection
// @ndk-side-effects Returns the collection head for an exact type/ID tuple and null for a mismatched tuple without changing collection ownership or links
@test("iffparse.library FindCollection matches exact identity")
pub fn iffparse_find_collection() {
