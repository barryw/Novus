}

// @covers-ndk function|iffparse.library|EntryHandler
// @ndk-side-effects Invokes a custom Hook exactly once on BODY entry with the caller object in A2 and IFFCMD_ENTRY in A1; a separate exit stop returns control
@test("iffparse.library EntryHandler preserves hook register ABI")
pub fn iffparse_entry_handler() {
    ENTRY_COUNT = 0
    HANDLER_OBJECT = null
    HANDLER_COMMAND = -1
    HANDLER_RETURN = 0
    var marker: u32 = $12345678
    var entry = hook(entry_hook_entry)
    var fixture = open_fixture()
    expect(fixture.opened, "valid FORM stream opens")
    if fixture.opened {
        let marker_pointer = unsafe { (*u8)&var marker }
        expect(EntryHandler(fixture.iff, ID_TEST, ID_BODY_TEST, STORE_ROOT, &var entry, marker_pointer) == 0,
            "entry handler installs")
        expect(StopOnExit(fixture.iff, ID_TEST, ID_BODY_TEST) == 0, "BODY exit stop installs")
        expect(ParseIFF(fixture.iff, PARSE_SCAN) == -2, "exit stop returns IFFERR_EOC at BODY exit")
        expect(ENTRY_COUNT == 1 && HANDLER_OBJECT == marker_pointer, "entry hook receives exact object once")
        expect(HANDLER_COMMAND == 5, "entry hook receives IFFCMD_ENTRY")
    }
    close_fixture(&var fixture)
}

// @covers-ndk function|iffparse.library|ExitHandler
// @ndk-side-effects Invokes a custom Hook exactly once before BODY exits with the caller object in A2 and IFFCMD_EXIT in A1; IFF_RETURN2CLIENT pauses parsing normally
@test("iffparse.library ExitHandler preserves hook register ABI")
pub fn iffparse_exit_handler() {
    EXIT_COUNT = 0
    HANDLER_OBJECT = null
    HANDLER_COMMAND = -1
    HANDLER_RETURN = -12
    var marker: u32 = $89ABCDEF
    var exit = hook(exit_hook_entry)
    var fixture = open_fixture()
    expect(fixture.opened, "valid FORM stream opens")
    if fixture.opened {
        let marker_pointer = unsafe { (*u8)&var marker }
        expect(ExitHandler(fixture.iff, ID_TEST, ID_BODY_TEST, STORE_ROOT, &var exit, marker_pointer) == 0,
            "exit handler installs")
        expect(ParseIFF(fixture.iff, PARSE_SCAN) == 0, "handler returns control without an error")
        expect(EXIT_COUNT == 1 && HANDLER_OBJECT == marker_pointer, "exit hook receives exact object once")
        expect(HANDLER_COMMAND == 6, "exit hook receives IFFCMD_EXIT")
    }
    HANDLER_RETURN = 0
    close_fixture(&var fixture)
}

// @covers-ndk function|iffparse.library|StopOnExit
// @ndk-side-effects Installs one BODY exit stop, returns IFFERR_EOC with the exact BODY context still current, and proves the payload remains caller-readable at that pause boundary
@test("iffparse.library StopOnExit pauses after complete chunk consumption")
pub fn iffparse_stop_on_exit() {
    var fixture = open_fixture()
    expect(fixture.opened, "valid FORM stream opens")
    if fixture.opened {
        expect(StopOnExit(fixture.iff, ID_TEST, ID_BODY_TEST) == 0, "BODY exit stop installs")
        expect(ParseIFF(fixture.iff, PARSE_SCAN) == -2, "scan returns IFFERR_EOC at BODY exit")
        let current = CurrentChunk(fixture.iff)
        expect(current != null, "a context remains current at the exit boundary")
        if current != null {
            expect(unsafe { (*current).cn_ID == ID_BODY_TEST }, "BODY remains current at its exit boundary")
            expect(unsafe { (*current).cn_Size == 8 }, "BODY preserves its exact declared size")
            var byte: u8 = 0
            expect(ReadChunkBytes(fixture.iff, &var byte, 1) == 1 && byte == 10,
                "BODY payload remains caller-readable from its first byte")
        }
    }
    close_fixture(&var fixture)
}

// @covers-ndk function|iffparse.library|StoreItemInContext
// @ndk-side-effects Transfers a local item into the exact current BODY ContextNode, makes it discoverable immediately, and lets parser teardown purge it with that context
@test("iffparse.library StoreItemInContext targets an exact context node")
pub fn iffparse_store_item_in_context() {
    var fixture = open_fixture()
    expect(stop_at_body(&var fixture), "parser reaches BODY")
    if fixture.opened {
        let context = CurrentChunk(fixture.iff)
        let item = AllocLocalItem(ID_TEST, ID_BODY_TEST, ID_LOCAL, 0)
        expect(context != null && item != null, "current context and local item exist")
        if context != null && item != null {
            StoreItemInContext(fixture.iff, item, context)
            expect(FindLocalItem(fixture.iff, ID_TEST, ID_BODY_TEST, ID_LOCAL) == item,
                "exact context exposes transferred item")
        } else if item != null {
            FreeLocalItem(item)
        }
    }
    close_fixture(&var fixture)
}
