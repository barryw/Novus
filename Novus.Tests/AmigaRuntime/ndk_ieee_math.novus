// @covers-ndk function|mathieeesingtrans.library|IEEESPTan
// @ndk-side-effects Returns the tangent without mutation
@test("mathieeesingtrans IEEESPTan preserves zero")
pub fn ieee_sp_tan() { expect(IEEESPTan(0.0) == 0.0, "tan zero is zero") }

// @covers-ndk function|mathieeesingtrans.library|IEEESPSincos
// @ndk-side-effects Returns sine and writes cosine through the supplied pointer
@test("mathieeesingtrans IEEESPSincos returns both components")
pub fn ieee_sp_sincos() {
    var cosine: f32 = 0.0
    let sine = IEEESPSincos(&var cosine, 0.0)
    expect(sine == 0.0 && cosine == 1.0, "zero produces sine zero and cosine one")
}

