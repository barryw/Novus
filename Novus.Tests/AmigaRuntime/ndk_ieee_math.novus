from std::test::test import expect
from amiga::raw::mathieeesingbas import IEEESPFix, IEEESPFlt, IEEESPCmp, IEEESPTst, IEEESPAbs, IEEESPNeg, IEEESPAdd, IEEESPSub, IEEESPMul, IEEESPDiv, IEEESPFloor, IEEESPCeil
from amiga::raw::mathieeesingtrans import IEEESPAtan, IEEESPSin, IEEESPCos, IEEESPTan, IEEESPSincos, IEEESPSinh, IEEESPCosh, IEEESPTanh, IEEESPExp, IEEESPLog, IEEESPPow, IEEESPSqrt, IEEESPTieee, IEEESPFieee, IEEESPAsin, IEEESPAcos, IEEESPLog10
from amiga::raw::mathieeedoubbas import IEEEDPFix, IEEEDPFlt, IEEEDPCmp, IEEEDPTst, IEEEDPAbs, IEEEDPNeg, IEEEDPAdd, IEEEDPSub, IEEEDPMul, IEEEDPDiv, IEEEDPFloor, IEEEDPCeil
from amiga::raw::mathieeedoubtrans import IEEEDPAtan, IEEEDPSin, IEEEDPCos, IEEEDPTan, IEEEDPSincos, IEEEDPSinh, IEEEDPCosh, IEEEDPTanh, IEEEDPExp, IEEEDPLog, IEEEDPPow, IEEEDPSqrt, IEEEDPTieee, IEEEDPFieee, IEEEDPAsin, IEEEDPAcos, IEEEDPLog10

fn near_f32(actual: f32, expected: f32) -> bool {
    let difference = actual - expected
    return difference > -0.001 && difference < 0.001
}

fn near_f64(actual: f64, expected: f64) -> bool {
    let difference = actual - expected
    return difference > -0.000001 && difference < 0.000001
}

// @covers-ndk function|mathieeesingbas.library|IEEESPFix
// @ndk-side-effects Converts by truncating toward zero and does not mutate caller state
@test("mathieeesingbas IEEESPFix truncates toward zero")
pub fn ieee_sp_fix() { expect(IEEESPFix(3.75) == 3 && IEEESPFix(-3.75) == -3, "both signs truncate toward zero") }

// @covers-ndk function|mathieeesingbas.library|IEEESPFlt
// @ndk-side-effects Converts an integer to IEEE single precision without mutating caller state
@test("mathieeesingbas IEEESPFlt converts signed integers")
pub fn ieee_sp_flt() { expect(IEEESPFlt(-7) == -7.0, "negative integer converts exactly") }

// @covers-ndk function|mathieeesingbas.library|IEEESPCmp
// @ndk-side-effects Compares values without mutation and returns negative, zero, or positive according to ordering
@test("mathieeesingbas IEEESPCmp reports ordering")
pub fn ieee_sp_cmp() { expect(IEEESPCmp(1.0, 2.0) < 0 && IEEESPCmp(2.0, 2.0) == 0 && IEEESPCmp(3.0, 2.0) > 0, "all ordering results are distinguished") }

// @covers-ndk function|mathieeesingbas.library|IEEESPTst
// @ndk-side-effects Tests one value without mutation and reports its sign
@test("mathieeesingbas IEEESPTst reports sign")
pub fn ieee_sp_tst() { expect(IEEESPTst(-1.0) < 0 && IEEESPTst(0.0) == 0 && IEEESPTst(1.0) > 0, "negative zero and positive are distinguished") }

// @covers-ndk function|mathieeesingbas.library|IEEESPAbs
// @ndk-side-effects Returns the magnitude without mutating caller state
@test("mathieeesingbas IEEESPAbs clears the sign")
pub fn ieee_sp_abs() { expect(IEEESPAbs(-2.5) == 2.5, "negative input becomes positive") }

// @covers-ndk function|mathieeesingbas.library|IEEESPNeg
// @ndk-side-effects Returns the negated value without mutating caller state
@test("mathieeesingbas IEEESPNeg reverses the sign")
pub fn ieee_sp_neg() { expect(IEEESPNeg(2.5) == -2.5, "positive input becomes negative") }

// @covers-ndk function|mathieeesingbas.library|IEEESPAdd
// @ndk-side-effects Returns the sum without mutating caller state
@test("mathieeesingbas IEEESPAdd adds operands")
pub fn ieee_sp_add() { expect(IEEESPAdd(1.25, 2.5) == 3.75, "sum is exact") }

// @covers-ndk function|mathieeesingbas.library|IEEESPSub
// @ndk-side-effects Returns the difference without mutating caller state
@test("mathieeesingbas IEEESPSub subtracts operands")
pub fn ieee_sp_sub() { expect(IEEESPSub(5.5, 2.0) == 3.5, "difference is exact") }

// @covers-ndk function|mathieeesingbas.library|IEEESPMul
// @ndk-side-effects Returns the product without mutating caller state
@test("mathieeesingbas IEEESPMul multiplies operands")
pub fn ieee_sp_mul() { expect(IEEESPMul(1.5, 4.0) == 6.0, "product is exact") }

// @covers-ndk function|mathieeesingbas.library|IEEESPDiv
// @ndk-side-effects Returns dividend divided by divisor without mutating caller state
@test("mathieeesingbas IEEESPDiv divides operands")
pub fn ieee_sp_div() { expect(IEEESPDiv(9.0, 4.0) == 2.25, "quotient is exact") }

// @covers-ndk function|mathieeesingbas.library|IEEESPFloor
// @ndk-side-effects Returns the greatest integral value not above the input without mutation
@test("mathieeesingbas IEEESPFloor rounds downward")
pub fn ieee_sp_floor() { expect(IEEESPFloor(-2.25) == -3.0, "negative input rounds downward") }

// @covers-ndk function|mathieeesingbas.library|IEEESPCeil
// @ndk-side-effects Returns the least integral value not below the input without mutation
@test("mathieeesingbas IEEESPCeil rounds upward")
pub fn ieee_sp_ceil() { expect(IEEESPCeil(-2.25) == -2.0, "negative input rounds upward") }

// @covers-ndk function|mathieeesingtrans.library|IEEESPAtan
// @ndk-side-effects Returns the arctangent in radians without mutation
@test("mathieeesingtrans IEEESPAtan preserves zero")
pub fn ieee_sp_atan() { expect(IEEESPAtan(0.0) == 0.0, "atan zero is zero") }

// @covers-ndk function|mathieeesingtrans.library|IEEESPSin
// @ndk-side-effects Returns the sine without mutation
