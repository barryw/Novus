// @covers-ndk function|listbrowser.library|GetLBColumnInfoAttrsA
// @ndk-side-effects Reads one allocated column's exact title, width, and flags through caller-owned destinations in a terminated TagItem list, then frees it
@test("listbrowser.library GetLBColumnInfoAttrsA reads column metadata")
pub fn listbrowser_get_columns_a() {
    let info = alloc_columns_a("P", 43, CIF_DRAGGABLE)
    var title: *u8 = null
    var width: u32 = 0
    var flags: u32 = 0
    var tags: [TagItem] = [
        TagItem { ti_Tag: LBCIA_Column, ti_Data: 0 },
        TagItem { ti_Tag: LBCIA_Title, ti_Data: (u32)(**u8)&var title },
        TagItem { ti_Tag: LBCIA_Width, ti_Data: (u32)(*u32)&var width },
        TagItem { ti_Tag: LBCIA_Flags, ti_Data: (u32)(*u32)&var flags },
        TagItem { ti_Tag: TAG_DONE, ti_Data: 0 },
    ]
    let status = if info != null { GetLBColumnInfoAttrsA(info, &var tags[0]) } else { -1 }
    let has_info = info != null
    let status_valid = status != 0
    let width_valid = width == 43
    let flags_valid = flags == (CIF_FIXED | CIF_DRAGGABLE)
    let title_valid = text_is(title, 80)
    if info != null { FreeLBColumnInfo(info) }
    expect(has_info, "tag-list getter receives allocated metadata")
    expect(status_valid, "tag-list getter returns documented non-zero success")
    expect(width_valid, "tag-list getter returns width 43")
    expect(flags_valid, "tag-list getter returns draggable and the fixed flag implied by width")
    expect(title_valid, "tag-list getter returns title P")
}

