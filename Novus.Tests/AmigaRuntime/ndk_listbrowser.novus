// @covers-ndk function|listbrowser.library|FreeLBColumnInfo
// @ndk-side-effects Completes two column-metadata allocate/free lifecycles; the per-test A4000 memory gate verifies both allocations are returned
@test("listbrowser.library FreeLBColumnInfo releases column metadata")
pub fn listbrowser_free_columns() {
    let first = alloc_columns_a("R", 45, CIF_FIXED)
    if first != null { FreeLBColumnInfo(first) }
    let second = alloc_columns_a("S", 46, CIF_DRAGGABLE)
    if second != null { FreeLBColumnInfo(second) }
    expect(first != null && second != null, "two complete column-metadata lifecycles succeed")
}

// @covers-ndk function|listbrowser.library|ListBrowserClearAll
// @ndk-side-effects Adds two selected private nodes to a detached Exec list, clears both, verifies both exact states, and frees the entire list
@test("listbrowser.library ListBrowserClearAll clears every selection")
pub fn listbrowser_clear_all() {
    var list: List = @zeroed(List)
    NewList(&var list)
    let first = alloc_node("T", 1, 1, 0, true)
    let second = alloc_node("U", 2, 1, 0, true)
    if first != null { AddTail(&var list, first) }
    if second != null { AddTail(&var list, second) }
    if first != null && second != null { ListBrowserClearAll(&var list) }
    let valid = first != null && second != null && node_value(first, LBNA_Selected) == 0 && node_value(second, LBNA_Selected) == 0
    FreeListBrowserList(&var list)
    expect(valid, "both detached-list nodes become unselected")
}
