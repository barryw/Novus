from std::test::test import expect
from amiga::raw::consts import GTYP_CLOSE, GTYP_SYSTYPEMASK, IECODE_LBUTTON, IECODE_UP_PREFIX, IECLASS_NEWPOINTERPOS, IECLASS_RAWMOUSE, IESUBCLASS_PIXEL, IND_WRITEEVENT
from amiga::raw::exec import CloseDevice, CreateIORequest, CreateMsgPort, DeleteIORequest, DeleteMsgPort, DoIO, OpenDevice
from amiga::raw::graphics import WaitTOF
from amiga::raw::structs import Gadget, IEPointerPixel, InputEvent, IORequest, IOStdReq, Window
from amiga::sys::exec::thread import run_thread_loop, spawn_thread
from amiga::sys::reaction import BevelStyle, LayoutOrientation, ReActionBuilder, ReActionEvent

const CLOSE_WORK: u32 = 1 << 17
static var CLOSE_TARGET: *Window = null
static var CLOSE_CLICKED: bool = false

fn close_gadget(window: *Window) -> *Gadget {
    var gadget = window.FirstGadget
    while gadget != null {
        if ((u32)gadget.GadgetType & GTYP_SYSTYPEMASK) == GTYP_CLOSE { return gadget }
        gadget = gadget.NextGadget
    }
    return null
}

@suppress("W0002", "pinned input constants and close-gadget coordinates fit their exact ABI fields")
fn click_close(window: *Window) -> bool {
    if window == null || window.WScreen == null { return false }
    let gadget = close_gadget(window)
    if gadget == null { return false }
    let reply = CreateMsgPort()
    if reply == null { return false }
    let request = CreateIORequest(reply, @sizeof(IOStdReq))
    if request == null {
        DeleteMsgPort(reply)
        return false
    }
    let opened = unsafe { OpenDevice("input.device", 0, (*IORequest)request, 0) } == 0
    var pixel: IEPointerPixel = @zeroed(IEPointerPixel)
    pixel.iepp_Screen = window.WScreen
    pixel.iepp_Position.X = window.LeftEdge + gadget.LeftEdge + gadget.Width / 2
    pixel.iepp_Position.Y = window.TopEdge + gadget.TopEdge + gadget.Height / 2
    var event: InputEvent = @zeroed(InputEvent)
    let io = (*IOStdReq)request
    io.io_Command = (u16)IND_WRITEEVENT
    io.io_Length = @sizeof(InputEvent)
    io.io_Data = (*u8)&var event
    event.ie_Class = (u8)IECLASS_NEWPOINTERPOS
    event.ie_SubClass = (u8)IESUBCLASS_PIXEL
    event.ie_position.ie_addr = (*u8)&var pixel
    let moved = opened && unsafe { DoIO((*IORequest)request) } == 0
    WaitTOF()
    event = @zeroed(InputEvent)
    event.ie_Class = (u8)IECLASS_RAWMOUSE
    event.ie_Code = (u16)IECODE_LBUTTON
    let down = moved && unsafe { DoIO((*IORequest)request) } == 0
    WaitTOF()
    event.ie_Code = (u16)(IECODE_LBUTTON | IECODE_UP_PREFIX)
    let up = down && unsafe { DoIO((*IORequest)request) } == 0
    if opened { unsafe { CloseDevice((*IORequest)request) } }
    DeleteIORequest(request)
    DeleteMsgPort(reply)
    return up
}

fn close_tick(_state: *u8) -> bool {
    for var frame: u32 = 0; frame < 30; frame++ { WaitTOF() }
    CLOSE_CLICKED = click_close(CLOSE_TARGET)
    return false
}

fn close_thread() -> i32 { return run_thread_loop(CLOSE_WORK, null, close_tick) }

// @covers amiga::sys::reaction::GadgetHandle::disabled()
// @covers amiga::sys::reaction::GadgetHandle::read_only()
// @covers amiga::sys::reaction::GadgetHandle::selected()
// @covers amiga::sys::reaction::GadgetHandle::with_maximum(i32)
// @covers amiga::sys::reaction::GadgetHandle::with_minimum(i32)
// @covers amiga::sys::reaction::LayoutHandle::add_button(u32, Str)
// @covers amiga::sys::reaction::LayoutHandle::add_checkbox(u32, Str)
// @covers amiga::sys::reaction::LayoutHandle::add_integer(u32, i32)
// @covers amiga::sys::reaction::LayoutHandle::add_label(Str)
// @covers amiga::sys::reaction::LayoutHandle::add_layout(LayoutOrientation)
// @covers amiga::sys::reaction::LayoutHandle::add_radiobutton(u32, Slice<Str>)
// @covers amiga::sys::reaction::LayoutHandle::space_outer()
// @covers amiga::sys::reaction::LayoutHandle::with_bevel(BevelStyle)
// @covers amiga::sys::reaction::LayoutHandle::with_label(Str)
// @covers amiga::sys::reaction::ReActionBuilder::build(Str)
// @covers amiga::sys::reaction::ReActionBuilder::layout(LayoutOrientation)
// @covers amiga::sys::reaction::ReActionBuilder::new(*Screen)
// @covers amiga::sys::reaction::ReActionBuilder::workbench()
// @covers amiga::sys::reaction::ReActionWindow::poll_event()
// @covers amiga::sys::reaction::ReActionWindow::refresh_layout()
// @covers amiga::sys::reaction::ReActionWindow::sig_mask()
// @covers amiga::sys::reaction::ReActionWindow::window()
@test("ReAction builder creates nested native layouts and configured gadgets")
pub fn reaction_builder_contract() {
    var builder = ReActionBuilder::workbench().unwrap()
    var root = builder.layout(LayoutOrientation::Vertical)
    root.space_outer().with_bevel(BevelStyle::Group).with_label("Controls")
    var row = root.add_layout(LayoutOrientation::Horizontal)
    var button = row.add_button(1, "OK")
    button.disabled()
    var checkbox = row.add_checkbox(2, "Enabled")
    checkbox.selected()
    var integer = root.add_integer(3, 5)
    integer.read_only().with_minimum(-10).with_maximum(10)
    root.add_label("Mode")
    var options = ["One", "Two", "Three"]
    root.add_radiobutton(4, &options)
    let window = builder.build("ReAction contracts").unwrap()
    expect(window.window() != null && window.sig_mask() != 0, "native ReAction window and signal are live")
    let _event = window.poll_event()
    window.refresh_layout()
}

// @covers amiga::sys::reaction::ReActionBuilder::build_with_menu(Str, GadToolsMenuStrip)
// @covers amiga::sys::reaction::ReActionBuilder::menu_builder()
// @covers amiga::sys::reaction::ReActionWindow::wait_event()
@test("ReAction window owns a GadTools menu and waits for a real close event")
pub fn reaction_menu_event_contract() {
    var builder = ReActionBuilder::workbench().unwrap()
    var root = builder.layout(LayoutOrientation::Vertical)
    root.add_button(10, "Close")
    var menus = builder.menu_builder()
    var project = menus.add_menu("Project")
    project.add_item("Close")
    let strip = menus.build().unwrap()
    let window = builder.build_with_menu("ReAction menu", strip).unwrap()
    CLOSE_TARGET = window.window()
    CLOSE_CLICKED = false
    var closer = spawn_thread("Tier12 ReAction closer", close_thread, 8192).unwrap()
    closer.signal(CLOSE_WORK)
    closer.wait()
    expect(CLOSE_CLICKED, "close gadget receives injected input")
    if CLOSE_CLICKED {
        var closed = false
        while !closed { closed = matches!(window.wait_event(), ReActionEvent::Close) }
        expect(closed, "wait_event decodes close")
    }
}
