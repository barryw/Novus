from std::core import Result
from std::memory::bytes import ByteError, ByteReader, ByteWriter
from std::test::test import expect

// @covers std::memory::bytes::ByteReader::new(Slice<u8>)
// @covers std::memory::bytes::ByteReader::read_be_u16(usize)
// @covers std::memory::bytes::ByteReader::read_be_u32(usize)
// @covers std::memory::bytes::ByteWriter::new(MutSlice<u8>)
// @covers std::memory::bytes::ByteWriter::write_be_u16(usize, u16)
// @covers std::memory::bytes::ByteWriter::write_be_u32(usize, u32)
@test("big-endian byte access is bounds checked")
pub fn foundation_bytes() {
    var bytes: [u8] = [0; 8]
    {
        var writer = ByteWriter::new(&var bytes)
        match writer.write_be_u16(0, $1234) {
            Result::Ok(_) => {},
            Result::Err(_) => expect(false, "write u16"),
        }
        match writer.write_be_u32(2, $89ABCDEF) {
            Result::Ok(_) => {},
            Result::Err(_) => expect(false, "write u32"),
        }
        match writer.write_be_u32(5, 0) {
            Result::Err(ByteError::OutOfBounds) => {},
            _ => expect(false, "reject crossing end"),
        }
    }

    let reader = ByteReader::new(&bytes)
    match reader.read_be_u16(0) {
        Result::Ok(value) => expect(value == $1234, "read u16"),
        Result::Err(_) => expect(false, "read u16 failed"),
    }
    match reader.read_be_u32(2) {
        Result::Ok(value) => expect(value == $89ABCDEF, "read u32"),
        Result::Err(_) => expect(false, "read u32 failed"),
    }
    match reader.read_be_u16($FFFFFFFF) {
        Result::Err(ByteError::OutOfBounds) => {},
        _ => expect(false, "overflow-safe bounds check"),
    }
}
