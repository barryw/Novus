from std::string import Str
from std::test::test import expect
from amiga::raw::consts import ACTION_CHANGE_MODE, ACTION_COPY_DIR, ACTION_EXAMINE_ALL, ACTION_IS_FILESYSTEM, ACTION_READ_LINK, ACTION_SAME_LOCK, CHANGE_LOCK, DOS_EXALLCONTROL, ED_NAME
from amiga::raw::dos import AllocDosObject, Close, CreateDir, DeleteFile, DeviceProc, DoPkt, DoPkt0, DoPkt1, DoPkt2, DoPkt3, DoPkt4, ExAllEnd, FreeDosObject, Lock, MakeLink, Open, Read, SameLock, SetProtection, UnLock, Write
from amiga::raw::structs import ExAllControl, ExAllData, MsgPort

fn c_equals(actual: *u8, expected: Str) -> bool {
    if actual == null { return false }
    unsafe {
        var index: usize = 0
        while index < expected.len() {
            if actual[index] != expected.as_ptr()[index] { return false }
            index++
        }
        return actual[expected.len()] == 0
    }
}

fn cleanup_link() {
    SetProtection("RAM:novus_ndk_packet_link", 0)
    SetProtection("RAM:novus_ndk_packet_target", 0)
    DeleteFile("RAM:novus_ndk_packet_link")
    DeleteFile("RAM:novus_ndk_packet_target")
}

@suppress("W0002", "MakeLink multiplexes a C-string address through one signed LONG packet field")
fn create_link() -> bool {
    cleanup_link()
    let handle = Open("RAM:novus_ndk_packet_target", 1006)
    if handle == 0 { return false }
    let written = Write(handle, "packet", 6)
    let closed = Close(handle)
    let destination: Str = "RAM:novus_ndk_packet_target"
    return written == 6 && closed != 0 && MakeLink("RAM:novus_ndk_packet_link", (i32)(u32)destination.as_cstr(), 1) != 0
}

fn cleanup_mode_directory() {
    DeleteFile("RAM:novus_ndk_packet_mode")
}

// @covers-ndk function|dos.library|DoPkt0
// @ndk-side-effects Sends zero packet arguments to the live RAM: handler and receives its affirmative ACTION_IS_FILESYSTEM result synchronously
@test("dos.library DoPkt0 queries filesystem identity")
@suppress("W0002", "NDK packet action IDs occupy signed LONG slots")
pub fn dos_do_pkt0() {
    let port = DeviceProc("RAM:")
    let result = if port != null { DoPkt0(port, (i32)ACTION_IS_FILESYSTEM) } else { 0 }
    expect(port != null && result != 0, "RAM: handler identifies itself as a filesystem")
}

// @covers-ndk function|dos.library|DoPkt1
// @ndk-side-effects Sends one lock argument with ACTION_COPY_DIR, receives an independent lock naming the same RAM: root, and releases both locks
@test("dos.library DoPkt1 duplicates a directory lock")
@suppress("W0002", "NDK packet action IDs occupy signed LONG slots")
pub fn dos_do_pkt1() {
    let port = DeviceProc("RAM:")
    let original = Lock("RAM:", -2)
    let duplicate = if port != null && original != 0 { DoPkt1(port, (i32)ACTION_COPY_DIR, original) } else { 0 }
    let same = duplicate != 0 && SameLock(original, duplicate) == 0
    if duplicate != 0 { UnLock(duplicate) }
    if original != 0 { UnLock(original) }
    expect(port != null && original != 0 && duplicate != 0 && same, "handler returns an independent lock for the same root")
}

// @covers-ndk function|dos.library|DoPkt2
// @ndk-side-effects Sends two independently owned RAM: locks to ACTION_SAME_LOCK, receives DOS TRUE for their exact filesystem identity, and releases both locks
@test("dos.library DoPkt2 compares two locks")
@suppress("W0002", "NDK packet action IDs occupy signed LONG slots")
pub fn dos_do_pkt2() {
    let port = DeviceProc("RAM:")
    let first = Lock("RAM:", -2)
    let second = Lock("RAM:", -2)
    let result = if port != null && first != 0 && second != 0 { DoPkt2(port, (i32)ACTION_SAME_LOCK, first, second) } else { 0 }
    if second != 0 { UnLock(second) }
    if first != 0 { UnLock(first) }
    expect(port != null && first != 0 && second != 0 && result != 0, "handler recognizes equivalent root locks")
}

// @covers-ndk function|dos.library|DoPkt3
// @ndk-side-effects Sends lock type, object, and mode arguments to ACTION_CHANGE_MODE, proves exclusive mode rejects a competing lock, restores shared mode, and proves concurrent locking works again
@test("dos.library DoPkt3 changes a lock mode")
@suppress("W0002", "NDK packet action IDs occupy signed LONG slots")
pub fn dos_do_pkt3() {
    cleanup_mode_directory()
    let created = CreateDir("RAM:novus_ndk_packet_mode")
    if created != 0 { UnLock(created) }
    let port = DeviceProc("RAM:novus_ndk_packet_mode")
    let lock = if created != 0 { Lock("RAM:novus_ndk_packet_mode", -2) } else { 0 }
    let exclusive = if port != null && lock != 0 { DoPkt3(port, (i32)ACTION_CHANGE_MODE, (i32)CHANGE_LOCK, lock, -1) } else { 0 }
    let blocked = if exclusive != 0 { Lock("RAM:novus_ndk_packet_mode", -2) } else { 0 }
    let shared = if blocked == 0 && lock != 0 { DoPkt3(port, (i32)ACTION_CHANGE_MODE, (i32)CHANGE_LOCK, lock, -2) } else { 0 }
    let concurrent = if shared != 0 { Lock("RAM:novus_ndk_packet_mode", -2) } else { 0 }
    if concurrent != 0 { UnLock(concurrent) }
    if blocked != 0 { UnLock(blocked) }
    if lock != 0 { UnLock(lock) }
    cleanup_mode_directory()
    expect(created != 0 && port != null && lock != 0, "mode-change fixture is available")
    expect(exclusive != 0 && blocked == 0, "exclusive mode rejects a competing shared lock")
    expect(shared != 0 && concurrent != 0, "restored shared mode permits another lock")
}

// @covers-ndk function|dos.library|DoPkt4
// @ndk-side-effects Sends lock, C-string path, output buffer, and capacity arguments to ACTION_READ_LINK, verifies the exact rewritten target path, and removes both soft-link entries
@test("dos.library DoPkt4 reads a soft link")
@suppress("W0002", "NDK packet pointers and action IDs occupy signed 32-bit LONG slots")
pub fn dos_do_pkt4() {
    let created = create_link()
    let port = if created { DeviceProc("RAM:") } else { (*MsgPort)null }
    let directory = if port != null { Lock("RAM:", -2) } else { 0 }
    let path: Str = "novus_ndk_packet_link"
    var buffer: [u8] = [0; 128]
    let pointer = unsafe { (*u8)&var buffer[0] }
    let result = if directory != 0 {
        DoPkt4(port, (i32)ACTION_READ_LINK, directory, (i32)(u32)path.as_cstr(), (i32)(u32)pointer, 127)
    } else {
        -1
    }
    let exact = result > 0 && c_equals(pointer, "RAM:novus_ndk_packet_target")
    if directory != 0 { UnLock(directory) }
    cleanup_link()
    expect(created && port != null && directory != 0, "soft-link packet fixture is available")
    expect(exact, "four packet arguments produce the exact resolved path")
}

// @covers-ndk function|dos.library|DoPkt
// @ndk-side-effects Sends all five ACTION_EXAMINE_ALL arguments to the SYS:C handler, verifies it populates a caller-owned control record and linked buffer, aborts the partial enumeration, and releases every DOS object and lock
@test("dos.library DoPkt transports all five packet arguments")
@suppress("W0002", "NDK packet pointers and action IDs occupy signed 32-bit LONG slots")
pub fn dos_do_pkt() {
    let port = DeviceProc("SYS:C")
    let lock = Lock("SYS:C", -2)
    let raw = if lock != 0 { AllocDosObject(DOS_EXALLCONTROL, null) } else { null }
    let control = (*ExAllControl)raw
    var buffer: [u32] = [0; 32]
    let data = (*ExAllData)&buffer[0]
    if control != null { control.eac_LastKey = 0 }
    let more = if port != null && lock != 0 && control != null {
        DoPkt(port, (i32)ACTION_EXAMINE_ALL, lock, (i32)(u32)data, 128, (i32)ED_NAME, (i32)(u32)control)
    } else {
        0
    }
    let entries = if control != null { control.eac_Entries } else { 0 }
    let linked = entries > 0 && data.ed_Name != null
    if more != 0 { ExAllEnd(lock, data, 128, (i32)ED_NAME, control) }
    if raw != null { FreeDosObject(DOS_EXALLCONTROL, raw) }
    if lock != 0 { UnLock(lock) }
    expect(port != null && lock != 0 && control != null, "packet enumeration resources are available")
    expect(more != 0 && linked, "fifth control argument and linked output buffer are populated")
}
