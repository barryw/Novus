from std::core import Result
from amiga::raw::consts import MEMF_ANY
from amiga::raw::exec import AvailMem
from amiga::sys::dos import DosEnvironment, DosNodeDraft
from std::test::test import expect

const DOS_FFS_INTL: u32 = $444F5303

@test("DOS node drafts own and release their backing structures")
pub fn dos_node_draft() {
    expect(invalid_environment_rejected(), "invalid geometry is rejected")

    // Warm compiler/runtime paths before taking the memory baseline.
    expect(make_and_drop(), "draft layout is valid")
    let before = unsafe { AvailMem(MEMF_ANY) }
    var ok = true
    while var i < 128 {
        if !make_and_drop() { ok = false }
        i++
    }
    let after = unsafe { AvailMem(MEMF_ANY) }
    expect(ok, "repeated draft layouts are valid")
    expect(after == before, "draft Drop releases every allocation")
}

fn invalid_environment_rejected() -> bool {
    return match DosEnvironment::partition(513, 1, 32, 0, 10, DOS_FFS_INTL) {
        Result::Ok(_) => false,
        Result::Err(_) => true,
    }
}

fn make_and_drop() -> bool {
    var environment = match DosEnvironment::partition(
        512, 16, 63, 2, 100, DOS_FFS_INTL
    ) {
        Result::Ok(value) => value,
        Result::Err(_) => return false,
    }
    match environment.set_buffers(50, MEMF_ANY) {
        Result::Ok(_) => {},
        Result::Err(_) => return false,
    }
    match environment.set_transfer($1FE00, $7FFFFFFE) {
        Result::Ok(_) => {},
        Result::Err(_) => return false,
    }
    let draft = match DosNodeDraft::new("HDP0", "scsi.device", 2, 0, &environment) {
        Result::Ok(value) => value,
        Result::Err(_) => return false,
    }
    if !draft.name().equals("HDP0") { return false }
    if !draft.driver().equals("scsi.device") { return false }
    if draft.unit() != 2 || draft.open_flags() != 0 { return false }
    if draft.dos_type() != DOS_FFS_INTL || draft.block_bytes() != 512 { return false }
    return !draft.has_handler()
}
