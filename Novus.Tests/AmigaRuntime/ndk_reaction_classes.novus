from std::test::test import expect
from amiga::raw::structs import IClass
from amiga::raw::bevel import BEVEL_GetClass
from amiga::raw::bitmap import BITMAP_GetClass
from amiga::raw::button import BUTTON_GetClass
from amiga::raw::checkbox import CHECKBOX_GetClass
from amiga::raw::drawlist import DRAWLIST_GetClass
from amiga::raw::fuelgauge import FUELGAUGE_GetClass
from amiga::raw::getfile import GETFILE_GetClass
from amiga::raw::getfont import GETFONT_GetClass
from amiga::raw::getscreenmode import GETSCREENMODE_GetClass
from amiga::raw::glyph import GLYPH_GetClass
from amiga::raw::integer import INTEGER_GetClass
from amiga::raw::label import LABEL_GetClass
from amiga::raw::palette import PALETTE_GetClass
from amiga::raw::penmap import PENMAP_GetClass
from amiga::raw::scroller import SCROLLER_GetClass
from amiga::raw::slider import SLIDER_GetClass
from amiga::raw::space import SPACE_GetClass
from amiga::raw::string import STRING_GetClass
from amiga::raw::texteditor import TEXTEDITOR_GetClass
from amiga::raw::virtual import VIRTUAL_GetClass
from amiga::raw::window import WINDOW_GetClass

fn expect_stable(first: *IClass, second: *IClass) {
    expect(first != null && second == first, "class pointer is non-null and stable")
}

// @covers-ndk function|bevel.library|BEVEL_GetClass
// @ndk-side-effects Returns the library-owned shared class pointer without transferring ownership
@test("bevel.library returns a stable class")
pub fn reaction_bevel_class() { expect_stable(BEVEL_GetClass(), BEVEL_GetClass()) }

