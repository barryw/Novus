from std::core import Option, Result
from amiga::sys::dos import BPtr, BPtrError
from amiga::sys::dos import DeviceProcess, DosDeviceList, DosListError
from std::string::core import FixedCString
from std::test::test import expect

static var BPTR_STORAGE: [u32] = [0x12345678, 0]

pub enum ProbeError {
    Expected,
    LockFailed,
}

fn leave_locked_scope_on_error() -> Result<(), ProbeError> {
    let devices = match DosDeviceList::lock() {
        Result::Ok(value) => value,
        Result::Err(_) => return Result::Err(ProbeError::LockFailed),
    }
    var entries = devices.iter()
    let _first = entries.next()
    return Result::Err(ProbeError::Expected)
}

// @covers amiga::sys::dos::bptr::BPtr::from_raw(i32)
// @covers amiga::sys::dos::bptr::BPtr::from_raw_u32(u32)
// @covers amiga::sys::dos::bptr::BPtr::is_null()
// @covers amiga::sys::dos::bptr::BPtr::as_ptr()
// @covers amiga::sys::dos::bptr::BPtr::as_raw()
// @covers amiga::sys::dos::bptr::BPtr::borrow()
// @covers amiga::sys::dos::bptr::BPtr::from_ptr(*T)
// @covers amiga::sys::dos::bptr::BPtrError::message()
// @covers amiga::sys::dos::list::DosListError::message()
// @covers amiga::sys::dos::list::FileSystemStartup::device_name()
// @covers amiga::sys::dos::list::FileSystemStartup::environment()
// @covers amiga::sys::dos::list::FileSystemStartup::flags()
// @covers amiga::sys::dos::list::FileSystemStartup::unit()
// @covers amiga::sys::dos::list::DeviceProcess::resolve(CStr)
// @covers amiga::sys::dos::list::DosDeviceEntry::is_handled_by(&DeviceProcess)
// @covers amiga::sys::dos::list::DosDeviceEntry::name()
// @covers amiga::sys::dos::list::DosDeviceEntry::startup()
// @covers amiga::sys::dos::list::DosDeviceIter::next()
// @covers amiga::sys::dos::list::DosDeviceList::iter()
// @covers amiga::sys::dos::list::DosDeviceList::lock()
@test("BPTR conversion and DOS device iteration are safe")
pub fn dos_device_list() {
    expect(DosListError::LockFailed.message() != null, "DOS-list errors have messages")
    match BPtr::<u8>::from_raw(0) {
        Result::Ok(value) => expect(value.is_null(), "zero BPTR is null"),
        Result::Err(_) => expect(false, "zero BPTR accepted"),
    }
    match BPtr::<u8>::from_raw_u32($40000000) {
        Result::Err(error) => expect(error.message() != null, "BPTR error has a message"),
        _ => expect(false, "overflowing BPTR rejected"),
    }
    let storage_ptr = (*u32)&var BPTR_STORAGE[0]
    let typed = BPtr::<u32>::from_ptr(storage_ptr).unwrap()
    expect(typed.as_raw() == ((u32)storage_ptr >> 2), "pointer encodes to exact BPTR")
    unsafe {
        expect(typed.as_ptr() == storage_ptr, "BPTR decodes to exact pointer")
        match typed.borrow() {
            Option::Some(value) => expect(*value == 0x12345678, "BPTR borrows live typed storage"),
            Option::None => expect(false, "live BPTR is borrowable")
        }
    }

    match leave_locked_scope_on_error() {
        Result::Err(ProbeError::Expected) => {},
        _ => expect(false, "early Result error returned"),
    }

    // Reacquiring proves the first guard unlocked while propagating Err.
    let sys_name = match FixedCString::<4>::new_from_str("SYS:") {
        Result::Ok(value) => value,
        Result::Err(_) => {
            expect(false, "SYS: fits its fixed C string")
            return
        },
    }
    let boot_process = match DeviceProcess::resolve(sys_name.as_cstr_view()) {
        Result::Ok(value) => value,
        Result::Err(_) => {
            expect(false, "SYS: resolves to its DOS process")
            return
        },
    }

    match DosDeviceList::lock() {
        Result::Ok(devices) => {
            var entries = devices.iter()
            var count: u32 = 0
            var boot_entry_found = false
            forever {
                match entries.next() {
                    Option::Some(entry) => {
                        match entry.name() {
                            Option::Some(name) => expect(name.len() > 0, "device name is bounded"),
                            Option::None => expect(false, "device has a name"),
                        }
                        if entry.is_handled_by(&boot_process) { boot_entry_found = true }
                        match entry.startup() {
                            Option::Some(startup) => {
                                expect(startup.device_name().is_some(), "startup exposes device name")
                                expect(startup.environment().is_some(), "startup exposes DOS environment")
                                let _unit = startup.unit()
                                let _flags = startup.flags()
                            },
                            Option::None => {}
                        }
                        count++
                    },
                    Option::None => { break },
                }
            }
            expect(count > 0, "DOS device list is not empty")
            expect(boot_entry_found, "SYS: handler belongs to a DOS device entry")
        },
        Result::Err(_) => expect(false, "DOS device list lock reacquired"),
    }
}
