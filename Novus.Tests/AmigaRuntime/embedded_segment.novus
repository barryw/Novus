from std::core import Result
from std::ffi::amiga_consts import MEMF_ANY
from std::ffi::exec import AvailMem
from std::os::segment import LoadedSegment
from std::test::test import expect

// One four-byte CODE hunk containing RTS.
static var MINIMAL_HUNK: [u8] = [
    0u8, 0u8, 3u8, $F3u8, 0u8, 0u8, 0u8, 0u8,
    0u8, 0u8, 0u8, 1u8, 0u8, 0u8, 0u8, 0u8,
    0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 0u8, 1u8,
    0u8, 0u8, 3u8, $E9u8, 0u8, 0u8, 0u8, 1u8,
    $4Eu8, $75u8, 0u8, 0u8, 0u8, 0u8, 3u8, $F2u8,
]

@test("embedded HUNK segments load and release every allocation")
pub fn embedded_segment() {
    expect(load_and_drop(), "minimal HUNK loads")
    let before = unsafe { AvailMem(MEMF_ANY) }
    var ok = true
    while var i < 64u32 {
        if !load_and_drop() { ok = false }
        i++
    }
    let after = unsafe { AvailMem(MEMF_ANY) }
    expect(ok, "repeated HUNK loads succeed")
    expect(after == before, "InternalUnLoadSeg releases every hunk")
}

fn load_and_drop() -> bool {
    let segment = match LoadedSegment::from_hunk(&MINIMAL_HUNK) {
        Result::Ok(value) => value,
        Result::Err(_) => return false,
    }
    return !segment.segment().is_null() && segment.segment().is_addressable()
}
