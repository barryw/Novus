// @covers-ndk function|locale.library|IsPrint
// @ndk-side-effects Verifies letters and spaces are printable, pins the installed classic locale bug that also classifies linefeed as printable, rejects NUL, and closes the locale; canonical VBCC C reproduces the same defect
@test("locale.library IsPrint distinguishes printable spaces from controls")
pub fn locale_is_print() {
    let locale = default_locale()
    let has_locale = locale != null
    let letter_prints = locale != null && IsPrint(locale, 65) != 0
    let space_prints = locale != null && IsPrint(locale, 32) != 0
    let linefeed_bug = locale != null && IsPrint(locale, 10) != 0
    let nul_does_not = locale != null && IsPrint(locale, 0) == 0
    if locale != null { CloseLocale(locale) }
    expect(has_locale, "default locale opens")
    expect(letter_prints, "A is printable")
    expect(space_prints, "space is printable")
    expect(linefeed_bug, "classic locale bug: linefeed is reported printable")
    expect(nul_does_not, "NUL is not printable")
}

