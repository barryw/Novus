from std::string import Str
from std::test::test import expect
from amiga::raw::consts import DAY_1, OC_BuiltInLanguage, SC_ASCII, TAG_DONE
from amiga::raw::dos import IoErr, SetIoErr
from amiga::raw::locale import CloseCatalog, CloseLocale, ConvToLower, ConvToUpper, FormatDate, FormatString, GetCatalogStr, GetLocaleStr, IsAlNum, IsAlpha, IsCntrl, IsDigit, IsGraph, IsLower, IsPrint, IsPunct, IsSpace, IsUpper, IsXDigit, OpenCatalog, OpenCatalogA, OpenLocale, ParseDate, StrConvert, StrnCmp
from amiga::raw::structs import Catalog, DateStamp, Hook, Locale, MinNode, TagItem

struct OutputState {
    buffer: *u32,
    index: u32,
    capacity: u32,
}

struct InputState {
    text: *u8,
    index: u32,
}

fn c_equals(actual: *u8, expected: Str) -> bool {
    return false if actual == null
    unsafe {
        var index: usize = 0
        while index < expected.len() {
            if actual[index] != expected.as_ptr()[index] { return false }
            index++
        }
        return actual[expected.len()] == 0
    }
}

fn bytes_equal(left: *u8, right: *u8, length: u32) -> bool {
    unsafe {
        var index: u32 = 0
        while index <= length {
            if left[index] != right[index] { return false }
            index++
        }
    }
    return true
}

fn output_equals(actual: *u32, expected: Str) -> bool {
    unsafe {
        var index: usize = 0
        while index < expected.len() {
            if actual[index] != (u32)expected.as_ptr()[index] { return false }
            index++
        }
        return actual[expected.len()] == 0
    }
}

amiga fn locale_put_char(hook: *Hook in a0, _locale: *u8 in a2, character: *u8 in a1) -> u32 in d0 {
    return 0 if hook == null || hook.h_Data == null
    let state = (*OutputState)hook.h_Data
    let value = (u32)character
    unsafe {
        if state.index < state.capacity {
            state.buffer[state.index] = value
            state.index++
        }
    }
    return value
}

amiga fn locale_get_char(hook: *Hook in a0, _unused: *u8 in a2, _locale: *u8 in a1) -> u32 in d0 {
    return 0 if hook == null || hook.h_Data == null
    let state = (*InputState)hook.h_Data
    let value = unsafe { state.text[state.index] }
    if value != 0 { state.index++ }
    return (u32)value
}

fn output_hook(state: *OutputState) -> Hook {
    return Hook {
        h_MinNode: MinNode { mln_Succ: null, mln_Pred: null },
        h_Entry: locale_put_char,
        h_SubEntry: locale_put_char,
        h_Data: (*u8)state,
    }
}

fn input_hook(state: *InputState) -> Hook {
    return Hook {
        h_MinNode: MinNode { mln_Succ: null, mln_Pred: null },
        h_Entry: locale_get_char,
        h_SubEntry: locale_get_char,
        h_Data: (*u8)state,
    }
}

fn default_locale() -> *Locale {
    return OpenLocale(null)
}

// @covers-ndk function|locale.library|OpenLocale
// @ndk-side-effects Opens the guaranteed current default locale, verifies its public locale and language names are initialized, and closes it
@test("locale.library OpenLocale opens the current default locale")
pub fn locale_open() {
    let locale = default_locale()
    let valid = locale != null && locale.loc_LocaleName != null && unsafe { locale.loc_LocaleName[0] != 0 } && locale.loc_LanguageName != null && unsafe { locale.loc_LanguageName[0] != 0 }
    if locale != null { CloseLocale(locale) }
    expect(valid, "default locale exposes initialized locale and language names")
}

// @covers-ndk function|locale.library|CloseLocale
// @ndk-side-effects Completes two guaranteed default-locale open/close lifecycles; the per-test A4000 memory gate verifies both references are released
@test("locale.library CloseLocale releases opened locales")
pub fn locale_close() {
    let first = default_locale()
    if first != null { CloseLocale(first) }
    let second = default_locale()
    if second != null { CloseLocale(second) }
    expect(first != null && second != null, "two complete default-locale lifecycles succeed")
}

// @covers-ndk function|locale.library|ConvToLower
// @ndk-side-effects Converts an uppercase ASCII character through the current locale and leaves a digit unchanged, then closes the locale
@test("locale.library ConvToLower converts only uppercase input")
pub fn locale_to_lower() {
    let locale = default_locale()
    let valid = locale != null && ConvToLower(locale, 65) == 97 && ConvToLower(locale, 55) == 55
    if locale != null { CloseLocale(locale) }
    expect(valid, "A converts to a while digit 7 remains unchanged")
}

// @covers-ndk function|locale.library|ConvToUpper
// @ndk-side-effects Converts a lowercase ASCII character through the current locale and leaves a digit unchanged, then closes the locale
@test("locale.library ConvToUpper converts only lowercase input")
pub fn locale_to_upper() {
    let locale = default_locale()
    let valid = locale != null && ConvToUpper(locale, 97) == 65 && ConvToUpper(locale, 55) == 55
    if locale != null { CloseLocale(locale) }
    expect(valid, "a converts to A while digit 7 remains unchanged")
}

// @covers-ndk function|locale.library|FormatDate
// @ndk-side-effects Formats the Amiga epoch through the documented A0/A1/A2/A3 hook ABI, captures every emitted byte including its terminator, and closes the locale
@test("locale.library FormatDate emits an exact epoch timestamp")
pub fn locale_format_date() {
    let locale = default_locale()
    var buffer: [u32] = [0; 32]
    var state = OutputState { buffer: &var buffer[0], index: 0, capacity: 32 }
    var hook = output_hook(&var state)
    var date = DateStamp { ds_Days: 0, ds_Minute: 0, ds_Tick: 0 }
    if locale != null { FormatDate(locale, "%Y-%m-%d %H:%M:%S", &var date, &var hook) }
    let valid = locale != null && state.index == 20 && output_equals(&var buffer[0], "1978-01-01 00:00:00")
    if locale != null { CloseLocale(locale) }
    expect(valid, "epoch formats exactly and the callback receives its terminating byte")
}

// @covers-ndk function|locale.library|FormatString
// @ndk-side-effects Formats an exact longword and C string through the documented callback registers, verifies the returned next-data pointer and terminating byte, and closes the locale
@test("locale.library FormatString consumes and emits exact data")
pub fn locale_format_string() {
    let locale = default_locale()
    var buffer: [u32] = [0; 32]
    var state = OutputState { buffer: &var buffer[0], index: 0, capacity: 32 }
    var hook = output_hook(&var state)
    let text: *u8 = "ok"
    var data: [u32] = [42, (u32)text]
    let next = if locale != null { FormatString(locale, "%ld:%s", (*u8)&var data[0], &var hook) } else { (*u8)null }
    let expected_next = (*u8)((u32)(*u32)&var data[0] + 8)
    let valid = locale != null && next == expected_next && state.index == 6 && output_equals(&var buffer[0], "42:ok")
    if locale != null { CloseLocale(locale) }
    expect(valid, "formatter emits 42:ok, consumes two longwords, and terminates output")
}

// @covers-ndk function|locale.library|GetCatalogStr
// @ndk-side-effects Requests an absent string from the documented null-catalog fallback and verifies the exact caller-owned default string is returned without allocation
@test("locale.library GetCatalogStr returns built-in fallback text")
pub fn locale_get_catalog_string() {
    let fallback: *u8 = "Novus fallback"
    let result = GetCatalogStr(null, 12345, fallback)
    expect(result == fallback && c_equals(result, "Novus fallback"), "null catalog returns the exact built-in fallback pointer")
}

// @covers-ndk function|locale.library|GetLocaleStr
// @ndk-side-effects Reads the current locale's first weekday name, verifies it is a non-empty library-owned string, and closes the locale
@test("locale.library GetLocaleStr returns localized weekday text")
pub fn locale_get_locale_string() {
    let locale = default_locale()
    let text = if locale != null { GetLocaleStr(locale, DAY_1) } else { (*u8)null }
    let valid = locale != null && text != null && unsafe { text[0] != 0 }
    if locale != null { CloseLocale(locale) }
    expect(valid, "the current locale provides a non-empty first weekday name")
}

// @covers-ndk function|locale.library|IsAlNum
// @ndk-side-effects Classifies one ASCII letter and one punctuation character through the current locale, then closes it
@test("locale.library IsAlNum distinguishes letters from punctuation")
pub fn locale_is_alnum() {
    let locale = default_locale()
    let valid = locale != null && IsAlNum(locale, 65) != 0 && IsAlNum(locale, 45) == 0
    if locale != null { CloseLocale(locale) }
    expect(valid, "A is alphanumeric and hyphen is not")
}

