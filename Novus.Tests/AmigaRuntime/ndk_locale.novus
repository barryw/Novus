// @covers-ndk function|locale.library|OpenCatalogA
// @ndk-side-effects Opens the system Workbench catalog through a terminated tag list, accepts either the documented English built-in null result or a real localized catalog, validates the result, and closes it
@test("locale.library OpenCatalogA selects matching built-in strings")
pub fn locale_open_catalog_a() {
    let locale = default_locale()
    let english: *u8 = "english"
    var tags: [TagItem] = [
        TagItem { ti_Tag: OC_BuiltInLanguage, ti_Data: (u32)english },
        TagItem { ti_Tag: TAG_DONE, ti_Data: 0 },
    ]
    SetIoErr(0)
    let catalog = if locale != null { OpenCatalogA(locale, "sys/workbench.catalog", &var tags[0]) } else { (*Catalog)null }
    let valid = locale != null && ((catalog == null && IoErr() == 0) || (catalog != null && catalog.cat_Language != null))
    CloseCatalog(catalog)
    if locale != null { CloseLocale(locale) }
    expect(valid, "Workbench strings resolve from English built-ins or an initialized localized catalog")
}

// @covers-ndk function|locale.library|OpenCatalog
// @ndk-side-effects Opens the system Workbench catalog through varargs, accepts either the documented English built-in null result or a real localized catalog, validates the result, and closes it
@test("locale.library OpenCatalog varargs selects matching built-in strings")
pub fn locale_open_catalog() {
    let locale = default_locale()
    SetIoErr(0)
    let catalog = if locale != null { OpenCatalog(locale, "sys/workbench.catalog", OC_BuiltInLanguage, "english", TAG_DONE) } else { (*Catalog)null }
    let valid = locale != null && ((catalog == null && IoErr() == 0) || (catalog != null && catalog.cat_Language != null))
    CloseCatalog(catalog)
    if locale != null { CloseLocale(locale) }
    expect(valid, "varargs Workbench strings resolve from built-ins or an initialized localized catalog")
}

// @covers-ndk function|locale.library|CloseCatalog
// @ndk-side-effects Closes the documented null built-in catalog result twice and verifies catalog fallback remains usable, exercising the required null-safe no-op behavior without disk state
@test("locale.library CloseCatalog accepts built-in fallback catalogs")
pub fn locale_close_catalog() {
    CloseCatalog(null)
    CloseCatalog(null)
    let fallback: *u8 = "still valid"
    expect(GetCatalogStr(null, 1, fallback) == fallback, "repeated null-catalog closes are harmless")
}

// @covers-ndk function|locale.library|ParseDate
// @ndk-side-effects Parses an exact numeric timestamp through the documented A0/A1/A2 hook registers, verifies the callback consumes all bytes and the resulting Amiga DateStamp fields, and closes the locale
@test("locale.library ParseDate consumes an exact timestamp")
pub fn locale_parse_date() {
    let locale = default_locale()
    var state = InputState { text: "1978-01-02 03:04:05", index: 0 }
    var hook = input_hook(&var state)
    var date: DateStamp = @zeroed(DateStamp)
    let parsed = if locale != null { ParseDate(locale, &var date, "%Y-%m-%d %H:%M:%S", &var hook) } else { 0 }
    let valid = locale != null && parsed != 0 && state.index == 19 && date.ds_Days == 1 && date.ds_Minute == 184 && date.ds_Tick == 250
    if locale != null { CloseLocale(locale) }
    expect(valid, "parser consumes every byte and returns the exact Amiga timestamp")
}

// @covers-ndk function|locale.library|StrConvert
// @ndk-side-effects Transforms two case variants using SC_ASCII into independent caller-owned buffers, verifies exact lengths and terminators and equal collation keys, and closes the locale
@test("locale.library StrConvert creates stable case-insensitive keys")
pub fn locale_str_convert() {
    let locale = default_locale()
    var upper: [u8] = [0; 32]
    var mixed: [u8] = [0; 32]
    let upper_len = if locale != null { StrConvert(locale, "ABC", &var upper[0], 32, SC_ASCII) } else { 0 }
    let mixed_len = if locale != null { StrConvert(locale, "aBc", &var mixed[0], 32, SC_ASCII) } else { 0 }
    let valid = locale != null && upper_len == mixed_len && upper_len > 0 && upper[upper_len] == 0 && mixed[mixed_len] == 0 && bytes_equal(&var upper[0], &var mixed[0], upper_len)
    if locale != null { CloseLocale(locale) }
    expect(valid, "case variants produce equal terminated SC_ASCII collation keys")
}

// @covers-ndk function|locale.library|StrnCmp
// @ndk-side-effects Performs full and length-limited SC_ASCII comparisons, verifying case folding, ordering, and the exact length boundary, then closes the locale
@test("locale.library StrnCmp honors case folding and length")
pub fn locale_str_compare() {
    let locale = default_locale()
    let valid = locale != null && StrnCmp(locale, "Alpha", "alpha", -1, SC_ASCII) == 0 && StrnCmp(locale, "Alpha", "beta", -1, SC_ASCII) < 0 && StrnCmp(locale, "ax", "az", 1, SC_ASCII) == 0
    if locale != null { CloseLocale(locale) }
    expect(valid, "SC_ASCII folds case, preserves ordering, and stops at one character")
}
