// @ndk-side-effects Changes GA_Disabled on an unattached built-in gadget through the varargs entry point, verifies the exact stored value with GetAttr, and disposes the object
@test("intuition.library SetAttrs updates an unattached object")
pub fn intuition_set_attrs() {
