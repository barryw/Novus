// @covers-ndk function|intuition.library|DoGadgetMethodA
// @ndk-side-effects Attaches a real BOOPSI button, dispatches GM_HITTEST through the GadgetInfo-aware live-window path, verifies the built-in class reports an exact interior hit while the caller-owned message field remains unchanged, then removes and disposes the gadget
@test("intuition.library DoGadgetMethodA dispatches an attached gadget method")
pub fn intuition_do_gadget_method_a() {
    var state = match fixture() {
        Result::Ok(value) => value,
        Result::Err(_) => {
            expect(false, "DoGadgetMethodA fixture opened")
            return
        },
    }
    let gadget = button_a(110)
    if gadget != null { AddGadget(state.window.as_raw(), gadget, 0) }
    var message: gpHitTest = @zeroed(gpHitTest)
    message.MethodID = GM_HITTEST
    message.gpht_Mouse.X = 1
    message.gpht_Mouse.Y = 1
    let result = if gadget != null {
        DoGadgetMethodA(gadget, state.window.as_raw(), null, (*u32)&var message)
    } else { 0 }
    if gadget != null {
        RemoveGadget(state.window.as_raw(), gadget)
        DisposeObject((*u8)gadget)
    }
    expect((result & GMR_GADGETHIT) != 0, "GM_HITTEST reports GMR_GADGETHIT for an interior point")
    expect(message.gpht_GInfo == null, "temporary dispatch context does not mutate the caller-owned message")
}

// @covers-ndk function|intuition.library|DoGadgetMethod
// @ndk-side-effects Calls DoGadgetMethod() on a live attached button gadget and validates the same return signaling as
// GM_HITTEST through a caller-owned message
@test("intuition.library DoGadgetMethod reads an attached gadget attribute")
pub fn intuition_do_gadget_method() {
    var state = match fixture() {
        Result::Ok(value) => value,
        Result::Err(_) => {
            expect(false, "DoGadgetMethod fixture opened")
            return
        },
    }
    let gadget = button_a(111)
    if gadget != null { AddGadget(state.window.as_raw(), gadget, 0) }
    var message: gpHitTest = @zeroed(gpHitTest)
    message.MethodID = GM_HITTEST
    message.gpht_Mouse.X = 1
    message.gpht_Mouse.Y = 1
    let found = if gadget != null {
        DoGadgetMethod(gadget, state.window.as_raw(), null, GM_HITTEST, (*u32)&var message)
    } else { 0 }
    if gadget != null {
        RemoveGadget(state.window.as_raw(), gadget)
        DisposeObject((*u8)gadget)
    }
    expect((found & GMR_GADGETHIT) != 0, "DoGadgetMethod with GM_HITTEST returns GMR_GADGETHIT")
}

// @covers-ndk function|intuition.library|MakeClass
// @covers-ndk function|intuition.library|FreeClass
// @ndk-side-effects Builds a private class from ROOTCLASS, checks superclass linkage, and proves it is freed when no objects exist
@test("intuition.library MakeClass and FreeClass handle a private class")
pub fn intuition_make_and_free_class() {
    let class = MakeClass(null, ROOTCLASS, null, 0, 0)
    if class != null {
        let had_super = unsafe { (*class).cl_Super } != null
        let freed = FreeClass(class)
        expect(had_super && freed != 0, "private class has ROOTCLASS linkage and is fully releasable")
    } else {
        expect(false, "MakeClass returned a class pointer")
    }
}

// @covers-ndk function|intuition.library|AddClass
// @covers-ndk function|intuition.library|RemoveClass
// @ndk-side-effects Creates a public class, adds it to the class list, removes it again, and confirms memory reclaim succeeds without leaks
@test("intuition.library AddClass and RemoveClass process a public class")
pub fn intuition_add_and_remove_class() {
    let class_name = "NOVUS-INTUITION-TEST-CLASS"
    let class = MakeClass(class_name.as_ptr(), ROOTCLASS, null, 0, 0)
    if class != null {
        AddClass(class)
        RemoveClass(class)
        let freed = FreeClass(class)
        expect(freed != 0, "public class registration path can be toggled and reclaimed")
    } else {
        expect(false, "MakeClass returned a public class pointer")
    }
}

// @covers-ndk function|intuition.library|NextObject
// @ndk-side-effects Builds a concrete list head and validates forward traversal returns the same nodes then null
@test("intuition.library NextObject traverses object nodes")
pub fn intuition_next_object() {
    var head: Node = @zeroed(Node)
    var tail: Node = @zeroed(Node)
    var second: Node = @zeroed(Node)
    head.ln_Succ = &var second
    head.ln_Pred = null
    second.ln_Succ = &var tail
    second.ln_Pred = &var head
    tail.ln_Pred = &var second
    tail.ln_Succ = null

    var list: List = @zeroed(List)
    list.lh_Head = &var head
    list.lh_Tail = &var tail
    list.lh_TailPred = &var second

    var state: *u8 = list.lh_Head as *u8
    let first = NextObject((*u8)(&var state))
    let second_value = NextObject((*u8)(&var state))
    let terminal = NextObject((*u8)(&var state))
    expect(first != null && second_value != null && terminal == null,
        "NextObject traverses list links and terminates at null")
}

// @covers-ndk function|intuition.library|ObtainGIRPort
// @covers-ndk function|intuition.library|ReleaseGIRPort
// @ndk-side-effects Obtains and releases a GIR RastPort from a valid GadgetInfo snapshot and verifies backing-bitmap continuity
@test("intuition.library ObtainGIRPort and ReleaseGIRPort roundtrip")
pub fn intuition_gir_port_cycle() {
    let state = match fixture() {
        Result::Ok(value) => value,
        Result::Err(_) => {
            expect(false, "GIR port cycle fixture opened")
            return
        },
    }
    let window = state.window.as_raw()
    var gadget_info = setup_gadget_info(window)
    let ras_port = ObtainGIRPort(&var gadget_info)
    if ras_port == null {
        expect(false, "ObtainGIRPort returned a rastport")
        return
    }
    let source = unsafe { (*window).RPort }
    let bitmap_matches = if source != null { (unsafe { (*ras_port).BitMap == (*source).BitMap }) != 0 } else { false }
    ReleaseGIRPort(ras_port)
    let again = ObtainGIRPort(&var gadget_info)
    if again == null {
        expect(false, "ObtainGIRPort reusable after release")
        return
    }
    ReleaseGIRPort(again)
    expect(bitmap_matches, "ObtainGIRPort returns a compatible RastPort")
}

// @covers-ndk function|intuition.library|AllocScreenBuffer
// @covers-ndk function|intuition.library|ChangeScreenBuffer
// @covers-ndk function|intuition.library|FreeScreenBuffer
// @ndk-side-effects Allocates two screen buffers, swaps each way via ChangeScreenBuffer, checks visible BitMap identity transitions, and frees both buffers
@test("intuition.library Screen buffer helpers install and restore rendering state")
pub fn intuition_screen_buffering() {
    match ScreenHandle::custom("Intuition ScreenBuffer", 320, 100, 2) {
        Result::Ok(screen_handle) => {
            var screen = screen_handle
            let raw = screen.as_raw()
            let primary = AllocScreenBuffer(raw, null, SB_SCREEN_BITMAP)
            if primary == null {
                expect(false, "primary screen buffer allocated")
                return
            }
            let primary_bitmap = unsafe { (*primary).sb_BitMap }
            let secondary = AllocScreenBuffer(raw, null, SB_SCREEN_BITMAP | SB_COPY_BITMAP)
            if secondary == null {
                FreeScreenBuffer(raw, primary)
                expect(false, "secondary screen buffer allocated")
                return
            }
            let secondary_bitmap = unsafe { (*secondary).sb_BitMap }
            let installed_primary = (unsafe { (*raw).RastPort.BitMap == primary_bitmap }) != 0
            let switched = ChangeScreenBuffer(raw, secondary) != 0
            if switched { WaitBlit() }
            let restored = if switched {
                ChangeScreenBuffer(raw, primary) != 0
            } else {
                false
            }
            if restored { WaitBlit() }
            FreeScreenBuffer(raw, secondary)
            FreeScreenBuffer(raw, primary)
            expect(switched && restored && installed_primary &&
                primary_bitmap != null && secondary_bitmap != null,
                "screen-buffer chain allocates, swaps, restores, and frees")
        },
        Result::Err(_) => expect(false, "screen buffer test screen opened"),
    }
}
