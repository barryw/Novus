from std::core import Result
from std::test::test import expect
from amiga::raw::consts import BUTTONGCLASS, GA_Disabled, GA_Height, GA_ID, GA_Left, GA_Top, GA_Width, GM_HITTEST, GMR_GADGETHIT, OM_GET, ROOTCLASS, SB_COPY_BITMAP, SB_SCREEN_BITMAP, TAG_DONE
from amiga::raw::graphics import WaitBlit
from amiga::raw::intuition import AddClass, AddGadget, AllocScreenBuffer, ChangeScreenBuffer, DisposeObject, DoGadgetMethod, DoGadgetMethodA, FreeClass, FreeScreenBuffer, GetAttr, MakeClass, NextObject, NewObject, NewObjectA, ObtainGIRPort, ReleaseGIRPort, RemoveClass, RemoveGadget, SetAttrs, SetAttrsA, SetGadgetAttrs, SetGadgetAttrsA
from amiga::raw::structs import Gadget, GadgetInfo, IBox, Node, List, TagItem, Window, gpHitTest
from amiga::sys::intuition import ScreenHandle, WindowHandle

fn setup_gadget_info(window: *Window) -> GadgetInfo {
    let screen = unsafe { (*window).WScreen }
    let rast_port = unsafe { (*window).RPort }
    var info: GadgetInfo = @zeroed(GadgetInfo)
    info.gi_Window = window
    info.gi_Screen = screen
    info.gi_Requester = null
    info.gi_RastPort = rast_port
    info.gi_Layer = unsafe { (*window).WLayer }
    info.gi_Pens.DetailPen = 0
    info.gi_Pens.BlockPen = 0
    info.gi_Domain = @zeroed(IBox)
    info.gi_Domain.Left = 0
    info.gi_Domain.Top = 0
    info.gi_Domain.Width = if screen != null { unsafe { screen.Width } } else { 0 }
    info.gi_Domain.Height = if screen != null { unsafe { screen.Height } } else { 0 }
    return info
}

struct BoopsiFixture {
    screen: ScreenHandle,
    window: WindowHandle,
}

fn fixture() -> Result<BoopsiFixture, i32> {
    return match ScreenHandle::custom("BOOPSI tests", 320, 120, 2) {
        Result::Ok(screen_handle) => {
            var screen = screen_handle
            match screen.open_backdrop() {
                Result::Ok(window) => Result::Ok(BoopsiFixture { screen: screen, window: window }),
                Result::Err(_) => Result::Err(2),
            }
        },
        Result::Err(_) => Result::Err(1),
    }
}

fn button_a(id: u32) -> *Gadget {
    var tags = [
        TagItem { ti_Tag: GA_ID, ti_Data: id },
        TagItem { ti_Tag: GA_Left, ti_Data: 20 },
        TagItem { ti_Tag: GA_Top, ti_Data: 20 },
        TagItem { ti_Tag: GA_Width, ti_Data: 60 },
        TagItem { ti_Tag: GA_Height, ti_Data: 16 },
        TagItem { ti_Tag: TAG_DONE, ti_Data: 0 },
    ]
    return (*Gadget)NewObjectA(null, BUTTONGCLASS, &var tags[0])
}

fn read_attr(object: *u8, attr: u32) -> Result<u32, i32> {
    var value: u32 = 0
    if GetAttr(attr, object, &var value) == 0 { return Result::Err(1) }
    return Result::Ok(value)
}

// @covers-ndk function|intuition.library|NewObjectA
// @ndk-side-effects Constructs a real built-in buttongclass object from an explicit tag list, verifies its exact GA_ID through BOOPSI dispatch, and disposes the object before process teardown
@test("intuition.library NewObjectA constructs a tagged BOOPSI object")
pub fn intuition_new_object_a() {
    let gadget = button_a(101)
    let id: Result<u32, i32> = if gadget != null { read_attr((*u8)gadget, GA_ID) } else { Result::Err(1) }
    if gadget != null { DisposeObject((*u8)gadget) }
    match id {
        Result::Ok(value) => expect(value == 101, "tag-list construction preserves the exact GA_ID"),
        Result::Err(_) => expect(false, "buttongclass object constructed and answered OM_GET"),
    }
}

// @covers-ndk function|intuition.library|NewObject
// @ndk-side-effects Constructs a real built-in buttongclass object through the varargs entry point, verifies the exact GA_ID, and disposes it before process teardown
@test("intuition.library NewObject constructs a varargs BOOPSI object")
pub fn intuition_new_object() {
    let object = NewObject(null, BUTTONGCLASS, GA_ID, 102, TAG_DONE)
    let id: Result<u32, i32> = if object != null { read_attr(object, GA_ID) } else { Result::Err(1) }
    if object != null { DisposeObject(object) }
    match id {
        Result::Ok(value) => expect(value == 102, "varargs construction preserves the exact GA_ID"),
        Result::Err(_) => expect(false, "varargs buttongclass object constructed and answered OM_GET"),
    }
}

// @covers-ndk function|intuition.library|DisposeObject
// @ndk-side-effects Constructs and disposes one built-in object, then independently constructs a replacement with a different ID and verifies it before balanced disposal; the harness proves all object storage is released
@test("intuition.library DisposeObject releases BOOPSI object storage")
pub fn intuition_dispose_object() {
    let first = button_a(103)
    if first != null { DisposeObject((*u8)first) }
    let second = button_a(104)
    let id: Result<u32, i32> = if second != null { read_attr((*u8)second, GA_ID) } else { Result::Err(1) }
    if second != null { DisposeObject((*u8)second) }
    match id {
        Result::Ok(value) => expect(first != null && value == 104, "replacement object constructs independently after disposal"),
        Result::Err(_) => expect(false, "replacement object constructed after disposal"),
    }
}

// @covers-ndk function|intuition.library|SetAttrsA
// @ndk-side-effects Changes GA_Disabled on an unattached built-in gadget through an explicit tag list, verifies the exact stored value with GetAttr, and disposes the object
@test("intuition.library SetAttrsA updates an unattached object")
pub fn intuition_set_attrs_a() {
    let gadget = button_a(105)
    var tags = [
        TagItem { ti_Tag: GA_Disabled, ti_Data: 1 },
        TagItem { ti_Tag: TAG_DONE, ti_Data: 0 },
    ]
    if gadget != null { SetAttrsA((*u8)gadget, &var tags[0]) }
    let disabled: Result<u32, i32> = if gadget != null { read_attr((*u8)gadget, GA_Disabled) } else { Result::Err(1) }
    if gadget != null { DisposeObject((*u8)gadget) }
    match disabled {
        Result::Ok(value) => expect(value != 0, "tag-list update stores GA_Disabled"),
        Result::Err(_) => expect(false, "updated object answers GA_Disabled"),
    }
}

