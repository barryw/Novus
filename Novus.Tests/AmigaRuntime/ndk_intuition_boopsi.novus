// @covers-ndk function|intuition.library|GetAttr
// @ndk-side-effects Queries both a known GA_ID and an unknown attribute on a real built-in object, verifies success writes exact storage while failure leaves the sentinel untouched, then disposes the object
@test("intuition.library GetAttr reports supported and unknown attributes")
pub fn intuition_get_attr() {
    let gadget = button_a(107)
    var id: u32 = 0
    var untouched: u32 = $A55A5AA5
    let known = if gadget != null { GetAttr(GA_ID, (*u8)gadget, &var id) } else { 0 }
    let unknown = if gadget != null { GetAttr($DEADBEEF, (*u8)gadget, &var untouched) } else { 1 }
    if gadget != null { DisposeObject((*u8)gadget) }
    expect(known != 0 && id == 107 && unknown == 0 && untouched == $A55A5AA5,
        "GetAttr writes supported storage and rejects an unknown attribute without mutation")
}

// @covers-ndk function|intuition.library|SetGadgetAttrsA
// @ndk-side-effects Attaches a real BOOPSI button to an owned live window, changes GA_Disabled through the GadgetInfo-aware tag-list path, verifies the exact attribute, then removes and disposes it before window teardown
@test("intuition.library SetGadgetAttrsA updates an attached gadget")
pub fn intuition_set_gadget_attrs_a() {
    var state = match fixture() {
        Result::Ok(value) => value,
        Result::Err(_) => {
            expect(false, "SetGadgetAttrsA fixture opened")
            return
        },
    }
    let gadget = button_a(108)
    var tags = [
        TagItem { ti_Tag: GA_Disabled, ti_Data: 1 },
        TagItem { ti_Tag: TAG_DONE, ti_Data: 0 },
    ]
    if gadget != null { AddGadget(state.window.as_raw(), gadget, 0) }
    if gadget != null { SetGadgetAttrsA(gadget, state.window.as_raw(), null, &var tags[0]) }
    let disabled: Result<u32, i32> = if gadget != null { read_attr((*u8)gadget, GA_Disabled) } else { Result::Err(1) }
    if gadget != null {
        RemoveGadget(state.window.as_raw(), gadget)
        DisposeObject((*u8)gadget)
    }
    match disabled {
        Result::Ok(value) => expect(value != 0, "attached tag-list update stores GA_Disabled"),
        Result::Err(_) => expect(false, "attached gadget answers GA_Disabled"),
    }
}

