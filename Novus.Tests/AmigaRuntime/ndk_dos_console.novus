from std::test::test import expect
from amiga::raw::consts import IECODE_UP_PREFIX, IECLASS_RAWKEY, IND_WRITEEVENT
from amiga::raw::dos import Close, Delay, Open, Read, SetMode, WaitForChar
from amiga::raw::exec import CloseDevice, CreateIORequest, CreateMsgPort, DeleteIORequest, DeleteMsgPort, DoIO, OpenDevice
from amiga::raw::structs import InputEvent, IORequest, IOStdReq

fn inject_raw_key(code: u16) -> bool {
    let port = CreateMsgPort()
    if port == null { return false }
    let request = CreateIORequest(port, @sizeof(IOStdReq))
    if request == null {
        DeleteMsgPort(port)
        return false
    }
    let opened = unsafe { OpenDevice("input.device", 0, (*IORequest)request, 0) } == 0
    var event: InputEvent = @zeroed(InputEvent)
    event.ie_Class = (u8)IECLASS_RAWKEY
    event.ie_Code = code
    let io = (*IOStdReq)request
    io.io_Command = (u16)IND_WRITEEVENT
    io.io_Length = @sizeof(InputEvent)
    io.io_Data = unsafe { (*u8)&var event }
    let written = opened && unsafe { DoIO((*IORequest)request) } == 0
    if opened { unsafe { CloseDevice((*IORequest)request) } }
    DeleteIORequest(request)
    DeleteMsgPort(port)
    return written
}

fn open_console() -> i32 {
    let handle = Open("CON:0/0/320/100/Novus Console/CLOSE", 1006)
    if handle != 0 { Delay(5) }
    return handle
}

// @covers-ndk function|dos.library|SetMode
// @ndk-side-effects Opens a real console.device virtual terminal, switches it to raw input mode, restores cooked console mode, and closes the handle and window
@test("dos.library SetMode switches a console raw and cooked")
pub fn dos_set_mode() {
    let handle = open_console()
    let raw = if handle != 0 { SetMode(handle, 1) } else { 0 }
    let cooked = if raw != 0 { SetMode(handle, 0) } else { 0 }
    let closed = if handle != 0 { Close(handle) } else { 0 }
    expect(handle != 0, "virtual terminal opens")
    expect(raw != 0 && cooked != 0, "console accepts both documented modes")
    expect(closed != 0, "console handle and window close")
}

// @covers-ndk function|dos.library|WaitForChar
// @ndk-side-effects Proves an empty raw virtual terminal times out, injects a real A-key event through input.device, proves readiness before reading, validates the exact translated byte, sends key-up, restores cooked mode, and closes every device and console resource
@test("dos.library WaitForChar detects injected console input")
pub fn dos_wait_for_char() {
    let handle = open_console()
    let raw = if handle != 0 { SetMode(handle, 1) } else { 0 }
    let empty = if raw != 0 { WaitForChar(handle, 20000) } else { -1 }
    let pressed = if empty == 0 { inject_raw_key(0x20) } else { false }
    let ready = if pressed { WaitForChar(handle, 1000000) } else { 0 }
    var byte: [u8] = [0; 1]
    let pointer = unsafe { (*u8)&var byte[0] }
    let count = if ready != 0 { Read(handle, pointer, 1) } else { -1 }
    let released = inject_raw_key((u16)(0x20 | IECODE_UP_PREFIX))
    let cooked = if raw != 0 { SetMode(handle, 0) } else { 0 }
    let closed = if handle != 0 { Close(handle) } else { 0 }
    expect(handle != 0 && raw != 0 && empty == 0, "empty virtual terminal reaches its timeout")
    expect(pressed && ready != 0, "input.device key-down makes the console readable")
    expect(count == 1 && byte[0] == 97, "console translates raw key A to exact byte 'a'")
    expect(released && cooked != 0 && closed != 0, "key state, console mode, and resources are restored")
}
