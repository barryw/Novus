from std::test::test import expect
from amiga::sys::intuition import ScreenHandle
from amiga::sys::gadtools::menu import GadToolsMenuBuilder, GadToolsMenuStrip
from amiga::raw::consts import MENUENABLED, NOITEM, NOSUB, SHANGHAI, SHOWTITLE, SDEPTH_TOBACK, SDEPTH_TOFRONT, SPOS_ABSOLUTE, SPOS_RELATIVE, WFLG_REPORTMOUSE
from amiga::raw::graphics import ReadPixel, RectFill, SetAPen, SetBPen, SetRast, WaitBlit, WaitTOF
from amiga::raw::intuition import ClearMenuStrip, ClearPointer, OffMenu, OnMenu, ReportMouse, ReportMouse1, ResetMenuStrip, ScreenDepth, ScreenPosition, ScrollWindowRaster, SetMenuStrip, SetPointer, SetPubScreenModes, SetWindowTitles, ViewPortAddress
from amiga::raw::structs import Screen

fn settle_display() {
    unsafe {
        WaitTOF()
        WaitTOF()
    }
}

fn test_menu(screen: *Screen) -> Result<GadToolsMenuStrip, i32> {
    var builder = GadToolsMenuBuilder::new(screen)
    var file = builder.add_menu("File")
    file.add_item("Quit")
    return match builder.build() {
        Result::Ok(strip) => Result::Ok(strip),
        Result::Err(_) => Result::Err(1),
    }
}

@suppress("W0002", "NOITEM and NOSUB occupy the documented packed UWORD fields")
fn whole_first_menu() -> u16 {
    return (u16)((NOITEM << 5) | (NOSUB << 11))
}

// @covers-ndk function|intuition.library|OpenScreenTagList
// @covers-ndk function|intuition.library|ScreenToFront
// @covers-ndk function|intuition.library|ScreenToBack
// @covers-ndk function|intuition.library|CloseScreen
// @ndk-side-effects OpenScreenTagList inserts two custom screens into Intuition's front-to-back list; ScreenToFront places the target immediately before its peer; ScreenToBack moves it to the list tail; scope exit closes both screens without retained display memory
@test("Intuition screen depth operations update the screen list")
pub fn screen_depth_order() {
    let first_result = ScreenHandle::custom("Depth First", 320, 100, 2)
    let second_result = ScreenHandle::custom("Depth Second", 320, 100, 2)
    match first_result {
        Result::Ok(first_screen) => {
            var first = first_screen
            match second_result {
                Result::Ok(second_screen) => {
                    var second = second_screen
                    first.to_front()
                    settle_display()
                    unsafe {
                        expect((*first.as_raw()).NextScreen == second.as_raw(), "ScreenToFront places the target immediately before the previous front screen")
                    }
                    first.to_back()
                    settle_display()
                    unsafe {
                        expect((*first.as_raw()).NextScreen == null, "ScreenToBack moves the target to the back of the screen list")
                    }
                },
                Result::Err(_) => expect(false, "second custom screen opened"),
            }
        },
        Result::Err(_) => expect(false, "first custom screen opened"),
    }
}

// @covers-ndk function|intuition.library|MoveScreen
// @ndk-side-effects MoveScreen changes the live screen TopEdge by the requested positive delta and a second call restores the exact original position
@test("MoveScreen applies reversible vertical deltas")
pub fn screen_move() {
    match ScreenHandle::custom("Move Screen", 320, 100, 2) {
        Result::Ok(screen_handle) => {
            var screen = screen_handle
            let raw = screen.as_raw()
            let original_top = unsafe { (*raw).TopEdge }
            screen.move_by(0, 10)
            settle_display()
            unsafe { expect((*raw).TopEdge == original_top + 10, "MoveScreen applies the positive delta") }
            screen.move_by(0, -10)
            settle_display()
            unsafe { expect((*raw).TopEdge == original_top, "MoveScreen restores the original position") }
        },
        Result::Err(_) => expect(false, "movable custom screen opened"),
    }
}

// @covers-ndk function|intuition.library|ShowTitle
// @ndk-side-effects ShowTitle(false) clears SHOWTITLE in the live Screen and ShowTitle(true) restores it
@test("ShowTitle updates the screen title priority flag")
pub fn screen_title_visibility() {
    match ScreenHandle::custom("Title Screen", 320, 100, 2) {
        Result::Ok(screen_handle) => {
            var screen = screen_handle
            let raw = screen.as_raw()
            screen.show_title(false)
            unsafe { expect(((*raw).Flags & SHOWTITLE) == 0, "ShowTitle(false) clears SHOWTITLE") }
            screen.show_title(true)
            unsafe { expect(((*raw).Flags & SHOWTITLE) != 0, "ShowTitle(true) sets SHOWTITLE") }
        },
        Result::Err(_) => expect(false, "title custom screen opened"),
    }
}

// @covers-ndk function|intuition.library|ScreenDepth
// @ndk-side-effects Opens two owned custom screens, moves the first to the exact front and back positions through ScreenDepth, verifies live list linkage after each operation, and closes both screens
@test("intuition.library ScreenDepth changes live screen ordering")
pub fn intuition_screen_depth() {
    let first_result = ScreenHandle::custom("ScreenDepth first", 320, 100, 2)
    let second_result = ScreenHandle::custom("ScreenDepth second", 320, 100, 2)
    match first_result {
        Result::Ok(first_screen) => {
            var first = first_screen
            match second_result {
                Result::Ok(second_screen) => {
                    var second = second_screen
                    ScreenDepth(first.as_raw(), SDEPTH_TOFRONT, null)
                    settle_display()
                    let front = unsafe { (*first.as_raw()).NextScreen == second.as_raw() }
                    ScreenDepth(first.as_raw(), SDEPTH_TOBACK, null)
                    settle_display()
                    let back = unsafe { (*first.as_raw()).NextScreen == null }
                    expect(front && back, "ScreenDepth moves the target to both exact list extremes")
                },
                Result::Err(_) => expect(false, "second ScreenDepth screen opened"),
            }
        },
        Result::Err(_) => expect(false, "first ScreenDepth screen opened"),
    }
}

// @covers-ndk function|intuition.library|ScreenPosition
// @ndk-side-effects Moves an owned custom screen by a relative vertical delta, verifies its live coordinate, then uses absolute positioning to restore the exact original coordinate before teardown
@test("intuition.library ScreenPosition applies relative and absolute coordinates")
pub fn intuition_screen_position() {
    match ScreenHandle::custom("ScreenPosition", 320, 100, 2) {
        Result::Ok(screen_handle) => {
            var screen = screen_handle
            let raw = screen.as_raw()
            let original_top = unsafe { (*raw).TopEdge }
            ScreenPosition(raw, SPOS_RELATIVE, 0, 7, 0, 0)
            settle_display()
            let moved = unsafe { (*raw).TopEdge == original_top + 7 }
            ScreenPosition(raw, SPOS_ABSOLUTE, 0, (i32)original_top, 0, 0)
            settle_display()
            let restored = unsafe { (*raw).TopEdge == original_top }
            expect(moved && restored, "relative movement is observable and absolute movement restores it")
        },
        Result::Err(_) => expect(false, "ScreenPosition screen opened"),
    }
}

// @covers-ndk function|intuition.library|ViewPortAddress
// @ndk-side-effects Opens an owned backdrop window and proves ViewPortAddress returns the exact embedded ViewPort of that window's retained screen
@test("intuition.library ViewPortAddress returns the window screen ViewPort")
pub fn intuition_viewport_address() {
    match ScreenHandle::custom("ViewPortAddress", 320, 100, 2) {
        Result::Ok(screen_handle) => {
            var screen = screen_handle
            match screen.open_backdrop() {
                Result::Ok(window) => {
                    let viewport = ViewPortAddress(window.as_raw())
                    expect(viewport == screen.viewport(), "returned pointer is the exact live screen ViewPort")
                },
                Result::Err(_) => expect(false, "ViewPortAddress backdrop opened"),
            }
        },
        Result::Err(_) => expect(false, "ViewPortAddress screen opened"),
    }
}

// @covers-ndk function|intuition.library|ReportMouse
// @ndk-side-effects Enables and disables mouse-movement reporting on a live owned backdrop and verifies the corresponding Window flag after each transition
@test("intuition.library ReportMouse updates the report flag")
pub fn intuition_report_mouse() {
    match ScreenHandle::custom("ReportMouse", 320, 100, 2) {
        Result::Ok(screen_handle) => {
            var screen = screen_handle
            match screen.open_backdrop() {
                Result::Ok(window) => {
                    let raw = window.as_raw()
                    ReportMouse(1, raw)
                    let enabled = unsafe { ((*raw).Flags & WFLG_REPORTMOUSE) != 0 }
                    ReportMouse(0, raw)
                    let disabled = unsafe { ((*raw).Flags & WFLG_REPORTMOUSE) == 0 }
                    expect(enabled && disabled, "ReportMouse performs both flag transitions")
                },
                Result::Err(_) => expect(false, "ReportMouse backdrop opened"),
            }
        },
        Result::Err(_) => expect(false, "ReportMouse screen opened"),
    }
}

