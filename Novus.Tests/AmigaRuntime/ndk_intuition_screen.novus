// @covers-ndk function|intuition.library|SetWindowTitles
// @ndk-side-effects Assigns retained static window and screen title pointers to a live backdrop and verifies both exact Window fields before teardown
@test("intuition.library SetWindowTitles retains both title pointers")
pub fn intuition_set_window_titles() {
    match ScreenHandle::custom("SetWindowTitles", 320, 100, 2) {
        Result::Ok(screen_handle) => {
            var screen = screen_handle
            match screen.open_backdrop() {
                Result::Ok(window) => {
                    let window_title = "NDK window title"
                    let screen_title = "NDK screen title"
                    let raw = window.as_raw()
                    SetWindowTitles(raw, window_title.as_ptr(), screen_title.as_ptr())
                    let exact = unsafe {
                        (*raw).Title == window_title.as_ptr() &&
                        (*raw).ScreenTitle == screen_title.as_ptr()
                    }
                    expect(exact, "Window retains the exact static title pointers supplied")
                },
                Result::Err(_) => expect(false, "SetWindowTitles backdrop opened"),
            }
        },
        Result::Err(_) => expect(false, "SetWindowTitles screen opened"),
    }
}

// @covers-ndk function|intuition.library|SetPointer
// @ndk-side-effects Installs a retained one-row custom pointer on a live window, verifies its exact data pointer, dimensions, and hot-spot offsets, then clears it before the backing data leaves scope
@test("intuition.library SetPointer stores custom pointer geometry")
pub fn intuition_set_pointer() {
    match ScreenHandle::custom("SetPointer", 320, 100, 2) {
        Result::Ok(screen_handle) => {
            var screen = screen_handle
            match screen.open_backdrop() {
                Result::Ok(window) => {
                    var pointer_data: [u16] = [0, 0]
                    let data: *u16 = &var pointer_data[0]
                    let raw = window.as_raw()
                    SetPointer(raw, data, 1, 16, -3, -4)
                    let exact = unsafe {
                        (*raw).Pointer == data && (*raw).PtrHeight == 1 &&
                        (*raw).PtrWidth == 16 && (*raw).XOffset == -3 && (*raw).YOffset == -4
                    }
                    ClearPointer(raw)
                    expect(exact, "custom pointer data and geometry are retained exactly")
                },
                Result::Err(_) => expect(false, "SetPointer backdrop opened"),
            }
        },
        Result::Err(_) => expect(false, "SetPointer screen opened"),
    }
}

// @covers-ndk function|intuition.library|ClearPointer
// @ndk-side-effects Clears a previously installed retained custom pointer and verifies the live Window returns to the default-pointer null state before its backing data leaves scope
@test("intuition.library ClearPointer restores the default pointer")
pub fn intuition_clear_pointer() {
    match ScreenHandle::custom("ClearPointer", 320, 100, 2) {
        Result::Ok(screen_handle) => {
            var screen = screen_handle
            match screen.open_backdrop() {
                Result::Ok(window) => {
                    var pointer_data: [u16] = [0, 0]
                    let data: *u16 = &var pointer_data[0]
                    let raw = window.as_raw()
                    SetPointer(raw, data, 1, 16, 0, 0)
                    let installed = unsafe { (*raw).Pointer == data }
                    ClearPointer(raw)
                    let cleared = unsafe { (*raw).Pointer == null }
                    expect(installed && cleared, "ClearPointer removes the installed custom definition")
                },
                Result::Err(_) => expect(false, "ClearPointer backdrop opened"),
            }
        },
        Result::Err(_) => expect(false, "ClearPointer screen opened"),
    }
}

// @covers-ndk function|intuition.library|SetPubScreenModes
// @ndk-side-effects Toggles only the documented global SHANGHAI bit, verifies each call returns the exact previous mode word, and restores the complete original global value
@test("intuition.library SetPubScreenModes returns and restores global modes")
@suppress("W0002", "SHANGHAI is a documented UWORD public-screen flag")
pub fn intuition_set_pub_screen_modes() {
    let original = SetPubScreenModes(0)
    let changed: u16 = original ^ (u16)SHANGHAI
    let cleared_previous = SetPubScreenModes(changed)
    let changed_previous = SetPubScreenModes(original)
    expect(cleared_previous == 0 && changed_previous == changed,
        "mode transitions return their exact predecessors and restore the original word")
}

// @covers-ndk function|intuition.library|ScrollWindowRaster
// @ndk-side-effects Draws an exact block into an owned backdrop RastPort, scrolls a bounded rectangle left by five pixels, waits for rendering completion, and verifies both the destination and vacated source pixels
@test("intuition.library ScrollWindowRaster moves exact pixels")
pub fn intuition_scroll_window_raster() {
    match ScreenHandle::custom("ScrollWindowRaster", 320, 100, 2) {
        Result::Ok(screen_handle) => {
            var screen = screen_handle
            match screen.open_backdrop() {
                Result::Ok(window) => {
                    let raw = window.as_raw()
                    let rast_port = unsafe { (*raw).RPort }
                    SetRast(rast_port, 0)
                    SetAPen(rast_port, 1)
                    SetBPen(rast_port, 0)
                    RectFill(rast_port, 40, 40, 42, 42)
                    WaitBlit()
                    ScrollWindowRaster(raw, 5, 0, 20, 20, 60, 60)
                    WaitBlit()
                    let destination = ReadPixel(rast_port, 35, 40)
                    let old_source = ReadPixel(rast_port, 40, 40)
                    expect(destination == 1 && old_source == 0,
                        "bounded positive dx moves the block left and exposes background")
                },
                Result::Err(_) => expect(false, "ScrollWindowRaster backdrop opened"),
            }
        },
        Result::Err(_) => expect(false, "ScrollWindowRaster screen opened"),
    }
}

// @covers-ndk function|intuition.library|SetMenuStrip
// @ndk-side-effects Builds and lays out a real GadTools menu for an owned custom screen, attaches its exact native pointer to a live backdrop, verifies Window.MenuStrip identity, and detaches it before either owner is dropped
@test("intuition.library SetMenuStrip attaches the exact menu")
pub fn intuition_set_menu_strip() {
    match ScreenHandle::custom("SetMenuStrip", 320, 100, 2) {
        Result::Ok(screen_handle) => {
            var screen = screen_handle
            match screen.open_backdrop() {
                Result::Ok(window) => match test_menu(screen.as_raw()) {
                    Result::Ok(strip_value) => {
                        var strip = strip_value
                        let menu = strip.raw_menu()
                        let attached = SetMenuStrip(window.as_raw(), menu)
                        let exact = unsafe { (*window.as_raw()).MenuStrip == menu }
                        ClearMenuStrip(window.as_raw())
                        expect(attached != 0 && exact, "SetMenuStrip installs the exact laid-out menu pointer")
                    },
                    Result::Err(_) => expect(false, "SetMenuStrip menu built"),
                },
                Result::Err(_) => expect(false, "SetMenuStrip backdrop opened"),
            }
        },
        Result::Err(_) => expect(false, "SetMenuStrip screen opened"),
    }
}

// @covers-ndk function|intuition.library|ClearMenuStrip
// @ndk-side-effects Attaches a real laid-out menu to a live backdrop, clears it through Intuition, and verifies Window.MenuStrip is null before the menu owner is dropped
@test("intuition.library ClearMenuStrip detaches the active menu")
pub fn intuition_clear_menu_strip() {
    match ScreenHandle::custom("ClearMenuStrip", 320, 100, 2) {
        Result::Ok(screen_handle) => {
            var screen = screen_handle
            match screen.open_backdrop() {
                Result::Ok(window) => match test_menu(screen.as_raw()) {
                    Result::Ok(strip_value) => {
                        var strip = strip_value
                        SetMenuStrip(window.as_raw(), strip.raw_menu())
                        let installed = unsafe { (*window.as_raw()).MenuStrip == strip.raw_menu() }
                        ClearMenuStrip(window.as_raw())
                        let cleared = unsafe { (*window.as_raw()).MenuStrip == null }
                        expect(installed && cleared, "ClearMenuStrip removes the live menu reference")
                    },
                    Result::Err(_) => expect(false, "ClearMenuStrip menu built"),
                },
                Result::Err(_) => expect(false, "ClearMenuStrip backdrop opened"),
            }
        },
        Result::Err(_) => expect(false, "ClearMenuStrip screen opened"),
    }
}

// @covers-ndk function|intuition.library|ResetMenuStrip
// @ndk-side-effects Attaches and clears a real menu, changes only its documented MENUENABLED state, reattaches it through the fast reset path, verifies pointer and flag identity, then clears it before teardown
@test("intuition.library ResetMenuStrip reattaches a state-only menu change")
@suppress("W0002", "MENUENABLED is a documented UWORD Menu.Flags bit")
pub fn intuition_reset_menu_strip() {
    match ScreenHandle::custom("ResetMenuStrip", 320, 100, 2) {
        Result::Ok(screen_handle) => {
            var screen = screen_handle
            match screen.open_backdrop() {
                Result::Ok(window) => match test_menu(screen.as_raw()) {
                    Result::Ok(strip_value) => {
                        var strip = strip_value
                        let menu = strip.raw_menu()
                        SetMenuStrip(window.as_raw(), menu)
                        ClearMenuStrip(window.as_raw())
                        unsafe { (*menu).Flags = (*menu).Flags & (u16)(~MENUENABLED) }
                        let reset = ResetMenuStrip(window.as_raw(), menu)
                        let exact = unsafe {
                            (*window.as_raw()).MenuStrip == menu &&
                            (((u32)(*menu).Flags & MENUENABLED) == 0)
                        }
                        ClearMenuStrip(window.as_raw())
                        expect(reset != 0 && exact, "ResetMenuStrip preserves the allowed disabled-menu change")
                    },
                    Result::Err(_) => expect(false, "ResetMenuStrip menu built"),
                },
                Result::Err(_) => expect(false, "ResetMenuStrip backdrop opened"),
            }
        },
        Result::Err(_) => expect(false, "ResetMenuStrip screen opened"),
    }
}

// @covers-ndk function|intuition.library|OffMenu
// @ndk-side-effects Attaches a real enabled menu, disables the whole first menu through its packed menu number, verifies MENUENABLED clears, then re-enables and detaches it before teardown
@test("intuition.library OffMenu disables the selected menu")
pub fn intuition_off_menu() {
    match ScreenHandle::custom("OffMenu", 320, 100, 2) {
        Result::Ok(screen_handle) => {
            var screen = screen_handle
            match screen.open_backdrop() {
                Result::Ok(window) => match test_menu(screen.as_raw()) {
                    Result::Ok(strip_value) => {
                        var strip = strip_value
                        let menu = strip.raw_menu()
                        SetMenuStrip(window.as_raw(), menu)
                        let initially_enabled = unsafe { ((u32)(*menu).Flags & MENUENABLED) != 0 }
                        OffMenu(window.as_raw(), whole_first_menu())
                        let disabled = unsafe { ((u32)(*menu).Flags & MENUENABLED) == 0 }
                        OnMenu(window.as_raw(), whole_first_menu())
                        ClearMenuStrip(window.as_raw())
                        expect(initially_enabled && disabled, "OffMenu clears MENUENABLED on the exact selected menu")
                    },
                    Result::Err(_) => expect(false, "OffMenu menu built"),
                },
                Result::Err(_) => expect(false, "OffMenu backdrop opened"),
            }
        },
        Result::Err(_) => expect(false, "OffMenu screen opened"),
    }
}

// @covers-ndk function|intuition.library|OnMenu
// @ndk-side-effects Attaches and disables a real first menu, re-enables it through the same packed menu number, verifies MENUENABLED is restored, then detaches it before teardown
@test("intuition.library OnMenu enables the selected menu")
pub fn intuition_on_menu() {
    match ScreenHandle::custom("OnMenu", 320, 100, 2) {
        Result::Ok(screen_handle) => {
            var screen = screen_handle
            match screen.open_backdrop() {
                Result::Ok(window) => match test_menu(screen.as_raw()) {
                    Result::Ok(strip_value) => {
                        var strip = strip_value
                        let menu = strip.raw_menu()
                        SetMenuStrip(window.as_raw(), menu)
                        OffMenu(window.as_raw(), whole_first_menu())
                        let disabled = unsafe { ((u32)(*menu).Flags & MENUENABLED) == 0 }
                        OnMenu(window.as_raw(), whole_first_menu())
                        let enabled = unsafe { ((u32)(*menu).Flags & MENUENABLED) != 0 }
                        ClearMenuStrip(window.as_raw())
                        expect(disabled && enabled, "OnMenu restores MENUENABLED on the exact selected menu")
                    },
                    Result::Err(_) => expect(false, "OnMenu menu built"),
                },
                Result::Err(_) => expect(false, "OnMenu backdrop opened"),
            }
        },
        Result::Err(_) => expect(false, "OnMenu screen opened"),
    }
}
