// @covers-ndk function|gadtools.library|GT_RefreshWindow
// @ndk-side-effects Performs the required initial refresh immediately after opening a live Workbench window with an attached integer gadget, then verifies visible gadget rendering by pixel readback
@test("gadtools.library GT_RefreshWindow repaints gadget pixels")
pub fn gadtools_refresh_window() {
    var fixture = window_fixture()
    expect(fixture.window != null, "GadTools window opens")
    if fixture.window != null { GT_RefreshWindow(fixture.window, null) }
    WaitBlit()
    expect(gadget_pixels(&var fixture) > 0, "initial refresh leaves visible GadTools rendering")
    close_window_fixture(&var fixture)
}

// @covers-ndk function|gadtools.library|GT_BeginRefresh
// @ndk-side-effects Enters a GadTools-friendly refresh session on a live simple-refresh window, proves both Window and Layer update flags are set, then balances the session before teardown
@test("gadtools.library GT_BeginRefresh enters live refresh state")
pub fn gadtools_begin_refresh() {
    var fixture = window_fixture()
    expect(fixture.window != null, "GadTools window opens")
    if fixture.window != null { GT_BeginRefresh(fixture.window) }
    var refreshing: bool = false
    if fixture.window != null {
        unsafe {
            refreshing = ((*fixture.window).Flags & WFLG_WINDOWREFRESH) != 0 &&
                (*fixture.window).WLayer != null &&
                ((*(*fixture.window).WLayer).Flags & UPDATING_FLAG) != 0
        }
    }
    expect(refreshing, "begin refresh sets live Window and Layer update state")
    if fixture.window != null { GT_EndRefresh(fixture.window, 1) }
    close_window_fixture(&var fixture)
}

// @covers-ndk function|gadtools.library|GT_EndRefresh
// @ndk-side-effects Completes a real GadTools refresh session and proves the Window refresh bit, Layer update bit, and recursive layer-lock nesting all return to their pre-session state
@test("gadtools.library GT_EndRefresh restores live refresh state")
pub fn gadtools_end_refresh() {
    var fixture = window_fixture()
    expect(fixture.window != null, "GadTools window opens")
    let original_nesting = if fixture.window != null && unsafe { (*fixture.window).WLayer != null } {
        unsafe { (*(*fixture.window).WLayer).Lock.ss_NestCount }
    } else { (i16)0 }
    if fixture.window != null {
        GT_BeginRefresh(fixture.window)
        GT_EndRefresh(fixture.window, 1)
    }
    var restored: bool = false
    if fixture.window != null {
        unsafe {
            restored = ((*fixture.window).Flags & WFLG_WINDOWREFRESH) == 0 &&
                (*fixture.window).WLayer != null &&
                ((*(*fixture.window).WLayer).Flags & UPDATING_FLAG) == 0 &&
                (*(*fixture.window).WLayer).Lock.ss_NestCount == original_nesting
        }
    }
    expect(restored, "end refresh restores Window, Layer, and lock state")
    close_window_fixture(&var fixture)
}

// @covers-ndk function|gadtools.library|GT_GetIMsg
// @ndk-side-effects Queues an ABI-complete close-window IntuiMessage on a real Exec port, obtains GadTools' modified message, verifies exact class/code, and returns the original through its reply port
@test("gadtools.library GT_GetIMsg filters a real queued message")
pub fn gadtools_get_imsg() {
    var fixture = message_fixture()
    expect(fixture.input != null && fixture.reply != null, "message and reply ports allocate")
    let original = original_message(&var fixture)
    queue_message(&var fixture)
    let filtered = if fixture.input != null { GT_GetIMsg(fixture.input) } else { (*IntuiMessage)null }
    expect(filtered != null, "queued close message survives GadTools filtering")
    if filtered != null {
        unsafe {
            expect((*filtered).Class == $00000200 && (*filtered).Code == $1234,
                "filtered message preserves exact class and code")
        }
        GT_ReplyIMsg(filtered)
    } else if original != null {
        ReplyMsg((*Message)original)
    }
    let replied = if fixture.reply != null { GetMsg(fixture.reply) } else { (*Message)null }
    expect(replied == (*Message)original, "GadTools returns the exact original message")
    close_message_fixture(&var fixture)
}

// @covers-ndk function|gadtools.library|GT_ReplyIMsg
// @ndk-side-effects Replies a modified message obtained from GT_GetIMsg and proves the exact caller-owned original—not GadTools' temporary copy—is queued on the designated reply port
@test("gadtools.library GT_ReplyIMsg replies exact original message")
pub fn gadtools_reply_imsg() {
    var fixture = message_fixture()
    expect(fixture.input != null && fixture.reply != null, "message and reply ports allocate")
    let original = original_message(&var fixture)
    queue_message(&var fixture)
    let filtered = if fixture.input != null { GT_GetIMsg(fixture.input) } else { (*IntuiMessage)null }
    expect(filtered != null, "GadTools returns a modified message")
    if filtered != null { GT_ReplyIMsg(filtered) } else { ReplyMsg((*Message)original) }
    let replied = if fixture.reply != null { GetMsg(fixture.reply) } else { (*Message)null }
    expect(replied == (*Message)original, "reply port receives the exact original address")
    if replied != null { unsafe { expect((*replied).mn_Node.ln_Type == 7, "Exec marks original as replied") } }
    close_message_fixture(&var fixture)
}

// @covers-ndk function|gadtools.library|GT_FilterIMsg
// @ndk-side-effects Filters an ABI-complete close-window message taken from a real Exec port, verifies its public fields, restores the original, and completes the mandatory Exec reply lifecycle
@test("gadtools.library GT_FilterIMsg preserves application message")
pub fn gadtools_filter_imsg() {
    var fixture = message_fixture()
    expect(fixture.input != null && fixture.reply != null, "message and reply ports allocate")
    let original = original_message(&var fixture)
    queue_message(&var fixture)
    let received = if fixture.input != null { GetMsg(fixture.input) } else { (*Message)null }
    expect(received == (*Message)original, "Exec returns the exact queued message")
    let filtered = if received != null { GT_FilterIMsg((*IntuiMessage)received) } else { (*IntuiMessage)null }
    expect(filtered != null, "close-window message remains application-visible")
    if filtered != null {
        unsafe {
            expect((*filtered).Class == $00000200 && (*filtered).Code == $1234,
                "filter preserves exact close-window payload")
        }
    }
    let restored = if filtered != null { GT_PostFilterIMsg(filtered) } else { (*IntuiMessage)null }
    expect(restored == original, "post-filter restores exact original")
    if restored != null { ReplyMsg((*Message)restored) }
    let replied = if fixture.reply != null { GetMsg(fixture.reply) } else { (*Message)null }
    expect(replied == (*Message)original, "original completes normal Exec reply lifecycle")
    close_message_fixture(&var fixture)
}

// @covers-ndk function|gadtools.library|GT_PostFilterIMsg
// @ndk-side-effects Reverses a successful GadTools filter, proves the exact original IntuiMessage address is recovered, then replies and retrieves that same address through Exec
@test("gadtools.library GT_PostFilterIMsg restores exact original")
pub fn gadtools_post_filter_imsg() {
    var fixture = message_fixture()
    expect(fixture.input != null && fixture.reply != null, "message and reply ports allocate")
    let original = original_message(&var fixture)
    queue_message(&var fixture)
    let received = if fixture.input != null { GetMsg(fixture.input) } else { (*Message)null }
    let filtered = if received != null { GT_FilterIMsg((*IntuiMessage)received) } else { (*IntuiMessage)null }
    expect(filtered != null, "filter produces a modified message")
    let restored = GT_PostFilterIMsg(filtered)
    expect(restored == original, "post-filter returns exact caller-owned message")
    if restored != null { ReplyMsg((*Message)restored) }
    let replied = if fixture.reply != null { GetMsg(fixture.reply) } else { (*Message)null }
    expect(replied == (*Message)original, "restored original remains replyable")
    close_message_fixture(&var fixture)
}
