from std::core import Result
from std::test::test import expect
from amiga::raw::asl import AbortAslRequest, ActivateAslRequest, AllocAslRequest, AllocAslRequestTags, AllocFileRequest, AslRequest, AslRequestTags, FreeAslRequest, FreeFileRequest, RequestFile
from amiga::raw::consts import ASLFR_InitialDrawer, ASLFR_InitialFile, ASLFR_PrivateIDCMP, ASLFR_TitleText, ASLFR_UserData, ASL_FileRequest, IECLASS_RAWKEY, IND_WRITEEVENT, TAG_DONE, WA_Activate, WA_AutoAdjust, WA_Height, WA_Left, WA_Top, WA_Width, WFLG_WINDOWACTIVE
from amiga::raw::dos import IoErr
from amiga::raw::exec import CloseDevice, CreateIORequest, CreateMsgPort, DeleteIORequest, DeleteMsgPort, DoIO, OpenDevice
from amiga::raw::graphics import WaitTOF
from amiga::raw::intuition import ActivateWindow, CloseWindow, OpenWindowTagList
from amiga::raw::structs import FileRequester, InputEvent, IORequest, IOStdReq, TagItem, Window
from amiga::sys::exec::thread import run_thread_loop, spawn_thread

const ASL_CONTROL_WORK: u32 = 1 << 17
const USER_DATA: u32 = $4E4F5655

static var ACTIVE_REQUEST: *u8 = null
static var ACTIVATION_PARENT: *Window = null
static var ABORT_CALLED: bool = false
static var ACTIVATE_CALLED: bool = false
static var ACTIVATION_OBSERVED: bool = false
static var CONTROL_ABORT_TARGET: bool = false
static var REQUEST_RETURNED: bool = false
static var ABORT_OBSERVED: bool = false
static var ESCAPE_WRITTEN: bool = false

fn c_equals(left: *u8, right: *u8) -> bool {
    return false if left == null || right == null
    var index: u32 = 0
    forever {
        let a = unsafe { left[index] }
        let b = unsafe { right[index] }
        return false if a != b
        return true if a == 0
        index++
    }
}

fn make_file_request() -> *u8 {
    var tags: [TagItem] = [
        TagItem { ti_Tag: ASLFR_InitialDrawer, ti_Data: (u32)"RAM:".as_cstr() },
        TagItem { ti_Tag: ASLFR_InitialFile, ti_Data: (u32)"novus.txt".as_cstr() },
        TagItem { ti_Tag: ASLFR_TitleText, ti_Data: (u32)"Novus ASL test".as_cstr() },
        TagItem { ti_Tag: ASLFR_UserData, ti_Data: USER_DATA },
        TagItem { ti_Tag: ASLFR_PrivateIDCMP, ti_Data: 1 },
        TagItem { ti_Tag: TAG_DONE, ti_Data: 0 },
    ]
    return AllocAslRequest(ASL_FileRequest, &var tags[0])
}

fn valid_file_request(requester: *u8) -> bool {
    return false if requester == null
    let file = (*FileRequester)requester
    return c_equals(file.fr_Drawer, "RAM:") && c_equals(file.fr_File, "novus.txt") &&
           (u32)file.fr_UserData == USER_DATA
}

fn open_parent_window() -> *Window {
    var tags: [TagItem] = [
        TagItem { ti_Tag: WA_Left, ti_Data: 30 },
        TagItem { ti_Tag: WA_Top, ti_Data: 30 },
        TagItem { ti_Tag: WA_Width, ti_Data: 180 },
        TagItem { ti_Tag: WA_Height, ti_Data: 60 },
        TagItem { ti_Tag: WA_AutoAdjust, ti_Data: 1 },
        TagItem { ti_Tag: WA_Activate, ti_Data: 1 },
        TagItem { ti_Tag: TAG_DONE, ti_Data: 0 },
    ]
    return OpenWindowTagList(null, &var tags[0])
}

@suppress("W0002", "The pinned NDK command and event-class constants fit their exact ABI fields")
fn inject_escape() -> bool {
    let port = CreateMsgPort()
    if port == null { return false }
    let request = CreateIORequest(port, @sizeof(IOStdReq))
    if request == null {
        DeleteMsgPort(port)
        return false
    }
    let opened = unsafe { OpenDevice("input.device", 0, (*IORequest)request, 0) } == 0
    var event: InputEvent = @zeroed(InputEvent)
    event.ie_Class = (u8)IECLASS_RAWKEY
    event.ie_Code = $45
    let io = (*IOStdReq)request
    io.io_Command = (u16)IND_WRITEEVENT
    io.io_Length = @sizeof(InputEvent)
    io.io_Data = (*u8)&var event
    let down = opened && unsafe { DoIO((*IORequest)request) } == 0
    event.ie_Code = $C5
    let up = down && unsafe { DoIO((*IORequest)request) } == 0
    if opened { unsafe { CloseDevice((*IORequest)request) } }
    DeleteIORequest(request)
    DeleteMsgPort(port)
    return down && up
}

fn asl_control_tick(_state: *u8) -> bool {
    // The first ASL drawer scan is slow under emulation. Keep trying while the
    // modal requester transitions from construction to its input loop.
    for var frame: u32 = 0; frame < 120; frame++ { WaitTOF() }

    if ACTIVE_REQUEST != null && ACTIVATION_PARENT != null {
        for var attempt: u32 = 0; attempt < 120; attempt++ {
            ActivateWindow(ACTIVATION_PARENT)
            WaitTOF()
            let was_parent = (ACTIVATION_PARENT.Flags & WFLG_WINDOWACTIVE) != 0
            ActivateAslRequest(ACTIVE_REQUEST)
            ACTIVATE_CALLED = true
            for var frame: u32 = 0; frame < 4; frame++ { WaitTOF() }
            if was_parent && (ACTIVATION_PARENT.Flags & WFLG_WINDOWACTIVE) == 0 {
                ACTIVATION_OBSERVED = true
                break
            }
        }
    }

    if CONTROL_ABORT_TARGET && ACTIVE_REQUEST != null {
        for var attempt: u32 = 0; attempt < 120; attempt++ {
            AbortAslRequest(ACTIVE_REQUEST)
            ABORT_CALLED = true
            for var frame: u32 = 0; frame < 5; frame++ { WaitTOF() }
            if REQUEST_RETURNED {
                ABORT_OBSERVED = true
                return false
            }
        }
    }

    for var attempt: u32 = 0; attempt < 60 && !REQUEST_RETURNED; attempt++ {
        ESCAPE_WRITTEN = inject_escape() || ESCAPE_WRITTEN
        for var frame: u32 = 0; frame < 10; frame++ { WaitTOF() }
    }
    return false
}

fn asl_controller() -> i32 {
    return run_thread_loop(ASL_CONTROL_WORK, null, asl_control_tick)
}

fn reset_control(requester: *u8, parent: *Window, abort_target: bool) {
    ACTIVE_REQUEST = requester
    ACTIVATION_PARENT = parent
    ABORT_CALLED = false
    ACTIVATE_CALLED = false
    ACTIVATION_OBSERVED = false
    CONTROL_ABORT_TARGET = abort_target
    REQUEST_RETURNED = false
    ABORT_OBSERVED = false
    ESCAPE_WRITTEN = false
}

fn clear_control() {
    ACTIVE_REQUEST = null
    ACTIVATION_PARENT = null
    CONTROL_ABORT_TARGET = false
}

fn settle_requester() {
    for var frame: u32 = 0; frame < 50; frame++ { WaitTOF() }
}

// @covers-ndk function|asl.library|AllocAslRequest
// @ndk-side-effects Allocates a real file requester with initial drawer, file, title, private IDCMP, and user-data tags, verifies the read-only result fields, then frees it
@test("asl.library AllocAslRequest applies file tags")
pub fn asl_alloc_request() {
    let requester = make_file_request()
    let valid = valid_file_request(requester)
    FreeAslRequest(requester)
    expect(valid, "the allocated file requester exposes the exact tagged drawer, file, and user data")
}

// @covers-ndk function|asl.library|AllocAslRequestTags
// @ndk-side-effects Allocates a real file requester through the varargs stub, verifies exact read-only initial values and user data, then frees it
@test("asl.library AllocAslRequestTags applies varargs")
pub fn asl_alloc_request_tags() {
    let requester = AllocAslRequestTags(ASL_FileRequest,
        ASLFR_InitialDrawer, (u32)"RAM:".as_cstr(),
        ASLFR_InitialFile, (u32)"novus.txt".as_cstr(),
        ASLFR_UserData, USER_DATA,
        ASLFR_PrivateIDCMP, 1,
        TAG_DONE)
    let valid = valid_file_request(requester)
    FreeAslRequest(requester)
    expect(valid, "varargs allocation preserves the exact requested initial values")
}

// @covers-ndk function|asl.library|FreeAslRequest
// @ndk-side-effects Frees a tagged file requester, allocates and validates a complete replacement, then frees the replacement
@test("asl.library FreeAslRequest releases a requester")
pub fn asl_free_request() {
    let first = make_file_request()
    let first_valid = valid_file_request(first)
    FreeAslRequest(first)
    let replacement = make_file_request()
    let replacement_valid = valid_file_request(replacement)
    FreeAslRequest(replacement)
    expect(first_valid && replacement_valid, "freeing one requester permits an independent complete replacement")
}

// @covers-ndk function|asl.library|AllocFileRequest
// @ndk-side-effects Allocates the obsolete but supported real FileRequester structure, verifies initialized result pointers, then frees it through its matching legacy API
@test("asl.library AllocFileRequest initializes a legacy requester")
pub fn asl_alloc_file_request() {
    let requester = AllocFileRequest()
    let initialized = requester != null && requester.fr_File != null && requester.fr_Drawer != null && requester.fr_Pattern != null
    FreeFileRequest(requester)
    expect(initialized, "legacy allocation returns an initialized FileRequester")
}

// @covers-ndk function|asl.library|FreeFileRequest
// @ndk-side-effects Frees a legacy FileRequester, allocates and validates a fresh replacement, then frees the replacement
@test("asl.library FreeFileRequest releases a legacy requester")
pub fn asl_free_file_request() {
    let first = AllocFileRequest()
    let first_valid = first != null
    FreeFileRequest(first)
    let replacement = AllocFileRequest()
    let replacement_valid = replacement != null && replacement.fr_File != null
    FreeFileRequest(replacement)
    expect(first_valid && replacement_valid, "legacy free permits a fresh initialized requester")
}

// @covers-ndk function|asl.library|RequestFile
// @ndk-side-effects Opens the real legacy file requester, injects an Escape key through input.device from a separate Exec task, waits for that task, verifies cancellation, and frees the requester
@test("asl.library RequestFile handles an asynchronous cancel")
pub fn asl_request_file() {
    let requester = AllocFileRequest()
    reset_control((*u8)requester, null, false)
    var cancelled = false
    match spawn_thread("Novus ASL closer", asl_controller, 8192) {
        Result::Ok(var thread) => {
            let started = thread.signal(ASL_CONTROL_WORK)
            let result = RequestFile(requester)
            let io_error = IoErr()
            REQUEST_RETURNED = true
            thread.wait()
            cancelled = started && result == 0 && ESCAPE_WRITTEN && io_error == 0
        },
        Result::Err(_) => {},
    }
    clear_control()
    FreeFileRequest(requester)
    settle_requester()
    expect(cancelled, "the modal legacy requester closes as a user cancellation when aborted")
}

// @covers-ndk function|asl.library|AslRequest
// @ndk-side-effects Opens a tagged real file requester through the tag-list API, injects Escape through input.device from a separate Exec task, waits for completion, verifies cancellation, and frees it
@test("asl.library AslRequest handles an asynchronous cancel")
pub fn asl_request_a() {
    let requester = make_file_request()
    var tags: [TagItem] = [
        TagItem { ti_Tag: ASLFR_TitleText, ti_Data: (u32)"Novus AslRequest".as_cstr() },
        TagItem { ti_Tag: TAG_DONE, ti_Data: 0 },
    ]
    reset_control(requester, null, false)
    var cancelled = false
    match spawn_thread("Novus ASL closer", asl_controller, 8192) {
        Result::Ok(var thread) => {
            let started = thread.signal(ASL_CONTROL_WORK)
            let result = AslRequest(requester, &var tags[0])
            let io_error = IoErr()
            REQUEST_RETURNED = true
            thread.wait()
            cancelled = started && result == 0 && ESCAPE_WRITTEN && io_error == 0
        },
        Result::Err(_) => {},
    }
    clear_control()
    FreeAslRequest(requester)
    settle_requester()
    expect(cancelled, "the tag-list requester reports a clean asynchronous cancellation")
}

// @covers-ndk function|asl.library|AslRequestTags
// @ndk-side-effects Opens a tagged real file requester through the varargs stub, injects Escape through input.device from a separate Exec task, waits for completion, verifies cancellation, and frees it
@test("asl.library AslRequestTags handles an asynchronous cancel")
pub fn asl_request_tags() {
    let requester = make_file_request()
    reset_control(requester, null, false)
    var cancelled = false
    match spawn_thread("Novus ASL closer", asl_controller, 8192) {
        Result::Ok(var thread) => {
            let started = thread.signal(ASL_CONTROL_WORK)
            let result = AslRequestTags(requester, ASLFR_TitleText, (u32)"Novus varargs request".as_cstr(), TAG_DONE)
            let io_error = IoErr()
            REQUEST_RETURNED = true
            thread.wait()
            cancelled = started && result == 0 && ESCAPE_WRITTEN && io_error == 0
        },
        Result::Err(_) => {},
    }
    clear_control()
    FreeAslRequest(requester)
    settle_requester()
    expect(cancelled, "the varargs requester reports a clean asynchronous cancellation")
}

// @covers-ndk function|asl.library|AbortAslRequest
// @ndk-side-effects Opens a real modal file requester, invokes the target call from a separate Exec task after the window is visible, waits for both contexts, verifies cancellation, and frees the requester
@test("asl.library AbortAslRequest closes a modal requester")
pub fn asl_abort_request() {
    let requester = make_file_request()
    reset_control(requester, null, true)
    var aborted = false
    match spawn_thread("Novus ASL abort", asl_controller, 8192) {
        Result::Ok(var thread) => {
            let started = thread.signal(ASL_CONTROL_WORK)
            let result = AslRequestTags(requester, ASLFR_TitleText, (u32)"AbortAslRequest target".as_cstr(), TAG_DONE)
            let io_error = IoErr()
            REQUEST_RETURNED = true
            thread.wait()
            aborted = started && result == 0 && ABORT_CALLED && ABORT_OBSERVED && !ESCAPE_WRITTEN && io_error == 0
        },
        Result::Err(_) => {},
    }
    clear_control()
    FreeAslRequest(requester)
    settle_requester()
    expect(aborted, "the cross-task abort closes the live requester as cancellation")
}

// @covers-ndk function|asl.library|ActivateAslRequest
// @ndk-side-effects Opens a parent window and real modal file requester, steals activation to the parent from another Exec task, invokes the target call, verifies Intuition moves activation away from the parent, injects Escape, and frees all resources
@test("asl.library ActivateAslRequest restores requester activation")
pub fn asl_activate_request() {
    let parent = open_parent_window()
    let requester = make_file_request()
    reset_control(requester, parent, false)
    var activated = false
    match spawn_thread("Novus ASL activate", asl_controller, 8192) {
        Result::Ok(var thread) => {
            let started = thread.signal(ASL_CONTROL_WORK)
            let result = AslRequestTags(requester, ASLFR_TitleText, (u32)"ActivateAslRequest target".as_cstr(), TAG_DONE)
            REQUEST_RETURNED = true
            thread.wait()
            activated = started && result == 0 && ACTIVATE_CALLED && ACTIVATION_OBSERVED && ESCAPE_WRITTEN
        },
        Result::Err(_) => {},
    }
    clear_control()
    FreeAslRequest(requester)
    if parent != null { CloseWindow(parent) }
    settle_requester()
    expect(activated, "the target call returns activation from the parent to the live requester")
}
