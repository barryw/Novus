    let window = if page != null { open_window(page) } else { (*Window)null }
    let changed = if window != null { SetPageGadgetAttrs((*Gadget)child, (*u32)page, window, null, GA_Disabled, 1, TAG_DONE) } else { 0 }
    var disabled: u32 = 0
