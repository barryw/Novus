// @covers-ndk function|layout.library|RefreshPageGadget
// @ndk-side-effects Refreshes a real visible Page child in an active Workbench window, verifies the child remains live with its exact ID, then closes and disposes the hierarchy
@test("layout.library RefreshPageGadget focused timing")
pub fn page_refresh_timing() {
    let child = make_input(57)
    let page = if child != null { make_page(child) } else { (*u8)null }
    let window = if page != null { open_window(page) } else { (*Window)null }
    if window != null { RefreshPageGadget((*Gadget)child, (*u32)page, window, null) }
    var id: u32 = 0
    let got = if child != null { GetAttr(GA_ID, child, &var id) } else { 0 }
    let refreshed = window != null
    if window != null { CloseWindow(window) }
    if page != null { DisposeObject(page) }
    if page == null && child != null { DisposeObject(child) }
    settle_display()
    expect(refreshed && got != 0 && id == 57, "refreshed Page child remains live with ID 57")
}
