    let previous = if handle != 0 { SelectOutput(handle) } else { 0 }
    var arguments: [i32] = [42]
    let result = if handle != 0 { VPrintf("value=%ld", unsafe { (*u8)&var arguments[0] }) } else { -1 }
    if handle != 0 { Flush(handle) }
    let displaced = if handle != 0 { SelectOutput(original) } else { 0 }
    if handle != 0 { Close(handle) }
    expect(previous == original && displaced == handle && result == 8 && file_equals(path, "value=42"), "formatted default output and length are exact")
