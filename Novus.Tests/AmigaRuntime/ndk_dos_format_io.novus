// @covers-ndk function|dos.library|PrintFault
// @ndk-side-effects Temporarily redirects process output, emits a localized known DOS error with a stable caller prefix, captures its IoErr contract, then restores both output and prior IoErr
@test("dos.library PrintFault emits a prefixed DOS error")
pub fn dos_print_fault() {
    let path: Str = "RAM:novus_ndk_format"
    remove_file(path)
    let handle = Open(path.as_cstr(), 1006)
    let output = Output()
    let previous = if handle != 0 { SelectOutput(handle) } else { 0 }
    let original_error = IoErr()
    SetIoErr(4321)
    let result = if handle != 0 { PrintFault(205, "Novus") } else { 0 }
    let reported = IoErr()
    if handle != 0 { Flush(handle) }
    let displaced = if handle != 0 { SelectOutput(output) } else { 0 }
    SetIoErr(original_error)
    if handle != 0 { Close(handle) }
    expect(previous == output && displaced == handle && result != 0 && file_starts_with(path, "Novus:"), "known error is printed with the stable caller prefix")
    expect(reported == 205, "PrintFault publishes the supplied error through IoErr")
    remove_file(path)
}
