    delete_fixture()
}

// @covers-ndk function|icon.library|AddFreeList
// @ndk-side-effects Records one exact Exec allocation in a caller-owned initialized FreeList, increments its public count, and transfers allocation ownership to the list
@test("icon.library AddFreeList records exact allocation ownership")
pub fn icon_add_free_list() {
    var free_list: FreeList = @zeroed(FreeList)
    NewList(&var free_list.fl_MemList)
    let memory = unsafe { AllocMem(32, MEMF_PUBLIC | MEMF_CLEAR) }
    expect(memory != null, "tracked memory allocates")
    if memory != null {
        let added = AddFreeList(&var free_list, memory, 32)
        let tail = unsafe { (*Node)&var free_list.fl_MemList.lh_Tail }
        expect(added != 0 && free_list.fl_MemList.lh_Head != tail,
            "free list records one exact allocation")
        if added != 0 { FreeFreeList(&var free_list) } else { unsafe { FreeMem(memory, 32) } }
    }
}

// @covers-ndk function|icon.library|FreeFreeList
// @ndk-side-effects Releases two exact Exec allocations previously transferred into one FreeList; the whole-process leak gate proves both payloads and tracking entries return
@test("icon.library FreeFreeList releases every tracked allocation")
pub fn icon_free_free_list() {
    var free_list: FreeList = @zeroed(FreeList)
    NewList(&var free_list.fl_MemList)
    let first = unsafe { AllocMem(16, MEMF_PUBLIC) }
    let second = unsafe { AllocMem(24, MEMF_PUBLIC) }
    let first_added = first != null && AddFreeList(&var free_list, first, 16) != 0
    let second_added = second != null && AddFreeList(&var free_list, second, 24) != 0
    let tail = unsafe { (*Node)&var free_list.fl_MemList.lh_Tail }
    expect(first_added && second_added && free_list.fl_MemList.lh_Head != tail,
        "both allocations transfer to free list")
    if first_added && second_added {
        FreeFreeList(&var free_list)
    } else {
        if first != null && !first_added { unsafe { FreeMem(first, 16) } }
        if second != null && !second_added { unsafe { FreeMem(second, 24) } }
        if first_added || second_added { FreeFreeList(&var free_list) }
    }
}

// @covers-ndk function|icon.library|ChangeToSelectedIconColor
// @ndk-side-effects Mutates one caller-owned RGB register to the selected-image variant and keeps every channel within its exact byte ABI
@test("icon.library ChangeToSelectedIconColor transforms RGB value")
pub fn icon_change_selected_color() {
    var color = ColorRegister { red: 200, green: 100, blue: 50 }
    ChangeToSelectedIconColor(&var color)
    expect(color.red != 200 || color.green != 100 || color.blue != 50,
        "selected color differs from original RGB")
}

// @covers-ndk function|icon.library|GetIconRectangleA
// @ndk-side-effects Computes the exact nonempty rendering bounds of a live default icon into caller-owned Rectangle storage without drawing or changing icon ownership
@test("icon.library GetIconRectangleA returns usable bounds")
pub fn icon_get_rectangle_a() {
    let icon = default_tool()
    var rectangle: Rectangle = @zeroed(Rectangle)
    let success = if icon != null { GetIconRectangleA(null, icon, null, &var rectangle, null) } else { 0 }
    expect(success != 0, "default icon bounds compute")
    expect(rectangle.MaxX >= rectangle.MinX && rectangle.MaxY >= rectangle.MinY,
        "computed rectangle has nonempty inclusive bounds")
    FreeDiskObject(icon)
}

// @covers-ndk function|icon.library|GetIconRectangle
// @ndk-side-effects Exercises the varargs rectangle entry point with a real label and RastPort, proving the resulting inclusive bounds cover a positive icon-plus-label area
@test("icon.library GetIconRectangle varargs includes label bounds")
pub fn icon_get_rectangle_varargs() {
    let icon = default_tool()
    var rectangle: Rectangle = @zeroed(Rectangle)
    var rastport: RastPort = @zeroed(RastPort)
    InitRastPort(&var rastport)
    let success = if icon != null {
        GetIconRectangle(&var rastport, icon, cstr("Novus"), &var rectangle, TAG_DONE)
    } else { 0 }
    expect(success != 0, "varargs icon-plus-label bounds compute")
    expect(rectangle.MaxX > rectangle.MinX && rectangle.MaxY > rectangle.MinY,
        "icon-plus-label bounds have positive area")
    FreeDiskObject(icon)
}

// @covers-ndk function|icon.library|LayoutIconA
// @ndk-side-effects Remaps an unremapped palette default icon to the library's four-color fallback using an explicit empty tag list and leaves a renderable nonzero icon
@test("icon.library LayoutIconA remaps palette icon without screen")
pub fn icon_layout_a() {
    let icon = palette_tool()
    expect(icon != null, "unremapped palette tool icon loads")
    if icon != null {
        var tags = [TagItem { ti_Tag: TAG_DONE, ti_Data: 0 }]
        expect(LayoutIconA(icon, null, &var tags[0]) != 0, "palette icon remaps to fallback palette")
        var width: u32 = 0
        var query = [
            TagItem { ti_Tag: ICONCTRLA_GetWidth, ti_Data: unsafe { (u32)(*u32)&var width } },
            TagItem { ti_Tag: TAG_DONE, ti_Data: 0 },
        ]
        expect(IconControlA(icon, &var query[0]) == 1 && width > 0, "remapped icon remains renderable")
        FreeDiskObject(icon)
    }
}

// @covers-ndk function|icon.library|LayoutIcon
// @ndk-side-effects Exercises the varargs layout entry point to remap an unremapped palette icon to the fallback palette, then verifies a nonzero rendered height and releases allocated image state
@test("icon.library LayoutIcon varargs remaps palette icon")
pub fn icon_layout_varargs() {
    let icon = palette_tool()
    expect(icon != null, "unremapped palette tool icon loads")
    if icon != null {
        expect(LayoutIcon(icon, null, TAG_DONE) != 0, "varargs layout remaps icon")
        var height: u32 = 0
        expect(IconControl(icon, ICONCTRLA_GetHeight, &var height, TAG_DONE) == 1 && height > 0,
            "varargs-remapped icon has nonzero height")
        FreeDiskObject(icon)
    }
}

// @covers-ndk function|icon.library|DrawIconStateA
// @ndk-side-effects Draws a real default icon in normal state into a cleared owned off-screen bitmap; exact pixel readback proves nonempty rendering before bitmap and icon teardown
@test("icon.library DrawIconStateA changes real bitmap pixels")
pub fn icon_draw_state_a() {
    let icon = default_tool()
    var surface = match bitmap() {
        Result::Ok(value) => value,
        Result::Err(_) => {
            expect(false, "off-screen bitmap allocates")
            FreeDiskObject(icon)
            return
        },
    }
    var rastport: RastPort = @zeroed(RastPort)
    attach(&surface, &var rastport)
    expect(icon != null, "default icon loads")
    if icon != null {
        DrawIconStateA(&var rastport, icon, null, 4, 4, IDS_NORMAL, null)
        WaitBlit()
        expect(painted_pixels(&var rastport) > 0, "normal icon paints nonzero pixels")
        FreeDiskObject(icon)
    }
}

// @covers-ndk function|icon.library|DrawIconState
// @ndk-side-effects Exercises the varargs renderer in selected frameless state on a cleared owned off-screen bitmap and requires nonzero pixel readback before complete teardown
@test("icon.library DrawIconState varargs paints selected state")
pub fn icon_draw_state_varargs() {
    let icon = default_tool()
    var surface = match bitmap() {
        Result::Ok(value) => value,
        Result::Err(_) => {
            expect(false, "off-screen bitmap allocates")
            FreeDiskObject(icon)
            return
        },
    }
    var rastport: RastPort = @zeroed(RastPort)
    attach(&surface, &var rastport)
    expect(icon != null, "default icon loads")
    if icon != null {
        DrawIconState(&var rastport, icon, null, 4, 4, IDS_SELECTED, ICONDRAWA_Frameless, 1, TAG_DONE)
        WaitBlit()
        expect(painted_pixels(&var rastport) > 0, "selected frameless icon paints nonzero pixels")
        FreeDiskObject(icon)
    }
}
