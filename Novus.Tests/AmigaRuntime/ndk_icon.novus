pub fn icon_put_tags() {
    delete_fixture()
    let icon = default_tool()
    let written = if icon != null { PutIconTags(path(), icon, ICONPUTA_NotifyWorkbench, 0, TAG_DONE) } else { 0 }
    let reloaded = if written != 0 { GetDiskObject(path()) } else { (*DiskObject)null }
    expect(reloaded != null && unsafe { (*reloaded).do_Type == WBTOOL }, "varargs write reloads exact type")
