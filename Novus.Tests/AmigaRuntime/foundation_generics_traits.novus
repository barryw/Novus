// Target-executed conformance tests for generics, traits, derives, and operators.

from std::test::test import expect, expect_true
from std::collections::arrayvec import ArrayVec, ArrayVecError
from std::core import Option, Result

struct Pair<T> {
    first: T,
    second: T,
}

impl<T> Pair<T> {
    fn new(first: T, second: T) -> Pair<T> {
        return Pair { first: first, second: second }
    }
}

struct Buffer<const N: u32> {
    bytes: [u8; N],
    len: u32,
}

impl<const N: u32> Buffer<N> {
    fn new() -> Buffer<N> {
        return Buffer { bytes: [0u8; N], len: 0 }
    }

    fn capacity(&self) -> u32 {
        return N
    }

    fn set(&var self, index: u32, value: u8) {
        self.bytes[index] = value
    }

    fn get(&self, index: u32) -> u8 {
        return self.bytes[index]
    }
}

enum Maybe<T> {
    Just(T),
    Nothing,
}

impl<T> Maybe<T> {
    fn get_or(self, consuming fallback: T) -> T {
        match self {
            Maybe::Just(value) => return value,
            Maybe::Nothing => return fallback,
        }
    }
}

trait Scale {
    fn scale(&self, factor: i32) -> i32
}

struct Scalar {
    value: i32,
}

impl Scale for Scalar {
    fn scale(&self, factor: i32) -> i32 {
        return self.value * factor
    }
}

struct Vector {
    x: i32,
    y: i32,
}

impl Add for Vector {
    fn add(&self, other: &Vector) -> Vector {
        return Vector { x: self.x + other.x, y: self.y + other.y }
    }
}

impl Eq for Vector {
    fn eq(&self, other: &Vector) -> bool {
        return self.x == other.x && self.y == other.y
    }
}

#[derive(Eq, Hash)]
struct DerivedPoint {
    x: i32,
    y: i32,
}

struct InlineItem {
    value: u32,
}

struct InlineItems {
    items: ArrayVec<InlineItem, 2>,
}

impl InlineItems {
    fn sum(&self) -> u32 {
        var total = 0u32
        for item in &self.items { total += item.value }
        return total
    }
}

static var ARRAYVEC_DROPS: u32 = 0u32

struct TrackedInlineItem {
    value: u32,
}

impl Drop for TrackedInlineItem {
    fn drop(&var self) { ARRAYVEC_DROPS++ }
}

fn drop_bounded_items() {
    var items = ArrayVec::<TrackedInlineItem, 2>::new()
    let _ = items.push(TrackedInlineItem { value: 1u32 })
    let _ = items.push(TrackedInlineItem { value: 2u32 })
    let _ = items.push(TrackedInlineItem { value: 3u32 })
}

@test("generic structs monomorphize for distinct types")
pub fn foundation_generic_structs() {
    let numbers = Pair::<i32>::new(10, 20)
    let flags = Pair::<bool>::new(true, false)
    expect(numbers.first + numbers.second == 30, "i32 pair")
    expect(flags.first && !flags.second, "bool pair")
}

@test("const generics create distinct capacities")
pub fn foundation_const_generics() {
    var small = Buffer::<8>::new()
    let large = Buffer::<64>::new()
    expect(small.capacity() == 8u32, "small buffer")
    expect(large.capacity() == 64u32, "large buffer")
    small.set(7u32, 42u8)
    expect(small.get(7u32) == 42u8, "const-sized inline array")
    expect(@sizeof(Buffer<8>) == 12u32, "const-sized layout")
}

@test("generic enums carry values and fallbacks")
pub fn foundation_generic_enums() {
    let present: Maybe<i32> = Maybe::Just(42)
    let absent: Maybe<i32> = Maybe::Nothing
    expect(present.get_or(0) == 42, "generic payload")
    expect(absent.get_or(7) == 7, "generic fallback")
}

@test("custom trait dispatch")
pub fn foundation_traits() {
    let value = Scalar { value: 14 }
    expect(value.scale(3) == 42, "trait method")
}

@test("operator overloads dispatch through traits")
pub fn foundation_operator_overloads() {
    let left = Vector { x: 1, y: 2 }
    let right = Vector { x: 3, y: 4 }
    let sum = left + right
    expect(sum.x == 4 && sum.y == 6, "Add overload")
    expect_true(sum == Vector { x: 4, y: 6 }, "Eq overload")
}

@test("derive generates Eq and Hash implementations")
pub fn foundation_derive() {
    let a = DerivedPoint { x: 10, y: 20 }
    let b = DerivedPoint { x: 10, y: 20 }
    let c = DerivedPoint { x: 10, y: 30 }
    expect_true(a.eq(&b), "derived equality")
    expect(a.hash() == b.hash(), "equal values hash equally")
    expect(a.hash() != c.hash(), "different values hash differently")
}

@test("inline bounded vectors borrow, mutate, bound, and drop")
pub fn foundation_arrayvec() {
    ARRAYVEC_DROPS = 0u32
    drop_bounded_items()
    expect(ARRAYVEC_DROPS == 3u32, "moved values drop exactly once")

    var items = ArrayVec::<InlineItem, 2>::new()
    expect(items.capacity() == 2u32 && items.is_empty(), "inline capacity")
    expect(items.push(InlineItem { value: 10u32 }).is_ok(), "first push")
    expect(items.push(InlineItem { value: 20u32 }).is_ok(), "second push")
    match items.push(InlineItem { value: 30u32 }) {
        Result::Err(ArrayVecError::Full) => {},
        Result::Ok(_) => expect(false, "capacity bound"),
    }
    match items.get(1u32) {
        Option::Some(item) => expect(item.value == 20u32, "borrowed get"),
        Option::None => expect(false, "missing item"),
    }
    match items.get_mut(0u32) {
        Option::Some(item) => { item.value = 11u32 },
        Option::None => expect(false, "missing mutable item"),
    }
    match items.get(0u32) {
        Option::Some(item) => expect(item.value == 11u32, "mutable get"),
        Option::None => expect(false, "missing updated item"),
    }
    var total = 0u32
    for item in items { total += item.value }
    expect(total == 31u32, "inline iteration")

    var nested = InlineItems { items: ArrayVec::<InlineItem, 2>::new() }
    expect(nested.items.push(InlineItem { value: 12u32 }).is_ok(), "nested first push")
    expect(nested.items.push(InlineItem { value: 30u32 }).is_ok(), "nested second push")
    expect(nested.sum() == 42u32, "borrowed generic field iteration")
}
