// @covers-ndk function|resource.library|RL_DisposeGroup
// @ndk-side-effects Creates and disposes a complete EuroCalc gadget group, then creates and validates a replacement group before disposing every owned resource
@test("resource.library disposes a group without damaging its resource")
pub fn resource_dispose_group() {
    // resource.library ships with ReAction, not with the ROM, so the machine may not
    // have it. The binding is optional: the base stays null instead of aborting startup.
    if !library_available("resource.library", 0) { return }
    let screen = LockPubScreen(null)
    let resource = if screen != null { open_resource(screen) } else { (*u8)null }
    let first = if resource != null { RL_NewGroup(resource, GROUP_ID_MAIN, TAG_DONE) } else { (**u32)null }
    let first_valid = valid_group(first)
    if first != null { RL_DisposeGroup(resource, first) }
    let replacement = if first_valid { RL_NewGroup(resource, GROUP_ID_MAIN, TAG_DONE) } else { (**u32)null }
    let replacement_valid = valid_group(replacement)
    if replacement != null { RL_DisposeGroup(resource, replacement) }
    RL_CloseResource(resource)
    if screen != null { UnlockPubScreen(null, screen) }
    expect(first_valid && replacement_valid, "disposing one group permits a complete fresh group from the same resource")
}

// @covers-ndk function|resource.library|RL_GetObjectArray
// @ndk-side-effects Creates the real EuroCalc window object, obtains its dependent gadget group twice, verifies stable identity and three exact BOOPSI gadget IDs, then disposes the owning object and resource
@test("resource.library retrieves an object's dependent group")
pub fn resource_get_object_array() {
    // resource.library ships with ReAction, not with the ROM, so the machine may not
    // have it. The binding is optional: the base stays null instead of aborting startup.
    if !library_available("resource.library", 0) { return }
    let screen = LockPubScreen(null)
    let resource = if screen != null { open_resource(screen) } else { (*u8)null }
    let object = if resource != null { RL_NewObject(resource, WIN_ID_MAIN, TAG_DONE) } else { (*u32)null }
    let first = if object != null { RL_GetObjectArray(resource, object, GROUP_ID_MAIN) } else { (**u32)null }
    let second = if object != null { RL_GetObjectArray(resource, object, GROUP_ID_MAIN) } else { (**u32)null }
    let valid = first != null && first == second && valid_group(first)
    if object != null { RL_DisposeObject(resource, object) }
    RL_CloseResource(resource)
    if screen != null { UnlockPubScreen(null, screen) }
    expect(valid, "the dependent group is stable and contains the exact generated gadgets")
}

// @covers-ndk function|resource.library|RL_SetResourceScreen
// @ndk-side-effects Opens the real resource without a screen, sets and repeats the public-screen association, creates and validates its real gadget group, clears the association, closes the resource, and unlocks the screen
@test("resource.library sets and clears its screen")
pub fn resource_set_screen() {
    // resource.library ships with ReAction, not with the ROM, so the machine may not
    // have it. The binding is optional: the base stays null instead of aborting startup.
    if !library_available("resource.library", 0) { return }
    let resource = open_resource(null)
    let screen = LockPubScreen(null)
    let set = if resource != null && screen != null { RL_SetResourceScreen(resource, screen) } else { 0 }
    let unchanged = if set != 0 { RL_SetResourceScreen(resource, screen) } else { 0 }
    let group = if unchanged != 0 { RL_NewGroup(resource, GROUP_ID_MAIN, TAG_DONE) } else { (**u32)null }
    let group_valid = valid_group(group)
    if group != null { RL_DisposeGroup(resource, group) }
    let cleared = if resource != null { RL_SetResourceScreen(resource, null) } else { 0 }
    RL_CloseResource(resource)
    if screen != null { UnlockPubScreen(null, screen) }
    expect(set != 0 && unchanged != 0 && group_valid && cleared != 0,
           "the screen association supports allocation, idempotent set, and explicit clear")
}
