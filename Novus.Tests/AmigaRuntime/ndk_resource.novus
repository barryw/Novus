    expect(valid, "varargs construction creates the window object and its exact gadget group")
}

// @covers-ndk function|resource.library|RL_DisposeObject
// @ndk-side-effects Creates and disposes a real EuroCalc window object, then creates a replacement and validates its dependent gadget group before disposing every owned resource
@test("resource.library disposes an object without damaging its resource")
pub fn resource_dispose_object() {
    // resource.library ships with ReAction, not with the ROM, so the machine may not
    // have it. The binding is optional: the base stays null instead of aborting startup.
    if !library_available("resource.library", 0) { return }
    let screen = LockPubScreen(null)
    let resource = if screen != null { open_resource(screen) } else { (*u8)null }
    let first = if resource != null { RL_NewObject(resource, WIN_ID_MAIN, TAG_DONE) } else { (*u32)null }
    if first != null { RL_DisposeObject(resource, first) }
    let replacement = if first != null { RL_NewObject(resource, WIN_ID_MAIN, TAG_DONE) } else { (*u32)null }
    let group = if replacement != null { RL_GetObjectArray(resource, replacement, GROUP_ID_MAIN) } else { (**u32)null }
    let valid = first != null && replacement != null && valid_group(group)
    if replacement != null { RL_DisposeObject(resource, replacement) }
    RL_CloseResource(resource)
    if screen != null { UnlockPubScreen(null, screen) }
    expect(valid, "disposing one object leaves its resource able to construct a complete replacement")
}

