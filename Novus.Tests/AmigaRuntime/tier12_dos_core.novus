// @covers amiga::dos::FileSystem::mount(MountSpec)
// @covers amiga::dos::ApplicationVolume::format(Str, u32)
@test("destructive application filesystem entry points link without touching disks")
pub fn destructive_filesystem_api_map_probe() {
    let _ = FileSystem::mount
    let _ = ApplicationVolume::format
}
