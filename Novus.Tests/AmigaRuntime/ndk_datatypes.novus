    WaitBlit()
    expect(result != 0 && object_pixels(&var fixture) > 0, "varargs draw produces visible picture pixels")
    if fixture.object != null && handle != null { ReleaseDTDrawInfo(fixture.object, handle) }
    close_dt_fixture(&var fixture)
}

// @covers-ndk function|datatypes.library|ReleaseDTDrawInfo
// @ndk-side-effects Releases one real opaque screen-bound ILBM drawing handle through the owning object; the process leak gate verifies all private layout state returns
@test("datatypes.library ReleaseDTDrawInfo releases private layout")
pub fn datatypes_release_draw_info() {
    var fixture = picture_fixture(false)
    let handle = if fixture.object != null { ObtainDTDrawInfoA(fixture.object, null) } else { (*u8)null }
    expect(handle != null, "drawing handle is obtained before release")
    if fixture.object != null && handle != null { ReleaseDTDrawInfo(fixture.object, handle) }
    close_dt_fixture(&var fixture)
}
