from amiga::sys::mui import make_text, make_text_preparse, on_radio, set_attr, set_progress
from amiga::sys::mui import set_str_attr, set_text

static CHOICES: [*u8] = ["One", "Two", "Three", (*u8)0]
static LIST_ENTRIES: [*u8] = ["First", "Second", (*u8)0]
const REQUEST_CONTROL_WORK: u32 = 1 << 17
static var REQUEST_RETURNED: bool = false

fn c_equals(left: *u8, right: *u8) -> bool {
    return false if left == null || right == null
    var index: u32 = 0
    forever {
        let a = unsafe { left[index] }
        let b = unsafe { right[index] }
        return false if a != b
        return true if a == 0
        index++
    }
}

fn activate_request_window() -> bool {
    let screen: *Screen = LockPubScreen(null)
    return false if screen == null
    var found: *Window = null
    var window = screen.FirstWindow
    while window != null {
        if c_equals(window.Title, "Tier12") {
            found = window
            break
        }
        window = window.NextWindow
    }
    UnlockPubScreen(null, screen)
    if found != null { ActivateWindow(found) }
    return found != null
}

@suppress("W0002", "The pinned input command and raw-key class fit their exact ABI fields")
fn inject_escape() -> bool {
    let port = CreateMsgPort()
    if port == null { return false }
    let request = CreateIORequest(port, @sizeof(IOStdReq))
    if request == null {
        DeleteMsgPort(port)
        return false
    }
    let opened = unsafe { OpenDevice("input.device", 0, (*IORequest)request, 0) } == 0
    var event: InputEvent = @zeroed(InputEvent)
    event.ie_Class = (u8)IECLASS_RAWKEY
    event.ie_Code = $45
    let io = (*IOStdReq)request
    io.io_Command = (u16)IND_WRITEEVENT
    io.io_Length = @sizeof(InputEvent)
    io.io_Data = (*u8)&var event
    let down = opened && unsafe { DoIO((*IORequest)request) } == 0
    event.ie_Code = $C5
    let up = down && unsafe { DoIO((*IORequest)request) } == 0
    if opened { unsafe { CloseDevice((*IORequest)request) } }
    DeleteIORequest(request)
    DeleteMsgPort(port)
    return down && up
}

fn request_control_tick(_state: *u8) -> bool {
    for var frame: u32 = 0; frame < 20; frame++ { WaitTOF() }
    for var attempt: u32 = 0; attempt < 100 && !REQUEST_RETURNED; attempt++ {
        let _ = activate_request_window()
        WaitTOF()
        let _ = inject_escape()
        for var frame: u32 = 0; frame < 5; frame++ { WaitTOF() }
    }
    return false
}

fn request_controller() -> i32 {
    return run_thread_loop(REQUEST_CONTROL_WORK, null, request_control_tick)
}

fn build_minimal_tree() {
    var builder = MUIAppBuilder::new("Minimal MUI")
    var window_builder = builder.window("Minimal")
    var root = window_builder.vgroup()
    root.label("Ready")
    window_builder.root(root.build())
    expect(window_builder.build() != null, "minimal window is created")
    let built = builder.build()
    let app_value = match built {
        Result::Ok(app) => app,
        Result::Err(_) => {
            expect(false, "minimal application builds")
            return
        },
    }
    var app = app_value
    expect(app.app_object() != null, "minimal application is created")
    let quit: [u32] = [MUIM_Application_ReturnID, (u32)MUIV_Application_ReturnID_Quit]
    unsafe { DoMethodA((*u32)app.app_object(), &quit[0]) }
    app.run()
}

@test("MUI minimal application tree opens and disposes")
pub fn mui_minimal_tree() {
    build_minimal_tree()
}

