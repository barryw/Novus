// @covers-ndk function|intuition.library|CloseWorkBench
// @ndk-side-effects maps high-risk requester APIs without invoking modal UI in the automated runtime path
@test("intuition requester edge APIs are mapped without runtime UI")
pub fn intuition_requester_api_map_probe() {
    let _ = DisplayAlert
    let _ = TimedDisplayAlert
    let _ = AutoRequest
    let _ = Request
    let _ = BuildSysRequest
    let _ = EndRequest
    let _ = FreeSysRequest
    let _ = EasyRequestArgs
    let _ = EasyRequest
    let _ = BuildEasyRequestArgs
    let _ = BuildEasyRequest
    let _ = SysReqHandler
    let _ = ModifyProp
    let _ = NewModifyProp
    let _ = CloseWorkBench
}
