// @covers-ndk function|workbench.library|AddAppWindowDropZoneA
// @ndk-side-effects Creates a real AppWindow, adds and removes a bounded drop zone, removes the AppWindow, then closes and frees all resources
@test("workbench.library AddAppWindowDropZoneA registers a bounded zone")
pub fn workbench_drop_zone_a() {
    let port = CreateMsgPort()
    let window = open_test_window()
    let app = if port != null && window != null { AddAppWindowA(107, 0, window, port, null) } else { (*AppWindow)null }
    var tags: [TagItem] = [
        TagItem { ti_Tag: WBDZA_Left, ti_Data: 4 },
        TagItem { ti_Tag: WBDZA_Top, ti_Data: 4 },
        TagItem { ti_Tag: WBDZA_Width, ti_Data: 40 },
        TagItem { ti_Tag: WBDZA_Height, ti_Data: 30 },
        TagItem { ti_Tag: TAG_DONE, ti_Data: 0 },
    ]
    let zone = if app != null { AddAppWindowDropZoneA(app, 108, $4E4F565B, &var tags[0]) } else { (*AppWindowDropZone)null }
    let zone_removed = if zone != null { RemoveAppWindowDropZone(app, zone) } else { 0 }
    let app_removed = if app != null { RemoveAppWindow(app) } else { 0 }
    if window != null { CloseWindow(window) }
    if port != null { DeleteMsgPort(port) }
    expect(zone != null && zone_removed != 0 && app_removed != 0, "bounded drop zone and parent registration are removed")
}

