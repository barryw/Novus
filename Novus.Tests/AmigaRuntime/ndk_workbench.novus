// @covers-ndk function|workbench.library|WorkbenchControlA
// @ndk-side-effects Queries the live global default stack size through the A entry point without changing Workbench state
@test("workbench.library WorkbenchControlA queries global state")
pub fn workbench_control_a() {
    var from_a: u32 = 0
    var tags: [TagItem] = [
        TagItem { ti_Tag: WBCTRLA_GetDefaultStackSize, ti_Data: (u32)(*u32)&var from_a },
        TagItem { ti_Tag: TAG_DONE, ti_Data: 0 },
    ]
    let a_ok = WorkbenchControlA(null, &var tags[0])
    expect(a_ok != 0 && from_a >= 4096, "A entry point returns a valid default stack size")
}

