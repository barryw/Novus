// @covers-ndk function|workbench.library|AddAppWindowDropZone
// @ndk-side-effects Exercises the varargs drop-zone entry point on a real AppWindow, removes both registrations, then closes and frees all resources
@test("workbench.library AddAppWindowDropZone varargs registers a bounded zone")
pub fn workbench_drop_zone_varargs() {
    let port = CreateMsgPort()
    let window = open_test_window()
    let app = if port != null && window != null { AddAppWindow(109, 0, window, port, TAG_DONE) } else { (*AppWindow)null }
    let zone = if app != null { AddAppWindowDropZone(app, 110, $4E4F565C, WBDZA_Left, 5, WBDZA_Top, 5, WBDZA_Width, 42, WBDZA_Height, 28, TAG_DONE) } else { (*AppWindowDropZone)null }
    let zone_removed = if zone != null { RemoveAppWindowDropZone(app, zone) } else { 0 }
    let app_removed = if app != null { RemoveAppWindow(app) } else { 0 }
    if window != null { CloseWindow(window) }
    if port != null { DeleteMsgPort(port) }
    expect(zone != null && zone_removed != 0 && app_removed != 0, "varargs bounded drop zone and parent registration are removed")
}

// @covers-ndk function|workbench.library|ChangeWorkbenchSelectionA
// @ndk-side-effects Opens SYS if needed, submits real icons to a stop-without-changing callback, validates the callback message shape, and restores the drawer's original state
@test("workbench.library ChangeWorkbenchSelectionA visits a real icon")
pub fn workbench_selection_a() {
    let name: *u8 = "SYS:"
    let initially_open = query_drawer_open(name)
    let ready = ensure_drawer_open(name)
    SELECTION_CALLBACKS = 0
    SELECTION_MESSAGE_VALID = false
    var hook = make_selection_hook()
    let changed = if ready { ChangeWorkbenchSelectionA(name, &var hook, null) } else { 0 }
    if !initially_open && ready {
        CloseWorkbenchObject(name, TAG_DONE)
        wait_for_drawer(name, false)
    }
    expect(changed != 0 && SELECTION_CALLBACKS == 1 && SELECTION_MESSAGE_VALID, "callback receives one complete real icon message and stops without mutation")
}

// @covers-ndk function|workbench.library|ChangeWorkbenchSelection
// @ndk-side-effects Repeats the real SYS icon callback contract through the varargs entry point without changing selection and restores the drawer's original state
@test("workbench.library ChangeWorkbenchSelection varargs visits a real icon")
pub fn workbench_selection_varargs() {
    let name: *u8 = "SYS:"
    let initially_open = query_drawer_open(name)
    let ready = ensure_drawer_open(name)
    SELECTION_CALLBACKS = 0
    SELECTION_MESSAGE_VALID = false
    var hook = make_selection_hook()
    let changed = if ready { ChangeWorkbenchSelection(name, &var hook, TAG_DONE) } else { 0 }
    if !initially_open && ready {
        CloseWorkbenchObject(name, TAG_DONE)
        wait_for_drawer(name, false)
    }
    expect(changed != 0 && SELECTION_CALLBACKS == 1 && SELECTION_MESSAGE_VALID, "varargs callback receives one complete real icon message and stops without mutation")
}

