// @covers-ndk function|workbench.library|WBInfo
// @ndk-side-effects Locks the real SYS parent, opens the Prefs Information requester, closes it with a real input.device Escape down/up pair from a short-lived Exec task, unlocks SYS, and joins/frees the task
@test("workbench.library WBInfo opens and closes a real requester")
pub fn workbench_info() {
    let lock = Lock("SYS:", SHARED_LOCK)
    WBINFO_ESCAPE_WRITTEN = false
    if lock == 0 {
        expect(false, "SYS parent lock is available")
        return
    }
    var closer = match spawn_thread("WBInfo closer", wbinfo_closer, 4096) {
        Result::Ok(value) => value,
        Result::Err(_) => {
            UnLock(lock)
            expect(false, "requester closer task starts")
            return
        },
    }
    let started = closer.signal(WBINFO_CLOSE_WORK)
    if started { WBInfo(lock, "Prefs", null) }
    closer.wait()
    UnLock(lock)
    expect(started && WBINFO_ESCAPE_WRITTEN, "valid requester returns after input.device delivers Escape down and up")
}
