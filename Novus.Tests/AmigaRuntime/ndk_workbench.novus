from std::core import Result
from std::test::test import expect
from amiga::raw::consts import IECLASS_RAWKEY, IND_WRITEEVENT, ISMACTION_Stop, SHARED_LOCK, TAG_DONE, WA_Activate, WA_AutoAdjust, WA_Height, WA_Left, WA_Top, WA_Width, WBCTRLA_GetDefaultStackSize, WBCTRLA_IsOpen, WBDZA_Height, WBDZA_Left, WBDZA_Top, WBDZA_Width
from amiga::raw::dos import Delay, Lock, UnLock
from amiga::raw::exec import CloseDevice, CreateIORequest, CreateMsgPort, DeleteIORequest, DeleteMsgPort, DoIO, OpenDevice
from amiga::raw::graphics import WaitTOF
from amiga::raw::icon import FreeDiskObject, GetDefDiskObject
from amiga::raw::intuition import CloseWindow, OpenWindowTagList
from amiga::raw::structs import AppIcon, AppMenuItem, AppWindow, AppWindowDropZone, Hook, IconSelectMsg, InputEvent, IORequest, IOStdReq, MinNode, TagItem, Window
from amiga::raw::workbench import AddAppIcon, AddAppIconA, AddAppMenuItem, AddAppMenuItemA, AddAppWindow, AddAppWindowA, AddAppWindowDropZone, AddAppWindowDropZoneA, ChangeWorkbenchSelection, ChangeWorkbenchSelectionA, CloseWorkbenchObject, CloseWorkbenchObjectA, MakeWorkbenchObjectVisible, MakeWorkbenchObjectVisibleA, OpenWorkbenchObject, OpenWorkbenchObjectA, RemoveAppIcon, RemoveAppMenuItem, RemoveAppWindow, RemoveAppWindowDropZone, WBInfo, WorkbenchControl, WorkbenchControlA
from amiga::sys::exec::thread import run_thread_loop, spawn_thread

const WBINFO_CLOSE_WORK: u32 = 1 << 17

static var SELECTION_CALLBACKS: u32 = 0
static var SELECTION_MESSAGE_VALID: bool = false
static var WBINFO_ESCAPE_WRITTEN: bool = false

fn open_test_window() -> *Window {
    var tags: [TagItem] = [
        TagItem { ti_Tag: WA_Left, ti_Data: 24 },
        TagItem { ti_Tag: WA_Top, ti_Data: 24 },
        TagItem { ti_Tag: WA_Width, ti_Data: 180 },
        TagItem { ti_Tag: WA_Height, ti_Data: 70 },
        TagItem { ti_Tag: WA_AutoAdjust, ti_Data: 1 },
        TagItem { ti_Tag: WA_Activate, ti_Data: 1 },
        TagItem { ti_Tag: TAG_DONE, ti_Data: 0 },
    ]
    return OpenWindowTagList(null, &var tags[0])
}

fn settle_display() {
    Delay(50)
}

fn query_drawer_open(name: *u8) -> bool {
    var open: u32 = 0
    var tags: [TagItem] = [
        TagItem { ti_Tag: WBCTRLA_IsOpen, ti_Data: (u32)(*u32)&var open },
        TagItem { ti_Tag: TAG_DONE, ti_Data: 0 },
    ]
    return WorkbenchControlA(name, &var tags[0]) != 0 && open != 0
}

fn wait_for_drawer(name: *u8, expected: bool) -> bool {
    for var attempt: u32 = 0; attempt < 100; attempt++ {
        if query_drawer_open(name) == expected { return true }
        Delay(1)
    }
    return false
}

fn ensure_drawer_open(name: *u8) -> bool {
    return true if query_drawer_open(name)
    return OpenWorkbenchObject(name, TAG_DONE) != 0 && wait_for_drawer(name, true)
}

@suppress("W0002", "The pinned NDK command and event-class constants fit their exact ABI fields")
fn inject_raw_key(code: u16) -> bool {
    let port = CreateMsgPort()
    if port == null { return false }
    let request = CreateIORequest(port, @sizeof(IOStdReq))
    if request == null {
        DeleteMsgPort(port)
        return false
    }
    let opened = unsafe { OpenDevice("input.device", 0, (*IORequest)request, 0) } == 0
    var event: InputEvent = @zeroed(InputEvent)
    event.ie_Class = (u8)IECLASS_RAWKEY
    event.ie_Code = code
    let io = (*IOStdReq)request
    io.io_Command = (u16)IND_WRITEEVENT
    io.io_Length = @sizeof(InputEvent)
    io.io_Data = (*u8)&var event
    let written = opened && unsafe { DoIO((*IORequest)request) } == 0
    if opened { unsafe { CloseDevice((*IORequest)request) } }
    DeleteIORequest(request)
    DeleteMsgPort(port)
    return written
}

fn wbinfo_close_tick(_state: *u8) -> bool {
    for var frame: u32 = 0; frame < 50; frame++ { WaitTOF() }
    let down = inject_raw_key($45)
    let up = inject_raw_key($C5)
    WBINFO_ESCAPE_WRITTEN = down && up
    return false
}

fn wbinfo_closer() -> i32 {
    return run_thread_loop(WBINFO_CLOSE_WORK, null, wbinfo_close_tick)
}

amiga fn selection_hook(_hook: *Hook in a0, _reserved: *u8 in a2, message: *u8 in a1) -> u32 in d0 {
    if message != null {
        let icon = (*IconSelectMsg)message
        SELECTION_CALLBACKS++
        SELECTION_MESSAGE_VALID = icon.ism_Length >= @sizeof(IconSelectMsg) && icon.ism_Name != null && icon.ism_ParentWindow != null
    }
    return ISMACTION_Stop
}

fn make_selection_hook() -> Hook {
    return Hook {
        h_MinNode: MinNode { mln_Succ: null, mln_Pred: null },
        h_Entry: selection_hook,
        h_SubEntry: selection_hook,
        h_Data: null,
    }
}

// @covers-ndk function|workbench.library|AddAppWindowA
// @ndk-side-effects Opens a real Intuition window and message port, registers and removes the AppWindow, then closes and frees every owned resource
@test("workbench.library AddAppWindowA registers a real window")
pub fn workbench_add_window_a() {
    let port = CreateMsgPort()
    let window = open_test_window()
    let app = if port != null && window != null { AddAppWindowA(101, $4E4F5655, window, port, null) } else { (*AppWindow)null }
    let removed = if app != null { RemoveAppWindow(app) } else { 0 }
    if window != null { CloseWindow(window) }
    if port != null { DeleteMsgPort(port) }
    expect(app != null && removed != 0, "real window registration is accepted and removed")
}

// @covers-ndk function|workbench.library|RemoveAppWindow
// @ndk-side-effects Creates a real AppWindow registration as its fixture, removes it through the target call, then closes the window and deletes the message port
@test("workbench.library RemoveAppWindow releases a registration")
pub fn workbench_remove_window() {
    let port = CreateMsgPort()
    let window = open_test_window()
    let app = if port != null && window != null { AddAppWindowA(111, $4E4F565D, window, port, null) } else { (*AppWindow)null }
    let removed = if app != null { RemoveAppWindow(app) } else { 0 }
    if window != null { CloseWindow(window) }
    if port != null { DeleteMsgPort(port) }
    expect(app != null && removed != 0, "owned AppWindow registration is accepted and released")
}

