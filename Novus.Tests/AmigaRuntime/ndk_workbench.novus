// @covers-ndk function|workbench.library|OpenWorkbenchObjectA
// @ndk-side-effects Forces the RAM drawer closed, opens it through the A entry point, verifies asynchronous visible state through WorkbenchControlA, closes it, verifies closure, and restores its original state
@test("workbench.library A entry points open and close a drawer")
pub fn workbench_open_close_a() {
    let name: *u8 = "RAM:"
    let initially_open = query_drawer_open(name)
    if initially_open {
        CloseWorkbenchObjectA(name, null)
        wait_for_drawer(name, false)
    }
    let opened = OpenWorkbenchObjectA(name, null)
    let became_open = opened != 0 && wait_for_drawer(name, true)
    let closed = if became_open { CloseWorkbenchObjectA(name, null) } else { 0 }
    let became_closed = closed != 0 && wait_for_drawer(name, false)
    if initially_open {
        OpenWorkbenchObjectA(name, null)
        wait_for_drawer(name, true)
    }
    expect(became_open && became_closed, "RAM drawer reaches both requested asynchronous states")
}

// @covers-ndk function|workbench.library|CloseWorkbenchObjectA
// @ndk-side-effects Opens the RAM drawer as a fixture, closes it through the A entry point, verifies the asynchronous closed state, and restores the original state
@test("workbench.library CloseWorkbenchObjectA closes a drawer")
pub fn workbench_close_a() {
    let name: *u8 = "RAM:"
    let initially_open = query_drawer_open(name)
    let ready = ensure_drawer_open(name)
    let closed = if ready { CloseWorkbenchObjectA(name, null) } else { 0 }
    let became_closed = closed != 0 && wait_for_drawer(name, false)
    if initially_open {
        OpenWorkbenchObjectA(name, null)
        wait_for_drawer(name, true)
    }
    expect(ready && became_closed, "A entry point drives the open RAM drawer to closed state")
}

// @covers-ndk function|workbench.library|OpenWorkbenchObject
// @ndk-side-effects Repeats a complete RAM drawer open/close lifecycle through both varargs entry points, verifies asynchronous state, and restores the original state
@test("workbench.library varargs entry points open and close a drawer")
pub fn workbench_open_close_varargs() {
    let name: *u8 = "RAM:"
    let initially_open = query_drawer_open(name)
    if initially_open {
        CloseWorkbenchObject(name, TAG_DONE)
        wait_for_drawer(name, false)
    }
    let opened = OpenWorkbenchObject(name, TAG_DONE)
    let became_open = opened != 0 && wait_for_drawer(name, true)
    let closed = if became_open { CloseWorkbenchObject(name, TAG_DONE) } else { 0 }
    let became_closed = closed != 0 && wait_for_drawer(name, false)
    if initially_open {
        OpenWorkbenchObject(name, TAG_DONE)
        wait_for_drawer(name, true)
    }
    expect(became_open && became_closed, "varargs RAM drawer lifecycle reaches both requested states")
}

