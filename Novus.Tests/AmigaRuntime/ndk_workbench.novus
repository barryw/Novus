// @covers-ndk function|workbench.library|AddAppIconA
// @ndk-side-effects Allocates a valid icon.library default tool icon and message port, adds and removes an AppIcon, frees both caller-owned resources, and waits for asynchronous Workbench teardown
@test("workbench.library AddAppIconA registers a valid icon")
pub fn workbench_add_icon_a() {
    let port = CreateMsgPort()
    let icon = GetDefDiskObject(3)
    let app = if port != null && icon != null { AddAppIconA(103, $4E4F5657, "Novus A", port, 0, icon, null) } else { (*AppIcon)null }
    let removed = if app != null { RemoveAppIcon(app) } else { 0 }
    if icon != null { FreeDiskObject(icon) }
    if port != null { DeleteMsgPort(port) }
    settle_display()
    expect(app != null && removed != 0, "valid default icon is displayed and removed")
}

