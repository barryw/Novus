Novus/Parser/Novus.interp
Novus/Parser/Novus.tokens
Novus/Parser/NovusLexer.interp
Novus/Parser/NovusLexer.tokens

# Python migration scripts (one-time use)
migrate_array_syntax.py

# Build outputs
bin/
obj/
*.dll
*.exe
*.pdb

# IDE files
.vs/
.vscode/
.idea/
*.user
*.suo

# OS files
.DS_Store
Thumbs.db
__pycache__/

# Test outputs
TestResults/
/_test_runner.novus
/tests
/tests.novus-build
/tests.novus-link

# Compiled object files and C sources (build artifacts)
*.o
*.c
!runtime/**/*.c
!Novus/runtime/**/*.c
!vendor/vbcc/**/*.c
!Novus.Tests/Examples/idiomatic_gui.c
!Novus.Tests/Examples/homepage_example.c
# Amiga-side tools are hand-written C sources, not generated build artifacts
!tools/amiga/*.c
*.out
a.out
novus_types.h

# Build directories
build/
target/
usercache/

# Test files in root only (keep test files in Novus.Tests/)
/test.novus
/test_*.novus
*.trx

# Vendored VBCC binaries (source is tracked)
vendor/vbcc/bin/
vendor/vbcc/**/*.o
vendor/vbcc/**/*.a
vendor/vbcc/bin/.build_complete

# Novus compilation cache
.novus-cache/

# Linker map files
*.map

# Release artifacts (built by scripts/release.sh)
release/

# Published binaries
publish/
publish-*/

# Compiled Amiga-side test tools (rebuild with tools/amiga/README.md)
tools/amiga/wrun
