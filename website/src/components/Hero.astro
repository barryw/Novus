---
// Hero component for Novus language homepage
---

<section class="relative overflow-hidden bg-gradient-to-br from-novus-gray-900 via-novus-gray-800 to-novus-gray-900">
  <!-- Boing Ball Stripe Pattern -->
  <div class="absolute inset-0 opacity-5" style="background-image: repeating-linear-gradient(45deg, transparent, transparent 20px, var(--color-novus-red-500) 20px, var(--color-novus-red-500) 40px, white 40px, white 60px);"></div>

  <div class="relative mx-auto max-w-7xl px-6 py-24 sm:py-32 lg:px-8 lg:py-40">
    <div class="mx-auto max-w-3xl text-center">
      <!-- Headline -->
      <h1 class="text-5xl font-bold tracking-tight text-white sm:text-7xl">
        New code for <span class="text-novus-red-500">classic machines</span>
      </h1>

      <!-- Subhead -->
      <p class="mt-6 text-xl leading-8 text-novus-gray-300 sm:text-2xl">
        A modern systems programming language for the Amiga 68k
      </p>

      <!-- CTAs -->
      <div class="mt-10 flex items-center justify-center gap-x-6">
        <a
          href="/getting-started/introduction"
          class="rounded-lg bg-novus-red-500 px-6 py-3 text-base font-semibold text-white shadow-lg hover:bg-novus-red-600 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-novus-red-500 transition-colors"
        >
          Get Started
        </a>
        <a
          href="#features"
          class="rounded-lg border border-novus-gray-600 bg-transparent px-6 py-3 text-base font-semibold text-white hover:bg-novus-gray-800 transition-colors"
        >
          Learn More
        </a>
      </div>

      <!-- Quick info badges -->
      <div class="mt-12 flex flex-wrap items-center justify-center gap-4 text-sm text-novus-gray-400">
        <div class="flex items-center gap-2">
          <svg class="h-5 w-5 text-novus-red-500" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.06 1.061l2.5 2.5a.75.75 0 001.137-.089l4-5.5z" clip-rule="evenodd" />
          </svg>
          <span>68k Native</span>
        </div>
        <div class="flex items-center gap-2">
          <svg class="h-5 w-5 text-novus-red-500" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.06 1.061l2.5 2.5a.75.75 0 001.137-.089l4-5.5z" clip-rule="evenodd" />
          </svg>
          <span>No GC</span>
        </div>
        <div class="flex items-center gap-2">
          <svg class="h-5 w-5 text-novus-red-500" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.06 1.061l2.5 2.5a.75.75 0 001.137-.089l4-5.5z" clip-rule="evenodd" />
          </svg>
          <span>Safe by Default</span>
        </div>
      </div>
    </div>
  </div>
</section>
