---
// Footer component for Novus language website
const currentYear = new Date().getFullYear();
---

<footer class="bg-novus-gray-900 border-t border-novus-gray-800">
  <div class="mx-auto max-w-7xl px-6 py-12 lg:px-8">
    <div class="grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-4">
      <!-- Brand Column -->
      <div>
        <div class="flex items-center gap-2">
          <div class="h-8 w-8 rounded-lg bg-gradient-to-br from-novus-red-500 to-novus-red-700 flex items-center justify-center">
            <span class="text-white font-bold text-lg">N</span>
          </div>
          <span class="text-xl font-bold text-white">Novus</span>
        </div>
        <p class="mt-4 text-sm text-novus-gray-400">
          New code for classic machines. A modern systems programming language for the Amiga 68k.
        </p>
        <div class="mt-4 flex gap-4">
          <a href="https://github.com/barryw/novus" class="text-novus-gray-400 hover:text-novus-red-500 transition-colors" aria-label="GitHub">
            <svg class="h-6 w-6" fill="currentColor" viewBox="0 0 24 24">
              <path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd" />
            </svg>
          </a>
        </div>
      </div>

      <!-- Learn Column -->
      <div>
        <h3 class="text-sm font-semibold text-white">Learn</h3>
        <ul class="mt-4 space-y-3">
          <li>
            <a href="/getting-started/introduction" class="text-sm text-novus-gray-400 hover:text-novus-red-500 transition-colors">
              Introduction
            </a>
          </li>
          <li>
            <a href="/getting-started/installation" class="text-sm text-novus-gray-400 hover:text-novus-red-500 transition-colors">
              Installation
            </a>
          </li>
          <li>
            <a href="/getting-started/first-program" class="text-sm text-novus-gray-400 hover:text-novus-red-500 transition-colors">
              First Program
            </a>
          </li>
          <li>
            <a href="/guide/variables-types" class="text-sm text-novus-gray-400 hover:text-novus-red-500 transition-colors">
              Language Guide
            </a>
          </li>
        </ul>
      </div>

      <!-- Community Column -->
      <div>
        <h3 class="text-sm font-semibold text-white">Community</h3>
        <ul class="mt-4 space-y-3">
          <li>
            <a href="https://github.com/barryw/novus" class="text-sm text-novus-gray-400 hover:text-novus-red-500 transition-colors">
              GitHub
            </a>
          </li>
          <li>
            <a href="https://github.com/barryw/novus/issues" class="text-sm text-novus-gray-400 hover:text-novus-red-500 transition-colors">
              Issues
            </a>
          </li>
          <li>
            <a href="https://github.com/barryw/novus/discussions" class="text-sm text-novus-gray-400 hover:text-novus-red-500 transition-colors">
              Discussions
            </a>
          </li>
          <li>
            <a href="https://github.com/barryw/novus/blob/main/CONTRIBUTING.md" class="text-sm text-novus-gray-400 hover:text-novus-red-500 transition-colors">
              Contributing
            </a>
          </li>
        </ul>
      </div>

      <!-- Resources Column -->
      <div>
        <h3 class="text-sm font-semibold text-white">Resources</h3>
        <ul class="mt-4 space-y-3">
          <li>
            <a href="/blog" class="text-sm text-novus-gray-400 hover:text-novus-red-500 transition-colors">
              Blog
            </a>
          </li>
          <li>
            <a href="/reference/cli" class="text-sm text-novus-gray-400 hover:text-novus-red-500 transition-colors">
              CLI Reference
            </a>
          </li>
          <li>
            <a href="/reference/language" class="text-sm text-novus-gray-400 hover:text-novus-red-500 transition-colors">
              Language Reference
            </a>
          </li>
          <li>
            <a href="https://github.com/barryw/novus/tree/main/examples" class="text-sm text-novus-gray-400 hover:text-novus-red-500 transition-colors">
              Examples
            </a>
          </li>
          <li>
            <a href="https://github.com/barryw/novus/releases" class="text-sm text-novus-gray-400 hover:text-novus-red-500 transition-colors">
              Releases
            </a>
          </li>
        </ul>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="mt-12 border-t border-novus-gray-800 pt-8">
      <div class="flex flex-col items-center justify-between gap-4 sm:flex-row">
        <p class="text-sm text-novus-gray-400">
          &copy; {currentYear} Novus Language Project. Open source under MIT License.
        </p>
        <div class="flex gap-6">
          <a href="https://github.com/barryw/novus/blob/main/LICENSE" class="text-sm text-novus-gray-400 hover:text-novus-red-500 transition-colors">
            License
          </a>
          <a href="https://github.com/barryw/novus/blob/main/CODE_OF_CONDUCT.md" class="text-sm text-novus-gray-400 hover:text-novus-red-500 transition-colors">
            Code of Conduct
          </a>
        </div>
      </div>
    </div>
  </div>
</footer>
