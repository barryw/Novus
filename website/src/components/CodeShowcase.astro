---
// Code showcase component showing Novus code and generated assembly
---

<section class="bg-novus-gray-900 py-24 sm:py-32">
  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    <div class="mx-auto max-w-2xl text-center">
      <h2 class="text-3xl font-bold tracking-tight text-white sm:text-4xl">
        Modern code. Efficient assembly.
      </h2>
      <p class="mt-4 text-lg text-novus-gray-400">
        Write clean, safe code that compiles to optimal 68k assembly
      </p>
    </div>

    <div class="mt-16 grid grid-cols-1 gap-8 lg:grid-cols-2">
      <!-- Novus Code -->
      <div class="group relative overflow-hidden rounded-lg border border-novus-gray-700 bg-novus-gray-800 shadow-xl">
        <!-- Terminal Chrome -->
        <div class="flex items-center gap-2 border-b border-novus-gray-700 bg-novus-gray-800 px-4 py-3">
          <div class="flex gap-1.5">
            <div class="h-3 w-3 rounded-full bg-novus-red-500"></div>
            <div class="h-3 w-3 rounded-full bg-yellow-500"></div>
            <div class="h-3 w-3 rounded-full bg-green-500"></div>
          </div>
          <div class="ml-2 text-sm text-novus-gray-400 font-mono">screen.novus</div>
        </div>

        <!-- Code Content -->
        <div class="overflow-x-auto bg-novus-gray-900 p-6">
          <pre class="text-sm leading-relaxed"><code><span class="text-novus-red-400">fn</span> <span class="text-yellow-400">open_screen</span><span class="text-novus-gray-400">(</span><span class="text-novus-gray-300">width</span><span class="text-novus-gray-400">:</span> <span class="text-green-400">u16</span><span class="text-novus-gray-400">,</span> <span class="text-novus-gray-300">height</span><span class="text-novus-gray-400">:</span> <span class="text-green-400">u16</span><span class="text-novus-gray-400">)</span>
    <span class="text-novus-gray-400">-></span> <span class="text-green-400">Result</span><span class="text-novus-gray-400">[</span><span class="text-green-400">ScreenHandle</span><span class="text-novus-gray-400">,</span> <span class="text-green-400">IntuitionError</span><span class="text-novus-gray-400">]</span> <span class="text-novus-gray-400">{</span>
    <span class="text-purple-400">let</span> <span class="text-novus-gray-300">tags</span> <span class="text-novus-gray-400">=</span> <span class="text-novus-gray-400">[</span>
        <span class="text-yellow-400">SA_Width</span><span class="text-novus-gray-400">(</span>width<span class="text-novus-gray-400">),</span>
        <span class="text-yellow-400">SA_Height</span><span class="text-novus-gray-400">(</span>height<span class="text-novus-gray-400">),</span>
        <span class="text-yellow-400">SA_Depth</span><span class="text-novus-gray-400">(</span><span class="text-blue-400">5</span><span class="text-novus-gray-400">),</span>
        <span class="text-yellow-400">SA_AutoScroll</span><span class="text-novus-gray-400">(</span><span class="text-purple-400">true</span><span class="text-novus-gray-400">),</span>
    <span class="text-novus-gray-400">];</span>

    <span class="text-purple-400">unsafe</span> <span class="text-novus-gray-400">{</span>
        <span class="text-purple-400">let</span> <span class="text-novus-gray-300">screen_ptr</span> <span class="text-novus-gray-400">=</span> <span class="text-yellow-400">OpenScreenTagList</span><span class="text-novus-gray-400">(</span>
            <span class="text-purple-400">null</span><span class="text-novus-gray-400">,</span>
            <span class="text-novus-gray-400">&amp;</span>tags<span class="text-novus-gray-400">.</span><span class="text-yellow-400">as_tag_list</span><span class="text-novus-gray-400">()</span>
        <span class="text-novus-gray-400">);</span>

        <span class="text-purple-400">match</span> <span class="text-novus-gray-300">screen_ptr</span> <span class="text-novus-gray-400">{</span>
            <span class="text-yellow-400">Some</span><span class="text-novus-gray-400">(</span>ptr<span class="text-novus-gray-400">)</span> <span class="text-novus-gray-400">=></span> <span class="text-yellow-400">Ok</span><span class="text-novus-gray-400">(</span><span class="text-yellow-400">ScreenHandle</span><span class="text-novus-gray-400">::</span><span class="text-yellow-400">new</span><span class="text-novus-gray-400">(</span>ptr<span class="text-novus-gray-400">)),</span>
            <span class="text-yellow-400">None</span> <span class="text-novus-gray-400">=></span> <span class="text-yellow-400">Err</span><span class="text-novus-gray-400">(</span><span class="text-green-400">IntuitionError</span><span class="text-novus-gray-400">::</span><span class="text-yellow-400">ScreenOpenFailed</span><span class="text-novus-gray-400">),</span>
        <span class="text-novus-gray-400">}</span>
    <span class="text-novus-gray-400">}</span>
<span class="text-novus-gray-400">}</span></code></pre>
        </div>
      </div>

      <!-- Generated Assembly -->
      <div class="group relative overflow-hidden rounded-lg border border-novus-gray-700 bg-novus-gray-800 shadow-xl">
        <!-- Terminal Chrome -->
        <div class="flex items-center gap-2 border-b border-novus-gray-700 bg-novus-gray-800 px-4 py-3">
          <div class="flex gap-1.5">
            <div class="h-3 w-3 rounded-full bg-novus-red-500"></div>
            <div class="h-3 w-3 rounded-full bg-yellow-500"></div>
            <div class="h-3 w-3 rounded-full bg-green-500"></div>
          </div>
          <div class="ml-2 text-sm text-novus-gray-400 font-mono">screen.s (68020)</div>
        </div>

        <!-- Code Content -->
        <div class="overflow-x-auto bg-novus-gray-900 p-6">
          <pre class="text-sm leading-relaxed"><code><span class="text-novus-gray-500">; Function: open_screen</span>
<span class="text-novus-gray-500">; Args: d0=width, d1=height</span>
<span class="text-novus-gray-500">; Returns: d0=Result</span>
<span class="text-yellow-400">_open_screen:</span>
    <span class="text-green-400">movem.l</span>    <span class="text-blue-400">d2-d7/a2-a6</span><span class="text-novus-gray-400">,-(</span><span class="text-blue-400">sp</span><span class="text-novus-gray-400">)</span>
    <span class="text-green-400">move.w</span>     <span class="text-blue-400">d0</span><span class="text-novus-gray-400">,</span><span class="text-blue-400">d2</span>            <span class="text-novus-gray-500">; Save width</span>
    <span class="text-green-400">move.w</span>     <span class="text-blue-400">d1</span><span class="text-novus-gray-400">,</span><span class="text-blue-400">d3</span>            <span class="text-novus-gray-500">; Save height</span>

    <span class="text-novus-gray-500">; Build tag list on stack</span>
    <span class="text-green-400">pea</span>        <span class="text-purple-400">TAG_DONE</span>
    <span class="text-green-400">move.l</span>     <span class="text-purple-400">#1</span><span class="text-novus-gray-400">,-(</span><span class="text-blue-400">sp</span><span class="text-novus-gray-400">)</span>       <span class="text-novus-gray-500">; AutoScroll=true</span>
    <span class="text-green-400">pea</span>        <span class="text-purple-400">SA_AutoScroll</span>
    <span class="text-green-400">move.l</span>     <span class="text-purple-400">#5</span><span class="text-novus-gray-400">,-(</span><span class="text-blue-400">sp</span><span class="text-novus-gray-400">)</span>       <span class="text-novus-gray-500">; Depth=5</span>
    <span class="text-green-400">pea</span>        <span class="text-purple-400">SA_Depth</span>
    <span class="text-green-400">move.l</span>     <span class="text-blue-400">d3</span><span class="text-novus-gray-400">,-(</span><span class="text-blue-400">sp</span><span class="text-novus-gray-400">)</span>        <span class="text-novus-gray-500">; Height</span>
    <span class="text-green-400">pea</span>        <span class="text-purple-400">SA_Height</span>
    <span class="text-green-400">move.l</span>     <span class="text-blue-400">d2</span><span class="text-novus-gray-400">,-(</span><span class="text-blue-400">sp</span><span class="text-novus-gray-400">)</span>        <span class="text-novus-gray-500">; Width</span>
    <span class="text-green-400">pea</span>        <span class="text-purple-400">SA_Width</span>

    <span class="text-novus-gray-500">; Call OpenScreenTagList</span>
    <span class="text-green-400">move.l</span>     <span class="text-blue-400">sp</span><span class="text-novus-gray-400">,</span><span class="text-blue-400">a0</span>          <span class="text-novus-gray-500">; Tag list</span>
    <span class="text-green-400">suba.l</span>     <span class="text-blue-400">a1</span><span class="text-novus-gray-400">,</span><span class="text-blue-400">a1</span>          <span class="text-novus-gray-500">; NewScreen=null</span>
    <span class="text-green-400">move.l</span>     <span class="text-yellow-400">_IntuitionBase</span><span class="text-novus-gray-400">,</span><span class="text-blue-400">a6</span>
    <span class="text-green-400">jsr</span>        <span class="text-purple-400">-606</span><span class="text-novus-gray-400">(</span><span class="text-blue-400">a6</span><span class="text-novus-gray-400">)</span>      <span class="text-novus-gray-500">; LVO OpenScreenTagList</span>

    <span class="text-green-400">lea</span>        <span class="text-purple-400">40</span><span class="text-novus-gray-400">(</span><span class="text-blue-400">sp</span><span class="text-novus-gray-400">),</span><span class="text-blue-400">sp</span>      <span class="text-novus-gray-500">; Clean up stack</span>
    <span class="text-green-400">tst.l</span>      <span class="text-blue-400">d0</span>
    <span class="text-green-400">beq.s</span>      <span class="text-yellow-400">.error</span>

<span class="text-yellow-400">.success:</span>
    <span class="text-novus-gray-500">; Return Ok(handle)</span>
    <span class="text-green-400">moveq</span>      <span class="text-purple-400">#0</span><span class="text-novus-gray-400">,</span><span class="text-blue-400">d1</span>          <span class="text-novus-gray-500">; Result tag = Ok</span>
    <span class="text-green-400">bra.s</span>      <span class="text-yellow-400">.return</span>

<span class="text-yellow-400">.error:</span>
    <span class="text-novus-gray-500">; Return Err(ScreenOpenFailed)</span>
    <span class="text-green-400">moveq</span>      <span class="text-purple-400">#1</span><span class="text-novus-gray-400">,</span><span class="text-blue-400">d1</span>          <span class="text-novus-gray-500">; Result tag = Err</span>
    <span class="text-green-400">moveq</span>      <span class="text-purple-400">#2</span><span class="text-novus-gray-400">,</span><span class="text-blue-400">d0</span>          <span class="text-novus-gray-500">; Error code</span>

<span class="text-yellow-400">.return:</span>
    <span class="text-green-400">movem.l</span>    <span class="text-novus-gray-400">(</span><span class="text-blue-400">sp</span><span class="text-novus-gray-400">)+,</span><span class="text-blue-400">d2-d7/a2-a6</span>
    <span class="text-green-400">rts</span></code></pre>
        </div>
      </div>
    </div>

    <!-- Feature callouts -->
    <div class="mt-12 grid grid-cols-1 gap-6 sm:grid-cols-3">
      <div class="rounded-lg border border-novus-gray-700 bg-novus-gray-800 p-6">
        <h3 class="text-lg font-semibold text-white">Type Safety</h3>
        <p class="mt-2 text-sm text-novus-gray-400">
          Result types ensure errors are handled. No null pointer crashes.
        </p>
      </div>
      <div class="rounded-lg border border-novus-gray-700 bg-novus-gray-800 p-6">
        <h3 class="text-lg font-semibold text-white">Efficient Code</h3>
        <p class="mt-2 text-sm text-novus-gray-400">
          Compiles to clean, readable 68k assembly with proper calling conventions.
        </p>
      </div>
      <div class="rounded-lg border border-novus-gray-700 bg-novus-gray-800 p-6">
        <h3 class="text-lg font-semibold text-white">AmigaOS Ready</h3>
        <p class="mt-2 text-sm text-novus-gray-400">
          Direct library calls with safe wrappers. Full HUNK format support.
        </p>
      </div>
    </div>
  </div>
</section>
