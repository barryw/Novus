---
import { Code } from 'astro:components';
import novusSource from '../../../Novus.Tests/Examples/homepage_example.novus?raw';
import cSource from '../../../Novus.Tests/Examples/homepage_example.c?raw';
import novusGrammar from '../../../vscode-novus/syntaxes/novus.tmLanguage.json';

// Binary sizes and assembly excerpts measured from 68020 VBCC release builds on 2026-08-10.

const fromFirstLine = (source: string, firstLine: string) =>
  source.slice(source.indexOf(firstLine)).trim();

const examples = [
  {
    language: 'Novus',
    filename: 'homepage_example.novus',
    size: '1,820 bytes',
    note: 'Result-based errors + automatic screen cleanup',
    source: fromFirstLine(novusSource, 'from '),
    codeLanguage: novusGrammar,
    assembly: `move.l  (-16,a5),d0
beq     l3788
moveq   #1,d1
cmp.l   d0,d1
beq     l3804
bra     l3813
l3788
move.l  (-12,a5),(-32,a5)
move.l  #0,(-12,a5)
move.l  (-32,a5),(-20,a5)
lea     (-20,a5),a0
move.l  a0,-(a7)
jsr     _ScreenHandle_rastport
move.l  d0,a2
move.l  _GfxBase,a6
move.l  a2,a1
moveq   #2,d0
jsr     -342(a6)
move.l  _GfxBase,a6
move.l  a2,a1
moveq   #10,d0
moveq   #20,d1
moveq   #100,d2
moveq   #80,d3
jsr     -306(a6)
move.l  _DOSBase,a6
move.l  #150,d1
jsr     -198(a6)
lea     (-20,a5),a0
move.l  a0,-(a7)
jsr     _ScreenHandle_Drop_drop
moveq   #0,d0`,
  },
  {
    language: 'C',
    filename: 'homepage_example.c',
    size: '1,620 bytes',
    note: 'Manual error paths + manual library/screen cleanup',
    source: fromFirstLine(cSource, '#include '),
    codeLanguage: 'c',
    assembly: `move.l  d0,d4
add.w   #52,a7
beq     l8
move.l  d4,a2
add.l   #84,a2
move.l  _GfxBase,a6
move.l  a2,a1
moveq   #2,d0
jsr     -342(a6)
move.l  _GfxBase,a6
move.l  a2,a1
moveq   #10,d0
moveq   #20,d1
moveq   #100,d2
moveq   #80,d3
jsr     -306(a6)
move.l  _DOSBase,a6
move.l  #150,d1
jsr     -198(a6)
moveq   #0,d5
l8
tst.l   d4
beq     l19
move.l  _IntuitionBase,a6
move.l  d4,a0
jsr     -66(a6)
l19
tst.l   _IntuitionBase
beq     l21
move.l  _IntuitionBase,a1
move.l  _SysBase,a6
jsr     -414(a6)`,
  },
].map((example) => ({
  ...example,
  lines: example.source.split('\n').length,
}));
---

<section class="bg-novus-gray-900 py-24 sm:py-32" aria-labelledby="screen-comparison-title">
  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    <div class="mx-auto max-w-3xl text-center">
      <p class="text-sm font-semibold uppercase tracking-[0.2em] text-novus-red-400">
        Measured on AmigaOS
      </p>
      <h2 id="screen-comparison-title" class="mt-3 text-3xl font-bold tracking-tight text-white sm:text-4xl">
        Same screen. Just 200 bytes apart.
      </h2>
      <p class="mt-5 text-lg leading-8 text-novus-gray-300">
        Both programs detect PAL or NTSC, open the same 5-bitplane custom screen,
        draw the same rectangle, wait, and clean up. Novus makes the failure and
        lifetime paths explicit in the type system instead of scattering them through the program.
      </p>
    </div>

    <dl class="mx-auto mt-10 grid max-w-3xl grid-cols-1 overflow-hidden rounded-xl border border-novus-gray-700 bg-novus-gray-800 text-center sm:grid-cols-3">
      <div class="p-5">
        <dt class="text-sm text-novus-gray-300">C executable</dt>
        <dd class="mt-1 font-mono text-2xl font-bold text-white">1,620 B</dd>
      </div>
      <div class="border-y border-novus-gray-700 p-5 sm:border-x sm:border-y-0">
        <dt class="text-sm text-novus-gray-300">Safety premium</dt>
        <dd class="mt-1 font-mono text-2xl font-bold text-novus-red-400">+200 B</dd>
      </div>
      <div class="p-5">
        <dt class="text-sm text-novus-gray-300">Novus executable</dt>
        <dd class="mt-1 font-mono text-2xl font-bold text-white">1,820 B</dd>
      </div>
    </dl>

    <p class="mt-4 text-center text-sm text-novus-gray-400">
      Release builds for 68020, optimized for size with VBCC. Both passed on an A4000/040 test machine.
    </p>

    <div class="mt-12 grid grid-cols-1 items-start gap-8 lg:grid-cols-2">
      {examples.map((example) => (
        <article class="min-w-0 overflow-hidden rounded-xl border border-novus-gray-700 bg-novus-gray-800 shadow-xl">
          <header class="flex flex-wrap items-center justify-between gap-3 border-b border-novus-gray-700 px-5 py-4">
            <div>
              <p class="font-mono text-sm text-white">{example.filename}</p>
              <p class="mt-1 text-xs text-novus-gray-400">{example.lines} lines · {example.note}</p>
            </div>
            <span class="rounded-full bg-novus-red-500/15 px-3 py-1 font-mono text-sm font-semibold text-novus-red-300">
              {example.size}
            </span>
          </header>

          <fieldset class="code-view">
            <legend class="sr-only">Choose the {example.language} source or generated assembly</legend>
            <input class="view-radio view-source sr-only" type="radio" name={`${example.language.toLowerCase()}-view`} id={`${example.language.toLowerCase()}-source`} checked />
            <input class="view-radio view-assembly sr-only" type="radio" name={`${example.language.toLowerCase()}-view`} id={`${example.language.toLowerCase()}-assembly`} />

            <div class="view-tabs flex border-b border-novus-gray-700 bg-novus-gray-900/50 p-1" role="presentation">
              <label class="source-tab flex-1 cursor-pointer rounded-md px-4 py-2 text-center text-sm font-medium text-novus-gray-300" for={`${example.language.toLowerCase()}-source`}>
                {example.language}
              </label>
              <label class="assembly-tab flex-1 cursor-pointer rounded-md px-4 py-2 text-center text-sm font-medium text-novus-gray-300" for={`${example.language.toLowerCase()}-assembly`}>
                68020 assembly
              </label>
            </div>

            <div class="code-panels">
              <div class="code-panel source-panel">
                <Code code={example.source} lang={example.codeLanguage} theme="github-dark" class="highlighted-code" tabindex="0" aria-label={`${example.language} source code`} />
              </div>
              <div class="code-panel assembly-panel">
                <Code code={example.assembly} lang="asm" theme="github-dark" class="highlighted-code" tabindex="0" aria-label={`${example.language} generated 68020 assembly`} />
              </div>
            </div>
          </fieldset>
        </article>
      ))}
    </div>

    <div class="mt-12 text-center">
      <p class="text-base text-novus-gray-300">
        The C version spends its clarity budget on bookkeeping. Novus spends 200 bytes on making that bookkeeping reliable.
      </p>
      <a href="/getting-started/introduction" class="mt-6 inline-flex rounded-lg bg-novus-red-600 px-5 py-3 font-semibold text-white transition-colors hover:bg-novus-red-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white">
        Build your first Novus program
      </a>
    </div>
  </div>
</section>

<style>
  .assembly-panel {
    display: none;
  }

  .view-source:checked ~ .view-tabs .source-tab,
  .view-assembly:checked ~ .view-tabs .assembly-tab {
    background: rgb(55 65 81);
    color: white;
  }

  .view-source:focus-visible ~ .view-tabs .source-tab,
  .view-assembly:focus-visible ~ .view-tabs .assembly-tab {
    outline: 2px solid rgb(248 113 113);
    outline-offset: -2px;
  }

  .view-assembly:checked ~ .code-panels .source-panel {
    display: none;
  }

  .view-assembly:checked ~ .code-panels .assembly-panel {
    display: block;
  }

  :global(.highlighted-code) {
    height: 36rem;
    margin: 0;
    overflow: auto;
    border-radius: 0;
    padding: 1.25rem;
    font-size: 0.8rem;
    line-height: 1.625;
  }
</style>
