// Example showcasing pattern matching on generic enums
// Demonstrates how generic impl block methods work internally

from std::core import Option, Result

// Custom generic enum with impl block methods
pub enum Maybe<T> {
    Just(T),
    Nothing,
}

impl<T> Maybe<T> {
    pub fn has_value(self) -> bool {
        match self {
            Just(_) => return true,
            Nothing => return false
        }
    }

    pub fn get_or(self, default: T) -> T {
        match self {
            Just(val) => return val,
            Nothing => return default
        }
    }
}

fn try_operation(success: bool) -> Maybe<i32> {
    if success {
        return Maybe::Just(123)
    }
    return Maybe::Nothing
}

fn main() -> i32 {
    // Using custom Maybe<T> enum
    let maybe1: Maybe<i32> = try_operation(true)

    if maybe1.has_value() {
        let result: i32 = maybe1.get_or(0)
        // result is 123
        return result
    }

    let maybe2: Maybe<i32> = try_operation(false)
    let fallback: i32 = maybe2.get_or(456)

    return fallback  // Returns 456
}
