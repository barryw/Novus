// Example: Exposing Novus functions to C
// This demonstrates the #[export] attribute for C interop

#[export]
pub fn add(a: i32, b: i32) -> i32 {
    return a + b
}

#[export]
pub fn subtract(a: i32, b: i32) -> i32 {
    return a - b
}

#[export]
pub fn multiply(a: i32, b: i32) -> i32 {
    return a * b
}

#[export]
pub fn divide(a: i32, b: i32) -> i32 {
    if b == 0 {
        return 0
    }
    return a / b
}

// This function is NOT exported - it's internal to Novus
fn internal_helper() -> i32 {
    return 42
}

// Novus can still use its own exported functions
fn main() -> i32 {
    var result: i32 = add(10, 20)
    result = multiply(result, 2)
    return result  // 60
}
