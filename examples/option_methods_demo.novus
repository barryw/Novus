// Example demonstrating Option<T> methods
// Shows pattern matching on generic enums in impl blocks

from std::core import Option

fn divide(a: i32, b: i32) -> Option<i32> {
    if b == 0 {
        return Option::None
    }
    return Option::Some(a / b)
}

fn main() -> i32 {
    // Test with successful division
    let result1: Option<i32> = divide(100, 5)

    if result1.is_some() {
        let value: i32 = result1.unwrap_or(0)
        // value is 20
    }

    // Test with division by zero
    let result2: Option<i32> = divide(100, 0)

    if result2.is_none() {
        // This will execute
        let fallback: i32 = result2.unwrap_or(999)
        // fallback is 999
        return fallback
    }

    return 0
}
