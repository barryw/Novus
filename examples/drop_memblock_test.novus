// Test Drop trait for MemoryBlock
// Memory should be automatically freed when blocks go out of scope

from std::mem import MemoryBlock, MEMF_FAST
from std::core import Option

fn test_basic_drop() {
    let block_opt = MemoryBlock::alloc(1024, MEMF_FAST)
    match block_opt {
        Some(block) => {
            // block.drop() will be called automatically at end of scope
        },
        None => {}
    }
    // Memory freed here automatically!
}

fn test_nested_scopes() {
    let outer_opt = MemoryBlock::alloc(512, MEMF_FAST)
    match outer_opt {
        Some(block1) => {
            {
                let inner_opt = MemoryBlock::alloc(256, MEMF_FAST)
                match inner_opt {
                    Some(block2) => {
                        // Use inner block
                    },
                    None => {}
                }
                // inner block freed here (before outer)
            }
            // outer block still valid here
        },
        None => {}
    }
    // outer block freed here
}

fn test_early_return() {
    let block_opt = MemoryBlock::alloc(2048, MEMF_FAST)
    match block_opt {
        Some(block) => {
            if true {
                return  // block.drop() called before return!
            }
        },
        None => {}
    }
}

pub fn main() {
    test_basic_drop()
    test_nested_scopes()
    test_early_return()

    // All memory automatically freed!
    // No manual cleanup needed!
    // RAII works perfectly! 🎉
}
