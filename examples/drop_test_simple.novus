// Simple test of Drop trait - automatic memory cleanup (RAII)
// This compiles successfully if Drop trait is working

from std::mem import MemoryBlock, MEMF_FAST
from std::collections import Vec
from std::core import Option

fn test_memory_block() {
    // Block will be automatically freed at end of scope
    let block_opt = MemoryBlock::alloc(1024, MEMF_FAST)
    match block_opt {
        Some(block) => {
            // block.drop() called automatically here
        },
        None => {}
    }
}

fn test_vec() {
    // Vec will be automatically freed at end of scope
    let mut vec: Vec<i32> = Vec::new<i32>()
    vec.push(1)
    vec.push(2)
    vec.push(3)
    // vec.drop() called automatically here
}

fn test_nested() {
    let outer = MemoryBlock::alloc(512, MEMF_FAST)
    match outer {
        Some(block1) => {
            {
                let inner = MemoryBlock::alloc(256, MEMF_FAST)
                match inner {
                    Some(block2) => {
                        // inner freed first
                    },
                    None => {}
                }
                // inner.drop() here
            }
            // block1 still valid
        },
        None => {}
    }
    // outer.drop() here
}

fn test_early_return() {
    let block_opt = MemoryBlock::alloc(2048, MEMF_FAST)
    match block_opt {
        Some(block) => {
            // Early return - block freed before returning
            if true {
                return
            }
        },
        None => {}
    }
}

fn test_multiple_vecs() {
    let mut vec1: Vec<i32> = Vec::new<i32>()
    vec1.push(10)

    let mut vec2: Vec<u8> = Vec::new<u8>()
    vec2.push(100)

    let mut vec3: Vec<i32> = Vec::new<i32>()
    vec3.push(1000)

    // All freed in LIFO order: vec3, vec2, vec1
}

pub fn main() {
    test_memory_block()
    test_vec()
    test_nested()
    test_early_return()
    test_multiple_vecs()

    // All memory automatically freed!
    // No defer blocks needed!
    // RAII works! 🎉
}
