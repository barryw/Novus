<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <Version>0.7.1</Version>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Antlr4.Runtime.Standard" Version="4.13.1" />
        <PackageReference Include="Antlr4BuildTasks" Version="12.14.0" PrivateAssets="all" />
        <PackageReference Include="NAudio" Version="2.2.1" />
    </ItemGroup>

    <ItemGroup>
        <!-- Split grammar: lexer first, then parser that references lexer tokens -->
        <Antlr4 Include="NovusLexer.g4">
            <Package>Novus.Parser</Package>
            <Listener>false</Listener>
            <Visitor>false</Visitor>
        </Antlr4>
        <Antlr4 Include="NovusParser.g4">
            <Package>Novus.Parser</Package>
            <Listener>false</Listener>
            <Visitor>true</Visitor>
        </Antlr4>
    </ItemGroup>

</Project>
