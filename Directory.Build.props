<Project>
  <PropertyGroup>
    <WarningLevel>9</WarningLevel>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest-minimum</AnalysisLevel>
    <!-- Suppress VSTHRD103 for debug logging in language server -->
    <!-- Suppress overly pedantic code analysis rules that are minor optimizations -->
    <!-- These rules suggest micro-optimizations that don't justify the code churn -->
    <NoWarn>$(NoWarn);VSTHRD103;CA1822;CA1825;CA1827;CA1830;CA1834;CA1845;CA1846;CA1847;CA1850;CA1852;CA1854;CA1859;CA1860;CA1861;CA1862;CA1865;CA1866;CA1868;CA1869</NoWarn>
  </PropertyGroup>
</Project>
